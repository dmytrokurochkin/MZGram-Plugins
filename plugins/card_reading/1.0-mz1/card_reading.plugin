def _dp(value: int) -> int:
    try:
        from org.telegram.messenger import AndroidUtilities
        return AndroidUtilities.dp(value)
    except Exception:
        return int(value * 3)


CARDS_DATA = [{'id': 'owl_rope', 'img': '001.png', 'name_uk': 'Сова на скакалці', 'text_uk': 'Сова бадьоро стрибає і радить не зволікати. Сьогодні ваш день для рішучих стрибків угору, але дивіться під ноги, щоб не заплутатися у власних планах.', 'name_en': 'Owl on a jump rope', 'text_en': "The owl is jumping energetically and advises you not to hesitate. Today is your day for bold leaps forward, but watch your step so you don't trip over your own plans.", 'name_ru': 'Сова на скакалке', 'text_ru': 'Сова бодро прыгает и советует не медлить. Сегодня отличный день для решительных прыжков вперед, но смотрите под ноги, чтобы не запутаться в собственных планах.'}, {'id': 'piggy_ballerina', 'img': '002.png', 'name_uk': 'Свинка-балерина', 'text_uk': 'Навіть якщо здається, що ситуація вимагає незграбних кроків, покажіть усім справжню грацію. Ваша впевненість здивує оточуючих і принесе несподіваний успіх.', 'name_en': 'Piggy ballerina', 'text_en': 'Even if life feels clumsy right now, show everyone your true grace. Your confidence will surprise those around you and bring unexpected success.', 'name_ru': 'Свинка-балерина', 'text_ru': 'Даже если кажется, что вокруг сплошная неуклюжесть, проявите истинную грацию. Ваша уверенность удивит окружающих и принесет неожиданный успех.'}, {'id': 'tiger_magic', 'img': '003.png', 'name_uk': 'Тигр-ілюзіоніст', 'text_uk': 'Спритність лап і жодного шахрайства. Сьогодні ви здатні здивувати друзів фокусом зі зникненням проблем і появою смаколиків.', 'name_en': 'Magic tiger', 'text_en': 'Sleight of paw and pure magic. Today you can amaze everyone by making your problems vanish into thin air.', 'name_ru': 'Тигр-фокусник', 'text_ru': 'Ловкость лап и никакого мошенничества. Сегодня вы способны удивить всех трюком с исчезновением проблем и появлением угощений.'}, {'id': 'sheep_sleeping', 'img': '004.png', 'name_uk': 'Спляча овечка', 'text_uk': 'Карта повного затишку та відновлення сил. Якщо справи почекають, сміливо закутайтеся в ковдру і дозвольте собі подрімати.', 'name_en': 'Sleeping sheep', 'text_en': 'A card of ultimate comfort and relaxation. If tasks can wait, wrap yourself in a blanket and enjoy a well-deserved nap.', 'name_ru': 'Спящая овечка', 'text_ru': 'Карта полного уюта и восстановления сил. Если дела могут подождать, смело укутайтесь в плед и позвольте себе вздремнуть.'}, {'id': 'bear_skateboard', 'img': '005.png', 'name_uk': 'Ведмідь на скейті', 'text_uk': 'Швидкість і драйв на кожному повороті. Головне - тримати рівновагу і вчасно гальмувати перед несподіваними пригодами.', 'name_en': 'Bear on a skateboard', 'text_en': "Speed and excitement around every corner. Keep your balance and don't forget to brake when unexpected adventures appear.", 'name_ru': 'Медведь на скейте', 'text_ru': 'Скорость и драйв на каждом повороте. Главное - держать равновесие и вовремя тормозить перед неожиданными приключениями.'}, {'id': 'flamingo_grocery', 'img': '006.png', 'name_uk': 'Фламінго на шопінгу', 'text_uk': 'Час потішити себе приємними покупками або смачною вечерею. Проте перевіряйте чек, щоб не придбати зайвий віз креветок.', 'name_en': 'Flamingo shopping', 'text_en': "Time to treat yourself to nice shopping or a delicious meal. Just check your cart so you don't buy an extra crate of shrimp.", 'name_ru': 'Фламинго за покупками', 'text_ru': 'Время порадовать себя приятными покупками или вкусным ужином. Но проверяйте чек, чтобы не набрать лишнюю тележку креветок.'}, {'id': 'dog_golfing', 'img': '007.png', 'name_uk': 'Пес-гольфіст', 'text_uk': 'Точний розрахунок і трохи витримки приведуть вас до мети з першої спроби. Не гавкайте на перешкоди, просто обійдіть їх.', 'name_en': 'Dog playing golf', 'text_en': "Precise aim and a bit of patience will get you straight to your goal. Don't bark at obstacles, just aim around them.", 'name_ru': 'Пес-гольфист', 'text_ru': 'Точный расчет и капля выдержки приведут вас к цели с первой попытки. Не лайте на преграды, просто аккуратно их обойдите.'}, {'id': 'monkey_juggling', 'img': '008.png', 'name_uk': 'Мавпа-жонглер', 'text_uk': 'Сьогодні вам доведеться втримати в руках одразу кілька справ. Спокій і посмішка допоможуть не впустити жодного важливого завдання.', 'name_en': 'Juggling monkey', 'text_en': 'You might have to juggle multiple tasks at once today. Stay calm and smiling, and not a single ball will drop.', 'name_ru': 'Обезьяна-жонглер', 'text_ru': 'Сегодня придется жонглировать несколькими делами сразу. Спокойствие и улыбка помогут не уронить ни одной важной задачи.'}, {'id': 'lion_football', 'img': '009.png', 'name_uk': 'Лев-футболіст', 'text_uk': "Енергія б'є через край, ви готові до командного прориву. Сміливо приймайте передачу від долі та забивайте свій вирішальний гол.", 'name_en': 'Lion playing football', 'text_en': 'Full of energy and ready for a team breakthrough. Catch the pass from destiny and score your decisive goal.', 'name_ru': 'Лев-футболист', 'text_ru': 'Энергия бьет через край, и вы готовы к командному прорыву. Смело принимайте пас от судьбы и забивайте победный гол.'}, {'id': 'dino_rodeo', 'img': '010.png', 'name_uk': 'Динозавр на родео', 'text_uk': 'Будь-яку непередбачувану ситуацію можна приборкати з ковбойським запалом. Тримайтеся міцно в сідлі, попереду яскраві враження.', 'name_en': 'Dinosaur at the rodeo', 'text_en': 'Any wild situation can be tamed with a bit of cowboy spirit. Hold tight to the saddle, great thrills are ahead.', 'name_ru': 'Динозавр на родео', 'text_ru': 'Любую дикую ситуацию можно обуздать с ковбойским задором. Держитесь крепче в седле, впереди яркие впечатления.'}, {'id': 'pirate_turkey', 'img': '011.png', 'name_uk': 'Індик-пірат', 'text_uk': 'Підняти вітрила! Десь поблизу захований скарб: гарна новина, знахідка чи несподівана знижка. Будьте пильні на горизонті.', 'name_en': 'Pirate turkey', 'text_en': 'Raise the sails! A treasure is hidden nearby: good news, a lucky find, or an unexpected discount. Keep a sharp eye on the horizon.', 'name_ru': 'Индюк-пират', 'text_ru': 'Поднять паруса! Где-то рядом спрятано сокровище: добрая весть, находка или неожиданная скидка. Смотрите в оба.'}, {'id': 'frog_selfie', 'img': '012.png', 'name_uk': 'Жабка робить селфі', 'text_uk': 'Посміхніться світу, і світ відповість лайками. Чудовий момент для оновлення фотографій або компліменту собі перед дзеркалом.', 'name_en': 'Frog taking a selfie', 'text_en': 'Smile at the world, and the world will send likes right back. A great time to take a fresh photo or admire yourself in the mirror.', 'name_ru': 'Лягушка делает селфи', 'text_ru': 'Улыбнитесь миру, и мир ответит лайками. Отличный момент для свежего фото или комплимента себе перед зеркалом.'}, {'id': 'octopus_icecream', 'img': '013.png', 'name_uk': 'Восьминіг з морозивом', 'text_uk': "У вас достатньо рук і можливостей, щоб насолоджуватися солодким життям. Не поспішайте ділитися десертом, якщо хочете з'їсти його самі.", 'name_en': 'Octopus with ice cream', 'text_en': "You have plenty of arms and opportunities to enjoy the sweet things in life. Don't rush to share your dessert if you want it all.", 'name_ru': 'Осьминог с мороженым', 'text_ru': 'У вас достаточно щупалец и возможностей, чтобы наслаждаться сладкой жизнью. Не спешите делиться десертом, если хотите его сами.'}, {'id': 'bee_race', 'img': '014.png', 'name_uk': 'Бджола-марафонець', 'text_uk': 'Ваша працьовитість скоро принесе смачний мед успіху. Тільки не забувайте зупинятися на квіткових галявинах для перепочинку.', 'name_en': 'Bee running a marathon', 'text_en': 'Your hard work will soon bring sweet honeyed success. Just remember to pause at a sunny flower meadow for a quick rest.', 'name_ru': 'Пчела на марафоне', 'text_ru': 'Ваше трудолюбие скоро принесет сладкий мед успеха. Главное - не забывайте делать паузы на солнечных полянках для отдыха.'}, {'id': 'cat_ninja', 'img': '015.png', 'name_uk': 'Кіт-ніндзя', 'text_uk': "М'які лапки і безшумні кроки допоможуть непомітно розв'язати будь-яку заплутану справу. Дійте тихо, але впевнено.", 'name_en': 'Ninja cat', 'text_en': 'Soft paws and silent steps will help you resolve any tricky situation quietly. Move stealthily, but strike with confidence.', 'name_ru': 'Кот-ниндзя', 'text_ru': 'Мягкие лапки и бесшумные шаги помогут тихо решить любой запутанный вопрос. Действуйте незаметно, но уверенно.'}, {'id': 'bird_painting', 'img': '016.png', 'name_uk': 'Пташка-художник', 'text_uk': "Сьогодні день для творчості та яскравих кольорів. Додайте трохи фантазії навіть до найбільш буденних обов'язків.", 'name_en': 'Bird painting', 'text_en': 'Today is a day for creativity and vibrant colors. Add a splash of imagination even to the most routine chores.', 'name_ru': 'Птица-художник', 'text_ru': 'Сегодня день для творчества и ярких красок. Добавьте каплю фантазии даже в самые обыденные дела.'}, {'id': 'skunk_racer', 'img': '017.png', 'name_uk': 'Скунс-гонщик', 'text_uk': 'Ви випередите всіх суперників завдяки сміливості та оригінальності. Залишайте позаду сумніви і тисніть на газ.', 'name_en': 'Skunk racer', 'text_en': 'You will outrun all competitors with boldness and originality. Leave doubts behind in the dust and hit the gas.', 'name_ru': 'Скунс-гонщик', 'text_ru': 'Вы обойдете всех соперников благодаря смелости и оригинальности. Оставьте сомнения позади и жмите на газ.'}, {'id': 'crab_reading', 'img': '018.png', 'name_uk': 'Краб читає книгу', 'text_uk': 'Глибокі знання - ваша найкраща броня. Прочитайте корисну статтю або інструкцію, там криється відповідь на важливе питання.', 'name_en': 'Crab reading a book', 'text_en': 'Deep knowledge is your best armor. Read an interesting article or guide, as it holds the answer to a key question.', 'name_ru': 'Краб читает книгу', 'text_ru': 'Глубокие знания - ваша лучшая броня. Прочитайте полезную статью или книгу, там кроется ответ на важный вопрос.'}, {'id': 'giraffe_bubbles', 'img': '019.png', 'name_uk': 'Жираф пускає бульбашки', 'text_uk': 'Дивіться на речі з висоти свого зросту та не переймайтеся дрібницями. Легкість думок привертає радісні події.', 'name_en': 'Giraffe blowing bubbles', 'text_en': "Look at things from a higher perspective and don't fret over small stuff. Lighthearted thoughts attract joyful events.", 'name_ru': 'Жираф пускает пузыри', 'text_ru': 'Смотрите на вещи с высоты своего полета и не переживайте по мелочам. Легкость мыслей привлекает радостные события.'}, {'id': 'surfing_snake', 'img': '020.png', 'name_uk': 'Змія на серфі', 'text_uk': 'Гнучкість і вміння відчувати хвилю дозволять вам вийти сухим із будь-якого бурхливого повороту подій.', 'name_en': 'Surfing snake', 'text_en': 'Flexibility and the skill to catch the wave will let you surf through any stormy turn of events.', 'name_ru': 'Змея на серфе', 'text_ru': 'Гибкость и умение ловить волну позволят вам выйти сухим из любого бурного поворота событий.'}, {'id': 'horse_fishing', 'img': '021.png', 'name_uk': 'Кінь на риболовлі', 'text_uk': 'Терпіння та спокійна вдача гарантують великий улов. Головне - не рвати вудку завчасно і чекати слушної миті.', 'name_en': 'Horse fishing', 'text_en': "Patience and a calm demeanor guarantee a big catch. Don't yank the line too soon, wait for the perfect moment.", 'name_ru': 'Лошадь на рыбалке', 'text_ru': 'Терпение и спокойный нрав гарантируют крупный улов. Главное - не дергать удочку раньше времени и дождаться верного момента.'}, {'id': 'squirrel_swimming', 'img': '022.png', 'name_uk': 'Білка пливе', 'text_uk': 'Ви здатні опанувати нові незвичні навички швидше, ніж очікували. Сміливо пірнайте в нові проекти, у вас все вийде.', 'name_en': 'Swimming squirrel', 'text_en': "You can master new and unfamiliar skills much faster than expected. Dive boldly into new ventures, you've got this.", 'name_ru': 'Белка плывет', 'text_ru': 'Вы способны освоить новые непривычные навыки быстрее, чем думали. Смело ныряйте в новые проекты, всё получится.'}, {'id': 'kangaroo_cooking', 'img': '023.png', 'name_uk': 'Кенгуру куховарить', 'text_uk': 'На вас чекає смачний сюрприз або вдалий кулінарний експеримент. Додайте дрібку тепла, і близькі будуть у захваті.', 'name_en': 'Kangaroo cooking', 'text_en': 'A delicious surprise or successful culinary experiment awaits you. Add a pinch of warmth, and everyone will be delighted.', 'name_ru': 'Кенгуру готовит', 'text_ru': 'Вас ждет вкусный сюрприз или удачный кулинарный эксперимент. Добавьте щепотку душевного тепла, и близкие будут в восторге.'}, {'id': 'astronaut_chicken', 'img': '024.png', 'name_uk': 'Курка-космонавт', 'text_uk': 'Навіть якщо оточуючі вважають ваші мрії фантастичними, ви готові підкорювати зірки. Не бійтеся літати вище за паркан.', 'name_en': 'Astronaut chicken', 'text_en': 'Even if others think your dreams are sky-high, you are ready to reach for the stars. Never fear flying higher than the fence.', 'name_ru': 'Курица-космонавт', 'text_ru': 'Даже если окружающим ваши мечты кажутся заоблачными, вы готовы покорять звезды. Не бойтесь взлетать выше забора.'}, {'id': 'camel_cleaning', 'img': '025.png', 'name_uk': 'Верблюд прибирає', 'text_uk': 'Час навести лад у думках, на робочому столі та в телефоні. Чистий простір миттєво відкриє дорогу свіжим ідеям.', 'name_en': 'Camel cleaning', 'text_en': 'Time to tidy up your thoughts, your desk, and your phone. A clean space instantly clears the path for fresh ideas.', 'name_ru': 'Верблюд убирается', 'text_ru': 'Пора навести порядок в мыслях, на рабочем столе и в телефоне. Чистое пространство откроет дорогу свежим идеям.'}, {'id': 'alligator_guitar', 'img': '026.png', 'name_uk': 'Алігатор з гітарою', 'text_uk': 'Ваш внутрішній рок-н-рол вимагає виходу! Заспівайте улюблену пісню або поділіться гарним треком із другом.', 'name_en': 'Alligator with a guitar', 'text_en': 'Your inner rock star is ready to shine! Sing your favorite song or share a great tune with a friend.', 'name_ru': 'Аллигатор с гитарой', 'text_ru': 'Ваш внутренний рок-н-ролл просится наружу! Спойте любимую песню или поделитесь классным треком с другом.'}, {'id': 'donkey_cheerleader', 'img': '027.png', 'name_uk': 'Осел-чирлідер', 'text_uk': 'Головна підтримка вже з вами! Вірте в свої сили, танцюйте з помпонами радості та не звертайте уваги на скептиків.', 'name_en': 'Donkey cheerleader', 'text_en': 'Your cheer squad is here! Believe in your own strength, dance with pom-poms of joy, and ignore the skeptics.', 'name_ru': 'Осел-чирлидер', 'text_ru': 'Группа поддержки уже здесь! Верьте в свои силы, танцуйте с помпонами радости и не обращайте внимания на скептиков.'}]

CARD_READING_HTML_TEMPLATE = "<!DOCTYPE html>\n<html lang=\"__LANG__\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover, user-scalable=no\">\n<meta name=\"theme-color\" content=\"#1c1b1f\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>__PAGE_TITLE__</title>\n<style>\n  /* Material Design 3 dark tokens */\n  :root {\n    --md-primary: #ffb951;\n    --md-on-primary: #452b00;\n    --md-primary-container: #653f00;\n    --md-on-primary-container: #ffddb0;\n\n    --md-secondary: #dcc3a1;\n    --md-surface: #141218;\n    --md-surface-dim: #141218;\n    --md-surface-bright: #3a373e;\n    --md-surface-container-lowest: #0f0d13;\n    --md-surface-container-low: #1d1b20;\n    --md-surface-container: #211f26;\n    --md-surface-container-high: #2b2930;\n    --md-surface-container-highest: #36343b;\n    --md-on-surface: #e6e0e9;\n    --md-on-surface-variant: #cac4d0;\n    --md-outline: #948f99;\n    --md-outline-variant: #49454f;\n\n    --md-elevation-1: 0 1px 3px rgba(0,0,0,0.35), 0 1px 2px rgba(0,0,0,0.5);\n    --md-elevation-2: 0 3px 6px rgba(0,0,0,0.4), 0 2px 4px rgba(0,0,0,0.35);\n    --md-elevation-3: 0 6px 14px rgba(0,0,0,0.45), 0 3px 6px rgba(0,0,0,0.3);\n\n    --shape-xs: 8px;\n    --shape-s: 12px;\n    --shape-m: 16px;\n    --shape-l: 24px;\n    --shape-xl: 32px;\n    --shape-full: 9999px;\n\n    --motion-standard: cubic-bezier(0.2, 0, 0, 1);\n    --motion-emphasized: cubic-bezier(0.2, 0, 0, 1.25);\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n\n  html, body {\n    width: 100%; height: 100%;\n    background: var(--md-surface);\n    color: var(--md-on-surface);\n    font-family: Roboto, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    overflow: hidden;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  #app {\n    display: flex;\n    flex-direction: column;\n    width: 100%; height: 100%;\n    position: relative;\n  }\n\n  /* Top bar */\n  #topbar {\n    padding: calc(16px + env(safe-area-inset-top)) 24px 8px;\n    display: flex; align-items: center; justify-content: space-between;\n    z-index: 10;\n  }\n  #topbar .title {\n    font-size: 22px; font-weight: 500; letter-spacing: 0;\n    color: var(--md-on-surface);\n    display: flex; align-items: center; gap: 8px;\n  }\n  #topbar .title .dot {\n    width: 8px; height: 8px; border-radius: var(--shape-full);\n    background: var(--md-primary);\n    box-shadow: 0 0 8px var(--md-primary);\n  }\n\n  /* Main card zone */\n  #deck-zone {\n    flex: 1;\n    position: relative;\n    display: flex; align-items: center; justify-content: center;\n    perspective: 1000px;\n    padding: 20px;\n    overflow: hidden;\n  }\n\n  /* Card presentation */\n  .card {\n    position: absolute;\n    width: 200px; height: 280px;\n    border-radius: var(--shape-l);\n    transform-style: preserve-3d;\n    box-shadow: var(--md-elevation-3);\n    cursor: pointer;\n    will-change: transform, opacity;\n  }\n\n  .card-front, .card-back {\n    position: absolute; inset: 0;\n    border-radius: var(--shape-l);\n    backface-visibility: hidden;\n    -webkit-backface-visibility: hidden;\n    overflow: hidden;\n  }\n\n  .card-back {\n    background: radial-gradient(circle at 30% 30%, #36343b, #1d1b20);\n    border: 2px solid var(--md-outline-variant);\n    display: flex; align-items: center; justify-content: center;\n  }\n  .card-back::before {\n    content: \"\";\n    width: 70%; height: 75%;\n    border-radius: var(--shape-m);\n    border: 1px dashed var(--md-outline);\n    opacity: 0.4;\n  }\n  .card-back::after {\n    content: \"\u2726\";\n    position: absolute;\n    font-size: 32px;\n    color: var(--md-primary);\n    text-shadow: 0 0 12px var(--md-primary);\n  }\n\n  .card-front {\n    background: var(--md-surface-container-high);\n    border: 2px solid var(--md-primary);\n    transform: rotateY(180deg);\n    display: flex; align-items: center; justify-content: center;\n    padding: 10px;\n  }\n  .card-front img {\n    width: 100%; height: 100%;\n    object-fit: contain;\n    border-radius: var(--shape-m);\n    opacity: 0;\n    transition: opacity 0.35s ease;\n  }\n  .card-front img.loaded { opacity: 1; }\n\n  /* Controls */\n  #controls {\n    padding: 12px 24px calc(20px + env(safe-area-inset-bottom));\n    display: flex; gap: 12px; align-items: center;\n    z-index: 10;\n  }\n\n  .md-field {\n    flex: 1;\n    position: relative;\n  }\n  .md-field input {\n    width: 100%; height: 52px;\n    background: var(--md-surface-container-highest);\n    border: 1px solid var(--md-outline);\n    border-radius: var(--shape-full);\n    padding: 0 20px;\n    color: var(--md-on-surface);\n    font-size: 16px;\n    outline: none;\n    transition: border-color 0.2s, border-width 0.1s;\n    text-align: center;\n  }\n  .md-field input:focus { border-color: var(--md-primary); border-width: 2px; }\n  .md-field input::placeholder {\n    color: var(--md-on-surface-variant);\n    text-align: center;\n  }\n\n  .md-button {\n    appearance: none; border: none;\n    height: 52px; padding: 0 30px;\n    border-radius: var(--shape-full);\n    background: var(--md-primary);\n    color: var(--md-on-primary);\n    font-size: 15px; font-weight: 600; letter-spacing: 0.1px;\n    box-shadow: var(--md-elevation-1);\n    cursor: pointer;\n    transition: transform 0.15s var(--motion-standard), box-shadow 0.15s var(--motion-standard), opacity 0.2s;\n    position: relative;\n    overflow: hidden;\n  }\n  .md-button:active { transform: scale(0.96); box-shadow: none; }\n  .md-button:disabled { opacity: 0.38; box-shadow: none; cursor: default; }\n\n  .md-button-text {\n    background: transparent; border: none;\n    color: var(--md-primary);\n    font-size: 14px; font-weight: 600;\n    padding: 12px 24px; border-radius: var(--shape-full);\n    cursor: pointer;\n    touch-action: manipulation;\n    position: relative;\n    z-index: 1;\n  }\n  .md-button-text:active { background: rgba(255,185,81,0.12); }\n\n  /* Result bottom sheet */\n  #result {\n    position: absolute; left: 0; right: 0; bottom: 0;\n    max-height: 48%;\n    background: var(--md-surface-container-low);\n    border-top-left-radius: var(--shape-xl);\n    border-top-right-radius: var(--shape-xl);\n    box-shadow: 0 -4px 24px rgba(0,0,0,0.4);\n    padding: 10px 24px calc(24px + env(safe-area-inset-bottom));\n    display: flex; flex-direction: column; align-items: center; gap: 10px;\n    transform: translateY(100%);\n    transition: transform 0.45s var(--motion-emphasized);\n    pointer-events: none;\n    overflow-y: auto;\n    z-index: 200;\n  }\n  #result.visible { transform: translateY(0); pointer-events: auto; }\n  #result .handle {\n    width: 32px; height: 4px; border-radius: var(--shape-full);\n    background: var(--md-outline-variant);\n    margin-bottom: 4px;\n  }\n  #result-name {\n    font-size: 20px; font-weight: 600; color: var(--md-on-primary-container);\n    background: var(--md-primary-container);\n    padding: 6px 16px; border-radius: var(--shape-full);\n  }\n  #result-text {\n    font-size: 15px; line-height: 1.55; text-align: center;\n    max-width: 480px; color: var(--md-on-surface-variant);\n    padding: 4px 4px 6px;\n  }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <div id=\"topbar\"><div class=\"title\"><span class=\"dot\"></span>__TOPBAR_TITLE__</div></div>\n\n  <div id=\"deck-zone\"></div>\n\n  <div id=\"controls\">\n    <div class=\"md-field\">\n      <input id=\"num-input\" type=\"number\" min=\"1\" max=\"27\" placeholder=\"__PLACEHOLDER__\">\n    </div>\n    <button id=\"start-btn\" class=\"md-button\">__START_BTN__</button>\n  </div>\n\n  <div id=\"result\">\n    <div class=\"handle\"></div>\n    <div id=\"result-name\"></div>\n    <div id=\"result-text\"></div>\n    <button id=\"again-btn\" class=\"md-button-text\">__AGAIN_BTN__</button>\n  </div>\n</div>\n\n<script>\n(function () {\n  const IMAGE_BASE = \"https://raw.githubusercontent.com/exterabase/Owls-/main/\";\n  const DECK = __DECK_DATA__;\n  const DEFAULT_OWL_WEIGHT = 4;\n\n  const urlParams = new URLSearchParams(window.location.search);\n  const owlWeight = Math.max(1, parseInt(urlParams.get(\"owl_weight\"), 10) || DEFAULT_OWL_WEIGHT);\n\n  const OWL_ID = \"owl_rope\";\n  const PITY_LIMIT = 5;\n  const NO_REPEAT_WINDOW = 3;\n  const KEY_DRAWS_SINCE_OWL = \"cr_draws_since_owl\";\n  const KEY_RECENT_CARDS = \"cr_recent_cards\";\n\n  function readDrawsSinceOwl() {\n    const raw = localStorage.getItem(KEY_DRAWS_SINCE_OWL);\n    if (raw === null) return null;\n    const n = parseInt(raw, 10);\n    return isNaN(n) ? null : n;\n  }\n\n  function readRecentCards() {\n    try {\n      const raw = localStorage.getItem(KEY_RECENT_CARDS);\n      const arr = raw ? JSON.parse(raw) : [];\n      return Array.isArray(arr) ? arr : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  function saveDrawState(drawnId) {\n    const prevDraws = readDrawsSinceOwl();\n    const nextDraws = drawnId === OWL_ID ? 0 : (prevDraws === null ? 1 : prevDraws + 1);\n    try { localStorage.setItem(KEY_DRAWS_SINCE_OWL, String(nextDraws)); } catch (e) {}\n\n    const recent = readRecentCards();\n    recent.push(drawnId);\n    while (recent.length > NO_REPEAT_WINDOW) recent.shift();\n    try { localStorage.setItem(KEY_RECENT_CARDS, JSON.stringify(recent)); } catch (e) {}\n  }\n\n  const deckZone = document.getElementById(\"deck-zone\");\n  const startBtn = document.getElementById(\"start-btn\");\n  const numInput = document.getElementById(\"num-input\");\n  const resultBox = document.getElementById(\"result\");\n  const resultName = document.getElementById(\"result-name\");\n  const resultText = document.getElementById(\"result-text\");\n  const againBtn = document.getElementById(\"again-btn\");\n\n  const cardEls = DECK.map((card, i) => {\n    const el = document.createElement(\"div\");\n    el.className = \"card\";\n    el.dataset.index = i;\n    const img = document.createElement(\"img\");\n    img.alt = card.name;\n    img.dataset.src = IMAGE_BASE + card.img;\n    img.dataset.loaded = \"0\";\n    el.innerHTML = '<div class=\"card-back\"></div><div class=\"card-front\"></div>';\n    el.querySelector(\".card-front\").appendChild(img);\n    deckZone.appendChild(el);\n    return el;\n  });\n\n  function loadCardImage(el, attempt = 0) {\n    const img = el.querySelector(\"img\");\n    if (!img || img.dataset.loaded === \"1\") return;\n    const maxAttempts = 4;\n    const retryDelay = 450 * (attempt + 1);\n    img.onerror = () => {\n      if (attempt < maxAttempts) {\n        setTimeout(() => loadCardImage(el, attempt + 1), retryDelay);\n      }\n    };\n    img.onload = () => {\n      img.dataset.loaded = \"1\";\n      img.classList.add(\"loaded\");\n    };\n    img.src = attempt === 0 ? img.dataset.src : img.dataset.src + \"?retry=\" + attempt;\n  }\n\n  function layoutIdle() {\n    const n = cardEls.length;\n    cardEls.forEach((el, i) => {\n      const offset = (i - n / 2) * 3;\n      el.style.transform = `translate(${offset}px, ${Math.abs(offset) * 0.4}px) rotate(${offset * 0.4}deg)`;\n      el.style.zIndex = i;\n      el.classList.remove(\"selected\");\n    });\n  }\n  layoutIdle();\n\n  const WEIGHTS = DECK.map((card) => (card.id === \"owl_rope\" ? owlWeight : 1));\n  const TOTAL_WEIGHT = WEIGHTS.reduce((a, b) => a + b, 0);\n\n  function weightedRandomIndex(randSource, excludeIds) {\n    const excludeSet = new Set(excludeIds || []);\n    let weights = WEIGHTS;\n    let total = TOTAL_WEIGHT;\n    if (excludeSet.size) {\n      weights = DECK.map((card, i) => (excludeSet.has(card.id) ? 0 : WEIGHTS[i]));\n      total = weights.reduce((a, b) => a + b, 0);\n      if (total <= 0) { weights = WEIGHTS; total = TOTAL_WEIGHT; }\n    }\n    let r = randSource * total;\n    for (let i = 0; i < weights.length; i++) {\n      r -= weights[i];\n      if (r <= 0) return i;\n    }\n    return weights.length - 1;\n  }\n\n  function pickIndex() {\n    const drawsSinceOwl = readDrawsSinceOwl();\n    const forceOwl = (drawsSinceOwl === null) || (drawsSinceOwl >= PITY_LIMIT);\n    if (forceOwl) {\n      const forcedIdx = DECK.findIndex((c) => c.id === OWL_ID);\n      if (forcedIdx !== -1) return forcedIdx;\n    }\n\n    const recentCards = readRecentCards();\n    const raw = numInput.value.trim();\n    const n = parseInt(raw, 10);\n\n    if (raw === \"\" || isNaN(n)) {\n      return weightedRandomIndex(Math.random(), recentCards);\n    }\n\n    const seed = Math.sin(n * 12.9898 + Date.now() * 0.0001) * 43758.5453;\n    const mixed = ((seed % 1) + 1) % 1;\n    const blended = (mixed * 0.5) + (Math.random() * 0.5);\n    return weightedRandomIndex(blended, recentCards);\n  }\n\n  let animating = false;\n\n  function shuffleStep(round, totalRounds, done) {\n    const n = cardEls.length;\n    cardEls.forEach((el, i) => {\n      const dir = round % 2 === 0 ? 1 : -1;\n      const spread = 90 + Math.random() * 40;\n      const x = dir * spread * Math.sin((i / n) * Math.PI * 2 + round);\n      const y = Math.cos((i / n) * Math.PI * 2 + round) * 20;\n      const rot = dir * (10 + Math.random() * 20);\n      el.style.transition = \"transform 0.28s var(--motion-standard)\";\n      el.style.transform = `translate(${x}px, ${y}px) rotate(${rot}deg)`;\n      el.style.zIndex = Math.floor(Math.random() * n);\n    });\n    if (round < totalRounds) {\n      setTimeout(() => shuffleStep(round + 1, totalRounds, done), 280);\n    } else {\n      setTimeout(done, 280);\n    }\n  }\n\n  function revealCard(index) {\n    const chosen = cardEls[index];\n    const others = cardEls.filter((_, i) => i !== index);\n\n    loadCardImage(chosen);\n\n    others.forEach((el, i) => {\n      const angle = (i / others.length) * Math.PI * 2;\n      el.style.transition = \"transform 0.5s var(--motion-standard), opacity 0.5s var(--motion-standard)\";\n      el.style.transform = `translate(${Math.cos(angle) * 240}px, ${Math.sin(angle) * 240}px) rotate(${angle * 40}deg)`;\n      el.style.opacity = \"0\";\n    });\n\n    chosen.classList.add(\"selected\");\n    chosen.style.transition = \"transform 0.5s var(--motion-standard)\";\n    chosen.style.transform = \"translate(0px, -8px) scale(1.15)\";\n    chosen.style.zIndex = \"100\";\n\n    setTimeout(() => {\n      let spins = 0;\n      const maxSpins = 3;\n      const spinInterval = setInterval(() => {\n        spins++;\n        const totalRotation = spins * 360;\n        chosen.style.transition = \"transform 0.45s var(--motion-emphasized)\";\n        chosen.style.transform = `translate(0px, -8px) scale(1.15) rotateY(${totalRotation}deg)`;\n        if (spins >= maxSpins) {\n          clearInterval(spinInterval);\n          setTimeout(() => {\n            const finalRotation = maxSpins * 360 + 180;\n            chosen.style.transition = \"transform 0.6s var(--motion-emphasized)\";\n            chosen.style.transform = `translate(0px, -8px) scale(1.15) rotateY(${finalRotation}deg)`;\n            setTimeout(() => showResult(index, chosen, finalRotation), 620);\n          }, 460);\n        }\n      }, 460);\n    }, 520);\n  }\n\n  function showResult(index, chosenEl, finalRotation) {\n    const card = DECK[index];\n    saveDrawState(card.id);\n    resultName.textContent = card.name;\n    resultText.textContent = card.text;\n    resultBox.classList.add(\"visible\");\n\n    if (chosenEl) {\n      chosenEl.style.transition = \"transform 0.45s var(--motion-emphasized)\";\n      chosenEl.style.transform = `translate(0px, -128px) scale(0.9) rotateY(${finalRotation}deg)`;\n      chosenEl.style.zIndex = \"1\";\n      chosenEl.style.pointerEvents = \"none\";\n    }\n\n    animating = false;\n    startBtn.disabled = false;\n  }\n\n  function startReading() {\n    if (animating) return;\n    animating = true;\n    startBtn.disabled = true;\n    resultBox.classList.remove(\"visible\");\n\n    const chosenIndex = pickIndex();\n    shuffleStep(0, 6, () => revealCard(chosenIndex));\n  }\n\n  function resetDeck() {\n    resultBox.classList.remove(\"visible\");\n    cardEls.forEach(el => {\n      el.style.transition = \"transform 0.5s var(--motion-standard), opacity 0.4s var(--motion-standard)\";\n      el.style.opacity = \"1\";\n      el.style.pointerEvents = \"\";\n      const img = el.querySelector(\"img\");\n      if (img) { img.classList.remove(\"loaded\"); img.dataset.loaded = \"0\"; img.removeAttribute(\"src\"); }\n    });\n    setTimeout(layoutIdle, 60);\n  }\n\n  startBtn.addEventListener(\"click\", startReading);\n  againBtn.addEventListener(\"click\", resetDeck);\n})();\n</script>\n</body>\n</html>"


class CardReadingPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_mz_t("Ворожити", "Fortune", "Гадать"),
                on_click=self._on_menu_click,
                icon="msg_info",
            )
        )

    def create_settings(self):
        return []

    def _on_menu_click(self, context: Dict[str, Any]):
        fragment = context.get("fragment") or get_last_fragment()
        self._show_dialog(fragment)

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()

        if params.message.strip().lower() not in COMMAND_TRIGGERS:
            return HookResult()

        self._show_dialog(get_last_fragment())
        return HookResult(strategy=HookStrategy.CANCEL)

    def _get_html(self) -> str:
        lang = _mz_t("uk", "en", "ru")
        page_title = _mz_t("Ворожіння", "Fortune Telling", "Гадание")
        topbar_title = _mz_t("Ворожіння на картах", "Card fortune telling", "Гадание на картах")
        placeholder = _mz_t("Введіть число", "Enter a number", "Введите число")
        start_btn = _mz_t("Ворожити", "Fortune", "Гадать")
        again_btn = _mz_t("Ще раз", "Once more", "Еще раз")

        deck = []
        for c in CARDS_DATA:
            deck.append({
                "id": c["id"],
                "img": c["img"],
                "name": c["name_" + lang],
                "text": c["text_" + lang]
            })

        html = CARD_READING_HTML_TEMPLATE
        html = html.replace("__LANG__", lang)
        html = html.replace("__PAGE_TITLE__", page_title)
        html = html.replace("__TOPBAR_TITLE__", topbar_title)
        html = html.replace("__PLACEHOLDER__", placeholder)
        html = html.replace("__START_BTN__", start_btn)
        html = html.replace("__AGAIN_BTN__", again_btn)
        html = html.replace("__DECK_DATA__", json.dumps(deck, ensure_ascii=False))
        return html

    def _show_dialog(self, fragment):
        if not fragment:
            BulletinHelper.show_error(_mz_t("Не вдалося відкрити вікно ворожіння.", "Couldn't open the fortune window.", "Не удалось открыть окно гадания."))
            return

        activity = fragment.getParentActivity()
        if not activity:
            BulletinHelper.show_error(_mz_t("Не вдалося відкрити вікно ворожіння.", "Couldn't open the fortune window.", "Не удалось открыть окно гадания."))
            return

        def _build():
            owl_weight = OWL_WEIGHT_OPTIONS[DEFAULT_OWL_WEIGHT_INDEX]
            surface_color = -15461864  # #FF141218
            close_bg_color = -1728053248  # 60% black

            try:
                metrics = activity.getResources().getDisplayMetrics()
                panel_width = int(metrics.widthPixels * 0.92)
                panel_height = int(metrics.heightPixels * 0.82)

                webview = WebView(activity)
                settings = webview.getSettings()
                settings.setJavaScriptEnabled(True)
                settings.setDomStorageEnabled(True)
                settings.setUseWideViewPort(True)
                settings.setLoadWithOverviewMode(True)
                webview.setBackgroundColor(surface_color)
                webview.setFocusable(True)
                webview.setFocusableInTouchMode(True)
                webview.loadDataWithBaseURL(
                    f"https://card-reading.local/?owl_weight={owl_weight}",
                    self._get_html(),
                    "text/html",
                    "UTF-8",
                    None,
                )

                card_bg = GradientDrawable()
                card_bg.setColor(surface_color)
                card_bg.setCornerRadius(_dp(20))

                container = FrameLayout(activity)
                container.setBackground(card_bg)
                container.setClipToOutline(True)
                container.addView(
                    webview,
                    FrameLayout.LayoutParams(
                        FrameLayout.LayoutParams.MATCH_PARENT,
                        FrameLayout.LayoutParams.MATCH_PARENT,
                    ),
                )

                close_size = _dp(32)
                close_button = TextView(activity)
                close_button.setText("\u2715")
                close_button.setTextColor(Color.WHITE)
                close_button.setTextSize(16)
                close_button.setGravity(Gravity.CENTER)
                close_bg = GradientDrawable()
                close_bg.setShape(GradientDrawable.OVAL)
                close_bg.setColor(close_bg_color)
                close_button.setBackground(close_bg)

                close_params = FrameLayout.LayoutParams(close_size, close_size)
                close_params.gravity = Gravity.TOP | Gravity.END
                close_params.topMargin = _dp(10)
                close_params.rightMargin = _dp(10)
                container.addView(close_button, close_params)

                dialog = Dialog(activity)
                dialog.requestWindowFeature(Window.FEATURE_NO_TITLE)
                dialog.setContentView(container)
                dialog.setCancelable(True)

                close_button.setOnClickListener(OnClickListener(lambda v: dialog.dismiss()))

                window = dialog.getWindow()
                if window:
                    window.setLayout(panel_width, panel_height)
                    window.setGravity(Gravity.CENTER)
                    window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
                    window.setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))

                dialog.show()
                webview.requestFocus()
            except Exception as e:
                log(f"card_reading: failed to open window: {e}")
                BulletinHelper.show_error(_mz_t("Не вдалося відкрити вікно ворожіння.", "Couldn't open the fortune window.", "Не удалось открыть окно гадания."))

        run_on_ui_thread(_build)
