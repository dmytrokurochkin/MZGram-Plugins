# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Divider, Selector
import random

__id__ = "quote_message_converter"
__name__ = "Quote-Converter"
__description__ = "Replaces messages starting with .qe with a random quote."
__author__ = "MZGram"
__version__ = "1.0-mz1"
__min_version__ = "11.5.3"
__category__ = ["fun"]

QUOTES = [('Світ ловив мене, та не спіймав. - Григорій Сковорода', 'The world tried to catch me, but did not succeed. - Hryhorii Skovoroda', 'Мир ловил меня, но не поймал. - Григорий Сковорода'), ('З усіх утрат втрата часу найтяжча. - Григорій Сковорода', 'Of all losses, the loss of time is the hardest. - Hryhorii Skovoroda', 'Из всех утрат потеря времени самая тяжкая. - Григорий Сковорода'), ('Не все те отрута, що неприємне на смак. - Григорій Сковорода', 'Not everything that tastes bitter is poison. - Hryhorii Skovoroda', 'Не все то яд, что неприятно на вкус. - Григорий Сковорода'), ('Кожному місту - звичай і права, всяка тримає свій ум голова. - Григорій Сковорода', 'Every city has its custom and law, every head holds its own mind. - Hryhorii Skovoroda', 'Всякому городу нрав и права, всяка имеет свой ум голова. - Григорий Сковорода'), ('Учітесь, читайте, і чужому научайтесь, й свого не цурайтесь. - Тарас Шевченко', 'Learn, read, study the foreign, but do not shun your own. - Taras Shevchenko', 'Учитесь, читайте, чужому научайтесь и своего не чуждайтесь. - Тарас Шевченко'), ('Нема на світі України, немає другого Дніпра. - Тарас Шевченко', 'There is no other Ukraine in the world, there is no second Dnipro. - Taras Shevchenko', 'Нет на свете Украины, нет другого Днепра. - Тарас Шевченко'), ('Книги - морська глибина, хто в них пірне аж до дна, дивнії перли виносить. - Іван Франко', 'Books are the ocean depths; whoever dives to the bottom brings forth wondrous pearls. - Ivan Franko', 'Книги - морская глубина; кто в них нырнет до дна, тот дивные жемчужины выносит. - Иван Франко'), ('Лиш боротись - значить жить. - Іван Франко', 'Only to strive is to live. - Ivan Franko', 'Лишь бороться - значит жить. - Иван Франко'), ('Щоб не плакать, я сміялась. - Леся Українка', 'So as not to weep, I laughed. - Lesya Ukrainka', 'Чтоб не плакать, я смеялась. - Леся Украинка'), ('Слово, моя ти єдиная зброє, ми не повинні загинуть обоє. - Леся Українка', 'Word, you are my only weapon, we must not both perish. - Lesya Ukrainka', 'Слово, мое ты единственное оружие, мы не должны погибнуть оба. - Леся Украинка'), ('В своїй хаті своя й правда, і сила, і воля. - Тарас Шевченко', 'In your own house you have your own truth, strength and freedom. - Taras Shevchenko', 'В своей хате своя и правда, и сила, и воля. - Тарас Шевченко'), ('Я хочу крізь сльози сміятись, серед лиха співати пісні. - Леся Українка', 'I want to laugh through tears and sing songs amid misfortune. - Lesya Ukrainka', 'Я хочу сквозь слезы смеяться, среди горя песни петь. - Леся Украинка'), ('Де згода в сімействі, де мир і тишина, щасливі там люде, блаженна сторона. - Іван Котляревський', 'Where a family lives in harmony, peace and quiet, the people are happy and the land is blessed. - Ivan Kotliarevsky', 'Где согласие в семье, где мир и тишина, счастливы там люди, блаженна сторона. - Иван Котляревский'), ('Я знаю тільки те, що нічого не знаю. - Сократ', 'I know that I know nothing. - Socrates', 'Я знаю только то, что ничего не знаю. - Сократ'), ('Початок - найважливіша частина роботи. - Платон', 'The beginning is the most important part of the work. - Plato', 'Начало - самая важная часть работы. - Платон'), ('Коріння освіти гірке, але плоди солодкі. - Арістотель', 'The roots of education are bitter, but the fruit is sweet. - Aristotle', 'Корни образования горьки, но плоды сладки. - Аристотель'), ('Якщо людина не знає, до якого порту пливе, жоден вітер не буде попутним. - Сенека', 'If one does not know to which port one is sailing, no wind is favorable. - Seneca', 'Когда человек не знает, к какой пристани держит путь, никакой ветер не будет попутным. - Сенека'), ('Вік живи - вік учись. - Сенека', 'As long as you live, keep learning how to live. - Seneca', 'Век живи - век учись. - Сенека'), ('Наше життя - це те, що роблять із нього наші думки. - Марк Аврелій', 'Our life is what our thoughts make it. - Marcus Aurelius', 'Наша жизнь - это то, во что ее превращают наши мысли. - Марк Аврелий'), ('Найкраща помста - не бути схожим на кривдника. - Марк Аврелій', 'The best revenge is not to be like the wrongdoer. - Marcus Aurelius', 'Лучшая месть - не уподобляться обидчику. - Марк Аврелий'), ('Справжнє знання - знати межі свого незнання. - Конфуцій', "Real knowledge is to know the extent of one's ignorance. - Confucius", 'Истинное знание состоит в том, чтобы знать пределы своего неведения. - Конфуций'), ('Шлях у тисячу миль починається з одного кроку. - Лао-цзи', 'A journey of a thousand miles begins with a single step. - Lao Tzu', 'Путешествие в тысячу миль начинается с одного шага. - Лао-цзы'), ('Хто знає міру, той не знає лиха. - Лао-цзи', 'He who knows when he has enough is rich. - Lao Tzu', 'Кто знает меру, тот не ведает бед. - Лао-цзы'), ('Поки дихаю - сподіваюся. - Цицерон', 'While I breathe, I hope. - Cicero', 'Пока дышу, надеюсь. - Цицерон'), ('Звичка - друга натура. - Цицерон', 'Habit is a second nature. - Cicero', 'Привычка - вторая натура. - Цицерон'), ('Лови день. - Горацій', 'Seize the day. - Horace', 'Лови день. - Гораций'), ('Все тече, все змінюється. - Геракліт', 'Everything flows, nothing stands still. - Heraclitus', 'Все течет, все меняется. - Гераклит'), ('Життя коротке, мистецтво вічне. - Гіппократ', 'Life is short, art long. - Hippocrates', 'Жизнь коротка, искусство вечно. - Гиппократ'), ('Весь світ - театр, а люди в ньому - актори. - Вільям Шекспір', "All the world's a stage, and all the men and women merely players. - William Shakespeare", 'Весь мир - театр, а люди в нем - актеры. - Уильям Шекспир'), ('Короткість - душа дотепності. - Вільям Шекспір', 'Brevity is the soul of wit. - William Shakespeare', 'Краткость - душа остроумия. - Уильям Шекспир'), ('Любов дивиться не очима, а серцем. - Вільям Шекспір', 'Love looks not with the eyes, but with the mind. - William Shakespeare', 'Любовь смотрит не глазами, а сердцем. - Уильям Шекспир'), ('Ніщо не коштує так дешево і не цінується так дорого, як ввічливість. - Мігель де Сервантес', 'Nothing is so cheap or so prized as courtesy. - Miguel de Cervantes', 'Ничто не обходится нам так дешево и не ценится так дорого, как вежливость. - Мигель де Сервантес'), ('Я мислю, отже, я існую. - Рене Декарт', 'I think, therefore I am. - Rene Descartes', 'Я мыслю, следовательно, я существую. - Рене Декарт'), ('Серце має свої причини, яких розум не знає. - Блез Паскаль', 'The heart has its reasons which reason knows nothing of. - Blaise Pascal', 'У сердца есть свои доводы, которых разум не знает. - Блез Паскаль'), ('Краще - ворог хорошого. - Вольтер', 'The better is the enemy of the good. - Voltaire', 'Лучшее - враг хорошего. - Вольтер'), ('Ніщо не спинить ідею, час якої настав. - Віктор Гюго', 'Nothing can stop an idea whose time has come. - Victor Hugo', 'Ничто не остановит идею, время которой пришло. - Виктор Гюго'), ("Якщо говориш правду, не потрібно нічого запам'ятовувати. - Марк Твен", "If you tell the truth, you don't have to remember anything. - Mark Twain", 'Если говоришь правду, не нужно ничего запоминать. - Марк Твен'), ("Досвід - це ім'я, яке кожен дає своїм помилкам. - Оскар Вайльд", 'Experience is merely the name men gave to their mistakes. - Oscar Wilde', 'Опыт - это имя, которое каждый дает своим ошибкам. - Оскар Уайльд'), ('Коли ви відкинете неможливе, те, що залишиться, і є правда. - Артур Конан Дойл', 'When you have eliminated the impossible, whatever remains must be the truth. - Arthur Conan Doyle', 'Отбросьте все невозможное, то, что останется, и будет истиной. - Артур Конан Дойл'), ('Книга повинна бути сокирою для замерзлого моря всередині нас. - Франц Кафка', 'A book must be the axe for the frozen sea within us. - Franz Kafka', 'Книга должна быть топором для замерзшего моря внутри нас. - Франц Кафка'), ('Те, що нас не вбиває, робить нас сильнішими. - Фрідріх Ніцше', 'What does not kill me makes me stronger. - Friedrich Nietzsche', 'То, что нас не убивает, делает нас сильнее. - Фридрих Ницше'), ('Ми відповідальні за тих, кого приручили. - Антуан де Сент-Екзюпері', 'You become responsible, forever, for what you have tamed. - Antoine de Saint-Exupery', 'Мы в ответе за тех, кого приручили. - Антуан де Сент-Экзюпери'), ('Найголовнішого очима не побачиш: серце бачить одне. - Антуан де Сент-Екзюпері', 'What is essential is invisible to the eye; only the heart sees rightly. - Antoine de Saint-Exupery', 'Зорко одно лишь сердце: самого главного глазами не увидишь. - Антуан де Сент-Экзюпери'), ('Дві речі наповнюють душу подивом: зоряне небо наді мною і моральний закон у мені. - Іммануїл Кант', 'Two things fill the mind with wonder: the starry heavens above and the moral law within. - Immanuel Kant', 'Две вещи наполняют душу удивлением: звездное небо надо мной и моральный закон во мне. - Иммануил Кант'), ('Знання - це сила. - Френсіс Бекон', 'Knowledge is power. - Francis Bacon', 'Знание - сила. - Фрэнсис Бэкон'), ('Якщо я бачив далі за інших, то тому, що стояв на плечах гігантів. - Ісаак Ньютон', 'If I have seen further, it is by standing on the shoulders of giants. - Isaac Newton', 'Если я видел дальше других, то потому, что стоял на плечах гигантов. - Исаак Ньютон'), ("Здоров'я настільки переважає інші блага, що здоровий жебрак щасливіший за хворого короля. - Артур Шопенгауер", 'Health so far outweighs all external goods that a healthy beggar is happier than a sick king. - Arthur Schopenhauer', 'Здоровье настолько перевешивает другие блага, что здоровый нищий счастливее больного короля. - Артур Шопенгауэр'), ("Життя можна зрозуміти тільки дивлячись назад, але прожити його треба дивлячись уперед. - Серен К'єркегор", 'Life can only be understood backwards, but it must be lived forwards. - Soren Kierkegaard', 'Жизнь можно понять только оглядываясь назад, но прожить ее нужно глядя вперед. - Серен Кьеркегор')]

JOKES = [('Якщо нічого не робити, то й помилитися неможливо.', 'If you do nothing, you cannot make mistakes.', 'Если ничего не делать, то и ошибиться невозможно.'), ('Ранок добрий буває тільки після обіду.', 'A morning is only good if it starts in the afternoon.', 'Утро добрым бывает только после обеда.'), ('Інтуїція - це здатність відчувати неприємності заздалегідь.', 'Intuition is the ability to sense trouble well in advance.', 'Интуиция - это способность чувствовать неприятности заранее.'), ('Хто рано встає, той увесь день хоче спати.', 'The early bird is sleepy all day long.', 'Кто рано встает, тот весь день хочет спать.'), ('Якщо план «А» не спрацював, у алфавіті є ще понад тридцять літер.', 'If plan A fails, remember the alphabet has plenty more letters.', 'Если план «А» не сработал, в алфавите есть еще три десятка букв.'), ('Справжній оптиміст навіть на цвинтарі бачить одні плюси.', 'A true optimist sees plus signs even in a cemetery.', 'Настоящий оптимист даже на кладбище видит одни плюсы.'), ('Складно знайти чорного кота в темній кімнаті, особливо якщо його там немає.', 'It is hard to find a black cat in a dark room, especially if it is not there.', 'Трудно найти черного кота в темной комнате, особенно если его там нет.'), ('Робота не вовк - у ліс не втече. На жаль.', 'Work is not a wolf: it will not run off into the woods. Sadly.', 'Работа не волк - в лес не убежит. К сожалению.'), ('Усі люди приносять радість: одні своєю появою, інші - своєю відсутністю.', 'Everyone brings joy: some by arriving, others by leaving.', 'Все люди приносят радость: одни своим появлением, другие - своим отсутствием.'), ('Не відкладай на завтра те, що можна взагалі не робити.', 'Never put off till tomorrow what you can avoid doing altogether.', 'Не откладывай на завтра то, что можно вообще не делать.'), ('Дієта - це короткий період між двома перекусами.', 'A diet is simply the short break between two snacks.', 'Диета - это короткий перерыв между двумя перекусами.'), ('Досвід - це те, що отримуєш, коли шукав зовсім інше.', 'Experience is what you get when looking for something completely different.', 'Опыт - это то, что получаешь, когда искал совсем другое.'), ('Сонце світить усім однаково, але комусь дістається тінь.', 'The sun shines on everyone, but some people manage to find shade.', 'Солнце светит всем одинаково, но кому-то достается тень.'), ('Будильник - це прилад, який дзвонить саме тоді, коли сон найсолодший.', 'An alarm clock is a device designed to ring when sleep is sweetest.', 'Будильник - это прибор, который звонит именно тогда, когда сон слаще всего.'), ('Якщо вам здається, що ви нікому не потрібні, спробуйте запізнитися на роботу.', 'If you think nobody cares about you, try being late for work.', 'Если вам кажется, что вы никому не нужны, попробуйте опоздать на работу.'), ('Пароль повинен бути надійним, але легко забуватися.', 'A password should be secure, yet easily forgotten.', 'Пароль должен быть надежным, но легко забываемым.'), ('Швидкий інтернет - запорука швидкого витрачання вільного часу.', 'Fast internet is the fastest way to spend your free time.', 'Быстрый интернет - залог быстрой траты свободного времени.'), ('Найважче на роботі - це перші вісім годин.', 'The hardest part of a workday is the first eight hours.', 'Труднее всего на работе - это первые восемь часов.'), ('Якщо вам здається, що все йде за планом, перевірте, чий це план.', 'If everything is going according to plan, check whose plan it is.', 'Если вам кажется, что все идет по плану, проверьте, чей это план.'), ('Час лікує все, крім бажання полежати.', 'Time heals everything, except the desire to stay in bed.', 'Время лечит всё, кроме желания полежать.'), ('Понеділок - це не день тижня, це стан душі.', 'Monday is not just a day of the week, it is a state of mind.', 'Понедельник - это не день недели, это состояние души.'), ('Чайник закипає втричі повільніше, якщо пильно на нього дивитися.', 'A kettle boils three times slower when you stare at it.', 'Чайник закипает в три раза медленнее, если пристально на него смотреть.'), ('Справжня мудрість приходить тоді, коли вже пізно щось змінювати.', 'True wisdom arrives right when it is too late to change anything.', 'Настоящая мудрость приходит тогда, когда уже поздно что-то менять.'), ('Якщо вихідні минули непомітно, отже, вони вдалися.', 'If the weekend passed in a flash, it means it went well.', 'Если выходные пролетели незаметно, значит, они удались.')]

class QuoteConverterPlugin(BasePlugin):
    def create_settings(self):
        return [
            Divider(text=_mz_t(
                "Повідомлення, що починаються з .qe, замінюються на випадкову цитату зі списку.",
                "Messages starting with .qe will be replaced with a random quote from the list.",
                "Сообщения, начинающиеся с .qe, будут заменяться на случайную цитату из списка."
            )),
            Selector(
                key="quote_type",
                text=_mz_t("Тип цитат", "Quote category", "Тип цитат"),
                default=0,
                items=[
                    _mz_t("Класичні цитати", "Classic quotes", "Классические цитаты"),
                    _mz_t("Жарти", "Jokes", "Шутки")
                ]
            ),
        ]

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def on_send_message_hook(self, account: int, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()
        message = params.message.strip()
        if message == ".qe" or message.startswith(".qe "):
            quote_type = self.get_setting("quote_type", 0)
            if quote_type == 1 or quote_type == "1":
                q = random.choice(JOKES)
            else:
                q = random.choice(QUOTES)
            params.message = _mz_t(q[0], q[1], q[2])
            return HookResult(
                strategy=HookStrategy.MODIFY,
                params=params
            )
        return HookResult()
