                default="",
                subtext=_mz_t("Формат: ID_чату:Текст підпису;ID_чату2:Текст підпису2", "Format: chat_ID:Signature text;chat_ID2:Signature text 2", "Формат: ID_чата:Текст подписи;ID_чата2:Текст подписи2"),
