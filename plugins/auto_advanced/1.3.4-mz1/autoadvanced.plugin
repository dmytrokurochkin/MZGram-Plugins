            ),
            Divider(text=_mz_t("Налаштування для окремих чатів (для загального підпису)", "Settings for specific chats (for the global signature)", "Настройки для конкретных чатов (для глобальной подписи)")),
            Switch(
                key="restrict_to_selected_chats",
