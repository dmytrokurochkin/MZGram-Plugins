                icon="msg_arrow_down"
            ),
            Divider(text=_mz_t("Застосовувати загальний підпис в:", "Apply the global signature in:", "Применять глобальную подпись в:")),
            Switch(
                key="enable_for_private",
                text=_mz_t("Особистих повідомленнях", "Private messages", "Личных сообщениях"),
                default=True,
                subtext=_mz_t("Додавати підпис в особистих чатах", "Add the signature in private chats", "Добавлять подпись в личных чатах"),
                icon="msg_chat"
            ),
            Switch(
                key="enable_for_groups",
                text=_mz_t("Групах", "Groups", "Группах"),
                default=True,
                subtext=_mz_t("Додавати підпис у звичайних групах і супергрупах", "Add the signature in regular groups and supergroups", "Добавлять подпись в обычных и супергруппах"),
                icon="msg_group"
            ),
            Switch(
                key="enable_for_channels",
                text=_mz_t("Каналах", "Channels", "Каналах"),
