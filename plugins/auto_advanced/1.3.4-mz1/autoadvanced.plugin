                icon="msg_add_contact"
            ),
            Divider(text=_mz_t("Налаштування для окремих чатів (перевизначають загальні)", "Settings for individual chats (override the global ones)", "Настройки для отдельных чатов (переопределяют глобальные)")),
            Switch(
