# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Input, Divider, Switch, Selector
from typing import Any, Dict, List, Tuple
from client_utils import get_messages_controller
from markdown_utils import parse_markdown
from java.util import ArrayList
from org.telegram.tgnet import TLRPC

__id__ = "auto_advanced"
__name__ = "Automatic signature for messages"
__description__ = "Adds a customizable signature to every outgoing message, with formatting support."
__author__ = "MZGram"
__version__ = "1.3.4-mz1"
__min_version__ = "11.12.0"
__category__ = ["chats"]

class AutoSignaturePlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.log("Plugin 'Automatic signature (Extended)' loaded.")

    def create_settings(self):
