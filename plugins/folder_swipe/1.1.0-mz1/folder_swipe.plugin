# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "folder_swipe"
__name__ = "Folder Swipe"
__description__ = "Switch folders by swiping, like on iPhone: a swipe from the middle of the chat list flips folders, and a swipe from the right edge does a chat action (read, pin, etc.)"
__author__ = "MZGram"
__version__ = "1.1.0-mz1"
__min_version__ = "12.10.6"
__category__ = ["appearance", "tools", "chats"]

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class

# Action code 'Change folder' (SwipeGestureSettingsView.SWIPE_GESTURE_FOLDERS)
SWIPE_FOLDERS = 5

# The index in the list matches the action code in SwipeGestureSettingsView
CHAT_ACTION_LABELS = [_mz_t("Закріпити", "Pin", "Закрепить"), _mz_t("Прочитати", "Read", "Прочитать"), _mz_t("Архівувати", "Archive", "Архивировать"), _mz_t("Без звуку", "Mute", "Без звука"), _mz_t("Видалити", "Delete", "Удалить")]
DEFAULT_CHAT_ACTION = 1

# Share of the screen width at the right edge where a swipe counts as a chat swipe
EDGE_LABELS = ["20%", "30%", "40%", "50%"]
EDGE_FRACTIONS = [0.2, 0.3, 0.4, 0.5]
DEFAULT_EDGE = 1

ACTION_DOWN = 0
VIEW_VISIBLE = 0


def _saved_swipe_action():
    # The value from 'Chat settings → Swipe left in the chat list', as it is saved on disk
    from java import jclass
    context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
    prefs = context.getSharedPreferences("mainconfig", 0)
    return int(prefs.getInt("ChatSwipeAction", -1))


def _int_or_none(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _index_setting(plugin, key, default, size):
    try:
        index = int(plugin.get_setting(key, default))
    except Exception:
        index = default
    return index if 0 <= index < size else default


class SwipeActionSetter:
    """Changes the swipe action that Telegram reads through SharedConfig.getChatSwipeAction(). The main path is the private chatSwipeAction field (memory only). If there is no field with that name, the public updateChatListSwipeSetting is used, which also saves the value, so it is called only when the value changes."""

    def __init__(self, logger):
        self.field = None
        self.last = None
        try:
            field = find_class("org.telegram.messenger.SharedConfig").getDeclaredField("chatSwipeAction")
            field.setAccessible(True)
            field.getInt(None)
            self.field = field
        except Exception as e:
            logger.info("Folder swipe: no chatSwipeAction field (%r), using updateChatListSwipeSetting" % (e,))

    def set(self, value):
        if self.field is not None:
            self.field.setInt(None, value)
        elif value != self.last:
            self._update(value)
        self.last = value

    def _update(self, value):
        from java import jclass
        jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(value)


class TouchDownHook(MethodHook):
    """DialogsActivity.ContentView.onInterceptTouchEvent. Called on every touch, before the chat list and ContentView decide what to do with the swipe, so the action is chosen at the moment of touch: at the right edge, a chat action; elsewhere, a folder switch."""

    def __init__(self, plugin, setter):
        self.plugin = plugin
        self.setter = setter

    def before_hooked_method(self, param):
        try:
            ev = param.args[0]
            if ev is None or ev.getActionMasked() != ACTION_DOWN:
                return
            view = param.thisObject
            width = view.getWidth()
            if width <= 0:
                return
            # Without visible folder tabs (no folders, tabs hidden, archive open) Telegram
            # would archive the chat for 'Change folder', so there it always does the chat action
            if not self._folder_tabs_visible(view):
                zone = _mz_t("немає вкладок → чат", "no tabs → chat", "нет вкладок → чат")
                action = self.plugin.chat_action()
            elif ev.getX() >= width * (1 - self.plugin.edge_fraction()):
                zone = _mz_t("край → чат", "edge → chat", "край → чат")
                action = self.plugin.chat_action()
            else:
                zone = _mz_t("середина → тека", "middle → folder", "середина → папка")
                action = SWIPE_FOLDERS
            self.setter.set(action)
            if self.plugin.get_setting("debug", False):
                self._show_debug(view, zone)
        except Exception as e:
            self.plugin.logger.error("Folder swipe: touch handling failed: %r" % (e,))

    def _folder_tabs_visible(self, view):
        # FilterTabsView is a direct child of ContentView (see ContentView.onLayout)
        for i in range(view.getChildCount()):
            child = view.getChildAt(i)
            if child.getClass().getName().endswith("FilterTabsView"):
                return child.getVisibility() == VIEW_VISIBLE
        # Tabs not found (different layout in this version): do not block folder swipes
        return True

    def _show_debug(self, view, zone):
        from java import jclass
        from android.widget import Toast
        account = jclass("org.telegram.messenger.UserConfig").selectedAccount
        actual = jclass("org.telegram.messenger.SharedConfig").getChatSwipeAction(account)
        Toast.makeText(view.getContext(), _mz_t("%s (дія %d)", "%s (action %d)", "%s (действие %d)") % (zone, actual), 0).show()


class FolderSwipePlugin(BasePlugin):
    def on_plugin_load(self):
        self.setter = None
        try:
            self._remember_original_action()
            self.setter = SwipeActionSetter(self.logger)
            content_view = find_class("org.telegram.ui.DialogsActivity$ContentView")
            self.hook_all_methods(content_view, "onInterceptTouchEvent", TouchDownHook(self, self.setter))
            self.logger.info("Folder swipe enabled")
        except Exception as e:
            self.logger.error("Folder swipe: failed to enable: %r" % (e,))

    def on_plugin_unload(self):
        # Restore the swipe setting that Telegram had before the plugin was enabled
        try:
            if self.setter is not None and self.setter.field is not None:
                # The plugin changed the value in memory only: the user's setting lies on disk
                # (including changes the user made in chat settings while the plugin was enabled)
                self.setter.set(_saved_swipe_action())
            else:
                original = _int_or_none(self.get_setting("original_swipe_action", None))
                if original is not None:
                    from java import jclass
                    jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(original)
            # The original setting is remembered again on the next enable
            self.set_setting("original_swipe_action", "")
        except Exception as e:
            self.logger.error("Folder swipe: failed to disable: %r" % (e,))

    def _remember_original_action(self):
        if _int_or_none(self.get_setting("original_swipe_action", None)) is not None:
            # The plugin was not turned off cleanly (for example, the app was closed): the original is already saved
            return
        current = _saved_swipe_action()
        # Early test versions wrote the setting to disk and saved the original in prev_action
        legacy = _int_or_none(self.get_setting("prev_action", None))
        original = legacy if legacy is not None else current
        if legacy is not None:
            self.set_setting("prev_action", "")
            if legacy != current:
                from java import jclass
                jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(legacy)
        self.set_setting("original_swipe_action", original)

    def chat_action(self):
        return _index_setting(self, "chat_action", DEFAULT_CHAT_ACTION, len(CHAT_ACTION_LABELS))

    def edge_fraction(self):
        return EDGE_FRACTIONS[_index_setting(self, "edge_width", DEFAULT_EDGE, len(EDGE_FRACTIONS))]

    def create_settings(self):
        from ui.settings import Header, Selector, Switch, Text
        return [
            Header(text=_mz_t("Свайпи в списку чатів", "Swipes in the chat list", "Свайпы в списке чатов")),
            Selector(
                key="chat_action",
                text=_mz_t("Свайп від правого краю", "Swipe from the right edge", "Свайп от правого края"),
                default=DEFAULT_CHAT_ACTION,
                items=CHAT_ACTION_LABELS,
            ),
            Selector(
                key="edge_width",
                text=_mz_t("Ширина зони біля краю", "Width of the edge zone", "Ширина зоны у края"),
                default=DEFAULT_EDGE,
                items=EDGE_LABELS,
            ),
            Switch(
                key="debug",
                text=_mz_t("Режим налагодження", "Debug mode", "Режим отладки"),
                default=False,
            ),
            Text(text=_mz_t("Свайп, розпочатий біля правого краю, виконує дію над чатом. Свайп із середини або лівої частини екрана перемикає теки (вліво: наступна, вправо: попередня). Теки мають бути показані вкладками над списком чатів. У режимі налагодження при кожному дотику показується, який жест вибрано.", "A swipe that starts at the right edge performs a chat action. A swipe from the middle or left part of the screen switches folders (left: next, right: previous). Folders must be shown as tabs above the chat list. In debug mode each touch shows which gesture was chosen.", "Свайп, начатый у правого края, выполняет действие над чатом. Свайп из середины или левой части экрана переключает папки (влево — следующая, вправо — предыдущая). Папки должны быть показаны вкладками над списком чатов. В режиме отладки при каждом касании показывается, какой жест выбран.")),
        ]
