# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "neural_typing"
__name__ = "Neural Typing"
__description__ = "Incoming messages appear on screen gradually, as if a neural network generated them in real time (the streaming effect of an AI reply). Pure cosmetics on your side, the other person sees nothing."
__version__ = "1.3.7-mz1"
__author__ = "MZGram"
__min_version__ = "11.12.0"
__category__ = ["appearance"]

import threading
import time
import random
import traceback

from base_plugin import BasePlugin
from android_utils import run_on_ui_thread
from ui.settings import Header, Switch, Divider, Input
from java import jclass
from java.util import ArrayList

DEFAULT_TICK_MS = 22
DEFAULT_CHARS_PER_TICK = 1
DEFAULT_MAX_LEN = 4096
DEFAULT_START_PAUSE_MS = 600
STEPS_TARGET = 60  # long messages are printed in chunks, so the effect fits
                   # into roughly this many steps, instead of dragging on for minutes
CURSOR = "▍"
FRESH_WINDOW_SEC = 15  # animate only the newly arrived ones, not the history while scrolling


class CellBindHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_cell_bound(param)
        except Exception as e:
            self.plugin.log(f"[NeuralTyping] bind hook: {e}")


class NeuralTypingPlugin(BasePlugin):

    def on_plugin_load(self):
        self._hooks = []
        self._timers = {}        # tkey -> threading.Timer
        self._done = {}          # msg_id -> True (already animated), incoming
        self._recent_out = {}    # (dialog_id, text) -> ts, outgoing that are already finished
        self._active_out = {}    # (dialog_id, text) -> anim, outgoing that are still running
        self._suppress = False   # recursion guard: our rebind triggers the same hook
        self._tk = 0             # counter of stable timer keys
        try:
            cell_cls = jclass("org.telegram.ui.Cells.ChatMessageCell")
            self._hooks = self.hook_all_methods(
                cell_cls.getClass(), "setMessageObject", CellBindHook(self))
        except Exception as e:
            self.log(f"[NeuralTyping] hook: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        for t in list(self._timers.values()):
            try:
                t.cancel()
            except Exception:
                pass
        self._timers.clear()
        hooks = self._hooks or []
        for h in (hooks if isinstance(hooks, (list, tuple)) else [hooks]):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []

    def _int_setting(self, key, default, lo, hi):
        try:
            return max(lo, min(hi, int(self.get_setting(key, str(default)))))
        except Exception:
            return default

    def _word_stops(self, full):
        # end positions of each word (the word plus the spaces after it), where
        # printing stops in the "by words" mode
        stops = []
        i, n = 0, len(full)
        while i < n:
            j = i
            while j < n and not full[j].isspace():
                j += 1
            while j < n and full[j].isspace():
                j += 1
            stops.append(j)
            i = j
        return stops

    def _advance(self, anim):
        # next print boundary: by words (step through stops) or by characters
        stops = anim.get("stops")
        if stops:
            anim["stop_idx"] += anim["words_per_step"]
            idx = anim["stop_idx"]
            return stops[idx] if idx < len(stops) else len(anim["full"])
        return anim["pos"] + anim["step_chars"]

    def _snapshot_entities(self, mo):
        # remember entities (bold, quote, code, links, custom emoji) with their
        # original offset/length, so they can be cut to the text length while printing
        out = []
        try:
            ents = mo.messageOwner.entities
            if ents is not None:
                for i in range(ents.size()):
                    e = ents.get(i)
                    out.append((e, int(e.offset), int(e.length)))
        except Exception:
            pass
        return out

    def _set_entities(self, mo, anim, n):
        # keep only entities that fall within the first n characters, and trim
        # their length, otherwise applyNewText would apply formatting outside the text
        ents = anim.get("entities")
        if not ents:
            return
        try:
            lst = ArrayList()
            for e, off, ln in ents:
                if n is None:                 # None means the full original
                    e.length = ln
                    lst.add(e)
                elif off < n:
                    e.length = min(ln, n - off)
                    lst.add(e)
            mo.messageOwner.entities = lst
        except Exception:
            pass

    # ---- start the animation when a message appears --------------------------

    def on_cell_bound(self, param):
        if self._suppress or not self.get_setting("enabled", True):
            return
        args = list(param.args or [])
        mo = args[0] if args else None
        if mo is None:
            return
        try:
            msg_id = int(mo.getId())
            outgoing = mo.isOutOwner()
            if outgoing:
                if not self.get_setting("animate_outgoing", False):
                    return
            elif msg_id <= 0 or msg_id in self._done:
                return
            if self.get_setting("only_private", False) and int(mo.getDialogId()) < 0:
                return
            date = int(getattr(mo.messageOwner, "date", 0) or 0)
            if time.time() - date > FRESH_WINDOW_SEC:
                return
            full_cs = mo.messageText
            full = str(full_cs or "")
            if len(full) < 2 or len(full) > self._int_setting("max_len", DEFAULT_MAX_LEN, 10, 4096):
                return
            # an outgoing message is rebound to a new cell/object when sent
            # (temp id -> real id). If the animation is already running, don't skip the bind,
            # but PASS it to the new object and trim it at once, otherwise Telegram
            # shows the full text (flicker). If it has already finished, skip.
            sig = None
            if outgoing:
                sig = (int(mo.getDialogId()), full)
                now = time.time()
                active = self._active_out.get(sig)
                if active is not None:
                    active["mo"] = mo
                    active["cell"] = param.thisObject
                    active["args"] = args
                    active["msg_id"] = msg_id
                    active["entities"] = self._snapshot_entities(mo)
                    try:
                        self._apply_text(mo, active, active["pos"])
                        self._redraw(param.thisObject, active)
                    except Exception:
                        pass
                    return
                if now - self._recent_out.get(sig, 0) < 12:
                    return
            entities = self._snapshot_entities(mo)
        except Exception:
            return

        if not outgoing:
            self._done[msg_id] = True
            if len(self._done) > 500:
                for k in list(self._done)[:250]:
                    self._done.pop(k, None)

        # for long messages increase the step, but not faster than the set value
        base = self._int_setting("chars_per_tick", DEFAULT_CHARS_PER_TICK, 1, 50)
        step_chars = max(base, -(-len(full) // STEPS_TARGET))

        # "by words" mode: step to the end of the word; for long ones, several words at a time
        stops = self._word_stops(full) if self.get_setting("by_words", False) else None
        if not stops:
            stops = None
        if stops:
            words_per_step = max(1, -(-len(stops) // STEPS_TARGET))
            stop_idx = words_per_step - 1
            init_pos = stops[min(stop_idx, len(stops) - 1)]
        else:
            words_per_step = 1
            stop_idx = 0
            init_pos = step_chars

        self._tk += 1
        anim = {
            "mo": mo,
            "cell": param.thisObject,
            "args": args,
            "full": full,
            "pos": init_pos,
            "msg_id": msg_id,
            "step_chars": step_chars,
            "entities": entities,
            "stops": stops,
            "stop_idx": stop_idx,
            "words_per_step": words_per_step,
            "sig": sig,          # non-empty only for outgoing
            "tkey": self._tk,    # stable timer key (the id changes when sent)
        }
        if sig is not None:
            self._active_out[sig] = anim
        # trim the text right at the moment of binding, otherwise the full message
        # would flash for a frame until the first timer tick
        try:
            self._apply_text(mo, anim, init_pos)
            self._redraw(anim["cell"], anim)
        except Exception:
            pass
        self._schedule(anim)

    def _schedule(self, anim):
        # DeepSeek style: the first characters appear, a pause, then even printing
        if (anim["pos"] > 0 and not anim.get("start_pause_done")
                and self.get_setting("start_pause", False)):
            anim["start_pause_done"] = True
            tick = self._int_setting("start_pause_ms", DEFAULT_START_PAUSE_MS, 100, 3000) / 1000.0
        else:
            tick = self._int_setting("tick_ms", DEFAULT_TICK_MS, 10, 500) / 1000.0
            # live speed: uneven interval, like real streaming
            if self.get_setting("jitter", True):
                tick *= random.uniform(0.55, 1.6)
        t = threading.Timer(tick, lambda: run_on_ui_thread(lambda: self._step(anim)))
        t.daemon = True
        self._timers[anim["tkey"]] = t
        t.start()

    # ---- text replacement ---------------------------------------------------
    # applyNewText + resetLayout is the way (as translators do) to replace the text in
    # an existing message and make the cell redraw; simply assigning
    # messageText is not enough, the cell keeps a cached layout.

    def _apply_text(self, mo, anim, n):
        # trim entities (formatting) to n characters, then set the text
        self._set_entities(mo, anim, n)
        prefix = anim["full"][:n]
        payload = prefix + CURSOR if self.get_setting("cursor", True) else prefix
        mo.applyNewText(payload)
        try:
            mo.resetLayout()
        except Exception:
            pass

    def _restore_text(self, mo, anim):
        self._set_entities(mo, anim, None)  # return the full entities
        try:
            mo.applyNewText()  # no argument means the original with entities and emoji
        except Exception:
            try:
                mo.applyNewText(anim["full"])
            except Exception:
                pass
        try:
            mo.resetLayout()
        except Exception:
            pass

    def _redraw(self, cell, anim):
        self._suppress = True
        try:
            cell.setMessageObject(*anim["args"])
        except Exception:
            pass
        finally:
            self._suppress = False
        try:
            cell.requestLayout()
            cell.invalidate()
        except Exception:
            pass

    def _finish_out(self, anim):
        sig = anim.get("sig")
        if sig is not None:
            self._active_out.pop(sig, None)
            self._recent_out[sig] = time.time()

    def _step(self, anim):
        self._timers.pop(anim["tkey"], None)
        mo = anim["mo"]
        cell = anim["cell"]
        try:
            # while scrolling the cell could be rebound to another message
            cur = cell.getMessageObject()
            alive = cur is not None and int(cur.getId()) == anim["msg_id"]

            anim["pos"] = self._advance(anim)
            if not alive or anim["pos"] >= len(anim["full"]):
                self._restore_text(mo, anim)
                if alive:
                    self._redraw(cell, anim)
                self._finish_out(anim)
                return

            self._apply_text(mo, anim, anim["pos"])
            self._redraw(cell, anim)
            self._schedule(anim)
        except Exception as e:
            self._restore_text(mo, anim)
            self._finish_out(anim)
            self.log(f"[NeuralTyping] step: {e}")

    # ---- settings --------------------------------------------------------

    def create_settings(self):
        return [
            Header(text="Neural Typing"),
            Switch(key="enabled", text=_mz_t("Увімкнено", "Enabled", "Включено"), default=True),
            Switch(key="cursor", text=_mz_t("Курсор під час друку", "Typing cursor", "Курсор при печати"),
                   subtext=_mz_t(f"Показувати «{CURSOR}» в кінці тексту, що з'являється", f"Show «{CURSOR}» at the end of the appearing text", f"Показывать «{CURSOR}» в конце появляющегося текста"), default=True),
            Switch(key="by_words", text=_mz_t("По словах", "By words", "По словам"),
                   subtext=_mz_t("З'являється цілими словами (до пробілу), а не по одній літері", "Appears in whole words (up to a space), not letter by letter", "Появляется целыми словами (до пробела), а не по одной букве"),
                   default=False),
            Switch(key="jitter", text=_mz_t("Жива швидкість", "Live speed", "Живая скорость"),
                   subtext=_mz_t("Нерівномірний інтервал друку, схоже на справжній стримінг ШІ, а не механічно рівно", "Uneven print interval that looks like real AI streaming, not mechanically even", ("Неравномерный интервал печати — выглядит как настоящий стриминг ИИ, "
                           "а не механически ровно")), default=True),
            Switch(key="only_private", text=_mz_t("Лише особисті чати", "Private chats only", "Только личные чаты"),
                   subtext=_mz_t("Не анімувати повідомлення в групах і каналах", "Don't animate messages in groups and channels", "Не анимировать сообщения в группах и каналах"), default=False),
            Switch(key="animate_outgoing", text=_mz_t("Анімувати свої повідомлення", "Animate my messages", "Анимировать свои сообщения"),
                   subtext=_mz_t("Друкувати ефектом і ваші надіслані (можливе коротке миготіння повного тексту через штатну анімацію надсилання)", "Also apply the effect to the messages you send (a brief flash of the full text may appear because of the built-in send animation)", ("Печатать эффектом и ваши отправленные (возможно короткое мелькание "
                           "полного текста из-за штатной анимации отправки)")), default=False),
            Switch(key="start_pause", text=_mz_t("Пауза після перших символів", "Pause after the first characters", "Пауза после первых символов"),
                   subtext=_mz_t("Перші символи з'являються, коротка пауза, а далі рівний друк (як у DeepSeek)", "The first characters appear, a short pause, then even printing (like DeepSeek)", "Первые символы появляются, короткая пауза — и дальше ровная печать (как у DeepSeek)"),
                   default=False),
            Input(key="start_pause_ms", text=_mz_t("Тривалість паузи (мс)", "Pause length (ms)", "Длительность паузы (мс)"),
                  default=str(DEFAULT_START_PAUSE_MS),
                  subtext=_mz_t("Пауза після перших символів, 100–3000 мс", "Pause after the first characters, 100–3000 ms", "Пауза после первых символов, 100–3000 мс")),
            Divider(),
            Input(key="chars_per_tick", text=_mz_t("Символів за крок", "Characters per step", "Символов за шаг"),
                  default=str(DEFAULT_CHARS_PER_TICK),
                  subtext=_mz_t("Скільки символів з'являється за один крок (1–50)", "How many characters appear per step (1–50)", "Сколько символов появляется за один шаг (1–50)")),
            Input(key="tick_ms", text=_mz_t("Інтервал кроку (мс)", "Step interval (ms)", "Интервал шага (мс)"),
                  default=str(DEFAULT_TICK_MS),
                  subtext=_mz_t("Пауза між кроками, 10–500 мс, менше означає плавніше", "Pause between steps, 10–500 ms, less means smoother", "Пауза между шагами, 10–500 мс — меньше значит плавнее")),
            Input(key="max_len", text=_mz_t("Максимальна довжина", "Maximum length", "Максимальная длина"),
                  default=str(DEFAULT_MAX_LEN),
                  subtext=_mz_t("Довші повідомлення не анімуються (типово 4096, максимум Telegram)", "Longer messages are not animated (default 4096, Telegram maximum)", "Сообщения длиннее не анимируются (по умолчанию 4096 — максимум Telegram)")),
        ]
