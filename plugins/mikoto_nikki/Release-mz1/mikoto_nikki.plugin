# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from ui.alert import AlertDialogBuilder
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread, log
from hook_utils import find_class
from java import dynamic_proxy

LinearLayout = find_class("android.widget.LinearLayout")
TextView = find_class("android.widget.TextView")
Button = find_class("android.widget.Button")
ScrollView = find_class("android.widget.ScrollView")
Theme = find_class("org.telegram.ui.ActionBar.Theme")
AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
Gravity = find_class("android.view.Gravity")
Typeface = find_class("android.graphics.Typeface")

from android.view import View, ViewGroup
from android.widget import FrameLayout, ImageView
from android.os import Handler, Looper
from android.graphics import Bitmap, Canvas, ColorMatrix, ColorMatrixColorFilter, Paint

__id__ = "mikoto_nikki"
__name__ = "Mikoto's Diary"
__description__ = "Adaptation of a 2013 visual novel inside exteraGram"
__author__ = "@KangelPlugins & @TomokoPlugins"
__version__ = "Release-mz1"
__min_version__ = "11.12.0"
__icon__ = "yunochkaaaaaaa/78"
__category__ = ["fun"]

DEFAULT_SHOW_IN_CHAT_ACTION = True
DEFAULT_SHOW_IN_DRAWER = True

class VisualNovelDemoPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sessions = {} 
        self._dbg = False
        self._active_overlay = None
        self._anim_handler = None
        self._black_overlay = None

    def on_plugin_load(self):
        self._update_menu_items()
        self._dlog("loaded")

    def on_plugin_unload(self):
        self._dlog("unloaded")
        try:
            for s in list(self._sessions.values()):
                try:
                    dlg = s.get("dialog")
                    if dlg:
                        self._safe_dismiss_dialog(dlg)
                except Exception:
                    pass
            self._sessions.clear()
        except Exception:
            pass
        try:
            if self._active_overlay is not None:
                overlay = self._active_overlay
                self._active_overlay = None
                run_on_ui_thread(lambda: self._safe_remove_overlay(overlay))
            if getattr(self, "_black_overlay", None) is not None:
                ov = self._black_overlay
                self._black_overlay = None
                run_on_ui_thread(lambda: self._safe_remove_overlay(ov))
        except Exception:
            pass

    def _dlog(self, msg: str):
        try:
            if getattr(self, "_dbg", False):
                log(f"[VN] {msg}")
        except Exception:
            pass


    def _update_menu_items(self):
        try:
            for i in getattr(self, "_menu_item_ids", []):
                try:
                    self.remove_menu_item(i)
                except Exception:
                    pass
        except Exception:
            pass
        self._menu_item_ids = []
        self._menu_item_ids.append(self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=_mz_t("Щоденник Микото", "Mikoto's Diary", "Дневник Микото"), icon="msg_groups_hw_remix", on_click=self._open_demo)))
        self._menu_item_ids.append(self.add_menu_item(MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text=_mz_t("Щоденник Микото", "Mikoto's Diary", "Дневник Микото"), icon="msg_groups_hw_remix", on_click=self._open_demo)))

    def _open_demo(self, context: dict):
        chat_id = context.get("dialog_id")
        fragment = get_last_fragment()
        activity = fragment and fragment.getParentActivity()
        if not activity:
            return
        self._dlog(f"open_vn chat={chat_id}")

        builder = AlertDialogBuilder(activity)
        builder.set_title(_mz_t("Щоденник Микото", "Mikoto's Diary", "Дневник Микото"))

        main = LinearLayout(activity)
        main.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(16)
        main.setPadding(pad, pad, pad, pad)

        text_view = TextView(activity)
        text_view.setTextSize(16)
        text_view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        text_view.setTypeface(None, Typeface.BOLD)
        text_view.setPadding(0, 0, 0, AndroidUtilities.dp(12))

        choices = LinearLayout(activity)
        choices.setOrientation(LinearLayout.VERTICAL)
        choices.setPadding(0, AndroidUtilities.dp(6), 0, 0)

        def make_btn(label, cb):
            btn = Button(activity)
            btn.setText(label)
            btn.setAllCaps(False)
            btn.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8))
            btn.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            btn.setBackgroundColor(Theme.getColor(Theme.key_chat_attachPhotoBackground))
            # OnClickListener via dynamic proxy
            OnClickListenerInterface = find_class("android.view.View$OnClickListener")
            class _L(dynamic_proxy(OnClickListenerInterface)):
                def __init__(self, fn):
                    super().__init__()
                    self.fn = fn
                def onClick(self, v):
                    try:
                        self.fn()
                    except Exception as e:
                        log(f"[VN] click error: {e}")
            btn.setOnClickListener(_L(cb))
            return btn

        main.addView(text_view)
        main.addView(choices)
        builder.set_view(main)
        dialog = builder.show()

        self._sessions[chat_id] = {
            "dialog": dialog,
            "text": text_view,
            "choices": choices,
            "state": "prologue1",
            "flags": {"happy": False, "flash": False},
            "di_idx": 0
        }
        self._render_state(chat_id)

    def _render_state(self, chat_id):
        s = self._sessions.get(chat_id)
        if not s:
            return
        tv = s["text"]
        ch = s["choices"]
        try:
            ch.removeAllViews()
        except Exception:
            pass
        st = s["state"]
        flags = s.get("flags", {})
        self._dlog(f"render state={st}")

        def add_choice(label, handler):
            btn = Button(ch.getContext())
            btn.setText(label)
            btn.setAllCaps(False)
            btn.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8))
            btn.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            btn.setBackgroundColor(Theme.getColor(Theme.key_chat_attachPhotoBackground))
            OnClickListenerInterface = find_class("android.view.View$OnClickListener")
            class _L(dynamic_proxy(OnClickListenerInterface)):
                def __init__(self, fn):
                    super().__init__()
                    self.fn = fn
                def onClick(self, v):
                    try:
                        self.fn()
                    except Exception as e:
                        log(f"[VN Demo] click error: {e}")
            btn.setOnClickListener(_L(handler))
            params = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            params.setMargins(0, AndroidUtilities.dp(6), 0, 0)
            btn.setLayoutParams(params)
            ch.addView(btn)

        if st == "prologue1":
            tv.setText(_mz_t("Пролог.\n\nМатаро набирається сміливості й дивиться Микото в очі. Що сказати?\n\n", "Prologue.\n\nMataro works up the courage and looks Mikoto in the eyes. What do you say?\n\n", "Пролог.\n\nМатаро набирается смелости и смотрит Микото в глаза. Что сказать?\n\n"))
            add_choice(_mz_t("Я люблю тебе всім серцем!", "I love you with all my heart!", "Я люблю тебя всем сердцем!"), lambda: self._set_state(chat_id, "prologue2"))
            add_choice(_mz_t("…Я давно хотів це сказати…", "…I've wanted to say this for a long time…", "…Я давно хотел это сказать…"), lambda: self._set_state(chat_id, "prologue2"))
        elif st == "prologue2":
            tv.setText(_mz_t("Микото м'яко усміхається.\n\nВона: «Добре…»\n\nТи відповідаєш?\n", "Mikoto smiles gently.\n\nShe says: “Okay…”\n\nDo you answer?\n", "Микото мягко улыбается.\n\nОна: «Хорошо…»\n\nТы отвечаешь?\n"))
            add_choice(_mz_t("Будь ласка, будь добра й до мене.", "Please, be kind to me too.", "Пожалуйста, будь добра ко мне тоже."), lambda: (self._on_window_glitch(chat_id), self._set_state(chat_id, "prologue3")))
        elif st == "prologue3":
            tv.setText(_mz_t("І ще одна думка вголос: чого ти насправді хочеш?\n", "And one more thought out loud: what do you really want?\n", "И ещё одна мысль вслух — что ты по‑настоящему хочешь?\n"))
            add_choice(_mz_t("Я хочу зробити Микото щасливою.", "I want to make Mikoto happy.", "Я хочу сделать Микото счастливой."), lambda: (flags.__setitem__("happy", True), self._set_state(chat_id, "entry")))
            add_choice(_mz_t("Я хочу бути з Микото назавжди.", "I want to be with Mikoto forever.", "Я хочу быть с Микото навсегда."), lambda: (flags.__setitem__("happy", False), self._set_state(chat_id, "entry")))
        elif st == "entry":
            tv.setText(_mz_t("Біля дому Микото. Вона запрошує всередину.\n\nЩо відповісти по дорозі?\n", "At Mikoto's house. She invites you inside.\n\nWhat do you say on the way in?\n", "У дома Микото. Она приглашает внутрь.\n\nЧто ответить по пути?\n"))
            add_choice(_mz_t("Вибач за вторгнення.", "Sorry for barging in.", "Прошу прощения за вторжение."), lambda: self._set_state(chat_id, "entry_reply1"))
            add_choice(_mz_t("Мені тут подобається.", "I like it here.", "Мне нравится здесь."), lambda: self._set_state(chat_id, "entry_reply2"))
            add_choice(_mz_t("Як пізно можна залишитися?", "How late can I stay?", "Как поздно можно остаться?"), lambda: self._set_state(chat_id, "entry_reply3"))
            add_choice(_mz_t("Що будеш готувати?", "What are you going to cook?", "Что будешь готовить?"), lambda: self._set_state(chat_id, "entry_reply4"))
        elif st == "entry_reply1":
            tv.setText(_mz_t("Ти: «Вибач за вторгнення.»\n\nМикото: «Дурненький, я рада, що ти прийшов.»\nЇї голос спокійний, майже шепіт.", "You: “Sorry for barging in.”\n\nMikoto: “Silly, I'm glad you came.”\nHer voice is calm, almost a whisper.", "Ты: «Прошу прощения за вторжение.»\n\nМикото: «Глупыш, я рада, что ты пришёл.»\nЕё голос спокойный, почти шёпот.") )
            add_choice(_mz_t("Далі", "Next", "Дальше"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "entry_reply2":
            tv.setText(_mz_t("Ти: «Мені тут подобається.»\n\nМикото: «Справді? Я старалася підтримувати затишок… для особливих гостей.»", "You: “I like it here.”\n\nMikoto: “Really? I've tried to keep it cozy… for special guests.”", "Ты: «Мне нравится здесь.»\n\nМикото: «Правда? Я старалась поддерживать уют… для особенных гостей.»") )
            add_choice(_mz_t("Далі", "Next", "Дальше"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "entry_reply3":
            tv.setText(_mz_t("Ти: «Як пізно можна залишитися?»\n\nМикото: «Не поспішаю. Можеш залишитися… скільки захочеш.»\nПогляд застрягає на зачиненій шафі.", "You: “How late can I stay?”\n\nMikoto: “I'm not rushing you. You can stay… as long as you like.”\nYour gaze gets stuck on the closed closet.", "Ты: «Как поздно можно остаться?»\n\nМикото: «Не тороплю. Можешь остаться… сколько захочешь.»\nВзгляд залипает на закрытом шкафу.") )
            # Light foreshadowing: a short glitch
            self._on_window_glitch(chat_id)
            add_choice(_mz_t("Далі", "Next", "Дальше"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "entry_reply4":
            tv.setText(_mz_t("Ти: «Що будеш готувати?»\n\nМикото: «Омлет з рисом… І мускатний чай. Думаю, тобі сподобається.»", "You: “What are you going to cook?”\n\nMikoto: “Rice omelet… And nutmeg tea. I think you'll like it.”", "Ты: «Что будешь готовить?»\n\nМикото: «Омлет с рисом… И мускатный чай. Думаю, тебе понравится.»") )
            add_choice(_mz_t("Далі", "Next", "Дальше"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "kitchen_opt":
            tv.setText(_mz_t("Кухня. Микото ставить чайник і зазирає в холодильник.\n", "Kitchen. Mikoto puts the kettle on and peeks into the fridge.\n", "Кухня. Микото ставит чайник и заглядывает в холодильник.\n"))
            add_choice(_mz_t("Поговорити про чай", "Talk about tea", "Поговорить о чае"), lambda: self._set_state(chat_id, "kitchen_tea"))
            add_choice(_mz_t("Поговорити про їжу", "Talk about food", "Поговорить о еде"), lambda: self._set_state(chat_id, "kitchen_food"))
            add_choice(_mz_t("Піти оглянути дім", "Go explore the house", "Пойти исследовать дом"), lambda: self._set_state(chat_id, "diaries_intro"))
        elif st == "kitchen_tea":
            tv.setText(_mz_t("Ти: «Чорний? Персиковий? Що любиш?»\nМикото: «Для гостей у мене завжди є персиковий. Але… сьогодні, може, мускатний?»\n", "You: “Black? Peach? What do you like?”\nMikoto: “I always keep peach for guests. But… maybe nutmeg today?”\n", "Ты: «Чёрный? Персиковый? Что любишь?»\nМикото: «Для гостей у меня всегда есть персиковый. Но… сегодня, может, мускатный?»\n"))
            add_choice(_mz_t("Кивнути", "Nod", "Кивнуть"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "kitchen_food":
            tv.setText(_mz_t("Ти: «Чим пригостиш?»\nМикото: «Омлет з рисом, моя коронна страва. Кажуть, смачно… Тому я стараюся ще більше.»\n", "You: “What will you treat me to?”\nMikoto: “Rice omelet is my specialty. They say it's tasty… So I try even harder.”\n", "Ты: «Чем угостишь?»\nМикото: «Омлет с рисом — моя коронка. Говорят, вкусно… Тогда я стараюсь ещё сильнее.»\n"))
            add_choice(_mz_t("Усміхнутися", "Smile", "Улыбнуться"), lambda: self._set_state(chat_id, "kitchen_opt"))
        elif st == "diaries_intro":
            tv.setText(_mz_t("Ти виходиш у коридор. На підлозі клаптик паперу.\n«…Щоденник?»\n\nЗбери уривки, щоб зрозуміти, що відбувається.\n", "You step into the hallway. A scrap of paper lies on the floor.\n“…A diary?”\n\nCollect the fragments to figure out what's going on.\n", "Ты выходишь в коридор. На полу — клочок бумаги.\n«…Дневник?»\n\nСобери обрывки, чтобы понять, что происходит.\n"))
            add_choice(_mz_t("Почати читати уривки", "Start reading the fragments", "Начать читать обрывки"), lambda: (s.__setitem__("di_idx", 1), self._on_window_glitch(chat_id), self._set_state(chat_id, "diary_show")))
        elif st == "diary_show":
            idx = int(s.get("di_idx", 1))
            scraps = self._get_diary_scraps_ru()
            total = len(scraps)
            idx = max(1, min(idx, total))
            title, lines = scraps[idx-1]
            tv.setText(f"{title}\n\n" + "\n".join(lines))
            if idx < total:
                add_choice(_mz_t("Далі", "Next", "Далее"), lambda: (s.__setitem__("di_idx", idx+1), self._set_state(chat_id, "diary_show")))
            else:
                add_choice(_mz_t("Далі", "Next", "Дальше"), lambda: self._set_state(chat_id, "pre_closet"))
        elif st == "pre_closet":
            tv.setText(_mz_t("У комірці замкнено. Здається, десь має бути ліхтарик…\n\nВзяти його, перш ніж іти?\n", "The storage room is locked. There should be a flashlight somewhere…\n\nTake it before you go?\n", "В кладовке заперто. Кажется, где‑то должен быть фонарик…\n\nВзять его перед тем, как идти?\n"))
            add_choice(_mz_t("Узяти ліхтарик", "Take the flashlight", "Взять фонарик"), lambda: (flags.__setitem__("flash", True), self._set_state(chat_id, "closet")))
            add_choice(_mz_t("Іти до шафи", "Go to the closet", "Идти к шкафу"), lambda: self._set_state(chat_id, "closet"))
        elif st == "closet":
            tv.setText(_mz_t("Замок піддається. Усередині темрява й важкий запах. Кілька тіл…\n\nМикото, пошепки: «Я замкнула батьків… вони називали мене чудовиськом. Потім Юкимару. Я думала, він зрозуміє…»\nВона: «Ти втечеш, як він?»\n", "The lock gives way. Inside is darkness and a heavy smell. Several bodies…\n\nMikoto, whispering: “I locked my parents in… they called me a monster. Then Yukimaru. I thought he would understand…”\nShe says: “Will you run away, like he did?”\n", "Замок поддаётся. Внутри — мрак и тяжёлый запах. Несколько тел…\n\nМикото, шёпотом: «Я заперла родителей… они называли меня чудовищем. Потом — Юкимару. Я думала, он поймёт…»\nОна: «Ты убежишь, как он?»\n"))
            if not flags.get("g_closet", False):
                flags.__setitem__("g_closet", True)
                self._on_window_glitch(chat_id)
            if not flags.get("flash", False):
                add_choice(_mz_t("Зайти без ліхтарика", "Go in without the flashlight", "Зайти без фонарика"), lambda: self._set_state(chat_id, "bad_noflash"))
            add_choice(_mz_t("Утекти", "Run away", "Убежать"), lambda: self._set_state(chat_id, "bad_run"))
            add_choice(_mz_t("Залишитися з Микото", "Stay with Mikoto", "Остаться с Микото"), lambda: self._set_state(chat_id, "bad_stay"))
            add_choice(_mz_t("Обійняти Микото", "Hug Mikoto", "Обнять Микото"), lambda: self._set_state(chat_id, "true_end"))
        elif st == "bad_noflash":
            tv.setText(_mz_t("Темрява. Удар ззаду.\n\nМикото: «У темряві треба дивитися по сторонах…»\n«Я тебе вб'ю.»\n\nПоганий кінець: Без ліхтарика.", "Darkness. A blow from behind.\n\nMikoto: “In the dark, you have to look around…”\n“I'll kill you.”\n\nBad ending: Without the flashlight.", "Темнота. Удар сзади.\n\nМикото: «В тьме надо смотреть по сторонам…»\n«Я убью тебя.»\n\nПлохая концовка: Без фонарика."))
            self._schedule(3000, self._exit_app)
        elif st == "bad_run":
            tv.setText(_mz_t("Ти кидаєшся бігти. За спиною швидкі кроки.\n\nТемрява згущується. Результат визначено.\n\nПоганий кінець: Ззаду.", "You bolt. Quick footsteps behind you.\n\nThe darkness thickens. The outcome is decided.\n\nBad ending: Behind you.", "Ты бросаешься бежать. За спиной — быстрые шаги.\n\nМрак сгущается. Исход предрешён.\n\nПлохая концовка: Сзади."))
            self._schedule(3000, self._exit_app)
        elif st == "bad_stay":
            tv.setText(_mz_t("Ти: «Я залишуся.»\n\nМикото: «Тоді я буду готувати для тебе багато-багато…»\nКлацання замка. Усередині тиша.\n\nПоганий кінець: Чого ти хотів.", "You: “I'll stay.”\n\nMikoto: “Then I'll cook for you a lot, a lot…”\nThe lock clicks. Inside, silence.\n\nBad ending: What you wanted.", "Ты: «Я останусь.»\n\nМикото: «Тогда я буду готовить для тебя много‑много…»\nЩелчок замка. Внутри — тишина.\n\nПлохая концовка: Чего ты хотел."))
            def _start_fade_and_exit():
                run_on_ui_thread(lambda: self._blackout_fade(2200, on_done=self._exit_app))
            self._schedule(3500, _start_fade_and_exit)
            try:
                dlg = s.get("dialog")
                if dlg:
                    self._safe_dismiss_dialog(dlg)
            except Exception:
                pass
        elif st == "true_end":
            extra = _mz_t(" Я хочу, щоб ти була щасливою.", " I want you to be happy.", " Я хочу, чтобы ты была счастлива.") if flags.get("happy", False) else ""
            tv.setText(_mz_t("Ти обіймаєш її, попри все.\n\nМикото: «Пробач… за все.»\nМинають місяці. Ви ліпите сніговика. Вона стає спокійнішою.\n", "You hug her, no matter what.\n\nMikoto: “Forgive me… for everything.”\nMonths pass. You build a snowman together. She becomes calmer.\n", "Ты обнимаешь её, несмотря ни на что.\n\nМикото: «Прости… за всё.»\nПроходят месяцы. Вы лепите снеговика. Она становится спокойнее.\n") + extra + _mz_t("\n\nІстинний кінець.", "\n\nTrue ending.", "\n\nИстинная концовка."))
            add_choice(_mz_t("Зіграти знову", "Play again", "Сыграть снова"), lambda: self._reset_and_restart(chat_id))
    
        else:
            tv.setText(_mz_t("(Невідомий стан)", "(Unknown state)", "(Неизвестное состояние)"))
            add_choice(_mz_t("На початок", "Back to start", "В начало"), lambda: self._set_state(chat_id, "start"))

    def _reset_and_restart(self, chat_id):
        s = self._sessions.get(chat_id)
        if not s:
            return
        s["flags"] = {"happy": False, "flash": False}
        s["di_idx"] = 0
        self._set_state(chat_id, "prologue1")

