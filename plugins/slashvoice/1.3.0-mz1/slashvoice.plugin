# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

# -*- coding: utf-8 -*-
#
# SlashVoice: voice "quick replies" in ANY chat, group or channel.
#
# MAIN: it can take voice messages straight from your Telegram Business quick replies.
#
# How to use:
# 1) Once (and after adding new replies) type in any chat: .qsync
# The plugin pulls your Business quick replies (/yes, /no, /cantdo ...).
# 2) In any chat type /yes and send -> the voice message from the "yes" quick reply is sent.
# - if you first reply (swipe) to someone's message, the voice message is sent as a QUOTE.
# 3) Just type / -> a list appears to choose from.
# 4) Commands: .qsync (refresh from Business), .qlist (show the list)
#
# Bonus: you can also save any voice message by hand: long-press it -> "Save as quick reply".
#
# SDK documentation: https://plugins.exteragram.app/docs

import json
import base64
import traceback

from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from ui.settings import Header, Input, Text
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper

from android_utils import run_on_ui_thread, log
from client_utils import (
    send_message, send_audio, send_request, run_on_queue,
    get_last_fragment, get_file_loader,
)

from org.telegram.tgnet import TLRPC, SerializedData
from android.widget import EditText

__id__ = "slashvoice"
__name__ = "SlashVoice: quick voice replies"
__description__ = ("Voice quick replies in any chats, groups and channels. Pulls voice messages from your Telegram Business quick replies: type .qsync, then in any chat type /name (for example /yes). If you reply to a message, the voice message is sent as a quote. Just / opens the list.")
__author__ = "@you"
__version__ = "1.3.0-mz1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.4.0"
__category__ = ["media", "chats"]
__sdk_version__ = ">=1.4.3.0"

MANUAL_KEY = "replies_json"   # saved by hand (long-press a voice message)
NATIVE_KEY = "native_json"    # pulled from Business quick replies
DEFAULT_PREFIX = "/"


# ---------- helpers ----------

def _argb(v):
    return v - 0x100000000 if v >= 0x80000000 else v


def toast(kind, text):
    try:
        if kind == "ok" and hasattr(BulletinHelper, "show_success"):
            BulletinHelper.show_success(text); return
        if kind == "err" and hasattr(BulletinHelper, "show_error"):
            BulletinHelper.show_error(text); return
    except Exception:
        pass
    try:
        BulletinHelper.show_info(text)
    except Exception:
        log("SlashVoice toast: " + str(text))


def serialize_document(doc):
    """TLRPC.Document -> base64 (keeps the exact form of the voice message: waveform + voice)."""
    try:
        size = doc.getObjectSize()
        data = SerializedData(size)
        doc.serializeToStream(data)
        raw = data.toByteArray()
        try:
            data.cleanup()
        except Exception:
            pass
        return base64.b64encode(bytes(raw)).decode("ascii")
    except Exception:
        log("SlashVoice serialize_document failed\n" + traceback.format_exc())
        return None


def deserialize_document(b64):
    try:
        raw = base64.b64decode(b64)
        data = SerializedData(bytes(raw))
        constructor = data.readInt32(False)
        doc = TLRPC.Document.TLdeserialize(data, constructor, False)
        try:
            data.cleanup()
        except Exception:
            pass
        return doc
    except Exception:
        log("SlashVoice deserialize_document failed\n" + traceback.format_exc())
        return None


def extract_voice(msg):
    """From MessageObject -> (document, path, is_voice)."""
    doc = None
    path = None
    is_voice = False
    try:
        try:
            is_voice = bool(msg.isVoice())
        except Exception:
            is_voice = False
        try:
            doc = msg.getDocument()
        except Exception:
            doc = None
        try:
            f = get_file_loader().getPathToMessage(msg.messageOwner)
            if f is not None and f.exists():
                path = f.getAbsolutePath()
        except Exception:
            path = None
    except Exception:
        log("SlashVoice extract_voice failed\n" + traceback.format_exc())
    return doc, path, is_voice


def java_iter(obj):
    """Converts a Java List / array / Iterable into a python list, as robustly as possible."""
    items = []
    if obj is None:
        return items
    try:
        n = obj.size()  # java.util.List
        for i in range(n):
            items.append(obj.get(i))
        return items
    except Exception:
        pass
    try:
        for x in obj:  # Iterable / array
            items.append(x)
        return items
    except Exception:
        pass
    try:
        n = len(obj)
        for i in range(n):
            items.append(obj[i])
    except Exception:
        pass
    return items


# ---------- plugin ----------

class SlashVoicePlugin(BasePlugin):

    def on_plugin_load(self):
        self._pending_pass = None  # text that may be let through once (after "Yes")
        self.add_on_send_message_hook()
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text=_mz_t("🎙 Зберегти як швидку відповідь", "🎙 Save as quick reply", "🎙 Сохранить как быстрый ответ"),
                on_click=self._on_save_click,
                icon="input_mic",
                priority=5,
            ))
        except Exception:
            log("SlashVoice: add MESSAGE_CONTEXT_MENU failed\n" + traceback.format_exc())
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text=_mz_t("Мої швидкі голосові", "My quick voice messages", "Мои быстрые голосовые"),
                on_click=self._on_manage_click,
                icon="msg_saved",
            ))
        except Exception:
            log("SlashVoice: add DRAWER_MENU failed\n" + traceback.format_exc())
        # pull Business quick replies on start
        try:
            self.sync_quick_replies(notify=False)
        except Exception:
            log("SlashVoice: initial sync failed\n" + traceback.format_exc())
        self.log("SlashVoice loaded")

    # ----- settings -----

    def create_settings(self):
        rows = [
            Header(text="SlashVoice"),
            Input(key="prefix", text=_mz_t("Префікс команди", "Command prefix", "Префикс команды"), default=DEFAULT_PREFIX,
                  subtext=_mz_t("З нього починається команда. Типово /", "The command starts with this. Default: /", "С него начинается команда. По умолчанию /"), icon="msg_edit"),
            Text(text=_mz_t("Завантажити Business відповіді", "Load Business replies", "Подтянуть Business ответы"),
                 subtext=_mz_t("Напишіть у будь-якому чаті: .qsync. Плагін завантажить ваші швидкі відповіді (/так, /ні ...)", "Type .qsync in any chat. The plugin will load your quick replies (/yes, /no ...)", "Напиши в любом чате: .qsync — плагин загрузит твои быстрые ответы (/да, /нет ...)"),
                 icon="msg_download"),
            Text(text=_mz_t("Як надіслати", "How to send", "Как отправить"),
                 subtext=_mz_t("Напишіть /ім'я. Можна частину імені: /не покаже список (/неможу, /немаю ...). Просто / покаже весь список. Свайп-відповідь перед командою, і голосове піде цитатою.", "Type /name. You can type part of a name: /no shows the list (/nope, /nocando ...). Just / shows the whole list. Swipe-reply to a message before the command and the voice message goes as a quote.", "Напиши /имя. Можно часть имени: /нем покажет список (/немогу, /немог...). Просто / — весь список. Свайп-ответ перед командой → уйдёт цитатой."),
                 icon="msg_info"),
            Text(text=_mz_t("Якщо змінили швидкі відповіді", "If you changed the quick replies", "Если изменил быстрые ответы"),
                 subtext=_mz_t("Знову напишіть .qsync, щоб оновити список.", "Type .qsync again to refresh the list.", "Снова напиши .qsync, чтобы обновить список."),
                 icon="msg_reset"),
        ]
        names_native = sorted(self._get_native().keys())
        names_manual = sorted(self._get_manual().keys())
        if names_native:
            rows.append(Header(text=_mz_t("З Business швидких відповідей", "From Business quick replies", "Из Business быстрых ответов")))
            for n in names_native:
                rows.append(Text(text=self._prefix() + n, icon="input_mic"))
        if names_manual:
            rows.append(Header(text=_mz_t("Збережені вручну", "Saved by hand", "Сохранённые вручную")))
            for n in names_manual:
                rows.append(Text(text=self._prefix() + n, icon="input_mic"))
        return rows

    # ----- storage -----

    def _read_json(self, key):
        raw = self.get_setting(key, "{}")
        try:
            d = json.loads(raw) if isinstance(raw, str) else (raw or {})
            return d if isinstance(d, dict) else {}
        except Exception:
            return {}

    def _get_manual(self):
        return self._read_json(MANUAL_KEY)

    def _get_native(self):
        return self._read_json(NATIVE_KEY)

    def _save_manual(self, d):
        try:
            self.set_setting(MANUAL_KEY, json.dumps(d, ensure_ascii=False))
        except Exception:
            log("SlashVoice: save manual failed\n" + traceback.format_exc())

    def _prefix(self):
        p = self.get_setting("prefix", DEFAULT_PREFIX)
        return p if isinstance(p, str) and p else DEFAULT_PREFIX

    def _resolve(self, name):
        """Looks up a voice message by name: first Business, then the manual ones."""
        nat = self._get_native()
        if name in nat:
            return nat[name]
        man = self._get_manual()
        if name in man:
            return man[name]
        return None

    def _all_names(self):
        return sorted(set(self._get_native().keys()) | set(self._get_manual().keys()))

    # ----- PULL Business quick replies -----

    def sync_quick_replies(self, notify=False):
        def worker():
            try:
                req = TLRPC.TL_messages_getQuickReplies()
                try:
                    req.hash = 0
                except Exception:
                    pass

                def on_resp(response, error):
                    try:
                        if error is not None:
                            if notify:
                                toast("err", _mz_t("Помилка: ", "Error: ", "Ошибка: ") + str(getattr(error, "text", error)))
                            return
                        quick = getattr(response, "quick_replies", None)
                        msgs = getattr(response, "messages", None)
                        if quick is None or msgs is None:
                            if notify:
                                toast("err", _mz_t("Швидкі відповіді не завантажились (порожньо?)", "Quick replies didn't load (empty?)", "Быстрые ответы не загрузились (пусто?)"))
                            return

                        # shortcut_id -> name
                        quick_list = java_iter(quick)
                        msgs_list = java_iter(msgs)

                        id_to_name = {}
                        for qr in quick_list:
                            try:
                                sid = getattr(qr, "shortcut_id", None)
                                name = getattr(qr, "shortcut", None)
                                if sid is not None and name:
                                    id_to_name[int(sid)] = str(name)
                            except Exception:
                                continue

                        # messages -> name -> voice message (document)
                        native = {}
                        for m in msgs_list:
                            try:
                                sid = getattr(m, "quick_reply_shortcut_id", None)
                                if not sid:
                                    continue
                                name = id_to_name.get(int(sid))
                                if not name:
                                    continue
                                media = getattr(m, "media", None)
                                doc = getattr(media, "document", None) if media is not None else None
                                if doc is None:
                                    continue
                                b64 = serialize_document(doc)
                                if b64:
                                    native[name] = {"doc": b64}
                            except Exception:
                                continue

                        self.set_setting(NATIVE_KEY, json.dumps(native, ensure_ascii=False))
                        if notify:
                            if native:
                                toast("ok", _mz_t("Завантажено голосових: ", "Voice messages loaded: ", "Загружено голосовых: ") + str(len(native)))
                            else:
                                toast("err", (_mz_t("Відповідей: %d, повідомлень: %d, голосових: 0", "Replies: %d, messages: %d, voice messages: 0", "Ответов: %d, сообщений: %d, голосовых: 0")
                                              % (len(quick_list), len(msgs_list))))
                    except Exception as e:
                        log("SlashVoice sync parse error\n" + traceback.format_exc())
                        if notify:
                            toast("err", _mz_t("Помилка обробки: ", "Processing error: ", "Ошибка обработки: ") + str(e)[:140])

                send_request(req, on_resp)
            except Exception as e:
                log("SlashVoice sync error\n" + traceback.format_exc())
                if notify:
                    toast("err", _mz_t("Запит не надіслано: ", "Request wasn't sent: ", "Запрос не ушёл: ") + str(e)[:140])

        run_on_queue(worker)

    # ----- manual save of a voice message -----

    def _on_save_click(self, context):
        msg = context.get("message")
        if msg is None:
            toast("err", _mz_t("Немає повідомлення", "No message", "Нет сообщения"))
            return
        doc, path, is_voice = extract_voice(msg)
        if doc is None and not path:
            toast("err", _mz_t("Не вдалося отримати файл. Спочатку прослухайте або завантажте голосове.", "Couldn't get the file. First play or download the voice message.", "Не удалось получить файл. Сначала прослушай/прогрузи голосовое."))
            return
        self._prompt_name(doc, path)

    def _prompt_name(self, doc, path):
        def show():
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return

            edit = EditText(activity)
            try:
                edit.setHint(_mz_t("ім'я, наприклад так", "name, e.g. yes", "имя, напр. да"))
                edit.setSingleLine(True)
                edit.setTextColor(_argb(0xFFFFFFFF))
                edit.setHintTextColor(_argb(0xFF7F7F7F))
                edit.setPadding(48, 24, 48, 24)
            except Exception:
                pass

            b = AlertDialogBuilder(activity)
            b.set_title(_mz_t("Нова швидка відповідь", "New quick reply", "Новый быстрый ответ"))
            b.set_message(_mz_t("Введіть коротке ім'я. Потім напишіть «", "Enter a short name. Then type «", "Введи короткое имя. Потом пиши «") + self._prefix() + _mz_t("ім'я» у будь-якому чаті.", "name» in any chat.", "имя» в любом чате."))
            b.set_view(edit)

            def on_ok(bld, which):
                try:
                    name = edit.getText().toString().strip()
                except Exception:
                    name = ""
                name = name.lstrip(self._prefix()).strip()
                if not name:
                    toast("err", _mz_t("Порожнє ім'я", "Empty name", "Пустое имя"))
                    bld.dismiss()
                    return
                doc_b64 = serialize_document(doc) if doc is not None else None
                store = self._get_manual()
                store[name] = {"doc": doc_b64, "path": path}
                self._save_manual(store)
                bld.dismiss()
                toast("ok", _mz_t("Збережено: ", "Saved: ", "Сохранено: ") + self._prefix() + name)

            b.set_positive_button(_mz_t("Зберегти", "Save", "Сохранить"), on_ok)
            b.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda bld, w: bld.dismiss())
            b.show()

        run_on_ui_thread(show)

    # ----- list / management -----

    def _on_manage_click(self, context):
        def show():
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return
            names = self._all_names()
            if not names:
                b = AlertDialogBuilder(activity)
                b.set_title(_mz_t("Швидкі голосові", "Quick voice messages", "Быстрые голосовые"))
                b.set_message(_mz_t("Порожньо.\nНапишіть .qsync, щоб завантажити Business швидкі відповіді,\nабо утримуйте голосове -> «Зберегти як швидку відповідь».", "Empty.\nType .qsync to load the Business quick replies,\nor long-press a voice message -> \"Save as quick reply\".", "Пусто.\nНапиши .qsync, чтобы подтянуть Business быстрые ответы,\nили зажми голосовое -> «Сохранить как быстрый ответ»."))
                b.set_positive_button(_mz_t("Ок", "OK", "Ок"), lambda bld, w: bld.dismiss())
                b.show()
                return
            items = [self._prefix() + n for n in names]
            b = AlertDialogBuilder(activity)
            b.set_title(_mz_t("Твої швидкі голосові", "Your quick voice messages", "Твои быстрые голосовые"))
            b.set_items(items, lambda bld, w: bld.dismiss())
            b.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda bld, w: bld.dismiss())
            b.show()

        run_on_ui_thread(show)

    # ----- choose from the list -----

    def _choose_and_send(self, peer, reply):
        self._choose_from(peer, reply, self._all_names())

    def _choose_from(self, peer, reply, names):
        names = list(names)

        def show():
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return
            if not names:
                toast("err", _mz_t("Порожньо. Напишіть .qsync, щоб завантажити Business відповіді.", "Empty. Type .qsync to load the Business replies.", "Пусто. Напиши .qsync для загрузки Business ответов."))
                return
            items = [self._prefix() + n for n in names]
            b = AlertDialogBuilder(activity)
            b.set_title(_mz_t("Оберіть голосове", "Choose a voice message", "Выбери голосовое"))

            def on_pick(bld, which):
                bld.dismiss()
                entry = self._resolve(names[which])
                if entry:
                    self._send_voice(peer, entry, reply)

            b.set_items(items, on_pick)
            b.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda bld, w: bld.dismiss())
            b.show()

        run_on_ui_thread(show)

    # ----- confirmation to send as text -----

    def _confirm_send_text(self, peer, text, reply):
        def show():
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag else None
            if not activity:
                # if the dialog can't be shown, send the message as it is, so it isn't lost
                self._send_text_raw(peer, text, reply)
                return
            b = AlertDialogBuilder(activity)
            b.set_title(_mz_t("Такої відповіді немає", "No such reply", "Нет такого ответа"))
            b.set_message(_mz_t("Голосової відповіді «", "Voice reply «", "Голосового «") + text + _mz_t("» немає.\nВсе одно надіслати «", "» not found.\nSend «", "» нет.\nВсё равно отправить «") + text + _mz_t("» текстом?", "» as text anyway?", "» текстом?"))
            b.set_positive_button(_mz_t("Так", "Yes", "Да"), lambda bld, w: (bld.dismiss(), self._send_text_raw(peer, text, reply)))
            b.set_negative_button(_mz_t("Ні", "No", "Нет"), lambda bld, w: bld.dismiss())
            b.show()

        run_on_ui_thread(show)

    def _send_text_raw(self, peer, text, reply):
        def do():
            try:
                # mark the text as allowed, so the hook lets it through once
                self._pending_pass = text.strip()
                p = {"peer": peer, "message": text}
                if reply is not None:
                    p["replyToMsg"] = reply
                send_message(p)
            except Exception:
                self._pending_pass = None
                log("SlashVoice send text error\n" + traceback.format_exc())

        run_on_ui_thread(do)

    # ----- sending the voice message -----

    def _send_voice(self, peer, entry, reply):
        doc = None
        b64 = entry.get("doc")
        if b64:
            doc = deserialize_document(b64)
        path = entry.get("path")

        def do_send():
            try:
                if doc is not None:
                    p = {"peer": peer, "document": doc}
                    if reply is not None:
                        p["replyToMsg"] = reply
                    send_message(p)
                    return
                if path:
                    p = {"peer": peer, "path": path}
                    if reply is not None:
                        p["replyToMsg"] = reply
                    send_message(p)
                    return
                toast("err", _mz_t("Файл недоступний. Спробуйте .qsync знову.", "File unavailable. Try .qsync again.", "Файл недоступен. Попробуй .qsync заново."))
            except Exception:
                log("SlashVoice send error\n" + traceback.format_exc())
                try:
                    if path:
                        send_audio(peer, path)
                except Exception:
                    log("SlashVoice fallback send_audio failed\n" + traceback.format_exc())

        run_on_ui_thread(do_send)

    # ----- outgoing interception -----

    def on_send_message_hook(self, account, params):
        try:
            text = getattr(params, "message", None)
            if not isinstance(text, str):
                return HookResult()
            t = text.strip()
            prefix = self._prefix()

            # let through once the text confirmed with the "Yes" button
            pend = getattr(self, "_pending_pass", None)
            if pend is not None and t == pend:
                self._pending_pass = None
                return HookResult()

            if t == ".qsync":
                self.sync_quick_replies(notify=True)
                return HookResult(strategy=HookStrategy.CANCEL)
            if t == ".qlist":
                self._on_manage_click({})
                return HookResult(strategy=HookStrategy.CANCEL)
            if t.startswith(".qdel"):
                name = t[len(".qdel"):].strip().lstrip(prefix).strip()
                store = self._get_manual()
                if name in store:
                    del store[name]
                    self._save_manual(store)
                    toast("ok", _mz_t("Видалено (вручну): ", "Deleted (by hand): ", "Удалено (вручную): ") + prefix + name)
                else:
                    toast("err", _mz_t("Такого серед збережених вручну немає: ", "No such one among the manual ones: ", "Нет такого среди ручных: ") + name)
                return HookResult(strategy=HookStrategy.CANCEL)

            if not prefix or not t.startswith(prefix):
                return HookResult()

            peer = getattr(params, "peer", None)
            reply = getattr(params, "replyToMsg", None)
            if peer is None:
                return HookResult()

            # just "/" -> the selection list
            if t == prefix:
                self._choose_and_send(peer, reply)
                return HookResult(strategy=HookStrategy.CANCEL)

            name = t[len(prefix):].strip()

            # exact match -> send right away
            entry = self._resolve(name)
            if entry is not None:
                self._send_voice(peer, entry, reply)
                return HookResult(strategy=HookStrategy.CANCEL)

            # no exact match: look for similar ones (first by the start of the name)
            low = name.lower()
            all_names = self._all_names()
            matches = [n for n in all_names if n.lower().startswith(low)]
            if not matches:
                matches = [n for n in all_names if low in n.lower()]

            if len(matches) == 1:
                self._send_voice(peer, self._resolve(matches[0]), reply)
                return HookResult(strategy=HookStrategy.CANCEL)
            if len(matches) >= 2:
                self._choose_from(peer, reply, matches)
                return HookResult(strategy=HookStrategy.CANCEL)

            # nothing found at all: ask before sending as text
            self._confirm_send_text(peer, t, reply)
            return HookResult(strategy=HookStrategy.CANCEL)

        except Exception:
            log("SlashVoice on_send_message_hook error\n" + traceback.format_exc())
            return HookResult()
