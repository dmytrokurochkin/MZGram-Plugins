# ---------- common functions ----------

def g(obj, name, default=None):
    try:
        return getattr(obj, name)
    except Exception:
        return default


def yn(value):
    return _mz_t("так", "yes", "да") if value else _mz_t("ні", "no", "нет")


def num(value):
    try:
        return f"{int(value):,}".replace(",", "\u00a0")
    except Exception:
        return str(value)


def fmt_size(size):
    try:
        size = int(size)
        return _mz_t(f"{size / 1024:.1f} КБ", f"{size / 1024:.1f} KB", f"{size / 1024:.1f} КБ") if size >= 1024 else _mz_t(f"{size} Б", f"{size} B", f"{size} Б")
    except Exception:
        return ""


def fmt_date(ts):
    try:
        ts = int(ts)
        return datetime.fromtimestamp(ts).strftime("%d.%m.%Y %H:%M") if ts > 0 else None
    except Exception:
        return None


def ago(ts):
    try:
        days = int((time.time() - int(ts)) // 86400)
    except Exception:
        return ""
    if days < 1:
        return _mz_t("сьогодні", "today", "сегодня")
    if days < 31:
        return _mz_t(f"{days} дн. тому", f"{days} d ago", f"{days} дн. назад")
    if days < 365:
        return _mz_t(f"{days // 30} міс. тому", f"{days // 30} mo ago", f"{days // 30} мес. назад")
    years, rest = divmod(days, 365)
    months = rest // 30
    return _mz_t(f"{years} р. {months} міс. тому", f"{years} y {months} mo ago", f"{years} г. {months} мес. назад") if months else _mz_t(f"{years} р. тому", f"{years} y ago", f"{years} г. назад")


def with_ago(ts):
    date = fmt_date(ts)
    return f"{date} ({ago(ts)})" if date else None


def dc_text(dc):
    try:
        return f"DC{int(dc)} {DC_PLACE.get(int(dc), '')}".strip() if dc else None
    except Exception:
        return None


def u16(text):
    # offsets in a Spannable are counted in UTF-16
    return len(text.encode("utf-16-le", "surrogatepass")) // 2


def signed(color):
    return color - 0x100000000 if color >= 0x80000000 else color


def theme_color(key, fallback):
    try:
        from org.telegram.ui.ActionBar import Theme
        return Theme.getColor(getattr(Theme, key))
    except Exception:
        return signed(fallback)


def dp(value):
    return AndroidUtilities.dp(float(value))


def display_name(user):
    return f"{g(user, 'first_name', '') or ''} {g(user, 'last_name', '') or ''}".strip()


def public_username(user):
    name = g(user, "username")
    if name:
        return name
    names = g(user, "usernames")
    for i in range(names.size() if names is not None else 0):
        item = names.get(i)
        if g(item, "active") and g(item, "username"):
            return g(item, "username")
    return None


def status_text(user):
    status = g(user, "status")
    if status is None:
        return None
    kind = status.getClass().getSimpleName()
    if kind == "TL_userStatusOffline":
        return _mz_t(f"був(-ла) {with_ago(g(status, 'was_online'))}", f"last seen {with_ago(g(status, 'was_online'))}", f"был(а) {with_ago(g(status, 'was_online'))}") if with_ago(g(status, "was_online")) else _mz_t("не в мережі", "offline", "не в сети")
    return STATUS.get(kind)


def chat_kind(chat):
    return _mz_t("канал", "channel", "канал") if g(chat, "broadcast") else _mz_t("супергрупа", "supergroup", "супергруппа") if g(chat, "megagroup") else _mz_t("чат", "chat", "чат")


def flag_labels(obj):
    pairs = ((_mz_t("верифіковано", "verified", "верифицирован"), "verified"), (_mz_t("скам", "scam", "скам"), "scam"), (_mz_t("фейк", "fake", "фейк"), "fake"))
    return [label for label, key in pairs if g(obj, key)]


def header(title):
    return "▸ " + title


def error_text(err, default=_mz_t("немає відповіді", "no response", "нет ответа")):
    return str(g(err, "text", default))[:60] if err else default


def widgets():
    global _widgets
    if _widgets is None:
        from android.widget import LinearLayout, FrameLayout, TextView, ImageView, HorizontalScrollView, ProgressBar
        from android.view import View, Gravity, MotionEvent, GestureDetector, VelocityTracker, ViewConfiguration
        from android.graphics import Color, Typeface, Bitmap, Canvas, Paint, BitmapShader, Shader, BitmapFactory
        from android.graphics.drawable import GradientDrawable
        from android.text import TextUtils, SpannableString, SpannableStringBuilder, Spanned
        from android.text.style import ForegroundColorSpan, RelativeSizeSpan, TypefaceSpan
        from android.animation import ValueAnimator
        from android.view.animation import DecelerateInterpolator
        from java import jarray, jfloat, jint
        _widgets = types.SimpleNamespace(**locals())
    return _widgets


def proxies():
    global _proxy_classes
    if _proxy_classes is None:
        from java import dynamic_proxy
        from android.view import View, GestureDetector
        from android.animation import ValueAnimator

        class Click(dynamic_proxy(View.OnClickListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onClick(self, view):
                self.fn()

        class Touch(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onTouch(self, view, event):
                return bool(self.fn(view, event))

        class Scroll(dynamic_proxy(View.OnScrollChangeListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onScrollChange(self, view, x, y, old_x, old_y):
                self.fn(view, x)

        class Update(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onAnimationUpdate(self, animator):
                self.fn(float(animator.getAnimatedValue()))

        class Gesture(dynamic_proxy(GestureDetector.OnGestureListener, GestureDetector.OnDoubleTapListener)):
            def __init__(self, on_tap, on_double):
                super().__init__()
                self.on_tap = on_tap
                self.on_double = on_double

            def onDown(self, e):
                return False

            def onShowPress(self, e):
                pass

            def onSingleTapUp(self, e):
                return False

            def onScroll(self, e1, e2, dx, dy):
                return False

            def onFling(self, e1, e2, vx, vy):
                return False

            def onLongPress(self, e):
                pass

            def onSingleTapConfirmed(self, e):
                self.on_tap()
                return False

            def onDoubleTap(self, e):
                self.on_double()
                return True

            def onDoubleTapEvent(self, e):
                return False

        _proxy_classes = types.SimpleNamespace(Click=Click, Touch=Touch, Scroll=Scroll, Update=Update, Gesture=Gesture)
    return _proxy_classes


class ChannelInspector(BasePlugin):
    # ---------- startup and settings ----------

    def on_plugin_load(self):
        self._enriched = set()
        self._user_cache = {}
        self._data_cache = {}
        self._peek_cache = {}
        self._flood_until = 0
        self.add_on_send_message_hook()
        self._init_settings()
        self._install_sheet_hook()

    def _init_settings(self):
        # Each key gets its default value once, later user changes are kept
        for key, default in DEFAULTS.items():
            marker = "init:" + key
            try:
                if self.get_setting(marker, "") != "done":
                    self.set_setting(key, default)
                    self.set_setting(marker, "done")
            except Exception as e:
                log(f"channel_inspector init {key}: {e}")

    def on(self, key):
        return bool(self.get_setting(key, DEFAULTS.get(key, True)))

    def create_settings(self):
        items = [Text(text=_mz_t("Команди: .chinfo, .chstats і .avatars з @username, t.me/username або t.me/+хеш. Без аргументу команда працює для поточного чату.", "Commands: .chinfo, .chstats and .avatars with @username, t.me/username or t.me/+hash. Without an argument the command works for the current chat.", ("Команды: .chinfo, .chstats и .avatars с @username, t.me/username или t.me/+хэш. "
                           "Без аргумента команда работает для текущего чата.")))]
        for title, entries in SETTINGS_SPEC:
            items.append(Header(text=title))
            for key, text, default in entries:
                items.append(Switch(key=key, text=text, default=default))
        return items

    # ---------- invite sheet ----------

    def _install_sheet_hook(self):
        try:
            from base_plugin import MethodHook
            from hook_utils import find_class
        except Exception as e:
            log(f"channel_inspector: no hook API: {e}")
            return
        plugin = self

        class SheetHook(MethodHook):
            def before_hooked_method(self, param):
                # The sheet takes its text from invite.about, so the block is appended before the sheet is created
                try:
                    if not plugin.on("inject_sheet"):
                        return
                    inv, h = plugin._find_args(param.args)
                    if inv is None:
                        return
                    about = g(inv, "about") or ""
                    if MARK in about:
                        return
                    lines = plugin._sheet_lines(inv, h)
                    if lines:
                        inv.about = (about + "\n\n" if about else "") + MARK + "\n" + "\n".join(lines)
                except Exception as e:
                    log(f"channel_inspector before: {e}")

            def after_hooked_method(self, param):
                try:
                    if not plugin.on("inject_sheet"):
                        return
                    inv, h = plugin._find_args(param.args)
                    sheet = param.thisObject
                    if inv is None or plugin._decorate(sheet, inv, h):
                        return
                    for delay in (250, 700):
                        run_on_ui_thread(lambda: plugin._decorate(sheet, inv, h), delay)
                except Exception as e:
                    log(f"channel_inspector after: {e}")

        for name in ("org.telegram.ui.Components.JoinGroupAlert", "org.telegram.ui.Components.JoinChatAlert"):
            try:
                cls = find_class(name)
                if cls is None:
                    continue
                hook = SheetHook()
                try:
                    self.hook_all_constructors(cls, hook)
                except Exception:
                    for ctor in cls.getDeclaredConstructors():
                        self.hook_method(ctor, hook)
                return
            except Exception as e:
                log(f"channel_inspector hook {name}: {e}")
        log("channel_inspector: sheet class not found")

    def _find_args(self, args):
        inv, h = None, None
        for arg in args:
            if arg is None:
                continue
            if isinstance(arg, str):
                h = arg
            elif hasattr(arg, "getClass") and arg.getClass().getSimpleName() == "TL_chatInvite":
                inv = arg
        return inv, h

    def _roots(self, sheet):
        roots = []
        for getter in (lambda: sheet.containerView, lambda: sheet.getContainer(),
                       lambda: sheet.getWindow().getDecorView()):
            try:
                root = getter()
                if root is not None:
                    roots.append(root)
            except Exception:
                pass
        return roots

    def _walk(self, view, out):
        out.append(view)
        if hasattr(view, "getChildCount"):
            for i in range(view.getChildCount()):
                self._walk(view.getChildAt(i), out)

    def _decorate(self, sheet, inv, h):
        self._sheet = sheet
        for root in self._roots(sheet):
            views = []
            self._walk(root, views)
            info = None
            for view in views:
                if hasattr(view, "getText") and hasattr(view, "setText"):
                    text = view.getText()
                    if text is not None and MARK in str(text):
                        info = view
                        break
            if info is None:
                continue
            if self.on("style_sheet"):
                self._guard("style", self._restyle, info)
            self._guard("buttons", self._add_buttons, root, views, info, inv, h)
            self._add_carousel(root, info, inv)
            self._guard("lookups", self._enrich_sheet, info, inv, h)
            return True
        return False

    def _guard(self, label, fn, *args):
        try:
            return fn(*args)
        except Exception as e:
            log(f"channel_inspector {label}: {e}")
            return None

    def _span_style(self, text_len_start, text_len_end, spannable):
        X = widgets()
        gray = theme_color("key_windowBackgroundWhiteGrayText", 0xFF9AA3AD)
        flag = X.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
        spannable.setSpan(X.ForegroundColorSpan(gray), text_len_start, text_len_end, flag)
        spannable.setSpan(X.RelativeSizeSpan(0.84), text_len_start, text_len_end, flag)
        try:
            spannable.setSpan(X.TypefaceSpan(X.Typeface.DEFAULT), text_len_start, text_len_end, flag)
        except Exception:
            pass

    def _restyle(self, tv):
        if tv.getTag() == STYLED_TAG:
            return
        X = widgets()
        text = tv.getText()
        plain = str(text)
        builder = X.SpannableStringBuilder(text)
        self._span_style(u16(plain[:plain.find(MARK)]), u16(plain), builder)
        tv.setText(builder)
        tv.setTag(STYLED_TAG)

    def _append_styled(self, tv, text):
        try:
            if not self.on("style_sheet"):
                tv.append(text)
                return
            X = widgets()
            span = X.SpannableString(text)
            self._span_style(0, u16(text), span)
            tv.append(span)
        except Exception as e:
            log(f"channel_inspector append: {e}")

    def _add_buttons(self, root, views, info, inv, h=None):
        want = [self.on("b_gallery"), self.on("b_copy"), self.on("b_save"), self.on("b_report")]
        if not any(want) or g(inv, "photo") is None or root.findViewWithTag(BUTTONS_TAG) is not None:
            return
        X, P = widgets(), proxies()
        parent = info.getParent()
        if not isinstance(parent, X.LinearLayout):
            return
        avatar_view = None
        for view in views:
            if view.getClass().getSimpleName() == "BackupImageView":
                avatar_view = view
                break
        ctx = root.getContext()
        blue = theme_color("key_dialogTextBlue", 0xFF4FA3E0)

        row = X.LinearLayout(ctx)
        row.setOrientation(X.LinearLayout.HORIZONTAL)
        row.setGravity(X.Gravity.CENTER)
        row.setTag(BUTTONS_TAG)

        def add(label, action):
            tv = X.TextView(ctx)
            tv.setText(label)
            tv.setTextSize(1, 13.0)
            tv.setTextColor(blue)
            tv.setGravity(X.Gravity.CENTER)
            tv.setPadding(dp(8), dp(8), dp(8), dp(8))
            tv.setOnClickListener(P.Click(action))
            row.addView(tv, X.LinearLayout.LayoutParams(-2, -2))

        def open_viewer():
            item = self._item_from_photo(self._photo(inv))
            if item is None:
                self._toast(_mz_t("В запрошенні немає аватарки", "The invite has no avatar", "В приглашении нет аватарки"))
                return
            item["invite"] = True
            self._viewer(g(inv, "title", _mz_t("Аватарка", "Avatar", "Аватарка")), [item])

        if want[0]:
            add(_mz_t("Перегляд", "View", "Просмотр"), open_viewer)
        if want[1]:
            add(_mz_t("Копіювати", "Copy", "Копировать"), lambda: self._avatar(inv, avatar_view, ctx, "copy"))
        if want[2]:
            add(_mz_t("До галереї", "To gallery", "В галерею"), lambda: self._avatar(inv, avatar_view, ctx, "save"))
        if want[3]:
            add(_mz_t("Звіт", "Report", "Отчёт"), lambda: self._report(inv, h))
        parent.addView(row, parent.indexOfChild(info) + 1, X.LinearLayout.LayoutParams(-1, -2))

    # ---------- member carousel ----------

    def _add_carousel(self, root, info, inv):
        if not self.on("s_carousel"):
            return
        users = g(inv, "participants")
        if users is None or users.size() == 0 or root.findViewWithTag(CAROUSEL_TAG) is not None:
            return
        try:
            built = self._build_carousel(root, info, users)
        except Exception as e:
            log(f"channel_inspector carousel: {e}")
            built = False
        if not built:
            self._users_as_text(info, inv)

    def _users_as_text(self, info, inv):
        key = info.hashCode()
        if key in self._enriched:
            return
        self._enriched.add(key)
        users = g(inv, "participants")
        lines = ["", _mz_t("Видимі учасники:", "Visible members:", "Видимые участники:")]
        for i in range(min(users.size(), 10)):
            name, parts = self._user_parts(users.get(i), False)
            lines.append(name + (" · " + " · ".join(parts) if parts else ""))
        run_on_ui_thread(lambda: self._append_styled(info, "\n".join(lines)))
        if self.on("e_users"):
            self._users_task(inv, True, lambda ls: ls and run_on_ui_thread(
                lambda: self._append_styled(info, "\n" + "\n".join(ls))))

    def _build_carousel(self, root, info, users):
        X, P = widgets(), proxies()
        parent = info.getParent()
        if not isinstance(parent, X.LinearLayout):
            return False
        ctx = root.getContext()
        screen = AndroidUtilities.displaySize.x
        count = min(users.size(), 10)
        card_w = int(screen * 0.80)
        step = card_w + dp(10)
        slop = X.ViewConfiguration.get(ctx).getScaledTouchSlop()

        main = theme_color("key_dialogTextBlack", 0xFFFFFFFF)
        gray = theme_color("key_windowBackgroundWhiteGrayText", 0xFF9AA3AD)
        accent = theme_color("key_dialogTextBlue", 0xFF4FA3E0)
        card_fill = theme_color("key_dialogBackgroundGray", 0x22FFFFFF)
        stroke = X.Color.argb(40, 150, 150, 150)
        dot_idle = X.Color.argb(90, 150, 150, 150)

        def label(text, size, color, bold=False):
            tv = X.TextView(ctx)
            tv.setText(text)
            tv.setTextSize(1, float(size))
            tv.setTextColor(color)
            tv.setSingleLine(True)
            tv.setEllipsize(X.TextUtils.TruncateAt.END)
            if bold:
                tv.setTypeface(X.Typeface.DEFAULT_BOLD)
            return tv

        def fill_facts(box, pairs):
            box.removeAllViews()
            pairs = pairs[:6]
            for i in range(0, len(pairs), 2):
                row = X.LinearLayout(ctx)
                row.setOrientation(X.LinearLayout.HORIZONTAL)
                chunk = pairs[i:i + 2]
                for title, value in chunk:
                    tile = X.LinearLayout(ctx)
                    tile.setOrientation(X.LinearLayout.VERTICAL)
                    tile.setPadding(0, dp(3), dp(6), dp(3))
                    tile.addView(label(title, 11, gray))
                    tile.addView(label(value, 13, main))
                    row.addView(tile, X.LinearLayout.LayoutParams(0, -2, 1.0))
                if len(chunk) == 1:
                    row.addView(X.View(ctx), X.LinearLayout.LayoutParams(0, 1, 1.0))
                box.addView(row, X.LinearLayout.LayoutParams(-1, -2))

        def make_card(user):
            uid = g(user, "id")
            name = display_name(user) or _mz_t("Без імені", "No name", "Без имени")
            card = X.LinearLayout(ctx)
            card.setOrientation(X.LinearLayout.VERTICAL)
            card.setPadding(dp(14), dp(12), dp(14), dp(12))
            card.setMinimumHeight(dp(176))
            bg = X.GradientDrawable()
            bg.setColor(card_fill)
            bg.setCornerRadius(float(dp(18)))
            bg.setStroke(1, stroke)
            card.setBackground(bg)

            top = X.LinearLayout(ctx)
            top.setOrientation(X.LinearLayout.HORIZONTAL)
            top.setGravity(X.Gravity.CENTER_VERTICAL)
            avatar = X.ImageView(ctx)
            avatar.setImageBitmap(self._initials(name, uid, dp(56)))
            top.addView(avatar, X.LinearLayout.LayoutParams(dp(56), dp(56)))
            text_col = X.LinearLayout(ctx)
            text_col.setOrientation(X.LinearLayout.VERTICAL)
            text_col.setPadding(dp(12), 0, 0, 0)
            text_col.addView(label(name, 16, main, True))
            username = public_username(user)
            sub = f"@{username}" if username else _mz_t("без username", "no username", "без username")
            if self.on("su_ids"):
                sub += f" · id {uid}"
            sub_view = label(sub, 13, accent)
            text_col.addView(sub_view)
            if self.on("su_flags"):
                badges = [title for title, key in (
                    ("Premium", "premium"), (_mz_t("Верифіковано", "Verified", "Верифицирован"), "verified"), (_mz_t("Бот", "Bot", "Бот"), "bot"),
                    (_mz_t("Скам", "Scam", "Скам"), "scam"), (_mz_t("Фейк", "Fake", "Фейк"), "fake"), (_mz_t("Обмежено", "Restricted", "Ограничен"), "restricted"), (_mz_t("Контакт", "Contact", "Контакт"), "contact"),
                ) if g(user, key)]
                if badges:
                    text_col.addView(label(" · ".join(badges), 11, gray))
            top.addView(text_col, X.LinearLayout.LayoutParams(0, -2, 1.0))
            card.addView(top, X.LinearLayout.LayoutParams(-1, -2))

            divider = X.View(ctx)
            divider.setBackgroundColor(stroke)
            div_lp = X.LinearLayout.LayoutParams(-1, 2)
            div_lp.setMargins(0, dp(10), 0, dp(8))
            card.addView(divider, div_lp)
            box = X.LinearLayout(ctx)
            box.setOrientation(X.LinearLayout.VERTICAL)
            card.addView(box, X.LinearLayout.LayoutParams(-1, -2))

            base = self._user_base_facts(user)
            fill_facts(box, base + ([(_mz_t("Профіль", "Profile", "Профиль"), _mz_t("завантажується", "loading", "загружается"))] if self.on("e_users") else []))

            actions = X.LinearLayout(ctx)
            actions.setOrientation(X.LinearLayout.HORIZONTAL)
            actions.setPadding(0, dp(6), 0, 0)
            for text in (_mz_t("Аватарки", "Avatars", "Аватарки"), _mz_t("Дані", "Data", "Данные"), _mz_t("Профіль", "Profile", "Профиль"), _mz_t("Копіювати", "Copy", "Копировать")):
                button = label(text, 12, accent)
                button.setGravity(X.Gravity.CENTER)
                actions.addView(button, X.LinearLayout.LayoutParams(0, -2, 1.0))
            actions_lp = X.LinearLayout.LayoutParams(-1, -2)
            actions_lp.setMargins(0, dp(8), 0, 0)
            card.addView(actions, actions_lp)
            return card, {"user": user, "uid": uid, "sub": sub_view, "avatar": avatar, "box": box, "base": base,
                          "actions": actions}

        def show_data(refs, data):
            if data.get("username"):
                suffix = f" · id {refs['uid']}" if self.on("su_ids") else ""
                refs["sub"].setText(f"@{data['username']}{suffix}")
            deep = []
            if data.get("reg"):
                deep.append((_mz_t("Реєстрація", "Registered", "Регистрация"), str(data["reg"])))
            if data.get("country"):
                deep.append((_mz_t("Країна номера", "Number country", "Страна номера"), str(data["country"])))
            if data.get("photos"):
                deep.append((_mz_t("Аватарок", "Avatars", "Аватарок"), str(data["photos"])))
            if data.get("common"):
                deep.append((_mz_t("Спільних чатів", "Common chats", "Общих чатов"), str(data["common"])))
            pairs = deep + refs["base"]
            if data.get("limited") and not deep:
                pairs.append((_mz_t("Профіль", "Profile", "Профиль"), _mz_t("закрито до вступу", "hidden until you join", "закрыт до вступления")))
            elif data.get("error") and not deep:
                pairs.append((_mz_t("Профіль", "Profile", "Профиль"), data["error"][:30]))
            elif not deep:
                pairs.append((_mz_t("Профіль", "Profile", "Профиль"), _mz_t("сервер не надав даних", "the server returned no data", "сервер данных не дал")))
            fill_facts(refs["box"], pairs)

        def load_avatar(refs):
            def work():
                try:
                    item = self._current_item(refs["user"])
                    bmp = self._fetch_bitmap(item, 10, 192) if item else None
                    if bmp is not None:
                        circle = self._circle(bmp, dp(56))
                        run_on_ui_thread(lambda: refs["avatar"].setImageBitmap(circle))
                except Exception as e:
                    log(f"channel_inspector card avatar: {e}")
            threading.Thread(target=work, daemon=True).start()

        holder = X.LinearLayout(ctx)
        holder.setOrientation(X.LinearLayout.VERTICAL)
        holder.setTag(CAROUSEL_TAG)
        title = label(_mz_t(f"ВИДИМІ УЧАСНИКИ · {count}", f"VISIBLE MEMBERS · {count}", f"ВИДИМЫЕ УЧАСТНИКИ · {count}"), 11, gray)
        title.setLetterSpacing(0.1)
        title.setPadding(dp(20), 0, dp(20), dp(8))
        holder.addView(title, X.LinearLayout.LayoutParams(-1, -2))

        stage = X.FrameLayout(ctx)
        cards, refs_list = [], []
        for i in range(count):
            user = users.get(i)
            card, refs = make_card(user)
            stage.addView(card, X.FrameLayout.LayoutParams(card_w, -2, X.Gravity.TOP | X.Gravity.CENTER_HORIZONTAL))
            cards.append(card)
            refs_list.append(refs)
            load_avatar(refs)
            if self.on("e_users"):
                fetch = lambda u=user, r=refs: self._user_data(
                    u, False, lambda data: run_on_ui_thread(lambda: show_data(r, data)))
                timer = threading.Timer(0.3 * i, fetch)
                timer.daemon = True
                timer.start()
        holder.addView(stage, X.LinearLayout.LayoutParams(-1, -2))

        dots_row = X.LinearLayout(ctx)
        dots_row.setOrientation(X.LinearLayout.HORIZONTAL)
        dots_row.setGravity(X.Gravity.CENTER)
        dots_row.setPadding(0, dp(10), 0, dp(2))
        dots = []
        for _ in range(count):
            dot = X.View(ctx)
            shape = X.GradientDrawable()
            shape.setCornerRadius(float(dp(3)))
            dot.setBackground(shape)
            lp = X.LinearLayout.LayoutParams(dp(6), dp(6))
            lp.setMargins(dp(3), 0, dp(3), 0)
            dots_row.addView(dot, lp)
            dots.append((dot, shape, lp))
        if count > 1:
            holder.addView(dots_row, X.LinearLayout.LayoutParams(-1, -2))

        state = {"offset": 0.0, "start": 0.0, "x": 0.0, "y": 0.0, "drag": False, "tracker": None,
                 "animator": None, "page": -1}

        def set_dots(page):
            if page == state["page"]:
                return
            state["page"] = page
            for i, (dot, shape, lp) in enumerate(dots):
                lp.width = dp(18) if i == page else dp(6)
                dot.setLayoutParams(lp)
                shape.setColor(accent if i == page else dot_idle)

        def place(offset):
            state["offset"] = offset
            for i, card in enumerate(cards):
                distance = i - offset
                near = min(abs(distance), 1.0)
                card.setTranslationX(distance * step)
                card.setScaleX(1.0 - 0.06 * near)
                card.setScaleY(1.0 - 0.06 * near)
                card.setAlpha(max(0.0, 1.0 - 0.55 * near) if abs(distance) < 2.0 else 0.0)
            set_dots(max(0, min(count - 1, int(round(offset)))))

        def animate_to(target):
            old = state["animator"]
            if old is not None:
                old.cancel()
            start = state["offset"]
            if abs(target - start) < 0.002:
                place(target)
                return
            try:
                anim = X.ValueAnimator.ofFloat(X.jarray(X.jfloat)([start, target]))
                anim.setDuration(int(200 + 180 * min(abs(target - start), 1.0)))
                anim.setInterpolator(X.DecelerateInterpolator(1.6))
                anim.addUpdateListener(P.Update(place))
                anim.start()
                state["animator"] = anim
            except Exception as e:
                log(f"channel_inspector animation: {e}")
                place(target)

        def details(user):
            self._toast(_mz_t("Завантажую профіль", "Loading profile", "Загружаю профиль"))
            title_text = display_name(user) or _mz_t("Профіль", "Profile", "Профиль")
            self._user_deep(user, False, lambda lines: self._dialog(title_text, lines, None, None))

        def card_action(i, rx, ry):
            refs = refs_list[i]
            user, actions = refs["user"], refs["actions"]
            if actions.getTop() <= ry <= actions.getBottom() and actions.getLeft() <= rx <= actions.getRight():
                segment = int((rx - actions.getLeft()) * 4 / max(1, actions.getWidth()))
                if segment <= 0:
                    self._show_user_avatars(user)
                elif segment == 1:
                    details(user)
                elif segment == 2:
                    self._open_user(user)
                else:
                    self._copy_user(user)
            elif dp(14) <= rx <= dp(70) and dp(12) <= ry <= dp(68):
                self._show_user_avatars(user)
            else:
                details(user)

        def on_tap(view, x, y):
            width = view.getWidth()
            current = int(round(state["offset"]))
            for i in range(count):
                left = width / 2.0 + (i - state["offset"]) * step - card_w / 2.0
                if left <= x <= left + card_w:
                    if i != current:
                        animate_to(float(i))
                    else:
                        card_action(i, x - left, y)
                    return

        def on_touch(view, event):
            action = event.getActionMasked()
            if action == X.MotionEvent.ACTION_DOWN:
                if state["animator"] is not None:
                    state["animator"].cancel()
                state.update(x=event.getX(), y=event.getY(), drag=False, start=state["offset"])
                state["tracker"] = X.VelocityTracker.obtain()
                state["tracker"].addMovement(event)
                return True
            tracker = state["tracker"]
            if tracker is not None:
                tracker.addMovement(event)
            if action == X.MotionEvent.ACTION_MOVE:
                dx, dy = event.getX() - state["x"], event.getY() - state["y"]
                if not state["drag"]:
                    if abs(dx) > slop and abs(dx) > abs(dy):
                        state["drag"] = True
                        view.getParent().requestDisallowInterceptTouchEvent(True)
                        state["x"] = event.getX()
                    return True
                delta = -(event.getX() - state["x"]) / float(step)
                state["x"] = event.getX()
                offset = state["offset"] + delta
                if offset < 0 or offset > count - 1:
                    offset = state["offset"] + delta * 0.35
                place(offset)
                return True
            if action == X.MotionEvent.ACTION_UP or action == X.MotionEvent.ACTION_CANCEL:
                view.getParent().requestDisallowInterceptTouchEvent(False)
                if state["drag"] and tracker is not None:
                    tracker.computeCurrentVelocity(1000)
                    target = int(round(state["offset"] - tracker.getXVelocity() / (step * 4.0)))
                    base = int(round(state["start"]))
                    target = max(0, min(count - 1, max(base - 1, min(base + 1, target))))
                    animate_to(float(target))
                elif action == X.MotionEvent.ACTION_UP:
                    on_tap(view, event.getX(), event.getY())
                if tracker is not None:
                    tracker.recycle()
                    state["tracker"] = None
            return True

        stage.setOnTouchListener(P.Touch(on_touch))
        lp = X.LinearLayout.LayoutParams(-1, -2)
        lp.setMargins(0, dp(12), 0, dp(4))
        row = root.findViewWithTag(BUTTONS_TAG)
        index = parent.indexOfChild(row) + 1 if row is not None and row.getParent() == parent \
            else parent.indexOfChild(info) + 1
        parent.addView(holder, index, lp)
        place(0.0)
        return True

    def _circle(self, bmp, size):
        X = widgets()
        side = min(bmp.getWidth(), bmp.getHeight())
        square = X.Bitmap.createBitmap(bmp, (bmp.getWidth() - side) // 2, (bmp.getHeight() - side) // 2, side, side)
        scaled = X.Bitmap.createScaledBitmap(square, size, size, True)
        out = X.Bitmap.createBitmap(size, size, X.Bitmap.Config.ARGB_8888)
        paint = X.Paint(X.Paint.ANTI_ALIAS_FLAG)
        paint.setShader(X.BitmapShader(scaled, X.Shader.TileMode.CLAMP, X.Shader.TileMode.CLAMP))
        X.Canvas(out).drawCircle(size / 2.0, size / 2.0, size / 2.0, paint)
        return out

    def _initials(self, name, uid, size):
        X = widgets()
        out = X.Bitmap.createBitmap(size, size, X.Bitmap.Config.ARGB_8888)
        canvas = X.Canvas(out)
        paint = X.Paint(X.Paint.ANTI_ALIAS_FLAG)
        # Paint.setColor(int) is called with an explicit jint, otherwise the long overload is picked
        paint.setColor(X.jint(signed(AVATAR_COLORS[int(uid or 0) % len(AVATAR_COLORS)])))
        canvas.drawCircle(size / 2.0, size / 2.0, size / 2.0, paint)
        words = [w for w in str(name).split() if w[:1].isalnum()]
        text = "".join(w[0] for w in words[:2]).upper() or "?"
        pen = X.Paint(X.Paint.ANTI_ALIAS_FLAG)
        pen.setColor(X.jint(-1))
        pen.setTypeface(X.Typeface.DEFAULT_BOLD)
        pen.setTextSize(size * 0.4)
        pen.setTextAlign(X.Paint.Align.CENTER)
        canvas.drawText(text, size / 2.0, size / 2.0 - (pen.descent() + pen.ascent()) / 2.0, pen)
        return out

    # ---------- sheet text block ----------

    def _parse_user_id(self, arg):
        match = USER_LINK_RE.search(arg)
        if match:
            return int(match.group(1))
        return int(arg) if DIGITS_RE.match(arg) else None

    def _find_user(self, uid, cb):
        cached = None
        try:
            cached = MessagesController.getInstance(UserConfig.selectedAccount).getUser(int(uid))
        except Exception as e:
            log(f"channel_inspector user cache: {e}")
        if cached is not None:
            self._usable_user(cached, lambda full: cb(full or cached))
            return
        from java.util import ArrayList
        try:
            ref = TLRPC.TL_inputUser()
            ref.user_id = uid
            ref.access_hash = 0
            ids = ArrayList()
            ids.add(ref)
            req = TLRPC.TL_users_getUsers()
            req.id = ids
        except Exception as e:
            log(f"channel_inspector getUsers: {e}")
            cb(None)
            return

        def rcb(res, err):
            objects = g(res, "objects") if (res is not None and not err) else None
            user = objects.get(0) if objects is not None and objects.size() > 0 else None
            if user is None or g(user, "id") != uid:
                cb(None)
                return
            self._usable_user(user, lambda full: cb(full or user))

        send_request(req, rcb)

    def _user_command(self, uid, mode):
        self._toast(_mz_t("Шукаю користувача", "Looking for the user", "Ищу пользователя"))

        def found(user):
            if user is None:
                self._toast(_mz_t("Клієнт не знає цього користувача, за ID його не знайти", "The client doesn't know this user, so it can't be found by ID", "Клиент не знает этого пользователя, по ID найти его нельзя"))
                return
            if mode == "avatars":
                self._show_user_avatars(user)
                return
            name = display_name(user) or f"id {uid}"
            username = public_username(user)
            head = [_mz_t(f"Ім'я: {name}", f"Name: {name}", f"Имя: {name}"), f"ID: {uid}", _mz_t(f"Посилання: tg://user?id={uid}", f"Link: tg://user?id={uid}", f"Ссылка: tg://user?id={uid}"),
                    f"Username: @{username}" if username else _mz_t("Username: не знайдено", "Username: not found", "Username: не найден")]
            self._user_deep(user, False, lambda lines: self._dialog(name, head + [""] + lines, None, None))

        self._find_user(uid, found)

    def _open_user(self, user):
        url = f"tg://user?id={g(user, 'id')}"
        try:
            sheet = getattr(self, "_sheet", None)
            if sheet is not None:
                sheet.dismiss()
        except Exception as e:
            log(f"channel_inspector closing sheet: {e}")
        frag = get_last_fragment()
        ctx = frag.getParentActivity() if frag else None
        if ctx is None:
            self._toast(url)
            return
        run_on_ui_thread(lambda: Browser.openUrl(ctx, url), 150)

    def _match_via_users(self, inv, head, compact, cb):
        # The server does not return the ID of a private chat, but it is visible in common chats with a member if you are in it
        users = g(inv, "participants")
        if not self.on("e_find") or users is None or users.size() == 0:
            cb([])
            return
        title = g(inv, "title") or ""
        photo = self._photo(inv)
        photo_id = g(photo, "id") if photo is not None else None
        count = g(inv, "participants_count")
        tasks = [lambda c, u=users.get(i): self._common_match(u, title, photo_id, count, c)
                 for i in range(min(users.size(), 5))]

        def done(lines):
            found = list(dict.fromkeys(line for line in lines if line.startswith(("ID чата", "ID чату", "Chat ID"))))
            cb(head + (found or [_mz_t("ID через спільні чати учасників не знайдено: чат не видно, поки ви в ньому не перебуваєте", "Chat ID not found via members' common chats: the chat is not visible until you join it", "ID через общие чаты участников не найден: чат не виден, пока вы в нём не состоите")]))

        self._gather(tasks, done)

    def _common_match(self, user, title, photo_id, count, cb):
        def with_user(full_user):
            if full_user is None:
                cb([])
                return
            req = TLRPC.TL_messages_getCommonChats()
            req.user_id = self._input_user(full_user)
            req.max_id = 0
            req.limit = 100

            def rcb(res, err):
                chats = g(res, "chats") if (res is not None and not err) else None
                for i in range(chats.size() if chats is not None else 0):
                    chat = chats.get(i)
                    score = 0
                    if photo_id is not None and g(g(chat, "photo"), "photo_id") == photo_id:
                        score += 3
                    if g(chat, "title") == title:
                        score += 2
                    if count and g(chat, "participants_count") == count:
                        score += 1
                    if score >= 3:
                        cid = g(chat, "id")
                        bot_id = f"-100{cid}" if chat.getClass().getSimpleName() == "TL_channel" else f"-{cid}"
                        who = display_name(user) or g(user, "id")
                        cb([_mz_t(f"ID чату: {cid} (Bot API: {bot_id}), знайдено через {who}", f"Chat ID: {cid} (Bot API: {bot_id}), found via {who}", f"ID чата: {cid} (Bot API: {bot_id}), найден через {who}")])
                        return
                cb([])

            send_request(req, rcb)

        self._usable_user(user, with_user)

    def _cached(self, key, cb, runner):
        hit = self._peek_cache.get(key)
        if hit and time.time() - hit[0] < 600:
            cb(hit[1])
            return

        def store(lines):
            self._peek_cache[key] = (time.time(), lines)
            cb(lines)

        runner(store)

    def _original_about(self, inv):
        about = g(inv, "about") or ""
        index = about.find(MARK)
        return about[:index].rstrip() if index >= 0 else about

    def _users_summary(self, inv):
        users = g(inv, "participants")
        total = users.size() if users is not None else 0
        if total == 0:
            return None
        premium = bots = verified = 0
        centers = {}
        for i in range(total):
            user = users.get(i)
            premium += 1 if g(user, "premium") else 0
            bots += 1 if g(user, "bot") else 0
            verified += 1 if g(user, "verified") else 0
            photo = g(user, "photo")
            dc = g(photo, "dc_id") if photo is not None else None
            if dc:
                centers[int(dc)] = centers.get(int(dc), 0) + 1
        parts = [_mz_t(f"видимих {total}", f"visible {total}", f"видимых {total}")]
        for label, value in (("premium", premium), (_mz_t("боти", "bots", "боты"), bots), (_mz_t("верифікованих", "verified", "верифицированных"), verified)):
            if value:
                parts.append(f"{label} {value}")
        if centers:
            parts.append("DC: " + ", ".join(f"{k}×{v}" for k, v in sorted(centers.items(), key=lambda kv: -kv[1])))
        return " · ".join(parts)

    def _user_base_facts(self, user):
        # Fields that exist even for the shortened users from the invite
        facts = []
        status = status_text(user)
        if self.on("su_status") and status:
            facts.append((_mz_t("Активність", "Activity", "Активность"), status))
        photo = g(user, "photo")
        has_photo = photo is not None and photo.getClass().getSimpleName() != "TL_userProfilePhotoEmpty"
        if self.on("su_dc") and has_photo and dc_text(g(photo, "dc_id")):
            facts.append((_mz_t("Дата-центр", "Data center", "Дата-центр"), dc_text(g(photo, "dc_id"))))
        if self.on("su_photo"):
            facts.append((_mz_t("Аватарка", "Avatar", "Аватарка"), (_mz_t("анімована", "animated", "анимированная") if g(photo, "has_video") else _mz_t("є", "yes", "есть")) if has_photo else _mz_t("немає", "none", "нет")))
        if self.on("su_extra"):
            emoji = g(user, "emoji_status")
            if emoji is not None and g(emoji, "document_id"):
                until = fmt_date(g(emoji, "until"))
                facts.append((_mz_t("Емодзі-статус", "Emoji status", "Эмодзи-статус"), _mz_t(f"до {until}", f"until {until}", f"до {until}") if until else _mz_t("задано", "set", "задан")))
            if g(user, "lang_code"):
                facts.append((_mz_t("Мова", "Language", "Язык"), g(user, "lang_code")))
        if self.on("su_namerefs"):
            found = re.findall(r"[@#]\w+|https?://\S+|t\.me/\S+", display_name(user))
            if found:
                facts.append((_mz_t("В імені", "In the name", "В имени"), " ".join(found[:3])))
        return facts

    def _copy_user(self, user):
        username = public_username(user)
        lines = [display_name(user), f"@{username}" if username else None, f"id {g(user, 'id')}",
                 f"tg://user?id={g(user, 'id')}"]
        self._copy("\n".join(x for x in lines if x))

    def _report(self, inv, h):
        self._toast(_mz_t("Збираю звіт", "Collecting the report", "Собираю отчёт"))
        title = g(inv, "title", _mz_t("Запрошення", "Invite", "Приглашение")) or _mz_t("Запрошення", "Invite", "Приглашение")
        base = [_mz_t(f"Назва: {title}", f"Title: {title}", f"Название: {title}"), _mz_t(f"Опис: {self._original_about(inv) or 'немає'}", f"Description: {self._original_about(inv) or 'none'}", f"Описание: {self._original_about(inv) or 'нет'}")]
        base += self._rows_to_lines(self._invite_rows(inv, h))
        self._gather(self._enrich_tasks(inv, h, False),
                     lambda extra: run_on_ui_thread(lambda: self._copy("\n".join(base + extra))))

    def _photo(self, inv):
        photo = g(inv, "photo")
        return photo if photo is not None and photo.getClass().getSimpleName() == "TL_photo" else None

    def _size_list(self, photo):
        out = []
        sizes = g(photo, "sizes")
        for i in range(sizes.size() if sizes is not None else 0):
            size = sizes.get(i)
            kind = size.getClass().getSimpleName()
            letter = g(size, "type", "")
            if kind == "TL_photoStrippedSize":
                data = g(size, "bytes")
                out.append((_mz_t(f"{letter} мініатюра {len(data) if data is not None else '?'} Б", f"{letter} thumbnail {len(data) if data is not None else '?'} B", f"{letter} миниатюра {len(data) if data is not None else '?'} Б"), 0, 0))
                continue
            w, h = int(g(size, "w", 0) or 0), int(g(size, "h", 0) or 0)
            if w:
                weight = g(size, "size")
                out.append((f"{letter} {w}×{h}" + (f" ({fmt_size(weight)})" if weight else ""), w, h))
        return out

    def _facts(self, inv, h):
        facts = []

        def add(key, section, group, label, value, short=None):
            if value in (None, ""):
                return
            facts.append({"key": key, "section": section, "group": group, "label": label, "value": str(value),
                          "short": f"{label}: {value}" if short is None else short})

        kind = chat_kind(inv)
        visibility = _mz_t("публічний", "public", "публичный") if g(inv, "public") else _mz_t("приватний", "private", "приватный")
        by_request = g(inv, "request_needed")
        count = g(inv, "participants_count")
        add("s_type", _mz_t("Канал", "Channel", "Канал"), "g1", _mz_t("Тип", "Type", "Тип"), f"{kind}, {visibility}", f"{kind.capitalize()} · {visibility}")
        add("s_join", _mz_t("Канал", "Channel", "Канал"), "g1", _mz_t("Вступ", "Joining", "Вступление"), _mz_t("за заявкою адмінів", "by admin approval", "по заявке админов") if by_request else _mz_t("вільний", "open", "свободное"),
            _mz_t("за заявкою", "by request", "по заявке") if by_request else _mz_t("вільний вхід", "open entry", "свободный вход"))
        if count is not None:
            add("s_count", _mz_t("Канал", "Channel", "Канал"), "g1", _mz_t("Учасників", "Members", "Участников"), num(count), _mz_t(f"{num(count)} учасн.", f"{num(count)} members", f"{num(count)} участн."))
        flags = flag_labels(inv)
        add("s_flags", _mz_t("Канал", "Channel", "Канал"), "g2", _mz_t("Позначки", "Flags", "Метки"), ", ".join(flags) if flags else _mz_t("немає", "none", "нет"),
            (_mz_t("позначки: ", "flags: ", "метки: ") + ", ".join(flags)) if flags else False)
        price = g(inv, "subscription_pricing")
        if price is not None:
            days = int(g(price, "period", 0) or 0) // 86400
            renew = _mz_t(", можна поновити", ", can be renewed", ", можно возобновить") if g(inv, "can_refulfill_subscription") else ""
            add("s_price", _mz_t("Канал", "Channel", "Канал"), "g3", _mz_t("Підписка", "Subscription", "Подписка"), _mz_t(f"{g(price, 'amount')} зірок / {days} дн.{renew}", f"{g(price, 'amount')} stars / {days} d{renew}", f"{g(price, 'amount')} звёзд / {days} дн.{renew}"))
        verification = g(inv, "bot_verification")
        if verification is not None:
            add("s_botver", _mz_t("Канал", "Channel", "Канал"), "g4", _mz_t("Верифікація ботом", "Verified by bot", "Верификация ботом"),
                _mz_t(f"{g(verification, 'description') or 'без опису'} (бот {g(verification, 'bot_id')})", f"{g(verification, 'description') or 'no description'} (bot {g(verification, 'bot_id')})", f"{g(verification, 'description') or 'без описания'} (бот {g(verification, 'bot_id')})"))
        color = g(inv, "color")
        if color is not None:
            parts = []
            if g(color, "color") is not None:
                parts.append(str(g(color, "color")))
            if g(color, "background_emoji_id"):
                parts.append(_mz_t(f"емодзі {g(color, 'background_emoji_id')}", f"emoji {g(color, 'background_emoji_id')}", f"эмодзи {g(color, 'background_emoji_id')}"))
            add("s_color", _mz_t("Канал", "Channel", "Канал"), "g5", _mz_t("Колір профілю", "Profile color", "Цвет профиля"), ", ".join(parts))
        add("s_idnote", _mz_t("Канал", "Channel", "Канал"), "g9", _mz_t("ID чату", "Chat ID", "ID чата"), _mz_t("недоступний до вступу", "unavailable until you join", "недоступен до вступления"))

        photo = self._photo(inv)
        if photo is not None:
            dc = dc_text(g(photo, "dc_id"))
            add("s_pdc", _mz_t("Аватарка", "Avatar", "Аватарка"), "g6", _mz_t("Дата-центр", "Data center", "Дата-центр"), dc, dc)
            add("s_pid", _mz_t("Аватарка", "Avatar", "Аватарка"), "g6", _mz_t("ID фото", "Photo ID", "ID фото"), g(photo, "id"), _mz_t(f"фото {g(photo, 'id')}", f"photo {g(photo, 'id')}", f"фото {g(photo, 'id')}"))
            add("s_phash", _mz_t("Аватарка", "Avatar", "Аватарка"), "g7", _mz_t("access_hash фото", "Photo access_hash", "access_hash фото"), g(photo, "access_hash"), False)
            uploaded = with_ago(g(photo, "date"))
            if uploaded:
                add("s_pdate", _mz_t("Аватарка", "Avatar", "Аватарка"), "g7", _mz_t("Завантажено", "Uploaded", "Загружена"), uploaded, _mz_t(f"завантажено {uploaded}", f"uploaded {uploaded}", f"загружено {uploaded}"))
                add("s_minage", _mz_t("Аватарка", "Avatar", "Аватарка"), "g7", _mz_t("Чат існує щонайменше з", "Chat exists since at least", "Чат существует минимум с"), uploaded, False)
            sizes = self._size_list(photo)
            if sizes:
                biggest = max(sizes, key=lambda x: x[1])
                add("s_psizes", _mz_t("Аватарка", "Avatar", "Аватарка"), "g7", _mz_t("Розміри прев'ю", "Preview sizes", "Размеры превью"), "; ".join(x[0] for x in sizes),
                    f"{biggest[1]}×{biggest[2]}" if biggest[1] else False)
            video = g(photo, "video_sizes")
            animated = video is not None and video.size() > 0
            add("s_panim", _mz_t("Аватарка", "Avatar", "Аватарка"), "g7", _mz_t("Анімована", "Animated", "Анимированная"), yn(animated), _mz_t("анімація", "animation", "анимация") if animated else False)
            add("s_pstick", _mz_t("Аватарка", "Avatar", "Аватарка"), "g8", _mz_t("Наліпки на фото", "Stickers on the photo", "Стикеры на фото"), yn(g(photo, "has_stickers")), False)
        if h:
            add("s_link", _mz_t("Посилання", "Link", "Ссылка"), "g10", _mz_t("Посилання", "Link", "Ссылка"), f"https://t.me/+{h}", f"t.me/+{h}")
            add("s_hash", _mz_t("Посилання", "Link", "Ссылка"), "g10", _mz_t("Хеш", "Hash", "Хэш"), h, False)
        add("s_limits", _mz_t("Недоступно до вступу", "Unavailable until you join", "Недоступно до вступления"), "g11", _mz_t("Повідомлення, файли, дати створення та вступу", "Messages, files, creation and join dates", "Сообщения, файлы, даты создания и вступления"),
            _mz_t("видно лише учасникам", "visible to members only", "видны только участникам"), _mz_t("повідомлення, файли й дати вступу видно лише учасникам", "messages, files and join dates are visible to members only", "сообщения, файлы и даты вступления видны только участникам"))
        return facts

    def _user_parts(self, user, full):
        use = (lambda key: True) if full else self.on
        name = display_name(user) or _mz_t("без імені", "no name", "без имени")
        parts = []
        if use("su_ids"):
            username = public_username(user)
            if username:
                parts.append("@" + username)
            names = g(user, "usernames")
            if names is not None and names.size() > 0:
                extra = [g(names.get(i), "username") for i in range(names.size())
                         if g(names.get(i), "username") != username]
                if extra:
                    parts.append(_mz_t("ще ", "more ", "ещё ") + ", ".join("@" + x for x in extra))
            parts.append(f"id {g(user, 'id')}")
            if full:
                parts.append(f"tg://user?id={g(user, 'id')}")
            if full and g(user, "access_hash"):
                parts.append(f"hash {g(user, 'access_hash')}")
        if use("su_flags"):
            for label, key in (("premium", "premium"), (_mz_t("верифіковано", "verified", "верифицирован"), "verified"), (_mz_t("бот", "bot", "бот"), "bot"),
                               (_mz_t("скам", "scam", "скам"), "scam"), (_mz_t("фейк", "fake", "фейк"), "fake"), (_mz_t("обмежено", "restricted", "ограничен"), "restricted"),
                               (_mz_t("контакт", "contact", "контакт"), "contact"), (_mz_t("взаємний контакт", "mutual contact", "взаимный контакт"), "mutual_contact")):
                if g(user, key):
                    parts.append(label)
        if use("su_status"):
            text = status_text(user)
            if text:
                parts.append(text)
        if use("su_dc"):
            photo = g(user, "photo")
            dc = dc_text(g(photo, "dc_id")) if photo is not None else None
            if dc:
                parts.append(dc)
        return name, parts

    def _sheet_lines(self, inv, h):
        groups = {}
        for fact in self._facts(inv, h):
            if self.on(fact["key"]) and fact["short"] is not False:
                groups.setdefault(fact["group"], []).append(fact["short"])
        lines = [" · ".join(v) for _, v in sorted(groups.items(), key=lambda kv: int(kv[0][1:]))]
        users = g(inv, "participants")
        has_users = users is not None and users.size() > 0
        summary = self._users_summary(inv)
        if summary and self.on("s_usersummary"):
            lines.append(_mz_t("Учасники: ", "Members: ", "Участники: ") + summary)
        if self.on("s_users") and not self.on("s_carousel") and has_users:
            lines += ["", _mz_t("Видимі учасники:", "Visible members:", "Видимые участники:")]
            for i in range(min(users.size(), 10)):
                name, parts = self._user_parts(users.get(i), False)
                lines.append(name + (" · " + " · ".join(parts) if parts else ""))
        elif self.on("s_users") and not has_users:
            lines += ["", _mz_t("Сервер не показав список учасників", "The server didn't show the member list", "Список участников сервер не показал")]
        return lines

    def _invite_rows(self, inv, h):
        rows, last = [], None
        for fact in self._facts(inv, h):
            if fact["section"] != last:
                rows.append(("h", fact["section"]))
                last = fact["section"]
            rows.append((fact["label"], fact["value"]))
        rows.append(("h", _mz_t("Видимі учасники", "Visible members", "Видимые участники")))
        summary = self._users_summary(inv)
        if summary:
            rows.append((_mz_t("Зведення", "Summary", "Сводка"), summary))
        users = g(inv, "participants")
        if users is not None and users.size() > 0:
            for i in range(users.size()):
                name, parts = self._user_parts(users.get(i), True)
                rows.append((name, " · ".join(parts)))
        else:
            rows.append((_mz_t("Список", "List", "Список"), _mz_t("сервер не показав", "not shown by the server", "сервер не показал")))
        return rows

    def _rows_to_lines(self, rows):
        return [header(v) if k == "h" else f"{k}: {v}" for k, v in rows]

    # ---------- avatars and viewer ----------

    def _item_from_photo(self, photo, date=None, msg_id=None):
        if photo is None:
            return None
        from org.telegram.messenger import ImageLocation
        sizes = g(photo, "sizes")
        best, best_w, best_h = None, 0, 0
        for i in range(sizes.size() if sizes is not None else 0):
            size = sizes.get(i)
            w = int(g(size, "w", 0) or 0)
            if w > best_w and size.getClass().getSimpleName() in ("TL_photoSize", "TL_photoSizeProgressive"):
                best, best_w, best_h = size, w, int(g(size, "h", 0) or 0)
        if best is None:
            return None
        return {"loc": ImageLocation.getForPhoto(best, photo), "obj": best, "parent": photo, "w": best_w,
                "h": best_h, "date": date or g(photo, "date"), "msg": msg_id, "photo": photo}

    def _current_item(self, owner):
        try:
            from org.telegram.messenger import ImageLocation
            big = g(g(owner, "photo"), "photo_big")
            if big is None:
                return None
            loc = ImageLocation.getForUserOrChat(owner, ImageLocation.TYPE_BIG)
            if loc is None:
                return None
            return {"loc": loc, "obj": big, "parent": owner, "w": 0, "h": 0, "date": None, "msg": None,
                    "photo": None}
        except Exception as e:
            log(f"channel_inspector current avatar: {e}")
            return None

    def _fetch_bitmap(self, item, timeout=14, max_side=None):
        from org.telegram.messenger import FileLoader
        X = widgets()
        loader = FileLoader.getInstance(UserConfig.selectedAccount)

        def ready():
            f = loader.getPathToAttach(item["obj"], True)
            return f if f is not None and f.exists() and f.length() > 0 else None

        f = ready()
        if f is None:
            loader.loadFile(item["loc"], item["parent"], None, 1, 1)
            deadline = time.time() + timeout
            while f is None and time.time() < deadline:
                time.sleep(0.4)
                f = ready()
        if f is None:
            return None
        path = f.getAbsolutePath()
        if not max_side:
            return X.BitmapFactory.decodeFile(path)
        bounds = X.BitmapFactory.Options()
        bounds.inJustDecodeBounds = True
        X.BitmapFactory.decodeFile(path, bounds)
        side, sample = max(bounds.outWidth, bounds.outHeight), 1
        while side // (sample * 2) >= max_side:
            sample *= 2
        opts = X.BitmapFactory.Options()
        opts.inSampleSize = sample
        return X.BitmapFactory.decodeFile(path, opts)

    def _save_bitmap(self, bmp, ctx, mode, name, quiet=False):
        try:
            from android.provider import MediaStore
            from android.content import ClipData, Context, Intent
            from android.net import Uri
            resolver = ctx.getContentResolver()
            url = MediaStore.Images.Media.insertImage(resolver, bmp, name, "Channel Inspector")
            if not url:
                raise Exception("the gallery did not accept the file")
            if mode == "copy":
                clipboard = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                clipboard.setPrimaryClip(ClipData.newUri(resolver, "avatar", Uri.parse(url)))
                self._toast(_mz_t("Аватарку скопійовано, копія лежить у галереї", "Avatar copied, the copy is in the gallery", "Аватарка скопирована, копия лежит в галерее"))
            elif mode == "share":
                def send():
                    intent = Intent(Intent.ACTION_SEND)
                    intent.setType("image/jpeg")
                    intent.putExtra(Intent.EXTRA_STREAM, Uri.parse(url))
                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                    ctx.startActivity(Intent.createChooser(intent, _mz_t("Поділитися аватаркою", "Share avatar", "Поделиться аватаркой")))
                run_on_ui_thread(send)
            elif not quiet:
                self._toast(_mz_t(f"Збережено до галереї ({bmp.getWidth()}×{bmp.getHeight()})", f"Saved to gallery ({bmp.getWidth()}×{bmp.getHeight()})", f"Сохранено в галерею ({bmp.getWidth()}×{bmp.getHeight()})"))
            return True
        except Exception as e:
            log(f"channel_inspector saving: {e}")
            if not quiet:
                self._toast(_mz_t(f"Не вдалося: {e}", f"Failed: {e}", f"Не удалось: {e}"))
            return False

    def _avatar(self, inv, avatar_view, ctx, mode):
        self._toast(_mz_t("Готую аватарку", "Preparing the avatar", "Готовлю аватарку"))

        def work():
            bmp = None
            photo = self._photo(inv)
            try:
                item = self._item_from_photo(photo)
                bmp = self._fetch_bitmap(item) if item else None
            except Exception as e:
                log(f"channel_inspector avatar loading: {e}")
            if bmp is None and avatar_view is not None:
                try:
                    bmp = avatar_view.getImageReceiver().getBitmap()
                except Exception as e:
                    log(f"channel_inspector ImageReceiver: {e}")
            if bmp is None:
                self._toast(_mz_t("Аватарка ще не завантажилась, повтори за кілька секунд", "The avatar hasn't loaded yet, try again in a few seconds", "Аватарка ещё не загрузилась, повтори через пару секунд"))
                return
            self._save_bitmap(bmp, ctx, mode, f"channel_{g(photo, 'id', 'avatar')}")

        threading.Thread(target=work, daemon=True).start()

    def _chat_photos(self, chat, done):
        items = []

        def step(offset_id):
            req = TLRPC.TL_messages_search()
            req.peer = self._input_peer(chat)
            req.q = ""
            req.filter = TLRPC.TL_inputMessagesFilterChatPhotos()
            req.limit = 100
            req.offset_id = offset_id
            req.add_offset = 0
            req.max_id = 0
            req.min_id = 0
            req.min_date = 0
            req.max_date = 0

            def cb(res, err):
                if err or res is None:
                    done(items, error_text(err, _mz_t("порожня відповідь", "empty response", "пустой ответ")))
                    return
                messages = g(res, "messages")
                total = messages.size() if messages is not None else 0
                last = 0
                for i in range(total):
                    message = messages.get(i)
                    last = message.id
                    photo = g(g(message, "action"), "photo")
                    if photo is not None and photo.getClass().getSimpleName() == "TL_photo":
                        item = self._item_from_photo(photo, g(message, "date"), message.id)
                        if item:
                            items.append(item)
                if total >= 100 and last and len(items) < 500:
                    step(last)
                else:
                    done(items, None)

            send_request(req, cb)

        step(0)

    def _full_photo(self, chat, cb):
        # The current avatar may be missing from the history, for example if it was set when the chat was created
        try:
            if chat.getClass().getSimpleName() == "TL_channel":
                req = TLRPC.TL_channels_getFullChannel()
                req.channel = self._input_channel(chat)
            else:
                req = TLRPC.TL_messages_getFullChat()
                req.chat_id = chat.id
        except Exception as e:
            log(f"channel_inspector full chat: {e}")
            cb(None)
            return

        def rcb(res, err):
            full = None if (err or res is None) else g(res, "full_chat")
            photo = g(full, "chat_photo") if full is not None else None
            if photo is not None and photo.getClass().getSimpleName() != "TL_photo":
                photo = None
            cb(photo)

        send_request(req, rcb)

    def _show_avatars(self, chat):
        self._toast(_mz_t("Завантажую список аватарок", "Loading the avatar list", "Загружаю список аватарок"))
        state = {"items": [], "error": None, "full": None, "history_done": False, "full_done": False}
        lock = threading.Lock()

        def finish():
            with lock:
                if not (state["history_done"] and state["full_done"]):
                    return
                state["history_done"] = False
            ordered = list(state["items"])
            if state["full"] is not None and self.on("v_merge"):
                current = self._item_from_photo(state["full"])
                if current:
                    ordered.insert(0, current)
            items, seen = [], set()
            for item in ordered:
                pid = str(g(item["photo"], "id")) if item.get("photo") is not None else None
                if pid is not None and pid in seen:
                    continue
                if pid is not None:
                    seen.add(pid)
                items.append(item)
            if not items:
                fallback = self._current_item(chat)
                items = [fallback] if fallback else []
            if not items:
                self._toast(_mz_t("Аватарок немає", "No avatars", "Аватарок нет") + (f" ({state['error']})" if state["error"] else ""))
                return
            if state["error"]:
                self._toast(_mz_t(f"Показано частину списку: {state['error']}", f"Showing part of the list: {state['error']}", f"Показана часть списка: {state['error']}"))
            run_on_ui_thread(lambda: self._viewer(g(chat, "title", _mz_t("Аватарки", "Avatars", "Аватарки")), items))

        def history_ready(items, error):
            state.update(items=items, error=error, history_done=True)
            finish()

        def full_ready(photo):
            state.update(full=photo, full_done=True)
            finish()

        self._chat_photos(chat, history_ready)
        self._full_photo(chat, full_ready)

    def _show_user_avatars(self, user):
        self._toast(_mz_t("Завантажую аватарки", "Loading avatars", "Загружаю аватарки"))
        name = display_name(user) or _mz_t("Користувач", "User", "Пользователь")

        def open_items(items, note=None):
            if not items:
                self._toast(_mz_t("Аватарок немає", "No avatars", "Аватарок нет"))
                return
            if note:
                self._toast(note)
            run_on_ui_thread(lambda: self._viewer(name, items))

        def with_user(full_user):
            if full_user is None:
                current = self._current_item(user)
                open_items([current] if current else [], _mz_t("Видно лише поточну аватарку: профіль закрито до вступу", "Only the current avatar is visible: the profile is hidden until you join", "Видна только текущая аватарка: профиль закрыт до вступления"))
                return
            req = TLRPC.TL_photos_getUserPhotos()
            req.user_id = self._input_user(full_user)
            req.offset = 0
            req.max_id = 0
            req.limit = 100

            def cb(res, err):
                items = []
                photos = g(res, "photos") if (res is not None and not err) else None
                for i in range(photos.size() if photos is not None else 0):
                    photo = photos.get(i)
                    if photo.getClass().getSimpleName() == "TL_photo":
                        item = self._item_from_photo(photo)
                        if item:
                            items.append(item)
                if not items:
                    current = self._current_item(full_user)
                    items = [current] if current else []
                open_items(items)

            send_request(req, cb)

        self._usable_user(user, with_user)

    def _item_info(self, item):
        lines = []
        photo = item.get("photo")
        if photo is not None:
            lines += [_mz_t(f"ID фото: {g(photo, 'id')}", f"Photo ID: {g(photo, 'id')}", f"ID фото: {g(photo, 'id')}"), f"access_hash: {g(photo, 'access_hash')}",
                      _mz_t(f"Дата-центр: {dc_text(g(photo, 'dc_id'))}", f"Data center: {dc_text(g(photo, 'dc_id'))}", f"Дата-центр: {dc_text(g(photo, 'dc_id'))}")]
            video = g(photo, "video_sizes")
            lines.append(_mz_t(f"Анімована: {yn(video is not None and video.size() > 0)}", f"Animated: {yn(video is not None and video.size() > 0)}", f"Анимированная: {yn(video is not None and video.size() > 0)}"))
            sizes = self._size_list(photo)
            if sizes:
                lines.append(_mz_t("Прев'ю: ", "Preview: ", "Превью: ") + "; ".join(x[0] for x in sizes))
        uploaded = with_ago(item.get("date"))
        if uploaded:
            lines.append(_mz_t(f"Завантажено: {uploaded}", f"Uploaded: {uploaded}", f"Загружена: {uploaded}"))
        if item.get("msg"):
            lines.append(_mz_t(f"ID повідомлення про зміну фото: {item['msg']}", f"Photo change message ID: {item['msg']}", f"ID сообщения о смене фото: {item['msg']}"))
        if item.get("w"):
            lines.append(_mz_t(f"Оригінал: {item['w']}×{item['h']}", f"Original: {item['w']}×{item['h']}", f"Оригинал: {item['w']}×{item['h']}"))
        if item.get("invite"):
            lines.append(_mz_t("Джерело: запрошення. За посиланням сервер віддає лише поточну аватарку, історія доступна після вступу", "Source: invite. Via the link the server returns only the current avatar, the history is available after joining", ("Источник: приглашение. По ссылке сервер отдаёт только текущую аватарку, "
                         "история доступна после вступления")))
        return lines or [_mz_t("Подробиць немає", "No details", "Подробностей нет")]

    def _viewer(self, title, items):
        frag = get_last_fragment()
        ctx = frag.getParentActivity() if frag else None
        if ctx is None or not items:
            self._toast(_mz_t("Нічого показувати", "Nothing to show", "Нечего показывать"))
            return
        X, P = widgets(), proxies()
        from android.app import Dialog
        try:
            from android import R
            theme = R.style.Theme_Black_NoTitleBar_Fullscreen
        except Exception:
            theme = 16973835
        count = len(items)
        screen = AndroidUtilities.displaySize.x
        bitmaps, started, failed = {}, set(), set()
        current = [0]
        zoomed = [False]
        chrome_visible = [True]
        touch = {"x": 0.0, "page": 0, "last_x": 0.0, "last_y": 0.0}

        dialog = Dialog(ctx, theme)
        root = X.FrameLayout(ctx)
        root.setBackgroundColor(X.Color.BLACK)
        scroller = X.HorizontalScrollView(ctx)
        scroller.setHorizontalScrollBarEnabled(False)
        scroller.setOverScrollMode(X.View.OVER_SCROLL_NEVER)
        strip = X.LinearLayout(ctx)
        strip.setOrientation(X.LinearLayout.HORIZONTAL)
        pages, spinners = [], []
        for _ in items:
            cell = X.FrameLayout(ctx)
            image = X.ImageView(ctx)
            image.setScaleType(X.ImageView.ScaleType.FIT_CENTER)
            cell.addView(image, X.FrameLayout.LayoutParams(-1, -1))
            spinner = X.ProgressBar(ctx)
            cell.addView(spinner, X.FrameLayout.LayoutParams(dp(40), dp(40), X.Gravity.CENTER))
            strip.addView(cell, X.LinearLayout.LayoutParams(screen, -1))
            pages.append(image)
            spinners.append(spinner)
        scroller.addView(strip)
        root.addView(scroller, X.FrameLayout.LayoutParams(-1, -1))

        shade = X.Color.argb(150, 0, 0, 0)
        counter = X.TextView(ctx)
        counter.setTextColor(X.Color.WHITE)
        counter.setTextSize(1, 14.0)
        counter.setBackgroundColor(shade)
        counter.setPadding(dp(16), dp(40), dp(64), dp(12))
        root.addView(counter, X.FrameLayout.LayoutParams(-1, -2, X.Gravity.TOP))

        close = X.TextView(ctx)
        close.setText("✕")
        close.setTextColor(X.Color.WHITE)
        close.setTextSize(1, 22.0)
        close.setGravity(X.Gravity.CENTER)
        close.setPadding(0, dp(36), 0, dp(8))
        close.setOnClickListener(P.Click(lambda: dialog.dismiss()))
        root.addView(close, X.FrameLayout.LayoutParams(dp(56), -2, X.Gravity.TOP | X.Gravity.END))

        bar = X.LinearLayout(ctx)
        bar.setOrientation(X.LinearLayout.HORIZONTAL)
        bar.setBackgroundColor(shade)
        bar.setPadding(0, dp(6), 0, dp(40))

        def load(i):
            if i < 0 or i >= count or i in started:
                return
            started.add(i)

            def work():
                try:
                    bmp = self._fetch_bitmap(items[i])
                except Exception as e:
                    log(f"channel_inspector page loading: {e}")
                    bmp = None
                if bmp is None:
                    started.discard(i)
                    if i not in failed:
                        failed.add(i)
                        self._toast(_mz_t(f"Не вдалося завантажити фото {i + 1}", f"Couldn't load photo {i + 1}", f"Не удалось загрузить фото {i + 1}"))
                    return
                bitmaps[i] = bmp

                def show():
                    pages[i].setImageBitmap(bmp)
                    spinners[i].setVisibility(X.View.GONE)
                run_on_ui_thread(show)

            threading.Thread(target=work, daemon=True).start()

        def reset_zoom():
            if zoomed[0]:
                zoomed[0] = False
                for image in pages:
                    image.setScaleX(1.0)
                    image.setScaleY(1.0)
                    image.setTranslationX(0.0)
                    image.setTranslationY(0.0)

        def refresh():
            i = current[0]
            date = with_ago(items[i].get("date"))
            counter.setText(f"{i + 1} / {count}" + (f"  ·  {date}" if date else "") + f"\n{title}")
            for j in (i, i + 1, i - 1, i + 2, i - 2):
                load(j)

        def act(mode):
            bmp = bitmaps.get(current[0])
            if bmp is None:
                self._toast(_mz_t("Фото ще завантажується", "The photo is still loading", "Фото ещё загружается"))
                return
            n = current[0] + 1
            threading.Thread(target=lambda: self._save_bitmap(bmp, ctx, mode, f"avatar_{n}"), daemon=True).start()

        def save_all():
            def work():
                saved = 0
                for i, item in enumerate(items):
                    self._toast(_mz_t(f"Зберігаю {i + 1} з {count}", f"Saving {i + 1} of {count}", f"Сохраняю {i + 1} из {count}"))
                    bmp = bitmaps.get(i)
                    if bmp is None:
                        try:
                            bmp = self._fetch_bitmap(item)
                        except Exception as e:
                            log(f"channel_inspector save all: {e}")
                    if bmp is not None and self._save_bitmap(bmp, ctx, "save", f"avatar_{i + 1}", True):
                        saved += 1
                self._toast(_mz_t(f"До галереї збережено {saved} з {count}", f"Saved {saved} of {count} to the gallery", f"В галерею сохранено {saved} из {count}"))
            threading.Thread(target=work, daemon=True).start()

        def info():
            text = "\n".join(self._item_info(items[current[0]]))
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_mz_t(f"Аватарка {current[0] + 1} з {count}", f"Avatar {current[0] + 1} of {count}", f"Аватарка {current[0] + 1} из {count}"))
            builder.set_message(text)
            builder.set_positive_button(_mz_t("Копіювати", "Copy", "Копировать"), lambda d, w: self._copy(text))
            builder.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), None)
            builder.show()

        buttons = [(_mz_t("Зберегти", "Save", "Сохранить"), lambda: act("save")), (_mz_t("Копіювати", "Copy", "Копировать"), lambda: act("copy"))]
        if self.on("v_share"):
            buttons.append((_mz_t("Поділитися", "Share", "Поделиться"), lambda: act("share")))
        if self.on("v_saveall") and count > 1:
            buttons.append((_mz_t("Усі", "All", "Все"), save_all))
        buttons.append((_mz_t("Інфо", "Info", "Инфо"), info))
        for label, action in buttons:
            tv = X.TextView(ctx)
            tv.setText(label)
            tv.setTextColor(X.Color.WHITE)
            tv.setTextSize(1, 13.0)
            tv.setGravity(X.Gravity.CENTER)
            tv.setPadding(0, dp(10), 0, dp(10))
            tv.setOnClickListener(P.Click(action))
            bar.addView(tv, X.LinearLayout.LayoutParams(0, -2, 1.0))
        root.addView(bar, X.FrameLayout.LayoutParams(-1, -2, X.Gravity.BOTTOM))

        def toggle_chrome():
            if not self.on("v_tap"):
                return
            chrome_visible[0] = not chrome_visible[0]
            visibility = X.View.VISIBLE if chrome_visible[0] else X.View.INVISIBLE
            for view in (counter, close, bar):
                view.setVisibility(visibility)

        def toggle_zoom():
            if not self.on("v_zoom"):
                return
            if zoomed[0]:
                reset_zoom()
            else:
                zoomed[0] = True
                pages[current[0]].setScaleX(2.5)
                pages[current[0]].setScaleY(2.5)

        detector = X.GestureDetector(ctx, P.Gesture(toggle_chrome, toggle_zoom))
        detector.setOnDoubleTapListener(P.Gesture(toggle_chrome, toggle_zoom))

        def on_scroll(view, x):
            page = int(round(x / float(screen)))
            if page != current[0] and 0 <= page < count:
                reset_zoom()
                current[0] = page
                refresh()

        def on_touch(view, event):
            detector.onTouchEvent(event)
            action = event.getActionMasked()
            if zoomed[0]:
                image = pages[current[0]]
                if action == X.MotionEvent.ACTION_DOWN:
                    touch["last_x"], touch["last_y"] = event.getX(), event.getY()
                elif action == X.MotionEvent.ACTION_MOVE:
                    scale = image.getScaleX()
                    max_x, max_y = screen * (scale - 1) / 2.0, image.getHeight() * (scale - 1) / 2.0
                    image.setTranslationX(max(-max_x, min(max_x, image.getTranslationX() + event.getX() - touch["last_x"])))
                    image.setTranslationY(max(-max_y, min(max_y, image.getTranslationY() + event.getY() - touch["last_y"])))
                    touch["last_x"], touch["last_y"] = event.getX(), event.getY()
                return True
            if action == X.MotionEvent.ACTION_DOWN:
                touch["x"] = event.getX()
                touch["page"] = int(round(view.getScrollX() / float(screen)))
            elif action == X.MotionEvent.ACTION_UP or action == X.MotionEvent.ACTION_CANCEL:
                dx = touch["x"] - event.getX()
                page = touch["page"] + (1 if dx > screen * 0.12 else -1 if dx < -screen * 0.12 else 0)
                page = max(0, min(count - 1, page))
                run_on_ui_thread(lambda: view.smoothScrollTo(page * screen, 0))
            return False

        def apply_insets():
            # padding for the status bar and navigation bar
            try:
                insets = root.getRootWindowInsets()
                if insets is None:
                    return
                top, bottom = insets.getSystemWindowInsetTop(), insets.getSystemWindowInsetBottom()
                counter.setPadding(dp(16), top + dp(10), dp(64), dp(12))
                close.setPadding(0, top + dp(6), 0, dp(8))
                bar.setPadding(0, dp(6), 0, bottom + dp(6))
            except Exception as e:
                log(f"channel_inspector insets: {e}")

        scroller.setOnScrollChangeListener(P.Scroll(on_scroll))
        scroller.setOnTouchListener(P.Touch(on_touch))
        dialog.setContentView(root)
        dialog.show()
        refresh()
        for delay in (120, 500):
            run_on_ui_thread(apply_insets, delay)

    # ---------- commands ----------

    def on_send_message_hook(self, account, params):
        text = (g(params, "message", "") or "").strip()
        low = text.lower()
        cmd = next((c for c in (".avatars", ".chstats", ".chinfo") if low.startswith(c)), None)
        if cmd is None:
            return HookResult()
        mode = {".avatars": "avatars", ".chstats": "stats", ".chinfo": "info"}[cmd]
        arg = text[len(cmd):].strip()
        cancel = HookResult(strategy=HookStrategy.CANCEL)
        if not arg:
            if self._run_for_current_chat(g(params, "peer"), mode):
                return cancel
            self._toast(_mz_t(f"Вкажи посилання або @username: {cmd} t.me/+abc", f"Provide a link or @username: {cmd} t.me/+abc", f"Укажи ссылку или @username: {cmd} t.me/+abc"))
            return cancel
        match = INVITE_RE.search(arg)
        if match:
            self._check_invite(match.group(1), mode)
            return cancel
        uid = self._parse_user_id(arg)
        if uid:
            self._user_command(uid, mode)
            return cancel
        match = USER_RE.search(arg)
        if match:
            self._resolve(match.group(1), mode)
        else:
            self._toast(_mz_t("Не зрозумів посилання", "Couldn't parse the link", "Не понял ссылку"))
        return cancel

    def _run_for_current_chat(self, peer, mode):
        if not peer:
            return False
        try:
            controller = MessagesController.getInstance(UserConfig.selectedAccount)
            if int(peer) < 0:
                chat = controller.getChat(-int(peer))
                if chat is not None:
                    self._dispatch_chat(chat, mode)
                    return True
            elif mode == "avatars" and self.on("v_users"):
                user = controller.getUser(int(peer))
                if user is not None:
                    self._show_user_avatars(user)
                    return True
        except Exception as e:
            log(f"channel_inspector current chat: {e}")
        return False

    def _dispatch_chat(self, chat, mode):
        if mode == "avatars":
            self._show_avatars(chat)
        else:
            self._with_full(chat, None, mode)

    def _check_invite(self, invite_hash, mode="info"):
        req = TLRPC.TL_messages_checkChatInvite()
        req.hash = invite_hash

        def cb(res, err):
            if err or res is None:
                self._toast(_mz_t("Посилання недійсне або відкликане", "The link is invalid or revoked", "Ссылка недействительна или отозвана"))
                return
            if res.getClass().getSimpleName() in ("TL_chatInviteAlready", "TL_chatInvitePeek"):
                if mode == "avatars":
                    self._show_avatars(res.chat)
                else:
                    self._with_full(res.chat, invite_hash, mode)
                return
            if mode == "avatars":
                item = self._item_from_photo(self._photo(res))
                if item is None:
                    self._toast(_mz_t("В запрошенні немає аватарки", "The invite has no avatar", "В приглашении нет аватарки"))
                else:
                    item["invite"] = True
                    run_on_ui_thread(lambda: self._viewer(g(res, "title", _mz_t("Аватарка", "Avatar", "Аватарка")), [item]))
                return
            title = g(res, "title", _mz_t("Запрошення", "Invite", "Приглашение")) or _mz_t("Запрошення", "Invite", "Приглашение")
            self._toast(_mz_t("Збираю дані", "Collecting data", "Собираю данные"))
            if mode == "stats":
                base = self._invite_stats(res)
            else:
                base = [_mz_t(f"Назва: {title}", f"Title: {title}", f"Название: {title}"), _mz_t(f"Опис: {g(res, 'about') or 'немає'}", f"Description: {g(res, 'about') or 'none'}", f"Описание: {g(res, 'about') or 'нет'}")]
                base += self._rows_to_lines(self._invite_rows(res, invite_hash))
            self._gather(self._enrich_tasks(res, invite_hash, False),
                         lambda extra: self._dialog(title, base + extra, None, invite_hash))

        send_request(req, cb)

    def _invite_stats(self, inv):
        lines = [_mz_t(f"Назва: {g(inv, 'title')}", f"Title: {g(inv, 'title')}", f"Название: {g(inv, 'title')}")]
        if g(inv, "participants_count") is not None:
            lines.append(_mz_t(f"Учасників: {num(g(inv, 'participants_count'))}", f"Members: {num(g(inv, 'participants_count'))}", f"Участников: {num(g(inv, 'participants_count'))}"))
        photo = self._photo(inv)
        uploaded = with_ago(g(photo, "date")) if photo is not None else None
        if uploaded:
            lines.append(_mz_t(f"Чат існує щонайменше з: {uploaded}", f"Chat exists since at least: {uploaded}", f"Чат существует минимум с: {uploaded}"))
        users = g(inv, "participants")
        lines.append(_mz_t(f"Видимих учасників: {users.size() if users is not None else 0}", f"Visible members: {users.size() if users is not None else 0}", f"Видимых участников: {users.size() if users is not None else 0}"))
        lines += ["", _mz_t("Кількість повідомлень і файлів, дату створення та дати вступу сервер віддає лише учасникам чату. Доки заявку не схвалено, отримати їх не можна. Для публічних чатів і чатів, де ви є учасником, команда ці дані покаже.", "The server returns the number of messages and files, the creation date and the join dates only to chat members. They can't be obtained until the request is approved. For public chats and chats you are in, the command will show this data.", ("Количество сообщений и файлов, дату создания и даты вступления сервер отдаёт только "
                      "участникам чата. Пока заявка не одобрена, получить их нельзя. Для публичных чатов и "
                      "чатов, где вы состоите, эти данные команда покажет."))]
        return lines

    def _resolve(self, username, mode="info"):
        req = TLRPC.TL_contacts_resolveUsername()
        req.username = username

        def cb(res, err):
            if err or res is None:
                self._toast(_mz_t("Username не знайдено", "Username not found", "Юзернейм не найден"))
                return
            chats = g(res, "chats")
            if chats is None or chats.size() == 0:
                users = g(res, "users")
                has_user = users is not None and users.size() > 0
                if mode == "avatars" and has_user and self.on("v_users"):
                    self._show_user_avatars(users.get(0))
                else:
                    self._toast(_mz_t("Це не канал і не група", "This is not a channel or a group", "Это не канал и не группа") + (_mz_t(", аватарки людини: .avatars @username", ", a person's avatars: .avatars @username", ", аватарки человека: .avatars @username") if has_user else ""))
                return
            self._dispatch_chat(chats.get(0), mode)

        send_request(req, cb)

    def _with_full(self, chat, invite_hash, mode="info"):
        title = g(chat, "title", _mz_t("Чат", "Chat", "Чат"))
        is_channel = chat.getClass().getSimpleName() == "TL_channel"
        if mode == "stats":
            head = [_mz_t(f"Назва: {title}", f"Title: {title}", f"Название: {title}")]
            if with_ago(g(chat, "date")):
                head.append(_mz_t(f"Створено: {with_ago(g(chat, 'date'))}", f"Created: {with_ago(g(chat, 'date'))}", f"Создан(а): {with_ago(g(chat, 'date'))}"))
            if g(chat, "participants_count"):
                head.append(_mz_t(f"Учасників: {num(g(chat, 'participants_count'))}", f"Members: {num(g(chat, 'participants_count'))}", f"Участников: {num(g(chat, 'participants_count'))}"))
            self._gather(self._stats_tasks(chat, True),
                         lambda extra: self._dialog(title, head + extra, chat, invite_hash))
            return

        def finish(base):
            self._gather(self._stats_tasks(chat, True),
                         lambda extra: self._dialog(title, base[:-1] + extra + base[-1:], chat, invite_hash))

        if not is_channel:
            finish(self._chat_lines(chat, None))
            return
        req = TLRPC.TL_channels_getFullChannel()
        req.channel = self._input_channel(chat)
        send_request(req, lambda res, err: finish(
            self._chat_lines(chat, None if (err or res is None) else g(res, "full_chat"))))

    # ---------- requests and result assembly ----------

    def _input_user(self, user):
        result = TLRPC.TL_inputUser()
        result.user_id = user.id
        result.access_hash = g(user, "access_hash", 0) or 0
        return result

    def _input_channel(self, chat):
        result = TLRPC.TL_inputChannel()
        result.channel_id = chat.id
        result.access_hash = g(chat, "access_hash", 0) or 0
        return result

    def _input_peer(self, chat):
        if chat.getClass().getSimpleName() == "TL_channel":
            result = TLRPC.TL_inputPeerChannel()
            result.channel_id = chat.id
            result.access_hash = g(chat, "access_hash", 0) or 0
        else:
            result = TLRPC.TL_inputPeerChat()
            result.chat_id = chat.id
        return result

    def _usable_user(self, user, cb):
        # Users from invites come in a shortened form and do not work in requests.
        # The full object is taken by username, and if there is none, it is searched by name and the ID is checked
        if not g(user, "min"):
            cb(user)
            return
        uid = g(user, "id")
        if uid in self._user_cache:
            cb(self._user_cache[uid])
            return
        username = public_username(user)
        queries = []
        if username:
            queries.append(("name", username))
        elif self.on("e_namesearch"):
            full_name = display_name(user)
            clean = " ".join(re.sub(r"[#@]\S*", "", full_name).split())
            first = full_name.split()[0] if full_name.split() else ""
            for query in (full_name, clean, first):
                if query and ("find", query) not in queries:
                    queries.append(("find", query))
        if not queries:
            self._user_cache[uid] = None
            cb(None)
            return

        def attempt(index):
            if index >= len(queries) or time.time() < self._flood_until:
                self._user_cache[uid] = None
                cb(None)
                return
            kind, query = queries[index]
            if kind == "name":
                req = TLRPC.TL_contacts_resolveUsername()
                req.username = query
            else:
                req = TLRPC.TL_contacts_search()
                req.q = query
                req.limit = 50

            def rcb(res, err):
                if err and "FLOOD_WAIT" in str(g(err, "text", "")):
                    self._flood_until = time.time() + 30
                users = g(res, "users") if (res is not None and not err) else None
                for i in range(users.size() if users is not None else 0):
                    candidate = users.get(i)
                    if g(candidate, "id") == uid:
                        self._user_cache[uid] = candidate
                        cb(candidate)
                        return
                attempt(index + 1)

            send_request(req, rcb)

        attempt(0)

    def _gather(self, tasks, done):
        # Runs tasks in parallel and joins the results in the original order
        if not tasks:
            done([])
            return
        results, lock, left = {}, threading.Lock(), [len(tasks)]

        def make(index, fn):
            def cb(lines):
                with lock:
                    results[index] = lines or []
                    left[0] -= 1
                    finished = left[0] == 0
                if finished:
                    out = []
                    for k in range(len(tasks)):
                        out += results.get(k, [])
                    done(out)
            try:
                fn(cb)
            except Exception as e:
                log(f"channel_inspector task {index}: {e}")
                cb([_mz_t(f"Помилка запиту: {str(e).splitlines()[0][:70] if str(e) else 'невідомо'}", f"Request error: {str(e).splitlines()[0][:70] if str(e) else 'unknown'}", f"Ошибка запроса: {str(e).splitlines()[0][:70] if str(e) else 'неизвестно'}")])

        for i, fn in enumerate(tasks):
            make(i, fn)

    def _stats_tasks(self, chat, with_admins):
        tasks = []
        if with_admins and chat.getClass().getSimpleName() == "TL_channel" and self.on("c_admins"):
            tasks.append(lambda cb: self._admins(chat, cb))
        if self.on("c_counts"):
            tasks.append(lambda cb: self._stat_counts(chat, cb))
        if self.on("c_first"):
            tasks.append(lambda cb: self._stat_history(chat, cb))
        if self.on("c_members"):
            tasks.append(lambda cb: self._stat_members(chat, cb))
        return tasks

    def _admins(self, chat, done):
        req = TLRPC.TL_channels_getParticipants()
        req.channel = self._input_channel(chat)
        req.filter = TLRPC.TL_channelParticipantsAdmins()
        req.offset = 0
        req.limit = 100
        req.hash = 0

        def cb(res, err):
            lines = []
            try:
                participants = g(res, "participants") if (res is not None and not err) else None
                if participants is not None and participants.size() > 0:
                    users = self._users_map(g(res, "users"))
                    lines.append(header(_mz_t("Адміністратори", "Admins", "Администраторы")))
                    for i in range(participants.size()):
                        p = participants.get(i)
                        uid = g(p, "user_id") or g(g(p, "peer"), "user_id")
                        role = _mz_t("власник", "owner", "владелец") if p.getClass().getSimpleName() == "TL_channelParticipantCreator" else _mz_t("адмін", "admin", "админ")
                        rank = g(p, "rank")
                        user = users.get(uid)
                        if user is None:
                            lines.append(f"id {uid} · {role}")
                            continue
                        name, parts = self._user_parts(user, True)
                        lines.append(f"{name} · {role}" + (f" «{rank}»" if rank else "")
                                     + (" · " + " · ".join(parts) if parts else ""))
            except Exception as e:
                log(f"channel_inspector admins: {e}")
            done(lines)

        send_request(req, cb)

    def _stat_counts(self, chat, cb):
        from java.util import ArrayList
        names = (("Photos", _mz_t("фото", "photos", "фото")), ("Video", _mz_t("відео", "videos", "видео")), ("RoundVideo", _mz_t("відеоповідомлення", "video messages", "кружки")), ("Gif", "GIF"),
                 ("Document", _mz_t("файли", "files", "файлы")), ("Music", _mz_t("музика", "music", "музыка")), ("Voice", _mz_t("голосові", "voice messages", "голосовые")), ("Url", _mz_t("посилання", "links", "ссылки")))
        filters = ArrayList()
        for name, _ in names:
            klass = g(TLRPC, "TL_inputMessagesFilter" + name)
            if klass is not None:
                filters.add(klass())
        req = TLRPC.TL_messages_getSearchCounters()
        req.peer = self._input_peer(chat)
        req.filters = filters

        def rcb(res, err):
            head = [header(_mz_t("Повідомлення й файли", "Messages and files", "Сообщения и файлы"))]
            if err or res is None:
                cb(head + [_mz_t("Недоступно: ", "Unavailable: ", "Недоступно: ") + error_text(err, _mz_t("немає доступу", "no access", "нет доступа"))])
                return
            objects = g(res, "objects")
            found = {}
            for i in range(objects.size() if objects is not None else 0):
                obj = objects.get(i)
                kind = g(obj, "filter")
                if kind is not None:
                    found[kind.getClass().getSimpleName()] = ("≥" if g(obj, "inexact") else "") + num(g(obj, "count", 0))
            parts = [f"{label} {found['TL_inputMessagesFilter' + n]}" for n, label in names
                     if "TL_inputMessagesFilter" + n in found]
            cb(head + ([" · ".join(parts)] if parts else [_mz_t("Лічильники не надійшли", "Counters didn't arrive", "Счётчики не пришли")]))

        send_request(req, rcb)

    def _stat_history(self, chat, cb):
        peer = self._input_peer(chat)

        def history(offset_id, add_offset, done):
            req = TLRPC.TL_messages_getHistory()
            req.peer = peer
            req.offset_id = offset_id
            req.offset_date = 0
            req.add_offset = add_offset
            req.limit = 1
            req.max_id = 0
            req.min_id = 0
            req.hash = 0
            send_request(req, done)

        def newest(res, err):
            head = [header(_mz_t("Історія", "History", "История"))]
            if err or res is None:
                cb(head + [_mz_t("Недоступна: ", "Unavailable: ", "Недоступна: ") + error_text(err, _mz_t("немає доступу", "no access", "нет доступа"))])
                return
            messages = g(res, "messages")
            last = messages.get(0) if messages is not None and messages.size() > 0 else None
            if last is None:
                cb(head + [_mz_t("Повідомлень немає", "No messages", "Сообщений нет")])
                return
            top, total, last_date = last.id, g(res, "count"), g(last, "date")
            lines = head + [_mz_t(f"Усього повідомлень: {num(total) if total else '≈' + num(top)}", f"Total messages: {num(total) if total else '≈' + num(top)}", f"Всего сообщений: {num(total) if total else '≈' + num(top)}"), _mz_t(f"Останній ID: {top}", f"Last ID: {top}", f"Последний ID: {top}")]
            if with_ago(last_date):
                lines.append(_mz_t(f"Останнє повідомлення: {with_ago(last_date)}", f"Last message: {with_ago(last_date)}", f"Последнее сообщение: {with_ago(last_date)}"))

            def oldest(res2, err2):
                try:
                    found = g(res2, "messages")
                    if not err2 and found is not None and found.size() > 0:
                        first = found.get(0)
                        first_date = g(first, "date")
                        if with_ago(first_date):
                            lines.append(_mz_t(f"Перше повідомлення: {fmt_date(first_date)} (ID {first.id}, {ago(first_date)})", f"First message: {fmt_date(first_date)} (ID {first.id}, {ago(first_date)})", f"Первое сообщение: {fmt_date(first_date)} (ID {first.id}, {ago(first_date)})"))
                            if last_date and last_date > first_date:
                                days = max(1.0, (int(last_date) - int(first_date)) / 86400.0)
                                lines.append(_mz_t(f"У середньому повідомлень на добу: {(total or top) / days:.1f}", f"Average messages per day: {(total or top) / days:.1f}", f"В среднем сообщений в сутки: {(total or top) / days:.1f}"))
                except Exception as e:
                    log(f"channel_inspector first message: {e}")
                cb(lines)

            history(1, -1, oldest)

        history(0, 0, newest)

    def _users_map(self, user_list):
        users = {}
        for i in range(user_list.size() if user_list is not None else 0):
            user = user_list.get(i)
            users[user.id] = user
        return users

    def _who(self, users, uid):
        user = users.get(uid)
        if user is None:
            return f"id {uid}"
        username = public_username(user)
        return (display_name(user) or _mz_t("без імені", "no name", "без имени")) + (f" @{username}" if username else "") + f" · id {uid}"

    def _member_lines(self, entries, users, total):
        lines = [header(_mz_t("Учасники та вступи", "Members and joins", "Участники и вступления"))]
        dates = sorted(e["date"] for e in entries if e["date"])
        if self.on("c_members") and dates:
            now = time.time()
            lines.append(_mz_t(f"У вибірці: {len(entries)}", f"In the sample: {len(entries)}", f"В выборке: {len(entries)}") + (_mz_t(f" із {num(total)}", f" of {num(total)}", f" из {num(total)}") if total else ""))
            lines.append(_mz_t(f"Найраніший вступ: {with_ago(dates[0])}", f"Earliest join: {with_ago(dates[0])}", f"Самое раннее вступление: {with_ago(dates[0])}"))
            lines.append(_mz_t(f"Найпізніший вступ: {with_ago(dates[-1])}", f"Latest join: {with_ago(dates[-1])}", f"Самое позднее вступление: {with_ago(dates[-1])}"))
            for label, days in ((_mz_t("за добу", "in 24 hours", "за сутки"), 1), (_mz_t("за 7 днів", "in 7 days", "за 7 дней"), 7), (_mz_t("за 30 днів", "in 30 days", "за 30 дней"), 30)):
                lines.append(_mz_t(f"Вступили {label}: {sum(1 for d in dates if now - int(d) <= days * 86400)}", f"Joined {label}: {sum(1 for d in dates if now - int(d) <= days * 86400)}", f"Вступили {label}: {sum(1 for d in dates if now - int(d) <= days * 86400)}"))
        elif not dates:
            lines.append(_mz_t("Сервер не надав дат вступу", "The server didn't provide join dates", "Дат вступления сервер не отдал"))
        if self.on("c_members_list") and entries:
            lines += ["", _mz_t("Хто й коли вступив:", "Who joined and when:", "Кто и когда вступил:")]
            for entry in sorted(entries, key=lambda e: -(int(e["date"] or 0)))[:30]:
                line = self._who(users, entry["uid"])
                if entry["role"]:
                    line += f" · {entry['role']}"
                if entry["date"]:
                    line += f" · {with_ago(entry['date'])}"
                if entry["inviter"] and entry["inviter"] != entry["uid"]:
                    line += _mz_t(f" · запросив(-ла): {self._who(users, entry['inviter'])}", f" · invited by: {self._who(users, entry['inviter'])}", f" · пригласил(а): {self._who(users, entry['inviter'])}")
                lines.append(line)
            if len(entries) > 30:
                lines.append(_mz_t(f"І ще {len(entries) - 30}", f"And {len(entries) - 30} more", f"И ещё {len(entries) - 30}"))
        return lines

    def _stat_members(self, chat, cb):
        head = [header(_mz_t("Учасники та вступи", "Members and joins", "Участники и вступления"))]

        def role_of(name):
            return _mz_t("власник", "owner", "владелец") if name.endswith("Creator") else _mz_t("адмін", "admin", "админ") if name.endswith("Admin") else ""

        if chat.getClass().getSimpleName() == "TL_channel":
            req = TLRPC.TL_channels_getParticipants()
            req.channel = self._input_channel(chat)
            req.filter = TLRPC.TL_channelParticipantsRecent()
            req.offset = 0
            req.limit = 200
            req.hash = 0

            def rcb(res, err):
                if err or res is None:
                    cb(head + [_mz_t("Недоступно: ", "Unavailable: ", "Недоступно: ") + error_text(err, _mz_t("немає доступу", "no access", "нет доступа"))
                               + _mz_t(" (список видно учасникам або якщо він відкритий)", " (the list is visible to members or if it is public)", " (список виден участникам или если он открыт)")])
                    return
                entries = []
                participants = g(res, "participants")
                for i in range(participants.size() if participants is not None else 0):
                    p = participants.get(i)
                    kind = p.getClass().getSimpleName()
                    if kind in ("TL_channelParticipantBanned", "TL_channelParticipantLeft"):
                        continue
                    entries.append({"uid": g(p, "user_id") or g(g(p, "peer"), "user_id"), "date": g(p, "date"),
                                    "inviter": g(p, "inviter_id") or g(p, "promoted_by"), "role": role_of(kind)})
                cb(self._member_lines(entries, self._users_map(g(res, "users")), g(res, "count")))

            send_request(req, rcb)
            return
        req = TLRPC.TL_messages_getFullChat()
        req.chat_id = chat.id

        def fcb(res, err):
            if err or res is None:
                cb(head + [_mz_t("Недоступно: ", "Unavailable: ", "Недоступно: ") + error_text(err, _mz_t("немає доступу", "no access", "нет доступа"))])
                return
            members = g(g(g(res, "full_chat"), "participants"), "participants")
            entries = []
            for i in range(members.size() if members is not None else 0):
                p = members.get(i)
                entries.append({"uid": g(p, "user_id"), "date": g(p, "date"), "inviter": g(p, "inviter_id"),
                                "role": role_of(p.getClass().getSimpleName())})
            cb(self._member_lines(entries, self._users_map(g(res, "users")), len(entries)))

        send_request(req, fcb)

    # ---------- extra invite lookups ----------

    def _enrich_tasks(self, inv, h, compact):
        tasks = []
        if self.on("e_match"):
            tasks.append(lambda cb: self._match_task(inv, compact, cb))
        if self.on("e_links"):
            tasks.append(lambda cb: self._links_task(inv, h, cb))
        if self.on("e_users") and not (compact and self.on("s_carousel")):
            tasks.append(lambda cb: self._users_task(inv, compact, cb))
        return tasks

    def _enrich_sheet(self, info, inv, h):
        key = ("sheet", h, info.hashCode())
        if key in self._enriched:
            return
        self._enriched.add(key)
        tasks = self._enrich_tasks(inv, h, True)
        if not tasks:
            return

        def done(lines):
            if lines:
                text = "\n" + "\n".join(lines)
                run_on_ui_thread(lambda: self._append_styled(info, text))

        self._gather(tasks, done)

    def _chat_line(self, chat, label):
        parts = [f"{label}: {chat_kind(chat)} «{g(chat, 'title')}»", f"ID {g(chat, 'id')}"]
        if g(chat, "participants_count"):
            parts.append(_mz_t(f"{num(g(chat, 'participants_count'))} учасн.", f"{num(g(chat, 'participants_count'))} members", f"{num(g(chat, 'participants_count'))} участн."))
        if g(chat, "join_request"):
            parts.append(_mz_t("за заявкою", "by request", "по заявке"))
        parts += flag_labels(chat)
        return " · ".join(parts)

    def _match_task(self, inv, compact, cb):
        # A public chat has an @username: it can be found by search and matched by the avatar ID
        head = [header(_mz_t("Пошук ID чату", "Chat ID search", "Поиск ID чата"))]
        if not g(inv, "public"):
            self._match_via_users(inv, head, compact, cb)
            return
        title = g(inv, "title") or ""
        photo = self._photo(inv)
        photo_id = g(photo, "id") if photo is not None else None
        count = g(inv, "participants_count")
        req = TLRPC.TL_contacts_search()
        req.q = title
        req.limit = 25

        def rcb(res, err):
            chats = g(res, "chats") if (res is not None and not err) else None
            best, best_score = None, 0
            for i in range(chats.size() if chats is not None else 0):
                chat = chats.get(i)
                if chat.getClass().getSimpleName() not in ("TL_channel", "TL_chat"):
                    continue
                score = 0
                if photo_id is not None and g(g(chat, "photo"), "photo_id") == photo_id:
                    score += 3
                if g(chat, "title") == title:
                    score += 2
                if count and g(chat, "participants_count") == count:
                    score += 1
                if score > best_score:
                    best, best_score = chat, score
            if best is None or best_score < 3:
                self._match_via_users(inv, head, compact, cb)
                return
            how = _mz_t("ID аватарки та назва", "avatar ID and title", "ID аватарки и название") if best_score >= 5 else _mz_t("ID аватарки", "avatar ID", "ID аватарки") if best_score == 3 \
                else _mz_t("назва й кількість учасників", "title and member count", "название и число участников")
            username, chat_id = g(best, "username"), g(best, "id")
            lines = head + [f"@{username} · ID {chat_id} (Bot API: -100{chat_id})" if username else f"ID {chat_id}",
                            _mz_t(f"Збіглося: {how}", f"Matched: {how}", f"Совпало: {how}")]
            if with_ago(g(best, "date")):
                lines.append(_mz_t(f"Створено: {with_ago(g(best, 'date'))}", f"Created: {with_ago(g(best, 'date'))}", f"Создан(а): {with_ago(g(best, 'date'))}"))
            if best.getClass().getSimpleName() != "TL_channel":
                cb(lines)
                return
            full_req = TLRPC.TL_channels_getFullChannel()
            full_req.channel = self._input_channel(best)

            def fcb(res2, err2):
                full = None if (err2 or res2 is None) else g(res2, "full_chat")
                if compact:
                    if full is not None:
                        bits = [f"{label} {num(g(full, key))}" for label, key in (
                            (_mz_t("адмінів", "admins", "админов"), "admins_count"), (_mz_t("онлайн", "online", "онлайн"), "online_count"),
                            (_mz_t("заявок в очікуванні", "pending requests", "заявок в ожидании"), "requests_pending")) if g(full, key)]
                        if g(full, "linked_chat_id"):
                            bits.append(_mz_t(f"прив'язаний чат {g(full, 'linked_chat_id')}", f"linked chat {g(full, 'linked_chat_id')}", f"привязанный чат {g(full, 'linked_chat_id')}"))
                        if bits:
                            lines.append(" · ".join(bits))
                    cb(lines)
                    return
                extra = self._chat_lines(best, full)[:-1]
                self._gather(self._stats_tasks(best, True), lambda stats: cb(lines + extra + stats))

            send_request(full_req, fcb)

        send_request(req, rcb)

    def _about_refs(self, about, own_hash):
        text = about or ""
        invites = []
        for match in INVITE_RE.finditer(text):
            if match.group(1) != own_hash and match.group(1) not in invites:
                invites.append(match.group(1))
        names = []
        for pattern in (r"t\.me/([A-Za-z][A-Za-z0-9_]{3,31})", r"(?<![\w/.])@([A-Za-z][A-Za-z0-9_]{3,31})"):
            for match in re.finditer(pattern, text):
                name = match.group(1)
                if name.lower() not in RESERVED_NAMES and name.lower() not in [x.lower() for x in names]:
                    names.append(name)
        domains = []
        for url in re.findall(r"https?://[^\s<>\"']+", text):
            try:
                host = (urlparse(url).hostname or "").lower()
            except Exception:
                host = ""
            if host and host not in ("t.me", "telegram.me", "telegram.dog") and host not in domains:
                domains.append(host)
        return {"invites": invites, "names": names, "domains": domains,
                "emails": list(dict.fromkeys(re.findall(r"[\w.+-]+@[\w-]+\.[\w.-]+", text))),
                "hashtags": len(re.findall(r"(?<!\w)#\w+", text))}

    def _peek_invite(self, invite_hash, cb):
        self._cached(("invite", invite_hash), cb, lambda c: self._peek_invite_raw(invite_hash, c))

    def _peek_invite_raw(self, invite_hash, cb):
        req = TLRPC.TL_messages_checkChatInvite()
        req.hash = invite_hash

        def rcb(res, err):
            label = f"t.me/+{invite_hash}"
            if err or res is None:
                cb([_mz_t(f"{label}: недійсне або відкликане", f"{label}: invalid or revoked", f"{label}: недействительна или отозвана")])
                return
            if res.getClass().getSimpleName() in ("TL_chatInviteAlready", "TL_chatInvitePeek"):
                cb([self._chat_line(res.chat, label)])
                return
            parts = [f"{label}: {chat_kind(res)} «{g(res, 'title')}»",
                     _mz_t(f"{num(g(res, 'participants_count', 0))} учасн.", f"{num(g(res, 'participants_count', 0))} members", f"{num(g(res, 'participants_count', 0))} участн."),
                     _mz_t("за заявкою", "by request", "по заявке") if g(res, "request_needed") else _mz_t("вільний вхід", "open entry", "свободный вход")] + flag_labels(res)
            cb([" · ".join(parts)])

        send_request(req, rcb)

    def _peek_username(self, name, cb):
        self._cached(("name", name.lower()), cb, lambda c: self._peek_username_raw(name, c))

    def _peek_username_raw(self, name, cb):
        req = TLRPC.TL_contacts_resolveUsername()
        req.username = name

        def rcb(res, err):
            if err or res is None:
                cb([_mz_t(f"@{name}: не знайдено", f"@{name}: not found", f"@{name}: не найден")])
                return
            chats = g(res, "chats")
            if chats is not None and chats.size() > 0:
                cb([self._chat_line(chats.get(0), f"@{name}")])
                return
            users = g(res, "users")
            if users is not None and users.size() > 0:
                user = users.get(0)
                parts = [_mz_t(f"@{name}: {'бот' if g(user, 'bot') else 'користувач'} «{display_name(user)}»", f"@{name}: {'bot' if g(user, 'bot') else 'user'} «{display_name(user)}»", f"@{name}: {'бот' if g(user, 'bot') else 'пользователь'} «{display_name(user)}»"),
                         f"ID {g(user, 'id')}"]
                if g(user, "bot_active_users"):
                    parts.append(_mz_t(f"{num(g(user, 'bot_active_users'))} корист./міс.", f"{num(g(user, 'bot_active_users'))} users/mo", f"{num(g(user, 'bot_active_users'))} польз./мес."))
                parts += [label for label, key in (("premium", "premium"), (_mz_t("верифіковано", "verified", "верифицирован"), "verified"),
                                                   (_mz_t("скам", "scam", "скам"), "scam"), (_mz_t("фейк", "fake", "фейк"), "fake")) if g(user, key)]
                cb([" · ".join(parts)])
                return
            cb([_mz_t(f"@{name}: нічого не знайдено", f"@{name}: nothing found", f"@{name}: ничего не найдено")])

        send_request(req, rcb)

    def _links_task(self, inv, h, cb):
        refs = self._about_refs(self._original_about(inv), h)
        tasks = [lambda c, ih=ih: self._peek_invite(ih, c) for ih in refs["invites"][:3]]
        tasks += [lambda c, name=name: self._peek_username(name, c) for name in refs["names"][:5]]
        extra = []
        if refs["domains"]:
            extra.append(_mz_t("Зовнішні сайти: ", "External sites: ", "Внешние сайты: ") + ", ".join(refs["domains"][:6]))
        if refs["emails"]:
            extra.append(_mz_t("Пошти: ", "Emails: ", "Почты: ") + ", ".join(refs["emails"][:4]))
        if refs["hashtags"]:
            extra.append(_mz_t(f"Хештегів: {refs['hashtags']}", f"Hashtags: {refs['hashtags']}", f"Хэштегов: {refs['hashtags']}"))
        if not tasks and not extra:
            cb([])
            return
        self._gather(tasks, lambda lines: cb([header(_mz_t("Посилання з опису", "Links from the description", "Ссылки из описания"))] + lines + extra))

    def _users_task(self, inv, compact, cb):
        users = g(inv, "participants")
        if users is None or users.size() == 0:
            cb([])
            return
        total = min(users.size(), 5 if compact else 10)
        tasks = [lambda c, u=users.get(i): self._user_deep(u, compact, c) for i in range(total)]
        self._gather(tasks, lambda lines: cb([header(_mz_t("Профілі видимих учасників", "Profiles of visible members", "Профили видимых участников"))] + lines))

    def _user_data(self, user, need_common, cb):
        key = (g(user, "id"), need_common)
        hit = self._data_cache.get(key)
        if hit and time.time() - hit[0] < 600:
            cb(dict(hit[1]))
            return
        if time.time() < self._flood_until:
            cb({"error": _mz_t("ліміт запитів, повтори пізніше", "rate limit, try again later", "лимит запросов, повтори позже")})
            return

        def store(data):
            wait = re.search(r"FLOOD_WAIT_(\d+)", str(data.get("error", "")))
            if wait:
                self._flood_until = time.time() + int(wait.group(1))
            else:
                self._data_cache[key] = (time.time(), dict(data))
            cb(data)

        self._user_data_raw(user, need_common, store)

    def _user_data_raw(self, user, need_common, cb):
        # Profile data that the server gives the client. cb is always called, errors go into the dict
        data = {}

        def with_user(full_user):
            if full_user is None:
                data["limited"] = True
                cb(data)
                return
            data["username"] = public_username(full_user)
            try:
                req = TLRPC.TL_users_getFullUser()
                req.id = self._input_user(full_user)
            except Exception as e:
                data["error"] = str(e).splitlines()[0][:70] if str(e) else _mz_t("помилка запиту", "request error", "ошибка запроса")
                cb(data)
                return

            def after_full(res, err):
                common = 0
                try:
                    if err or res is None:
                        data["error"] = error_text(err)
                    else:
                        full = g(res, "full_user")
                        if full is None and g(res, "common_chats_count") is not None:
                            full = res
                        if full is not None:
                            settings = g(full, "settings")
                            if settings is not None:
                                data["reg"] = g(settings, "registration_month") or None
                                data["country"] = g(settings, "phone_country") or None
                                data["name_change"] = fmt_date(g(settings, "name_change_date"))
                                data["photo_change"] = fmt_date(g(settings, "photo_change_date"))
                            birthday = g(full, "birthday")
                            if birthday is not None and g(birthday, "day"):
                                data["birthday"] = f"{g(birthday, 'day')}.{g(birthday, 'month')}" + (
                                    f".{g(birthday, 'year')}" if g(birthday, "year") else "")
                            data["about"] = g(full, "about") or None
                            data["channel"] = g(full, "personal_channel_id") or None
                            data["gifts"] = g(full, "stargifts_count") or None
                            common = int(g(full, "common_chats_count", 0) or 0)
                            data["common"] = common
                except Exception as e:
                    log(f"channel_inspector profile: {e}")
                    data["error"] = str(e).splitlines()[0][:60] if str(e) else _mz_t("помилка розбору", "parse error", "ошибка разбора")
                photos_req = TLRPC.TL_photos_getUserPhotos()
                photos_req.user_id = self._input_user(full_user)
                photos_req.offset = 0
                photos_req.max_id = 0
                photos_req.limit = 1

                def after_photos(res2, err2):
                    try:
                        if res2 is not None and not err2:
                            total = g(res2, "count")
                            if not total:
                                listed = g(res2, "photos")
                                total = listed.size() if listed is not None else 0
                            data["photos"] = total or None
                    except Exception as e:
                        log(f"channel_inspector avatar count: {e}")
                    if common and need_common:
                        common_req = TLRPC.TL_messages_getCommonChats()
                        common_req.user_id = self._input_user(full_user)
                        common_req.max_id = 0
                        common_req.limit = 10

                        def after_common(res3, err3):
                            try:
                                chats = g(res3, "chats") if (res3 is not None and not err3) else None
                                if chats is not None and chats.size() > 0:
                                    data["common_titles"] = [f"«{g(chats.get(i), 'title')}»" for i in range(chats.size())]
                            except Exception as e:
                                log(f"channel_inspector common chats: {e}")
                            cb(data)

                        send_request(common_req, after_common)
                    else:
                        cb(data)

                send_request(photos_req, after_photos)

            send_request(req, after_full)

        self._usable_user(user, with_user)

    def _user_deep(self, user, compact, cb):
        uid = g(user, "id")
        who = self._who({uid: user}, uid)
        short = display_name(user) or f"id {uid}"

        def done(data):
            facts = []
            if data.get("reg"):
                facts.append(_mz_t(f"реєстрація {data['reg']}", f"registered {data['reg']}", f"регистрация {data['reg']}"))
            if data.get("country"):
                facts.append(_mz_t(f"країна номера {data['country']}", f"number country {data['country']}", f"страна номера {data['country']}"))
            if not compact:
                for label, key in ((_mz_t("ім'я змінювалося", "name was changed", "имя менялось"), "name_change"), (_mz_t("аватарка змінювалася", "avatar was changed", "аватарка менялась"), "photo_change"),
                                   (_mz_t("день народження", "birthday", "день рождения"), "birthday")):
                    if data.get(key):
                        facts.append(f"{label} {data[key]}")
                if data.get("about"):
                    facts.append(_mz_t("про себе: ", "bio: ", "о себе: ") + str(data["about"])[:140].replace("\n", " "))
                if data.get("channel"):
                    facts.append(_mz_t(f"канал у профілі: {data['channel']}", f"channel in profile: {data['channel']}", f"канал в профиле: {data['channel']}"))
                if data.get("gifts"):
                    facts.append(_mz_t(f"подарунків: {data['gifts']}", f"gifts: {data['gifts']}", f"подарков: {data['gifts']}"))
            if data.get("photos"):
                facts.append(_mz_t(f"аватарок: {data['photos']}", f"avatars: {data['photos']}", f"аватарок: {data['photos']}"))
            if data.get("common"):
                facts.append(_mz_t(f"спільних чатів: {data['common']}", f"common chats: {data['common']}", f"общих чатов: {data['common']}"))
            if not facts:
                if data.get("limited"):
                    facts.append(_mz_t("профіль закрито до вступу", "profile hidden until you join", "профиль закрыт до вступления"))
                elif data.get("error"):
                    facts.append(_mz_t("профіль недоступний: ", "profile unavailable: ", "профиль недоступен: ") + data["error"])
                else:
                    facts.append(_mz_t("сервер не надав додаткових даних", "the server provided no extra data", "сервер дополнительных данных не отдал"))
            titles = data.get("common_titles") or []
            if compact:
                cb([f"{short}: " + " · ".join(facts)])
            else:
                cb([who] + ["  " + f for f in facts] + ([_mz_t("  спільні чати: ", "  common chats: ", "  общие чаты: ") + ", ".join(titles)] if titles else []))

        self._user_data(user, not compact, done)

    # ---------- public chat data ----------

    def _chat_lines(self, chat, full):
        lines = []

        def add(label, value):
            if value not in (None, ""):
                lines.append(f"{label}: {value}")

        chat_id = g(chat, "id")
        add(_mz_t("Назва", "Title", "Название"), g(chat, "title"))
        add("ID", chat_id)
        add(_mz_t("ID у форматі Bot API", "Bot API format ID", "ID в формате Bot API"), f"-100{chat_id}" if g(chat, "broadcast") or g(chat, "megagroup") else f"-{chat_id}")
        add("access_hash", g(chat, "access_hash"))
        username = g(chat, "username")
        add("Username", f"@{username}" if username else None)
        add(_mz_t("Внутрішнє посилання", "Internal link", "Внутренняя ссылка"), f"t.me/c/{chat_id}" if chat_id else None)
        names = g(chat, "usernames")
        if names is not None and names.size() > 0:
            add(_mz_t("Усі username", "All usernames", "Все юзернеймы"), ", ".join(
                f"@{g(names.get(i), 'username')}" + ("" if g(names.get(i), "active") else _mz_t(" (неактивний)", " (inactive)", " (неактивен)"))
                for i in range(names.size())))
        kinds = [label for label, key in ((_mz_t("канал", "channel", "канал"), "broadcast"), (_mz_t("супергрупа", "supergroup", "супергруппа"), "megagroup"),
                                          (_mz_t("гігагрупа", "gigagroup", "гигагруппа"), "gigagroup"), (_mz_t("форум", "forum", "форум"), "forum")) if g(chat, key)]
        add(_mz_t("Тип", "Type", "Тип"), ", ".join(kinds) if kinds else None)
        add(_mz_t("Потрібна заявка на вступ", "Join request required", "Нужна заявка на вступление"), yn(g(chat, "join_request")))
        add(_mz_t("Писати можуть лише учасники", "Only members can write", "Писать могут только вступившие"), yn(g(chat, "join_to_send")))
        add(_mz_t("Верифіковано", "Verified", "Верифицирован"), yn(g(chat, "verified")))
        add(_mz_t("Скам / фейк", "Scam / fake", "Скам / фейк"), f"{yn(g(chat, 'scam'))} / {yn(g(chat, 'fake'))}")
        add(_mz_t("Заборона копіювання", "Copying restricted", "Запрет копирования"), yn(g(chat, "noforwards")))
        add(_mz_t("Підписи авторів", "Author signatures", "Подписи авторов"), yn(g(chat, "signatures")))
        add(_mz_t("Дата створення (за сервером)", "Creation date (by server)", "Дата создания (по серверу)"), with_ago(g(chat, "date")))
        add(_mz_t("Рівень бустів", "Boost level", "Уровень бустов"), g(chat, "level"))
        color = g(chat, "color")
        if color is not None and g(color, "color") is not None:
            add(_mz_t("Колір профілю", "Profile color", "Цвет профиля"), g(color, "color"))
        photo = g(chat, "photo")
        if photo is not None:
            add(_mz_t("Дата-центр аватарки", "Avatar data center", "Дата-центр аватарки"), dc_text(g(photo, "dc_id")))
            add(_mz_t("ID фото", "Photo ID", "ID фото"), g(photo, "photo_id"))
            add(_mz_t("Відеоаватарка", "Video avatar", "Видео-аватарка"), yn(g(photo, "has_video")))
        reasons = g(chat, "restriction_reason") if g(chat, "restricted") else None
        for i in range(reasons.size() if reasons is not None else 0):
            add(_mz_t(f"Обмеження ({g(reasons.get(i), 'platform')})", f"Restriction ({g(reasons.get(i), 'platform')})", f"Ограничение ({g(reasons.get(i), 'platform')})"), g(reasons.get(i), "text"))

        if full is not None:
            add(_mz_t("Опис", "Description", "Описание"), g(full, "about") or _mz_t("немає", "none", "нет"))
            add(_mz_t("Учасників", "Members", "Участников"), num(g(full, "participants_count", 0)))
            add(_mz_t("Онлайн", "Online", "Онлайн"), g(full, "online_count"))
            add(_mz_t("Адмінів", "Admins", "Админов"), g(full, "admins_count"))
            add(_mz_t("Вилучено / заблоковано", "Removed / banned", "Исключено / заблокировано"), f"{g(full, 'kicked_count')} / {g(full, 'banned_count')}")
            add(_mz_t("Заявок в очікуванні", "Pending requests", "Заявок в ожидании"), g(full, "requests_pending"))
            add(_mz_t("Прив'язаний чат (ID)", "Linked chat (ID)", "Привязанный чат (ID)"), g(full, "linked_chat_id") or None)
            add(_mz_t("Повільний режим, с", "Slow mode, sec", "Слоумод, сек"), g(full, "slowmode_seconds") or None)
            add(_mz_t("Список учасників видно", "Member list visible", "Список участников виден"), yn(g(full, "can_view_participants")))
            add(_mz_t("Історію приховано для нових", "History hidden for new members", "История скрыта для новых"), yn(g(full, "hidden_prehistory")))
            add(_mz_t("DC статистики", "Statistics DC", "DC статистики"), g(full, "stats_dc"))
            add(_mz_t("Отримано бустів", "Boosts received", "Бустов получено"), g(full, "boosts_applied"))
            add(_mz_t("Закріплене (ID повідомлення)", "Pinned (message ID)", "Закреп (ID сообщения)"), g(full, "pinned_msg_id") or None)
            add(_mz_t("Мігрував із чату", "Migrated from chat", "Мигрировал из чата"), g(full, "migrated_from_chat_id") or None)
            add(_mz_t("Таймер автовидалення, с", "Auto-delete timer, sec", "Таймер автоудаления, сек"), g(full, "ttl_period") or None)
            location = g(full, "location")
            if location is not None:
                add(_mz_t("Адреса", "Address", "Адрес"), g(location, "address"))
        else:
            lines.append(_mz_t("Сервер не надав повні дані каналу, показано лише базові.", "The server didn't return the full channel data, showing only the basics.", "Полные данные канала сервер не отдал, показано только базовое."))
        lines.append(_mz_t("Повідомлення чату із заявкою на вступ недоступні до схвалення.", "Messages of a chat with a join request are unavailable until it is approved.", "Сообщения чата с заявкой на вступление недоступны до одобрения."))
        return lines

    # ---------- interface ----------

    def _dialog(self, title, lines, chat, invite_hash):
        text = "\n".join(lines)

        def show():
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx is None:
                return
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(str(title))
            builder.set_message(text)
            if chat is not None:
                builder.set_positive_button(_mz_t("Аватарки", "Avatars", "Аватарки"), lambda d, w: self._show_avatars(chat))
                builder.set_neutral_button(_mz_t("Копіювати", "Copy", "Копировать"), lambda d, w: self._copy(text))
                if self.on("auto_open") and g(chat, "username"):
                    builder.set_negative_button(_mz_t("Відкрити", "Open", "Открыть"), lambda d, w: self._open_chat(chat))
                else:
                    builder.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), None)
            else:
                builder.set_positive_button(_mz_t("Копіювати", "Copy", "Копировать"), lambda d, w: self._copy(text))
                if invite_hash:
                    builder.set_neutral_button(
                        _mz_t("Вікно вступу", "Join window", "Окно вступления"), lambda d, w: Browser.openUrl(ctx, "https://t.me/+" + invite_hash))
                builder.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), None)
            builder.show()

        run_on_ui_thread(show)

    def _open_chat(self, chat):
        try:
            MessagesController.getInstance(UserConfig.selectedAccount).putChat(chat, False)
            args = Bundle()
            args.putLong("chat_id", chat.id)
            get_last_fragment().presentFragment(ChatActivity(args))
        except Exception as e:
            self._toast(_mz_t(f"Не вдалося відкрити: {e}", f"Couldn't open: {e}", f"Не удалось открыть: {e}"))

    def _copy(self, text):
        AndroidUtilities.addToClipboard(text)
        self._toast(_mz_t("Скопійовано", "Copied", "Скопировано"))

    def _toast(self, message):
        run_on_ui_thread(lambda: BulletinHelper.show_info(message))
