        "crop_pos_title": "Автокадрирование",
        "crop_pos_h": "По горизонтали (%)",
        "crop_pos_v": "По вертикали (%)",
        "crop_pos_desc": "50% — строго по центру. Меньше 50% сдвигает обрезку к верху/левому краю, больше 50% — к низу/правому краю. При ручном кадрировании используется ваш выбор.",
        "support_header": "Поддержка и разработка",
