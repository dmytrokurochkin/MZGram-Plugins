class UserManagerPlugin(BasePlugin):
    """
    Optimized plugin for managing chat and channel members
    """

    def __init__(self):
        super().__init__()
        self._chat_menu_items = {}
        self._current_operation = None
        self._operation_lock = threading.Lock()
        self._current_language = "ru"

    def on_plugin_load(self):
        """Called when the plugin loads."""
        self.log("User Manager plugin loaded")
        self._detect_language()
        self._add_chat_menu_items()

    def on_plugin_unload(self):
        """Called when the plugin unloads."""
        self.log("User Manager plugin unloaded")
        self._remove_chat_menu_items()

    def _detect_language(self):
        """Detects the system language"""
        try:
            locale = LocaleController.getInstance().getCurrentLocale()
            language = locale.getLanguage().lower()
            if language.startswith(('ru', 'uk')):
                self._current_language = "ru"
            else:
                self._current_language = "en"
            self.log(f"Language detected: {self._current_language}")
        except:
            self._current_language = "ru"

