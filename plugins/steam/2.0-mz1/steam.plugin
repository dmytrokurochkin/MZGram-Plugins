                    subtext=_mz_t("Два способи знайти свій Steam ID та інструкція щодо API-ключа", "Two ways to find your Steam ID and an API key guide", "Два способа найти свой Steam ID и инструкция по API ключу"),
                    icon="msg_secret",
                    on_click=lambda _: self._handle_show_steam_guide_alert_click(None),
