                Header(text=_mz_t("Посібники", "Guides", "Руководства")),
                Text(
                    text=_mz_t("З чого почати?", "Where to start?", "С чего начать?"),
                    subtext=_mz_t("Покроковий гайд з початкового налаштування плагіна", "Step-by-step guide for initial plugin setup", "Пошаговый гайд по первоначальной настройке плагина"),
                    icon="msg_info",
