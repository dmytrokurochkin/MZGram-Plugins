                text=_mz_t("Стиль іконок у тексті", "Icon style in text", "Стиль иконок в тексте") if is_ui_ru() else "Icon style in text",
                default=1,
                items=[_mz_t("Звичайні", "Regular", "Обычные"), "Needy Streamer Overload"] if is_ui_ru() else ["Standard", "Needy Streamer Overload"],
                icon="msg_emoji_smiles",
                link_alias="icon_style"
            ),
        ]

    def _sub_stream_settings(self):
        update_bio = self.get_setting("update_bio", False)
        items = [
            Header(text=_mz_t("Авто-статус у Telegram", "Auto status in Telegram", "Авто-статус в Telegram") if is_ui_ru() else "Telegram Auto-Status"),
            Switch(
                key="update_bio",
                text=_mz_t("Увімкнути авто-трансляцію", "Enable auto-broadcast", "Включить авто-трансляцию") if is_ui_ru() else "Enable auto-status",
                default=False,
                subtext=_mz_t("Автоматично оновлює профіль інформацією про гру", "Automatically updates profile with game info", "Автоматически обновляет профиль информацией об игре") if is_ui_ru() else "Automatically updates profile with game info",
                on_change=lambda new_value: self._show_stream_alert(new_value),
                icon="ic_ab_search",
                link_alias="update_bio"
            ),
        ]
        if update_bio:
            items.extend([
                Selector(
                    key="stream_place",
                    text=_mz_t("Куди транслювати статус", "Where to show status", "Куда транслировать статус") if is_ui_ru() else "Status location",
                    default=1 if get_user_config().isPremium() else 0,
                    items=[_mz_t("Про себе (біо)", "About (Bio)", "О себе (Био)"), _mz_t("Емодзі-статус (Telegram Premium)", "Emoji status (Telegram Premium)", "Эмодзи-статус (Telegram Premium)")] if is_ui_ru() else ["About (Bio)", "Emoji Status (Telegram Premium)"],
                    icon="menu_premium_location" if get_user_config().isPremium() else "msg_openprofile",
                    link_alias="stream_place"
                ) if get_user_config().isPremium() else None,
                Input(
                    key="check_interval",
                    text=_mz_t("Інтервал перевірки (секунди)", "Check interval (seconds)", "Интервал проверки (секунды)") if is_ui_ru() else "Check interval (seconds)",
                    subtext=_mz_t("Як часто перевіряти статус гри в Steam", "How often to check Steam game status", "Как часто проверять статус игры в Steam") if is_ui_ru() else "How often to check game status in Steam",
                    default=DEFAULT_CHECK_INTERVAL,
                    icon="input_schedule",
                    link_alias="check_interval"
                ),
                Input(
                    key="track_display_format",
                    text=_mz_t("Шаблон статусу в грі", "Game status template", "Шаблон статуса в игре") if is_ui_ru() else "In-game status template",
                    subtext=_mz_t("Використовуйте {game} для назви гри", "Use {game} for the game name", "Используйте {game} для названия игры") if is_ui_ru() else "Use {game} for game name",
                    default=DEFAULT_STREAM_STRING,
                    icon="input_forward",
                    link_alias="track_display_format"
                ),
                Input(
                    key="default_stream_text",
                    text=_mz_t("Текст, коли не в грі", "Text when not in game", "Текст когда не в игре") if is_ui_ru() else "Offline/idle text",
                    subtext=_mz_t("Показується, коли гру не запущено", "Shown when no game is running", "Отображается, когда игра не запущена") if is_ui_ru() else "Shown when no game is running",
                    default=DEFAULT_STREAM_TEXT,
                    icon="input_reply",
                    link_alias="default_stream_text"
                ),
            ])
            if Build.VERSION.SDK_INT >= 36:
                items.append(
                    Switch(
                        key="enable_live_updates",
                        text=_mz_t("Сповіщення Live Updates", "Live Updates notifications", "Уведомления Live Updates") if is_ui_ru() else "Live Updates notifications",
                        default=True,
                        subtext=_mz_t("Показує інтерактивне сповіщення Live Updates під час гри (Android 16+)", "Shows an interactive Live Updates notification while playing (Android 16+)", "Отображает интерактивное уведомление Live Updates во время игры (Android 16+)") if is_ui_ru() else "Display interactive Live Updates notification while playing (Android 16+)",
                        icon="msg_notifications",
                        link_alias="enable_live_updates"
                    )
                )
        return [x for x in items if x is not None]

    def _sub_games_settings(self):
        return [
            Header(text=_mz_t("Інвентар (.sinv)", "Inventory (.sinv)", "Инвентарь (.sinv)") if is_ui_ru() else "Inventory (.sinv)"),
            Selector(
                key="last_inv_game",
                text=_mz_t("Типова гра (.sinv)", "Default game (.sinv)", "Игра по умолчанию (.sinv)") if is_ui_ru() else "Default game (.sinv)",
                default=0,
                items=["Counter-Strike 2 (.sinv cs2)", "Team Fortress 2 (.sinv tf2)", "Dota 2 (.sinv dota)"],
                icon="files_storage",
                link_alias="last_inv_game"
            ),
            Text(
                text=_mz_t("Як відкрити інвентар?", "How to open the inventory?", "Как открыть инвентарь?") if is_ui_ru() else "How to make inventory public?",
                subtext=_mz_t("Інструкція з налаштування приватності Steam для роботи .sinv", "Guide to Steam privacy settings for .sinv", "Инструкция по настройке приватности Steam для работы .sinv") if is_ui_ru() else "Steam privacy setup instructions for .sinv",
                icon="msg_permissions",
                on_click=lambda _: self._show_inventory_privacy_guide(),
                link_alias="inv_privacy_link"
            ),
            Divider(),
            Header(text=_mz_t("Бібліотека ігор (.slibrary)", "Game library (.slibrary)", "Библиотека игр (.slibrary)") if is_ui_ru() else "Game Library (.slibrary)"),
            Switch(
                key="sort_by_playtime",
                text=_mz_t("Сортувати за часом у грі", "Sort by playtime", "Сортировать по времени игры") if is_ui_ru() else "Sort by playtime",
                default=True,
                subtext=_mz_t("Увімкнено: топ за годинами. Вимкнено: топ за датою останнього запуску", "On: top by hours. Off: top by last launch date", "Включено: топ по часам. Выключено: топ по дате последнего запуска") if is_ui_ru() else "Enabled: top by hours. Disabled: top by last played date",
                icon="msg_stats",
                link_alias="sort_by_playtime"
            ),
        ]

    def _sub_faq_settings(self):
        if is_ui_ru():
            return [
                Header(text=_mz_t("Основні команди", "Main commands", "Основные команды")),
                Text(
                    text=".sprofile / .sp",
                    subtext=_mz_t("Картка профілю Steam: аватар, рівень, статус, 3 останні ігри. Приклад: .sp 76561198...", "Steam profile card: avatar, level, status, last 3 games. Example: .sp 76561198...", "Карточка профиля Steam: аватар, уровень, статус, 3 последние игры. Пример: .sp 76561198..."),
                    icon="msg_openprofile",
                    on_click=lambda _: self._show_cmd_help(
                        ".sprofile / .sp",
                        _mz_t("Створює візуальну картку профілю Steam.\n\nМістить: аватар із кольоровим кільцем статусу, нік, \nрівень Steam, статус (у грі / у мережі / офлайн), \nпостери та години для 3 останніх ігор.\n\nВикористання:\n  .sprofile: твій профіль\n  .sp нік_або_id: профіль іншого гравця", "Generates a visual Steam profile card.\n\nIncludes: avatar with a colored status ring, nickname, \nSteam level, status (in game / online / offline), \nposters and playtime for the last 3 games.\n\nUsage:\n  .sprofile: your profile\n  .sp nick_or_id: another player's profile", ("Генерирует визуальную карточку профиля Steam.\n\n"
                        "Включает: аватар с цветным кольцом статуса, никнейм, \n"
                        "уровень Steam, статус (в игре / в сети / оффлайн), \n"
                        "постеры и часы для 3 последних игр.\n\n"
                        "Использование:\n"
                        "  .sprofile — твой профиль\n"
                        "  .sp ник_или_id — профиль другого игрока"))
                    ),
                    link_alias="cmd_sprofile"
                ),
                Text(
                    text=".nowsteam / .snp",
                    subtext=_mz_t("Картка поточної гри: банер, Metacritic, відгуки, жанри, розробник", "Current game card: banner, Metacritic, reviews, genres, developer", "Карточка текущей игры: баннер, Metacritic, отзывы, жанры, разработчик"),
                    icon="msg_photo_text_regular",
                    on_click=lambda _: self._show_cmd_help(
                        ".nowsteam / .snp",
                        _mz_t("Створює картку 1080x1080 для поточної запущеної гри.\n\nМістить: аватар із кільцем 'У грі', великий банер гри, \nназву, час у грі, оцінку Metacritic, \nвідсоток позитивних відгуків, жанри, розробника, \nдату виходу.\n\nВикористання:\n  .nowsteam: картка гри, в яку ти граєш", "Generates a 1080x1080 card for the game you are running.\n\nIncludes: avatar with an 'In game' ring, large game banner, \ntitle, playtime, Metacritic score, \npercentage of positive reviews, genres, developer, \nrelease date.\n\nUsage:\n  .nowsteam: card for the game you are playing", ("Генерирует карточку 1080x1080 для текущей запущенной игры.\n\n"
                        "Включает: аватар с кольцом 'В игре', большой баннер игры, \n"
                        "название, время в игре, оценку Metacritic, \n"
                        "процент положительных отзывов, жанры, разработчика, \n"
                        "дату выхода.\n\n"
                        "Использование:\n"
                        "  .nowsteam — карточка игры в которую ты играешь"))
                    ),
                    link_alias="cmd_nowsteam"
                ),
                Divider(),
                Header(text=_mz_t("Інвентар і бібліотека", "Inventory and library", "Инвентарь и библиотека")),
                Text(
                    text=".sinv [cs2 | tf2 | dota]",
                    subtext=_mz_t("Інвентар Steam: скіни та предмети, згруповані за рідкістю", "Steam inventory: skins and items grouped by rarity", "Инвентарь Steam: скины и предметы, сгруппированные по редкости"),
                    icon="files_storage",
                    on_click=lambda _: self._show_cmd_help(
                        ".sinv",
                        _mz_t("Завантажує й показує інвентар Steam.\n\nПідтримувані ігри:\n  CS2 (Counter-Strike 2)\n  TF2 (Team Fortress 2)\n  Dota 2\n\nВикористання:\n  .sinv: типова гра (з налаштувань)\n  .sinv cs2: інвентар CS2\n  .sinv tf2: інвентар TF2\n  .sinv dota: інвентар Dota 2\n\nПотрібен відкритий інвентар у налаштуваннях Steam!", "Loads and shows the Steam inventory.\n\nSupported games:\n  CS2 (Counter-Strike 2)\n  TF2 (Team Fortress 2)\n  Dota 2\n\nUsage:\n  .sinv: default game (from settings)\n  .sinv cs2: CS2 inventory\n  .sinv tf2: TF2 inventory\n  .sinv dota: Dota 2 inventory\n\nYour inventory must be public in Steam settings!", ("Загружает и отображает инвентарь Steam.\n\n"
                        "Поддерживаемые игры:\n"
                        "  CS2 (Counter-Strike 2)\n"
                        "  TF2 (Team Fortress 2)\n"
                        "  Dota 2\n\n"
                        "Использование:\n"
                        "  .sinv — игра по умолчанию (из настроек)\n"
                        "  .sinv cs2 — инвентарь CS2\n"
                        "  .sinv tf2 — инвентарь TF2\n"
                        "  .sinv dota — инвентарь Dota 2\n\n"
                        "Требует открытого инвентаря в настройках Steam!"))
                    ),
                    link_alias="cmd_sinv"
                ),
                Text(
                    text=".slibrary",
                    subtext=_mz_t("Список усіх ігор із бібліотеки Steam з годинами, відсортований за часом", "List of all games in your Steam library with hours, sorted by playtime", "Список всех игр из Steam библиотеки с часами, отсортированный по времени"),
                    icon="msg_search",
                    on_click=lambda _: self._show_cmd_help(
                        ".slibrary",
                        _mz_t("Виводить повну бібліотеку ігор Steam-акаунта.\n\nПоказує: кількість ігор, загальний час, \nсписок з годинами для кожної гри.\n\nСортування налаштовується в:\nНалаштування -> Інвентар і бібліотека", "Shows the full game library of the Steam account.\n\nShows: number of games, total playtime, \nlist with hours for each game.\n\nSorting is set in:\nSettings -> Inventory and library", ("Выводит полную библиотеку игр Steam-аккаунта.\n\n"
                        "Показывает: количество игр, суммарное время, \n"
