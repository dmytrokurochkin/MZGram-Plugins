DEFAULT, HIDE, SEARCH, SAVED, ARCHIVE, CALLS, CONTACTS, PROFILE, SETTINGS, PLUGINS, CHAT, GHOST = range(12)

# What a long press can do: everything except hiding. DEFAULT here means "nothing".
HOLD_CHOICES = [DEFAULT, SEARCH, SAVED, ARCHIVE, CALLS, CONTACTS, PROFILE, SETTINGS, PLUGINS, CHAT, GHOST]

