RUNNABLE_CLASS = find_class("java.lang.Runnable")


class _RunnableProxy(dynamic_proxy(RUNNABLE_CLASS)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.fn()
        except Exception:
            pass


class _ClickListener(dynamic_proxy(ONCLICKLISTENER_CLASS)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        try:
            self.fn()
        except Exception:
            pass


_FD_USERS = {5197625326}
_FD_CHANS = {3728629720}

if not hasattr(_b, "_fd_state"):
    _b._fd_state = {}
if not hasattr(_b, "_fd_hooked"):
    _b._fd_hooked = False


def _fd_int(v):
    try:
        return int(v)
    except Exception:
        return 0


def _fd_id(act):
    for name, ids, t in [("userId", _FD_USERS, "user"), ("chatId", _FD_CHANS, "channel")]:
        v = _fd_int(getattr(act, name, 0))
        if not v:
            try:
                v = _fd_int(get_private_field(act, name))
            except Exception:
                pass
        if v in ids:
            return v, t
    return 0, None


def _fd_field(o, n):
    try:
        f = o.getClass().getDeclaredField(n)
        f.setAccessible(True)
        return f
    except Exception:
        return None


def _fd_listen(fn):
    return _ClickListener(fn)


class _FDRows(MethodHook):
    def before_hooked_method(self, param):
        act = param.thisObject
        _, t = _fd_id(act)
        _b._fd_state[id(act)] = {"row": -1, "vtype": t, "ins": t is not None}

    def after_hooked_method(self, param):
        act = param.thisObject
        st = _b._fd_state.get(id(act))
        if not st or not st["ins"]:
            return
        pos = next(
            (f.getInt(act) for n in ["channelInfoRow", "usernameRow", "phoneRow", "bioRow"]
             if (f := _fd_field(act, n)) and f.getInt(act) != -1),
            -1,
        )
        if pos == -1:
            return
        st["row"] = pos
        if rc := _fd_field(act, "rowCount"):
            rc.setInt(act, rc.getInt(act) + 1)
        I = jclass("java.lang.Integer")
        for f in act.getClass().getDeclaredFields():
            n = f.getName()
            if "row" not in n.lower() or n == "rowCount":
                continue
            if f.getType() not in (I.TYPE, I):
                continue
            f.setAccessible(True)
            v = f.get(act)
            if v and int(v) >= pos != -1:
                f.setInt(act, int(v) + 1)


class _FDType(MethodHook):
    def before_hooked_method(self, param):
        try:
            f = param.thisObject.getClass().getDeclaredField("this$0")
            f.setAccessible(True)
            st = _b._fd_state.get(id(f.get(param.thisObject)))
            if st and int(param.args[0]) == st.get("row", -1):
                param.setResult(jclass("java.lang.Integer")(2))
        except Exception:
            pass


class _FDBind(MethodHook):
    def after_hooked_method(self, param):
        try:
            f = param.thisObject.getClass().getDeclaredField("this$0")
            f.setAccessible(True)
            st = _b._fd_state.get(id(f.get(param.thisObject)))
            if not st or int(param.args[1]) != st.get("row", -1):
                return
            cell = param.args[0].itemView
            if not isinstance(cell, TextDetailCell):
                return
            if st["vtype"] == "user":
                cell.setTextAndValue("🦊 FoxDrop", "Разработчик плагинов", True)
                cell.setOnClickListener(_fd_listen(lambda: BulletinHelper.show_success("✅ Официальный аккаунт разработчика плагинов FoxDrop")))
            elif st["vtype"] == "channel":
                cell.setTextAndValue("🦊 FoxDrop", "Официальный канал", True)
                cell.setOnClickListener(_fd_listen(lambda: BulletinHelper.show_success("✅ Официальный канал FoxDrop")))
        except Exception:
            pass


def _fd_init(plg):
    if _b._fd_hooked:
        return
    _b._fd_hooked = True
    I = jclass("java.lang.Integer").TYPE
    VH = jclass("androidx.recyclerview.widget.RecyclerView$ViewHolder")
    P = find_class("org.telegram.ui.ProfileActivity")
    A = find_class("org.telegram.ui.ProfileActivity$ListAdapter")
    plg.hook_method(P.getClass().getDeclaredMethod("updateRowsIds"), _FDRows())
    plg.hook_method(A.getClass().getDeclaredMethod("getItemViewType", I), _FDType())
    plg.hook_method(A.getClass().getDeclaredMethod("onBindViewHolder", VH, I), _FDBind())


def _format_like_telegram(dt):
    mon = MONTHS_RU_ABBR.get(dt.month, "")
    return f"{dt.day} {mon}. {dt.year} в {dt.strftime('%H:%M:%S')}"


def _format_date_only(dt):
    mon = MONTHS_RU_ABBR.get(dt.month, "")
    return f"{dt.day} {mon}. {dt.year}"


def _month_num(name):
    return MONTHS_RU.get(name.strip().lower()[:3])


def _parse_tooltip_date(m):
    month = _month_num(m.group(2))
    if not month:
        return None
    day = int(m.group(3))
    now = datetime.datetime.now()
    year = now.year
    try:
        dt = datetime.datetime(year, month, day)
    except ValueError:
        return None
    if dt > now + datetime.timedelta(days=3):
        try:
            dt = datetime.datetime(year - 1, month, day)
        except ValueError:
            return None
    return dt


def _parse_tx_date(m):
    day = int(m.group(1))
    month = _month_num(m.group(2))
    if not month:
        return None
    year = int(m.group(3))
    hh, mm, ss = int(m.group(4)), int(m.group(5)), int(m.group(6))
    try:
        return datetime.datetime(year, month, day, hh, mm, ss)
    except ValueError:
        return None


def _describe_view(v, depth=0):
    try:
        cls = v.getClass().getName()
        extra = ""
        try:
            if hasattr(v, "getText"):
                extra = f" text={str(v.getText())[:30]!r}"
        except Exception:
            pass
        try:
            bg = v.getBackground()
            if bg is not None:
                extra += f" bg={bg.getClass().getName()}"
        except Exception:
            pass
        return f"{'  ' * depth}{cls}{extra}"
    except Exception as e:
        return f"{'  ' * depth}<error: {e}>"


def _dump_balance_hierarchy(plugin, header_tv, attempt=0):
    if _calc_debug_dumped[0]:
        return
    if attempt == 0:
        plugin._plog("[CALC DEBUG] === header ===")
        try:
            plugin._plog(_describe_view(header_tv))
        except Exception as e:
            plugin._plog(f"[CALC DEBUG] header describe error: {e}")
            _calc_debug_dumped[0] = True
            return

    node = header_tv
    recycler = None
    monetization_layout = None
    for level in range(1, 6):
        try:
            parent = node.getParent()
        except Exception as e:
            plugin._plog(f"[CALC DEBUG] level {level} getParent() error: {e}")
            _calc_debug_dumped[0] = True
            break
        if parent is None:
            if attempt < 6:
                plugin._plog(f"[CALC DEBUG] level {level}: parent is None, retrying in 400ms (attempt {attempt + 1})")
                try:
                    from android.os import Handler, Looper
                    Handler(Looper.getMainLooper()).postDelayed(
                        _RunnableProxy(lambda: _dump_balance_hierarchy(plugin, header_tv, attempt + 1)),
                        400,
                    )
                except Exception as e:
                    plugin._plog(f"[CALC DEBUG] retry schedule failed: {e}")
                    _calc_debug_dumped[0] = True
                return
            plugin._plog(f"[CALC DEBUG] level {level}: still None after {attempt} retries, giving up")
            _calc_debug_dumped[0] = True
            break
        if not hasattr(parent, "getChildCount"):
            plugin._plog(f"[CALC DEBUG] level {level}: parent has no getChildCount ({type(parent)}), stopping")
            break
        try:
            plugin._plog(f"[CALC DEBUG] --- level {level}: {_describe_view(parent)} children={parent.getChildCount()} ---")
            for i in range(parent.getChildCount()):
                try:
                    child = parent.getChildAt(i)
                    marker = " <== HEADER PATH" if child == node else ""
                    plugin._plog(f"[CALC DEBUG]   [{i}] {_describe_view(child)}{marker}")
                    if "ColorfulTextCell" in child.getClass().getName():
                        plugin._plog(f"[CALC DEBUG]   >>> deep dump of ColorfulTextCell [{i}]:")
                        _deep_dump(plugin, child, 0, max_depth=5)
                except Exception as e:
                    plugin._plog(f"[CALC DEBUG]   [{i}] child error: {e}")
        except Exception as e:
            plugin._plog(f"[CALC DEBUG] level {level} iteration error: {e}")

        try:
            cls_name = parent.getClass().getName()
            if "UniversalRecyclerView" in cls_name:
                recycler = parent
            if "ChannelMonetizationLayout" in cls_name:
                monetization_layout = parent
        except Exception:
            pass
        node = parent

    _calc_debug_dumped[0] = True

    target = monetization_layout or recycler
    if target is not None:
        plugin._plog(f"[CALC DEBUG] === methods of {target.getClass().getName()} (fill/item/row/update) ===")
        try:
            methods = target.getClass().getMethods()
            names = sorted(set(
                f"{m.getName()}({len(m.getParameterTypes())} args)" for m in methods
                if any(k in m.getName().lower() for k in ("fill", "item", "row", "update", "getitems"))
            ))
            for n in names:
                plugin._plog(f"[CALC DEBUG]   {n}")
        except Exception as e:
            plugin._plog(f"[CALC DEBUG] methods reflection error: {e}")
    else:
        plugin._plog("[CALC DEBUG] no recycler/monetization_layout found in walked hierarchy")

    plugin._plog("[CALC DEBUG] === dump finished ===")


def _deep_dump(plugin, view, depth, max_depth=4):
    if depth > max_depth:
        return
    plugin._plog(f"[CALC DEBUG]     {_describe_view(view, depth)}")
    try:
        if hasattr(view, "getChildCount"):
            for i in range(view.getChildCount()):
                _deep_dump(plugin, view.getChildAt(i), depth + 1, max_depth)
    except Exception:
        pass


def _parse_int(s):
    try:
        digits = "".join(ch for ch in str(s) if ch.isdigit())
        return int(digits) if digits else 0
    except Exception:
        return 0


def _plural_days(n):
    n_abs = abs(n) % 100
    n1 = n_abs % 10
    if 11 <= n_abs <= 14:
        word = "\u0434\u043d\u0435\u0439"
    elif n1 == 1:
        word = "\u0434\u0435\u043d\u044c"
    elif 2 <= n1 <= 4:
        word = "\u0434\u043d\u044f"
    else:
        word = "\u0434\u043d\u0435\u0439"
    return f"{n} {word}"


def _calc_unlock_ts(target):
    avail = _calc_data.get("available", 0) or 0
    if target <= avail:
        return int(time.time())
    need = target - avail
    txs = sorted(_calc_data.get("pending_tx", []), key=lambda t: t[0])

    now_ts = int(time.time())
    total_pending = sum(a for _, a in txs)
    _mlog(
        f"[CALC DEBUG] target={target} avail={avail} need={need} "
        f"current_total={_calc_data.get('current_total')} "
        f"tx_count={len(txs)} sum(pending_tx)={total_pending}"
    )
    for d, a in txs:
        age = (now_ts - d) / 86400.0
        _mlog(f"[CALC DEBUG]   tx date={d} age={age:.2f}d amount={a}")

    cum = 0
    for date, amount in txs:
        cum += amount
        if cum >= need:
            _mlog(f"[CALC DEBUG] stopped at tx date={date} cum={cum} (need={need})")
            return date + UNLOCK_DAYS * 86400
    _mlog(f"[CALC DEBUG] never reached need — cum maxed at {cum}, need={need}")
    return None


def _update_calc_display(refs, raw_value):
    current_total = _calc_data.get("current_total", 0) or 0
    upper = max(current_total, 1000)
    clamped = max(1000, min(raw_value, upper))

    ts = _calc_unlock_ts(clamped)
    now = time.time()

    usd_rate = _calc_data.get("usd_rate", 0.0) or 0.0
    usd_val = clamped * usd_rate
    cur_str = _fmt_currency(usd_val) if usd_val else None
    sub_text = f"\u2248{usd_val:.2f} $"
    if cur_str:
        sub_text += f" (\u2248{cur_str})"

    try:
        refs["big_number"].setText(f"\u2b50 {clamped}")
        refs["sub"].setText(sub_text)
    except Exception:
        pass

    try:
        if ts is None:
            refs["days"].setText("\u2014")
            refs["date"].setText("")
        else:
            left = ts - now
            days = max(0, int(math.ceil(left / 86400)))
            if days <= 0:
                refs["days"].setText("\u0443\u0436\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e")
                refs["date"].setText("")
            else:
                refs["days"].setText(_plural_days(days))
                date_str = datetime.datetime.fromtimestamp(ts).strftime("%d.%m.%Y")
                refs["date"].setText(f"({date_str})")
    except Exception:
        pass

    return clamped


def _refresh_calculator_cards():
    for entry in list(_calc_card_registry):
        try:
            edit = entry["edit"]
            raw = _parse_int(str(edit.getText()))
            _update_calc_display(entry["refs"], raw if raw else 1000)
        except Exception:
            pass


FOCUSCHANGE_CLASS = find_class("android.view.View$OnFocusChangeListener")


class _CalcTextWatcher(dynamic_proxy(TEXTWATCHER_CLASS)):
    def __init__(self, edit_text, refs):
        super().__init__()
        self.edit_text = edit_text
        self.refs = refs
        self.updating = False

    def beforeTextChanged(self, s, start, count, after):
        pass

    def onTextChanged(self, s, start, before, count):
        pass

    def afterTextChanged(self, s):
        if self.updating:
            return
        try:
            raw = _parse_int(str(s))
            current_total = _calc_data.get("current_total", 0) or 0
            upper = max(current_total, 1000)

            if raw > upper:
                self.updating = True
                try:
                    self.edit_text.setText(str(upper))
                    self.edit_text.setSelection(len(str(upper)))
                finally:
                    self.updating = False
                raw = upper

            preview = raw if raw > 0 else 1000
            _update_calc_display(self.refs, preview)
        except Exception:
            pass


class _CalcFocusListener(dynamic_proxy(FOCUSCHANGE_CLASS)):
    def __init__(self, edit_text, refs):
        super().__init__()
        self.edit_text = edit_text
        self.refs = refs

    def onFocusChange(self, view, has_focus):
        if has_focus:
            return
        try:
            raw = _parse_int(str(self.edit_text.getText()))
            current_total = _calc_data.get("current_total", 0) or 0
            upper = max(current_total, 1000)
            clamped = max(1000, min(raw if raw else 1000, upper))
            self.edit_text.setText(str(clamped))
            self.edit_text.setSelection(len(str(clamped)))
            _update_calc_display(self.refs, clamped)
        except Exception:
            pass


def _build_calculator_view(plugin, context):
    purple = COLOR_CLASS.parseColor("#8774E1")

    outer = LINEARLAYOUT_CLASS(context)
    outer.setOrientation(LINEARLAYOUT_CLASS.VERTICAL)
    try:
        outer.setTag("fd_calc_card")
    except Exception:
        pass
    outer.setPadding(
        ANDROIDUTILITIES_CLASS.dp(16), ANDROIDUTILITIES_CLASS.dp(14),
        ANDROIDUTILITIES_CLASS.dp(16), ANDROIDUTILITIES_CLASS.dp(14),
    )
    try:
        outer.setBackgroundColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhite))
    except Exception:
        pass

    try:
        RVLayoutParams = find_class("androidx.recyclerview.widget.RecyclerView$LayoutParams")
        rv_lp = RVLayoutParams(RVLayoutParams.MATCH_PARENT, RVLayoutParams.WRAP_CONTENT)
        outer.setLayoutParams(rv_lp)
    except Exception as e:
        plugin._plog(f"[CALC BUILD] RecyclerView.LayoutParams failed: {e}")
        try:
            ViewGroupClass = find_class("android.view.ViewGroup")
            vg_lp = ViewGroupClass.LayoutParams(ViewGroupClass.LayoutParams.MATCH_PARENT, ViewGroupClass.LayoutParams.WRAP_CONTENT)
            outer.setLayoutParams(vg_lp)
        except Exception as e2:
            plugin._plog(f"[CALC BUILD] ViewGroup.LayoutParams fallback also failed: {e2}")

    try:
        outer.setMinimumHeight(ANDROIDUTILITIES_CLASS.dp(150))
    except Exception:
        pass

    GravityClass = find_class("android.view.Gravity")
    FULL_WIDTH_LP = lambda: LINEARLAYOUT_CLASS.LayoutParams(LINEARLAYOUT_CLASS.LayoutParams.MATCH_PARENT, LINEARLAYOUT_CLASS.LayoutParams.WRAP_CONTENT)

    big_number = TEXTVIEW_CLASS(context)
    big_number.setTextSize(24)
    big_number.setTypeface(None, 1)
    big_number.setGravity(GravityClass.CENTER)
    try:
        big_number.setTextColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhiteBlackText))
    except Exception:
        pass
    big_number.setLayoutParams(FULL_WIDTH_LP())
    outer.addView(big_number)

    sub = TEXTVIEW_CLASS(context)
    sub.setTextSize(14)
    sub.setGravity(GravityClass.CENTER)
    try:
        sub.setTextColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhiteGrayText))
    except Exception:
        pass
    sub.setLayoutParams(FULL_WIDTH_LP())
    outer.addView(sub)

    days_tv = TEXTVIEW_CLASS(context)
    days_tv.setTextSize(20)
    days_tv.setTypeface(None, 1)
    days_tv.setGravity(GravityClass.CENTER)
    try:
        days_tv.setTextColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhiteBlackText))
    except Exception:
        pass
    days_p = FULL_WIDTH_LP()
    days_p.setMargins(0, ANDROIDUTILITIES_CLASS.dp(6), 0, 0)
    days_tv.setLayoutParams(days_p)
    outer.addView(days_tv)

    date_tv = TEXTVIEW_CLASS(context)
    date_tv.setTextSize(13)
    date_tv.setGravity(GravityClass.CENTER)
    try:
        date_tv.setTextColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhiteGrayText))
    except Exception:
        pass
    date_tv.setLayoutParams(FULL_WIDTH_LP())
    outer.addView(date_tv)

    box = LINEARLAYOUT_CLASS(context)
    box.setOrientation(LINEARLAYOUT_CLASS.VERTICAL)
    box_bg = GRADIENTDRAWABLE_CLASS()
    box_bg.setShape(GRADIENTDRAWABLE_CLASS.RECTANGLE)
    box_bg.setCornerRadius(ANDROIDUTILITIES_CLASS.dp(10))
    box_bg.setColor(COLOR_CLASS.TRANSPARENT)
    box_bg.setStroke(ANDROIDUTILITIES_CLASS.dp(1), purple)
    box.setBackground(box_bg)
    box.setPadding(
        ANDROIDUTILITIES_CLASS.dp(12), ANDROIDUTILITIES_CLASS.dp(8),
        ANDROIDUTILITIES_CLASS.dp(12), ANDROIDUTILITIES_CLASS.dp(8),
    )
    box_p = FULL_WIDTH_LP()
    box_p.setMargins(0, ANDROIDUTILITIES_CLASS.dp(10), 0, 0)
    box.setLayoutParams(box_p)

    label = TEXTVIEW_CLASS(context)
    label.setText("\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u043e\u0434\u0441\u0447\u0451\u0442\u0430")
    label.setTextSize(12)
    label.setTextColor(purple)
    box.addView(label)

    edit = EDITTEXT_CLASS(context)
    edit.setText("1000")
    edit.setInputType(INPUTTYPE_CLASS.TYPE_CLASS_NUMBER)
    edit.setTextSize(18)
    try:
        edit.setTextColor(THEME_CLASS.getColor(THEME_CLASS.key_windowBackgroundWhiteBlackText))
    except Exception:
        pass
    edit.setBackgroundColor(COLOR_CLASS.TRANSPARENT)
    box.addView(edit)

    outer.addView(box)

    refs = {"big_number": big_number, "sub": sub, "days": days_tv, "date": date_tv}

    watcher = _CalcTextWatcher(edit, refs)
    edit.addTextChangedListener(watcher)

    focus_listener = _CalcFocusListener(edit, refs)
    edit.setOnFocusChangeListener(focus_listener)

    return outer, refs, edit


class _CalculatorInsertHook(MethodHook):
    def after_hooked_method(self, param):
        plugin = _plugin_ref[0]
        if plugin is None:
            return
        if not plugin.get_setting("show_calculator", True):
            return
        try:
            adapter = param.thisObject

            items_field = adapter.getClass().getDeclaredField("items")
            items_field.setAccessible(True)
            items = items_field.get(adapter)
            if items is None:
                return

            balance_header_idx = -1
            already_inserted = False
            for i in range(items.size()):
                it = items.get(i)
                try:
                    v = getattr(it, "view", None)
                    if v is not None:
                        tag = v.getTag()
                        if tag is not None and str(tag) == "fd_calc_card":
                            already_inserted = True
                            break
                except Exception:
                    pass
                try:
                    txt = getattr(it, "text", None)
                    if txt is not None and "Баланс звёзд" in str(txt).strip():
                        balance_header_idx = i
                except Exception:
                    pass

            if already_inserted or balance_header_idx < 0:
                return

            recycler_field = None
            for f in adapter.getClass().getDeclaredFields():
                try:
                    tname = f.getType().getName()
                    if "RecyclerListView" in tname or "RecyclerView" in tname:
                        recycler_field = f
                        break
                except Exception:
                    pass

            context = None
            try:
                context = adapter.getContext()
            except Exception:
                pass
            if context is None and recycler_field is not None:
                try:
                    recycler_field.setAccessible(True)
                    rv = recycler_field.get(adapter)
                    if rv is not None:
                        context = rv.getContext()
                except Exception:
                    pass
            if context is None:
                plugin._plog("[CALC INSERT] could not resolve context")
                return

            card_view, refs, edit_text = _build_calculator_view(plugin, context)

            UItemClass = find_class("org.telegram.ui.Components.UItem")
            header_item = UItemClass.asHeader("Калькулятор звёзд")
            card_item = UItemClass.asCustom(card_view)

            items.add(balance_header_idx, card_item)
            items.add(balance_header_idx, header_item)

            adapter.notifyItemRangeInserted(balance_header_idx, 2)
            plugin._plog(f"[CALC INSERT] inserted at index {balance_header_idx}, new size={items.size()}")

            _calc_card_registry.clear()
            _calc_card_registry.append({"refs": refs, "edit": edit_text})
            _update_calc_display(refs, 1000)
        except Exception as e:
            import traceback
            plugin._plog(f"[CALC INSERT] error: {e}\n{traceback.format_exc()}")


def _post_insert_check(plugin, recycler, card_view, idx):
    try:
        plugin._plog(f"[CALC CHECK] recycler.childCount={recycler.getChildCount()} card_view.width={card_view.getWidth()} card_view.height={card_view.getHeight()} card_view.isAttached={card_view.isAttachedToWindow()} card_view.visibility={card_view.getVisibility()}")
        parent = card_view.getParent()
        plugin._plog(f"[CALC CHECK] card_view.parent={parent}")
        adapter = recycler.getAdapter()
        if adapter is not None:
            plugin._plog(f"[CALC CHECK] adapter.getItemCount()={adapter.getItemCount()}")
            try:
                vh = recycler.findViewHolderForAdapterPosition(idx)
                plugin._plog(f"[CALC CHECK] viewHolder at idx {idx}: {vh}")
            except Exception as e:
                plugin._plog(f"[CALC CHECK] findViewHolderForAdapterPosition error: {e}")
    except Exception as e:
        plugin._plog(f"[CALC CHECK] error: {e}")


def _row_label_exists(outer, label_text):
    try:
        for i in range(outer.getChildCount()):
            c = outer.getChildAt(i)
            if hasattr(c, "getChildCount") and c.getChildCount() > 0:
                first = c.getChildAt(0)
                try:
                    if str(first.getText()) == label_text:
                        return True
                except Exception:
                    pass
    except Exception:
        pass
    return False


def _inject_unlock_row(plugin, value_tv, label_text, value_text):
    try:
        content_cell = value_tv.getParent()
        if content_cell is None:
            return
        table_row = content_cell.getParent()
        if table_row is None:
            return
        outer = table_row.getParent()
        if outer is None or not hasattr(outer, "addRow"):
            plugin._plog("inject: outer has no addRow method")
            return

        if not _row_label_exists(outer, label_text):
            outer.addRow(label_text, value_text)
    except Exception as e:
        plugin._plog(f"inject row error: {e}")


def _add_foxdrop_credit_span(plugin, cs):
    try:
        from android.text import SpannableStringBuilder, Spanned
        from android.text.style import URLSpan

        ssb = SpannableStringBuilder(cs)
        ssb.append("\nМодификация: ")
        start = ssb.length()
        ssb.append("FoxDrop")
        end = ssb.length()
        ssb.setSpan(URLSpan(FOXDROP_URL), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
        return ssb
    except Exception as e:
        plugin._plog(f"[CREDIT] span error: {e}")
        return None


def _fetch_cbr_all():
    try:
        req = urllib.request.Request(CBR_URL, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = resp.read()
        root = ET.fromstring(data)
        rates = {"RUB": 1.0}
        for valute in root.findall("Valute"):
            code = valute.findtext("CharCode")
            if not code:
                continue
            try:
                value = float(valute.findtext("Value").replace(",", "."))
                nominal = float(valute.findtext("Nominal") or "1")
                rates[code] = value / nominal
            except (TypeError, ValueError):
                continue
        return rates
    except Exception as e:
        _mlog(f"[StarsUnlockRUB] CBR fetch error: {e}")
        return None


def _rate_ttl_seconds():
    p = _plugin_ref[0]
    idx = p.get_setting("rate_update_hours_idx", 1) if p else 1
    try:
        hours = RATE_HOURS_OPTIONS[int(idx)]
    except (IndexError, ValueError, TypeError):
        hours = 12
    return hours * 3600


def _get_rates(force=False):
    now = time.time()
    if force or _state["rates"] is None or now - _state["rate_ts"] > _rate_ttl_seconds():
        rates = _fetch_cbr_all()
        if rates:
            _state["rates"] = rates
            _state["rate_ts"] = now
    return _state["rates"]


def _convert_usd(usd_value, target_code):
    rates = _get_rates()
    if not rates:
        return None
    usd_rub = rates.get("USD")
    if not usd_rub:
        return None
    if target_code == "RUB":
        return usd_value * usd_rub
    target_rub = rates.get(target_code)
    if not target_rub:
        return None
    return usd_value * usd_rub / target_rub


def _current_currency_code():
    p = _plugin_ref[0]
    idx = p.get_setting("currency", 0) if p else 0
    try:
        return CURRENCY_CODES[int(idx)]
    except (IndexError, ValueError, TypeError):
        return "RUB"


def _fmt_currency(usd_value):
    code = _current_currency_code()
    amount = _convert_usd(usd_value, code)
    if amount is None:
        return None
    formatted = f"{amount:,.2f}".replace(",", " ").replace(".", ",")
    return f"{formatted} {CURRENCY_SYMS.get(code, '₽')}"


def _fmt_left(seconds_left):
    if seconds_left <= 0:
        return "менее суток"
    days = int(seconds_left // 86400)
    hours = int((seconds_left % 86400) // 3600)
    if days > 0 and hours > 0:
        return f"{days} дн {hours} ч"
    if days > 0:
        return f"{days} дн"
    return f"{hours} ч"


def _stars_amount(v):
    try:
        return int(v.amount)
    except Exception:
        try:
            return int(v)
        except Exception:
            return 0


def _dump_fields(obj, plugin, label):
    try:
        names = [f.getName() for f in obj.getClass().getDeclaredFields()]
        plugin._plog(f"[FIELD DUMP] {label}: {names}")
    except Exception as e:
        plugin._plog(f"[FIELD DUMP] {label} failed: {e}")


_tl_class_cache = {}


def _get_tl_class(name, plugin=None):
    if name in _tl_class_cache:
        return _tl_class_cache[name]

    attempts = []

    try:
        from org.telegram.tgnet import TLRPC
        attempts.append(("TLRPC attr", lambda: getattr(TLRPC, name)))
    except Exception:
        pass

    try:
        from org.telegram.tgnet.tl import TL_stars
        attempts.append(("TL_stars attr", lambda: getattr(TL_stars, name)))
    except Exception:
        pass

    attempts.append(("find_class TLRPC$", lambda: find_class(f"org.telegram.tgnet.TLRPC${name}")))
    attempts.append(("find_class TL_stars$", lambda: find_class(f"org.telegram.tgnet.tl.TL_stars${name}")))

    for label, getter in attempts:
        try:
            cls = getter()
            if cls is not None:
                if plugin:
                    plugin._plog(f"[TL LOOKUP] {name} found via {label}")
                _tl_class_cache[name] = cls
                return cls
        except Exception:
            continue

    if plugin:
        plugin._plog(f"[TL LOOKUP] {name} NOT FOUND in any location")
    return None


class StarsTextHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            plugin = _plugin_ref[0]
            if not plugin:
                return
            cs = param.args[0]
            if cs is None:
                return
            text = str(cs)
            if not text:
                return

            new_text = text

            already_has_currency = any(sym in text for sym in CURRENCY_SYMS.values())
            if plugin.get_setting("show_rub", True) and "$" in text and "≈" in text and not already_has_currency:
                m = DOLLAR_RE.search(text)
                if m:
                    usd_str = m.group(1).replace(" ", "").replace(",", ".")
                    try:
                        usd_val = float(usd_str)
                        cur_str = _fmt_currency(usd_val)
                        if cur_str:
                            new_text = f"{new_text} (≈{cur_str})"
                    except ValueError:
                        pass

            if plugin.get_setting("show_unlock_inline", True):
                m_tip = TOOLTIP_DATE_RE.match(text)
                if m_tip:
                    dt = _parse_tooltip_date(m_tip)
                    if dt:
                        unlock = dt + datetime.timedelta(days=UNLOCK_DAYS)
                        new_text = f"{new_text} — разблокировка {unlock.strftime('%d.%m.%Y')}"

                m_tx = TX_DATE_RE.match(text)
                if m_tx:
                    dt = _parse_tx_date(m_tx)
                    if dt:
                        unlock = dt + datetime.timedelta(days=UNLOCK_DAYS)
                        show_exact = plugin.get_setting("show_exact_time", True)
                        unlock_str = _format_like_telegram(unlock) if show_exact else _format_date_only(unlock)
                        run_on_ui_thread(lambda tv=param.thisObject, u=unlock_str: _inject_unlock_row(plugin, tv, "Разблокируется", u))

            if plugin.get_setting("show_disclaimers", True):
                if "через 21 день после поступления звёзд на баланс" in text and "Точную дату" not in text:
                    new_text = f"{new_text}{EXTRA_21DAY_NOTE}"
                elif "вывести звёзды с помощью Fragment" in text and "ЦБ РФ" not in text:
                    new_text = f"{new_text}{EXTRA_FRAGMENT_NOTE}"
                elif "Условия" in text and "использования звёзд" in text and "Модификация" not in text:
                    spanned = _add_foxdrop_credit_span(plugin, cs)
                    if spanned is not None:
                        param.args[0] = spanned
                        return

            if new_text != text:
                param.args[0] = new_text
        except Exception as e:
            log(f"[StarsUnlockRUB] text hook error: {e}")


class StarsUnlockRubPlugin(BasePlugin):

    def _plog(self, msg):
        if self.get_setting("show_logs", True):
            self.log(msg)

    def on_plugin_load(self):
        _plugin_ref[0] = self
        self.add_hook(STATS_REQUEST)

        try:
            _fd_init(self)
        except Exception as e:
            self._plog(f"verification init error: {e}")

        run_on_queue(lambda: _get_rates(force=True), PLUGINS_QUEUE)

        try:
            TextView = find_class("android.widget.TextView")
            CharSequence = find_class("java.lang.CharSequence")

            set_text_method = TextView.getClass().getDeclaredMethod("setText", CharSequence)
            set_text_method.setAccessible(True)
            self._text_unhook = self.hook_method(set_text_method, StarsTextHook())
            self._plog("setText(CharSequence) hook installed")

            try:
                BufferType = find_class("android.widget.TextView$BufferType")
                set_text_method2 = TextView.getClass().getDeclaredMethod("setText", CharSequence, BufferType)
                set_text_method2.setAccessible(True)
                self._text_unhook2 = self.hook_method(set_text_method2, StarsTextHook())
                self._plog("setText(CharSequence, BufferType) hook installed")
            except Exception as e2:
                self._plog(f"setText(CharSequence, BufferType) hook failed: {e2}")
        except Exception as e:
            self._plog(f"setText hook failed: {e}")

        try:
            AnimatedTextViewClass = find_class("org.telegram.ui.Components.AnimatedTextView")
            hooked_any = False
            for m in AnimatedTextViewClass.getClass().getDeclaredMethods():
                if m.getName() == "setText":
                    try:
                        m.setAccessible(True)
                        self.hook_method(m, StarsTextHook())
                        hooked_any = True
                    except Exception as e3:
                        self._plog(f"AnimatedTextView.setText hook (one overload) failed: {e3}")
            self._plog(f"AnimatedTextView hooks installed: {hooked_any}")
        except Exception as e:
            self._plog(f"AnimatedTextView class not found / hook failed: {e}")

        try:
            UAClass = find_class("org.telegram.ui.Components.UniversalAdapter")
            BooleanType = jclass("java.lang.Boolean").TYPE
            update_method = UAClass.getClass().getDeclaredMethod("update", BooleanType)
            update_method.setAccessible(True)
            self.hook_method(update_method, _CalculatorInsertHook())
            self._plog("calculator insert hook installed (UniversalAdapter.update)")
        except Exception as e:
            self._plog(f"calculator insert hook failed: {e}")

        self._plog("Stars Unlock & RUB loaded")

    def on_plugin_unload(self):
        _plugin_ref[0] = None
        _b._fd_hooked = False
        _b._fd_state.clear()

    def _open_channel(self):
        try:
            from android.content import Intent
            from android.net import Uri
            from org.telegram.messenger import ApplicationLoader

            intent = Intent(Intent.ACTION_VIEW, Uri.parse(FOXDROP_URL))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ApplicationLoader.applicationContext.startActivity(intent)
        except Exception as e:
            self._plog(f"open channel error: {e}")

    def _build_channel_button(self):
        try:
            from org.telegram.messenger import AndroidUtilities, ApplicationLoader
            from android.widget import Button
            from android.graphics.drawable import GradientDrawable
            from android.graphics import Color
            from android.widget import LinearLayout as LL

            ctx = ApplicationLoader.applicationContext
            btn = Button(ctx)
            btn.setText("Официальный канал модификации, FoxDrop")
            btn.setAllCaps(False)
            btn.setTextColor(Color.WHITE)

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadius(AndroidUtilities.dp(10))
            bg.setColor(Color.parseColor("#2196F3"))
            btn.setBackground(bg)
            btn.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(10), AndroidUtilities.dp(16), AndroidUtilities.dp(10))

            params = LL.LayoutParams(LL.LayoutParams.WRAP_CONTENT, LL.LayoutParams.WRAP_CONTENT)
            params.setMargins(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(16))
            btn.setLayoutParams(params)

            btn.setOnClickListener(_ClickListener(self._open_channel))
            return btn
        except Exception as e:
            self._plog(f"button build error: {e}")
            return None

    def create_settings(self):
        items = [
            Header(text="Stars Unlock & RUB"),
            Switch(key="show_rub", text="Курс валюты рядом с $ в Монетизации", default=True),
            Switch(key="show_unlock_inline", text="Дата разблокировки в графике и в деталях транзакции", default=True),
            Switch(key="show_calculator", text="Калькулятор звёзд в Монетизации", default=True),
            Switch(
                key="show_exact_time",
                text="Точное время в дате разблокировки",
                subtext="Выкл — только дата, без часов и минут",
                default=True,
            ),
            Switch(key="show_disclaimers", text="Пояснения про курс ЦБ и про то, где смотреть дату разблокировки", default=True),
            Switch(key="show_logs", text="Логи плагина", subtext="Для отладки; можно выключить", default=False),
            Divider(),
            Selector(
                key="currency",
                text="Валюта конвертации",
                items=CURRENCY_ITEMS,
                default=0,
            ),
            Selector(
                key="rate_update_hours_idx",
                text="Обновлять курс ЦБ раз в",
                items=["6 часов", "12 часов", "24 часа", "48 часов"],
                default=1,
            ),
            Divider(text="Курс ЦБ РФ обновляется автоматически с выбранным интервалом."),
            Header(text="О плагине"),
            Divider(text=f"Версия {__version__}. Модификация: FoxDrop (@Fox_Plugin). {self._status_text()}"),
            Divider(text="После установки или обновления плагина перезапустите приложение (полностью закройте и откройте заново) — иначе часть хуков может работать нестабильно."),
            Divider(text="Кнопка ниже открывает официальный канал модификации FoxDrop — там публикуются обновления этого и других плагинов."),
        ]

        btn = self._build_channel_button()
        if btn is not None:
            items.append(Custom(view=btn))

        return items

    def _status_text(self):
        rates = _state["rates"]
        if not rates or not rates.get("USD"):
            return "Курс ЦБ РФ ещё не загружен — откроется автоматически при первом обновлении"
        rate = rates["USD"]
        dt = datetime.datetime.fromtimestamp(_state["rate_ts"]).strftime("%d.%m %H:%M")
        return f"Курс ЦБ РФ: 1$ = {rate:.2f}₽ (обновлён {dt})"

    def pre_request_hook(self, request_name, account, request):
        if request_name == STATS_REQUEST:
            try:
                _last_peer[account] = request.peer
            except Exception as e:
                self._plog(f"pre_request_hook: couldn't capture peer: {e}")
        return HookResult()

    def post_request_hook(self, request_name, account, response, error):
        if request_name != STATS_REQUEST or error or response is None:
            return HookResult()
        try:
            status = response.status

            if not _fields_dumped[0]:
                _fields_dumped[0] = True
                _dump_fields(status, self, "StarsRevenueStatus")

            available = _stars_amount(status.available_balance)
            current = _stars_amount(status.current_balance)
            overall = _stars_amount(status.overall_revenue)
            pending = max(current - available, 0)

            usd_rate = 0.0
            try:
                usd_rate = float(getattr(response, "usd_rate", 0) or 0)
            except Exception:
                pass

            is_real_stars_response = current > 0 or available > 0 or overall > 0

            if is_real_stars_response:
                _pending_info["pending"] = pending
                _pending_info["current_usd"] = current * usd_rate if usd_rate else 0.0

                _calc_data["available"] = available
                _calc_data["current_total"] = current
                _calc_data["usd_rate"] = usd_rate
            else:
                self._plog("skipping zero-data stats response (likely parallel TON/ad-revenue request)")

            lines = [f"⭐ Доступно к выводу: {available}"]
            lines.append(f"Σ всего заработано: {overall} ⭐")
            self._plog("\n".join(lines))

            if not is_real_stars_response:
                return HookResult()

            if pending > 0 and account in _last_peer and not _tx_lookup_inflight.get(account):
                _tx_lookup_inflight[account] = True
                self._fetch_pending_unlock_date(account, _last_peer[account], pending)
            elif pending == 0:
                _pending_info["next_ts"] = 0
                _calc_data["pending_tx"] = []
        except Exception as e:
            self._plog(f"post_request_hook error: {e}")
        return HookResult()

    def _fetch_pending_unlock_date(self, account, peer, pending_total, offset="", page=0, oldest_pending_date=[None], tx_collected=None):
        if tx_collected is None:
            tx_collected = []
        try:
            ReqClass = _get_tl_class("TL_payments_getStarsTransactions", self)
            if ReqClass is None:
                self._finish_unlock_lookup(account, oldest_pending_date[0], tx_collected)
                return

            req = ReqClass()
            req.peer = peer
            req.inbound = True
            req.ascending = False
            req.offset = offset or ""
            req.limit = TX_PAGE_LIMIT

            def on_response(response, error):
                try:
                    if error or response is None:
                        self._finish_unlock_lookup(account, oldest_pending_date[0], tx_collected)
                        return

                    history = response.history
                    size = history.size()

                    hit_old_enough = False
                    now_ts = int(time.time())
                    for i in range(size):
                        tx = history.get(i)
                        tx_date = int(getattr(tx, "date", 0) or 0)
                        if not tx_date:
                            continue
                        age_days = (now_ts - tx_date) / 86400.0
                        if age_days >= UNLOCK_DAYS:
                            hit_old_enough = True
                            break
                        if oldest_pending_date[0] is None or tx_date < oldest_pending_date[0]:
                            oldest_pending_date[0] = tx_date
                        tx_amount = _stars_amount(getattr(tx, "amount", None))
                        if tx_amount:
                            tx_collected.append((tx_date, tx_amount))

                    next_offset = None
                    try:
                        next_offset = str(getattr(response, "next_offset", "") or "")
                    except Exception:
                        pass

                    if hit_old_enough or not next_offset or page + 1 >= MAX_TX_PAGES:
                        self._finish_unlock_lookup(account, oldest_pending_date[0], tx_collected)
                    else:
                        run_on_queue(
                            lambda: self._fetch_pending_unlock_date(
                                account, peer, pending_total, next_offset, page + 1, oldest_pending_date, tx_collected
                            ),
                            PLUGINS_QUEUE,
                        )
                except Exception as e:
                    self._plog(f"getStarsTransactions callback error: {e}")
                    self._finish_unlock_lookup(account, oldest_pending_date[0], tx_collected)

            send_request(req, on_response, account=account)
        except Exception as e:
            self._plog(f"_fetch_pending_unlock_date error: {e}")
            self._finish_unlock_lookup(account, oldest_pending_date[0], tx_collected)

    def _finish_unlock_lookup(self, account, oldest_pending_date, tx_collected=None):
        _tx_lookup_inflight[account] = False
        _calc_data["pending_tx"] = list(tx_collected or [])
        _refresh_calculator_cards()

        if not oldest_pending_date:
            self._plog("Unlock lookup: no pending transaction date found")
            return

        next_ts = int(oldest_pending_date) + UNLOCK_DAYS * 86400
        _pending_info["next_ts"] = next_ts

        pending = _pending_info["pending"]
        left = next_ts - time.time()
        show_exact = self.get_setting("show_exact_time", True)
        dt_obj = datetime.datetime.fromtimestamp(next_ts)
        unlock_dt = dt_obj.strftime("%d.%m.%Y %H:%M") if show_exact else dt_obj.strftime("%d.%m.%Y")
        msg = f"🔒 В ожидании: {pending} ⭐ → разблокировка {unlock_dt} ({_fmt_left(left)})"
        self._plog(msg)


def create_plugin():
    return StarsUnlockRubPlugin()

