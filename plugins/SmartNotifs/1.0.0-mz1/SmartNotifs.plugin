            Divider(),

            Header(text=_mz_t("🔄 Автозміна профілю", "🔄 Auto profile change", "🔄 Авто-смена профиля")),
            Switch(key="auto_profile_enabled", text=_mz_t("Увімкнути", "Enable", "Включить"),
