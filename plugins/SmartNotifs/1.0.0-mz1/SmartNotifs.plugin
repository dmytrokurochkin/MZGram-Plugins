                   default=False),
            Input(key="auto_last_name", text=_mz_t("Варіанти прізвища", "Last name options", "Варианты фамилии"),
                  subtext=_mz_t("Через кому. Порожньо: не змінювати", "Comma-separated. Empty: do not change", "Через запятую. Пусто — не менять"),
