            Switch(key="auto_ln_random", text=_mz_t("🎲 Випадковий порядок (прізвище)", "🎲 Random order (last name)", "🎲 Случайный порядок (фамилия)"),
                   default=False),
            Switch(key="auto_ln_no_repeat", text=_mz_t("🚫 Без повторів (прізвище)", "🚫 No repeats (last name)", "🚫 Без повторения (фамилия)"),
                   subtext=_mz_t("Не обирати варіант, який вже стоїть", "Do not pick the option that is already set", "Не выбирать вариант который уже стоит"),
