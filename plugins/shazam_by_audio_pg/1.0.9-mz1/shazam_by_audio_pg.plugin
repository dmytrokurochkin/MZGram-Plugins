# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "shazam_by_audio_pg"
__name__ = "Shazam (by audio)"
__description__ = "Identifies music from an audio file or voice message (reply with .shazam). The result is shown in a dialog with details and links. Accuracy depends on the audio quality (it may be lower for voice messages)."
__version__ = "1.0.9-mz1"
__author__ = "MZGram"
__min_version__ = "11.12.0"
__category__ = ["media", "integrations"]

import os
import uuid
import time
import threading
import traceback
import json
import requests
import shutil
from typing import Any, Optional
from java.io import File

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import send_message, get_last_fragment, run_on_queue
from android_utils import log, run_on_ui_thread
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
from ui.settings import Header, Input, Divider, Text
from org.telegram.messenger import ApplicationLoader, MessageObject, FileLoader, UserConfig, AndroidUtilities, R as R_tg
from org.telegram.tgnet import TLRPC
from android.graphics import Color

class ShazamPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.pg_temp_dir = None
        self.pg_processing = False
        self.pg_loading_dialog: Optional[AlertDialogBuilder] = None
        self.last_shazam_request_time = 0 # Rate limit for requests
        self.shazam_cooldown_seconds = 10 # Wait time between requests in seconds

    def on_plugin_load(self):
        self.pg_temp_dir = self._prepare_temp_dir()
        if not self.pg_temp_dir:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Не вдалося ініціалізувати тимчасову директорію для плагіна Shazam.", "Couldn't initialize the temporary folder for the Shazam plugin.", "Не удалось инициализировать временную директорию для Shazam плагина.")))
            log(f"[{__id__}] Error: couldn't initialize the temporary directory.")
            return

        self.add_on_send_message_hook()
        log(f"[{__id__}] Plugin 'Shazam (by audio)' loaded.")
        self._cleanup_old_files()

    def on_plugin_unload(self):
        if self.pg_temp_dir and self.pg_temp_dir.exists():
            try:
                for file_obj in self.pg_temp_dir.listFiles():
                    if file_obj.isFile():
                        file_obj.delete()
                log(f"[{__id__}] Temporary files deleted from {self.pg_temp_dir.getAbsolutePath()}.")
            except Exception as e:
                log(f"[{__id__}] Error while cleaning the temporary directory: {e}")
        self._dismiss_loading_dialog()
        log(f"[{__id__}] Plugin 'Shazam (by audio)' unloaded.")

    def create_settings(self):
        return [
            Header(text=_mz_t("Налаштування Shazam", "Shazam settings", "Настройки Shazam")),
            Input(
                key="shazam_command",
                text=_mz_t("Команда активації", "Activation command", "Команда активации"),
                default=".shazam",
                subtext=_mz_t("Напишіть цю команду у відповідь на аудіофайл.", "Send this command as a reply to an audio file.", "Напишите эту команду в ответ на аудиофайл."),
                icon="input_bot1_solar"
            ),
            Input(
                key="auddio_api_token",
                text=_mz_t("Audd.io API-токен", "Audd.io API token", "Audd.io API Токен"),
                default="",
                subtext=_mz_t("Отримайте на https://audd.io/develop. Обов'язково для роботи!", "Get it at https://audd.io/develop. Required to work!", "Получите на https://audd.io/develop. Обязателен для работы!"),
                icon="menu_feature_code_solar"
            ),
            Divider(text=_mz_t("Як користуватися:", "How to use:", "Как пользоваться:")),
            Text(text=_mz_t("1. Отримайте API-токен на Audd.io (https://audd.io/develop).", "1. Get an API token at Audd.io (https://audd.io/develop).", "1. Получите API-токен на Audd.io (https://audd.io/develop).")),
            Text(text=_mz_t("2. Вставте його в поле вище.", "2. Paste it in the field above.", "2. Вставьте его в поле выше.")),
            Text(text=_mz_t("3. У чаті дайте відповідь на аудіофайл або голосове повідомлення командою з поля «Команда активації» (типово .shazam).", "3. In a chat, reply to an audio file or voice message with the command from the 'Activation command' field (default: .shazam).", "3. В чате ответьте на аудиофайл или голосовое сообщение командой, указанной в 'Команде активации' (по умолчанию .shazam).")),
            Divider(text=_mz_t("Важливо: плагін визначає музику лише за аудіофайлами. Запис із мікрофона не підтримується. Результат буде показано у спливаючому вікні з розширеною інформацією. Точність визначення залежить від якості вихідного аудіо. Для голосових повідомлень точність може бути нижчою.", "Important: the plugin identifies music only from audio files. Recording from the microphone is not supported. The result is shown in a pop-up window with extended info. Accuracy depends on the source audio quality. For voice messages the accuracy may be lower.", "Важно: Плагин может определять музыку только по аудиофайлам. Не поддерживает запись с микрофона. Результат будет показан в всплывающем окне с расширенной информацией. Точность определения зависит от качества исходного аудио. Для голосовых сообщений точность может быть ниже."))
        ]

    def _prepare_temp_dir(self) -> Optional[File]:
        try:
            base_dir = ApplicationLoader.getFilesDirFixed()
            if not base_dir:
                return None
            temp_dir = File(base_dir, "ShazamAudioTemp")
            if not temp_dir.exists():
                if not temp_dir.mkdirs():
                    log(f"[{__id__}] Couldn't create the temporary directory: {temp_dir.getAbsolutePath()}")
                    return None
            return temp_dir
        except Exception as e:
            log(f"[{__id__}] Error while preparing the temporary directory: {e}\n{traceback.format_exc()}")
            return None

    def _cleanup_old_files(self, max_age_hours=1):
        if not self.pg_temp_dir:
            return
        try:
            now = time.time()
            max_age_seconds = max_age_hours * 3600
            for file_obj in self.pg_temp_dir.listFiles():
                if file_obj.isFile() and now - (file_obj.lastModified() / 1000) > max_age_seconds:
                    file_obj.delete()
                    log(f"[{__id__}] Deleted old temporary file: {file_obj.getName()}")
        except Exception as e:
            log(f"[{__id__}] Error while cleaning old files: {e}\n{traceback.format_exc()}")

    def _download_audio_sync(self, message_obj: MessageObject, document_to_download: TLRPC.Document) -> Optional[str]:
        """
        Synchronously downloads an audio file from MessageObject into the plugin's temporary directory.
        Takes an already extracted and validated TLRPC.Document.
        Returns the path to the downloaded file, or None on error.
        """
        if not self.pg_temp_dir:
            log(f"[{__id__}] _download_audio_sync: the temporary directory is not initialized.")
            return None

        try:
            mime_type = getattr(document_to_download, 'mime_type', 'audio/ogg')
            file_extension = ".ogg"
            if "mp3" in mime_type: file_extension = ".mp3"
            elif "wav" in mime_type: file_extension = ".wav"
            elif "flac" in mime_type: file_extension = ".flac"
            elif "m4a" in mime_type: file_extension = ".m4a"
            elif "opus" in mime_type: file_extension = ".ogg" # Voice messages often use opus codec in ogg container

            final_temp_file_path_str = File(self.pg_temp_dir, f"audio_{uuid.uuid4().hex}{file_extension}").getAbsolutePath()
            
            file_loader = FileLoader.getInstance(UserConfig.selectedAccount)
            
            # Get the path of the file in the Telegram cache based on the original MessageOwner
            telegram_cache_file_path_obj = file_loader.getPathToMessage(message_obj.messageOwner)
            telegram_cache_file_path_str = telegram_cache_file_path_obj.getAbsolutePath() if telegram_cache_file_path_obj else None

            downloaded_telegram_cache_path = None

            # 1. Check whether the file is already in the Telegram cache
            if telegram_cache_file_path_str and os.path.exists(telegram_cache_file_path_str) and os.path.getsize(telegram_cache_file_path_str) > 0:
                downloaded_telegram_cache_path = telegram_cache_file_path_str
                log(f"[{__id__}] Audio file is already in the Telegram cache: {telegram_cache_file_path_str}")
            else:
                # 2. If the file is not in the cache, start loading it into the Telegram cache
                # FileLoader.loadFile expects a TLRPC.Document as its first argument.
                file_loader.loadFile(document_to_download, message_obj, mime_type.split('/')[0], FileLoader.PRIORITY_HIGH, 0)
                
                pg_timeout = 60 # Wait up to 60 seconds for the file to load into the Telegram cache
                for _pg_iterator_index in range(pg_timeout):
                    if telegram_cache_file_path_str and os.path.exists(telegram_cache_file_path_str) and os.path.getsize(telegram_cache_file_path_str) > 0:
                        downloaded_telegram_cache_path = telegram_cache_file_path_str
                        log(f"[{__id__}] Audio file loaded into the Telegram cache after waiting: {telegram_cache_file_path_str}")
                        break
                    time.sleep(1) # Wait 1 second
            
            if not downloaded_telegram_cache_path:
                log(f"[{__id__}] Error: couldn't load the audio file into the Telegram cache after waiting.")
                return None

            # 3. Copy the file from the Telegram cache into our temporary directory
            shutil.copyfile(downloaded_telegram_cache_path, final_temp_file_path_str)
            log(f"[{__id__}] Audio file copied from the Telegram cache into the plugin's temporary directory: {final_temp_file_path_str}")
            return final_temp_file_path_str

        except Exception as e:
            log(f"[{__id__}] Error while downloading/copying the audio file: {e}\n{traceback.format_exc()}")
            return None

    def _identify_music(self, audio_path: str) -> Optional[dict]:
        api_token = self.get_setting("auddio_api_token", "").strip()
        if not api_token:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Помилка: Audd.io API-токен не вказано в налаштуваннях плагіна.", "Error: the Audd.io API token is not set in the plugin settings.", "Ошибка: Audd.io API Токен не указан в настройках плагина.")))
            log(f"[{__id__}] Error: the Audd.io API token is missing.")
            return None

        url = "https://api.audd.io/"
        params = {
            "api_token": api_token,
            "return": "lyrics,artist,title,album,label,song_link,release_date,genres,spotify,youtube,deezer,apple_music"
        }

        try:
            with open(audio_path, 'rb') as f:
                content_type = 'audio/mpeg' if '.mp3' in audio_path.lower() else 'audio/ogg'
                files = {'file': (os.path.basename(audio_path), f, content_type)}
                response = requests.post(url, data=params, files=files, timeout=30)
            response.raise_for_status()

            result = response.json()
            if result.get("status") == "success" and result.get("result"):
                return result["result"]
            else:
                error_message = result.get("error", {}).get("error_message", _mz_t("Невідома помилка Audd.io.", "Unknown Audd.io error.", "Неизвестная ошибка Audd.io."))
                log(f"[{__id__}] Error from Audd.io: {error_message} (full response: {result})")
                run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t(f"Не вдалося визначити музику: {error_message}", f"Couldn't identify the music: {error_message}", f"Не удалось определить музыку: {error_message}")))
                return None
        except requests.exceptions.Timeout:
            log(f"[{__id__}] Error: the request to Audd.io timed out.")
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Час очікування запиту до Audd.io минув.", "The request to Audd.io timed out.", "Время ожидания запроса к Audd.io истекло.")))
            return None
        except requests.exceptions.RequestException as e:
            log(f"[{__id__}] Error requesting Audd.io: {e}\n{traceback.format_exc()}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t(f"Помилка мережі під час запиту до Audd.io: {e}", f"Network error while requesting Audd.io: {e}", f"Ошибка сети при запросе к Audd.io: {e}")))
            return None
        except json.JSONDecodeError as e:
            log(f"[{__id__}] Error parsing the JSON from Audd.io: {e}\nResponse: {response.text}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t(f"Помилка обробки відповіді від Audd.io: {e}", f"Error while processing the response from Audd.io: {e}", f"Ошибка обработки ответа от Audd.io: {e}")))
            return None
        except Exception as e:
            log(f"[{__id__}] Unexpected error while identifying music: {e}\n{traceback.format_exc()}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t(f"Неочікувана помилка: {e}", f"Unexpected error: {e}", f"Непредвиденная ошибка: {e}")))
            return None

    def _show_loading_dialog(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None

        if not activity:
            log(f"[{__id__}] Couldn't get the context for the loading AlertDialog.")
            return

        def _action():
            try:
                builder = AlertDialogBuilder(activity)
                builder.set_title(_mz_t("Визначаємо музику...", "Identifying music...", "Определение музыки..."))
                builder.set_top_animation(R_tg.raw.dots_loading, AndroidUtilities.dp(60), True, Color.TRANSPARENT, None)
                builder.set_cancelable(False)
                builder.set_canceled_on_touch_outside(False)
                self.pg_loading_dialog = builder.show()
            except Exception as e:
                log(f"[{__id__}] Error while creating or showing the loading AlertDialog: {e}\n{traceback.format_exc()}")
                BulletinHelper.show_error(_mz_t(f"Помилка інтерфейсу завантаження: {e}", f"Loading UI error: {e}", f"Ошибка UI загрузки: {e}"))

        run_on_ui_thread(_action)

    def _dismiss_loading_dialog(self):
        def _action():
            if self.pg_loading_dialog:
                try:
                    self.pg_loading_dialog.dismiss() 
                except Exception as e:
                    log(f"[{__id__}] Error while hiding the loading AlertDialog: {e}")
                finally:
                    self.pg_loading_dialog = None
        run_on_ui_thread(_action)

    def _show_result_dialog(self, title: str, message: str, copy_text: Optional[str] = None):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None

        if not activity:
            log(f"[{__id__}] Couldn't get the context for the AlertDialog.")
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Не вдалося показати діалог (немає контексту).", "Couldn't show the dialog (no context).", "Не удалось отобразить диалог (нет контекста).")))
            return

        def _action():
            try:
                builder = AlertDialogBuilder(activity)
                builder.set_title(title)
                builder.set_message(message)
                
                builder.set_top_animation(R_tg.raw.sound_on, AndroidUtilities.dp(40), False, Color.TRANSPARENT, None)
                
                if copy_text:
                    def copy_action(bld, which):
                        if AndroidUtilities.addToClipboard(copy_text):
                            BulletinHelper.show_copied_to_clipboard()
                        bld.dismiss()
                    builder.set_positive_button(_mz_t("Скопіювати", "Copy", "Копировать"), copy_action)
                    builder.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda bld, which: bld.dismiss())
                else:
                    builder.set_positive_button(_mz_t("Закрити", "Close", "Закрыть"), lambda bld, which: bld.dismiss())

                builder.set_cancelable(True)
                builder.set_canceled_on_touch_outside(True)
                builder.show()
            except Exception as e:
                log(f"[{__id__}] Error while creating or showing the AlertDialog: {e}\n{traceback.format_exc()}")
                BulletinHelper.show_error(_mz_t(f"Помилка інтерфейсу: {e}", f"UI error: {e}", f"Ошибка UI: {e}"))

        run_on_ui_thread(_action)

    def _process_shazam_request(self, original_params: Any, reply_msg: MessageObject, document_to_process: TLRPC.Document):
        """
        The main music identification logic, runs in a background thread.
        Takes an already extracted and validated TLRPC.Document.
        """
        if self.pg_processing:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Визначення музики вже триває. Будь ласка, зачекайте.", "Music identification is already running. Please wait.", "Уже идет процесс определения музыки. Пожалуйста, подождите.")))
            return

        self.pg_processing = True
        audio_path = None
        
        self._show_loading_dialog()
        
        try:
            # Pass reply_msg and document_to_process to the loading function
            audio_path = self._download_audio_sync(reply_msg, document_to_process)
            if not audio_path:
                self._show_result_dialog(_mz_t("Помилка", "Error", "Ошибка"), _mz_t("Не вдалося завантажити аудіофайл для визначення.", "Couldn't load the audio file for identification.", "Не удалось загрузить аудиофайл для определения."))
                return

            result = self._identify_music(audio_path)
            
            if result:
                title = result.get("title", _mz_t("Невідомо", "Unknown", "Неизвестно"))
                artist = result.get("artist", _mz_t("Невідомо", "Unknown", "Неизвестно"))
                album = result.get("album", _mz_t("Невідомо", "Unknown", "Неизвестно"))
                label = result.get("label", _mz_t("Невідомо", "Unknown", "Неизвестно"))
                release_date = result.get("release_date")
                genres = result.get("genres")
                
                song_link = result.get("song_link")
                spotify_link = result.get("spotify", {}).get("link")
                youtube_link = result.get("youtube", {}).get("link")
                apple_music_link = result.get("apple_music", {}).get("link")
                deezer_link = result.get("deezer", {}).get("link")

                output_message_parts = [
                    _mz_t(f"🎤 *Виконавець:* {artist}", f"🎤 *Artist:* {artist}", f"🎤 *Исполнитель:* {artist}"),
                    _mz_t(f"🎵 *Назва:* {title}", f"🎵 *Title:* {title}", f"🎵 *Название:* {title}"),
                    _mz_t(f"💿 *Альбом:* {album}", f"💿 *Album:* {album}", f"💿 *Альбом:* {album}"),
                    _mz_t(f"🏷️ *Лейбл:* {label}", f"🏷️ *Label:* {label}", f"🏷️ *Лейбл:* {label}")
                ]
                
                if release_date:
                    year = release_date.split('-')[0] if '-' in release_date else release_date
                    output_message_parts.append(_mz_t(f"🗓️ *Рік випуску:* {year}", f"🗓️ *Release year:* {year}", f"🗓️ *Год выпуска:* {year}"))
                
                genre_names = []
                if genres:
                    genre_names = [g.get("name", "") for g in genres if g.get("name")]
                    if genre_names:
                        output_message_parts.append(_mz_t(f"🎶 *Жанр(и):* {', '.join(genre_names)}", f"🎶 *Genre(s):* {', '.join(genre_names)}", f"🎶 *Жанр(ы):* {', '.join(genre_names)}"))
                
                output_message_links = []
                if song_link:
                    output_message_links.append(f"🔗 [Audd.io]({song_link})")
                if spotify_link:
                    output_message_links.append(f"🔗 [Spotify]({spotify_link})")
                if youtube_link:
                    output_message_links.append(f"🔗 [YouTube]({youtube_link})")
                
                output_message = "\n".join(output_message_parts)
                if output_message_links:
                    output_message += _mz_t("\n\n*Посилання:*\n", "\n\n*Links:*\n", "\n\n*Ссылки:*\n") + "\n".join(output_message_links)

                copy_content_parts = [
                    _mz_t(f"Виконавець: {artist}", f"Artist: {artist}", f"Исполнитель: {artist}"),
                    _mz_t(f"Назва: {title}", f"Title: {title}", f"Название: {title}"),
                    _mz_t(f"Альбом: {album}", f"Album: {album}", f"Альбом: {album}"),
                    _mz_t(f"Лейбл: {label}", f"Label: {label}", f"Лейбл: {label}")
                ]
                if release_date:
                    copy_content_parts.append(_mz_t(f"Рік випуску: {year}", f"Release year: {year}", f"Год выпуска: {year}"))
                if genre_names:
                    copy_content_parts.append(_mz_t(f"Жанр(и): {', '.join(genre_names)}", f"Genre(s): {', '.join(genre_names)}", f"Жанр(ы): {', '.join(genre_names)}"))
                
                copy_content_links = []
                if song_link: copy_content_links.append(f"Audd.io: {song_link}")
                if spotify_link: copy_content_links.append(f"Spotify: {spotify_link}")
                if youtube_link: copy_content_links.append(f"YouTube: {youtube_link}")
                if apple_music_link: copy_content_links.append(f"Apple Music: {apple_music_link}")
                if deezer_link: copy_content_links.append(f"Deezer: {deezer_link}")

                if copy_content_links:
                    copy_content = "\n".join(copy_content_parts) + _mz_t("\n\nПосилання:\n", "\n\nLinks:\n", "\n\nСсылки:\n") + "\n".join(copy_content_links)
                else:
                    copy_content = "\n".join(copy_content_parts)

                self._show_result_dialog(_mz_t("Музику визначено!", "Music identified!", "Музыка определена!"), output_message, copy_content)
                run_on_ui_thread(lambda: BulletinHelper.show_success(_mz_t("Музику успішно визначено!", "Music identified successfully!", "Музыка успешно определена!"), get_last_fragment()))
            else:
                self._show_result_dialog(_mz_t("Не вдалося визначити музику", "Couldn't identify the music", "Не удалось определить музыку"), _mz_t("Спробуйте ще раз з чистішим аудіо.", "Try again with cleaner audio.", "Попробуйте еще раз с более чистым аудио."))

        except Exception as e:
            error_details = traceback.format_exc()
            log(f"[{__id__}] Critical error in _process_shazam_request: {e}\n{error_details}")
            self._show_result_dialog(_mz_t("Критична помилка", "Critical error", "Критическая ошибка"), _mz_t(f"Сталася неочікувана помилка: {e}\n\nДеталі в логах.", f"An unexpected error occurred: {e}\n\nDetails are in the logs.", f"Произошла непредвиденная ошибка: {e}\n\nПодробности в логах."))
        finally:
            self._dismiss_loading_dialog()
            if audio_path and os.path.exists(audio_path):
                run_on_queue(lambda: os.remove(audio_path), delay=500)
                log(f"[{__id__}] Temporary audio file deleted: {audio_path}")
            self.pg_processing = False

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not hasattr(params, "message") or not isinstance(params.message, str):
            return HookResult()

        command_prefix = self.get_setting("shazam_command", ".shazam").strip()
        if not params.message.lower().startswith(command_prefix):
            return HookResult()
        
        current_time = time.time()
        if current_time - self.last_shazam_request_time < self.shazam_cooldown_seconds:
            remaining_time = int(self.shazam_cooldown_seconds - (current_time - self.last_shazam_request_time))
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t(f"Зачекайте {remaining_time} сек. перед новим запитом Shazam.", f"Wait {remaining_time} sec. before the next Shazam request.", f"Подождите {remaining_time} сек. перед новым запросом Shazam."), get_last_fragment()))
            return HookResult(strategy=HookStrategy.CANCEL)

        if not hasattr(params, "replyToMsg") or not params.replyToMsg:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Будь ласка, дайте відповідь на аудіофайл або голосове повідомлення командою .shazam", "Please reply to an audio file or voice message with the .shazam command.", "Пожалуйста, ответьте на аудиофайл или голосовое сообщение командой .shazam"), get_last_fragment()))
            return HookResult(strategy=HookStrategy.CANCEL)

        reply_msg = params.replyToMsg
        
        document_to_process = MessageObject.getDocument(reply_msg)

        if not document_to_process:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Не вдалося отримати медіа з відповіді. Переконайтеся, що це аудіофайл або голосове повідомлення.", "Couldn't get media from the reply. Make sure it is an audio file or a voice message.", "Не удалось получить медиа-данные из ответного сообщения. Убедитесь, что это аудиофайл или голосовое сообщение."), get_last_fragment()))
            return HookResult(strategy=HookStrategy.CANCEL)

        if not hasattr(document_to_process, 'mime_type') or not document_to_process.mime_type.startswith("audio"):
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Відповідь має бути аудіофайлом або голосовим повідомленням.", "The reply must be an audio file or a voice message.", "Ответ на сообщение должен быть аудиофайлом или голосовым сообщением."), get_last_fragment()))
            return HookResult(strategy=HookStrategy.CANCEL)
        
        self.last_shazam_request_time = current_time

        threading.Thread(target=self._process_shazam_request, args=(params, reply_msg, document_to_process), daemon=True).start()
        
        return HookResult(strategy=HookStrategy.CANCEL)