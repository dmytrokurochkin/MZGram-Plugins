# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import re
from typing import Any, List
from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Switch
from java.util import ArrayList
from org.telegram.tgnet import TLRPC

__id__ = "long_quote_auto"
__name__ = "LongQuoteAuto"
__description__ = "Collapses a message into a quote when it has trigger words (crash logs), so long texts do not flood the chat."
__author__ = "MZGram"
__min_version__ = "12.5.1"
__version__ = "1.4.0-mz1"
__category__ = ["chats"]

_TRIGGER_RE = re.compile(
    r"hooks|python|chaquo(?:py)?|pythonpluginsengine|"
    r"lsphooker|xposed|lsposed|org\.telegram\.ui|zygotelnit|java",
    re.IGNORECASE,
)

_BLOCKQUOTE_CLS = TLRPC.TL_messageEntityBlockquote


class LongQuoteAutoPlugin(BasePlugin):
    __slots__ = ("_enabled", "_skip_commands")

    def on_plugin_load(self):
        self._enabled = None
        self._skip_commands = None
        self.add_on_send_message_hook()

    def _refresh(self):
        self._enabled = bool(self.get_setting("enabled", True))
        self._skip_commands = bool(self.get_setting("skip_commands", True))

    def on_settings_changed(self, key=None, value=None):
        self._enabled = None

    def on_send_message_hook(self, account, params):
        if self._enabled is None:
            self._refresh()
        if not self._enabled or params is None:
            return HookResult()

        msg = params.message
        if not msg:
            return HookResult()

        if self._skip_commands and msg[0] == '.':
            return HookResult()

        text = str(msg)
        if not _TRIGGER_RE.search(text):
            return HookResult()

        entities = params.entities
        if entities is not None:
            n = entities.size()
            for i in range(n):
                if isinstance(entities.get(i), _BLOCKQUOTE_CLS):
                    return HookResult()
        else:
            entities = ArrayList()
            params.entities = entities

        quote = _BLOCKQUOTE_CLS()
        quote.offset = 0
        quote.length = len(text)
        quote.flags = 1
        try:
            quote.collapsed = True
        except AttributeError:
            pass

        entities.add(0, quote)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def create_settings(self) -> List[Any]:
        return [
            Header(text=_mz_t("Основні налаштування", "Main settings", "Основные настройки")),
            Switch(
                key="enabled",
                text=_mz_t("Увімкнути автоцитату", "Enable auto quote", "Включить авто-цитату"),
                default=True,
                subtext=_mz_t("Згортати повідомлення з тригерами", "Collapse messages that have triggers", "Сворачивать сообщения при наличии триггеров"),
            ),
            Switch(
                key="skip_commands",
                text=_mz_t("Ігнорувати команди", "Ignore commands", "Игнорировать команды"),
                default=True,
                subtext=_mz_t("Не згортати повідомлення, що починаються з '.'", "Don't collapse messages that start with '.'", "Не сворачивать сообщения, начинающиеся с '.'"),
            ),
            Header(text=_mz_t("Автор: @KUNSESHBOY", "Author: @KUNSESHBOY", "Автор: @KUNSESHBOY")),
        ]
