    def _create_appearance_settings(self) -> List[Any]:
        """Appearance settings for EACH boykisser separately.
        How many cats are enabled is defined by a single number
        (see _get_boykisser_count), not by a separate toggle for each:
        at the bottom of the list there are "Add Boykisser" / "Remove
        boykisser" buttons that add/remove a cat from the end."""
        count = self._get_boykisser_count()
        items: List[Any] = [
            Header(text=_mz_t("Вигляд", "Appearance", "Внешний вид")),
            Text(
                text="Налаштуй розмір і прозорість кожного boykisser-а "
                     "окремо. Кнопки внизу додають або прибирають котів.",
                subtext="",
                icon="msg_info",
            ),
        ]
        for index in range(count):
            suffix = _instance_suffix(index)
            items.append(Header(text=BOYKISSER_LABELS[index]))
            items.append(
                Input(
                    key=f"width_dp{suffix}",
                    text=_mz_t("Ширина (dp)", "Width (dp)", "Ширина (dp)"),
                    default=str(DEFAULT_SIZE_DP),
                    subtext=_mz_t(f"Від {MIN_SIZE_DP} до {MAX_SIZE_DP} dp", f"From {MIN_SIZE_DP} to {MAX_SIZE_DP} dp", f"От {MIN_SIZE_DP} до {MAX_SIZE_DP} dp"),
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("width", index),
                )
            )
            items.append(
                Input(
                    key=f"height_dp{suffix}",
                    text=_mz_t("Висота (dp)", "Height (dp)", "Высота (dp)"),
                    default=str(DEFAULT_SIZE_DP),
                    subtext=_mz_t(f"Від {MIN_SIZE_DP} до {MAX_SIZE_DP} dp", f"From {MIN_SIZE_DP} to {MAX_SIZE_DP} dp", f"От {MIN_SIZE_DP} до {MAX_SIZE_DP} dp"),
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("height", index),
                )
            )
            items.append(
                Input(
                    key=f"alpha_percent{suffix}",
                    text=_mz_t("Прозорість (%)", "Opacity (%)", "Прозрачность (%)"),
                    default=str(DEFAULT_ALPHA_PERCENT),
                    subtext=_mz_t(f"Від {MIN_ALPHA_PERCENT} до {MAX_ALPHA_PERCENT}%, 100 непрозоро", f"From {MIN_ALPHA_PERCENT} to {MAX_ALPHA_PERCENT}%, 100 is opaque", f"От {MIN_ALPHA_PERCENT} до {MAX_ALPHA_PERCENT}%, 100 — непрозрачно"),
                    icon="msg_photo_settings",
                    on_change=self._make_appearance_handler("alpha", index),
                )
            )

        items.append(Divider())
        if count < MAX_BOYKISSERS:
            items.append(
                Text(
                    text=_mz_t("Додати Бойкіссера", "Add Boykisser", "Добавить Бойкиссера"),
                    subtext=_mz_t(f"Зараз: {count} з {MAX_BOYKISSERS}", f"Now: {count} of {MAX_BOYKISSERS}", f"Сейчас: {count} из {MAX_BOYKISSERS}"),
                    icon="msg_add",
                    accent=True,
                    on_click=self._on_add_boykisser_click,
                )
            )
        if count > 1:
            items.append(
                Text(
                    text=_mz_t("Прибрати бойкіссера", "Remove boykisser", "Убрать бойкиссера"),
                    subtext=_mz_t(f"Прибере {BOYKISSER_LABELS[count - 1]}", f"Will remove {BOYKISSER_LABELS[count - 1]}", f"Уберёт {BOYKISSER_LABELS[count - 1]}"),
                    icon="msg_delete",
                    red=True,
                    on_click=self._on_remove_boykisser_click,
                )
            )
        return items

    def _get_boykisser_count(self) -> int:
        return self._get_clamped_int_setting(
            BOYKISSER_COUNT_KEY, DEFAULT_BOYKISSER_COUNT, 1, MAX_BOYKISSERS
        )

    def _on_add_boykisser_click(self, view=None):
        """The "Add Boykisser" button: enables the next cat
        in order and immediately rebuilds the settings page so that its own
        size/opacity fields appear for it."""
        count = self._get_boykisser_count()
        if count >= MAX_BOYKISSERS:
            return
        new_count = count + 1
        self.set_setting(BOYKISSER_COUNT_KEY, str(new_count), reload_settings=True)
        self._try_attach_to_current_activity()
        run_on_ui_thread(
            lambda: BulletinHelper.show_success(
                _mz_t(f"{BOYKISSER_LABELS[new_count - 1]} додано", f"{BOYKISSER_LABELS[new_count - 1]} added", f"{BOYKISSER_LABELS[new_count - 1]} добавлен"), get_last_fragment()
            )
        )

    def _on_remove_boykisser_click(self, view=None):
        """The "Remove boykisser" button: disables the last cat
        in order (not an arbitrary one) and rebuilds the settings page."""
        count = self._get_boykisser_count()
        if count <= 1:
            return
        removed_label = BOYKISSER_LABELS[count - 1]
        new_count = count - 1
        self.set_setting(BOYKISSER_COUNT_KEY, str(new_count), reload_settings=True)
        self._try_attach_to_current_activity()
        run_on_ui_thread(
            lambda: BulletinHelper.show_success(_mz_t(f"{removed_label} прибрано", f"{removed_label} removed", f"{removed_label} убран"), get_last_fragment())
        )

    def _create_tap_settings(self) -> List[Any]:
        return [
            Header(text=_mz_t("Дотик", "Tap", "Тап")),
            Switch(
                key="tap_enabled",
                text=_mz_t("Реакція на дотик (анімація, звук і сповіщення)", "Reaction to tap (animation, sound and notification)", "Реакция по тапу (анимация + звук + уведомление)"),
                default=True,
            ),
            Switch(
                key="tap_notification_enabled",
                text=_mz_t("Сповіщення після дотику (лише якщо ввімкнено \"Реакцію на дотик\")", "Notification on tap (only if \"Reaction to tap\" is on)", "Уведомление по тапу (только если включена \"Реакция по тапу\")"),
                default=True,
            ),
        ]

    def _create_petting_settings(self) -> List[Any]:
        return [
            Header(text=_mz_t("Гладження", "Petting", "Глажка")),
            Switch(
                key="petting_enabled",
                text=_mz_t("Гладити свайпом по верхній частині", "Pet by swiping the top part", "Гладить свайпом по верхней части"),
                default=True,
            ),
            Switch(
                key="pet_notification_enabled",
                text=_mz_t("Сповіщення під час гладження", "Notification while petting", "Уведомление при глажке"),
                default=True,
            ),
        ]

    def _create_idle_settings(self) -> List[Any]:
        return [
            Header(text=_mz_t("Інколи", "Sometimes", "Иногда")),
            Switch(
                key="idle_gif_enabled",
                text=_mz_t("Інколи показувати випадкову гіфку", "Sometimes play a random gif", "Изредка проигрывать случайную гифку"),
                default=True,
            ),
            Selector(
                key="idle_gif_preset",
                text=_mz_t("Гіфка: частота", "Gif: frequency", "Гифка: частота"),
                default=IDLE_SPEED_PRESET_DEFAULT_INDEX,
                items=IDLE_SPEED_PRESET_LABELS,
                icon="msg_photo_settings",
            ),
            Switch(
                key="idle_meow_enabled",
                text=_mz_t("Інколи нявкати просто так", "Sometimes meow for no reason", "Изредка мяукать просто так"),
                default=True,
            ),
            Selector(
                key="idle_meow_preset",
                text=_mz_t("Нявкання: частота", "Meow: frequency", "Мяу: частота"),
                default=IDLE_SPEED_PRESET_DEFAULT_INDEX,
                items=IDLE_SPEED_PRESET_LABELS,
                icon="msg_photo_settings",
            ),
        ]

    def _create_sleep_settings(self) -> List[Any]:
        return [
            Header(text=_mz_t("Сон", "Sleep", "Сон")),
            Switch(
                key="sleep_enabled",
                text=_mz_t("Засинати, коли нічого не робиш", "Fall asleep when idle", "Засыпать при бездействии"),
                default=True,
            ),
            Selector(
                key="sleep_timeout_preset",
                text=_mz_t("Через який час", "After how long", "Через какое время"),
                default=IDLE_SPEED_PRESET_DEFAULT_INDEX,
                items=IDLE_SPEED_PRESET_LABELS,
                icon="msg_mute",
