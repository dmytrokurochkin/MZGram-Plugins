SLEEP_TIMEOUT_PRESETS_SEC = [
    30,      # Very fast
    90,      # Fast
    300,     # Normal (5 minutes)
    900,     # Slow (15 minutes)
    1800,    # Very slow (30 minutes)
]

# The "pet" gesture is recognized as several finger reversals left and right
# in a row (unlike a normal one-way drag).
PET_DIRECTION_CHANGES_THRESHOLD = 3
PET_MIN_STEP_DP = 8       # minimum X step between move events, to ignore finger jitter
PET_MAX_VERTICAL_DRIFT_DP = 40  # how far the finger may wander in Y while the gesture still counts as petting

# Throwing the boykisser with inertia: if the finger was moving faster than the
# threshold when released (at the end of a drag), the boykisser does not
# stop in place but keeps flying in that direction and
# slowly slows down, bouncing off the screen edges until it stops.
# Finger speed is computed by hand from the raw coordinates of
# ACTION_MOVE events (see DragTouchListener), not via VelocityTracker: the
# view itself moves with the finger during the drag, so event coordinates
# RELATIVE to the view barely change and would give a speed of ~0;
# we need screen coordinates (getRawX/getRawY).
THROW_MIN_VELOCITY_DP = 300       # dp/s: below this threshold the release counts as just "put down"
THROW_MAX_VELOCITY_DP = 6000      # dp/s: cap on the initial throw speed (so it does not fly away instantly)
THROW_VELOCITY_SMOOTHING = 0.35   # smoothing of the instantaneous finger speed between neighboring move events
                                  # (was 0.5, lowered so finger jitter "jerks" the
                                  # final throw speed less and the flight is smoother)
THROW_RETENTION_PER_SEC = 0.5     # share of speed left after 1 second of flight (deceleration)
                                  # (was 0.35, increased: it slows down more gently, the boykisser
                                  # rolls on by inertia longer instead of abruptly "sticking")
THROW_BOUNCE_DAMPING = 0.6        # share of speed kept when bouncing off a screen edge
                                  # (was 0.55, a bit livelier bounce to match the smoother deceleration)
THROW_FRAME_MS = 12               # frame period of the throw animation loop (~83 fps, was 16ms/60 fps:
                                  # more frequent frames = smoother (less "jerky") flight animation)
THROW_STOP_VELOCITY_DP = 40       # dp/s: at this speed or lower the flight counts as finished

# "Jelly" bounce: on hitting a screen edge the image briefly
# squashes along the impact axis and bulges slightly in the perpendicular one,
# then wobbles back and forth several times, fading out like jelly
# (see _trigger_jelly_bounce/_run_jelly_frame). A purely visual effect,
# it does not affect the flight physics (vx/vy).
JELLY_BOUNCE_MAX_SQUASH = 0.28     # maximum squash amplitude (share of the size)
JELLY_BOUNCE_DURATION_MS = 320     # how long the damped oscillation lasts
JELLY_BOUNCE_FREQUENCY_HZ = 7.0    # oscillation frequency
JELLY_BOUNCE_DAMPING_RATE = 9.0    # damping rate of the amplitude (higher = fades faster)
JELLY_BOUNCE_FRAME_MS = 12         # frame period of the jelly animation

# Image size limits (dp), so an absurdly large/small size
# cannot be set and break the chat interface.
MIN_SIZE_DP = 40
MAX_SIZE_DP = 400

# Opacity limits (%), 100 = fully opaque.
MIN_ALPHA_PERCENT = 10
MAX_ALPHA_PERCENT = 100
DEFAULT_ALPHA_PERCENT = 100

# Minimum playback duration of half a sound (for very
# short files), so the sound is not cut off instantly.
MIN_MEOW_HALF_MS = 200

PLUGIN_DATA_DIRNAME = "boykisser_meow_data"
GIF_FILENAME = "boykisser.gif"
SOUND_FILENAME = "meow.mp3"
PURR_SOUND_FILENAME = "purr.mp3"

# ------------------------------------------------------------------------ #
# Several boykissers (v1.4.2): instead of one global set of
# self._overlay_view/self._drawable/..., the plugin can now keep
# several independent "cats" on screen, each a separate
# _BoykisserInstance with its own view, gif, sound, throw/jelly
# physics, sleep and "just because" timers. Only the behavior settings
# (tap/petting/sometimes/sleep/drag/
# reaction to messages) stay shared, while SIZE,
# OPACITY and POSITION are separate for each boykisser (see create_settings/
# _create_appearance_settings).
#
# The number of active cats is stored as ONE number, BOYKISSER_COUNT_KEY
# (how many first indexes of BOYKISSER_LABELS are enabled), instead of
# a separate toggle for each. In the settings it looks like
# "Add Boykisser" / "Remove boykisser" buttons at the bottom of the list (see
# _create_appearance_settings/_on_add_boykisser_click/
# _on_remove_boykisser_click): a new cat is added/removed one at a time
# from the end, not by ticking an arbitrary checkbox.
# ------------------------------------------------------------------------ #
MAX_BOYKISSERS = 5
BOYKISSER_LABELS = [f"Boykisser {i + 1}" for i in range(MAX_BOYKISSERS)]
BOYKISSER_COUNT_KEY = "boykisser_count"
DEFAULT_BOYKISSER_COUNT = 1

# Unique tags on overlay views. They are needed so that on (re)connect we can
# find and remove ANY boykisser view already hanging in the tree, even if
# it was added by another instance of this class (for example an old one
# "orphaned" after a plugin reload/update) that has no
# working reference in self._instances. Relying only on the Python
# references of the current instance is not enough: that is the main cause
# of the "2+ boykissers" bug in the original (single) version of the plugin, see
# _purge_stale_overlays. Each instance adds its own suffix to the base tag
# (see _instance_suffix), so tags like
# "boykisser_meow_overlay_main_3" unambiguously belong to Boykisser no. 3.
OVERLAY_VIEW_TAG = "boykisser_meow_overlay_main"
PET_OVERLAY_VIEW_TAG = "boykisser_meow_overlay_pet"


def _data_dir() -> str:
    # We use Telegram's shared files directory, not the plugin folder,
    # so the gif/sound are not lost when the .plugin file is reinstalled.
    d = os.path.join(get_files_dir(), PLUGIN_DATA_DIRNAME)
    ensure_dir_exists(d)
    return d


def _instance_suffix(index: int) -> str:
    """Suffix for settings keys/tags of a specific boykisser. The first
    (index=0) has no suffix, which keeps backward compatibility with old
    settings (width_dp/height_dp/alpha_percent/pos_*_dp)
    saved by plugin versions from before several cats existed."""
    return "" if index == 0 else f"_{index + 1}"


class _BoykisserInstance:
    """All mutable state of ONE boykisser on screen: its view,
    current drawable, sound, animation/petting/sleep flags and throw/jelly tokens.
    Before, all this was fields self._... of the plugin itself (the only
    boykisser on screen); now the plugin keeps a list of such objects,
    one per enabled cat (see self._instances)."""

    def __init__(self, index: int):
        self.index = index
        self.suffix = _instance_suffix(index)

        self.overlay_view = None
        self.drawable = None
        self.gif_path = None

        self.pet_view = None
        self.pet_drawable = None
        self.pet_gif_path = None
        self.is_petting = False
        self.pet_session_id = 0
        # True while the boykisser's main gif is replaced with PET_MAIN_GIF_URL.
        self.pet_main_active = False

        # While True the animation/sound are still playing and repeated taps are
        # ignored (see _on_boykisser_tap).
        self.is_animating = False

        # "Just because" gif (see _idle_gif_tick).
        self.is_idle_playing = False
        self.idle_drawable = None
        self.idle_gif_token = 0

        # Throw with inertia (see _start_throw/_run_throw_frame).
        self.is_throwing = False
        self.throw_token = 0
        # "Jelly" bounce (see _trigger_jelly_bounce/_run_jelly_frame).
        self.jelly_token = 0

        # Sleep (see _fall_asleep/_wake_up).
        self.is_sleeping = False
        self.last_interaction_ms = 0

        # Sound: each boykisser has its own MediaPlayer, so one
        # cat's meow does not cut off another's meow/purr.
        self.media_player = None
        self.purr_media_player = None
        self.is_purring = False


class BoykisserMeowPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._activity_hook = None
        # Flag to stop the chain of delayed "sometimes"/sleep timers
        # after the plugin is unloaded, see _schedule_idle_gif/_schedule_idle_meow/
        # _schedule_sleep_check (each instance additionally checks
        # that it is still present in self._instances).
        self._destroyed = False
        # True while the app is really on screen (after onResume/onCreate,
        # until the next onPause). While False, random "just because"
        # triggers (gif/meow) do not start and make no sound, even
        # if their timer fired at that moment, see _on_activity_paused,
        # _idle_gif_tick, _idle_meow_tick.
        self._is_foreground = True
        # List of active boykissers, one _BoykisserInstance for
        # each cat currently shown on screen (see _attach_overlay).
        self._instances: List[_BoykisserInstance] = []

    # ------------------------------------------------------------------ #
    # Plugin lifecycle
    # ------------------------------------------------------------------ #

    def on_plugin_load(self):
        self.log("Boykisser Corner: loading plugin")
        self._destroyed = False
        # Download the gif/sound in the background so the UI thread is not blocked
        threading.Thread(target=self._prepare_assets, daemon=True).start()
        self._install_activity_hook()
        # Hook for outgoing messages, needed to react to one's own
        # trigger words (see on_send_message_hook/_check_trigger_words).
        self.add_on_send_message_hook()
        # Try to attach the overlay right away without waiting for onCreate/onResume;
        # this is needed if the plugin is enabled in an already open app.
        # Scheduling of the "sometimes" gif/meow and the sleep check starts for
        # each boykisser separately, right after its view is created, see
        # _attach_overlay.
        self._try_attach_to_current_activity()

    def _try_attach_to_current_activity(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            activity = fragment.getParentActivity()
            if activity is None:
                return
            self._is_foreground = True
            run_on_ui_thread(lambda: self._attach_overlay(activity))
        except Exception as e:
            self.log(f"Boykisser Corner: failed to get the current activity: {e}")

    def _on_activity_paused(self):
        """Called when the app leaves the foreground (minimized, screen off, another
        app opened on top). Immediately stops a playing sound and the random
        "just because" gif for EACH boykisser. Without this the MediaPlayer would keep playing
        sound even when the user does not see or touch the app (that
        was the sound bug while minimized)."""
        self._is_foreground = False
        for instance in list(self._instances):
            self._interrupt_idle_gif(instance)
            self._stop_throw(instance)
            if instance.media_player is not None:
                mp = instance.media_player
                instance.media_player = None
                try:
                    if mp.isPlaying():
                        mp.stop()
                    mp.release()
                except Exception:
                    pass
        # Purring while petting does not need to be stopped separately: the gesture
        # itself cannot physically continue in a minimized app, the finger
        # is no longer on the screen, and ACTION_UP/ACTION_CANCEL stop it
        # the normal way (_hide_pet_overlay_now -> _stop_purr).

    def on_plugin_unload(self):
        self._destroyed = True
        for instance in list(self._instances):
            instance.is_animating = False
            self._stop_throw(instance)
        self._remove_overlay_view()
        if self._activity_hook:
            try:
                for unhook_obj in self._activity_hook:
                    self.unhook_method(unhook_obj)
            except Exception as e:
                self.log(f"Boykisser Corner: failed to remove hook: {e}")
            self._activity_hook = None

    # ------------------------------------------------------------------ #
    # Settings
    # ------------------------------------------------------------------ #

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Boykisser Corner"),
            Switch(
                key="enabled",
                text=_mz_t("Показувати boykisser", "Show boykisser", "Показывать boykisser"),
                default=True,
                on_change=self._on_enabled_change,
            ),
            Text(
                text=_mz_t("Вигляд", "Appearance", "Внешний вид"),
                subtext=_mz_t("Скільки котів, розмір і прозорість кожного", "How many cats, size and opacity of each", "Сколько котов, размер и прозрачность каждого"),
                icon="msg_photo_settings",
                create_sub_fragment=self._create_appearance_settings,
            ),
            Text(
                text=_mz_t("Дотик", "Tap", "Тап"),
                subtext=_mz_t("Анімація, звук, сповіщення після дотику", "Animation, sound, notification on tap", "Анимация, звук, уведомление по тапу"),
                icon="msg_reactions",
                create_sub_fragment=self._create_tap_settings,
            ),
            Text(
                text=_mz_t("Гладження", "Petting", "Глажка"),
                subtext=_mz_t("Свайп по верхній частині та сповіщення", "Swipe on the top part and notification", "Свайп по верхней части и уведомление"),
                icon="msg_fave",
                create_sub_fragment=self._create_petting_settings,
            ),
            Text(
                text=_mz_t("Інколи", "Sometimes", "Иногда"),
                subtext=_mz_t("Випадкові гіфки та нявкання без причини", "Random gifs and meows for no reason", "Случайные гифки и мяу без причины"),
                icon="msg_reactions",
                create_sub_fragment=self._create_idle_settings,
            ),
            Text(
                text=_mz_t("Сон", "Sleep", "Сон"),
                subtext=_mz_t("Засинає, якщо його довго не чіпати", "Falls asleep if left alone for a long time", "Засыпает, если долго не трогать"),
                icon="msg_mute",
