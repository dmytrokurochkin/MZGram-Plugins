# word → nominative | genitive | gender (m/f/n/p); * = head word
_WORDS_SRC = _mz_t("""
*text=текст|тексту|m
*background=фон|фону|m
*icon=іконка|іконки|f
*icons=іконки|іконок|p
*line=лінія|лінії|f
*lines=лінії|ліній|p
*shadow=тінь|тіні|f
*border=рамка|рамки|f
*fill=заливка|заливки|f
*circle=коло|кола|n
*dot=крапка|крапки|f
*glow=свічення|свічення|n
*selector=ефект натискання|ефекту натискання|m
*ripple=ефект натискання|ефекту натискання|m
*thumb=повзунок|повзунка|m
*track=доріжка|доріжки|f
