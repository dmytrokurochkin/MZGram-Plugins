"""
Theme Color Editor — interface color editor for exteraGram.

Features:
  • a floating window with a list of all theme color keys (like the built-in
    Telegram editor), search, tabs "On screen / All / Changed";
  • tapping a key shows where that element is on screen
    (a frame around the elements + color blinking);
  • eyedropper: tap any element on screen and the plugin finds its keys;
  • convenient color picker: HSV wheel, HSV/RGB sliders, opacity, HEX,
    recent colors and a palette, live preview;
  • changes are saved and apply on top of any theme, survive a
    restart and a theme change; export/import in .attheme format.
"""
# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en


__id__ = "color_inspector"
__name__ = "Theme Color Editor"
__description__ = "Color editor for every interface element: clear names, an eyedropper to find an element by tapping it, element highlight with a jump to the right screen, RGB shimmer and a \"ribbon\", HSV wheel, RGB/HEX, live preview, export and import."
__author__ = "@resotez"
__version__ = "1.3.3-mz1"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.10.6"
__category__ = ["appearance"]

