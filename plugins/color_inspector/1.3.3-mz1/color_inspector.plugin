def key_hint(name):
    """App section the key belongs to."""
    if not name:
        return ""
    for prefix, text in PREFIX_HINTS:
        if name.startswith(prefix):
            return text
    return _mz_t("Колір теми", "Theme color", "Цвет темы")


def flag_labels(flags):
    flags = u32(flags)
    out = []
    for bit, label in FLAG_LABELS:
        if flags & bit and label not in out:
            out.append(label)
    return out


