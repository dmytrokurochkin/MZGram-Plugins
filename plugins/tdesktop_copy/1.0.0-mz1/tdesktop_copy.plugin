# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from datetime import datetime
from typing import Any, List

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Text

__id__ = "tdesktop_copy"
__name__ = "Copy Like TDesktop"
__description__ = "Copies messages with date and time in the Telegram Desktop style"
__author__ = "MZGram"
__version__ = "1.0.0-mz1"
__app_version__ = ">=12.8.1"
__category__ = ["chats"]
__sdk_version__ = ">=1.4.3.10"


class GetMessageContentHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            msg_obj = param.args[0]
            result = param.getResult()
            if result is None:
                return

            owner = getattr(msg_obj, "messageOwner", None)
            date_unix = getattr(owner, "date", None) if owner else None
            if date_unix is None:
                date_unix = getattr(msg_obj, "date", None)
            if date_unix is None:
                return

            dt = datetime.fromtimestamp(int(date_unix))
            date_str = dt.strftime("%d/%m/%Y %H:%M")
            original = str(result)
            param.setResult(f"[{date_str}] {original}")

        except Exception as e:
            self.plugin.log(f"GetMessageContentHook error: {e}")


class CopyWithTimestampPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            CA = find_class("org.telegram.ui.ChatActivity")
            self.hook_all_methods(CA, "getMessageContent", GetMessageContentHook(self))
        except Exception as e:
            self.log(f"CopyWithTimestamp: {e}")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Copy with Timestamp"),
            Text(
                text=_mz_t("Як користуватися", "How to use", "Как пользоваться"),
                subtext=_mz_t("Виділіть повідомлення → натисніть «Копіювати». Формат: [DD/MM/YYYY HH:MM] Ім'я: текст", "Select messages → tap Copy. Format: [DD/MM/YYYY HH:MM] Name: text", "Выдели сообщения → нажми Копировать. Формат: [DD/MM/YYYY HH:MM] Имя: текст"),
                icon="msg_copy",
            ),
        ]
