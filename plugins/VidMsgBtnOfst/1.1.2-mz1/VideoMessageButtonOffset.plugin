# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Switch, Input, Header, Divider

__id__ = "VidMsgBtnOfst"
__name__ = "Button offset in video messages"
__description__ = "Lets you move the flash and camera switch buttons in video messages"
__author__ = "MZGram"
__version__ = "1.1.2-mz1"
__min_version__ = "11.12.0"
__category__ = ["appearance", "media"]

TAG_FIXED = 0x7A9B1C


class CameraButtonsRightPlugin(BasePlugin):
    def on_plugin_load(self):
        InstantCameraView = find_class("org.telegram.ui.Components.InstantCameraView")
        if not InstantCameraView:
            return
        plugin = self

        class CtorHook(MethodHook):
            def after_hooked_method(self, param):
                run_on_ui_thread(lambda: plugin._fix(param.thisObject), 300)

        ctors = InstantCameraView.getClass().getDeclaredConstructors()
        for ctor in ctors:
            ctor.setAccessible(True)
            self.hook_method(ctor, CtorHook())

    def create_settings(self):
        return [
            Header(text=_mz_t("Розташування", "Position", "Расположение")),
            Switch(
                key="invert",
                text=_mz_t("Інвертувати кнопки", "Invert buttons", "Инвертировать кнопки"),
                default=False,
                subtext=_mz_t("Спалах справа, камера зліва", "Flash on the right, camera on the left", "Вспышка справа, камера слева")
            ),
            Header(text=_mz_t("Зміщення", "Offset", "Смещение")),
            Input(
                key="offset_x",
                text=_mz_t("Зміщення по X (dp)", "X offset (dp)", "Смещение по X (dp)"),
                default="499",
                subtext=_mz_t("Відступ від правого краю", "Margin from the right edge", "Отступ от правого края")
            ),
            Input(
                key="offset_y",
                text=_mz_t("Зміщення по Y (dp)", "Y offset (dp)", "Смещение по Y (dp)"),
                default="0",
                subtext=_mz_t("Відступ від нижнього краю", "Margin from the bottom edge", "Отступ от нижнего края")
            ),
            Header(text=_mz_t("Розмір", "Size", "Размер")),
            Input(
                key="scale",
                text=_mz_t("Масштаб кнопок (%)", "Button scale (%)", "Масштаб кнопок (%)"),
                default="100",
                subtext=_mz_t("100: оригінальний розмір", "100: original size", "100 — оригинальный размер")
            ),
            Header(text=_mz_t("Прозорість", "Opacity", "Прозрачность")),
            Input(
                key="alpha",
                text=_mz_t("Прозорість кнопок (%)", "Button opacity (%)", "Прозрачность кнопок (%)"),
                default="100",
                subtext=_mz_t("100: повністю видимі, 0: невидимі", "100: fully visible, 0: invisible", "100 — полностью видимые, 0 — невидимые")
            ),
            Header(text=_mz_t("Прибрати кнопки", "Hide buttons", "Убрать кнопки")),
            Switch(
                key="hide_flash",
                text=_mz_t("Прибрати кнопку спалаху", "Hide flash button", "Убрать кнопку вспышки"),
                default=False
            ),
            Switch(
                key="hide_camera",
                text=_mz_t("Прибрати кнопку зміни камери", "Hide camera switch button", "Убрать кнопку смены камеры"),
                default=False
            ),
            Divider(text=_mz_t("Зміни застосовуються після перезапуску застосунку", "Changes apply after restarting the app", "Изменения применяются после перезапуска приложения")),
        ]

    def _fix(self, view):
        try:
            if view.getTag(TAG_FIXED):
                return

            dp = self._dp(view)

            invert = self.get_setting("invert", False)
            hide_flash = self.get_setting("hide_flash", False)
            hide_camera = self.get_setting("hide_camera", False)
            try:
                offset_x = int(self.get_setting("offset_x", "499"))
            except Exception:
                offset_x = 499
            try:
                offset_y = int(self.get_setting("offset_y", "0"))
            except Exception:
                offset_y = 0
            try:
                scale = float(self.get_setting("scale", "100")) / 100.0
            except Exception:
                scale = 1.0
            try:
                alpha = int(float(self.get_setting("alpha", "100")) / 100.0 * 255)
            except Exception:
                alpha = 255

            for i in range(view.getChildCount()):
                child = view.getChildAt(i)
                try:
                    lp = child.getLayoutParams()
                    if lp is None:
                        continue
                    if lp.gravity == 83 and child.getChildCount() == 2:
                        btn0 = child.getChildAt(0)
                        btn1 = child.getChildAt(1)
                        child.removeAllViews()

                        if hide_flash:
                            btn1.setVisibility(4)
                        if hide_camera:
                            btn0.setVisibility(4)

                        if alpha < 255:
                            child.setAlpha(alpha / 255.0)

                        if invert:
                            child.addView(btn0)
                            child.addView(btn1)
                        else:
                            child.addView(btn1)
                            child.addView(btn0)

                        if scale != 1.0:
                            child.setScaleX(scale)
                            child.setScaleY(scale)

                        lp.gravity = 85
                        lp.rightMargin = dp(offset_x)
                        lp.bottomMargin = dp(offset_y)
                        lp.leftMargin = 0
                        child.setLayoutParams(lp)
                        child.requestLayout()
                        break
                except Exception:
                    pass

            view.setTag(TAG_FIXED, True)
        except Exception:
            pass

    def _dp(self, view):
        try:
            density = view.getContext().getResources().getDisplayMetrics().density
            return lambda x: int(x * density + 0.5)
        except Exception:
            return lambda x: x * 3