# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "quick_select"
__name__ = "Quick Select"
__description__ = "Speeds up automatic chat scrolling with several selection options and removes the limit on selecting messages."
__version__ = "1.0.0-mz1"
__author__ = "MZGram"
__min_version__ = "11.12.0"
__category__ = ["chats"]

import math
from typing import Any

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook, MethodReplacement
from client_utils import get_last_fragment
from hook_utils import find_class, get_private_field, set_private_field
from java import jclass
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text
from org.telegram.messenger import AndroidUtilities


# Selection-limit lifting was implemented from scratch after studying
# the approach used in noForwardLimit.plugin by @zwylair.


class MultiSelectRunHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin._inject_extra_scroll(param.thisObject)


class UnlimitedSelectionHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin._prepare_unlimited_selection(param)

    def after_hooked_method(self, param):
        self.plugin._finalize_unlimited_selection(param)


class ClearSelectionStateHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, _param):
        self.plugin._clear_unlimited_selection_state()


class LimitReachedReplacement(MethodReplacement):
    def replace_hooked_method(self, _param):
        return False


class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._integer_class = jclass("java.lang.Integer")
        self._unhooks = []
        self._multiselect_runner_class = None
        self._chat_activity_class = None
        self._chat_multiselect_class = None
        self._selected_messages = {0: {}, 1: {}}
        self._selection_dialog_id = None
        self._unlimited_mode_active = False
        self._update_action_mode_title_method = None

    def on_plugin_load(self):
        try:
            self._multiselect_runner_class = find_class("org.telegram.ui.Components.RecyclerListView$6")
            self._chat_activity_class = find_class("org.telegram.ui.ChatActivity")
            self._chat_multiselect_class = find_class("org.telegram.ui.ChatActivity$11")

            if not self._multiselect_runner_class:
                raise RuntimeError("RecyclerListView$6 class not found.")
            if not self._chat_activity_class:
                raise RuntimeError("ChatActivity class not found.")
            if not self._chat_multiselect_class:
                raise RuntimeError("ChatActivity$11 class not found.")

            self._add_unhooks(
                self.hook_all_methods(
                    self._multiselect_runner_class,
                    "run",
                    MultiSelectRunHook(self),
                )
            )
            self._add_unhooks(
                self.hook_all_methods(
                    self._chat_activity_class,
                    "addToSelectedMessages",
                    UnlimitedSelectionHook(self),
                )
            )
            self._add_unhooks(
                self.hook_all_methods(
                    self._chat_activity_class,
                    "hideActionMode",
                    ClearSelectionStateHook(self),
                )
            )
            self._add_unhooks(
                self.hook_all_methods(
                    self._chat_multiselect_class,
                    "limitReached",
                    LimitReachedReplacement(),
                )
            )
            self._update_action_mode_title_method = self._chat_activity_class.getDeclaredMethod("updateActionModeTitle")
            self._update_action_mode_title_method.setAccessible(True)
        except Exception as error:
            self.log(f"Quick Select load error: {error}")

    def on_plugin_unload(self):
        for unhook in self._unhooks:
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks.clear()
        self._clear_unlimited_selection_state()

    def create_settings(self):
        return [
            Header(text="Quick Select"),
            Switch(
                key="enabled",
                text=_mz_t("Прискорювати виділення", "Speed up selection", "Ускорять выделение"),
                default=True,
                subtext=_mz_t("Додає extra scroll під час drag-select у чаті.", "Adds extra scroll during drag-select in the chat.", "Добавляет extra scroll во время drag-select в чате."),
                icon="msg_settings",
            ),
            Input(
                key="speed_multiplier",
                text=_mz_t("Множник швидкості", "Speed multiplier", "Множитель скорости"),
                default="4.0",
                subtext=_mz_t("1.0 = як було. Великі значення тепер справді прискорюють сильніше.", "1.0 = as before. Larger values now really speed things up more.", "1.0 = как было. Большие значения теперь реально ускоряют сильнее."),
                icon="msg_text",
            ),
            Input(
                key="min_step",
                text=_mz_t("Мінімальний крок", "Minimum step", "Минимальный шаг"),
                default="12",
                subtext=_mz_t("Нижній поріг extra-scroll у px за один tick.", "Lower extra-scroll threshold in px per tick.", "Нижний порог extra-scroll в px за один tick."),
                icon="msg_text",
            ),
            Input(
                key="max_step_per_call",
                text=_mz_t("Макс. крок за виклик", "Max step per call", "Макс. шаг за вызов"),
                default="64",
                subtext=_mz_t("Ліміт одного виклику extra-scroll. Для дуже великих швидкостей використовується turbo-repeat.", "Limit of one extra-scroll call. Very high speeds use turbo-repeat.", "Лимит одного extra-scroll вызова. Для очень больших скоростей используется turbo-repeat."),
                icon="msg_text",
            ),
            Input(
                key="max_repeat_calls",
                text=_mz_t("Ліміт turbo repeat", "Turbo repeat cap", "Turbo repeat cap"),
                default="10",
                subtext=_mz_t("Скільки викликів extra-scroll можна зробити за один tick. Це знімає стелю швидкості на 10x, 25x і вище.", "How many extra-scroll calls can be made per tick. This removes the speed ceiling at 10x, 25x and above.", "Сколько extra-scroll вызовов можно сделать за один tick. Это убирает потолок скорости на 10x, 25x и выше."),
                icon="msg_text",
            ),
            Input(
                key="base_tick_dp",
                text=_mz_t("Базовий tick (dp)", "Base tick (dp)", "Базовый tick (dp)"),
                default="3.0",
                subtext=_mz_t("Стандартний розмір scroll tick. Можна підняти, якщо хочеться ще агресивніше.", "Standard scroll tick size. Can be raised if you want it even more aggressive.", "Штатный размер scroll tick. Можно поднять, если хочется ещё агрессивнее."),
                icon="msg_text",
            ),
            Divider(),
            Switch(
                key="remove_selection_limit",
                text=_mz_t("Прибрати ліміт вибору", "Remove selection limit", "Убрать лимит выбора"),
                default=True,
                subtext=_mz_t("Дозволяє вибирати більше 100 повідомлень в одному режимі вибору.", "Allows selecting more than 100 messages in one selection mode.", "Позволяет выделять больше 100 сообщений в одном режиме выбора."),
                icon="msg_settings",
            ),
            Divider(),
            Header(text=_mz_t("Як налаштувати", "How to set up", "Как настроить")),
            Text(
                text=_mz_t("Відкрити зрозумілу інструкцію", "Open the clear guide", "Открыть понятную инструкцию"),
                icon="msg_info",
                accent=True,
                on_click=self._show_tuning_guide,
            ),
            Text(
                text=_mz_t("Показати поточні значення", "Show current values", "Показать текущие значения"),
                icon="msg_info",
                accent=True,
                on_click=self._show_status,
            ),
            Text(
                text=_mz_t("Скинути до рекомендованих", "Reset to recommended", "Сбросить к рекомендованным"),
