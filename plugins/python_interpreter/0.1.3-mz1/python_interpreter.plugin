        enable_py = self.enable_py
        show_traceback = self.show_traceback
        max_history = self.max_history
        timeout_seconds = self.timeout_seconds
        max_output_len = self.max_output_len
        max_file_size_kb = self.max_file_size_kb
        restrict_dangerous = self.restrict_dangerous

        history_count = len(getattr(self, "history", []))
        scope_var_count = len([
            k for k in getattr(self, "scope", {}).keys() if k not in ("__builtins__", "_")
        ])

        return [
            Header(text=_mz_t("Безпека", "Security", "Безопасность")),
            Text(
                text=_mz_t("Важлива інформація", "Important information", "Важная информация"),
                icon="msg_error",
                red=True,
                on_click=self._show_safety_dialog,
            ),
            Switch(
                key="restrict_dangerous",
                text=_mz_t("Обмежити небезпечні функції", "Restrict dangerous functions", "Ограничить опасные функции"),
                default=restrict_dangerous,
                subtext=_mz_t("Блокує import, open, eval, exec, compile у коді, що виконується. Застосовується одразу і скидає контекст.", "Blocks import, open, eval, exec and compile in the code being run. Applied at once, and resets the context.", "Блокирует import, open, eval, exec, compile в выполняемом коде. Применяется сразу и сбрасывает контекст."),
                icon="floating_check",
                on_change=self._on_restrict_dangerous_change,
