                subtext=_mz_t(f"Зараз у scope змінних: {scope_var_count}", f"Variables in scope now: {scope_var_count}", f"Сейчас в scope переменных: {scope_var_count}"),
                icon="msg_arrow_forward",
                on_click=self._on_reset_context_click,
            ),
            Text(
                text=_mz_t("Очистити історію", "Clear history", "Очистить историю"),
                subtext=_mz_t(f"Записів в історії: {history_count}", f"History entries: {history_count}", f"Записей в истории: {history_count}"),
                icon="msg_list",
                on_click=self._on_clear_history_click,
            ),

        ]

    def _parse_py_command(self, raw_text: str):
        if raw_text == ">py":
            return ""
        if raw_text.startswith(">py "):
            return raw_text[4:]
        if raw_text.startswith(">py\n"):
            return raw_text[4:]
        return None

    def _extract_assign_names(self, target):
        if isinstance(target, ast.Name):
            return [target.id]
        if isinstance(target, (ast.Tuple, ast.List)):
            names = []
            for elt in target.elts:
                names.extend(self._extract_assign_names(elt))
            return names
        if isinstance(target, ast.Attribute):
            return [target.attr]
        if isinstance(target, ast.Starred):
            return self._extract_assign_names(target.value)
        return []

    def _describe_assignment(self, node):
        if isinstance(node, ast.Assign):
            names = []
            for target in node.targets:
                names.extend(self._extract_assign_names(target))
            return names
        if isinstance(node, ast.AnnAssign) and node.target is not None:
            return self._extract_assign_names(node.target)
        if isinstance(node, ast.AugAssign):
            return self._extract_assign_names(node.target)
        return []

    def _format_no_output(self, code: str) -> str:
        stripped = code.lstrip()
        if not stripped:
            return _mz_t("<порожній код>", "<empty code>", "<пустой код>")

        try:
            tree = ast.parse(code, mode="exec")
        except SyntaxError:
            tree = None

        if tree is not None:
            assigned_names = []
            for node in tree.body:
                assigned_names.extend(self._describe_assignment(node))
            if assigned_names:
                unique_names = list(dict.fromkeys(assigned_names))
                if len(unique_names) == 1:
                    return _mz_t(f"Змінну прийнято: {unique_names[0]}", f"Variable accepted: {unique_names[0]}", f"Переменная принята: {unique_names[0]}")
                return _mz_t(f"Змінні прийнято: {', '.join(unique_names)}", f"Variables accepted: {', '.join(unique_names)}", f"Переменные приняты: {', '.join(unique_names)}")

        starters = ("def ", "class ", "import ", "from ", "for ", "while ", "if ", "try:", "with ")
        if stripped.startswith(starters):
            first = stripped.split(None, 1)[0].rstrip(":")
            return f"OK: {first} executed"
        return _mz_t("<немає виводу>", "<no output>", "<нет вывода>")

    def _sanitize_code(self, code: str) -> str:
        replacements = {
            "\u00a0": " ",
            "\u2007": " ",
            "\u202f": " ",
            "\u2018": "'",
            "\u2019": "'",
            "\u201c": '"',
            "\u201d": '"',
            "\u2013": "-",
            "\u2014": "-",
            "\u200b": "",
            "\u200c": "",
            "\u200d": "",
            "\ufeff": "",
        }
        for bad, good in replacements.items():
            code = code.replace(bad, good)
        return code

    def _compile_repl(self, code: str):
        code = self._sanitize_code(code)
        tree = ast.parse(code, mode="exec")
        eval_expr = None
        if tree.body and isinstance(tree.body[-1], ast.Expr):
            last = tree.body.pop()
            eval_expr = ast.Expression(last.value)
            ast.fix_missing_locations(eval_expr)
        exec_part = compile(tree, "<chat-py>", "exec") if tree.body else None
        eval_part = compile(eval_expr, "<chat-py>", "eval") if eval_expr else None
        return exec_part, eval_part

    def _execute_code(self, code: str, command_name: str) -> str:
        code = self._sanitize_code(code.strip())
        if not code:
            return _mz_t("<порожній код>", "<empty code>", "<пустой код>")

        if not self._execution_lock.acquire(blocking=False):
            elapsed = time.time() - self._execution_started_at if self._execution_started_at else 0
            return _mz_t(f"Попередній код ще виконується ({elapsed:.1f} с), дочекайтеся завершення або перевірте >running.", f"The previous code is still running ({elapsed:.1f} s). Wait for it to finish or check >running.", f"Предыдущий код ещё выполняется ({elapsed:.1f} с), дождитесь завершения или проверьте >running.")

        result_container = {}
        self._is_running = True
        self._execution_started_at = time.time()

        def runner():
            try:
                from android.os import Process
                Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
            except Exception as e:
                self.log(f"Failed to lower thread priority: {e}")

            buffer = io.StringIO()
            start_time = time.time()
            try:
                exec_part, eval_part = self._compile_repl(code)
                with redirect_stdout(buffer), redirect_stderr(buffer):
                    if exec_part:
                        exec(exec_part, self.scope, self.scope)
                    if eval_part:
                        result_val = eval(eval_part, self.scope, self.scope)
                        self.scope["_"] = result_val
                        if result_val is not None:
                            print(result_val)
                out = buffer.getvalue().strip()
                if not out:
                    out = self._format_no_output(code)
                result_container["result"] = out
            except (SystemExit, KeyboardInterrupt) as e:
                result_container["result"] = f"Blocked: {type(e).__name__}"
            except EOFError as e:
                result_container["result"] = str(e) if str(e) else (
                    _mz_t("input() не працює в цьому середовищі: тут немає інтерактивного введення, код виконується в чаті, а не в терміналі.", "input() doesn't work in this environment: there is no interactive input here, the code runs in the chat, not in a terminal.", ("input() не работает в этом окружении: здесь нет интерактивного ввода, "
                    "код выполняется в чате, а не в терминале."))
                )
            except (IndentationError, TabError):
                base_msg = (
                    traceback.format_exc().strip() if self.show_traceback
                    else str(traceback.format_exc().splitlines()[-1])
                )
                result_container["result"] = (
                    _mz_t(f"{base_msg}\n\nСхоже, відступи зсунулися. Це часта проблема під час введення багаторядкового коду з телефона. Перевірте, що скрізь використовуються однакові відступи (наприклад, лише пробіли, без табуляції).", f"{base_msg}\n\nThe indentation looks off. This is a common problem when typing multi-line code on a phone. Check that the same indentation is used everywhere (for example, spaces only, no tabs).", (f"{base_msg}\n\nПохоже, отступы съехали — частая проблема при вводе "
                    "многострочного кода с телефона. Проверьте, что везде используются "
                    "одинаковые отступы (например, только пробелы, без табов)."))
                )
            except Exception:
                result_container["result"] = (
                    traceback.format_exc().strip() if self.show_traceback
                    else str(traceback.format_exc().splitlines()[-1])
                )
            finally:
                result_container["duration"] = time.time() - start_time
                self._persist_scope()
                self._is_running = False
                self._execution_started_at = None

        thread = threading.Thread(target=runner, daemon=True)
        thread.start()
        thread.join(self.timeout_seconds)

        if thread.is_alive():
            self._execution_lock.release()
            if getattr(self, "_waiting_for_input", False):
                result = (
                    _mz_t(f"Код чекає введення: {self._input_prompt}\n\nВідповідайте командою >answer <значення>, щоб продовжити виконання.", f"Code is waiting for input: {self._input_prompt}\n\nReply with the >answer <value> command to continue.", (f"Код ждёт ввод: {self._input_prompt}\n\n"
                    "Ответьте командой >answer <значение>, чтобы продолжить выполнение."))
                )
            else:
                result = (
                    _mz_t(f"Тайм-аут виконання ({self.timeout_seconds} с). Код не завершився і може продовжувати працювати у фоні. Перевірити, чи він завершився, можна командою >running.", f"Execution timeout ({self.timeout_seconds} s). The code didn't finish and may keep running in the background. Check whether it has finished with >running.", (f"Тайм-аут выполнения ({self.timeout_seconds} с). Код не завершился и "
                    "может продолжать работать в фоне. Проверить, закончил ли он, можно командой >running."))
                )
            self._add_to_history(command_name, result)

            def notify_when_done():
                thread.join()
                final_result = self._clip_text(result_container.get("result", _mz_t("<немає виводу>", "<no output>", "<нет вывода>")))
                final_duration = result_container.get("duration")
                if final_duration is not None:
                    final_result = f"{final_result}\n\n[{final_duration:.3f} {_mz_t('с', 's', 'с')}]"
                self._add_to_history(command_name, final_result)
                try:
                    run_on_ui_thread(lambda: BulletinHelper.show_success(_mz_t("Код завершив виконання.", "The code finished running.", "Код завершил выполнение.")))
                except Exception as e:
                    self.log(f"Failed to show completion bulletin: {e}")

            threading.Thread(target=notify_when_done, daemon=True).start()
            return result

        self._execution_lock.release()
        result = self._clip_text(result_container.get("result", _mz_t("<немає виводу>", "<no output>", "<нет вывода>")))
        duration = result_container.get("duration")
        if duration is not None:
            result = f"{result}\n\n[{duration:.3f} {_mz_t('с', 's', 'с')}]"
        self._add_to_history(command_name, result)
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_success(_mz_t("Код завершив виконання.", "The code finished running.", "Код завершил выполнение.")))
        except Exception as e:
            self.log(f"Failed to show completion bulletin: {e}")
        return result

    def _read_python_file(self, file_path: str) -> str:
        if not os.path.exists(file_path):
            raise FileNotFoundError(_mz_t("Файл не знайдено на пристрої.", "File not found on the device.", "Файл не найден на устройстве."))

        if os.path.getsize(file_path) > self.max_file_size_kb * 1024:
            raise ValueError(_mz_t("Файл занадто великий для безпечного виконання.", "The file is too large to run safely.", "Файл слишком большой для безопасного выполнения."))

        encodings = ("utf-8", "utf-8-sig", "cp1251")
        last_error = None

        for enc in encodings:
            try:
                with open(file_path, "r", encoding=enc) as f:
                    return f.read()
            except Exception as e:
                last_error = e

        raise ValueError(_mz_t(f"Не вдалося прочитати файл: {last_error}", f"Couldn't read the file: {last_error}", f"Не удалось прочитать файл: {last_error}"))

    def _get_document_filename(self, document):
        try:
            name = FileLoader.getDocumentFileName(document)
            if name and str(name).strip():
                return str(name)
        except Exception:
            pass

        try:
            for attribute in document.attributes:
                candidate = getattr(attribute, "file_name", None)
                if candidate:
                    return str(candidate)
        except Exception:
            pass

        fallback = getattr(document, "file_name", None) or getattr(document, "fileName", None)
        return str(fallback) if fallback else "unknown"

    def _extract_document_path(self, account: int, reply_to_msg):
        def find_doc(obj):
            if not obj:
                return None
            if hasattr(obj, "document") and obj.document:
                return obj.document
            if hasattr(obj, "media"):
                if hasattr(obj.media, "document") and obj.media.document:
                    return obj.media.document
                if hasattr(obj.media, "file") and obj.media.file:
                    return obj.media.file
            return None

        document = find_doc(reply_to_msg)
        if not document:
            return None, None, _mz_t("Не вдалося знайти файл у відповіді.", "Couldn't find the file in the reply.", "Не удалось найти файл в ответе.")

        file_name = self._get_document_filename(document)
        if not file_name.lower().endswith(".py"):
            return None, None, _mz_t(f"Підтримуються лише .py файли (отримано: {file_name}).", f"Only .py files are supported (got: {file_name}).", f"Поддерживаются только .py файлы (получено: {file_name}).")

        try:
            java_file = FileLoader.getInstance(account).getPathToAttach(document)
            file_path = java_file.getAbsolutePath() if java_file else None
            if not file_path:
                return None, None, _mz_t("Не вдалося отримати шлях до файлу.", "Couldn't get the file path.", "Не удалось получить путь к файлу.")
            return document, file_path, None
        except Exception:
            return None, None, _mz_t("Помилка під час отримання шляху до файлу.", "Error while getting the file path.", "Ошибка при получении пути к файлу.")

    def _render_history(self) -> str:
        if not self.history:
            return _mz_t("Історія порожня.", "History is empty.", "История пуста.")

        lines = []
        for i, (cmd, res) in enumerate(self.history, start=1):
            cmd_preview = cmd.replace("\n", " ")[:40]
            res_preview = res.replace("\n", " ")[:60]
            lines.append(f"{i}. {cmd_preview} -> {res_preview}")
        return "\n".join(lines)

    def _render_vars(self) -> str:
        skip = ("__builtins__", "_", "input")
        names = sorted(k for k in self.scope.keys() if k not in skip)
        if not names:
            return _mz_t("Змінних поки немає.", "No variables yet.", "Переменных пока нет.")

        lines = []
        for name in names:
            value = self.scope[name]
            type_name = type(value).__name__
            try:
                value_repr = repr(value)
            except Exception:
                value_repr = _mz_t("<не вдалося отримати repr>", "<couldn't get repr>", "<не удалось получить repr>")
            if len(value_repr) > 40:
                value_repr = value_repr[:40] + "..."
            lines.append(f"{name}: {type_name} = {value_repr}")
        return _mz_t("Поточні змінні:\n", "Current variables:\n", "Текущие переменные:\n") + "\n".join(lines)

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not isinstance(getattr(params, "message", None), str):
            return HookResult()

        self._load_settings()
        if self.restrict_dangerous != getattr(self, "_scope_restrict_state", False):
            self._reset_scope()

        raw_text = params.message.strip()

        if raw_text == ">help":
            params.message = (
                _mz_t("Команди Python Interpreter:\n>py <code>: код Python\n>pyopen: запуск .py файлу з відповіді\n>history: історія\n>repeat: повтор останнього результату\n>rerun <номер>: повторити команду з історії\n>vars: показати поточні змінні\n>reset: скидання контексту\n>clearhistory: очистити історію\n>running: чи триває зараз виконання\n>answer <значення>: відповідь на input() у коді\n>info: інформація про плагін", "Python Interpreter commands:\n>py <code>: Python code\n>pyopen: run a .py file from the reply\n>history: history\n>repeat: repeat the last result\n>rerun <number>: run a command from history again\n>vars: show current variables\n>reset: reset context\n>clearhistory: clear history\n>running: whether code is running now\n>answer <value>: reply to input() in the code\n>info: plugin info", ("Команды Python Interpreter:\n"
                ">py <code> — код Python\n"
                ">pyopen — запуск .py файла из ответа\n"
                ">history — история\n"
                ">repeat — повтор последнего результата\n"
                ">rerun <номер> — повторить команду из истории\n"
                ">vars — показать текущие переменные\n"
                ">reset — сброс контекста\n"
                ">clearhistory — очистить историю\n"
                ">running — идёт ли сейчас выполнение\n"
                ">answer <значение> — ответ на input() внутри кода\n"
                ">info — информация о плагине"))
            )
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text in (">info", ">status"):
            params.message = (
                f"Plugin: {__name__}\n"
                f"Dev: {__author__}\n"
                f"Version: {__version__}\n"
                f"Status: {'Active' if self.enable_py else 'Disabled'}"
            )
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">history":
            params.message = self._render_history()
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">repeat":
            params.message = self.last_result if self.last_result else _mz_t("Немає результату для повтору.", "No result to repeat.", "Нет результата для повтора.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">reset":
            self._reset_scope()
            params.message = _mz_t("Контекст (scope) скинуто.", "Context (scope) reset.", "Контекст (scope) сброшен.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">clearhistory":
            self.history = []
            self.last_result = ""
            self._persist_history()
            params.message = _mz_t("Історію очищено.", "History cleared.", "История очищена.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text in (">running", ">isrunning"):
            if getattr(self, "_is_running", False) and self._execution_started_at:
                elapsed = time.time() - self._execution_started_at
                params.message = _mz_t(f"Код виконується вже {elapsed:.1f} с.", f"The code has been running for {elapsed:.1f} s.", f"Код выполняется уже {elapsed:.1f} с.")
            else:
                params.message = _mz_t("Зараз нічого не виконується.", "Nothing is running right now.", "Сейчас ничего не выполняется.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text in (">vars", ">variables"):
            params.message = self._render_vars()
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">answer" or raw_text.startswith(">answer "):
            answer_text = raw_text[8:] if raw_text.startswith(">answer ") else ""
            if getattr(self, "_waiting_for_input", False):
                self._input_value = answer_text
                self._input_event.set()
                params.message = _mz_t(f"Відповідь прийнято: {answer_text}", f"Answer accepted: {answer_text}", f"Ответ принят: {answer_text}")
            else:
                params.message = _mz_t("Код зараз не чекає введення.", "The code is not waiting for input right now.", "Код сейчас не ждёт ввода.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">rerun" or raw_text.startswith(">rerun "):
            arg = raw_text[7:].strip() if raw_text.startswith(">rerun ") else ""
            try:
                idx = int(arg) - 1
            except ValueError:
                params.message = _mz_t("Використання: >rerun <номер з >history>", "Usage: >rerun <number from >history>", "Использование: >rerun <номер из >history>")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if not (0 <= idx < len(self.history)):
                params.message = _mz_t(f"Немає запису №{arg} в історії. Перевірте >history.", f"No entry #{arg} in the history. Check >history.", f"Нет записи №{arg} в истории. Проверьте >history.")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            cmd_to_rerun = self.history[idx][0]
            if cmd_to_rerun.startswith("File: "):
                params.message = _mz_t("Цей запис не можна повторити: це результат >pyopen, а не код.", "This entry can't be repeated: it is the result of >pyopen, not code.", "Эту запись нельзя повторить — это результат >pyopen, а не код.")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if not self.enable_py:
                params.message = _mz_t("Виконання коду вимкнено.", "Code execution is disabled.", "Выполнение кода отключено.")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            params.message = self._execute_code(cmd_to_rerun, cmd_to_rerun or ">py")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        code = self._parse_py_command(raw_text)
        if code is not None:
            if not self.enable_py:
                params.message = _mz_t("Виконання коду вимкнено.", "Code execution is disabled.", "Выполнение кода отключено.")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            params.message = self._execute_code(code, code or ">py")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if raw_text == ">pyopen":
            if not self.enable_py:
                params.message = _mz_t("Виконання коду вимкнено.", "Code execution is disabled.", "Выполнение кода отключено.")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            reply_obj = getattr(params, "replyToMsg", None) or getattr(params, "reply_to_msg", None)
            reply_to_msg = getattr(reply_obj, "messageOwner", reply_obj)

            if not reply_to_msg:
                params.message = _mz_t("Відповідьте на повідомлення з .py файлом командою >pyopen", "Reply to a message with a .py file using the >pyopen command", "Ответьте на сообщение с .py файлом командой >pyopen")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            document, file_path, error = self._extract_document_path(account, reply_to_msg)
            if error:
                params.message = error
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            try:
                code = self._read_python_file(file_path)
                cmd_name = f"File: {self._get_document_filename(document)}"
                params.message = self._execute_code(code, cmd_name)
            except Exception as e:
                params.message = _mz_t(f"Помилка читання файлу: {e}", f"File read error: {e}", f"Ошибка чтения файла: {e}")

            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        return HookResult()