            ),
            Input(
                key="max_output_len",
                text=_mz_t("Ліміт довжини виводу", "Output length limit", "Лимит длины вывода"),
                default=str(max_output_len),
                subtext=_mz_t("Максимальна довжина результату в символах, решта обрізається", "Maximum length of the result in characters, the rest is cut off", "Максимальная длина результата в символах, дальше — обрезается"),
                icon="msg_text",
                on_change=self._on_max_output_len_change,
            ),
            Input(
                key="max_file_size_kb",
                text=_mz_t("Ліміт розміру .py файлу (КБ)", "Size limit for a .py file (KB)", "Лимит размера .py файла (КБ)"),
                default=str(max_file_size_kb),
                subtext=_mz_t("Максимальний розмір файлу для >pyopen", "Maximum file size for >pyopen", "Максимальный размер файла для >pyopen"),
