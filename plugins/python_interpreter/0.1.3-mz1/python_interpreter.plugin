                default=str(timeout_seconds),
                subtext=_mz_t("Якщо код не встиг за цей час, інтерпретатор перестає його чекати (сам код може продовжувати працювати у фоні)", "If the code doesn't finish in this time, the interpreter stops waiting (the code itself may keep running in the background)", "Если код не уложился в это время, интерпретатор перестаёт ждать (сам код может остаться висеть в фоне)"),
                icon="msg_settings",
                on_change=self._on_timeout_change,
            ),
            Divider(),
            Header(text=_mz_t("Ліміти", "Limits", "Лимиты")),
            Input(
                key="max_history",
                text=_mz_t("Ліміт історії", "History limit", "Лимит истории"),
                default=str(max_history),
                subtext=_mz_t("Максимальна кількість команд в історії", "Maximum number of commands in history", "Максимальное количество команд в истории"),
