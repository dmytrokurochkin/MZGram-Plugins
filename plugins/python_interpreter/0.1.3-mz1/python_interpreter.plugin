                default=enable_py,
                icon="msg_settings",
                on_change=self._on_enable_py_change,
            ),
            Switch(
                key="show_traceback",
                text=_mz_t("Показувати повну помилку", "Show the full error", "Показывать полную ошибку"),
                default=show_traceback,
                subtext=_mz_t("Під час помилки буде показано повний traceback", "On error, the full traceback is shown", "При ошибке будет показан полный traceback"),
                icon="msg_info",
                on_change=self._on_show_traceback_change,
            ),
            Input(
                key="timeout_seconds",
