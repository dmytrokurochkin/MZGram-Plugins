    def _flip(self):
        sides = [_mz_t("орел", "heads", "орёл"),_mz_t("решка", "tails", "решка"),_mz_t("монетка стала на ребро!", "the coin landed on its edge!", "монетка встала на ребро!")]
        result = random.choice(sides)
        if sides.index(result) == 2:
            return "🪙 " + result + _mz_t("\nнеймовірно рідкісний результат (1%)", "\nincredibly rare outcome (1%)", "\nневероятно редкий исход (1%)")
        return _mz_t("🪙 результат: ", "🪙 result: ", "🪙 результат: ") + result

    def _slots(self):
        symbols = ["🫐","🍏","🍌","🍓","🍋","🔥","💎","7️⃣","⭐","🍀"]
        r = random.choices(symbols, k=3)
        line = " | ".join(r)
        if r[0] == r[1] == r[2]:
            if r[0] == "7️⃣":
                verdict = _mz_t("мега джекпот!!! 🎰💰", "mega jackpot!!! 🎰💰", "мега джекпот!!! 🎰💰")
            elif r[0] == "💎":
                verdict = _mz_t("діамантовий джекпот! 💎✨", "diamond jackpot! 💎✨", "алмазный джекпот! 💎✨")
            else:
                verdict = _mz_t("джекпот! 🎉", "jackpot! 🎉", "джекпот! 🎉")
        elif r[0]==r[1] or r[1]==r[2] or r[0]==r[2]:
            verdict = _mz_t("два збіги! майже...", "two matches! almost...", "два совпадения! почти...")
        else:
            verdict = _mz_t("немає збігів.", "no matches.", "нет совпадений.")
        return "🎰 [ " + line + " ]\n→ " + verdict

    def _rps(self, args):
        choices = {"к":_mz_t("камінь 🪨", "rock 🪨", "камень 🪨"),"н":_mz_t("ножиці ✂️", "scissors ✂️", "ножницы ✂️"),"б":_mz_t("папір 📄", "paper 📄", "бумага 📄")}
        beats = {"к":"н","н":"б","б":"к"}
        first = args.lower()[:1].replace("п", "б") if args else ""
        uk = first if first in choices else random.choice(list(choices))
        bk = random.choice(list(choices))
        if uk==bk: verdict=_mz_t("нічия! 🤝", "draw! 🤝", "ничья! 🤝")
        elif beats[uk]==bk: verdict=_mz_t("ти переміг! 🏆", "you won! 🏆", "ты победил! 🏆")
        else: verdict=_mz_t("ти програв 😔", "you lost 😔", "ты проиграл 😔")
        return _mz_t("✂️ ти: ", "✂️ you: ", "✂️ ты: ")+choices[uk]+_mz_t("\nбот: ", "\nbot: ", "\nбот: ")+choices[bk]+"\n→ "+verdict

    def _pick(self, args):
        opts = [o.strip() for o in args.split() if o.strip()]
        if not opts:
            return _mz_t("🎯 використовуй: .pick - [...]", "🎯 usage: .pick - [...]", "🎯 используй: .pick - [...]")
        if len(opts) == 1:
            return _mz_t("🎯 лише один варіант? тоді ", "🎯 only one option? then ", "🎯 только один вариант? тогда ") + opts[0]
        return _mz_t("🎯 випало: ", "🎯 picked: ", "🎯 выпало: ") + random.choice(opts)

    def _rng(self, args):
        try:
            nums = list(map(int, args.split()))
            if len(nums)==2: lo,hi=nums
            elif len(nums)==1: lo,hi=1,nums[0]
            else: lo,hi=1,100
        except Exception:
            return _mz_t("🔢 використовуй: .rng - [...]", "🔢 usage: .rng - [...]", "🔢 используй: .rng - [...]")
        if lo>hi: lo,hi=hi,lo
        return "🔢 " + str(random.randint(lo,hi)) + "  [" + str(lo) + " - " + str(hi) + "]"

    def _ball(self, args):
        answers = [
            _mz_t("так, безперечно.", "yes, definitely.", "да, определённо."),_mz_t("без сумнівів.", "no doubt.", "без сомнений."),_mz_t("найімовірніше так.", "most likely yes.", "скорее всего да."),
            _mz_t("запитай пізніше.", "ask again later.", "спроси позже."),_mz_t("не можу передбачити.", "I can't predict that.", "не могу предсказать."),_mz_t("можливо.", "maybe.", "возможно."),
            _mz_t("не розраховуй на це.", "don't count on it.", "не рассчитывай на это."),_mz_t("моя відповідь - ні.", "my answer is no.", "мой ответ - нет."),_mz_t("найімовірніше ні.", "most likely no.", "скорее всего нет."),
            _mz_t("все вказує на так.", "everything points to yes.", "всё указывает на да."),_mz_t("однозначно ні.", "definitely not.", "однозначно нет."),_mz_t("знаки кажуть так.", "the signs say yes.", "знаки говорят да."),
            _mz_t("краще зараз не казати.", "better not to say right now.", "лучше не говорить сейчас."),_mz_t("зосередься і запитай ще раз.", "focus and ask again.", "сосредоточься и спроси снова."),
            _mz_t("це таємниця всесвіту.", "it's a secret of the universe.", "это секрет вселенной."),_mz_t("шанси 50/50, але я на твоєму боці.", "50/50 odds, but I'm on your side.", "шансы 50/50, но я на твоей стороне."),
        ]
        ans = random.choice(answers)
        return "🎱 " + (args + "\n→ " + ans if args else ans)

    def _lucky(self):
        n = random.randint(1,100)
        bar = "█"*(n//10) + "░"*(10 - n//10)
        if n >= 90: msg = _mz_t("🔥 сьогодні твій день! все вийде.", "🔥 today is your day! everything will work out.", "🔥 сегодня твой день! всё получится.")
        elif n >= 70: msg = _mz_t("😊 удача на твоєму боці.", "😊 luck is on your side.", "😊 удача на твоей стороне.")
        elif n >= 40: msg = _mz_t("😐 середній день. без сюрпризів.", "😐 an average day. no surprises.", "😐 средний день. без сюрпризов.")
        elif n >= 20: msg = _mz_t("😬 удача вередує. обережніше.", "😬 luck is acting up. be careful.", "😬 удача капризничает. осторожнее.")
        else: msg = _mz_t("💀 краще сиди вдома і не висовуйся.", "💀 better stay home and keep a low profile.", "💀 лучше сиди дома и не высовывайся.")
        return _mz_t("🍀 удача: ", "🍀 luck: ", "🍀 удача: ") + str(n) + "%\n[" + bar + "]\n" + msg

    def _truth_dare(self):
        return "🎲 " + random.choice(truth_dare)

    def _roulette(self):
        if random.randint(1,6) == 1:
            return _mz_t("💥 бах! ти помер.\n💀 game over", "💥 bang! you died.\n💀 game over", "💥 бах! ты умер.\n💀 game over")
        return _mz_t("🔫 клац... пощастило.\nзалишилось патронів: ", "🔫 click... lucky.\nbullets left: ", "🔫 щёлк... повезло.\nосталось патронов: ") + str(random.randint(1,5))

    def _battle(self, args):
        parts = args.split()
        if len(parts) < 2:
            return _mz_t("⚔️ використовуй: .battle - [...]", "⚔️ usage: .battle - [...]", "⚔️ используй: .battle - [...]")
        a, b = parts[0], parts[1]
        hp_a = random.randint(15, 100)
        hp_b = random.randint(15, 100)
        if hp_a == hp_b:
            hp_a += 1
        winner = a if hp_a > hp_b else b
        loser = b if hp_a > hp_b else a
        return ("⚔️ " + a + " vs " + b + "\n\n"
                + a + ": " + str(hp_a) + " hp\n"
                + b + ": " + str(hp_b) + " hp\n\n"
                + _mz_t("🏆 переможець: ", "🏆 winner: ", "🏆 победитель: ") + winner + "\n"
                + "💀 " + loser + _mz_t(" переможений.", " is defeated.", " повержен."))

    def _game(self):
        return "" + random.choice(["⚽", "🏀", "🎯", "🎳", "🎰", "🎲"])

    def _love(self, args):
        name = args.strip() or _mz_t("він/вона", "he/she", "он/она")
        count = random.randint(5, 11)
        seq = [_mz_t("любить", "loves", "любит") if i % 2 == 0 else _mz_t("не любить", "doesn't love", "не любит") for i in range(count)]
        result = seq[-1]
        return ("🌸 " + name + "\n"
                + " - ".join(seq) + "\n\n"
                + ("💖 " + result + "!" if (count - 1) % 2 == 0 else "💔 " + result + "..."))

    def _ship(self, args):
        parts = args.split()
        if len(parts) < 2:
            return _mz_t("❤️ використовуй: .ship - [...]", "❤️ usage: .ship - [...]", "❤️ используй: .ship - [...]")
        a, b = parts[0], parts[1]
        name = a[:max(1, len(a)//2)] + b[max(1, len(b)//2):]
        score = random.randint(0, 100)
        bar = "❤️" * (score // 20) + "🖤" * (5 - score // 20)
        if score >= 85: c = _mz_t("вогонь. ідеальна пара. 🔥", "fire. perfect match. 🔥", "огонь. абсолютный шип. 🔥")
        elif score >= 60: c = _mz_t("непогано, є хімія.", "not bad, there's chemistry.", "неплохо, есть химия.")
        elif score >= 35: c = _mz_t("сумнівно, але чому б і ні.", "debatable, but why not.", "спорно, но почему бы и нет.")
        else: c = _mz_t("ні. просто ні. 🚫", "no. just no. 🚫", "нет. просто нет. 🚫")
        return ("❤️ " + a + " × " + b + "\n"
                + _mz_t("назва: ", "name: ", "название: ") + name + "\n"
                + bar + " " + str(score) + "%\n" + c)

    def _rarity(self):
        weights = [40, 25, 15, 10, 6, 3, 1]
        rarity, desc = random.choices(rarities, weights=weights, k=1)[0]
        return _mz_t("🎰 твоя рідкість: ", "🎰 your rarity: ", "🎰 твоя редкость: ") + rarity + "\n" + desc

