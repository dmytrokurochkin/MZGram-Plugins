    def _uwu(self, args):
        if not args:
            return _mz_t("🌸 використовуй: .uwu - [...]", "🌸 usage: .uwu - [...]", "🌸 используй: .uwu - [...]")
        t = args
        t = t.replace("р", "ш").replace("Р", "Ш")
        t = t.replace("л", "й").replace("Л", "Й")
        t = t.replace("на", "ня").replace("На", "Ня")
        t = t.replace("не", "ня").replace("Не", "Ня")
        t = t.replace("ни", "ньи").replace("Ни", "Ньи")
        words = t.split()
        result = []
        for w in words:
            result.append(w)
            if random.random() < 0.3:
                result.append(random.choice(["~~", "~", "♡", "•ᴗ•"]))
        text = " ".join(result)
        suffix = random.choice([
            " uwu", " owo", " >w<", " ^w^", " :3", _mz_t(" ням~", " nyaa~", " нюня~"),
            " ♡", " (˘ᵕ˘)", " (◕ᴗ◕✿)", " ~nya", " >.<",
            " (˶˃ᆺ˂˶)", " ✧٩(ˊωˋ*)و✧",
        ])
        if random.random() < 0.4 and words:
            first = words[0]
            text = first[0] + "-" + text if first else text
        out = text + suffix
        if random.random() < 0.4:
            out += " " + random.choice(uwu_extra)
        return out

    def _clap(self, args):
        if not args:
            return _mz_t("👏 використовуй: .clap - [...]", "👏 usage: .clap - [...]", "👏 используй: .clap - [...]")
        return " 👏 ".join(args.split()) + " 👏"

    def _caesar(self, args):
        parts = args.split(maxsplit=1)
        try:
            shift = int(parts[0]) % 26
            text = parts[1] if len(parts) > 1 else ""
            if not text:
                return _mz_t("🔐 використовуй: .caesar - [...]", "🔐 usage: .caesar - [...]", "🔐 используй: .caesar - [...]")
            result = ""
            for ch in text:
                if ch.isalpha():
                    base = ord("A") if ch.isupper() else ord("a")
                    result += chr((ord(ch) - base + shift) % 26 + base)
                else:
                    result += ch
            return "🔐 " + result
        except Exception:
            return _mz_t("🔐 використовуй: .caesar - [...]", "🔐 usage: .caesar - [...]", "🔐 используй: .caesar - [...]")

    def _morse(self, args):
        if not args:
            return _mz_t("📡 використовуй: .morse - [...]", "📡 usage: .morse - [...]", "📡 используй: .morse - [...]")
        result = [morse_enc.get(ch, "?") for ch in args.upper()]
        return "📡 " + " ".join(result)

    def _unmorse(self, args):
        if not args:
            return _mz_t("📡 використовуй: .unmorse - [...]", "📡 usage: .unmorse - [...]", "📡 используй: .unmorse - [...]")
        words = args.strip().split(" / ")
        decoded = []
        for word in words:
            letters = [morse_dec.get(symbol, "?") for symbol in word.strip().split()]
            decoded.append("".join(letters))
        return "📡 " + " ".join(decoded)

    def _repeat(self, args):
        parts = args.split(maxsplit=1)
        if len(parts) < 2:
            return _mz_t("🔁 використовуй: .repeat - [...]", "🔁 usage: .repeat - [...]", "🔁 используй: .repeat - [...]")
        try:
            n = max(1, min(int(parts[0]), 20))
            text = parts[1]
            return "\n".join([text] * n)
        except Exception:
            return _mz_t("🔁 використовуй: .repeat - [...]", "🔁 usage: .repeat - [...]", "🔁 используй: .repeat - [...]")

    def _wc(self, args):
        if not args:
            return _mz_t("📝 використовуй: .wc - [...]", "📝 usage: .wc - [...]", "📝 используй: .wc - [...]")
        words = len(args.split())
        chars = len(args)
        chars_no_space = len(args.replace(" ", ""))
        minutes = max(1, round(words / 200))
        return (_mz_t("📝 слів: ", "📝 words: ", "📝 слов: ") + str(words) + "\n"
                + _mz_t("символів: ", "characters: ", "символов: ") + str(chars) + "\n"
                + _mz_t("символів (без пробілів): ", "characters (no spaces): ", "символов (без пробелов): ") + str(chars_no_space) + "\n"
                + _mz_t("час читання: ~", "reading time: ~", "время чтения: ~") + str(minutes) + _mz_t(" хв.", " min.", " мин."))

    def _fmt_num(self, v):
        if isinstance(v, float) and v.is_integer():
            return str(int(v))
        if isinstance(v, float):
            return str(round(v, 6))
        return str(v)

    def _calc_eval(self, node, steps):
        if isinstance(node, ast.Expression):
            return self._calc_eval(node.body, steps)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in calc_ops:
            left = self._calc_eval(node.left, steps)
            right = self._calc_eval(node.right, steps)
            if isinstance(node.op, ast.Pow) and (abs(right) > 100 or abs(left) > 100000):
                raise ValueError("number is too large")
            result = calc_ops[type(node.op)](left, right)
            sym = calc_symbols[type(node.op)]
            steps.append(self._fmt_num(left) + " " + sym + " " + self._fmt_num(right) + " = " + self._fmt_num(result))
            return result
        if isinstance(node, ast.UnaryOp) and type(node.op) in calc_ops:
            val = self._calc_eval(node.operand, steps)
            return calc_ops[type(node.op)](val)
        raise ValueError("invalid expression")

    def _calc(self, args):
        expr = args.strip()[:200]
        if not expr:
            return _mz_t("🧮 використовуй: .calc - [...]", "🧮 usage: .calc - [...]", "🧮 используй: .calc - [...]")
        try:
            tree = ast.parse(expr, mode="eval")
            steps = []
            value = self._calc_eval(tree, steps)
        except ZeroDivisionError:
            return _mz_t("🧮 на нуль ділити не можна.", "🧮 can't divide by zero.", "🧮 на ноль делить нельзя.")
        except Exception:
            return _mz_t("🧮 не вдалося це порахувати.", "🧮 couldn't calculate that.", "🧮 не получилось это посчитать.")
        value_str = self._fmt_num(value)
        if len(steps) <= 1:
            return "🧮 " + expr + " = " + value_str
        lines = ["🧮 " + expr]
        for i, s in enumerate(steps, 1):
            lines.append(_mz_t("крок ", "step ", "шаг ") + str(i) + ": " + s)
        lines.append(_mz_t("результат: ", "result: ", "результат: ") + value_str)
        return "\n".join(lines)

    def _sqrt(self, args):
        try:
            n = float(args)
            if n < 0:
                return _mz_t("🔢 корінь з від'ємного - комплексне. не сьогодні.", "🔢 square root of a negative is complex. not today.", "🔢 корень из отрицательного - комплексное. не сегодня.")
            return "🔢 √" + str(n) + " = " + str(round(n ** 0.5, 6))
        except Exception:
            return _mz_t("🔢 використовуй: .sqrt - [...]", "🔢 usage: .sqrt - [...]", "🔢 используй: .sqrt - [...]")

    def _pow(self, args):
        parts = args.split()
        try:
            base, exp = float(parts[0]), float(parts[1])
            return "🔢 " + str(base) + "^" + str(exp) + " = " + str(round(base ** exp, 6))
        except Exception:
            return _mz_t("🔢 використовуй: .pow - [...]", "🔢 usage: .pow - [...]", "🔢 используй: .pow - [...]")

    def _fib(self, args):
        try:
            n = min(int(args), 50)
            if n <= 0:
                return _mz_t("🔢 використовуй: .fib - [...]", "🔢 usage: .fib - [...]", "🔢 используй: .fib - [...]")
            a, b = 0, 1
            seq = [0]
            for _ in range(n - 1):
                a, b = b, a + b
                seq.append(a)
            return _mz_t("🔢 фібоначчі (", "🔢 fibonacci (", "🔢 фибоначчи (") + str(n) + "):\n" + " ".join(map(str, seq))
        except Exception:
            return _mz_t("🔢 використовуй: .fib - [...]", "🔢 usage: .fib - [...]", "🔢 используй: .fib - [...]")

    def _text(self, args):
        try:
            n = int(args)
            if n < 2:
                return "🔢 " + str(n) + _mz_t(" - не просте.", " - not prime.", " - не простое.")
            for i in range(2, int(n ** 0.5) + 1):
                if n % i == 0:
                    return "🔢 " + str(n) + _mz_t(" - складене (ділиться на ", " - composite (divisible by ", " - составное (делится на ") + str(i) + ")."
            return "🔢 " + str(n) + _mz_t(" - просте число ✓", " - prime number ✓", " - простое число ✓")
        except Exception:
            return _mz_t("🔢 використовуй: .text - [...]", "🔢 usage: .text - [...]", "🔢 используй: .text - [...]")

    def _binary(self, args):
        try:
            n = int(args.strip())
            return "🔢 " + str(n) + " → " + bin(n)[2:] + " (bin)"
        except Exception:
            return _mz_t("🔢 використовуй: .binary - [...]", "🔢 usage: .binary - [...]", "🔢 используй: .binary - [...]")

    def _tohex(self, args):
        try:
            n = int(args.strip())
            return "🔢 " + str(n) + " → " + hex(n)[2:].upper() + " (hex)"
        except Exception:
            return _mz_t("🔢 використовуй: .hex - [...]", "🔢 usage: .hex - [...]", "🔢 используй: .hex - [...]")

    def _roman(self, args):
        try:
            n = int(args.strip())
            if not 1 <= n <= 3999:
                return _mz_t("🔢 число має бути від 1 до 3999", "🔢 the number must be from 1 to 3999", "🔢 число должно быть от 1 до 3999")
            vals = [(1000,"M"),(900,"CM"),(500,"D"),(400,"CD"),(100,"C"),(90,"XC"),
                    (50,"L"),(40,"XL"),(10,"X"),(9,"IX"),(5,"V"),(4,"IV"),(1,"I")]
            result = ""
            for v, r in vals:
                while n >= v:
                    result += r
                    n -= v
            return "🔢 " + args.strip() + " → " + result
        except Exception:
            return _mz_t("🔢 використовуй: .roman - [...]", "🔢 usage: .roman - [...]", "🔢 используй: .roman - [...]")

    def _split(self, args):
        parts = args.split()
        try:
            total = float(parts[0])
            people = int(parts[1])
            if people <= 0:
                return _mz_t("➗ кількість людей має бути більше 0", "➗ the number of people must be greater than 0", "➗ количество людей должно быть больше 0")
            per = total / people
            return (_mz_t("➗ рахунок: ", "➗ bill: ", "➗ счёт: ") + str(total) + _mz_t(" грн.\n", " rub.\n", " руб.\n")
                    + _mz_t("люди: ", "people: ", "люди: ") + str(people) + "\n"
                    + _mz_t("кожен платить: ", "each pays: ", "каждый платит: ") + str(round(per, 2)) + _mz_t(" грн.", " rub.", " руб."))
        except Exception:
            return _mz_t("➗ використовуй: .split - [...]", "➗ usage: .split - [...]", "➗ используй: .split - [...]")

    def _bmi(self, args):
        parts = args.split()
        try:
            weight = float(parts[0])
            height = float(parts[1])
            if height > 3:
                height = height / 100
            bmi = weight / (height ** 2)
            bmi_r = round(bmi, 1)
            if bmi < 18.5: cat = _mz_t("дефіцит ваги 🔵", "underweight 🔵", "дефицит веса 🔵")
            elif bmi < 25: cat = _mz_t("норма 🟢", "normal 🟢", "норма 🟢")
            elif bmi < 30: cat = _mz_t("надлишкова вага 🟡", "overweight 🟡", "избыточный вес 🟡")
            elif bmi < 35: cat = _mz_t("ожиріння i 🟠", "obesity i 🟠", "ожирение i 🟠")
            else: cat = _mz_t("ожиріння ii+ 🔴", "obesity ii+ 🔴", "ожирение ii+ 🔴")
            return _mz_t("⚖️ ІМТ: ", "⚖️ BMI: ", "⚖️ имт: ") + str(bmi_r) + "\n" + cat
        except Exception:
            return _mz_t("⚖️ використовуй: .bmi - [...]", "⚖️ usage: .bmi - [...]", "⚖️ используй: .bmi - [...]")

    def _days(self, args):
        try:
            target = datetime.strptime(args.strip(), "%d.%m.%Y").date()
            today = date.today()
            delta = (target - today).days
            if delta > 0:
                return _mz_t("📅 до ", "📅 until ", "📅 до ") + args.strip() + _mz_t(" залишилось ", ", ", " осталось ") + str(delta) + _mz_t(" дн.", " days left", " дн.")
            elif delta < 0:
                return _mz_t("📅 з ", "📅 since ", "📅 с ") + args.strip() + _mz_t(" минуло ", ", ", " прошло ") + str(abs(delta)) + _mz_t(" дн.", " days ago", " дн.")
            else:
                return _mz_t("📅 це сьогодні! 🎉", "📅 that's today! 🎉", "📅 это сегодня! 🎉")
        except Exception:
            return _mz_t("📅 використовуй: .days - [...]", "📅 usage: .days - [...]", "📅 используй: .days - [...]")

    def _temp(self, args):
        parts = args.split()
        try:
            val = float(parts[0])
            unit = parts[1].lower() if len(parts) > 1 else "c"
            if unit in ("c", "с", "°c"):
                f = val * 9/5 + 32
                k = val + 273.15
                return ("🌡️ " + str(val) + "°c\n"
                        + "= " + str(round(f, 2)) + "°f\n"
                        + "= " + str(round(k, 2)) + "k")
            elif unit in ("f", "°f"):
                c = (val - 32) * 5/9
                k = c + 273.15
                return ("🌡️ " + str(val) + "°f\n"
                        + "= " + str(round(c, 2)) + "°c\n"
                        + "= " + str(round(k, 2)) + "k")
            elif unit in ("k", "к"):
                c = val - 273.15
                f = c * 9/5 + 32
                return ("🌡️ " + str(val) + "k\n"
                        + "= " + str(round(c, 2)) + "°c\n"
                        + "= " + str(round(f, 2)) + "°f")
            else:
                return _mz_t("🌡️ вкажи одиницю: c, f або k", "🌡️ specify a unit: c, f or k", "🌡️ укажи единицу: c, f или k")
        except Exception:
            return _mz_t("🌡️ використовуй: .temp - [...]", "🌡️ usage: .temp - [...]", "🌡️ используй: .temp - [...]")

    def _pass(self, args):
        try:
            length = min(max(4, int(args)), 64) if args else 12
        except Exception:
            length = 12
        letters = string.ascii_letters
        digits = string.digits
        symbols = "!@#$%&*"
        pool = letters + digits + symbols
        pwd_chars = [random.choice(letters), random.choice(digits), random.choice(symbols)]
        pwd_chars += [random.choice(pool) for _ in range(length - len(pwd_chars))]
        random.shuffle(pwd_chars)
        return _mz_t("🔑 пароль: ", "🔑 password: ", "🔑 пароль: ") + "".join(pwd_chars)

