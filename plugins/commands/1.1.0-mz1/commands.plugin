truth_dare = [
    _mz_t("правда: який твій найдивніший страх?", "truth: what's your weirdest fear?", "правда: какой твой самый странный страх?"),
    _mz_t("правда: яку останню дурницю ти шукав в інтернеті?", "truth: what's the last silly thing you searched for online?", "правда: какую последнюю глупость ты искал в интернете?"),
    _mz_t("правда: якби міг стати невидимкою на годину, що б зробив?", "truth: if you could be invisible for an hour, what would you do?", "правда: если бы мог стать невидимкой на час, что бы сделал?"),
    _mz_t("правда: кого з чату ти взяв би з собою на безлюдний острів?", "truth: who from the chat would you take to a desert island?", "правда: кого из чата ты бы взял с собой на необитаемый остров?"),
    _mz_t("правда: який найсоромніший момент трапився з тобою в школі?", "truth: what's the most embarrassing thing that happened to you at school?", "правда: какой самый стыдный момент произошёл с тобой в школе?"),
    _mz_t("правда: кому з чату ти б не довірив свій телефон?", "truth: who from the chat wouldn't you trust with your phone?", "правда: кому из чата ты бы не доверил свой телефон?"),
    _mz_t("правда: що ти робиш, коли ніхто не бачить?", "truth: what do you do when nobody's looking?", "правда: что ты делаешь когда никто не видит?"),
    _mz_t("правда: хто тобі подобається просто зараз?", "truth: who do you like right now?", "правда: кто тебе нравится прямо сейчас?"),
    _mz_t("правда: що тебе реально дратує в людях, але ти мовчиш?", "truth: what really annoys you about people, but you keep quiet?", "правда: что тебя реально раздражает в людях, но ты молчишь?"),
    _mz_t("правда: що ти шукаєш в інтернеті, коли думаєш, що ніхто не бачить?", "truth: what do you search for online when you think nobody's looking?", "правда: что ты ищешь в интернете, когда думаешь что никто не видит?"),
    _mz_t("правда: чи є в тебе секрет, який ти нікому не розкажеш?", "truth: do you have a secret you'll never tell anyone?", "правда: есть ли у тебя секрет, который ты не расскажешь никому?"),
    _mz_t("правда: найдивніше, що ти їв?", "truth: what's the weirdest thing you've ever eaten?", "правда: самое странное, что ты ел?"),
    _mz_t("правда: ти коли-небудь брехав другові прямо в обличчя?", "truth: have you ever lied to a friend's face?", "правда: ты когда-нибудь врал другу прямо в лицо?"),
    _mz_t("правда: якби тобі дали мільйон, на що витратив би першим ділом?", "truth: if you were given a million, what would you spend it on first?", "правда: если бы тебе дали миллион, куда бы потратил первым делом?"),
    _mz_t("правда: яка твоя улюблена образа?", "truth: what's your favorite insult?", "правда: какое твоё любимое оскорбление?"),
    _mz_t("дія: надішли в чат останній збережений мем.", "dare: send the last meme you saved to the chat.", "действие: отправь в чат последний сохранённый мем."),
    _mz_t("дія: напиши повідомлення лише за допомогою емодзі.", "dare: write a message using only emoji.", "действие: напиши сообщение только с помощью эмодзи."),
    _mz_t("дія: надішли голосове повідомлення з будь-яким звуком тварини.", "dare: send a voice message with any animal sound.", "действие: отправь голосовое сообщение с любым звуком животного."),
    _mz_t("дія: похвали людину, яка написала повідомлення перед тобою.", "dare: compliment the person who wrote the message before you.", "действие: похвали человека, который написал сообщение перед тобой."),
    _mz_t("дія: постав у профіль найсмішніший емодзі на 10 хвилин.", "dare: set the funniest emoji in your profile for 10 minutes.", "действие: поставь в профиль самый смешной эмодзи на 10 минут."),
    _mz_t("дія: напиши одне речення, використовуючи лише слова на літеру «п».", "dare: write one sentence using only words that start with the letter \"p\".", "действие: напиши одно предложение, используя только слова на букву «п»."),
    _mz_t("дія: зміни ім'я в тг на випадкове на 10 хвилин.", "dare: change your name in tg to a random one for 10 minutes.", "действие: поменяй имя в тг на случайное на 10 минут."),
    _mz_t("дія: напиши наступні 3 повідомлення лише великими літерами.", "dare: write your next 3 messages in capital letters only.", "действие: напиши следующие 3 сообщения только заглавными буквами."),
    _mz_t("дія: надішли фото того, що зараз у тебе на столі.", "dare: send a photo of what's on your desk right now.", "действие: отправь фото того, что сейчас у тебя на столе."),
    _mz_t("дія: напиши міні-вірш про чат, просто зараз, будь-який.", "dare: write a mini poem about the chat right now, any poem.", "действие: напиши мини-стих про чат, прямо сейчас, любой."),
    _mz_t("дія: напиши комплімент кожному учаснику чату.", "dare: write a compliment to every chat member.", "действие: напиши комплимент каждому участнику чата."),
    _mz_t("дія: зізнайся в коханні своєму улюбленому персонажу.", "dare: confess your love to your favorite character.", "действие: признайся в любви к своему любимому персонажу."),
    _mz_t("дія: надішли голосове: вимов будь-яку фразу голосом робота.", "dare: send a voice message: say any phrase in a robot voice.", "действие: отправь голосовое - произнеси любую фразу голосом робота."),
]


dere_types = [
    (_mz_t("цундере 🔥", "tsundere 🔥", "цундере 🔥"),_mz_t("зовні холодний і грубий, але всередині добрий і дбайливий.", "cold and rude on the outside, but kind and caring inside.", "снаружи холодный и грубый, но внутри добрый и заботливый."),_mz_t("«я зробив це не заради тебе, зрозумів?! просто так вийшло!»", "\"I didn't do it for you, got it?! it just happened!\"", "«я сделал это не ради тебя, понял?! просто так получилось!»")),
    (_mz_t("яндере 🔪", "yandere 🔪", "яндере 🔪"),_mz_t("шалено закоханий і готовий на все заради об'єкта прихильності.", "madly in love and ready to do anything for the object of affection.", "безумно влюблён и готов пойти на всё ради объекта привязанности."),_mz_t("«я нікому тебе не віддам. нікому.»", "\"I won't give you to anyone. anyone.\"", "«я никому тебя не отдам. никому.»")),
    (_mz_t("кудере 🧊", "kuudere 🧊", "кудере 🧊"),_mz_t("холодний, мовчазний, майже без емоцій.", "cold, silent, almost without emotions.", "холодный, молчаливый, почти без эмоций."),"«...»"),
    (_mz_t("дандере 🌸", "dandere 🌸", "дандере 🌸"),_mz_t("тихий і сором'язливий, але з близькими дуже відкритий.", "quiet and shy, but very open with people close to them.", "тихий и застенчивый, но с близкими очень открытый."),_mz_t("«а-а... п-привіт...»", "\"u-um... h-hi...\"", "«а-а... п-привет...»")),
    (_mz_t("камідере 👑", "kamidere 👑", "камидере 👑"),_mz_t("вважає себе кращим за всіх. зарозумілий, але харизматичний.", "thinks they're better than everyone. arrogant, but charismatic.", "считает себя лучше всех. высокомерный, но харизматичный."),_mz_t("«стань гідним мене, тоді поговоримо.»", "\"become worthy of me, then we'll talk.\"", "«стань достоин меня - тогда поговорим.»")),
    (_mz_t("дередере 💖", "deredere 💖", "дередере 💖"),_mz_t("постійно закоханий, всюди бачить романтику, обожнює всіх навколо.", "always in love, sees romance everywhere, adores everyone around.", "постоянно влюблён, везде видит романтику, обожает всех вокруг."),_mz_t("«ти такий класний!! я тебе обожнюю!!»", "\"you're so cool!! I adore you!!\"", "«ты такой классный!! я тебя обожаю!!»")),
    (_mz_t("хяндере 😭", "hyandere 😭", "хяндере 😭"),_mz_t("весь час плаче або майже плаче.", "cries or almost cries all the time.", "всё время плачет или почти плачет."),_mz_t("«пробач... я просто... знову розплакався...»", "\"sorry... I just... started crying again...\"", "«прости... я просто... снова расплакался...»")),
    (_mz_t("бокодере 🙈", "bokodere 🙈", "бокодере 🙈"),_mz_t("закоханий, але не вміє це показати. червоніє й тікає.", "in love, but can't show it. blushes and runs away.", "влюблён, но не умеет это показать. краснеет и убегает."),_mz_t("«я... ні, нічого... вибач... йду.»", "\"I... no, nothing... sorry... I'm leaving.\"", "«я... нет, ничего... извини... ухожу.»")),
    (_mz_t("садодере 😈", "sadodere 😈", "садодере 😈"),_mz_t("отримує задоволення від того, щоб дражнити інших.", "enjoys teasing others.", "получает удовольствие от того, чтобы дразнить других."),_mz_t("«о, ти почервонів? як мило. ще раз?»", "\"oh, you blushed? how cute. again?\"", "«о, ты покраснел? как мило. ещё раз?»")),
    (_mz_t("хікікоморі-дере 🏠", "hikikomori-dere 🏠", "хикикомори-дере 🏠"),_mz_t("не виходить із кімнати, але в інтернеті душа компанії.", "never leaves the room, but online is the life of the party.", "не выходит из комнаты, но в интернете - душа компании."),_mz_t("«онлайн = ок. реальне життя = ні.»", "\"online = ok. real life = no.\"", "«онлайн = ок. реальная жизнь = нет.»")),
    (_mz_t("маядере ⚔️", "mayadere ⚔️", "маядере ⚔️"),_mz_t("спочатку був проти, але перейшов на бік героя.", "was against the hero at first, but switched sides.", "изначально был против, но перешёл на сторону героя."),_mz_t("«не думай, що я тебе пробачив. просто ти не такий поганий.»", "\"don't think I forgave you. you're just not that bad.\"", "«не думай, что я тебя простил. просто ты не такой плохой.»")),
    (_mz_t("уредере 🌙", "uredere 🌙", "уредере 🌙"),_mz_t("заздрить, але щиро захоплюється.", "is jealous, but sincerely admires.", "завидует, но искренне восхищается."),_mz_t("«ненавиджу тебе за те, який ти... і захоплююся цим.»", "\"I hate you for being who you are... and I admire it.\"", "«ненавижу тебя за то, какой ты... и восхищаюсь этим.»")),
]

tarot_cards = [
    (_mz_t("блазень 0", "the fool 0", "шут 0"),_mz_t("нові починання і спонтанність. стрибай: крила з'являться в польоті.", "new beginnings and spontaneity. jump: wings will appear in flight.", "новые начинания и спонтанность. прыгай - крылья появятся в полёте.")),
    (_mz_t("маг i", "the magician i", "маг i"),_mz_t("сила волі й ресурси вже під рукою. дій.", "willpower and resources are already at hand. act.", "сила воли и ресурсы уже под рукой. действуй.")),
    (_mz_t("верховна жриця ii", "the high priestess ii", "верховная жрица ii"),_mz_t("інтуїція й приховані знання. довіряй собі.", "intuition and hidden knowledge. trust yourself.", "интуиция и скрытые знания. доверяй себе.")),
    (_mz_t("колесо фортуни x", "wheel of fortune x", "колесо фортуны x"),_mz_t("зміни неминучі. готуйся.", "change is inevitable. get ready.", "перемены неизбежны. готовься.")),
    (_mz_t("вежа xvi", "the tower xvi", "башня xvi"),_mz_t("різкі зміни. все впаде, і це нормально.", "sudden change. everything will collapse, and that's fine.", "резкие перемены. всё рухнет - и это нормально.")),
    (_mz_t("зірка xvii", "the star xvii", "звезда xvii"),_mz_t("надія і натхнення. все буде.", "hope and inspiration. everything will be fine.", "надежда и вдохновение. всё будет.")),
    (_mz_t("місяць xviii", "the moon xviii", "луна xviii"),_mz_t("ілюзії й страхи. не все є тим, чим здається.", "illusions and fears. not everything is what it seems.", "иллюзии и страхи. не всё то, чем кажется.")),
    (_mz_t("сонце xix", "the sun xix", "солнце xix"),_mz_t("радість і ясність. вдалий день.", "joy and clarity. a good day.", "радость и ясность. удачный день.")),
    (_mz_t("світ xxi", "the world xxi", "мир xxi"),_mz_t("завершення циклу. ти впорався.", "the end of a cycle. you did it.", "завершение цикла. ты справился.")),
    (_mz_t("смерть xiii", "death xiii", "смерть xiii"),_mz_t("кінець одного - початок іншого. не бійся.", "the end of one thing is the start of another. don't be afraid.", "конец одного - начало другого. не бойся.")),
    (_mz_t("диявол xv", "the devil xv", "дьявол xv"),_mz_t("ти сам створюєш свої обмеження.", "you create your own limits.", "ты сам создаёшь свои ограничения.")),
    (_mz_t("закохані vi", "the lovers vi", "влюблённые vi"),_mz_t("вибір і гармонія. серце знає відповідь.", "choice and harmony. the heart knows the answer.", "выбор и гармония. сердце знает ответ.")),
]

rarities = [
    (_mz_t("звичайний 🩶", "common 🩶", "обычный 🩶"),_mz_t("таких мільйони. ти один із них.", "there are millions like that. you're one of them.", "таких миллионы. ты один из них.")),
    (_mz_t("незвичайний 🟢", "uncommon 🟢", "необычный 🟢"),_mz_t("трохи вище за середнє. вже непогано.", "a bit above average. not bad already.", "чуть выше среднего. уже неплохо.")),
    (_mz_t("рідкісний 🔵", "rare 🔵", "редкий 🔵"),_mz_t("рідкість. більшість на тебе не заслуговує.", "a rarity. most people don't deserve you.", "редкость. большинство тебя не заслуживает.")),
