"""Smart Bookmark: single-file exteraGram plugin, Python 3.11, SDK 1.4.4.3.

Storage/validation is platform-independent. Android imports are intentionally lazy.
No hooks observe messages: only the explicit message-menu action reads a message.
"""
# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import contextlib
import datetime as dt
import json
import os
import re
import sqlite3
import tempfile
import time
import unicodedata
import uuid
from concurrent.futures import ThreadPoolExecutor

__id__ = "smart_bookmark"
__name__ = "Smart Bookmark"
__description__ = "Personal notes and tasks for chats, stored locally and never forwarded"
__version__ = "1.3-mz1"
__app_version__ = ">=12.10.6"
__category__ = ["chats", "tools"]
__sdk_version__ = ">=1.4.4.3"
__author__ = "MZGram"
__icon__ = "SmartBookmark/0"

DEFAULT_CATEGORIES = ("Работа", "Личное", "Важное", "Документы", "Идеи",
                      "Покупки", "Прочитать позже")
MAX_BACKUP_BYTES = 32 * 1024 * 1024
MAX_BOOKMARKS_IMPORT = 100000
PAGE_SIZE = 30
SORTS = (_mz_t("Спочатку нові", "Newest first", "Сначала новые"), _mz_t("Спочатку старі", "Oldest first", "Сначала старые"), _mz_t("За назвою", "By title", "По названию"), _mz_t("За категорією", "By category", "По категории"))
NOTE_STATES = (_mz_t("Нотатка", "Note", "Заметка"), _mz_t("До виконання", "To do", "К выполнению"), _mz_t("Виконано", "Done", "Выполнено"))
RECORD_COLORS = (
    ("none", _mz_t("Без виділення", "No highlight", "Без выделения"), None), ("red", _mz_t("Червоний", "Red", "Красный"), 0xFFE05263),
    ("orange", _mz_t("Помаранчевий", "Orange", "Оранжевый"), 0xFFE49A32), ("green", _mz_t("Зелений", "Green", "Зелёный"), 0xFF37A875),
    ("blue", _mz_t("Синій", "Blue", "Синий"), 0xFF488BDE), ("purple", _mz_t("Фіолетовий", "Purple", "Фиолетовый"), 0xFF9B72D7),
)
COLOR_LABELS = {key: title for key, title, _ in RECORD_COLORS}
COLOR_VALUES = {key: value for key, _, value in RECORD_COLORS}
FIELD_NAMES = {"account_slot": _mz_t("номер акаунта", "account number", "номер аккаунта"), "account_user_id": _mz_t("власник акаунта", "account owner", "владелец аккаунта"),
               "dialog_id": _mz_t("ID діалогу", "dialog ID", "ID диалога"), "message_id": _mz_t("ID повідомлення", "message ID", "ID сообщения"), "topic_id": _mz_t("ID теми", "topic ID", "ID темы"),
               "saved_at": _mz_t("дата збереження", "saved date", "дата сохранения"), "updated_at": _mz_t("дата зміни", "modified date", "дата изменения"), "title": _mz_t("назва", "title", "название"),
               "text": _mz_t("текст", "text", "текст"), "note": _mz_t("нотатка", "note", "заметка"), "sender": _mz_t("відправник", "sender", "отправитель"), "chat": _mz_t("чат", "chat", "чат"),
               "category": _mz_t("категорія", "category", "категория"), "status": _mz_t("стан нотатки", "note state", "состояние заметки"), "body": _mz_t("текст нотатки", "note text", "текст заметки")}


class BookmarkError(Exception):
    """A safe, Russian, user-facing error without message contents."""


def fold(value):
    return unicodedata.normalize("NFKC", str(value or "")).casefold()


def text_value(value, name, limit, empty=True):
    name = FIELD_NAMES.get(name, name)
    if not isinstance(value, str) or len(value) > limit or "\x00" in value:
        raise BookmarkError(_mz_t("Некоректне поле: ", "Invalid field: ", "Некорректное поле: ") + name)
    value = value.strip()
    if not empty and not value:
        raise BookmarkError(_mz_t("Заповніть поле: ", "Fill in the field: ", "Заполните поле: ") + name)
    return value


def tags_value(value):
    if isinstance(value, str):
        value = re.split(r"[\s,;]+", value.strip())
    if not isinstance(value, list) or len(value) > 100:
        raise BookmarkError(_mz_t("Дозволено не більше 100 тегів.", "No more than 100 tags are allowed.", "Допустимо не более 100 тегов."))
    result = []
    for tag in value:
        tag = fold(text_value(tag, _mz_t("тег", "tag", "тег"), 81)).lstrip("#")
        if not tag:
            continue
        if len(tag) > 80 or re.search(r"[\s,;#]", tag):
            raise BookmarkError(_mz_t("Тег не може містити пробіли, коми або # всередині.", "A tag can't contain spaces, commas or # inside.", "Тег не должен содержать пробелы, запятые или # внутри."))
        if tag not in result:
            result.append(tag)
    return sorted(result)


def integer(value, name, low, high):
    if type(value) is not int or not low <= value <= high:
        raise BookmarkError(_mz_t("Некоректне поле: ", "Invalid field: ", "Некорректное поле: ") + FIELD_NAMES.get(name, name))
    return value


def validate_color(value):
    if not isinstance(value, str) or value not in COLOR_LABELS:
        raise BookmarkError(_mz_t("Невідомий колір виділення.", "Unknown highlight color.", "Неизвестный цвет выделения."))
    return value


def validate_bookmark(data):
    if not isinstance(data, dict):
        raise BookmarkError(_mz_t("Закладка має бути об'єктом JSON.", "A bookmark must be a JSON object.", "Закладка должна быть объектом JSON."))
    out = {}
    for key, low, high in (
        ("account_slot", 0, 99), ("account_user_id", 1, 2**63 - 1),
        ("dialog_id", -(2**63) + 1, 2**63 - 1),
        ("message_id", -(2**31) + 1, 2**31 - 1),
        ("topic_id", 0, 2**63 - 1), ("saved_at", 1, 253402300799),
        ("updated_at", 1, 253402300799),
    ):
        out[key] = integer(data.get(key), key, low, high)
    if not out["dialog_id"] or not out["message_id"]:
        raise BookmarkError(_mz_t("Немає ідентифікатора повідомлення або діалогу.", "The message or dialog ID is missing.", "Отсутствует идентификатор сообщения или диалога."))
    for key, limit, empty in (
        ("title", 300, False), ("text", 65536, True), ("note", 16384, True),
        ("sender", 500, True), ("chat", 500, True), ("category", 100, False),
    ):
        out[key] = text_value(data.get(key), key, limit, empty)
    if data.get("peer_kind") not in ("user", "group", "channel", "secret"):
        raise BookmarkError(_mz_t("Невідомий тип діалогу.", "Unknown dialog type.", "Неизвестный тип диалога."))
    out["peer_kind"] = data["peer_kind"]
    out["tags"] = tags_value(data.get("tags"))
    out["color"] = validate_color(data.get("color", "none"))
    return out


def validate_note(data):
    if not isinstance(data, dict):
        raise BookmarkError(_mz_t("Некоректна нотатка.", "Invalid note.", "Некорректная заметка."))
    out = {}
    uid = data.get("uid")
    if not isinstance(uid, str) or not re.fullmatch(r"[0-9a-f]{32}", uid):
        raise BookmarkError(_mz_t("Некоректний ID нотатки.", "Invalid note ID.", "Некорректный ID заметки."))
    out["uid"] = uid
    for key, low, high in (("account_slot", 0, 99), ("account_user_id", 1, 2**63 - 1),
                           ("dialog_id", -(2**63) + 1, 2**63 - 1),
                           ("saved_at", 1, 253402300799), ("updated_at", 1, 253402300799),
                           ("status", 0, 2)):
        out[key] = integer(data.get(key), key, low, high)
    for key, limit, empty in (("title", 300, False), ("body", 16384, False), ("chat", 500, True)):
        out[key] = text_value(data.get(key), _mz_t("текст нотатки", "note text", "текст заметки") if key == "body" else key, limit, empty)
    if type(data.get("pinned")) is not bool:
        raise BookmarkError(_mz_t("Некоректна ознака закріплення нотатки.", "Invalid note pin flag.", "Некорректный признак закрепления заметки."))
    out["pinned"] = data["pinned"]
    out["color"] = validate_color(data.get("color", "none"))
    out["source"] = None if data.get("source") is None else validate_bookmark(data["source"])
    source = out["source"]
    if source and (source["account_user_id"] != out["account_user_id"] or source["dialog_id"] != out["dialog_id"]):
        raise BookmarkError(_mz_t("Джерело нотатки належить іншому чату або акаунту.", "The note source belongs to another chat or account.", "Источник заметки принадлежит другому чату или аккаунту."))
    return out


def validate_backup(data):
    if not isinstance(data, dict) or data.get("format") != "smart_bookmark":
        raise BookmarkError(_mz_t("Це не резервна копія Smart Bookmark.", "This is not a Smart Bookmark backup.", "Это не резервная копия Smart Bookmark."))
    if type(data.get("schema")) is not int or data["schema"] not in (1, 2, 3):
        raise BookmarkError(_mz_t("Версія резервної копії не підтримується.", "This backup version is not supported.", "Версия резервной копии не поддерживается."))
    cats, records = data.get("categories"), data.get("bookmarks")
    if not isinstance(cats, list) or len(cats) > 10000:
        raise BookmarkError(_mz_t("Некоректний список категорій.", "Invalid category list.", "Некорректный список категорий."))
    if not isinstance(records, list) or len(records) > MAX_BOOKMARKS_IMPORT:
        raise BookmarkError(_mz_t("Некоректний або завеликий список закладок.", "The bookmark list is invalid or too large.", "Некорректный или слишком большой список закладок."))
    categories = []
    for cat in cats:
        if not isinstance(cat, dict) or type(cat.get("builtin")) is not bool:
            raise BookmarkError(_mz_t("Некоректна категорія.", "Invalid category.", "Некорректная категория."))
        name = text_value(cat.get("name"), _mz_t("категорія", "category", "категория"), 100, False)
        if name not in categories:
            categories.append(name)
    # Validate EVERYTHING before offering confirmation or starting a transaction.
    bookmarks = [validate_bookmark(record) for record in records]
    notes = data.get("notes") if data["schema"] >= 2 else []
    if not isinstance(notes, list) or len(notes) + len(bookmarks) > MAX_BOOKMARKS_IMPORT:
        raise BookmarkError(_mz_t("Некоректний або завеликий список нотаток.", "The note list is invalid or too large.", "Некорректный или слишком большой список заметок."))
    return {"categories": categories, "bookmarks": bookmarks, "notes": [validate_note(n) for n in notes]}


def read_backup(path):
    try:
        with open(path, "rb") as stream:
            raw = stream.read(MAX_BACKUP_BYTES + 1)
        if len(raw) > MAX_BACKUP_BYTES:
            raise BookmarkError(_mz_t("Файл перевищує допустимі 32 МБ.", "The file exceeds the 32 MB limit.", "Файл превышает допустимые 32 МБ."))
        return validate_backup(json.loads(raw.decode("utf-8-sig")))
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise BookmarkError(_mz_t("Не вдалося прочитати структуру JSON.", "Couldn't read the JSON structure.", "Не удалось прочитать структуру JSON.")) from exc


def write_backup(path, data):
    """Atomic local export; does not include settings or authorization data."""
    directory = os.path.dirname(os.path.abspath(path))
    fd, temporary = tempfile.mkstemp(prefix=".smart-bookmark-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.flush()
            os.fsync(stream.fileno())
        if os.path.getsize(temporary) > MAX_BACKUP_BYTES:
            raise BookmarkError(_mz_t("Експорт перевищує 32 МБ. Розділіть колекцію перед перенесенням.", "The export exceeds 32 MB. Split the collection before moving it.", "Экспорт превышает 32 МБ. Разделите коллекцию перед переносом."))
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.remove(temporary)


class BookmarkStore:
    """Short-lived SQLite connections, transactions, FK and unique identity.

    Corrupt databases fail closed: never rename/delete/reinitialize user data.
    The UI executes all these methods on a dedicated serial worker.
    """
    COLUMNS = ("account_slot", "account_user_id", "dialog_id", "message_id",
               "topic_id", "saved_at", "updated_at", "title", "text", "note",
               "sender", "chat", "category", "peer_kind", "color")

    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.skipped_records = 0
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        try:
            with self.connection() as db:
                if db.execute("PRAGMA quick_check").fetchone()[0] != "ok":
                    raise BookmarkError(_mz_t("База пошкоджена. Вихідний файл збережено, відновіть копію окремо.", "The database is corrupted. The original file is kept; restore a backup separately.", "База повреждена. Исходный файл сохранён; восстановите копию отдельно."))
                version = db.execute("PRAGMA user_version").fetchone()[0]
                if version not in (0, 1, 2, 3):
                    raise BookmarkError(_mz_t("Базу створено новішою версією плагіна.", "The database was created by a newer plugin version.", "База создана более новой версией плагина."))
                db.execute("PRAGMA journal_mode=WAL")
                db.executescript("""
                    BEGIN IMMEDIATE;
                    CREATE TABLE IF NOT EXISTS categories (
                        name TEXT PRIMARY KEY, builtin INTEGER NOT NULL DEFAULT 0);
                    CREATE TABLE IF NOT EXISTS bookmarks (
                        id INTEGER PRIMARY KEY,
                        account_slot INTEGER NOT NULL, account_user_id INTEGER NOT NULL,
                        dialog_id INTEGER NOT NULL, message_id INTEGER NOT NULL,
                        topic_id INTEGER NOT NULL, saved_at INTEGER NOT NULL,
                        updated_at INTEGER NOT NULL, title TEXT NOT NULL,
                        text TEXT NOT NULL, note TEXT NOT NULL, sender TEXT NOT NULL,
                        chat TEXT NOT NULL,
                        category TEXT NOT NULL REFERENCES categories(name) ON UPDATE CASCADE,
                        peer_kind TEXT NOT NULL,
                        UNIQUE(account_user_id, dialog_id, message_id));
                    CREATE TABLE IF NOT EXISTS bookmark_tags (
                        bookmark_id INTEGER NOT NULL REFERENCES bookmarks(id) ON DELETE CASCADE,
                        tag TEXT NOT NULL, PRIMARY KEY(bookmark_id, tag));
                    CREATE INDEX IF NOT EXISTS bookmarks_saved ON bookmarks(saved_at, id);
                    CREATE INDEX IF NOT EXISTS bookmarks_category ON bookmarks(category);
                    CREATE INDEX IF NOT EXISTS tags_lookup ON bookmark_tags(tag, bookmark_id);
                    CREATE TABLE IF NOT EXISTS notes (
                        uid TEXT NOT NULL, account_user_id INTEGER NOT NULL,
                        account_slot INTEGER NOT NULL, dialog_id INTEGER NOT NULL,
                        chat TEXT NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL,
                        status INTEGER NOT NULL CHECK(status BETWEEN 0 AND 2),
                        pinned INTEGER NOT NULL CHECK(pinned IN (0,1)),
                        saved_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
                        source_json TEXT NOT NULL, PRIMARY KEY(uid,account_user_id));
                    CREATE INDEX IF NOT EXISTS notes_scope ON notes(account_user_id,dialog_id,status);
                    CREATE INDEX IF NOT EXISTS notes_order ON notes(pinned DESC,updated_at DESC);
                    COMMIT;
                """)
                # Add presentation fields without replacing or rewriting old records.
                db.execute("BEGIN IMMEDIATE")
                for table in ("bookmarks", "notes"):
                    columns = {row[1] for row in db.execute("PRAGMA table_info(" + table + ")")}
                    if "color" not in columns:
                        db.execute("ALTER TABLE " + table + " ADD COLUMN color TEXT NOT NULL DEFAULT 'none'")
                db.execute("PRAGMA user_version=3")
                db.executemany("INSERT OR IGNORE INTO categories VALUES (?,1)",
                               [(name,) for name in DEFAULT_CATEGORIES])
        except sqlite3.DatabaseError as exc:
            raise BookmarkError(_mz_t("Не вдалося відкрити базу. Файли не видалено; перевірте пам'ять або відновіть копію окремо.", "Couldn't open the database. No files were deleted; check storage or restore a backup separately.", "Не удалось открыть базу. Файлы не удалены; проверьте память или восстановите копию отдельно.")) from exc

    @contextlib.contextmanager
    def connection(self):
        db = sqlite3.connect(self.path, timeout=5)
        db.row_factory = sqlite3.Row
        db.create_function("sb_fold", 1, fold, deterministic=True)
        try:
            db.execute("PRAGMA foreign_keys=ON")
            db.execute("PRAGMA synchronous=FULL")
            with db:
                yield db
        finally:
            db.close()

    def categories(self):
        with self.connection() as db:
            return [dict(row) for row in db.execute(
                "SELECT name,builtin FROM categories ORDER BY builtin DESC,sb_fold(name)")]

    def category_add(self, name):
        name = text_value(name, _mz_t("категорія", "category", "категория"), 100, False)
        with self.connection() as db:
            if db.execute("SELECT 1 FROM categories WHERE sb_fold(name)=?", (fold(name),)).fetchone():
                raise BookmarkError(_mz_t("Така категорія вже існує.", "This category already exists.", "Такая категория уже существует."))
            db.execute("INSERT INTO categories VALUES (?,0)", (name,))

    def category_rename(self, old, new):
        new = text_value(new, _mz_t("категорія", "category", "категория"), 100, False)
        with self.connection() as db:
            if not db.execute("SELECT 1 FROM categories WHERE name=? AND builtin=0", (old,)).fetchone():
                raise BookmarkError(_mz_t("Вбудовану категорію не можна перейменувати.", "A built-in category can't be renamed.", "Встроенную категорию нельзя переименовать."))
            if db.execute("SELECT 1 FROM categories WHERE sb_fold(name)=? AND name<>?",
                          (fold(new), old)).fetchone():
                raise BookmarkError(_mz_t("Така категорія вже існує.", "This category already exists.", "Такая категория уже существует."))
            db.execute("UPDATE categories SET name=? WHERE name=?", (new, old))

    def category_delete(self, name, destination="Личное"):
        with self.connection() as db:
            if not db.execute("SELECT 1 FROM categories WHERE name=? AND builtin=0", (name,)).fetchone():
                raise BookmarkError(_mz_t("Вбудовану категорію не можна видалити.", "A built-in category can't be deleted.", "Встроенную категорию нельзя удалить."))
            if name == destination or not db.execute("SELECT 1 FROM categories WHERE name=?", (destination,)).fetchone():
                raise BookmarkError(_mz_t("Виберіть іншу наявну категорію.", "Choose another existing category.", "Выберите другую существующую категорию."))
            db.execute("UPDATE bookmarks SET category=? WHERE category=?", (destination, name))
            db.execute("DELETE FROM categories WHERE name=?", (name,))

    def _row(self, db, row):
        value = dict(row)
        value["tags"] = [r[0] for r in db.execute(
            "SELECT tag FROM bookmark_tags WHERE bookmark_id=? ORDER BY tag", (row["id"],))]
        try:
            clean = validate_bookmark(value)
            clean["id"] = row["id"]
            return clean
        except BookmarkError:
            self.skipped_records += 1
            return None

    def get(self, bookmark_id):
        with self.connection() as db:
            row = db.execute("SELECT * FROM bookmarks WHERE id=?", (bookmark_id,)).fetchone()
            return self._row(db, row) if row else None

    def find(self, owner, dialog, message):
        with self.connection() as db:
            row = db.execute("SELECT * FROM bookmarks WHERE account_user_id=? AND dialog_id=? AND message_id=?",
                             (owner, dialog, message)).fetchone()
            return self._row(db, row) if row else None

    def _insert(self, db, data):
        db.execute("INSERT OR IGNORE INTO categories VALUES (?,0)", (data["category"],))
        cursor = db.execute("INSERT OR IGNORE INTO bookmarks (" + ",".join(self.COLUMNS) +
                            ") VALUES (" + ",".join("?" for _ in self.COLUMNS) + ")",
                            [data[key] for key in self.COLUMNS])
        added = cursor.rowcount == 1
        row = db.execute("SELECT id FROM bookmarks WHERE account_user_id=? AND dialog_id=? AND message_id=?",
                         (data["account_user_id"], data["dialog_id"], data["message_id"])).fetchone()
        if added:
            db.executemany("INSERT INTO bookmark_tags VALUES (?,?)", [(row[0], tag) for tag in data["tags"]])
        return row[0], added

    def save(self, data):
        data = validate_bookmark(data)
        with self.connection() as db:
            db.execute("BEGIN IMMEDIATE")
            return self._insert(db, data)

    def edit(self, bookmark_id, title, category, tags, note, color=None):
        title = text_value(title, _mz_t("назва", "title", "название"), 300, False)
        category = text_value(category, _mz_t("категорія", "category", "категория"), 100, False)
        note = text_value(note, _mz_t("нотатка", "note", "заметка"), 16384)
        tags = tags_value(tags)
        if color is not None:
            color = validate_color(color)
        with self.connection() as db:
            db.execute("BEGIN IMMEDIATE")
            row = db.execute("SELECT color FROM bookmarks WHERE id=?", (bookmark_id,)).fetchone()
            if not row:
                raise BookmarkError(_mz_t("Закладку вже видалено.", "The bookmark was already deleted.", "Закладка уже удалена."))
            if not db.execute("SELECT 1 FROM categories WHERE name=?", (category,)).fetchone():
                raise BookmarkError(_mz_t("Категорію вже видалено. Виберіть іншу.", "The category was already deleted. Choose another one.", "Категория уже удалена. Выберите другую."))
            db.execute("UPDATE bookmarks SET title=?,category=?,note=?,updated_at=?,color=? WHERE id=?",
                       (title, category, note, int(time.time()), row[0] if color is None else color, bookmark_id))
            db.execute("DELETE FROM bookmark_tags WHERE bookmark_id=?", (bookmark_id,))
            db.executemany("INSERT INTO bookmark_tags VALUES (?,?)", [(bookmark_id, tag) for tag in tags])

    def delete(self, bookmark_id):
        with self.connection() as db:
            db.execute("DELETE FROM bookmarks WHERE id=?", (bookmark_id,))

    def clear(self):
        with self.connection() as db:
            db.execute("DELETE FROM bookmarks")

    def count(self):
        with self.connection() as db:
            return db.execute("SELECT count(*) FROM bookmarks").fetchone()[0]

    def tags(self, prefix="", limit=100):
        with self.connection() as db:
            return [r[0] for r in db.execute(
                "SELECT DISTINCT tag FROM bookmark_tags WHERE substr(tag,1,?)=? ORDER BY tag LIMIT ?",
                (len(fold(prefix).lstrip("#")), fold(prefix).lstrip("#"), limit))]

    def query(self, search="", category=None, tags=None, sort=0, offset=0, limit=PAGE_SIZE):
        conditions, args = [], []
        # All whitespace-separated words must match; each may match a different field.
        for word in fold(search).split()[:30]:
            conditions.append("(instr(sb_fold(b.title||' '||b.text||' '||b.note||' '||b.category||' '||b.chat),?)>0 "
                              "OR EXISTS(SELECT 1 FROM bookmark_tags t WHERE t.bookmark_id=b.id AND instr(t.tag,?)>0))")
            args.extend([word, word.lstrip("#")])
        if category:
            conditions.append("b.category=?")
            args.append(category)
        for tag in tags_value(tags or []):
            conditions.append("EXISTS(SELECT 1 FROM bookmark_tags t WHERE t.bookmark_id=b.id AND t.tag=?)")
            args.append(tag)
        where = " WHERE " + " AND ".join(conditions) if conditions else ""
        orders = ("b.saved_at DESC,b.id DESC", "b.saved_at,b.id", "sb_fold(b.title),b.id",
                  "sb_fold(b.category),sb_fold(b.title),b.id")
        order = orders[sort] if type(sort) is int and 0 <= sort < len(orders) else orders[0]
        with self.connection() as db:
            count = db.execute("SELECT count(*) FROM bookmarks b" + where, args).fetchone()[0]
            rows = db.execute("SELECT b.* FROM bookmarks b" + where + " ORDER BY " + order + " LIMIT ? OFFSET ?",
                              args + [min(max(limit, 1), 100), max(offset, 0)]).fetchall()
            result = [self._row(db, row) for row in rows]
            return [row for row in result if row is not None], count

    NOTE_COLUMNS = ("uid", "account_user_id", "account_slot", "dialog_id", "chat", "title", "body",
                    "status", "pinned", "saved_at", "updated_at", "source_json", "color")

    def _note_row(self, row):
        value = dict(row)
        try:
            value["source"] = json.loads(value.pop("source_json"))
            if value["pinned"] not in (0, 1):
                raise BookmarkError(_mz_t("Некоректна нотатка.", "Invalid note.", "Некорректная заметка."))
            value["pinned"] = bool(value["pinned"])
            return validate_note(value)
        except (BookmarkError, ValueError, TypeError, RecursionError):
            self.skipped_records += 1
            return None

    def _insert_note(self, db, note):
        data = dict(note, source_json=json.dumps(note["source"], ensure_ascii=False))
        return db.execute("INSERT INTO notes (" + ",".join(self.NOTE_COLUMNS) + ") VALUES (" +
                          ",".join("?" for _ in self.NOTE_COLUMNS) + ") ON CONFLICT(uid,account_user_id) DO NOTHING",
                          [data[k] for k in self.NOTE_COLUMNS]).rowcount == 1

    def save_note(self, note, editing=False):
        note = validate_note(note)
        with self.connection() as db:
            db.execute("BEGIN IMMEDIATE")
            if not editing:
                if not self._insert_note(db, note):
                    raise BookmarkError(_mz_t("Ця нотатка вже існує. Відкрийте її зі списку.", "This note already exists. Open it from the list.", "Эта заметка уже существует. Откройте её из списка."))
            else:
                result = db.execute("UPDATE notes SET title=?,body=?,status=?,pinned=?,updated_at=?,color=? "
                    "WHERE uid=? AND account_user_id=?",
                    (note["title"], note["body"], note["status"], note["pinned"], note["updated_at"], note["color"],
                     note["uid"], note["account_user_id"]))
                if result.rowcount != 1:
                    raise BookmarkError(_mz_t("Нотатку вже видалено. Чернетку залишено відкритою.", "The note was already deleted. The draft is left open.", "Заметка уже удалена. Черновик оставлен открытым."))

    def note_get(self, uid, owner):
        with self.connection() as db:
            row = db.execute("SELECT * FROM notes WHERE uid=? AND account_user_id=?", (uid, owner)).fetchone()
            return self._note_row(row) if row else None

    def note_action(self, uid, owner, action):
        with self.connection() as db:
            if action == "delete":
                db.execute("DELETE FROM notes WHERE uid=? AND account_user_id=?", (uid, owner))
                return
            expressions = {"pin": "pinned=1-pinned", "done": "status=CASE WHEN status=2 THEN 1 ELSE 2 END"}
            if action not in expressions:
                raise BookmarkError(_mz_t("Невідома дія з нотаткою.", "Unknown note action.", "Неизвестное действие с заметкой."))
            if db.execute("UPDATE notes SET " + expressions[action] + ",updated_at=? WHERE uid=? AND account_user_id=?",
                          (int(time.time()), uid, owner)).rowcount != 1:
                raise BookmarkError(_mz_t("Нотатку вже видалено.", "The note was already deleted.", "Заметка уже удалена."))

    def clear_notes(self):
        with self.connection() as db:
            db.execute("DELETE FROM notes")

    def set_color(self, kind, key, owner, color):
        color = validate_color(color)
        if kind not in ("bookmark", "note"):
            raise BookmarkError(_mz_t("Невідомий тип запису.", "Unknown entry type.", "Неизвестный тип записи."))
        table, column = ("bookmarks", "id") if kind == "bookmark" else ("notes", "uid")
        with self.connection() as db:
            if db.execute("UPDATE " + table + " SET color=?,updated_at=? WHERE " + column + "=? AND account_user_id=?",
                          (color, int(time.time()), key, owner)).rowcount != 1:
                raise BookmarkError(_mz_t("Запис вже видалено або він належить іншому акаунту.", "The entry was already deleted or belongs to another account.", "Запись уже удалена или принадлежит другому аккаунту."))

    def notes_query(self, owner=None, dialog=None, search="", status=None, offset=0):
        conditions, args = [], []
        if dialog is not None and owner is None:
            raise BookmarkError(_mz_t("Для фільтра чату потрібен акаунт.", "The chat filter needs an account.", "Для фильтра чата нужен аккаунт."))
        if owner is not None:
            conditions.append("account_user_id=?")
            args.append(owner)
        if dialog is not None:
            conditions.append("dialog_id=?")
            args.append(dialog)
        if status is not None:
            conditions.append("status=?")
            args.append(integer(status, _mz_t("статус", "status", "статус"), 0, 2))
        for word in fold(search).split()[:30]:
            conditions.append("instr(sb_fold(title||' '||body||' '||chat),?)>0")
            args.append(word)
        where = " WHERE " + " AND ".join(conditions) if conditions else ""
        with self.connection() as db:
            total = db.execute("SELECT count(*) FROM notes" + where, args).fetchone()[0]
            rows = db.execute("SELECT * FROM notes" + where +
                " ORDER BY pinned DESC,updated_at DESC,uid LIMIT ? OFFSET ?", args + [PAGE_SIZE, max(0, offset)]).fetchall()
            return [note for row in rows if (note := self._note_row(row)) is not None], total

    def export_data(self):
        with self.connection() as db:
            db.execute("BEGIN")  # One consistent snapshot, including categories/tags.
            cats = [{"name": row[0], "builtin": bool(row[1])} for row in db.execute(
                "SELECT name,builtin FROM categories ORDER BY name")]
            records = []
            for row in db.execute("SELECT * FROM bookmarks ORDER BY id"):
                record = self._row(db, row)
                if record is not None:
                    record.pop("id", None)
                    records.append(record)
            notes = [note for row in db.execute("SELECT * FROM notes ORDER BY uid,account_user_id")
                     if (note := self._note_row(row)) is not None]
            return {"format": "smart_bookmark", "schema": 3, "version": __version__,
                    "exported_at": int(time.time()), "categories": cats, "bookmarks": records, "notes": notes}

    def import_data(self, prepared):
        # Revalidate even if called outside the normal preview flow.
        data = validate_backup({"format": "smart_bookmark", "schema": 3,
                                "categories": [{"name": n, "builtin": False} for n in prepared["categories"]],
                                "bookmarks": prepared["bookmarks"], "notes": prepared.get("notes", [])})
        added = 0
        with self.connection() as db:
            db.execute("BEGIN IMMEDIATE")
            db.executemany("INSERT OR IGNORE INTO categories VALUES (?,0)", [(n,) for n in data["categories"]])
            for record in data["bookmarks"]:
                added += int(self._insert(db, record)[1])
            for note in data["notes"]:
                added += int(self._insert_note(db, note))
        return added, len(data["bookmarks"]) + len(data["notes"]) - added


def choose_account(record, accounts):
    """Resolve stable Telegram owner ID, not a possibly reassigned slot number."""
    for slot, owner in accounts:
        if owner == record["account_user_id"]:
            return slot
    raise BookmarkError(_mz_t("Акаунт цієї закладки не підключено. Увійдіть у відповідний акаунт Telegram.", "The account of this bookmark is not connected. Sign in to the matching Telegram account.", "Аккаунт этой закладки не подключён. Войдите в соответствующий аккаунт Telegram."))


def original_available(messages, record):
    """Shared, testable response policy. Empty/deleted messages aren't navigable."""
    return any(mid == record["message_id"] and not empty for mid, empty in messages)


def display_date(timestamp):
    try:
        return dt.datetime.fromtimestamp(timestamp).strftime("%d.%m.%Y %H:%M")
    except (ValueError, OverflowError, OSError):
        return _mz_t("Дата невідома", "Unknown date", "Дата неизвестна")


# Only the official SDK is imported at module initialization.
from base_plugin import BasePlugin, MenuItemData, MenuItemType


class SmartBookmarkPlugin(BasePlugin):
    def on_plugin_load(self):
        self._alive = True
        self._epoch = object()
        self._navigation_epoch = object()
        self._store = None
        self._storage_error = None
        self._count = 0
        self._categories = list(DEFAULT_CATEGORIES)
        self._menus = []
        self._dialogs = []
        self._requests = []
        self._pending_document = None
        self._worker = ThreadPoolExecutor(max_workers=1, thread_name_prefix="smart-bookmark")
        self._sync_menus()
        self._setup_documents()
        self._job(self._initialize, self._initialized, require_store=False)

    def _initialize(self):
        from file_utils import get_files_dir
        path = os.path.join(str(get_files_dir()), "smart_bookmark", "bookmarks.sqlite3")
        store = BookmarkStore(path)
        return store, store.count(), [c["name"] for c in store.categories()]

    def _initialized(self, result):
        self._store, self._count, self._categories = result

    def on_plugin_unload(self):
        self._alive = False
        self._pending_document = None
        self._worker.shutdown(wait=False, cancel_futures=True)
        self._cancel_requests()
        dialogs = self._dialogs[:]
        self._dialogs.clear()
        def close_dialogs():
            for dialog in dialogs:
                try:
                    dialog.dismiss()
                except Exception:
                    pass
        self._ui(close_dialogs)
        # SDK removes menus and the single activity-result hook automatically.

    def _cancel_requests(self):
        self._icon_loading = False
        for manager, request in self._requests:
            try:
                manager.cancelRequest(request, True)
            except Exception:
                pass
        self._requests.clear()

    def _enabled(self):
        return self._alive and self.get_setting("feature_enabled", True)

    def _sync_menus(self, *_):
        for item in self._menus:
            self.remove_menu_item(item)
        self._menus = []
        if not self._enabled():
            return
        for menu_type, text, callback, icon in (
            (MenuItemType.MESSAGE_CONTEXT_MENU, _mz_t("Додати нотатку", "Add note", "Добавить заметку"), self._note_message_click, "msg_edit"),
            (MenuItemType.DRAWER_MENU, _mz_t("Мої нотатки", "My notes", "Мои заметки"), lambda c: self.open_notes(), "msg_edit"),
            (MenuItemType.DRAWER_MENU, _mz_t("Мої закладки", "My bookmarks", "Мои закладки"), lambda c: self.open_manager(), "msg_saved"),
            (MenuItemType.CHAT_ACTION_MENU, _mz_t("Мої нотатки", "My notes", "Мои заметки"), self._chat_notes_click, "msg_edit"),
        ):
            # MAIN_MENU and DRAWER_MENU both feed the drawer on some builds.
            # Register only DRAWER_MENU; settings provide a second entry point.
            item = self.add_menu_item(MenuItemData(menu_type=menu_type, text=text, on_click=callback, icon=icon))
            if item:
                self._menus.append(item)
        # The old capture flow is opt-in, not another Saved Messages menu by default.
        if self.get_setting("legacy_bookmark_menu", False):
            item = self.add_menu_item(MenuItemData(menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text=_mz_t("Додати в закладки", "Add to bookmarks", "Добавить в закладки"), on_click=self._message_click, icon="msg_saved"))
            if item:
                self._menus.append(item)

    def _toggle(self, value):
        self.set_setting("feature_enabled", bool(value))
        self._sync_menus()
        if not value:
            self._navigation_epoch = object()
            self._cancel_requests()
            for dialog in self._dialogs[:]:
                dialog.dismiss()
            self._pending_document = None

    def _job(self, work, done=None, require_store=True, on_error=None):
        if not self._alive:
            return
        epoch = self._epoch

        def run():
            try:
                if not self._alive or self._epoch is not epoch:
                    return
                if require_store and self._store is None:
                    raise BookmarkError(self._storage_error or _mz_t("База ще завантажується. Спробуйте за кілька секунд.", "The database is still loading. Try again in a few seconds.", "База ещё загружается. Попробуйте через несколько секунд."))
                result = work()
                if self._store is not None:
                    count = self._store.count()
                    categories = [c["name"] for c in self._store.categories()]
                else:
                    count, categories = self._count, self._categories
                def finish():
                    if self._alive and self._epoch is epoch:
                        self._count, self._categories = count, categories
                        if done:
                            self._guard(lambda: done(result))
                self._ui(finish)
            except Exception as exc:
                message = str(exc) if isinstance(exc, BookmarkError) else _mz_t("Помилка читання або запису. Перевірте вільне місце та резервну копію.", "Read or write error. Check free space and your backup.", "Ошибка чтения или записи. Проверьте свободное место и резервную копию.")
                if not require_store:
                    self._storage_error = message
                # Never log text, notes, filenames selected by the user or raw RPC errors.
                self.log("Smart Bookmark: " + type(exc).__name__)
                def failed():
                    if self._alive and self._epoch is epoch:
                        self._notice(message)
                        if on_error:
                            self._guard(on_error)
                self._ui(failed)
        self._worker.submit(run)

    @staticmethod
    def _ui(fn, delay=0):
        from android_utils import run_on_ui_thread
        run_on_ui_thread(fn, delay)

    def _guard(self, fn):
        try:
            if self._alive:
                return fn()
        except Exception as exc:
            self.log("Smart Bookmark UI: " + type(exc).__name__)
            self._notice(str(exc) if isinstance(exc, BookmarkError) else _mz_t("Дія недоступна в цій версії застосунку.", "This action is not available in this app version.", "Действие недоступно в этой версии приложения."))

    @staticmethod
    def _activity():
        from client_utils import get_last_fragment
        fragment = get_last_fragment()
        if fragment is None or fragment.getParentActivity() is None:
            raise BookmarkError(_mz_t("Немає активного вікна. Відкрийте список чатів і повторіть.", "No active window. Open the chat list and try again.", "Нет активного окна. Откройте список чатов и повторите."))
        return fragment.getParentActivity()

    def _notice(self, text):
        from android.widget import Toast
        try:
            Toast.makeText(self._activity(), text, Toast.LENGTH_LONG).show()
        except Exception:
            self.log("Smart Bookmark: notification unavailable")

    def _dialog(self, title):
        from ui.alert import AlertDialogBuilder
        dialog = AlertDialogBuilder(self._activity())
        dialog.set_title(title)
        self._dialogs.append(dialog)
        def released(_):
            if dialog in self._dialogs:
                self._dialogs.remove(dialog)
        dialog.set_on_dismiss_listener(released)
        return dialog

    def _choices(self, title, items, callback):
        dialog = self._dialog(title)
        def selected(b, index):
            b.dismiss()
            self._guard(lambda: callback(int(index)))
        dialog.set_items(items, selected)
        dialog.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda b, w: b.dismiss())
        dialog.show()

    def _confirm(self, title, message, callback):
        dialog = self._dialog(title)
        dialog.set_message(message)
        def yes(b, w):
            b.dismiss()
            self._guard(callback)
        dialog.set_positive_button(_mz_t("Продовжити", "Continue", "Продолжить"), yes)
        dialog.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda b, w: b.dismiss())
        dialog.show()

    @staticmethod
    def _color(key):
        from org.telegram.ui.ActionBar import Theme
        return Theme.getColor(getattr(Theme, key))

    def _layout(self, padding=12):
        from android.widget import LinearLayout
        from org.telegram.messenger import AndroidUtilities
        layout = LinearLayout(self._activity())
        layout.setOrientation(1)
        padding = AndroidUtilities.dp(padding)
        layout.setPadding(padding, padding, padding, padding)
        layout.setBackgroundColor(self._color("key_dialogBackground"))
        return layout

    def _row(self, parent):
        row = self._layout(0)
        row.setOrientation(0)
        parent.addView(row)
        return row

    @staticmethod
    def _blend(background, foreground, amount):
        color = sum(round(((background >> shift) & 255) * (1 - amount) +
                          ((foreground >> shift) & 255) * amount) << shift
                    for shift in (0, 8, 16, 24))
        return color - 2**32 if color >= 2**31 else color

    def _surface(self, view, accent=False, danger=False, interactive=False, color="none"):
        from android.graphics.drawable import GradientDrawable, StateListDrawable
        base = self._color("key_dialogBackground")
        custom = COLOR_VALUES.get(color)
        highlighted = accent or danger or custom is not None
        ink = custom if custom is not None and not danger else self._color(
            "key_text_RedBold" if danger else ("key_dialogTextBlue" if accent else "key_dialogTextGray2"))
        def drawable(pressed=False):
            shape = GradientDrawable()
            shape.setCornerRadius(float(self._dp(12)))
            shape.setColor(self._blend(base, ink, 0.22 if pressed else (0.14 if highlighted else 0.06)))
            shape.setStroke(self._dp(2 if custom is not None else 1), self._blend(base, ink, 0.65 if custom is not None else
                                                                                      (0.20 if highlighted else 0.12)))
            return shape
        if interactive:
            background = StateListDrawable()
            background.addState([16842919], drawable(True))  # android.R.attr.state_pressed
            background.addState([], drawable())
        else:
            background = drawable()
        view.setBackground(background)

    def _sections(self, parent, active, switch):
        row = self._row(parent)
        buttons = {}
        for key, title in (("notes", _mz_t("Нотатки", "Notes", "Заметки")), ("bookmarks", _mz_t("Закладки", "Bookmarks", "Закладки"))):
            button = self._button(row, title, lambda section=key: switch(section), primary=key == active, compact=True)
            button.setEnabled(key != active)
            button.setContentDescription(title + (_mz_t(": поточний розділ", ": current section", ": текущий раздел") if key == active else _mz_t(": відкрити розділ", ": open section", ": открыть раздел")))
            buttons[key] = button
        return buttons

    def _pick_color(self, selected, callback):
        choices = [("✓ " if key == selected else "") + title for key, title, _ in RECORD_COLORS]
        self._choices(_mz_t("Колір виділення", "Highlight color", "Цвет выделения"), choices, lambda index: callback(RECORD_COLORS[index][0]))

    def _color_field(self, parent, record):
        def chosen(color):
            record["color"] = color
            button.setText(_mz_t("Колір: ", "Color: ", "Цвет: ") + COLOR_LABELS[color] + " ▾")
            self._surface(button, color=color, interactive=True)
        button = self._button(parent, _mz_t("Колір: ", "Color: ", "Цвет: ") + COLOR_LABELS.get(record.get("color", "none"), _mz_t("Без виділення", "No highlight", "Без выделения")) + " ▾",
                              lambda: self._pick_color(record.get("color", "none"), chosen))
        self._surface(button, color=record.get("color", "none"), interactive=True)
        return button

    def _change_color(self, record, kind, refresh):
        key = record["id"] if kind == "bookmark" else record["uid"]
        def selected(color):
            self._job(lambda: self._store.set_color(kind, key, record["account_user_id"], color), lambda _: refresh())
        self._pick_color(record.get("color", "none"), selected)

    def _heading(self, layout, text):
        from android.graphics import Typeface
        view = self._label(layout, text)
        view.setTextSize(14)
        view.setTypeface(Typeface.DEFAULT_BOLD)
        view.setPadding(self._dp(4), self._dp(14), self._dp(4), self._dp(6))
        return view

    def _label(self, layout, text, secondary=False):
        from android.widget import TextView
        from org.telegram.messenger import AndroidUtilities
        view = TextView(self._activity())
        view.setText(str(text))
        view.setTextSize(13 if secondary else 16)
        view.setTextColor(self._color("key_dialogTextGray2" if secondary else "key_dialogTextBlack"))
        p = AndroidUtilities.dp(5)
        view.setPadding(p, p, p, p)
        layout.addView(view)
        return view

    def _button(self, layout, text, callback, primary=False, danger=False, compact=False):
        from android_utils import OnClickListener
        from android.widget import LinearLayout
        from android.text import TextUtils
        view = self._label(layout, text)
        view.setTextSize(14 if compact else 15)
        view.setTextColor(self._color("key_text_RedBold" if danger else "key_dialogTextBlue"))
        view.setMinHeight(self._dp(44 if compact else 48))
        view.setGravity(17)  # Gravity.CENTER
        view.setPadding(self._dp(12), self._dp(10), self._dp(12), self._dp(10))
        if compact:
            view.setMaxLines(1)
            view.setEllipsize(TextUtils.TruncateAt.END)
        params = LinearLayout.LayoutParams(0, -2, 1.0) if compact else LinearLayout.LayoutParams(-1, -2)
        params.setMargins(self._dp(3), self._dp(4), self._dp(3), self._dp(4))
        view.setLayoutParams(params)
        self._surface(view, accent=primary, danger=danger, interactive=True)
        view.setOnClickListener(OnClickListener(lambda v: self._guard(callback)))
        return view

    def _chip_state(self, view, active):
        self._surface(view, accent=active, interactive=True)

    def _watch_text(self, field, callback):
        from java import dynamic_proxy
        from android.text import TextWatcher
        if not hasattr(self, "_text_watcher_type"):
            class TextListener(dynamic_proxy(TextWatcher)):
                def __init__(self, callback):
                    super().__init__()
                    self.callback = callback

                def beforeTextChanged(self, text, start, count, after):
                    pass

                def onTextChanged(self, text, start, before, count):
                    pass

                def afterTextChanged(self, editable):
                    self.callback()
            self._text_watcher_type = TextListener
        field.addTextChangedListener(self._text_watcher_type(lambda: self._guard(callback)))

    @staticmethod
    def _dp(value):
        from org.telegram.messenger import AndroidUtilities
        return AndroidUtilities.dp(value)

    def _input(self, layout, hint, value="", multiline=False):
        from android.widget import EditText
        from android.text import InputType
        view = EditText(self._activity())
        view.setText(str(value))
        view.setHint(hint)
        view.setTextSize(16)
        view.setTextColor(self._color("key_dialogTextBlack"))
        view.setHintTextColor(self._color("key_dialogTextHint"))
        view.setSingleLine(not multiline)
        view.setInputType(InputType.TYPE_CLASS_TEXT | (InputType.TYPE_TEXT_FLAG_MULTI_LINE if multiline else 0))
        view.setMinHeight(self._dp(48))
        view.setPadding(self._dp(12), self._dp(10), self._dp(12), self._dp(10))
        view.setGravity(51 if multiline else 19)  # TOP|LEFT / CENTER_VERTICAL|LEFT
        self._surface(view)
        if multiline:
            view.setMinLines(2)
            view.setMaxLines(5)
        layout.addView(view)
        return view

    def _scroll(self, layout, height=None):
        from android.widget import ScrollView
        scroll = ScrollView(self._activity())
        scroll.addView(layout)
        return scroll

    def _prompt(self, title, value, callback, positive=_mz_t("Зберегти", "Save", "Сохранить"), helper=""):
        layout = self._layout()
        if helper:
            self._label(layout, helper, True)
        field = self._input(layout, title, value)
        dialog = self._dialog(title)
        dialog.set_view(layout)
        def save(b, w):
            text = str(field.getText())
            b.dismiss()
            self._guard(lambda: callback(text))
        dialog.set_positive_button(positive, save)
        dialog.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda b, w: b.dismiss())
        dialog.show()

    def _message_click(self, context):
        if not self._enabled():
            return
        self._guard(lambda: self._capture(context))

    def _capture(self, context, as_note=False):
        from org.telegram.messenger import UserConfig, MessagesController, DialogObject
        message = context.get("message")
        if message is None:
            raise BookmarkError(_mz_t("Виберіть одне повідомлення.", "Select one message.", "Выберите одно сообщение."))
        account = int(message.currentAccount)
        config = UserConfig.getInstance(account)
        if not config.isClientActivated():
            raise BookmarkError(_mz_t("Акаунт не підключено.", "The account is not connected.", "Аккаунт не подключён."))
        controller = MessagesController.getInstance(account)
        dialog_id = int(message.getDialogId())
        owner = message.messageOwner
        peer = owner.peer_id
        kind = "user"
        if peer is not None and int(peer.channel_id) != 0:
            kind = "channel"
        elif peer is not None and int(peer.chat_id) != 0:
            kind = "group"
        if DialogObject.isEncryptedDialog(dialog_id):
            kind = "secret"
        chat_name = ""
        is_forum = False
        if kind in ("channel", "group"):
            chat = controller.getChat(-dialog_id)
            chat_name = str(chat.title) if chat is not None else ""
            is_forum = chat is not None and bool(chat.forum)
        elif kind == "user":
            chat_name = self._user_name(controller.getUser(dialog_id))
        sender = ""
        source = owner.from_id
        if source is not None:
            if int(source.user_id):
                sender = self._user_name(controller.getUser(int(source.user_id)))
            elif int(source.channel_id):
                user_chat = controller.getChat(int(source.channel_id))
                sender = str(user_chat.title) if user_chat is not None else ""
        text = str(owner.message or "")
        if not text:
            text = str(message.messageText or "")
        topic = 0
        # getTopicId() also returns Saved Messages subdialog IDs on recent clients.
        # Only real forum topics belong in the navigation thread field.
        if is_forum:
            try:
                topic = max(0, int(message.getTopicId()))
            except Exception:
                reply = owner.reply_to
                if reply is not None and bool(reply.forum_topic):
                    topic = int(reply.reply_to_top_id or reply.reply_to_msg_id)
        now = int(time.time())
        category = self.get_setting("default_category", "Личное")
        if category not in self._categories:
            category = "Личное"
        record = validate_bookmark({
            "account_slot": account, "account_user_id": int(config.getClientUserId()),
            "dialog_id": dialog_id, "message_id": int(message.getId()), "topic_id": topic,
            "peer_kind": kind, "title": " ".join(text.split())[:100] or _mz_t("Повідомлення з вкладенням", "Message with attachment", "Сообщение с вложением"),
            "text": text[:65536], "sender": sender[:500], "chat": chat_name[:500],
            "category": category, "tags": [], "note": "", "saved_at": now, "updated_at": now,
        })
        if as_note:
            self._note_editor(self._new_note(record, source=record))
            return
        self._job(lambda: self._store.find(record["account_user_id"], dialog_id, record["message_id"]),
                  lambda existing: self._duplicate(existing) if existing else self._editor(record))

    @staticmethod
    def _user_name(user):
        if user is None:
            return ""
        return (str(user.first_name or "") + " " + str(user.last_name or "")).strip()

    def _duplicate(self, record):
        self._choices(_mz_t("Повідомлення вже збережено", "Message already saved", "Сообщение уже сохранено"), [_mz_t("Відкрити закладку", "Open bookmark", "Открыть закладку"), _mz_t("Видалити із закладок", "Remove from bookmarks", "Удалить из закладок")],
                      lambda i: self._details(record) if i == 0 else self._delete(record))

    def _editor(self, record, on_saved=None):
        record = dict(record)
        layout = self._layout()
        self._label(layout, record["chat"] or _mz_t("Повідомлення Telegram", "Telegram message", "Сообщение Telegram"), True)
        self._heading(layout, _mz_t("Назва закладки", "Bookmark title", "Название закладки"))
        title = self._input(layout, _mz_t("Наприклад, договір із клієнтом", "For example, client contract", "Например, договор с клиентом"), record["title"])
        self._color_field(layout, record)
        selected = [record["category"]]
        def choose_category():
            choices = self._categories[:]
            self._choices(_mz_t("Категорія", "Category", "Категория"), choices, lambda i: set_category(choices[i]))
        self._heading(layout, _mz_t("Категорія", "Category", "Категория"))
        cat = self._button(layout, selected[0] + "  ▾", choose_category)
        def set_category(name):
            selected[0] = name
            cat.setText(name + "  ▾")
        self._heading(layout, _mz_t("Теги · необов'язково", "Tags · optional", "Теги · необязательно"))
        tags = self._input(layout, _mz_t("#договір #клієнт", "#contract #client", "#договор #клиент"), " ".join("#" + t for t in record["tags"]))
        self._label(layout, _mz_t("Розділяйте теги пробілом або комою.", "Separate tags with a space or comma.", "Разделяйте теги пробелом или запятой."), True)
        suggestions = self._layout(0)
        layout.addView(suggestions)
        self._button(layout, _mz_t("Вибрати з моїх тегів", "Choose from my tags", "Выбрать из моих тегов"), lambda: self._tag_suggestions(tags))
        self._heading(layout, _mz_t("Особиста нотатка · необов'язково", "Personal note · optional", "Личная заметка · необязательно"))
        note = self._input(layout, _mz_t("Що важливо запам'ятати?", "What's worth remembering?", "Что важно запомнить?"), record["note"], True)
        self._label(layout, _mz_t("Збережено: ", "Saved: ", "Сохранено: ") + display_date(record["saved_at"]) + _mz_t("\nДоступно лише на цьому пристрої.", "\nAvailable only on this device.", "\nДоступно только на этом устройстве."), True)
        dialog = self._dialog(_mz_t("Редагування закладки", "Edit bookmark", "Редактирование закладки") if "id" in record else _mz_t("Додати в закладки", "Add to bookmarks", "Добавить в закладки"))
        dialog.set_view(self._scroll(layout))
        busy = [False]
        def save():
            if busy[0] or not self._enabled():
                return
            new = dict(record, title=str(title.getText()), category=selected[0],
                       tags=tags_value(str(tags.getText())), note=str(note.getText()), updated_at=int(time.time()))
            clean = validate_bookmark(new)
            busy[0] = True
            save_button = dialog.get_button(-1)
            save_button.setEnabled(False)
            save_button.setText(_mz_t("Зберігаємо…", "Saving…", "Сохраняем…"))
            # Keep the draft open if storage fails; reject repeated submissions.
            if "id" in record:
                work = lambda: (self._store.edit(record["id"], clean["title"], clean["category"], clean["tags"], clean["note"],
                                                color=clean["color"]), record["id"])[1]
            else:
                work = lambda: self._store.save(clean)
            def saved(result):
                dialog.dismiss()
                if isinstance(result, tuple) and not result[1]:
                    self._job(lambda: self._store.get(result[0]), self._duplicate)
                    return
                if self.get_setting("notify_saved", True):
                    self._notice(_mz_t("Закладку збережено", "Bookmark saved", "Закладка сохранена"))
                if on_saved:
                    on_saved()
            def failed():
                busy[0] = False
                save_button.setEnabled(True)
                save_button.setText(save_text)
            self._job(work, saved, on_error=failed)
        save_text = _mz_t("Зберегти зміни", "Save changes", "Сохранить изменения") if "id" in record else _mz_t("Зберегти закладку", "Save bookmark", "Сохранить закладку")
        dialog.set_positive_button(save_text, lambda b, w: self._guard(save))
        dialog.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda b, w: b.dismiss())
        dialog.show()
        # Telegram dismisses native buttons automatically; replace this listener
        # so invalid fields do not close the editor.
        from android_utils import OnClickListener
        dialog.get_button(-1).setOnClickListener(OnClickListener(lambda v: self._guard(save)))
        self._watch_tags(tags, suggestions, dialog)

    def _watch_tags(self, field, container, dialog):
        """Debounced, theme-aware inline completions, not a system-colored popup."""
        generation = [0]
        def changed():
            generation[0] += 1
            token = generation[0]
            def lookup():
                if token != generation[0] or dialog not in self._dialogs or not self._alive:
                    return
                current = str(field.getText())
                prefix = re.split(r"[\s,;]+", current)[-1].lstrip("#")
                def loaded(values):
                    if token != generation[0] or dialog not in self._dialogs:
                        return
                    container.removeAllViews()
                    for tag in values:
                        def complete(value=tag):
                            # Keep all previous tokens and replace just the partial one.
                            parts = re.split(r"[\s,;]+", current)
                            completed = tags_value(parts[:-1] + [value])
                            field.setText(" ".join("#" + t for t in completed) + " ")
                            field.setSelection(field.length())
                        self._button(container, "#" + tag, complete)
                self._job(lambda: self._store.tags(prefix, limit=5), loaded)
            self._ui(lambda: self._guard(lookup), 250)
        self._watch_text(field, changed)
        changed()

    def _tag_suggestions(self, field):
        current = str(field.getText())
        tail = re.split(r"[\s,;]+", current)[-1].lstrip("#")
        def loaded(values):
            if not values:
                self._notice(_mz_t("Відповідних тегів поки немає.", "No matching tags yet.", "Подходящих тегов пока нет."))
                return
            def append(index):
                all_tags = tags_value(current)
                # Replace the partial final token with its completed suggestion.
                if tail and fold(tail) in all_tags:
                    all_tags.remove(fold(tail))
                all_tags = tags_value(all_tags + [values[index]])
                field.setText(" ".join("#" + t for t in all_tags) + " ")
                field.setSelection(field.length())
            self._choices(_mz_t("Раніше використані теги (до 100)", "Previously used tags (up to 100)", "Ранее использованные теги (до 100)"), ["#" + t for t in values], append)
        self._job(lambda: self._store.tags(tail), loaded)

    def open_manager(self):
        if not self._enabled():
            self._notice(_mz_t("Увімкніть Smart Bookmark у налаштуваннях плагіна.", "Turn on Smart Bookmark in the plugin settings.", "Включите Smart Bookmark в настройках плагина."))
            return
        self._guard(self._manager)

    def _note_message_click(self, context):
        if self._enabled():
            self._guard(lambda: self._capture(context, as_note=True))

    def _chat_notes_click(self, context):
        if self._enabled():
            self._guard(lambda: self.open_notes(self._chat_scope(context)))

    def _chat_scope(self, context):
        from org.telegram.messenger import UserConfig, MessagesController, DialogObject
        fragment = context.get("fragment")
        account = context.get("account")
        if account is None and fragment is not None:
            account = fragment.getCurrentAccount()
        dialog = context.get("dialog_id")
        if dialog is None and fragment is not None:
            dialog = fragment.getDialogId()
        # Do not fall back to selectedAccount for a chat callback: it may differ.
        if account is None or dialog is None or int(dialog) == 0:
            raise BookmarkError(_mz_t("Клієнт не передав чат або акаунт. Відкрийте «Мої нотатки» з бічного меню.", "The client didn't pass a chat or account. Open \"My notes\" from the side menu.", "Клиент не передал чат или аккаунт. Откройте «Мои заметки» из бокового меню."))
        account, dialog = int(account), int(dialog)
        config = UserConfig.getInstance(account)
        if not config.isClientActivated():
            raise BookmarkError(_mz_t("Акаунт цього чату не підключено.", "The account of this chat is not connected.", "Аккаунт этого чата не подключён."))
        controller = MessagesController.getInstance(account)
        name = ""
        if not DialogObject.isEncryptedDialog(dialog):
            if dialog < 0:
                chat = controller.getChat(-dialog)
                name = str(chat.title) if chat is not None else ""
            else:
                name = self._user_name(controller.getUser(dialog))
        return {"account_slot": account, "account_user_id": int(config.getClientUserId()),
                "dialog_id": dialog, "chat": name[:500] or _mz_t("Поточний чат", "Current chat", "Текущий чат")}

    def _general_scope(self):
        from org.telegram.messenger import UserConfig
        account = int(UserConfig.selectedAccount)
        config = UserConfig.getInstance(account)
        if not config.isClientActivated():
            raise BookmarkError(_mz_t("Підключіть акаунт, щоб створити нотатку.", "Connect an account to create a note.", "Подключите аккаунт для создания заметки."))
        return {"account_slot": account, "account_user_id": int(config.getClientUserId()),
                "dialog_id": 0, "chat": ""}

    @staticmethod
    def _new_note(scope, source=None):
        now = int(time.time())
        return {"uid": uuid.uuid4().hex, "account_slot": scope["account_slot"],
                "account_user_id": scope["account_user_id"], "dialog_id": scope["dialog_id"],
                "chat": scope["chat"], "title": "", "body": "", "status": 0, "pinned": False,
                "source": source, "saved_at": now, "updated_at": now}

    def _note_editor(self, note, refresh=None, editing=False):
        from android_utils import OnClickListener
        note = dict(note)
        layout = self._layout()
        self._label(layout, (_mz_t("До чату: ", "For chat: ", "К чату: ") + note["chat"]) if note["dialog_id"] else _mz_t("Особиста нотатка без прив'язки до чату", "Personal note not linked to a chat", "Личная заметка без привязки к чату"), True)
        self._label(layout, _mz_t("Видно лише вам. У переписку нічого не надсилається.", "Visible only to you. Nothing is sent to the conversation.", "Видна только вам. В переписку ничего не отправляется."), True)
        body = self._input(layout, _mz_t("Що потрібно запам'ятати або зробити?", "What do you need to remember or do?", "Что нужно запомнить или сделать?"), note["body"], True)
        body.setMinLines(4)
        self._color_field(layout, note)
        self._heading(layout, _mz_t("Назва · необов'язково", "Title · optional", "Название · необязательно"))
        title = self._input(layout, _mz_t("Буде взято з першого рядка", "Taken from the first line", "Будет взято из первой строки"), note["title"])
        row = self._row(layout)
        def select_status():
            def chosen(index):
                note["status"] = index
                status.setText(NOTE_STATES[index] + " ▾")
            self._choices(_mz_t("Тип нотатки", "Note type", "Тип заметки"), list(NOTE_STATES), chosen)
        status = self._button(row, NOTE_STATES[note["status"]] + " ▾", select_status, compact=True)
        def pin():
            note["pinned"] = not note["pinned"]
            pin_button.setText(_mz_t("Закріплена", "Pinned", "Закреплена") if note["pinned"] else _mz_t("Закріпити", "Pin", "Закрепить"))
            self._chip_state(pin_button, note["pinned"])
        pin_button = self._button(row, _mz_t("Закріплена", "Pinned", "Закреплена") if note["pinned"] else _mz_t("Закріпити", "Pin", "Закрепить"), pin, compact=True)
        self._chip_state(pin_button, note["pinned"])
        if note["source"]:
            self._label(layout, _mz_t("Джерело: ", "Source: ", "Источник: ") + note["source"]["title"][:120], True)
        dialog = self._dialog(_mz_t("Редагувати нотатку", "Edit note", "Изменить заметку") if editing else _mz_t("Нова нотатка", "New note", "Новая заметка"))
        dialog.set_view(self._scroll(layout))
        busy = [False]
        def save():
            if busy[0] or not self._enabled():
                return
            content = str(body.getText())
            name = str(title.getText()).strip() or " ".join(content.split())[:100]
            clean = validate_note(dict(note, body=content, title=name, updated_at=int(time.time())))
            busy[0] = True
            button = dialog.get_button(-1)
            button.setEnabled(False)
            button.setText(_mz_t("Зберігаємо…", "Saving…", "Сохраняем…"))
            def saved(_):
                dialog.dismiss()
                if self.get_setting("notify_saved", True):
                    self._notice(_mz_t("Нотатку збережено", "Note saved", "Заметка сохранена"))
                if refresh:
                    refresh()
            def failed():
                busy[0] = False
                button.setEnabled(True)
                button.setText(_mz_t("Зберегти", "Save", "Сохранить"))
            self._job(lambda: self._store.save_note(clean, editing=editing), saved, on_error=failed)
        dialog.set_positive_button(_mz_t("Зберегти", "Save", "Сохранить"), lambda b, w: self._guard(save))
        dialog.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), lambda b, w: b.dismiss())
        dialog.show()
        dialog.get_button(-1).setOnClickListener(OnClickListener(lambda v: self._guard(save)))

    def open_notes(self, scope=None):
        if not self._enabled():
            self._notice(_mz_t("Увімкніть Smart Bookmark у налаштуваннях плагіна.", "Turn on Smart Bookmark in the plugin settings.", "Включите Smart Bookmark в настройках плагина."))
            return
        self._guard(lambda: self._notes_manager(scope))

    def _notes_manager(self, scope=None):
        from android.widget import LinearLayout
        # One scroll region; toolbar stays visible. No nested scrolling in the new manager.
        dialog = self._dialog(_mz_t("Мої нотатки", "My notes", "Мои заметки"))
        layout = self._layout()
        def switch(section):
            if section == "bookmarks":
                dialog.dismiss()
                self.open_manager()
        sections = self._sections(layout, "notes", switch)
        self._label(layout, (_mz_t("Чат: ", "Chat: ", "Чат: ") + scope["chat"]) if scope else _mz_t("Особисті нотатки до всіх чатів і акаунтів", "Personal notes for all chats and accounts", "Личные заметки ко всем чатам и аккаунтам"), True)
        state = {"chat_only": scope is not None, "status": None, "offset": 0,
                 "generation": 0, "typing": 0, "closed": False}
        search = self._input(layout, _mz_t("Знайти в нотатках", "Search notes", "Найти в заметках"))
        toolbar = self._row(layout)
        def new():
            target = scope if state["chat_only"] else self._general_scope()
            self._note_editor(self._new_note(target), lambda: fetch(True))
        self._button(toolbar, _mz_t("+ Нотатка", "+ Note", "+ Заметка"), new, primary=True, compact=True)
        def filters():
            choices = [_mz_t("Усі записи", "All entries", "Все записи"), _mz_t("Лише нотатки", "Notes only", "Только заметки"), _mz_t("До виконання", "To do", "К выполнению"), _mz_t("Виконано", "Done", "Выполнено")]
            def chosen(index):
                state["status"] = None if index == 0 else index - 1
                filter_button.setText(choices[index] + " ▾")
                fetch(True)
            self._choices(_mz_t("Показати", "Show", "Показать"), choices, chosen)
        filter_button = self._button(toolbar, _mz_t("Усі записи ▾", "All entries ▾", "Все записи ▾"), filters, compact=True)
        if scope:
            def toggle_scope():
                state["chat_only"] = not state["chat_only"]
                scope_button.setText(_mz_t("Цей чат · показати всі", "This chat · show all", "Этот чат · показать все") if state["chat_only"] else _mz_t("Усі чати · лише цей", "All chats · this one only", "Все чаты · только этот"))
                fetch(True)
            scope_button = self._button(layout, _mz_t("Цей чат · показати всі", "This chat · show all", "Этот чат · показать все"), toggle_scope)
        status = self._label(layout, _mz_t("Завантаження…", "Loading…", "Загрузка…"), True)
        results = self._layout(0)
        scroll = self._scroll(results)
        layout.addView(scroll, LinearLayout.LayoutParams(-1, self._dp(self._notes_height(scope is not None))))
        pager = self._row(layout)
        dialog.set_view(layout)
        def fetch(reset=False):
            if state["closed"]:
                return
            state["typing"] += 1
            state["generation"] += 1
            if reset:
                state["offset"] = 0
            generation = state["generation"]
            target = scope if state["chat_only"] else None
            params = dict(owner=target["account_user_id"] if target else None,
                          dialog=target["dialog_id"] if target else None,
                          search=str(search.getText()), status=state["status"], offset=state["offset"])
            status.setText(_mz_t("Пошук…", "Searching…", "Поиск…"))
            def loaded(value):
                if state["closed"] or generation != state["generation"]:
                    return
                records, total = value
                if state["offset"] and state["offset"] >= total:
                    state["offset"] = max(0, ((total - 1) // PAGE_SIZE) * PAGE_SIZE)
                    fetch()
                    return
                results.removeAllViews()
                pager.removeAllViews()
                status.setText(_mz_t("Нотаток: %d · %s", "Notes: %d · %s", "Заметок: %d · %s") % (total, _mz_t("цей чат", "this chat", "этот чат") if target else _mz_t("усі чати", "all chats", "все чаты")))
                bookmark_count = getattr(self, "_count", 0)
                sections["bookmarks"].setText(_mz_t("Закладки · ", "Bookmarks · ", "Закладки · ") + str(bookmark_count))
                if self._store.skipped_records:
                    self._label(results, _mz_t("Пошкоджені записи пропущено; файли збережено.", "Damaged entries were skipped; files are kept.", "Повреждённые записи пропущены; файлы сохранены."), True)
                for note in records:
                    self._note_card(results, note, lambda n=note: self._note_details(n, lambda: fetch()))
                if not records:
                    self._heading(results, _mz_t("Поки нічого немає", "Nothing here yet", "Пока ничего нет"))
                    if bookmark_count:
                        self._label(results, _mz_t("Збережених повідомлень у «Моїх закладках»: %d. Відкрийте вкладку «Закладки» зверху, це окремий список без фільтра поточного чату.", "Saved messages in \"My bookmarks\": %d. Open the \"Bookmarks\" tab at the top. It's a separate list without the current chat filter.", ("Сохранённых сообщений в «Моих закладках»: %d. "
                                    "Откройте вкладку «Закладки» сверху — это отдельный список, без фильтра текущего чата.")) %
                                    bookmark_count, True)
                    else:
                        self._label(results, _mz_t("Натисніть «+ Нотатка». Якщо ви зберігали повідомлення як закладку, відкрийте вкладку «Закладки» зверху. Якщо ввімкнено пошук або фільтр нотаток, очистьте запит або виберіть «Усі записи».", "Tap \"+ Note\". If you saved a message as a bookmark, open the \"Bookmarks\" tab at the top. If a note search or filter is on, clear the query or choose \"All entries\".", ("Нажмите «+ Заметка». Если вы сохраняли сообщение как закладку, "
                                    "откройте вкладку «Закладки» сверху. Если включён поиск или фильтр заметок — "
                                    "очистите запрос либо выберите «Все записи».")), True)
                if state["offset"] > 0:
                    self._button(pager, _mz_t("← Назад", "← Back", "← Назад"), lambda: page(-1), compact=True)
                if state["offset"] + PAGE_SIZE < total:
                    self._button(pager, _mz_t("Далі →", "Next →", "Далее →"), lambda: page(1), compact=True)
                scroll.scrollTo(0, 0)
            self._job(lambda: self._store.notes_query(**params), loaded)
        def page(delta):
            state["offset"] = max(0, state["offset"] + PAGE_SIZE * delta)
            fetch()
        def typing():
            state["typing"] += 1
            state["generation"] += 1
            token = state["typing"]
            self._ui(lambda: self._guard(lambda: fetch(True))
                     if not state["closed"] and token == state["typing"] else None, 350)
        self._watch_text(search, typing)
        self._button(layout, _mz_t("Налаштування та резервна копія", "Settings and backup", "Настройки и резервная копия"), self._notes_options)
        dialog.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda b, w: b.dismiss())
        def closed(_):
            state["closed"] = True
            if dialog in self._dialogs:
                self._dialogs.remove(dialog)
        dialog.set_on_dismiss_listener(closed)
        dialog.show()
        fetch()

    def _notes_height(self, scoped):
        # Reserve room for title, controls and footer on short screens/large text.
        try:
            resources = self._activity().getResources()
            metrics = resources.getDisplayMetrics()
            screen_dp = float(metrics.heightPixels) / float(metrics.density)
            font_scale = max(1.0, float(resources.getConfiguration().fontScale))
            return int(max(80, min(280, screen_dp - (640 if scoped else 584) * font_scale)))
        except Exception:
            return 200

    def _note_card(self, parent, note, callback):
        from android.widget import LinearLayout
        from android.graphics import Typeface
        from android.text import TextUtils
        from android_utils import OnClickListener
        card = self._layout(10)
        self._surface(card, accent=note["pinned"], interactive=True, color=note.get("color", "none"))
        title = self._label(card, (_mz_t("Закріплено · ", "Pinned · ", "Закреплено · ") if note["pinned"] else "") + note["title"])
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setMaxLines(2)
        title.setEllipsize(TextUtils.TruncateAt.END)
        body = self._label(card, note["body"], True)
        body.setMaxLines(3)
        body.setEllipsize(TextUtils.TruncateAt.END)
        self._label(card, NOTE_STATES[note["status"]] + " · " + (note["chat"] or _mz_t("Без прив'язки до чату", "Not linked to a chat", "Без привязки к чату")), True)
        if note.get("color", "none") != "none":
            self._label(card, _mz_t("Колір: ", "Color: ", "Цвет: ") + COLOR_LABELS[note["color"]], True)
        self._label(card, display_date(note["updated_at"]), True)
        card.setOnClickListener(OnClickListener(lambda v: self._guard(callback)))
        card.setContentDescription(_mz_t("Відкрити нотатку: ", "Open note: ", "Открыть заметку: ") + note["title"])
        params = LinearLayout.LayoutParams(-1, -2)
        params.setMargins(0, self._dp(4), 0, self._dp(8))
        parent.addView(card, params)

    def _note_details(self, note, refresh):
        from android_utils import copy_to_clipboard
        layout = self._layout()
        self._label(layout, NOTE_STATES[note["status"]] + " · " + (note["chat"] or _mz_t("Без прив'язки до чату", "Not linked to a chat", "Без привязки к чату")), True)
        body = self._label(layout, note["body"])
        body.setTextIsSelectable(True)
        self._surface(layout, color=note.get("color", "none"))
        dialog = self._dialog(note["title"])
        def after():
            dialog.dismiss()
            refresh()
        self._button(layout, _mz_t("Редагувати нотатку", "Edit note", "Изменить заметку"), lambda: self._note_editor(note, after, editing=True), primary=True)
        row = self._row(layout)
        def action(kind):
            self._job(lambda: self._store.note_action(note["uid"], note["account_user_id"], kind), lambda _: after())
        self._button(row, _mz_t("Повернути в завдання", "Move back to tasks", "Вернуть в задачи") if note["status"] == 2 else _mz_t("Виконано", "Done", "Выполнено"), lambda: action("done"), compact=True)
        self._button(row, _mz_t("Відкріпити", "Unpin", "Открепить") if note["pinned"] else _mz_t("Закріпити", "Pin", "Закрепить"), lambda: action("pin"), compact=True)
        self._button(layout, _mz_t("Скопіювати нотатку", "Copy note", "Копировать заметку"), lambda: copy_to_clipboard(note["body"]))
        self._button(layout, _mz_t("Змінити колір", "Change color", "Изменить цвет"), lambda: self._change_color(note, "note", after))
        if note["source"]:
            self._label(layout, _mz_t("Джерело: ", "Source: ", "Источник: ") + note["source"]["title"][:150], True)
            self._button(layout, _mz_t("До повідомлення-джерела", "Go to source message", "К сообщению-источнику"), lambda: self._open_original(note["source"]))
        self._label(layout, _mz_t("Акаунт Telegram: ", "Telegram account: ", "Аккаунт Telegram: ") + str(note["account_user_id"]), True)
        self._button(layout, _mz_t("Видалити нотатку", "Delete note", "Удалить заметку"), lambda: self._confirm(_mz_t("Видалити нотатку?", "Delete note?", "Удалить заметку?"),
            _mz_t("Буде видалено лише вашу локальну нотатку. Переписка не зміниться.", "Only your local note will be deleted. The conversation won't change.", "Удалится только ваша локальная заметка. Переписка не изменится."), lambda: action("delete")), danger=True)
        dialog.set_view(self._scroll(layout))
        dialog.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda b, w: b.dismiss())
        dialog.show()

    def _notes_options(self):
        callbacks = [self.open_manager, self._export, lambda: self._pick_document("import"),
                     self._clear_notes, self._settings_dialog]
        self._choices(_mz_t("Дані та налаштування", "Data and settings", "Данные и настройки"), [_mz_t("Мої закладки", "My bookmarks", "Мои закладки"), _mz_t("Експорт нотаток і закладок", "Export notes and bookmarks", "Экспорт заметок и закладок"),
            _mz_t("Імпорт резервної копії", "Import backup", "Импорт резервной копии"), _mz_t("Очистити лише нотатки", "Clear notes only", "Очистить только заметки"), _mz_t("Розширені налаштування", "Advanced settings", "Расширенные настройки")], lambda i: callbacks[i]())

    def _clear_notes(self):
        self._confirm(_mz_t("Очистити всі нотатки?", "Clear all notes?", "Очистить все заметки?"), _mz_t("Буде видалено нотатки й завдання всіх акаунтів. Архів закладок залишиться. Спочатку зробіть експорт.", "Notes and tasks of all accounts will be deleted. The bookmark archive stays. Export first.", ("Удалятся заметки и задачи всех аккаунтов. "
                      "Архив закладок останется. Сначала сделайте экспорт.")),
                      lambda: self._job(lambda: self._store.clear_notes(), lambda _: self._notice(_mz_t("Нотатки очищено", "Notes cleared", "Заметки очищены"))))

    def _manager(self):
        from android.widget import LinearLayout
        dialog = self._dialog(_mz_t("Мої закладки", "My bookmarks", "Мои закладки"))
        layout = self._layout()
        def switch(section):
            if section == "notes":
                dialog.dismiss()
                self.open_notes()
        self._sections(layout, "bookmarks", switch)
        self._label(layout, _mz_t("Збережені повідомлення з усіх чатів і акаунтів. Особисті нотатки відкриваються окремо.", "Saved messages from all chats and accounts. Personal notes open separately.", "Сохранённые сообщения всех чатов и аккаунтов. Личные заметки открываются отдельно."), True)
        search_row = self._row(layout)
        search = self._input(search_row, _mz_t("Пошук у закладках", "Search bookmarks", "Поиск в закладках"))
        search.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))
        state = {"category": None, "tags": [], "sort": 0, "offset": 0,
                 "generation": 0, "typing": 0, "closed": False}
        find = self._button(search_row, _mz_t("Знайти", "Search", "Найти"), lambda: fetch(True), primary=True, compact=True)
        find.setLayoutParams(LinearLayout.LayoutParams(self._dp(78), -2))
        filters = self._row(layout)
        toolbar = self._row(layout)
        reset_button = self._button(layout, _mz_t("Скинути пошук і фільтри", "Reset search and filters", "Сбросить поиск и фильтры"), lambda: reset())
        reset_button.setVisibility(8)
        status = self._label(layout, _mz_t("Завантажуємо закладки…", "Loading bookmarks…", "Загружаем закладки…"), True)
        results = self._layout(0)
        scroll = self._scroll(results)
        # Fixed viewport bounds the number of native views, even for huge collections.
        layout.addView(scroll, LinearLayout.LayoutParams(-1, self._dp(self._notes_height(False))))
        pager = self._row(layout)
        dialog.set_view(layout)
        def active_filters():
            return bool(str(search.getText()).strip() or state["category"] or state["tags"] or state["sort"])
        def sync_controls():
            cat.setText((state["category"] or _mz_t("Усі категорії", "All categories", "Все категории")) + "  ▾")
            tag_button.setText((_mz_t("Теги · ", "Tags · ", "Теги · ") + str(len(state["tags"])) if state["tags"] else _mz_t("Усі теги", "All tags", "Все теги")) + "  ▾")
            sort_button.setText(SORTS[state["sort"]] + "  ▾")
            self._chip_state(cat, bool(state["category"]))
            self._chip_state(tag_button, bool(state["tags"]))
            reset_button.setVisibility(0 if active_filters() else 8)
            tag_button.setContentDescription(_mz_t("Фільтр тегів: ", "Tag filter: ", "Фильтр тегов: ") + (", ".join(state["tags"]) or _mz_t("усі теги", "all tags", "все теги")))
        def fetch(reset=False):
            if state["closed"]:
                return
            state["typing"] += 1  # Invalidate a queued live-search callback.
            if reset:
                state["offset"] = 0
            if state["category"] and state["category"] not in self._categories:
                state["category"] = None
            sync_controls()
            state["generation"] += 1
            generation = state["generation"]
            params = dict(search=str(search.getText()), category=state["category"], tags=list(state["tags"]),
                          sort=state["sort"], offset=state["offset"])
            status.setText(_mz_t("Пошук…", "Searching…", "Поиск…"))
            def loaded(value):
                if state["closed"] or generation != state["generation"]:
                    return
                records, total = value
                # If the final record on a page was deleted, move back one page.
                if state["offset"] and state["offset"] >= total:
                    state["offset"] = max(0, ((total - 1) // PAGE_SIZE) * PAGE_SIZE)
                    fetch()
                    return
                results.removeAllViews()
                pager.removeAllViews()
                status.setText((_mz_t("Знайдено: ", "Found: ", "Найдено: ") if active_filters() else _mz_t("Збережено закладок: ", "Saved bookmarks: ", "Сохранено закладок: ")) + str(total))
                if self._store.skipped_records:
                    self._label(results, _mz_t("Пошкоджені записи пропущено. Вихідні дані збережено.", "Damaged entries were skipped. The original data is kept.", "Повреждённые записи пропущены. Исходные данные сохранены."), True)
                for record in records:
                    self._bookmark_card(results, record, lambda r=record: self._details(r, lambda: fetch(False)))
                if not records:
                    if total:
                        self._heading(results, _mz_t("Записи знайдено, але вони не показуються", "Entries found but not displayed", "Записи найдены, но не отображаются"))
                        self._label(results, _mz_t("Записів у базі: %d, але цю сторінку не вдалося прочитати. Вихідні записи не видалено. Не очищайте дані застосунку; повідомте розробника про проблему.", "Entries in the database: %d, but this page couldn't be read. The original entries were not deleted. Don't clear the app data; report the problem to the developer.", ("В базе найдено записей: %d, но эту страницу не удалось прочитать. "
                                    "Исходные записи не удалены. Не очищайте данные приложения; "
                                    "сообщите разработчику о проблеме.")) % total, True)
                    else:
                        self._heading(results, _mz_t("Нічого не знайдено", "Nothing found", "Ничего не найдено") if active_filters() else _mz_t("Закладок поки немає", "No bookmarks yet", "Пока нет закладок"))
                        self._label(results, _mz_t("Спробуйте інший запит або скиньте фільтри.", "Try another query or reset the filters.", "Попробуйте другой запрос или сбросьте фильтры.") if active_filters() else
                                    _mz_t("Записи, створені через «Додати нотатку», містяться в «Моїх нотатках». Щоб зберігати повідомлення саме як закладки, увімкніть «Додати в закладки» в налаштуваннях.", "Entries created with \"Add note\" are in \"My notes\". To save a message as a bookmark, turn on \"Add to bookmarks\" in settings.", ("Записи, созданные через «Добавить заметку», находятся в «Моих заметках». "
                                    "Для сохранения сообщения именно как закладки включите «Добавить в закладки» в настройках.")), True)
                        self._button(results, _mz_t("Відкрити мої нотатки", "Open my notes", "Открыть мои заметки"), self.open_notes)
                pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
                pager.setVisibility(0 if pages > 1 else 8)
                if pages > 1:
                    previous = self._button(pager, _mz_t("← Назад", "← Back", "← Назад"), lambda: page(-1), compact=True)
                    previous.setEnabled(state["offset"] > 0)
                    previous.setAlpha(1.0 if state["offset"] > 0 else 0.35)
                    counter = self._label(pager, "%d / %d" % (state["offset"] // PAGE_SIZE + 1, pages), True)
                    counter.setGravity(17)
                    counter.setPadding(self._dp(8), self._dp(16), self._dp(8), 0)
                    following = self._button(pager, _mz_t("Далі →", "Next →", "Далее →"), lambda: page(1), compact=True)
                    following.setEnabled(state["offset"] + PAGE_SIZE < total)
                    following.setAlpha(1.0 if state["offset"] + PAGE_SIZE < total else 0.35)
                scroll.scrollTo(0, 0)
            def failed():
                if not state["closed"] and generation == state["generation"]:
                    status.setText(_mz_t("Не вдалося завантажити закладки. Щоб повторити, натисніть «Знайти». Дані не видалено.", "Couldn't load bookmarks. Tap \"Search\" to retry. No data was deleted.", "Не удалось загрузить закладки. Для повтора нажмите «Найти». Данные не удалены."))
            self._job(lambda: self._store.query(**params), loaded, on_error=failed)
        def page(delta):
            state["offset"] = max(0, state["offset"] + PAGE_SIZE * delta)
            fetch()
        def category():
            choices = [_mz_t("Усі категорії", "All categories", "Все категории")] + self._categories[:]
            def chosen(i):
                state["category"] = None if i == 0 else choices[i]
                fetch(True)
            self._choices(_mz_t("Категорії", "Categories", "Категории"), choices, chosen)
        def filter_tags():
            self._prompt(_mz_t("Фільтр за тегами", "Filter by tags", "Фильтр по тегам"), " ".join("#" + t for t in state["tags"]), set_tags,
                         positive=_mz_t("Застосувати", "Apply", "Применить"), helper=_mz_t("Укажіть теги через пробіл. Знайдемо закладки з усіма вказаними тегами. Порожнє поле: будь-які теги.", "Enter tags separated by spaces. We'll find bookmarks with all the listed tags. An empty field means any tags.", ("Укажите теги через пробел. Найдём закладки со всеми "
                         "указанными тегами. Пустое поле — любые теги.")))
        def set_tags(value):
            state["tags"] = tags_value(value)
            fetch(True)
        def sort():
            def selected(i):
                state["sort"] = i
                fetch(True)
            self._choices(_mz_t("Сортування", "Sort", "Сортировка"), list(SORTS), selected)
        def reset():
            search.setText("")
            state.update(category=None, tags=[], sort=0, offset=0)
            fetch(True)
        def typing():
            state["typing"] += 1
            state["generation"] += 1  # Ignore an older search already in flight.
            token = state["typing"]
            def apply():
                if not state["closed"] and token == state["typing"]:
                    fetch(True)
            self._ui(lambda: self._guard(apply), 350)
        cat = self._button(filters, _mz_t("Усі категорії  ▾", "All categories  ▾", "Все категории  ▾"), category, compact=True)
        tag_button = self._button(filters, _mz_t("Усі теги  ▾", "All tags  ▾", "Все теги  ▾"), filter_tags, compact=True)
        sort_button = self._button(toolbar, SORTS[0] + "  ▾", sort, compact=True)
        self._button(toolbar, _mz_t("Налаштування", "Settings", "Настройки"), self._settings_dialog, compact=True)
        self._watch_text(search, typing)
        dialog.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda b, w: b.dismiss())
        def closed(_):
            state["closed"] = True
            if dialog in self._dialogs:
                self._dialogs.remove(dialog)
        dialog.set_on_dismiss_listener(closed)
        dialog.show()
        fetch()

    def _bookmark_card(self, parent, record, callback):
        from android.widget import LinearLayout
        from android.graphics import Typeface
        from android.text import TextUtils
        from android_utils import OnClickListener
        card = self._layout(12)
        self._surface(card, interactive=True, color=record.get("color", "none"))
        title = self._label(card, record["title"])
        title.setTextSize(17)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setMaxLines(2)
        title.setEllipsize(TextUtils.TruncateAt.END)
        snippet = self._label(card, record["text"][:220] or _mz_t("Повідомлення з вкладенням", "Message with attachment", "Сообщение с вложением"), True)
        snippet.setTextSize(14)
        snippet.setMaxLines(3)
        snippet.setEllipsize(TextUtils.TruncateAt.END)
        source = " · ".join(value for value in (record["sender"], record["chat"]) if value)
        origin = self._label(card, source or _mz_t("Джерело не вказано", "Source not specified", "Источник не указан"), True)
        origin.setMaxLines(1)
        origin.setEllipsize(TextUtils.TruncateAt.END)
        category = self._label(card, "□ " + record["category"] +
                               (_mz_t("   ·   Є нотатка", "   ·   Has a note", "   ·   Есть заметка") if record["note"] else ""), True)
        category.setTextColor(self._color("key_dialogTextBlue"))
        category.setMaxLines(1)
        category.setEllipsize(TextUtils.TruncateAt.END)
        if record["tags"]:
            tags = self._label(card, " ".join("#" + t for t in record["tags"]), True)
            tags.setMaxLines(1)
            tags.setEllipsize(TextUtils.TruncateAt.END)
        if record.get("color", "none") != "none":
            self._label(card, _mz_t("Колір: ", "Color: ", "Цвет: ") + COLOR_LABELS[record["color"]], True)
        date = self._label(card, display_date(record["saved_at"]) + _mz_t("   ·   Натисніть, щоб відкрити", "   ·   Tap to open", "   ·   Нажмите, чтобы открыть"), True)
        date.setTextSize(11)
        card.setOnClickListener(OnClickListener(lambda v: self._guard(callback)))
        card.setContentDescription(_mz_t("Відкрити закладку: ", "Open bookmark: ", "Открыть закладку: ") + record["title"])
        params = LinearLayout.LayoutParams(-1, -2)
        params.setMargins(0, self._dp(4), 0, self._dp(10))
        parent.addView(card, params)
        return card

    def _details(self, record, refresh=None):
        if record is None:
            self._notice(_mz_t("Закладку вже видалено або пошкоджено.", "The bookmark was already deleted or is damaged.", "Закладка уже удалена или повреждена."))
            return
        layout = self._layout()
        self._surface(layout, color=record.get("color", "none"))
        self._label(layout, "□ " + record["category"] + "   ·   " + display_date(record["saved_at"]), True)
        self._heading(layout, _mz_t("Повідомлення", "Message", "Сообщение"))
        text = self._label(layout, record["text"] or _mz_t("Повідомлення з вкладенням", "Message with attachment", "Сообщение с вложением"))
        text.setTextIsSelectable(True)
        if record["tags"]:
            self._label(layout, " ".join("#" + t for t in record["tags"]), True)
        self._heading(layout, _mz_t("Моя нотатка", "My note", "Моя заметка"))
        self._label(layout, record["note"] or _mz_t("Нотатку не додано", "No note added", "Заметка не добавлена"), not bool(record["note"]))
        self._heading(layout, _mz_t("Джерело", "Source", "Источник"))
        self._label(layout, (record["chat"] or _mz_t("Чат не вказано", "Chat not specified", "Чат не указан")) + "\n" +
                    (record["sender"] or _mz_t("Відправник невідомий", "Unknown sender", "Отправитель неизвестен")), True)
        self._label(layout, _mz_t("Акаунт Telegram: ", "Telegram account: ", "Аккаунт Telegram: ") + str(record["account_user_id"]), True)
        dialog = self._dialog(record["title"])
        def after():
            dialog.dismiss()
            if refresh:
                refresh()
        self._heading(layout, _mz_t("Дії", "Actions", "Действия"))
        self._button(layout, _mz_t("Відкрити повідомлення в Telegram", "Open message in Telegram", "Открыть сообщение в Telegram"), lambda: self._open_original(record), primary=True)
        actions = self._row(layout)
        self._button(actions, _mz_t("Редагувати", "Edit", "Изменить"), lambda: self._editor(record, after), compact=True)
        from android_utils import copy_to_clipboard
        self._button(actions, _mz_t("Скопіювати", "Copy", "Копировать"), lambda: copy_to_clipboard(record["text"]), compact=True)
        def category():
            choices = self._categories[:]
            self._choices(_mz_t("Категорія", "Category", "Категория"), choices, lambda i: self._job(
                lambda: self._store.edit(record["id"], record["title"], choices[i], record["tags"], record["note"]),
                lambda _: after()))
        self._button(layout, _mz_t("Перенести в іншу категорію", "Move to another category", "Перенести в другую категорию"), category)
        self._button(layout, _mz_t("Змінити колір", "Change color", "Изменить цвет"), lambda: self._change_color(record, "bookmark", after))
        self._button(layout, _mz_t("Видалити закладку", "Delete bookmark", "Удалить закладку"), lambda: self._delete(record, after), danger=True)
        dialog.set_view(self._scroll(layout))
        dialog.set_negative_button(_mz_t("Закрити", "Close", "Закрыть"), lambda b, w: b.dismiss())
        dialog.show()

    def _delete(self, record, done=None):
        self._confirm(_mz_t("Видалити закладку?", "Delete bookmark?", "Удалить закладку?"), _mz_t("Оригінальне повідомлення залишиться в Telegram.", "The original message stays in Telegram.", "Оригинальное сообщение останется в Telegram."),
                      lambda: self._job(lambda: self._store.delete(record["id"]),
                                        lambda _: done() if done else self._notice(_mz_t("Закладку видалено", "Bookmark deleted", "Закладка удалена"))))

    def _categories_dialog(self):
        self._job(self._store.categories if self._store else lambda: [], self._show_categories)

    def _show_categories(self, categories):
        names = [_mz_t("Створити категорію", "Create category", "Создать категорию")] + ["□ " + c["name"] for c in categories]
        def chosen(i):
            if i == 0:
                self._prompt(_mz_t("Нова категорія", "New category", "Новая категория"), "", lambda value: self._job(
                    lambda: self._store.category_add(value), lambda _: self._categories_dialog()))
                return
            category = categories[i - 1]
            name = category["name"]
            if category["builtin"]:
                self._notice(_mz_t("Вбудована категорія. Власні категорії можна створювати, перейменовувати й видаляти.", "Built-in category. You can create, rename and delete your own categories.", "Встроенная категория. Свои категории можно создавать, переименовывать и удалять."))
                return
            def action(index):
                if index == 0:
                    def renamed(value):
                        def complete(_):
                            if self.get_setting("default_category", "Личное") == name:
                                self.set_setting("default_category", value.strip())
                            self._categories_dialog()
                        self._job(lambda: self._store.category_rename(name, value), complete)
                    self._prompt(_mz_t("Назва категорії", "Category name", "Название категории"), name, renamed)
                else:
                    self._confirm(_mz_t("Видалити категорію?", "Delete category?", "Удалить категорию?"), _mz_t("Закладки буде перенесено в «Личное», а не видалено.", "Bookmarks will be moved to \"Личное\", not deleted.", "Закладки будут перенесены в «Личное», а не удалены."),
                        lambda: self._job(lambda: self._store.category_delete(name), lambda _: self._category_deleted(name)))
            self._choices("□ " + name, [_mz_t("Перейменувати", "Rename", "Переименовать"), _mz_t("Видалити й перенести в «Личное»", "Delete and move to \"Личное\"", "Удалить и перенести в «Личное»")], action)
        self._choices(_mz_t("Категорії", "Categories", "Категории"), names, chosen)

    def _category_deleted(self, name):
        if self.get_setting("default_category", "Личное") == name:
            self.set_setting("default_category", "Личное")
        self._categories_dialog()

    def _default_category(self):
        choices = self._categories[:]
        self._choices(_mz_t("Типова категорія", "Default category", "Категория по умолчанию"), choices,
                      lambda i: self.set_setting("default_category", choices[i], reload_settings=True))

    def _clear(self):
        self._confirm(_mz_t("Очистити всі закладки?", "Clear all bookmarks?", "Очистить все закладки?"), _mz_t("Буде видалено закладки всіх акаунтів. Скасувати не можна. Спочатку зробіть експорт.", "Bookmarks of all accounts will be deleted. This can't be undone. Export first.", "Будут удалены закладки всех аккаунтов. Отменить нельзя. Сначала сделайте экспорт."),
                      lambda: self._job(self._store.clear, lambda _: self._notice(_mz_t("Закладки очищено", "Bookmarks cleared", "Закладки очищены"))))

    def create_settings(self):
        from ui.settings import Header, Switch, Text, Divider
        return [
            Header(text="Smart Bookmark"),
            Switch(key="feature_enabled", text=_mz_t("Увімкнути Smart Bookmark", "Turn on Smart Bookmark", "Включить Smart Bookmark"), default=True, on_change=self._toggle),
            Text(text=_mz_t("Мої нотатки", "My notes", "Мои заметки"), subtext=_mz_t("Особисті нотатки й завдання до чатів, без пересилання", "Personal notes and tasks for chats, never forwarded", "Личные заметки и задачи к чатам, без пересылки"),
                 icon="msg_edit", on_click=lambda v: self.open_notes()),
            Text(text=_mz_t("Мої закладки", "My bookmarks", "Мои закладки"), subtext=_mz_t("Збережені повідомлення, зокрема з попередніх версій", "Saved messages, including from previous versions", "Сохранённые сообщения, в том числе из прошлых версий"),
                 icon="msg_saved", on_click=lambda v: self.open_manager()),
            Switch(key="legacy_bookmark_menu", text=_mz_t("Показувати «Додати в закладки»", "Show \"Add to bookmarks\"", "Показывать «Добавить в закладки»"), default=False,
                   on_change=self._toggle_legacy_menu),
            Text(text=_mz_t("Типова категорія", "Default category", "Категория по умолчанию"), subtext=self.get_setting("default_category", "Личное"),
                 on_click=lambda v: self._guard(self._default_category)),
            Switch(key="notify_saved", text=_mz_t("Сповіщати після збереження", "Notify after saving", "Уведомлять после сохранения"), default=True),
            Text(text=_mz_t("Керування категоріями", "Manage categories", "Управление категориями"), on_click=lambda v: self._guard(self._categories_dialog)),
            Divider(), Header(text=_mz_t("Дані та резервні копії", "Data and backups", "Данные и резервные копии")),
            Text(text=_mz_t("Експорт нотаток і закладок", "Export notes and bookmarks", "Экспорт заметок и закладок"), on_click=lambda v: self._guard(self._export)),
            Text(text=_mz_t("Імпорт резервної копії", "Import backup", "Импорт резервной копии"), on_click=lambda v: self._guard(lambda: self._pick_document("import"))),
            Text(text=_mz_t("Очистити лише нотатки", "Clear notes only", "Очистить только заметки"), red=True, on_click=lambda v: self._guard(self._clear_notes)),
            Text(text=_mz_t("Очистити закладки", "Clear bookmarks", "Очистить закладки"), red=True, on_click=lambda v: self._guard(self._clear)),
            Text(text=_mz_t("Кількість збережених закладок: ", "Number of saved bookmarks: ", "Количество сохранённых закладок: ") + str(getattr(self, "_count", 0)),
                 subtext=_mz_t("Натисніть, щоб оновити", "Tap to refresh", "Нажмите, чтобы обновить"), on_click=lambda v: self._job(lambda: self._store.count(),
                     lambda n: self._notice(_mz_t("Збережено закладок: ", "Saved bookmarks: ", "Сохранено закладок: ") + str(n)))),
            Text(text=_mz_t("Версія плагіна: ", "Plugin version: ", "Версия плагина: ") + __version__),
            Text(text=_mz_t("Перевірити й завантажити іконку", "Check and load icon", "Проверить и загрузить иконку"), subtext=_mz_t("Перевірка метаданих і набору SmartBookmark у Telegram", "Checks the metadata and the SmartBookmark set in Telegram", "Проверка метаданных и набора SmartBookmark в Telegram"),
                 on_click=lambda v: self._guard(self._check_icon)),
            Divider(text=_mz_t("Дані лише на пристрої. Експорт містить особисте листування й не зашифрований.", "Data stays on the device only. The export contains private conversations and is not encrypted.", "Данные только на устройстве. Экспорт содержит личную переписку и не зашифрован.")),
        ]

    def _toggle_legacy_menu(self, value):
        self.set_setting("legacy_bookmark_menu", bool(value))
        self._sync_menus()

    def _settings_dialog(self):
        items = [_mz_t("Типова категорія", "Default category", "Категория по умолчанию"), _mz_t("Керування категоріями", "Manage categories", "Управление категориями"), _mz_t("Сповіщення: ", "Notifications: ", "Уведомления: ") +
                 (_mz_t("увімкнено", "on", "включены") if self.get_setting("notify_saved", True) else _mz_t("вимкнено", "off", "выключены")),
                 _mz_t("Експорт закладок", "Export bookmarks", "Экспорт закладок"), _mz_t("Імпорт закладок", "Import bookmarks", "Импорт закладок"), _mz_t("Очистити закладки", "Clear bookmarks", "Очистить закладки"),
                 _mz_t("Кількість закладок", "Number of bookmarks", "Количество закладок"), _mz_t("Перевірити й завантажити іконку", "Check and load icon", "Проверить и загрузить иконку"), _mz_t("Вимкнути Smart Bookmark", "Turn off Smart Bookmark", "Отключить Smart Bookmark")]
        callbacks = [self._default_category, self._categories_dialog,
                     lambda: self.set_setting("notify_saved", not self.get_setting("notify_saved", True)),
                     self._export, lambda: self._pick_document("import"), self._clear,
                     lambda: self._job(self._store.count, lambda n: self._notice(_mz_t("Закладок: ", "Bookmarks: ", "Закладок: ") + str(n))),
                     self._check_icon,
                     lambda: self._toggle(False)]
        self._choices(_mz_t("Налаштування · версія ", "Settings · version ", "Настройки · версия ") + __version__, items, lambda i: callbacks[i]())

    def _icon_report_header(self):
        lines = [_mz_t("Код плагіна: ", "Plugin code: ", "Код плагина: ") + __version__,
                 _mz_t("Версія в метаданих SDK: ", "Version in SDK metadata: ", "Версия в метаданных SDK: ") + str(getattr(self, "version", _mz_t("не передано", "not provided", "не передана"))),
                 _mz_t("Іконка у файлі: ", "Icon in the file: ", "Иконка в файле: ") + __icon__,
                 _mz_t("Іконка в метаданих SDK: ", "Icon in SDK metadata: ", "Иконка в метаданных SDK: ") + str(getattr(self, "icon", None) or _mz_t("не передано", "not provided", "не передана"))]
        try:
            import _sdk_version
            lines.append("SDK: " + str(_sdk_version.__version__))
        except Exception:
            lines.append(_mz_t("Версія SDK: недоступна", "SDK version: unavailable", "Версия SDK: недоступна"))
        try:
            from org.telegram.messenger import BuildVars
            lines.append(_mz_t("Застосунок: ", "App: ", "Приложение: ") + str(BuildVars.BUILD_VERSION_STRING))
        except Exception:
            pass
        return "\n".join(lines)

    def _show_icon_report(self, text):
        from android_utils import copy_to_clipboard
        dialog = self._dialog(_mz_t("Перевірка іконки", "Icon check", "Проверка иконки"))
        dialog.set_message(text)
        dialog.set_positive_button(_mz_t("Закрити", "Close", "Закрыть"), lambda b, w: b.dismiss())
        dialog.set_neutral_button(_mz_t("Скопіювати звіт", "Copy report", "Скопировать отчёт"), lambda b, w: copy_to_clipboard(text))
        dialog.show()

    def _check_icon(self):
        """Explicit sticker read/cache warm-up; does not install a sticker set.

        Host plugin-list rendering is not hooked or replaced. Report distinguishes
        stale host metadata from an inaccessible/empty set instead of guessing.
        """
        from org.telegram.messenger import UserConfig, MediaDataController
        from org.telegram.tgnet import TLRPC, ConnectionsManager
        from client_utils import RequestCallback
        if getattr(self, "_icon_loading", False):
            self._notice(_mz_t("Перевірка іконки вже триває…", "Icon check is already running…", "Проверка иконки уже выполняется…"))
            return
        header = self._icon_report_header()
        account = int(UserConfig.selectedAccount)
        config = UserConfig.getInstance(account)
        if not config.isClientActivated():
            self._show_icon_report(header + _mz_t("\n\nНемає підключеного акаунта для перевірки набору.", "\n\nNo connected account to check the set.", "\n\nНет подключённого аккаунта для проверки набора."))
            return
        owner = int(config.getClientUserId())
        request = TLRPC.TL_messages_getStickerSet()
        request.stickerset = TLRPC.TL_inputStickerSetShortName()
        request.stickerset.short_name = "SmartBookmark"
        request.hash = 0
        manager = ConnectionsManager.getInstance(account)
        epoch = self._epoch
        navigation_epoch = getattr(self, "_navigation_epoch", self._epoch)
        completed, handle = [False], [None]
        def valid():
            return (self._alive and self._epoch is epoch and
                    getattr(self, "_navigation_epoch", self._epoch) is navigation_epoch)
        def finish_report(text):
            completed[0] = True
            self._icon_loading = False
            if handle[0] in self._requests:
                self._requests.remove(handle[0])
            self._show_icon_report(header + "\n\n" + text)
        def response(result, error):
            def finish():
                if completed[0] or not valid():
                    return
                if error is not None:
                    code = str(getattr(error, "text", ""))
                    if not re.fullmatch(r"[A-Z0-9_]{1,80}", code):
                        code = "НЕИЗВЕСТНАЯ_ОШИБКА"
                    finish_report(_mz_t("Telegram не повернув набір. Код: ", "Telegram didn't return the set. Code: ", "Telegram не вернул набор. Код: ") + code +
                                  _mz_t("\nПеревірте мережу й доступність набору в цьому акаунті.", "\nCheck your network and the set's availability in this account.", "\nПроверьте сеть и доступность набора в этом аккаунте."))
                    return
                if result is None or not isinstance(result, TLRPC.TL_messages_stickerSet):
                    finish_report(_mz_t("Неочікувана відповідь Telegram. Кеш і метадані не змінено.", "Unexpected Telegram response. The cache and metadata were not changed.", "Неожиданный ответ Telegram. Кэш и метаданные не изменены."))
                    return
                count = int(result.documents.size())
                name = str(result.set.short_name or "")
                if fold(name) != "smartbookmark" or count < 1:
                    finish_report(_mz_t("Набір: ", "Set: ", "Набор: ") + name + _mz_t("\nНаліпок: ", "\nStickers: ", "\nСтикеров: ") + str(count) +
                                  _mz_t("\nНе можна вибрати першу наліпку. Кеш не змінено.", "\nThe first sticker can't be selected. The cache was not changed.", "\nНельзя выбрать первый стикер. Кэш не изменён."))
                    return
                if not config.isClientActivated() or int(config.getClientUserId()) != owner:
                    finish_report(_mz_t("Акаунт змінився під час перевірки. Повторіть дію.", "The account changed during the check. Try again.", "Аккаунт изменился во время проверки. Повторите действие."))
                    return
                text = _mz_t("Набір: ", "Set: ", "Набор: ") + name + _mz_t("\nНаліпок: ", "\nStickers: ", "\nСтикеров: ") + str(count) + _mz_t("\nВибрано індекс: 0", "\nSelected index: 0", "\nВыбран индекс: 0")
                try:
                    # Verified Telegram API; updates its cache and emits stickersDidLoad.
                    # This does NOT call messages.installStickerSet or send a message.
                    MediaDataController.getInstance(account).putStickerSet(result, True)
                    text += _mz_t("\nНабір збережено в кеш клієнта.", "\nThe set was saved to the client cache.", "\nНабор сохранён в кэш клиента.")
                except Exception as exc:
                    self.log("Smart Bookmark icon cache: " + type(exc).__name__)
                    text += _mz_t("\nНе вдалося оновити кеш у цій збірці застосунку.", "\nCouldn't update the cache in this app build.", "\nНе удалось обновить кэш в этой сборке приложения.")
                actual = str(getattr(self, "icon", None) or "")
                if actual != __icon__:
                    text += _mz_t("\n\nМетадані SDK відрізняються від файла. Оновіть плагін через інсталятор; ", "\n\nSDK metadata differs from the file. Update the plugin through the installer; ", "\n\nМетаданные SDK отличаются от файла. Обновите плагин через установщик; ")
                    text += _mz_t("самого перемикання вмикання недостатньо. Не видаляйте дані застосунку.", "toggling it on and off is not enough. Don't delete the app data.", "одного переключения включения недостаточно. Не удаляйте данные приложения.")
                else:
                    text += _mz_t("\n\nМетадані збігаються. Поверніться до списку плагінів і відкрийте його знову. ", "\n\nMetadata matches. Go back to the plugin list and open it again. ", "\n\nМетаданные совпадают. Вернитесь к списку плагинов и откройте его заново. ")
                    text += _mz_t("Якщо значка досі немає, надішліть цей звіт і знімок екрана: ", "If the icon is still missing, send this report and a screenshot: ", "Если значка всё ещё нет, пришлите этот отчёт и скриншот: ")
                    text += _mz_t("потрібна перевірка відображення саме у вашій збірці, а не зміна індексу.", "the rendering needs to be checked in your exact build, not the index changed.", "нужна проверка отрисовки именно вашей сборки, а не смена индекса.")
                finish_report(text)
            def safely_finish():
                try:
                    finish()
                except Exception as exc:
                    self.log("Smart Bookmark icon response: " + type(exc).__name__)
                    if valid() and not completed[0]:
                        finish_report(_mz_t("Не вдалося обробити відповідь щодо набору в цій збірці застосунку. Передайте цей звіт розробнику; дані закладок не змінено.", "Couldn't process the set response in this app build. Pass this report to the developer; bookmark data was not changed.", ("Не удалось обработать ответ набора в этой сборке приложения. "
                                      "Передайте этот отчёт разработчику; данные закладок не изменены.")))
            self._ui(lambda: self._guard(safely_finish))
        self._icon_loading = True
        try:
            request_id = manager.sendRequest(request, RequestCallback(response))
        except Exception as exc:
            self.log("Smart Bookmark icon request: " + type(exc).__name__)
            finish_report(_mz_t("Не вдалося виконати запит набору в цій збірці застосунку.", "Couldn't run the set request in this app build.", "Не удалось выполнить запрос набора в этой сборке приложения."))
            return
        handle[0] = (manager, request_id)
        if not completed[0]:
            self._requests.append(handle[0])
        self._notice(_mz_t("Перевіряємо набір і метадані іконки…", "Checking the set and icon metadata…", "Проверяем набор и метаданные иконки…"))
        def timeout():
            if completed[0] or not valid():
                return
            try:
                manager.cancelRequest(request_id, True)
            finally:
                finish_report(_mz_t("Telegram не відповів за 15 секунд. Перевірте мережу й повторіть перевірку.", "Telegram didn't respond within 15 seconds. Check your network and try again.", "Telegram не ответил за 15 секунд. Проверьте сеть и повторите проверку."))
        self._ui(lambda: self._guard(timeout), 15000)

    # Android Storage Access Framework; only this narrow UI-result hook is needed.
    # No broad JSON file handler, no permission to access arbitrary shared files.
    def _setup_documents(self):
        from hook_utils import find_class
        from java import jint
        self._document_hook = False
        try:
            method = find_class("org.telegram.ui.LaunchActivity").getDeclaredMethod(
                "onActivityResult", jint, jint, find_class("android.content.Intent"))
            method.setAccessible(True)
            self._document_hook = bool(self.hook_method(method, after=self._document_result))
        except Exception as exc:
            self.log("Smart Bookmark: SAF " + type(exc).__name__)

    def _export(self):
        self._confirm(_mz_t("Експорт нотаток і закладок", "Export notes and bookmarks", "Экспорт заметок и закладок"), _mz_t("JSON-файл може містити конфіденційне листування, нотатки та ID акаунтів. Він не зашифрований. Зберігайте його безпечно; вибір хмарного сховища передасть файл цьому провайдеру.", "The JSON file may contain private conversations, notes and account IDs. It is not encrypted. Store it safely; choosing cloud storage will hand the file to that provider.", ("JSON-файл может содержать конфиденциальную переписку, заметки и ID аккаунтов. "
                      "Он не зашифрован. Храните его безопасно; выбор облачного хранилища передаст файл этому провайдеру.")),
                      lambda: self._pick_document("export"))

    def _pick_document(self, mode):
        from android.content import Intent
        if not self._document_hook:
            raise BookmarkError(_mz_t("Системний вибір файлів недоступний у цій збірці застосунку.", "The system file picker is not available in this app build.", "Системный выбор файлов недоступен в этой сборке приложения."))
        if self._pending_document:
            raise BookmarkError(_mz_t("Спочатку завершіть відкритий вибір файла.", "Finish the open file selection first.", "Сначала завершите открытый выбор файла."))
        activity = self._activity()
        request = 27441 if mode == "import" else 27442
        intent = Intent(Intent.ACTION_OPEN_DOCUMENT if mode == "import" else Intent.ACTION_CREATE_DOCUMENT)
        intent.addCategory(Intent.CATEGORY_OPENABLE)
        intent.setType("*/*" if mode == "import" else "application/json")
        if mode == "export":
            intent.putExtra(Intent.EXTRA_TITLE, "smart_bookmark_" + dt.datetime.now().strftime("%Y%m%d_%H%M%S") + ".json")
        self._pending_document = (request, mode, activity)
        try:
            activity.startActivityForResult(intent, request)
        except Exception:
            self._pending_document = None
            raise BookmarkError(_mz_t("На пристрої немає застосунку для вибору файлів.", "No file picker app on this device.", "На устройстве нет приложения для выбора файлов."))

    def _document_result(self, param):
        pending = self._pending_document
        if not self._alive or not pending or int(param.args[0]) != pending[0] or param.thisObject != pending[2]:
            return
        self._pending_document = None
        if int(param.args[1]) != -1 or param.args[2] is None:
            return
        uri = param.args[2].getData()
        if uri is None:
            return
        resolver = pending[2].getContentResolver()
        if pending[1] == "export":
            def export():
                with tempfile.TemporaryDirectory(prefix="smart-bookmark-") as directory:
                    path = os.path.join(directory, "backup.json")
                    write_backup(path, self._store.export_data())
                    self._copy_uri(resolver, uri, path, False)
            self._job(export, lambda _: self._notice(_mz_t("Експорт завершено. Пошкоджені записи пропущено.", "Export finished. Damaged entries were skipped.", "Экспорт завершён. Повреждённые записи пропущены.")
                if self._store.skipped_records else _mz_t("Експорт нотаток і закладок завершено", "Notes and bookmarks export finished", "Экспорт заметок и закладок завершён")))
        else:
            def stage():
                with tempfile.TemporaryDirectory(prefix="smart-bookmark-") as directory:
                    path = os.path.join(directory, "backup.json")
                    self._copy_uri(resolver, uri, path, True)
                    return read_backup(path)
            def preview(data):
                self._confirm(_mz_t("Імпорт резервної копії", "Import backup", "Импорт резервной копии"), _mz_t("Нотаток і завдань: %d. Закладок: %d. Категорій: %d. Наявні записи не зміняться, дублікати буде пропущено. Імпортувати?", "Notes and tasks: %d. Bookmarks: %d. Categories: %d. Existing entries won't change, duplicates will be skipped. Import?", ("Заметок и задач: %d. Закладок: %d. Категорий: %d. "
                    "Существующие записи не изменятся, дубликаты будут пропущены. Импортировать?")) %
                    (len(data.get("notes", [])), len(data["bookmarks"]), len(data["categories"])),
                    lambda: self._job(lambda: self._store.import_data(data), lambda result: self._notice(
                        _mz_t("Імпортовано: %d. Дублікатів пропущено: %d.", "Imported: %d. Duplicates skipped: %d.", "Импортировано: %d. Дубликатов пропущено: %d.") % result)))
            self._job(stage, preview)

    @staticmethod
    def _copy_uri(resolver, uri, path, importing):
        from java import jarray, jbyte
        from java.io import FileInputStream, FileOutputStream
        with contextlib.ExitStack() as stack:
            source = resolver.openInputStream(uri) if importing else FileInputStream(path)
            if source is None:
                raise BookmarkError(_mz_t("Не вдалося відкрити вибраний файл.", "Couldn't open the selected file.", "Не удалось открыть выбранный файл."))
            stack.callback(source.close)
            target = FileOutputStream(path) if importing else resolver.openOutputStream(uri, "wt")
            if target is None:
                raise BookmarkError(_mz_t("Не вдалося відкрити вибраний файл.", "Couldn't open the selected file.", "Не удалось открыть выбранный файл."))
            stack.callback(target.close)
            buffer = jarray(jbyte)(65536)
            total = 0
            while True:
                count = source.read(buffer)
                if count < 0:
                    break
                if count == 0:
                    continue
                total += count
                if total > MAX_BACKUP_BYTES:
                    raise BookmarkError(_mz_t("Файл перевищує допустимі 32 МБ.", "The file exceeds the 32 MB limit.", "Файл превышает допустимые 32 МБ."))
                target.write(buffer, 0, count)
            target.flush()

    def _open_original(self, record):
        from org.telegram.messenger import UserConfig, MessagesController
        from org.telegram.tgnet import TLRPC, ConnectionsManager
        from client_utils import RequestCallback
        from java.lang import Integer
        if not self._enabled():
            return
        if record["peer_kind"] == "secret" or record["message_id"] <= 0:
            raise BookmarkError(_mz_t("Точний перехід до секретного, відкладеного або ще не надісланого повідомлення не підтримується. Копію закладки збережено.", "Jumping exactly to a secret, scheduled or unsent message is not supported. The bookmark copy is saved.", "Точный переход к секретному, отложенному или ещё не отправленному сообщению не поддерживается. Копия закладки сохранена."))
        accounts = []
        for slot in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
            config = UserConfig.getInstance(slot)
            if config.isClientActivated():
                accounts.append((slot, int(config.getClientUserId())))
        account = choose_account(record, accounts)
        controller = MessagesController.getInstance(account)
        if record["peer_kind"] == "channel":
            request = TLRPC.TL_channels_getMessages()
            request.channel = controller.getInputChannel(-record["dialog_id"])
            if request.channel is None or int(request.channel.channel_id) == 0:
                raise BookmarkError(_mz_t("Канал недоступний у цьому акаунті. Відкрийте його вручну й повторіть.", "The channel is unavailable in this account. Open it manually and try again.", "Канал недоступен в этом аккаунте. Откройте его вручную и повторите."))
        else:
            request = TLRPC.TL_messages_getMessages()
        request.id.add(Integer(record["message_id"]))
        manager = ConnectionsManager.getInstance(account)
        epoch = self._epoch
        navigation_epoch = getattr(self, "_navigation_epoch", self._epoch)
        def valid():
            return (self._enabled() and self._epoch is epoch and
                    getattr(self, "_navigation_epoch", self._epoch) is navigation_epoch)
        completed = [False]
        handle = [None]
        def response(result, error):
            def finish():
                if completed[0] or not valid():
                    return
                completed[0] = True
                if handle[0] in self._requests:
                    self._requests.remove(handle[0])
                if error is not None or result is None:
                    self._notice(_mz_t("Оригінал недоступний. Перевірте підключення та доступ до чату. Закладку збережено.", "The original is unavailable. Check your connection and chat access. The bookmark is saved.", "Оригинал недоступен. Проверьте подключение и доступ к чату. Закладка сохранена."))
                    return
                messages = result.messages
                available = [(int(messages.get(i).id), isinstance(messages.get(i), TLRPC.TL_messageEmpty))
                             for i in range(messages.size())]
                if not original_available(available, record):
                    self._notice(_mz_t("Повідомлення видалено або воно недоступне. Збережена закладка залишилась.", "The message was deleted or is unavailable. The saved bookmark is kept.", "Сообщение удалено или недоступно. Сохранённая закладка осталась."))
                    return
                controller.putUsers(result.users, False)
                controller.putChats(result.chats, False)
                self._guard(lambda: self._navigate(record, account, controller))
            self._ui(lambda: self._guard(finish))
        request_id = manager.sendRequest(request, RequestCallback(response))
        handle[0] = (manager, request_id)
        self._requests.append(handle[0])
        self._notice(_mz_t("Перевірка доступності оригіналу…", "Checking if the original is available…", "Проверка доступности оригинала…"))
        def timeout():
            if completed[0] or not valid():
                return
            completed[0] = True
            manager.cancelRequest(request_id, True)
            if handle[0] in self._requests:
                self._requests.remove(handle[0])
            self._notice(_mz_t("Немає відповіді від Telegram. Перевірте мережу й повторіть. Закладку збережено.", "No response from Telegram. Check your network and try again. The bookmark is saved.", "Нет ответа от Telegram. Проверьте сеть и повторите. Закладка сохранена."))
        self._ui(timeout, 15000)

    def _navigate(self, record, account, controller):
        from android.os import Bundle
        from org.telegram.ui import ChatActivity
        from org.telegram.messenger import UserConfig, MessageObject
        from client_utils import get_last_fragment
        from android_utils import R
        from java.util import ArrayList
        navigation_epoch = getattr(self, "_navigation_epoch", self._epoch)
        def active():
            return self._enabled() and getattr(self, "_navigation_epoch", self._epoch) is navigation_epoch
        # Recheck identity after the asynchronous RPC (the user may have logged out).
        if int(UserConfig.getInstance(account).getClientUserId()) != record["account_user_id"]:
            raise BookmarkError(_mz_t("Акаунт змінився. Повторіть відкриття закладки.", "The account changed. Try opening the bookmark again.", "Аккаунт изменился. Повторите открытие закладки."))
        args = Bundle()
        if record["dialog_id"] > 0:
            args.putLong("user_id", record["dialog_id"])
        else:
            args.putLong("chat_id", -record["dialog_id"])
        args.putInt("message_id", record["message_id"])
        chat = ChatActivity(args)
        chat.setCurrentAccount(account)
        def present():
            if not active():
                return
            config = UserConfig.getInstance(account)
            if not config.isClientActivated() or int(config.getClientUserId()) != record["account_user_id"]:
                raise BookmarkError(_mz_t("Акаунт змінився. Повторіть відкриття закладки.", "The account changed. Try opening the bookmark again.", "Аккаунт изменился. Повторите открытие закладки."))
            if int(UserConfig.selectedAccount) != account:
                self._activity().switchToAccount(account, True)
            fragment = get_last_fragment()
            if fragment is None or not fragment.presentFragment(chat):
                raise BookmarkError(_mz_t("Не вдалося відкрити чат. Можливо, доступ до нього втрачено.", "Couldn't open the chat. Access to it may have been lost.", "Не удалось открыть чат. Возможно, доступ к нему потерян."))
            for dialog in self._dialogs[:]:
                dialog.dismiss()
        if record["topic_id"]:
            topics = controller.getTopicsController()
            epoch = self._epoch
            settled = [False]
            def ready():
                if settled[0] or not active() or self._epoch is not epoch:
                    return
                settled[0] = True
                topic = topics.findTopic(-record["dialog_id"], record["topic_id"])
                if topic is None or topic.topicStartMessage is None:
                    self._notice(_mz_t("Тему форуму видалено або вона недоступна. Закладку збережено.", "The forum topic was deleted or is unavailable. The bookmark is saved.", "Тема форума удалена или недоступна. Закладка сохранена."))
                    return
                objects = ArrayList()
                objects.add(MessageObject(account, topic.topicStartMessage, False, False))
                chat.setThreadMessages(objects, controller.getChat(-record["dialog_id"]), int(topic.id),
                                       int(topic.read_inbox_max_id), int(topic.read_outbox_max_id), topic)
                self._guard(present)
            if topics.findTopic(-record["dialog_id"], record["topic_id"]) is not None:
                ready()
            else:
                topics.loadTopic(-record["dialog_id"], record["topic_id"], R(lambda: self._ui(lambda: self._guard(ready))))
                def topic_timeout():
                    if not settled[0] and active() and self._epoch is epoch:
                        settled[0] = True
                        self._notice(_mz_t("Не вдалося завантажити тему форуму. Перевірте мережу й повторіть.", "Couldn't load the forum topic. Check your network and try again.", "Не удалось загрузить тему форума. Проверьте сеть и повторите."))
                self._ui(topic_timeout, 15000)
        else:
            present()
