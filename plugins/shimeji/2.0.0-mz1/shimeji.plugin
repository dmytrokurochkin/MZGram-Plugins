        return [
            Header(text="Shimeji"),
            Switch(
                key="enabled",
                text=_mz_t("Увімкнути", "Turn on", "Включить"),
                subtext=_mz_t("Показувати персонажа", "Show character", "Показывать персонажа"),
                default=True,
                icon="msg_settings",
                on_change=self._on_enable_change,
            ),
            Divider(),
            Header(text=_mz_t("Персонаж", "Character", "Персонаж")),
            Input(
                key="sprites_dir",
                text=_mz_t("Шлях до персонажа", "Character path", "Путь к персонажу"),
                default=INSTALL_DIR + "img/",
                icon="msg_settings",
                on_change=lambda v: self.ss("sprites_dir", str(v).strip()),
            ),
            Input(
                key="scale",
                text=_mz_t("Масштаб (0.5 – 3.0)", "Scale (0.5 – 3.0)", "Масштаб (0.5 – 3.0)"),
                default="1.0",
                icon="msg_settings",
                on_change=lambda v: self.ss("scale", str(v).strip()),
            ),
            Divider(),
            Header(text=_mz_t("Відступи", "Margins", "Отступы")),
            Input(
                key="bottom_offset",
                text=_mz_t("Відступ знизу", "Bottom margin", "Отступ снизу"),
                subtext=_mz_t("Якщо персонаж висить над підлогою, збільш значення", "If the character hovers above the floor, increase the value", "Если персонаж висит над полом — увеличь значение"),
                default="0",
                icon="msg_settings",
                on_change=lambda v: self.ss("bottom_offset", str(v).strip()),
            ),
            Input(
                key="climb_pad_left",
                text=_mz_t("Відступ лівої стіни", "Left wall margin", "Отступ левой стены"),
                subtext=_mz_t("Наскільки персонаж заходить за лівий край під час лазіння (типово: 52)", "How far the character goes past the left edge while climbing (default: 52)", "Насколько персонаж заходит за левый край при карабкании (дефолт: 52)"),
                default="52",
                icon="msg_settings",
                on_change=lambda v: (self.ss("climb_pad_left", str(v).strip()), self._restart_engine()),
            ),
            Input(
                key="climb_pad_right",
                text=_mz_t("Відступ правої стіни", "Right wall margin", "Отступ правой стены"),
                subtext=_mz_t("Наскільки персонаж заходить за правий край під час лазіння (типово: 52)", "How far the character goes past the right edge while climbing (default: 52)", "Насколько персонаж заходит за правый край при карабкании (дефолт: 52)"),
                default="52",
                icon="msg_settings",
                on_change=lambda v: (self.ss("climb_pad_right", str(v).strip()), self._restart_engine()),
            ),
            Divider(),
            Switch(
                key="drag_enabled",
                text=_mz_t("Перетягування", "Dragging", "Перетаскивание"),
                subtext=_mz_t("Тягни персонажа пальцем", "Drag the character with your finger", "Тащи персонажа пальцем"),
                default=True,
                icon="msg_settings",
                on_change=self._on_drag_toggle,
            ),
            Switch(
                key="show_borders",
                text=_mz_t("Показувати межі вікна", "Show window bounds", "Показывать границы окна"),
                subtext=_mz_t("Червона рамка навколо спрайта для налагодження", "Red frame around the sprite for debugging", "Красная рамка вокруг спрайта для отладки"),
                default=False,
                icon="msg_settings",
                on_change=self._on_borders_change,
            ),
            Text(
                text=_mz_t("Бібліотека персонажів", "Character library", "Библиотека персонажей"),
                icon="msg_settings",
                accent=True,
                on_click=self._open_library,
            ),
            Text(
                text=_mz_t("Локальна бібліотека", "Local library", "Локальная библиотека"),
                icon="msg_settings",
                on_click=self._open_local_library,
            ),
            Text(
                text=_mz_t("Перезапустити", "Restart", "Перезапустить"),
                icon="msg_settings",
                accent=True,
                on_click=self._restart_engine,
            ),
            Divider(text=f"v{__version__}"),
        ]

    def _on_enable_change(self, val: bool):
        if val:
            self._start_engine()
        else:
            self._stop_engine()

    def _on_drag_toggle(self, val: bool):
        if self._engine and self._engine._alive:
            if val:
                self._engine._renderer.enable_drag(on_drag_end=self._engine.on_drag_end)
            else:
                self._engine._renderer.disable_drag()

    def _on_borders_change(self, val: bool):
        if self._engine and self._engine._alive:
            self._engine._renderer.set_border_visible(val)

    # -- library -------------------------------------------

    def _open_library(self, view=None):
        """Opens a BottomSheet with a gallery of characters."""
        def _do():
            try:
                f   = get_last_fragment()
                ctx = f.getParentActivity() if f else None
                if not ctx:
                    BulletinHelper.show_error(_mz_t("Немає контексту", "No context", "Нет контекста"))
                    return
                self._show_library_sheet(ctx)
            except Exception as e:
                self._log(f"_open_library: {e}")
        run_on_ui_thread(_do)

    def _show_library_sheet(self, ctx):
        try:
            dp  = AndroidUtilities.dp
            LP  = LinearLayout.LayoutParams
            FLP = FrameLayout.LayoutParams
            p   = _palette()

            sh = BottomSheet(ctx, False)
            try: sh.setFullscreen(True)
            except Exception: pass
            try: sh.setCanDismissWithSwipe(False)
            except Exception: pass
            try: sh.setCanDrag(False)
            except Exception: pass

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(p["bg"])

            # Header
            bar = LinearLayout(ctx)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL)
            bar.setPadding(dp(16), dp(14), dp(12), dp(14))
            bar.setBackgroundColor(p["bar"])

            title_tv = TextView(ctx)
            title_tv.setText(_mz_t("Бібліотека персонажів", "Character library", "Библиотека персонажей"))
            title_tv.setTextSize(18.0)
            title_tv.setTextColor(p["title"])
            title_tv.setTypeface(title_tv.getTypeface(), 1)
            bar.addView(title_tv, LP(0, LP.WRAP_CONTENT, 1.0))

            # Close button: drawable icon
            close_iv = ImageView(ctx)
            close_ic = _drawable("msg_close") or _drawable("ic_close")
            if close_ic:
                close_iv.setImageResource(close_ic)
                close_iv.setColorFilter(p["hint"])
            else:
                close_iv = TextView(ctx)
                close_iv.setText("✕")
                close_iv.setTextSize(20.0)
                close_iv.setTextColor(p["hint"])
            close_iv.setPadding(dp(12), dp(8), dp(12), dp(8))
            close_iv.setOnClickListener(_make_click(lambda v: sh.dismiss()))
            bar.addView(close_iv, LP(dp(44), dp(44)))
            root.addView(bar, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            # Loading
            loading_tv = TextView(ctx)
            loading_tv.setText(_mz_t("Завантажую...", "Loading...", "Загружаю..."))
            loading_tv.setTextColor(p["hint"])
            loading_tv.setTextSize(15.0)
            loading_tv.setGravity(Gravity.CENTER)
            loading_tv.setPadding(dp(20), dp(60), dp(20), dp(60))
            root.addView(loading_tv, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            sh.setCustomView(root)
            sh.show()

            plugin = self
            def _load():
                try:
                    import requests
                    resp = requests.get(GITHUB_INDEX, timeout=10)
                    if resp.status_code != 200:
                        run_on_ui_thread(lambda: loading_tv.setText(_mz_t(f"Помилка: HTTP {resp.status_code}", f"Error: HTTP {resp.status_code}", f"Ошибка: HTTP {resp.status_code}")))
                        return
                    packs = resp.json()
                    def _build():
                        try:
                            root.removeView(loading_tv)

                            # Group by universe
                            from collections import OrderedDict
                            universes = OrderedDict()
                            universes[_mz_t("Усі", "All", "Все")] = packs
                            for pack in packs:
                                u = pack.get("universe", _mz_t("Інше", "Other", "Другое"))
                                universes.setdefault(u, []).append(pack)

                            # -- Tab bar ------------------------------------
                            tabs = [(k, k) for k in universes.keys()]
                            current = [tabs[0][0]]   # active tab

                            tab_shell, set_active = _build_pill_tabs(ctx, p, tabs,
                                lambda k: (current.__setitem__(0, k), _show_tab(k)))

                            lp_tabs = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
                            lp_tabs.topMargin    = dp(8)
                            lp_tabs.bottomMargin = dp(8)
                            lp_tabs.leftMargin   = dp(12)
                            lp_tabs.rightMargin  = dp(12)
                            root.addView(tab_shell, lp_tabs)

                            # -- Content under the tabs ---------------------
                            scroll = ScrollView(ctx)
                            scroll.setVerticalScrollBarEnabled(False)
                            grid = LinearLayout(ctx)
                            grid.setOrientation(LinearLayout.VERTICAL)
                            grid.setPadding(dp(12), dp(4), dp(12), dp(80))
                            scroll.addView(grid, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
                            root.addView(scroll, LP(LP.MATCH_PARENT, LP.MATCH_PARENT))

                            def _show_tab(key):
                                def _ui():
                                    grid.removeAllViews()
                                    chars = universes.get(key, [])
                                    for pack in chars:
                                        plugin._add_list_row(ctx, grid, pack, sh, p, dp, LP, FLP)
                                    scroll.scrollTo(0, 0)
                                run_on_ui_thread(_ui)

                            _show_tab(tabs[0][0])
                        except Exception as e:
                            plugin._log(f"_build: {e}\n{traceback.format_exc()}")
                    run_on_ui_thread(_build)
                except Exception as e:
                    plugin._log(f"_load: {e}")
                    run_on_ui_thread(lambda: loading_tv.setText(_mz_t(f"Помилка: {e}", f"Error: {e}", f"Ошибка: {e}")))
            import threading
            threading.Thread(target=_load, daemon=True).start()

        except Exception as e:
            self._log(f"_show_library_sheet: {e}\n{traceback.format_exc()}")

    def _add_list_row(self, ctx, parent, pack, sh, p, dp, LP, FLP):
        try:
            pid       = pack.get("id", "")
            name      = pack.get("name", pid)
            author    = pack.get("author", "?")
            sprites   = pack.get("sprites", "?")
            scale     = pack.get("scale_recommended", 1.0)
            thumb_url = GITHUB_RAW + pack.get("thumb", "")
            installed = self._is_pack_installed(pid)
            plugin    = self

            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(12), dp(10), dp(12), dp(10))
            from android.graphics.drawable import GradientDrawable as _GD
            gd = _GD(); gd.setColor(p["card"]); gd.setCornerRadius(dp(12))
            row.setBackground(gd)
            lp_row = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_row.bottomMargin = dp(8)

            # thumb.png preview
            iv = ImageView(ctx)
            iv.setScaleType(ImageView.ScaleType.CENTER_CROP)
            gd2 = _GD(); gd2.setColor(p["bg"]); gd2.setCornerRadius(dp(8))
            iv.setBackground(gd2)
            lp_iv = LP(dp(64), dp(64))
            lp_iv.rightMargin = dp(12)
            row.addView(iv, lp_iv)

            def _load_thumb(v=iv, url=thumb_url):
                try:
                    import requests as req
                    r = req.get(url, timeout=10)
                    if r.status_code == 200:
                        data = bytearray(r.content)
                        bm = BitmapFactory.decodeByteArray(data, 0, len(data))
                        if bm:
                            run_on_ui_thread(lambda b=bm, vi=v: (vi.setImageBitmap(b), vi.setBackgroundColor(0)))
                except Exception: pass
            import threading
            threading.Thread(target=_load_thumb, daemon=True).start()

            # Text
            info = LinearLayout(ctx)
            info.setOrientation(LinearLayout.VERTICAL)

            name_tv = TextView(ctx)
            # "installed" icon: a drawable instead of an emoji
            name_tv.setText(name)
            name_tv.setTextSize(16.0)
            name_tv.setTextColor(p["text"])
            name_tv.setTypeface(name_tv.getTypeface(), 1)
            if installed:
                ic = _drawable("msg_check") or _drawable("checkmark") or _drawable("ic_check")
                if ic:
                    from android.graphics.drawable import Drawable
                    try:
                        d = ctx.getDrawable(ic)
                        if d:
                            d.setColorFilter(p["accent"],
                                android.graphics.PorterDuff.Mode.SRC_IN if hasattr(android.graphics, "PorterDuff") else None)
                            d.setBounds(0, 0, dp(16), dp(16))
                            name_tv.setCompoundDrawables(None, None, d, None)
                            name_tv.setCompoundDrawablePadding(dp(4))
                    except Exception: pass
            info.addView(name_tv, LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT))

            meta_tv = TextView(ctx)
            meta_tv.setText(_mz_t(f"{author}  •  спрайтів: {sprites}  •  x{scale}", f"{author}  •  {sprites} sprites  •  x{scale}", f"{author}  •  {sprites} спрайтов  •  x{scale}"))
            meta_tv.setTextSize(12.0)
            meta_tv.setTextColor(p["hint"])
            lp_m = LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT)
            lp_m.topMargin = dp(2)
            info.addView(meta_tv, lp_m)
            row.addView(info, LP(0, LP.WRAP_CONTENT, 1.0))

            # Forward arrow: drawable
            arr_iv = ImageView(ctx)
            arr_ic = _drawable("msg_arrow_forward") or _drawable("ic_ab_forward") or _drawable("ic_arrow_right")
            if arr_ic:
                arr_iv.setImageResource(arr_ic)
                arr_iv.setColorFilter(p["hint"])
                arr_iv.setPadding(dp(4), dp(4), dp(4), dp(4))
                row.addView(arr_iv, LP(dp(24), dp(24)))
            else:
                arr_tv = TextView(ctx)
                arr_tv.setText("›")
                arr_tv.setTextSize(24.0)
                arr_tv.setTextColor(p["hint"])
                row.addView(arr_tv, LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT))

            row.setOnClickListener(_make_click(
                lambda v, pk=pack, nt=name_tv: plugin._open_pack_detail(ctx, pk, sh, p, dp, LP, FLP, nt)
            ))
            parent.addView(row, lp_row)
        except Exception as e:
            self._log(f"_add_list_row: {e}\n{traceback.format_exc()}")

    def _open_pack_detail(self, ctx, pack, parent_sh, p, dp, LP, FLP, name_tv_ref=None):
        try:
            pid       = pack.get("id", "")
            name      = pack.get("name", pid)
            author    = pack.get("author", "?")
            sprites   = pack.get("sprites", "?")
            scale     = pack.get("scale_recommended", 1.0)
            zip_url   = GITHUB_RAW + pack.get("zip", "")
            thumb_url = GITHUB_RAW + pack.get("thumb", "")
            subdir    = pack.get("zip_subdir", "")
            installed = self._is_pack_installed(pid)
            plugin    = self

            sh2 = BottomSheet(ctx, False)
            try: sh2.setFullscreen(False)
            except Exception: pass
            try: sh2.setCanDismissWithSwipe(True)
            except Exception: pass

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(p["bg"])
            root.setPadding(dp(16), dp(16), dp(16), dp(32))

            # Name
            name_tv = TextView(ctx)
            name_tv.setText(name)
            name_tv.setTextSize(22.0)
            name_tv.setTextColor(p["text"])
            name_tv.setTypeface(name_tv.getTypeface(), 1)
            name_tv.setGravity(Gravity.CENTER_HORIZONTAL)
            root.addView(name_tv, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            # Meta: no emoji, via a string
            meta_tv = TextView(ctx)
            meta_tv.setText(_mz_t(f"{author}   спрайтів: {sprites}   x{scale}", f"{author}   {sprites} sprites   x{scale}", f"{author}   {sprites} спрайтов   x{scale}"))
            meta_tv.setTextSize(13.0)
            meta_tv.setTextColor(p["hint"])
            meta_tv.setGravity(Gravity.CENTER_HORIZONTAL)
            lp_mt = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_mt.topMargin = dp(4)
            lp_mt.bottomMargin = dp(16)
            root.addView(meta_tv, lp_mt)

            # Preview: thumb.png instead of gif
            prev_iv = ImageView(ctx)
            prev_iv.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            from android.graphics.drawable import GradientDrawable as _GD3
            gd3 = _GD3(); gd3.setColor(p["card"]); gd3.setCornerRadius(dp(16))
            prev_iv.setBackground(gd3)
            lp_img = LP(LP.MATCH_PARENT, dp(280))
            lp_img.bottomMargin = dp(20)
            root.addView(prev_iv, lp_img)

            def _load_preview(v=prev_iv, url=thumb_url):
                try:
                    import requests as req
                    r = req.get(url, timeout=10)
                    if r.status_code == 200:
                        data = bytearray(r.content)
                        bm = BitmapFactory.decodeByteArray(data, 0, len(data))
                        if bm:
                            run_on_ui_thread(lambda b=bm, vi=v: (vi.setImageBitmap(b), vi.setBackgroundColor(0)))
                except Exception: pass
            import threading
            threading.Thread(target=_load_preview, daemon=True).start()

            # Install button
            btn_install = TextView(ctx)
            btn_install.setText(_mz_t("Перевстановити", "Reinstall", "Переустановить") if installed else _mz_t("Встановити", "Install", "Установить"))
            btn_install.setTextSize(16.0)
            btn_install.setTextColor(p["bg"])
            btn_install.setGravity(Gravity.CENTER)
            btn_install.setPadding(dp(16), dp(14), dp(16), dp(14))
            # Download icon
            dl_ic = _drawable("msg_download") or _drawable("attach_file")
            if dl_ic and not installed:
                btn_install.setCompoundDrawablePadding(dp(6))
                try:
                    d = ctx.getDrawable(dl_ic)
                    if d:
                        d.setBounds(0, 0, dp(18), dp(18))
                        btn_install.setCompoundDrawables(d, None, None, None)
                except Exception: pass
            from android.graphics.drawable import GradientDrawable as _GD4
            gd4 = _GD4(); gd4.setColor(p["accent"]); gd4.setCornerRadius(dp(12))
            btn_install.setBackground(gd4)
            lp_btn = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_btn.bottomMargin = dp(10)

            def _on_install(v, z=zip_url, i=pid, s=scale, sd=subdir, n=name):
                btn_install.setText(_mz_t("Завантажую...", "Downloading...", "Скачиваю..."))
                btn_install.setEnabled(False)
                def _done(ok):
                    def _ui():
                        btn_install.setText(_mz_t("Встановлено", "Installed", "Установлен") if ok else _mz_t("Помилка", "Error", "Ошибка"))
                        btn_install.setEnabled(True)
                        if ok:
                            name_tv.setText(n)
                            if name_tv_ref: name_tv_ref.setText(n)
                            btn_delete.setVisibility(View.VISIBLE)
                    run_on_ui_thread(_ui)
                plugin._install_pack(z, i, s, sd, on_done=_done, name=n)
            btn_install.setOnClickListener(_make_click(_on_install))
            root.addView(btn_install, lp_btn)

            # Delete button
            btn_delete = TextView(ctx)
            btn_delete.setText(_mz_t("Видалити", "Delete", "Удалить"))
            btn_delete.setTextSize(15.0)
            btn_delete.setTextColor(p["text"])
            btn_delete.setGravity(Gravity.CENTER)
            btn_delete.setPadding(dp(16), dp(12), dp(16), dp(12))
            btn_delete.setVisibility(View.VISIBLE if installed else View.GONE)
            # Delete icon
            del_ic = _drawable("msg_delete") or _drawable("ic_delete")
            if del_ic:
                try:
                    d = ctx.getDrawable(del_ic)
                    if d:
                        d.setBounds(0, 0, dp(18), dp(18))
                        btn_delete.setCompoundDrawables(d, None, None, None)
                        btn_delete.setCompoundDrawablePadding(dp(6))
                except Exception: pass
            from android.graphics.drawable import GradientDrawable as _GD5
            gd5 = _GD5(); gd5.setColor(p["card"]); gd5.setCornerRadius(dp(12))
            btn_delete.setBackground(gd5)

            def _on_delete(v, i=pid):
                try:
                    import shutil
                    path = os.path.join(INSTALL_DIR, i)
                    if os.path.isdir(path): shutil.rmtree(path)
                    BulletinHelper.show_success(_mz_t(f"{name} видалено", f"{name} deleted", f"{name} удалён"))
                    btn_delete.setVisibility(View.GONE)
                    btn_install.setText(_mz_t("Встановити", "Install", "Установить"))
                    name_tv.setText(name)
                    if name_tv_ref: name_tv_ref.setText(name)
                    sh2.dismiss()
                except Exception as e:
                    plugin._log(f"delete: {e}")
                    BulletinHelper.show_error(str(e))
            btn_delete.setOnClickListener(_make_click(_on_delete))
            root.addView(btn_delete, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            sh2.setCustomView(root)
            sh2.show()
        except Exception as e:
            self._log(f"_open_pack_detail: {e}\n{traceback.format_exc()}")

    def _add_pack_card(self, ctx, parent, pack, sh, p, dp, LP, FLP):
        self._add_list_row(ctx, parent, pack, sh, p, dp, LP, FLP)


    # -- local library -----------------------------------

    def _open_local_library(self, view=None):
        """Opens the local character library."""
        def _do():
            try:
                f   = get_last_fragment()
                ctx = f.getParentActivity() if f else None
                if not ctx:
                    BulletinHelper.show_error(_mz_t("Немає контексту", "No context", "Нет контекста"))
                    return
                self._show_local_library_sheet(ctx)
            except Exception as e:
                self._log(f"_open_local_library: {e}")
        run_on_ui_thread(_do)

    def _show_sprite_guide(self, ctx, p, dp, LP, FLP):
        """Instruction window: how to name sprites in the archive."""
        try:
            sh = BottomSheet(ctx, False)
            try: sh.setFullscreen(True)
            except Exception: pass
            try: sh.setCanDismissWithSwipe(True)
            except Exception: pass

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(p["bg"])

            # Header
            bar = LinearLayout(ctx)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL)
            bar.setPadding(dp(16), dp(14), dp(12), dp(14))
            bar.setBackgroundColor(p["bar"])
            title_tv = TextView(ctx)
            title_tv.setText(_mz_t("Як підготувати спрайти", "How to prepare sprites", "Как подготовить спрайты"))
            title_tv.setTextSize(18.0)
            title_tv.setTextColor(p["title"])
            title_tv.setTypeface(title_tv.getTypeface(), 1)
            bar.addView(title_tv, LP(0, LP.WRAP_CONTENT, 1.0))
            close_iv = ImageView(ctx)
            close_ic = _drawable("msg_close") or _drawable("ic_close")
            if close_ic:
                close_iv.setImageResource(close_ic)
                close_iv.setColorFilter(p["hint"])
            close_iv.setPadding(dp(8), dp(8), dp(12), dp(8))
            close_iv.setOnClickListener(_make_click(lambda v: sh.dismiss()))
            bar.addView(close_iv, LP(dp(44), dp(44)))
            root.addView(bar, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            scroll = ScrollView(ctx)
            body = LinearLayout(ctx)
            body.setOrientation(LinearLayout.VERTICAL)
            body.setPadding(dp(16), dp(16), dp(16), dp(40))

            from android.graphics.drawable import GradientDrawable as _GD

            def _section(title, color=None):
                tv = TextView(ctx)
                tv.setText(title)
                tv.setTextSize(16.0)
                tv.setTextColor(color or p["accent"])
                tv.setTypeface(tv.getTypeface(), 1)
                lp = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
                lp.topMargin = dp(16)
                lp.bottomMargin = dp(8)
                body.addView(tv, lp)

            def _para(text):
                tv = TextView(ctx)
                tv.setText(text)
                tv.setTextSize(14.0)
                tv.setTextColor(p["text"])
                lp = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
                lp.bottomMargin = dp(6)
                body.addView(tv, lp)

            def _chip(name, desc, required=True):
                row = LinearLayout(ctx)
                row.setOrientation(LinearLayout.HORIZONTAL)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setPadding(dp(10), dp(8), dp(10), dp(8))
                gd = _GD()
                gd.setColor(p["card"])
                gd.setCornerRadius(dp(8))
                row.setBackground(gd)
                lp_r = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
                lp_r.bottomMargin = dp(4)

                # File name
                name_tv = TextView(ctx)
                name_tv.setText(name)
                name_tv.setTextSize(13.0)
                name_tv.setTextColor(p["accent"])
                name_tv.setTypeface(name_tv.getTypeface(), 1)
                lp_n = LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT)
                lp_n.rightMargin = dp(8)
                row.addView(name_tv, lp_n)

                # Description
                desc_tv = TextView(ctx)
                desc_tv.setText(desc)
                desc_tv.setTextSize(12.0)
                desc_tv.setTextColor(p["hint"])
                row.addView(desc_tv, LP(0, LP.WRAP_CONTENT, 1.0))

                # Required label
                req_tv = TextView(ctx)
                req_tv.setText(_mz_t("обов.", "required", "обяз.") if required else _mz_t("необов.", "optional", "необяз."))
                req_tv.setTextSize(11.0)
                req_tv.setTextColor(p["accent"] if required else p["hint"])
                row.addView(req_tv, LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT))

                body.addView(row, lp_r)

            # -- Content --------------------------------------
            _section(_mz_t("Формат архіву", "Archive format", "Формат архива"))
            _para(_mz_t("ZIP-архів із PNG-файлами 128×128 пікселів на прозорому тлі.", "A ZIP archive with PNG files of 128×128 pixels on a transparent background.", "ZIP-архив содержащий PNG файлы 128×128 пикселей с прозрачным фоном."))
            _para(_mz_t("Імена файлів: shime1.png, shime2.png, ... (регістр не важливий)", "File names: shime1.png, shime2.png, ... (case does not matter)", "Имена файлов: shime1.png, shime2.png, ... (регистр не важен)"))
            _para(_mz_t("Файли можуть лежати в корені архіву або в одній підпапці.", "Files can be in the archive root or in one subfolder.", "Файлы могут лежать в корне архива или в одной подпапке."))

            _section(_mz_t("Основні спрайти", "Main sprites", "Основные спрайты"))
            _chip("shime1.png",  _mz_t("Стоїть: головний спрайт", "Standing: the main sprite", "Стоит — главный спрайт"),          True)
            _chip("shime2.png",  _mz_t("Іде: крок 1", "Walking: step 1", "Идёт — шаг 1"),                    True)
            _chip("shime3.png",  _mz_t("Іде: крок 2", "Walking: step 2", "Идёт — шаг 2"),                    True)
            _chip("shime4.png",  _mz_t("Падає вниз", "Falling down", "Падает вниз"),                      True)
            _chip("shime11.png", _mz_t("Сидить на підлозі", "Sitting on the floor", "Сидит на полу"),                    True)
            _chip("shime18.png", _mz_t("Приземлення: кадр 1", "Landing: frame 1", "Приземление — кадр 1"),             True)
            _chip("shime19.png", _mz_t("Приземлення: кадр 2", "Landing: frame 2", "Приземление — кадр 2"),             True)
            _chip("shime22.png", _mz_t("Стрибок", "Jump", "Прыжок"),                           False)

            _section(_mz_t("Перетягування (drag)", "Dragging (drag)", "Перетаскивание (drag)"))
            _chip("shime5.png",  _mz_t("Тягнуть: кадр 1", "Being dragged: frame 1", "Тащат — кадр 1"),                  False)
            _chip("shime6.png",  _mz_t("Тягнуть: кадр 2", "Being dragged: frame 2", "Тащат — кадр 2"),                  False)
            _chip("shime7.png",  _mz_t("Тягнуть: кадр 3", "Being dragged: frame 3", "Тащат — кадр 3"),                  False)
            _chip("shime8-10.png", _mz_t("Тягнуть: кадри 4-6", "Being dragged: frames 4-6", "Тащат — кадры 4-6"),             False)

            _section(_mz_t("Лазіння по стінах", "Climbing walls", "Карабкание по стенам"))
            _chip("shime12.png", _mz_t("Стіна: кадр 1", "Wall: frame 1", "Стена — кадр 1"),                  False)
            _chip("shime13.png", _mz_t("Стіна: кадр 2", "Wall: frame 2", "Стена — кадр 2"),                  False)
            _chip("shime14.png", _mz_t("Стіна: кадр 3", "Wall: frame 3", "Стена — кадр 3"),                  False)

            _section(_mz_t("Стеля", "Ceiling", "Потолок"))
            _chip("shime23.png", _mz_t("Стеля: кадр 1", "Ceiling: frame 1", "Потолок — кадр 1"),                False)
            _chip("shime24.png", _mz_t("Стеля: кадр 2", "Ceiling: frame 2", "Потолок — кадр 2"),                False)
            _chip("shime25.png", _mz_t("Стеля: кадр 3", "Ceiling: frame 3", "Потолок — кадр 3"),                False)

            _section(_mz_t("Відпочинок та інше", "Rest and other", "Отдых и другое"))
            _chip("shime20.png", _mz_t("Лежить: кадр 1", "Lying: frame 1", "Лежит — кадр 1"),                  False)
            _chip("shime21.png", _mz_t("Лежить: кадр 2", "Lying: frame 2", "Лежит — кадр 2"),                  False)
            _chip("shime26.png", _mz_t("Дивиться вгору", "Looking up", "Смотрит вверх"),                   False)

            _section(_mz_t("Розкадрування", "Storyboard", "Раскадровка"))
            # Load the guide image from GitHub
            guide_tv = TextView(ctx)
            guide_tv.setText(_mz_t("Завантажую розкадрування...", "Loading storyboard...", "Загружаю раскадровку..."))
            guide_tv.setTextSize(13.0)
            guide_tv.setTextColor(p["hint"])
            guide_tv.setGravity(Gravity.CENTER)
            body.addView(guide_tv, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            guide_iv = ImageView(ctx)
            guide_iv.setScaleType(ImageView.ScaleType.FIT_CENTER)
            guide_iv.setAdjustViewBounds(True)
            lp_gi = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_gi.topMargin = dp(8)
            body.addView(guide_iv, lp_gi)

            def _load_guide():
                try:
                    import requests as req
                    url = GITHUB_RAW + "sprite_guide.png"
                    r = req.get(url, timeout=15)
                    if r.status_code == 200:
                        data = bytearray(r.content)
                        bm = BitmapFactory.decodeByteArray(data, 0, len(data))
                        if bm:
                            def _ui(b=bm):
                                from android.view import View as _V2
                                guide_tv.setVisibility(_V2.GONE)
                                guide_iv.setImageBitmap(b)
                            run_on_ui_thread(_ui)
                    else:
                        run_on_ui_thread(lambda: guide_tv.setText(
                            _mz_t(f"Розкадрування недоступне (HTTP {r.status_code})", f"Storyboard unavailable (HTTP {r.status_code})", f"Раскадровка недоступна (HTTP {r.status_code})")))
                except Exception as e:
                    run_on_ui_thread(lambda: guide_tv.setText(_mz_t(f"Помилка завантаження: {e}", f"Loading error: {e}", f"Ошибка загрузки: {e}")))
            import threading
            threading.Thread(target=_load_guide, daemon=True).start()

            scroll.addView(body, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
            root.addView(scroll, LP(LP.MATCH_PARENT, LP.MATCH_PARENT))
            sh.setCustomView(root)
            sh.show()
        except Exception as e:
            self._log(f"_show_sprite_guide: {e}\n{traceback.format_exc()}")

    def _show_local_library_sheet(self, ctx):
        try:
            dp  = AndroidUtilities.dp
            LP  = LinearLayout.LayoutParams
            FLP = FrameLayout.LayoutParams
            p   = _palette()
            plugin = self

            sh = BottomSheet(ctx, False)
            try: sh.setFullscreen(True)
            except Exception: pass
            try: sh.setCanDismissWithSwipe(False)
            except Exception: pass
            try: sh.setCanDrag(False)
            except Exception: pass

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(p["bg"])

            # Header
            bar = LinearLayout(ctx)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL)
            bar.setPadding(dp(16), dp(14), dp(12), dp(14))
            bar.setBackgroundColor(p["bar"])

            title_tv = TextView(ctx)
            title_tv.setText(_mz_t("Локальна бібліотека", "Local library", "Локальная библиотека"))
            title_tv.setTextSize(18.0)
            title_tv.setTextColor(p["title"])
            title_tv.setTypeface(title_tv.getTypeface(), 1)
            bar.addView(title_tv, LP(0, LP.WRAP_CONTENT, 1.0))

            # Info button
            info_iv = ImageView(ctx)
            info_ic = _drawable("msg_filled_info") or _drawable("msg_info") or _drawable("info")
            if info_ic:
                info_iv.setImageResource(info_ic)
                info_iv.setColorFilter(p["hint"])
            info_iv.setPadding(dp(10), dp(10), dp(10), dp(10))
            info_iv.setOnClickListener(_make_click(lambda v: plugin._show_sprite_guide(ctx, p, dp, LP, FLP)))

            # "+" add button with the msg_add icon
            add_iv = ImageView(ctx)
            add_ic = _drawable("msg_add")
            if add_ic:
                add_iv.setImageResource(add_ic)
                add_iv.setColorFilter(p["accent"])
            add_iv.setPadding(dp(10), dp(10), dp(10), dp(10))
            add_iv.setOnClickListener(_make_click(lambda v: plugin._open_add_local_pack(ctx, sh, root, scroll_ll, p, dp, LP, FLP)))

            # Close button
            close_iv = ImageView(ctx)
            close_ic = _drawable("msg_close") or _drawable("ic_close")
            if close_ic:
                close_iv.setImageResource(close_ic)
                close_iv.setColorFilter(p["hint"])
            else:
                close_iv = TextView(ctx)
                close_iv.setText("✕")
                close_iv.setTextSize(20.0)
                close_iv.setTextColor(p["hint"])
            close_iv.setPadding(dp(8), dp(8), dp(12), dp(8))
            close_iv.setOnClickListener(_make_click(lambda v: sh.dismiss()))

            bar.addView(info_iv, LP(dp(44), dp(44)))
            bar.addView(add_iv, LP(dp(44), dp(44)))
            bar.addView(close_iv, LP(dp(44), dp(44)))
            root.addView(bar, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))

            # List of local characters
            scroll = ScrollView(ctx)
            scroll_ll = LinearLayout(ctx)
            scroll_ll.setOrientation(LinearLayout.VERTICAL)
            scroll_ll.setPadding(dp(12), dp(12), dp(12), dp(80))
            scroll.addView(scroll_ll, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
            root.addView(scroll, LP(LP.MATCH_PARENT, LP.MATCH_PARENT))

            # Fill with existing local packs
            plugin._refresh_local_list(ctx, scroll_ll, p, dp, LP, FLP)

            sh.setCustomView(root)
            sh.show()

        except Exception as e:
            self._log(f"_show_local_library_sheet: {e}\n{traceback.format_exc()}")

    def _get_local_packs(self):
        """Returns the list of locally installed packs from INSTALL_DIR."""
        packs = []
        try:
            if not os.path.isdir(INSTALL_DIR):
                return packs
            for name in sorted(os.listdir(INSTALL_DIR)):
                path = os.path.join(INSTALL_DIR, name)
                if not os.path.isdir(path):
                    continue
                # Count the sprites
                sprites = [f for f in os.listdir(path) if f.lower().startswith("shime") and f.lower().endswith(".png")]
                if not sprites:
                    continue
                thumb_path = os.path.join(path, "thumb.png")
                packs.append({
                    "id":         name,
                    "name":       name.replace("_", " ").title(),
                    "path":       path,
                    "sprites":    len(sprites),
                    "thumb_path": thumb_path if os.path.exists(thumb_path) else None,
                })
        except Exception as e:
            self._log(f"_get_local_packs: {e}")
        return packs

    def _refresh_local_list(self, ctx, parent, p, dp, LP, FLP):
        """Clears and refills the list of local packs."""
        try:
            # Clear
            parent.removeAllViews()
            packs = self._get_local_packs()

            if not packs:
                empty_tv = TextView(ctx)
                empty_tv.setText(_mz_t("Немає локальних персонажів.\nНатисни +, щоб додати", "No local characters.\nTap + to add", "Нет локальных персонажей.\nНажми + чтобы добавить"))
                empty_tv.setTextColor(p["hint"])
                empty_tv.setTextSize(14.0)
                empty_tv.setGravity(Gravity.CENTER)
                empty_tv.setPadding(dp(20), dp(60), dp(20), dp(20))
                parent.addView(empty_tv, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
                return

            plugin = self
            for pack in packs:
                self._add_local_row(ctx, parent, pack, p, dp, LP, FLP)
        except Exception as e:
            self._log(f"_refresh_local_list: {e}")

    def _add_local_row(self, ctx, parent, pack, p, dp, LP, FLP):
        try:
            plugin = self
            pid   = pack["id"]
            name  = pack["name"]
            path  = pack["path"]
            is_active = self.gs("sprites_dir", "") == path

            from android.graphics.drawable import GradientDrawable as _GD
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(12), dp(10), dp(12), dp(10))
            gd = _GD(); gd.setColor(p["card"]); gd.setCornerRadius(dp(12))
            row.setBackground(gd)
            lp_row = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_row.bottomMargin = dp(8)

            # Preview
            iv = ImageView(ctx)
            iv.setScaleType(ImageView.ScaleType.CENTER_CROP)
            gd2 = _GD(); gd2.setColor(p["bg"]); gd2.setCornerRadius(dp(8))
            iv.setBackground(gd2)
            lp_iv = LP(dp(64), dp(64))
            lp_iv.rightMargin = dp(12)
            row.addView(iv, lp_iv)

            # Load the local thumb
            thumb_path = pack.get("thumb_path")
            if thumb_path:
                def _load(v=iv, tp=thumb_path):
                    try:
                        bm = BitmapFactory.decodeFile(tp)
                        if bm:
                            run_on_ui_thread(lambda b=bm, vi=v: (vi.setImageBitmap(b), vi.setBackgroundColor(0)))
                    except Exception: pass
                import threading
                threading.Thread(target=_load, daemon=True).start()
            else:
                # The first sprite as a preview
                def _load_sprite(v=iv, pp=path):
                    try:
                        for f in sorted(os.listdir(pp)):
                            if f.lower() == "shime1.png":
                                bm = BitmapFactory.decodeFile(os.path.join(pp, f))
                                if bm:
                                    run_on_ui_thread(lambda b=bm, vi=v: (vi.setImageBitmap(b), vi.setBackgroundColor(0)))
                                break
                    except Exception: pass
                import threading
                threading.Thread(target=_load_sprite, daemon=True).start()

            # Text
            info = LinearLayout(ctx)
            info.setOrientation(LinearLayout.VERTICAL)

            name_tv = TextView(ctx)
            name_tv.setText(name)
            name_tv.setTextSize(15.0)
            name_tv.setTextColor(p["accent"] if is_active else p["text"])
            name_tv.setTypeface(name_tv.getTypeface(), 1 if is_active else 0)
            info.addView(name_tv, LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT))

            meta_tv = TextView(ctx)
            meta_tv.setText(_mz_t(f"{pack['sprites']} спрайтів  •  {'активний' if is_active else path}", f"{pack['sprites']} sprites  •  {'active' if is_active else path}", f"{pack['sprites']} спрайтов  •  {'активен' if is_active else path}"))
            meta_tv.setTextSize(11.0)
            meta_tv.setTextColor(p["hint"])
            meta_tv.setSingleLine(True)
            lp_m = LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT)
            lp_m.topMargin = dp(2)
            info.addView(meta_tv, lp_m)
            row.addView(info, LP(0, LP.WRAP_CONTENT, 1.0))

            # "Select" button
            btn = TextView(ctx)
            btn.setText(_mz_t("Вибрати", "Select", "Выбрать") if not is_active else _mz_t("Активний", "Active", "Активен"))
            btn.setTextSize(12.0)
            btn.setTextColor(p["bg"] if not is_active else p["hint"])
            btn.setPadding(dp(10), dp(6), dp(10), dp(6))
            gd3 = _GD()
            gd3.setColor(p["accent"] if not is_active else p["card"])
            gd3.setCornerRadius(dp(8))
            btn.setBackground(gd3)
            lp_btn = LP(LP.WRAP_CONTENT, LP.WRAP_CONTENT)
            lp_btn.leftMargin = dp(8)

            def _on_select(v, pp=path):
                plugin.ss("sprites_dir", pp)
                plugin._restart_engine()
                BulletinHelper.show_success(_mz_t(f"{name} вибрано", f"{name} selected", f"{name} выбран"))
            btn.setOnClickListener(_make_click(_on_select))
            if not is_active:
                row.addView(btn, lp_btn)

            # Delete button
            del_iv = ImageView(ctx)
            del_ic = _drawable("msg_delete") or _drawable("ic_delete")
            if del_ic:
                del_iv.setImageResource(del_ic)
                del_iv.setColorFilter(p["hint"])
                del_iv.setPadding(dp(6), dp(6), dp(6), dp(6))
                lp_del = LP(dp(36), dp(36))
                lp_del.leftMargin = dp(4)

                def _on_delete(v, pp=path, pn=name, r=row):
                    try:
                        import shutil
                        shutil.rmtree(pp)
                        run_on_ui_thread(lambda: parent.removeView(r))
                        BulletinHelper.show_success(_mz_t(f"{pn} видалено", f"{pn} deleted", f"{pn} удалён"))
                    except Exception as e:
                        BulletinHelper.show_error(str(e))
                del_iv.setOnClickListener(_make_click(_on_delete))
                row.addView(del_iv, lp_del)

            parent.addView(row, lp_row)
        except Exception as e:
            self._log(f"_add_local_row: {e}\n{traceback.format_exc()}")

    def _open_add_local_pack(self, ctx, sh, root, scroll_ll, p, dp, LP, FLP):
        """Opens the menu for adding a new local character."""
        try:
            plugin = self

            sh2 = BottomSheet(ctx, True)   # needFocus=True for the keyboard
            try: sh2.setCanDismissWithSwipe(True)
            except Exception: pass

            root2 = LinearLayout(ctx)
            root2.setOrientation(LinearLayout.VERTICAL)
            root2.setBackgroundColor(p["bg"])
            root2.setPadding(dp(16), dp(20), dp(16), dp(40))

            title_tv = TextView(ctx)
            title_tv.setText(_mz_t("Додати персонажа", "Add character", "Добавить персонажа"))
            title_tv.setTextSize(20.0)
            title_tv.setTextColor(p["text"])
            title_tv.setTypeface(title_tv.getTypeface(), 1)
            title_tv.setGravity(Gravity.CENTER_HORIZONTAL)
            lp_t = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_t.bottomMargin = dp(24)
            root2.addView(title_tv, lp_t)

            # Preview of the selected thumb
            from android.graphics.drawable import GradientDrawable as _GD
            prev_iv = ImageView(ctx)
            prev_iv.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            gd_prev = _GD(); gd_prev.setColor(p["card"]); gd_prev.setCornerRadius(dp(16))
            prev_iv.setBackground(gd_prev)
            lp_prev = LP(LP.MATCH_PARENT, dp(200))
            lp_prev.bottomMargin = dp(16)
            root2.addView(prev_iv, lp_prev)

            # State: selected paths
            state = {"thumb_path": None, "zip_path": None, "name": ""}

            # Name field: the pattern from manga_reader
            from android.text import InputType as _IT
            try:
                from org.telegram.ui.Components import EditTextBoldCursor as _ETBC
                name_et = _ETBC(ctx)
                try: name_et.setCursorColor(p["accent"])
                except Exception: pass
            except Exception:
                from android.widget import EditText
                name_et = EditText(ctx)
            name_et.setHint(_mz_t("Ім'я персонажа", "Character name", "Имя персонажа"))
            name_et.setHintTextColor(p["hint"])
            name_et.setTextColor(p["text"])
            name_et.setTextSize(15.0)
            name_et.setSingleLine(True)
            name_et.setFocusable(True)
            name_et.setFocusableInTouchMode(True)
            name_et.setInputType(_IT.TYPE_CLASS_TEXT | _IT.TYPE_TEXT_FLAG_CAP_SENTENCES)
            name_et.setPadding(dp(12), dp(10), dp(12), dp(10))
            from android.graphics.drawable import GradientDrawable as _GD_ET
            gd_et = _GD_ET(); gd_et.setColor(p["card"]); gd_et.setCornerRadius(dp(10))
            name_et.setBackground(gd_et)
            lp_et = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_et.bottomMargin = dp(12)
            root2.addView(name_et, lp_et)

            # Select preview button
            def _make_btn(text, ic_name):
                btn = LinearLayout(ctx)
                btn.setOrientation(LinearLayout.HORIZONTAL)
                btn.setGravity(Gravity.CENTER_VERTICAL)
                btn.setPadding(dp(14), dp(12), dp(14), dp(12))
                gd_b = _GD(); gd_b.setColor(p["card"]); gd_b.setCornerRadius(dp(10))
                btn.setBackground(gd_b)
                lp_b = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
                lp_b.bottomMargin = dp(10)

                ic = _drawable(ic_name)
                if ic:
                    iv2 = ImageView(ctx)
                    iv2.setImageResource(ic)
                    iv2.setColorFilter(p["accent"])
                    lp_i = LP(dp(24), dp(24))
                    lp_i.rightMargin = dp(10)
                    btn.addView(iv2, lp_i)

                tv2 = TextView(ctx)
                tv2.setText(text)
                tv2.setTextColor(p["text"])
                tv2.setTextSize(15.0)
                btn.addView(tv2, LP(0, LP.WRAP_CONTENT, 1.0))

                return btn, tv2

            btn_thumb, lbl_thumb = _make_btn(_mz_t("Вибрати прев'ю (PNG/JPG)", "Select preview (PNG/JPG)", "Выбрать превью (PNG/JPG)"), "msg_media_photo_count")

            # Preview progress bar
            try:
                from org.telegram.ui.Components import LineProgressView
                lpv_thumb = LineProgressView(ctx)
                lpv_thumb.setProgressColor(p["accent"])
                lpv_thumb.setBackColor(p["card"])
            except Exception:
                from android.widget import ProgressBar
                lpv_thumb = ProgressBar(ctx, None, 16842872)
                lpv_thumb.setMax(1000)
                lpv_thumb.setIndeterminate(False)
            from android.view import View as _View
            lpv_thumb.setVisibility(_View.GONE)
            lp_lpv = LP(LP.MATCH_PARENT, dp(4))
            lp_lpv.topMargin = dp(2)

            btn_zip, lbl_zip = _make_btn(_mz_t("Вибрати архів (ZIP)", "Select archive (ZIP)", "Выбрать архив (ZIP)"), "msg_media_doc2")

            # Archive progress bar
            try:
                from org.telegram.ui.Components import LineProgressView as LPV2
                lpv_zip = LPV2(ctx)
                lpv_zip.setProgressColor(p["accent"])
                lpv_zip.setBackColor(p["card"])
            except Exception:
                from android.widget import ProgressBar as PB2
                lpv_zip = PB2(ctx, None, 16842872)
                lpv_zip.setMax(1000)
                lpv_zip.setIndeterminate(False)
            lpv_zip.setVisibility(_View.GONE)
            lp_lpv2 = LP(LP.MATCH_PARENT, dp(4))
            lp_lpv2.topMargin = dp(2)

            # "Add" button
            btn_add = TextView(ctx)
            btn_add.setText(_mz_t("Додати", "Add", "Добавить"))
            btn_add.setTextSize(16.0)
            btn_add.setTextColor(p["bg"])
            btn_add.setGravity(Gravity.CENTER)
            btn_add.setPadding(dp(16), dp(14), dp(16), dp(14))
            gd_add = _GD(); gd_add.setColor(p["accent"]); gd_add.setCornerRadius(dp(12))
            btn_add.setBackground(gd_add)
            lp_add = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_add.topMargin = dp(8)

            # File picker via Intent
            def _pick_file(mime_types, on_result):
                try:
                    from android.content import Intent
                    from hook_utils import find_class
                    from java import jclass

                    REQUEST_CODE = 0x5348  # SH: a unique code

                    intent = Intent(Intent.ACTION_GET_CONTENT)
                    intent.setType("*/*")
                    intent.addCategory(Intent.CATEGORY_OPENABLE)
                    chooser = Intent.createChooser(intent, _mz_t("Виберіть файл", "Choose a file", "Выберите файл"))

                    plugin._pending_file_callback = on_result

                    frag = get_last_fragment()
                    act  = frag.getParentActivity() if frag else None
                    if not act:
                        BulletinHelper.show_error(_mz_t("Немає активності", "No activity", "Нет активности"))
                        return

                    # Hook onActivityResult on the activity (PluginSettingsActivity -> LaunchActivity)
                    try:
                        int_t      = jclass("java.lang.Integer").TYPE
                        intent_cls = find_class("android.content.Intent")
                        # Look for the method going up the act hierarchy
                        m = None
                        klass = act.getClass()
                        while klass is not None:
                            try:
                                m = klass.getDeclaredMethod("onActivityResult", int_t, int_t, intent_cls)
                                m.setAccessible(True)
                                plugin._log(f"_pick_file: found onActivityResult on {klass.getSimpleName()}")
                                break
                            except Exception:
                                klass = klass.getSuperclass()
                        if m:
                            plugin._instance_result_hook = plugin.hook_method(
                                m, _FileResultHook(plugin, REQUEST_CODE))
                            plugin._log(f"_pick_file: hooked OK")
                        else:
                            plugin._log("_pick_file: onActivityResult not found on act, trying LaunchActivity")
                            # Fallback: hook LaunchActivity directly
                            la_cls = find_class("org.telegram.messenger.LaunchActivity")
                            if la_cls:
                                for mm in la_cls.getDeclaredMethods():
                                    if mm.getName() == "onActivityResult":
                                        mm.setAccessible(True)
                                        plugin.hook_method(mm, _FileResultHook(plugin, REQUEST_CODE))
                                        plugin._log("_pick_file: hooked LaunchActivity OK")
                                        break
                    except Exception as he:
                        plugin._log(f"_pick_file hook err: {he}\n{traceback.format_exc()}")

                    # Launch via act
                    launched = False
                    for launcher in (act, frag):
                        try:
                            launcher.startActivityForResult(chooser, REQUEST_CODE)
                            launched = True
                            plugin._log(f"_pick_file: launched via {launcher.getClass().getSimpleName()}")
                            break
                        except Exception as le:
                            plugin._log(f"_pick_file launch {launcher.getClass().getSimpleName()}: {le}")
                    if not launched:
                        BulletinHelper.show_error(_mz_t("Не вдалося відкрити вибір файлу", "Couldn't open the file picker", "Не удалось открыть выбор файла"))
                except Exception as e:
                    plugin._log(f"_pick_file: {e}\n{traceback.format_exc()}")

            def _show_lpv(lpv, frac):
                """Shows and updates LineProgressView."""
                from android.view import View as _V
                def _ui():
                    lpv.setVisibility(_V.VISIBLE)
                    try: lpv.setProgress(frac, True)
                    except Exception:
                        try: lpv.setProgress(int(frac * 1000))
                        except Exception: pass
                run_on_ui_thread(_ui)

            def _on_thumb_picked(uri_str):
                try:
                    _show_lpv(lpv_thumb, 0.2)
                    run_on_ui_thread(lambda: lbl_thumb.setText(_mz_t("Читаю прев'ю...", "Reading preview...", "Читаю превью...")))
                    path = plugin._uri_to_path(ctx, uri_str)
                    _show_lpv(lpv_thumb, 0.7)
                    if not path:
                        run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Не вдалося прочитати прев'ю", "Couldn't read the preview", "Не удалось прочитать превью")))
                        return
                    state["thumb_path"] = path
                    fname = path.split("/")[-1]
                    bm = BitmapFactory.decodeFile(path)
                    _show_lpv(lpv_thumb, 1.0)
                    def _upd(b=bm, f=fname):
                        lbl_thumb.setText(_mz_t(f"Прев'ю: {f[:30]}", f"Preview: {f[:30]}", f"Превью: {f[:30]}"))
                        if b:
                            prev_iv.setImageBitmap(b)
                            prev_iv.setBackgroundColor(0)
                    run_on_ui_thread(_upd)
                except Exception as e:
                    plugin._log(f"_on_thumb: {e}")

            def _on_zip_picked(uri_str):
                try:
                    _show_lpv(lpv_zip, 0.2)
                    run_on_ui_thread(lambda: lbl_zip.setText(_mz_t("Читаю архів...", "Reading archive...", "Читаю архив...")))
                    path = plugin._uri_to_path(ctx, uri_str)
                    _show_lpv(lpv_zip, 1.0)
                    if not path:
                        run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Не вдалося прочитати архів", "Couldn't read the archive", "Не удалось прочитать архив")))
                        return
                    state["zip_path"] = path
                    fname = path.split("/")[-1]
                    suggested = fname.replace(".zip","").replace("_pack","").replace("_"," ").strip()
                    def _upd(f=fname, s=suggested):
                        lbl_zip.setText(_mz_t(f"Архів: {f[:30]}", f"Archive: {f[:30]}", f"Архив: {f[:30]}"))
                        if not str(name_et.getText()).strip() and s:
                            name_et.setText(s)
                            name_et.setSelection(len(s))
                    run_on_ui_thread(_upd)
                except Exception as e:
                    plugin._log(f"_on_zip: {e}")

            btn_thumb.setOnClickListener(_make_click(lambda v: _pick_file(
                ["image/png","image/jpeg","image/webp"], _on_thumb_picked
            )))
            btn_zip.setOnClickListener(_make_click(lambda v: _pick_file(
                ["application/zip","application/x-zip-compressed","*/*"], _on_zip_picked
            )))

            def _on_add(v):
                zip_path   = state.get("zip_path")
                thumb_path = state.get("thumb_path")
                try:
                    raw_name = name_et.getText().toString().strip()
                except Exception:
                    raw_name = str(name_et.getText()).strip()
                if not zip_path:
                    BulletinHelper.show_error(_mz_t("Вибери ZIP-архів", "Select a ZIP archive", "Выбери ZIP архив"))
                    return
                if not raw_name:
                    BulletinHelper.show_error(_mz_t("Введи ім'я персонажа", "Enter the character name", "Введи имя персонажа"))
                    return
                # Block the button
                btn_add.setEnabled(False)
                _set_progress(0.0, _mz_t("Підготовка...", "Preparing...", "Подготовка..."))
                pack_id = raw_name.lower().replace(" ","_")
                plugin._install_local_pack(zip_path, thumb_path, pack_id, raw_name,
                                           sh2, scroll_ll, p, dp, LP, FLP, _set_progress)

            btn_add.setOnClickListener(_make_click(_on_add))

            root2.addView(btn_thumb, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
            root2.addView(lpv_thumb, lp_lpv)
            root2.addView(btn_zip, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
            root2.addView(lpv_zip, lp_lpv2)
            root2.addView(btn_add, lp_add)

            # Progress block (hidden until installation)
            from android.view import View
            prog_block = LinearLayout(ctx)
            prog_block.setOrientation(LinearLayout.VERTICAL)
            prog_block.setVisibility(View.GONE)
            lp_pb = LP(LP.MATCH_PARENT, LP.WRAP_CONTENT)
            lp_pb.topMargin = dp(12)

            # LineProgressView as in ai_assistant
            line_prog = [None]
            try:
                from org.telegram.ui.Components import LineProgressView
                lpv = LineProgressView(ctx)
                lpv.setProgressColor(p["accent"])
                lpv.setBackColor(p["card"])
                lp_lpv = LP(LP.MATCH_PARENT, dp(4))
                lp_lpv.bottomMargin = dp(6)
                prog_block.addView(lpv, lp_lpv)
                line_prog[0] = lpv
            except Exception:
                from android.widget import ProgressBar
                pb = ProgressBar(ctx, None, 16842872)
                pb.setMax(1000)
                pb.setIndeterminate(False)
                prog_block.addView(pb, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
                line_prog[0] = pb

            prog_tv = TextView(ctx)
            prog_tv.setTextSize(12.0)
            prog_tv.setGravity(Gravity.CENTER)
            prog_tv.setTextColor(p["hint"])
            prog_block.addView(prog_tv, LP(LP.MATCH_PARENT, LP.WRAP_CONTENT))
            root2.addView(prog_block, lp_pb)

            def _set_progress(frac, text=""):
                def _ui():
                    prog_block.setVisibility(View.VISIBLE)
                    prog_tv.setText(text)
                    lp = line_prog[0]
                    if lp is not None:
                        try: lp.setProgress(frac, True)
                        except Exception:
                            try: lp.setProgress(int(frac * 1000))
                            except Exception: pass
                run_on_ui_thread(_ui)

            sh2.setCustomView(root2)
            sh2.show()

        except Exception as e:
            self._log(f"_open_add_local_pack: {e}\n{traceback.format_exc()}")



    def _uri_to_path(self, ctx, uri_str):
        """Converts a URI to a local file. The pattern from ai_assistant."""
        try:
            from android.net import Uri
            uri = Uri.parse(uri_str)
            scheme = str(uri.getScheme() or "")
            self._log(f"_uri_to_path: scheme={scheme} uri={uri_str[:80]}")

            # file://: direct path
            if scheme == "file":
                return str(uri.getPath())

            cr = ctx.getContentResolver()

            # Get the file name via OpenableColumns
            fname = "file"
            try:
                from android.provider import OpenableColumns
                cur = cr.query(uri, None, None, None, None)
                if cur and cur.moveToFirst():
                    col = cur.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                    if col >= 0:
                        fname = str(cur.getString(col))
                    cur.close()
            except Exception as e:
                self._log(f"  fname_err: {e}")

            self._log(f"  fname={fname}")
            ext = fname[fname.rfind("."):].lower() if "." in fname else ""
            is_img = ext in (".png",".jpg",".jpeg",".webp",".bmp")
            suffix = ext if ext else (".png" if is_img else ".zip")

            # Read the stream byte by byte: the pattern from ai_assistant
            inp = cr.openInputStream(uri)
            if inp is None:
                raise RuntimeError("openInputStream=null")

            chunks = []
            try:
                while True:
                    b = inp.read()
                    if b < 0: break
                    chunks.append(b)
            finally:
                try: inp.close()
                except Exception: pass

            raw = bytes(chunks)
            self._log(f"  read {len(raw)} bytes")

            # Save to a temporary file
            import tempfile
            tmp = tempfile.mktemp(suffix=suffix, dir=INSTALL_DIR)
            with open(tmp, "wb") as f_out:
                f_out.write(raw)
            self._log(f"  saved → {tmp}")
            return tmp

        except Exception as e:
            self._log(f"_uri_to_path ERROR: {e}\n{traceback.format_exc()}")
        return None

    def _install_local_pack(self, zip_path, thumb_path, pack_id, display_name, sh2, scroll_ll, p, dp, LP, FLP, on_progress=None):
        """Installs a character from a local ZIP file."""
        if on_progress: on_progress(0.05, _mz_t("Читаю архів...", "Reading archive...", "Читаю архив..."))
        plugin = self
        ctx_ref = [None]
        try:
            f = get_last_fragment()
            if f: ctx_ref[0] = f.getParentActivity()
        except Exception: pass

        def _worker():
            try:
                import zipfile as zfmod

                install_path = os.path.join(INSTALL_DIR, pack_id)
                os.makedirs(install_path, exist_ok=True)

                # Unpack the ZIP
                with zfmod.ZipFile(zip_path, "r") as zf:
                    members = zf.infolist()
                    top_dirs = set()
                    for m in members:
                        parts = m.filename.split("/")
                        if len(parts) > 1 and parts[0]:
                            top_dirs.add(parts[0])
                    subdir = list(top_dirs)[0] if len(top_dirs) == 1 else ""
                    total = max(len(members), 1)
                    if on_progress: on_progress(0.1, _mz_t(f"Розпаковую 0/{total}...", f"Unpacking 0/{total}...", f"Распаковываю 0/{total}..."))
                    for i, member in enumerate(members):
                        parts = member.filename.split("/")
                        if subdir and parts and parts[0] == subdir:
                            parts = parts[1:]
                        if not parts or not parts[0]:
                            continue
                        target = os.path.join(install_path, *parts)
                        if member.is_dir():
                            os.makedirs(target, exist_ok=True)
                        else:
                            os.makedirs(os.path.dirname(target), exist_ok=True)
                            with open(target, "wb") as f_out:
                                f_out.write(zf.read(member.filename))
                        if on_progress and i % 5 == 0:
                            frac = 0.1 + 0.8 * (i / total)
                            on_progress(frac, _mz_t(f"Розпаковую {i+1}/{total}...", f"Unpacking {i+1}/{total}...", f"Распаковываю {i+1}/{total}..."))

                # Copy the preview if there is one
                if thumb_path and os.path.exists(thumb_path):
                    import shutil
                    shutil.copy2(thumb_path, os.path.join(install_path, "thumb.png"))

                if on_progress: on_progress(0.95, _mz_t("Зберігаю прев'ю...", "Saving preview...", "Сохраняю превью..."))
                # Activate
                plugin.ss("sprites_dir", install_path)
                plugin._log(f"Local pack installed: {pack_id} → {install_path}")

                def _done():
                    if on_progress: on_progress(1.0, _mz_t("Готово!", "Done!", "Готово!"))
                    BulletinHelper.show_success(_mz_t(f"{display_name} додано!", f"{display_name} added!", f"{display_name} добавлен!"))
                    sh2.dismiss()
                    # Update the list
                    ctx = ctx_ref[0]
                    if ctx:
                        plugin._refresh_local_list(ctx, scroll_ll, p, dp, LP, FLP)
                    plugin._restart_engine()
                run_on_ui_thread(_done)

            except Exception as e:
                plugin._log(f"_install_local_pack: {e}\n{traceback.format_exc()}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))

        import threading
        threading.Thread(target=_worker, daemon=True).start()

    def _is_pack_installed(self, pack_id: str) -> bool:
        path = os.path.join(INSTALL_DIR, pack_id)
        return os.path.isdir(path)

    def _install_pack(self, zip_url, pack_id, scale, subdir, on_done=None, name=None):
        display_name = name or pack_id
        BulletinHelper.show_info(_mz_t(f"Завантажую {display_name}...", f"Downloading {display_name}...", f"Скачиваю {display_name}..."))
        self._log(f"Installing: {pack_id}")
        plugin = self

        def _worker():
            try:
                import requests, zipfile, io
                resp = requests.get(zip_url, timeout=60)
                if resp.status_code != 200:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"HTTP {resp.status_code}"))
                    if on_done: on_done(False)
                    return

                install_path = os.path.join(INSTALL_DIR, pack_id)
                os.makedirs(install_path, exist_ok=True)

                with zipfile.ZipFile(io.BytesIO(resp.content)) as zf:
                    for member in zf.infolist():
                        parts = member.filename.split("/")
                        if subdir and parts and parts[0] == subdir:
                            parts = parts[1:]
                        if not parts or parts[0] == "":
                            continue
                        target = os.path.join(install_path, *parts)
                        if member.is_dir():
                            os.makedirs(target, exist_ok=True)
                        else:
                            os.makedirs(os.path.dirname(target), exist_ok=True)
                            with open(target, "wb") as f:
                                f.write(zf.read(member.filename))

                plugin.ss("sprites_dir", install_path)
                plugin.ss("scale", str(scale))
                plugin._log(f"Installed {pack_id} → {install_path}")

                def _apply():
                    BulletinHelper.show_success(_mz_t(f"{display_name} встановлено", f"{display_name} installed", f"{display_name} установлен"))
                    plugin._restart_engine()
                    if on_done: on_done(True)
                run_on_ui_thread(_apply)

            except Exception as e:
                plugin._log(f"_install_pack: {e}\n{traceback.format_exc()}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))
                if on_done: on_done(False)

        import threading
        threading.Thread(target=_worker, daemon=True).start()

    def _show_character(self, view=None):
        """Shows the character if it was hidden by a double tap."""
        try:
            if self._engine and self._engine._alive:
                r = self._engine._renderer
                if r and r._alive:
                    r._hidden = False
                    def _do():
                        try:
                            from android.view import View
                            r._root.setVisibility(View.VISIBLE)
                        except Exception as e:
                            self._log(f"show: {e}")
                    run_on_ui_thread(_do)
                    BulletinHelper.show_success(_mz_t("Персонаж знову тут!", "The character is back!", "Персонаж снова здесь!"))
        except Exception as e:
            self._log(f"_show_character: {e}")

    def _show_logs(self, view=None):
        def _do():
            try:
                from ui.alert import AlertDialogBuilder
                f = get_last_fragment()
                act = f.getParentActivity() if f else None
                if not act:
                    return
                text = "\n".join(self._logs[-100:]) if self._logs else _mz_t("(порожньо)", "(empty)", "(пусто)")
                bld = AlertDialogBuilder(act)
                bld.set_title(_mz_t("Журнали Shimeji", "Shimeji logs", "Логи Shimeji"))
                bld.set_message(text)
                bld.set_message_text_view_clickable(True)
                bld.set_positive_button("OK", lambda b, w: b.dismiss())
                bld.set_neutral_button(_mz_t("Очистити", "Clear", "Очистить"), lambda b, w: (self._logs.clear(), b.dismiss()))
                bld.show()
            except Exception as e:
                self._log(f"_show_logs: {e}")
        run_on_ui_thread(_do)
