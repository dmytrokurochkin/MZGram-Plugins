def _safe_str(v):
    try:
        if v is None:
            return None
        return str(v)
    except Exception:
        return None


def _cls_name(cls):
    try:
        n = cls.getName()
        if n:
            return str(n)
    except Exception:
        pass
    try:
        return str(cls)
    except Exception:
        return "?"


def _real_class(cls):
    if cls is None:
        return None
    try:
        cls.getDeclaredMethods()
        return cls
    except Exception:
        pass
    try:
        jc = cls.getClass()
        jc.getDeclaredMethods()
        return jc
    except Exception:
        pass
    try:
        from java import jclass
        jc = jclass("java.lang.Class").forName(_cls_name(cls))
        jc.getDeclaredMethods()
        return jc
    except Exception:
        return cls


def _safe_find_class(name):
    cls = _sdk_find_class(name)
    if cls is None:
        return None
    return _real_class(cls)


def _method_names(clazz):
    names = []
    try:
        for m in clazz.getDeclaredMethods():
            try:
                n = str(m.getName())
            except Exception:
                continue
            if n.startswith("$") or "lambda" in n.lower():
                continue
            names.append(n)
    except Exception:
        return []
    return sorted(set(names))


class _SafeHook(MethodHook):
    def __init__(self, plugin, before=None, after=None):
        super(_SafeHook, self).__init__()
        self.plugin = plugin
        self.before_fn = before
        self.after_fn = after

    def before_hooked_method(self, param):
        if self.before_fn is None:
            return
        try:
            self.before_fn(param)
        except Exception as e:
            try:
                self.plugin._log("HOOK", "before fail", self.plugin._err_str(e))
            except Exception:
                pass

    def after_hooked_method(self, param):
        if self.after_fn is None:
            return
        try:
            self.after_fn(param)
        except Exception as e:
            try:
                self.plugin._log("HOOK", "after fail", self.plugin._err_str(e))
            except Exception:
                pass


class _ClassLoadWatch(MethodHook):
    def __init__(self, plugin):
        super(_ClassLoadWatch, self).__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            name = str(param.args[0])
        except Exception:
            return
        self.plugin._on_class_loaded(name)


class _NotifyHook(MethodHook):
    def __init__(self, plugin):
        super(_NotifyHook, self).__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_notification(param)
        except Exception:
            pass


class IosCirclePlugin(BasePlugin):
    ICV = "org.telegram.ui.Components.InstantCameraView"

    def __init__(self):
        super(IosCirclePlugin, self).__init__()
        self._mixer_class = None
        self._mixer_status = "not loaded"
        self._counts = {}
        self._notes = {}
        self._unhooks = []
        self._round_paths = set()
        self._processed = set()
        self._busy = set()
        self._switches_ms = []
        self._last_facing = None
        self._pending_facing = None
        self._zoom_cuts_ignored = 0
        self._recording = False
        self._session_active = False
        self._rec_start = 0
        self._last_stop_ms = 0
        self._reattempts = 0
        self._watch_pending = False
        self._inner_scanned = False
        self._icv_scanned = False
        self._nc_started = None
        self._nc_stopped = None
        self._remembered_this_session = False
        self._passthrough = 0
        self._xb = None
        self._hooks_ready = False
        self._welcome_shown = False
        self._mix_factory = None
        self._mix_preview = None
        self._mix_layer_a = None
        self._mix_layer_b = None
        self._mix_anim = None
        self._mix_anim_layer = None
        self._mix_tick_r = None
        self._preview_ready = False
        self._preview_bitmaps = {}
        self._logs = []
        self._log_seq = 0
        self._log_path = None
        self._profile = {}
        self._probed = False
        self._encoders = []

    def on_plugin_load(self):
        try:
            self._logs = []
        except Exception:
            pass
        self._probe_device(force=True)
        self._load_mixer()
        self._load_notification_ids()
        self._install_hooks(only_missing=False)
        self._log("LOAD", "iOS Circle 3.2 starting")
        self._log("LOAD", "mixer", getattr(self, "_mixer_status", "?"))
        self._log("HOOKS", "after install", self._hook_summary())
        if not self._hooks_ready:
            self._install_classwatch()
            self._schedule_rehook(3)
        self._ensure_preview_images()

    def on_plugin_unload(self):
        self._round_paths.clear()
        self._processed.clear()
        self._busy.clear()
        self._session_active = False
        self._recording = False
        self._passthrough = 0
        self._stop_mix_anim()
        self._mix_preview = None
        self._mix_layer_a = None
        self._mix_layer_b = None
        self._preview_bitmaps = {}

    def _app_context(self):
        ApplicationLoaderCls = _safe_find_class("org.telegram.messenger.ApplicationLoader")
        ctx = None
        if ApplicationLoaderCls is not None:
            try:
                ctx = ApplicationLoaderCls.applicationContext
            except Exception:
                ctx = None
            if ctx is None:
                try:
                    ctx = get_private_field(ApplicationLoaderCls, "applicationContext")
                except Exception:
                    ctx = None
        if ctx is None:
            from java import jclass
            ctx = jclass("android.app.ActivityThread").currentApplication()
        return ctx

    def _open_tg_link(self, username):
        try:
            context = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW, Uri.parse("tg://resolve?domain=" + username))
            intent.setPackage(context.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        except Exception:
            pass

    def _show_welcome_dialog(self):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment:
                return
            activity = current_fragment.getParentActivity()
            if not activity:
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title(__name__)
            builder.set_message("Кажется там еще больше крутых плагинов")

            def on_hide(bld, which):
                self.set_setting("welcome_shown", True)
                bld.dismiss()

            def on_channel(bld, which):
                self.set_setting("welcome_shown", True)
                self._open_tg_link("HzzzPlugins")
                bld.dismiss()

            builder.set_positive_button("👀 Посмотреть канал и больше не показывать", on_channel)
            builder.set_negative_button("Скрыть", on_hide)
            builder.show()
        except Exception:
            pass

    def _on_reload_dex(self, view=None):
        self._mixer_class = None
        self._clear_preview_cache()
        self._load_mixer()
        if self._mixer_class is not None:
            self._toast("DEX reloaded")
        else:
            self._toast("DEX failed")
        self._ensure_preview_images()

    def _debug_on(self):
        try:
            v = self.get_setting("debug_mode", False)
        except Exception:
            return False
        if v is True:
            return True
        if v is False or v is None:
            return False
        try:
            if isinstance(v, str):
                low = v.strip().lower()
                if low in ("1", "true", "on", "yes", "вкл"):
                    return True
                if low in ("0", "false", "off", "no", "выкл", ""):
                    return False
            return int(v) != 0
        except Exception:
            return bool(v)
            
    def _on_debug_toggle(self, value=None):
        if self._debug_on():
            self._log("UI", "debug on")
            self._toast("Debug включен :3")
        else:
            self._toast("Debug выключен")

    def _debug_switch_row(self):
        if Switch is not None:
            for kwargs in (
                dict(key="debug_mode", text="Включить debug режим", default=False,
                     subtext="логи и инфо", on_change=self._on_debug_toggle),
                dict(key="debug_mode", text="Включить debug режим", default=False,
                     on_change=self._on_debug_toggle),
                dict(key="debug_mode", title="Включить debug режим", default=False),
            ):
                try:
                    return Switch(**kwargs)
                except Exception:
                    continue
            try:
                return Switch("debug_mode", "Включить debug режим")
            except Exception:
                pass
        return Selector(
            key="debug_mode",
            text="Включить debug режим",
            default=0,
            items=["Выкл", "Вкл"],
            on_change=self._on_debug_toggle,
        )

    def create_settings(self):
        self._install_hooks(only_missing=True)
        if not self._welcome_shown and not self.get_setting("welcome_shown", False):
            self._welcome_shown = True
            try:
                run_on_ui_thread(self._show_welcome_dialog)
            except Exception:
                self._show_welcome_dialog()
        dex_ok = self._mixer_class is not None
        prof = getattr(self, "_profile", None) or {}
        status = ("DEX ready" if dex_ok else "DEX failed") + " | 3.3 | " + (prof.get("name") or "?device?")
        items = [
            Text(text=status, subtext=_safe_str(getattr(self, "_mixer_status", "")) or ""),
            Selector(
                key="mix_duration",
                text="Mix duration",
                default=2,
                items=MIX_MS_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Selector(
                key="easing",
                text="Easing",
                default=1,
                items=EASE_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Selector(
                key="mix_path",
                text="Mix engine",
                default=0,
                items=MIX_PATH_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Selector(
                key="transition_type",
                text="Transition type",
                default=0,
                items=TRANSITION_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Text(text="Reload DEX", subtext="нажми если чет сломалось", on_click=self._on_reload_dex),
            Divider(),
            self._debug_switch_row(),
        ]
        if self._debug_on():
            items.extend([
                Text(text="показать логи", subtext="отправь в чат канала,если плагин не робит", on_click=self._on_show_logs),
                Text(text="записать инфо устройства", subtext="кодеки и хуки", on_click=self._on_dump_device),
            ])
        items.append(Divider())
        preview = self._mix_preview_setting()
        if preview is not None:
            items.append(preview)
            items.append(Divider())
        items.extend([
            Text(text="Сделал: @exoseo", on_click=lambda v: self._open_tg_link("exoseo")),
            Text(text="Канал: @HzzzPlugins", on_click=lambda v: self._open_tg_link("HzzzPlugins")),
            Text(
                    text="Найдет все тайны: @xucxbot",
                    accent=True,
                    on_click=lambda v: self._open_tg_link("xucxbot")
                ),
        ])
        return items

    def _on_mix_setting(self, index):
        pass

    def _mix_preview_setting(self):
        setting = None
        if SimpleSettingFactory is not None:
            try:
                if self._mix_factory is None:
                    self._mix_factory = SimpleSettingFactory(
                        self._create_mix_preview_view,
                        self._bind_mix_preview_view,
                        is_clickable=False,
                        is_shadow=False,
                    )
                factory = self._mix_factory
                try:
                    setting = factory()
                except Exception:
                    setting = None
                if setting is None and Custom is not None:
                    try:
                        inst = getattr(factory, "instance", None)
                        java_factory = None
                        if inst is not None:
                            java_factory = getattr(inst, "java", inst)
                        if java_factory is not None:
                            setting = Custom(factory=java_factory)
                    except Exception:
                        setting = None
            except Exception:
                setting = None
        if setting is None and Custom is not None:
            try:
                ctx = None
                try:
                    frag = get_last_fragment()
                    if frag is not None:
                        ctx = frag.getParentActivity()
                except Exception:
                    ctx = None
                if ctx is None:
                    ctx = self._app_context()
                if ctx is not None:
                    setting = Custom(view=self._build_mix_preview(ctx))
            except Exception:
                setting = None
        return setting

    def _create_mix_preview_view(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            return self._build_mix_preview(context)
        except Exception:
            try:
                from android.widget import FrameLayout
                from org.telegram.messenger import AndroidUtilities
                root = FrameLayout(context)
                h = AndroidUtilities.dp(228)
                root.setMinimumHeight(h)
                try:
                    from android.view import ViewGroup
                    root.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, h))
                except Exception:
                    pass
                return root
            except Exception:
                from android.view import View
                return View(context)

    def _bind_mix_preview_view(self, view, item, divider, adapter, list_view):
        self._mix_preview = view
        layer = None
        try:
            tag = view.getTag()
        except Exception:
            tag = None
        if isinstance(tag, (list, tuple)) and len(tag) >= 1:
            layer = tag[0]
        else:
            layer = tag
            try:
                holder = view.getChildAt(0)
                if holder is not None:
                    layer = holder.getChildAt(0)
            except Exception:
                pass
        if layer is not None:
            self._mix_layer_a = layer
            self._mix_layer_b = layer
        self._apply_preview_images()

    def _build_mix_preview(self, context):
        from android.widget import FrameLayout, LinearLayout
        from android.view import Gravity, ViewGroup
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.Components import LayoutHelper

        size_dp = 176
        size = AndroidUtilities.dp(size_dp)
        pad = AndroidUtilities.dp(26)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setGravity(Gravity.CENTER)
        root.setPadding(0, pad, 0, pad)
        try:
            root.setMinimumHeight(size + pad * 2)
        except Exception:
            pass
        try:
            root.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        except Exception:
            pass

        holder = FrameLayout(context)
        try:
            oval = GradientDrawable()
            oval.setShape(GradientDrawable.OVAL)
            oval.setColor(0xFF141414)
            holder.setBackground(oval)
            holder.setClipToOutline(True)
        except Exception:
            pass
        try:
            holder.setMinimumWidth(size)
            holder.setMinimumHeight(size)
        except Exception:
            pass

        img = self._make_preview_layer(context, size)

        fill = None
        try:
            fill = LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT)
        except Exception:
            fill = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT)
        holder.addView(img, fill)

        holder_lp = None
        try:
            holder_lp = LayoutHelper.createLinear(size_dp, size_dp, Gravity.CENTER)
        except Exception:
            try:
                holder_lp = LinearLayout.LayoutParams(size, size)
                holder_lp.gravity = Gravity.CENTER
            except Exception:
                holder_lp = ViewGroup.LayoutParams(size, size)
        root.addView(holder, holder_lp)

        try:
            root.setTag([img])
        except Exception:
            root.setTag(img)
        self._mix_preview = root
        self._mix_layer_a = img
        self._mix_layer_b = img
        self._apply_preview_images()
        return root

    def _make_preview_layer(self, context, size_px):
        radius = int(size_px / 2) if size_px else 0
        try:
            from org.telegram.ui.Components import BackupImageView
            v = BackupImageView(context)
            try:
                v.setRoundRadius(radius)
            except Exception:
                pass
            return v
        except Exception:
            pass
        from android.widget import ImageView
        v = ImageView(context)
        try:
            v.setScaleType(ImageView.ScaleType.CENTER_CROP)
        except Exception:
            pass
        try:
            v.setAdjustViewBounds(False)
        except Exception:
            pass
        return v

    def _preview_dir(self):
        base = None
        try:
            base = get_plugins_dir()
        except Exception:
            base = None
        if not base:
            try:
                base = get_files_dir()
            except Exception:
                base = None
        if not base:
            try:
                base = get_cache_dir()
            except Exception:
                base = None
        if not base:
            base = "/data/data"
        path = os.path.join(str(base), "ios_circle")
        try:
            ensure_dir_exists(path)
        except Exception:
            try:
                os.makedirs(path)
            except Exception:
                pass
        return path

    def _preview_path(self):
        d = self._preview_dir()
        return os.path.join(d, "preview.gif")

    def _preview_paths(self):
        p = self._preview_path()
        return p, p

    def _file_ok(self, path):
        try:
            return os.path.isfile(path) and os.path.getsize(path) > 1024
        except Exception:
            return False

    def _clear_preview_cache(self):
        self._preview_ready = False
        self._preview_bitmaps = {}
        self._logs = []
        self._log_seq = 0
        self._log_path = None
        self._profile = {}
        self._probed = False
        self._encoders = []
        try:
            d = self._preview_dir()
            for name in ("preview.gif", "preview_a.jpg", "preview_b.jpg",
                         "preview.gif.part", "preview_a.jpg.part", "preview_b.jpg.part"):
                path = os.path.join(d, name)
                try:
                    if os.path.isfile(path):
                        os.remove(path)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            run_on_ui_thread(self._apply_preview_images)
        except Exception:
            try:
                self._apply_preview_images()
            except Exception:
                pass

    def _ensure_preview_images(self):
        try:
            path = self._preview_path()
        except Exception:
            return
        if self._file_ok(path):
            self._preview_ready = True
            try:
                run_on_ui_thread(self._apply_preview_images)
            except Exception:
                try:
                    self._apply_preview_images()
                except Exception:
                    pass
            return

        def _dl():
            try:
                self._download_file(PREVIEW_IMG, path)
            except Exception:
                pass
            ok = False
            try:
                ok = self._file_ok(path)
            except Exception:
                ok = False
            self._preview_ready = ok
            if ok:
                try:
                    run_on_ui_thread(self._apply_preview_images)
                except Exception:
                    try:
                        self._apply_preview_images()
                    except Exception:
                        pass

        self._run_bg(_dl)

    def _download_file(self, url, dest):
        tmp = dest + ".part"
        data = None
        try:
            import urllib.request
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            resp = urllib.request.urlopen(req, timeout=30)
            try:
                data = resp.read()
            finally:
                try:
                    resp.close()
                except Exception:
                    pass
        except Exception:
            data = None
        if data is None:
            try:
                from java.net import URL
                from java.io import BufferedInputStream, ByteArrayOutputStream
                conn = URL(url).openConnection()
                conn.setRequestProperty("User-Agent", "Mozilla/5.0")
                conn.setConnectTimeout(15000)
                conn.setReadTimeout(30000)
                conn.connect()
                inp = BufferedInputStream(conn.getInputStream())
                bos = ByteArrayOutputStream()
                buf = bytearray(8192)
                try:
                    from jarray import zeros
                    jbuf = zeros(8192, "b")
                    while True:
                        n = inp.read(jbuf)
                        if n is None or int(n) < 0:
                            break
                        bos.write(jbuf, 0, int(n))
                    data = bos.toByteArray()
                except Exception:
                    data = None
                try:
                    inp.close()
                except Exception:
                    pass
            except Exception:
                data = None
        if data is None or len(data) < 1024:
            return False
        try:
            ensure_dir_exists(os.path.dirname(dest))
        except Exception:
            try:
                os.makedirs(os.path.dirname(dest))
            except Exception:
                pass
        try:
            write_file_bytes(tmp, bytes(data) if not isinstance(data, bytes) else data)
            os.replace(tmp, dest)
            return self._file_ok(dest)
        except Exception:
            pass
        try:
            raw = bytes(data) if not isinstance(data, bytes) else data
            f = open(tmp, "wb")
            try:
                f.write(raw)
            finally:
                f.close()
            os.replace(tmp, dest)
            return self._file_ok(dest)
        except Exception:
            try:
                from java.io import FileOutputStream, File
                fos = FileOutputStream(tmp)
                fos.write(data)
                fos.close()
                File(tmp).renameTo(File(dest))
                return self._file_ok(dest)
            except Exception:
                return False

    def _decode_preview_bitmap(self, path, view):
        if not self._file_ok(path):
            return None
        cached = None
        try:
            cached = self._preview_bitmaps.get(path)
        except Exception:
            cached = None
        if cached is not None:
            return cached
        try:
            from android.graphics import BitmapFactory
            bounds = BitmapFactory.Options()
            bounds.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path, bounds)
            w = int(bounds.outWidth or 0)
            h = int(bounds.outHeight or 0)
            target = 512
            try:
                vw = int(view.getWidth()) if view is not None else 0
                if vw > 64:
                    target = vw
            except Exception:
                pass
            if target < 256:
                target = 256
            sample = 1
            while w > 0 and h > 0 and (w / sample) > (target * 2) and (h / sample) > (target * 2):
                sample = sample * 2
            opts = BitmapFactory.Options()
            opts.inJustDecodeBounds = False
            opts.inSampleSize = int(sample)
            bmp = BitmapFactory.decodeFile(path, opts)
            if bmp is not None:
                try:
                    self._preview_bitmaps[path] = bmp
                except Exception:
                    pass
            return bmp
        except Exception:
            return None

    def _put_gif(self, view, path):
        if view is None or not self._file_ok(path):
            return
        try:
            view.setImage(path, None, None)
            try:
                ir = view.getImageReceiver()
                if ir is not None:
                    try:
                        ir.setAllowStartAnimation(True)
                    except Exception:
                        pass
                    try:
                        ir.setAutoRepeat(1)
                    except Exception:
                        pass
                    try:
                        ir.startAnimation()
                    except Exception:
                        pass
            except Exception:
                pass
            return
        except Exception:
            pass
        try:
            from org.telegram.messenger import ImageLocation
            loc = ImageLocation.getForPath(path)
            view.setImage(loc, None, None, None, 0)
            try:
                ir = view.getImageReceiver()
                if ir is not None:
                    try:
                        ir.setAllowStartAnimation(True)
                    except Exception:
                        pass
                    try:
                        ir.setAutoRepeat(1)
                    except Exception:
                        pass
                    try:
                        ir.startAnimation()
                    except Exception:
                        pass
            except Exception:
                pass
            return
        except Exception:
            pass
        try:
            ir = view.getImageReceiver()
            if ir is not None:
                try:
                    from org.telegram.messenger import ImageLocation
                    loc = ImageLocation.getForPath(path)
                    ir.setImage(loc, None, None, None, 0, None, None, 1)
                except Exception:
                    try:
                        ir.setImage(path, None, None)
                    except Exception:
                        pass
                try:
                    ir.setAllowStartAnimation(True)
                except Exception:
                    pass
                try:
                    ir.setAutoRepeat(1)
                except Exception:
                    pass
                try:
                    ir.startAnimation()
                except Exception:
                    pass
                return
        except Exception:
            pass
        bmp = self._decode_preview_bitmap(path, view)
        if bmp is None:
            return
        try:
            view.setImageBitmap(bmp)
            return
        except Exception:
            pass
        try:
            from android.graphics.drawable import BitmapDrawable
            res = view.getContext().getResources()
            view.setImageDrawable(BitmapDrawable(res, bmp))
        except Exception:
            pass

    def _put_bitmap(self, view, path):
        self._put_gif(view, path)

    def _apply_preview_images(self):
        a_view = getattr(self, "_mix_layer_a", None)
        b_view = getattr(self, "_mix_layer_b", None)
        if a_view is None and b_view is None:
            return
        try:
            path = self._preview_path()
        except Exception:
            return
        if a_view is not None:
            self._put_gif(a_view, path)
        if b_view is not None and b_view is not a_view:
            self._put_gif(b_view, path)

    def _stop_mix_anim(self):
        self._mix_anim_layer = None
        old = getattr(self, "_mix_anim", None)
        self._mix_anim = None
        if old is not None and old is not True:
            try:
                old.cancel()
            except Exception:
                pass

    def _mix_ease(self, kind, x):
        if x <= 0.0:
            return 0.0
        if x >= 1.0:
            return 1.0
        k = int(kind)
        if k == 0:
            return x
        if k == 2:
            return self._bezier_ease(x, 0.42, 0.0, 0.58, 1.0)
        return self._bezier_ease(x, 0.25, 0.1, 0.25, 1.0)

    def _bezier_ease(self, x, x1, y1, x2, y2):
        t = x
        for _ in range(8):
            cx = 3.0 * x1
            bx = 3.0 * (x2 - x1) - cx
            ax = 1.0 - cx - bx
            xt = ((ax * t + bx) * t + cx) * t
            dxt = (3.0 * ax * t + 2.0 * bx) * t + cx
            if abs(dxt) < 1e-6:
                break
            t = t - (xt - x) / dxt
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
        cy = 3.0 * y1
        by = 3.0 * (y2 - y1) - cy
        ay = 1.0 - cy - by
        return ((ay * t + by) * t + cy) * t

    def _mix_alpha_at(self, frac, mix_ms, hold_ms):
        total = float(hold_ms * 2 + mix_ms * 2)
        if total <= 0:
            return 0.0
        ms = float(frac) * total
        easing = int(self.get_setting("easing", 1) or 1)
        a = float(hold_ms)
        b = a + float(mix_ms)
        c = b + float(hold_ms)
        if ms < a:
            return 0.0
        if ms < b:
            return self._mix_ease(easing, (ms - a) / float(mix_ms))
        if ms < c:
            return 1.0
        return 1.0 - self._mix_ease(easing, (ms - c) / float(mix_ms))

    def _mix_cycle_times(self):
        mix_i = int(self.get_setting("mix_duration", 2) or 2)
        if mix_i < 0 or mix_i >= len(MIX_MS_VALUES):
            mix_i = 2
        mix_ms = int(MIX_MS_VALUES[mix_i])
        hold_ms = int(PREVIEW_CYCLE_MS) - mix_ms
        if hold_ms < 200:
            hold_ms = 200
        total = hold_ms * 2 + mix_ms * 2
        return mix_ms, hold_ms, total

    def _now_anim_ms(self):
        try:
            from android.os import SystemClock
            return int(SystemClock.uptimeMillis())
        except Exception:
            pass
        try:
            from java.lang import System
            return int(System.currentTimeMillis())
        except Exception:
            return int(time.time() * 1000)

    def _apply_mix_alpha(self, layer, value):
        if layer is None:
            return
        a = float(value)
        if a < 0.0:
            a = 0.0
        if a > 1.0:
            a = 1.0
        t_mode = self._transition_mode()
        s = 4.0 * a * (1.0 - a)
        try:
            if t_mode == 3:
                layer.setRotation(0.0)
                if a < 0.5:
                    p = 2.0 * a * a
                    sc = float(1.0 + 0.65 * p)
                else:
                    u = (a - 0.5) * 2.0
                    p = u * (2.0 - u)
                    sc = float(0.45 + 0.55 * p)
                layer.setScaleX(sc)
                layer.setScaleY(sc)
                layer.setAlpha(float(1.0 - 0.45 * s))
                return
            elif t_mode == 4:
                layer.setRotation(0.0)
                step_a = float(int(a * 8.0 + 0.5)) / 8.0
                sc = float(1.0 + 0.03 * s)
                layer.setScaleX(sc)
                layer.setScaleY(sc)
                layer.setAlpha(float(1.0 - 0.22 * (4.0 * step_a * (1.0 - step_a))))
                return
            elif t_mode == 2:
                if a < 0.5:
                    p = 2.0 * a * a
                else:
                    u = 1.0 - a
                    p = 1.0 - 2.0 * u * u
                layer.setRotation(float(p * 360.0))
                sc = float(1.0 + 0.08 * s)
                layer.setScaleX(sc)
                layer.setScaleY(sc)
                layer.setAlpha(float(1.0 - 0.15 * s))
                return
            elif t_mode == 1:
                layer.setRotation(0.0)
                sc = float(1.0 + 0.04 * s)
                layer.setScaleX(sc)
                layer.setScaleY(sc)
                layer.setAlpha(float(1.0 - 0.35 * s))
                return
            else:
                layer.setRotation(0.0)
                layer.setScaleX(1.0)
                layer.setScaleY(1.0)
        except Exception:
            pass
        try:
            layer.setAlpha(a)
            return
        except Exception:
            pass
        try:
            layer.setAlpha(int(a * 255))
        except Exception:
            pass

    def _post_mix_tick(self, layer, delay):
        r = getattr(self, "_mix_tick_r", None)
        if layer is None or r is None:
            return
        try:
            layer.postDelayed(r, int(delay))
            return
        except Exception:
            pass
        try:
            layer.post(r)
        except Exception:
            pass

    def _start_mix_anim(self, layer_b):
        self._stop_mix_anim()
        if layer_b is None:
            return
        mix_ms, hold_ms, total = self._mix_cycle_times()
        self._mix_anim_mix = mix_ms
        self._mix_anim_hold = hold_ms
        self._mix_anim_total = total
        self._mix_anim_layer = layer_b
        self._mix_anim_t0 = self._now_anim_ms()
        plugin = self

        def _tick():
            layer = getattr(plugin, "_mix_anim_layer", None)
            if layer is None:
                return
            try:
                total_i = int(plugin._mix_anim_total)
                if total_i <= 0:
                    return
                now = plugin._now_anim_ms()
                frac = float((now - plugin._mix_anim_t0) % total_i) / float(total_i)
                a = plugin._mix_alpha_at(frac, plugin._mix_anim_mix, plugin._mix_anim_hold)
                plugin._apply_mix_alpha(layer, a)
            except Exception:
                pass
            plugin._post_mix_tick(layer, 16)

        started = False
        try:
            runner = _R
            if runner is None:
                raise Exception("no R")
            self._mix_tick_r = runner(_tick)
            self._mix_anim = True
            self._post_mix_tick(layer_b, 0)
            started = True
        except Exception:
            started = False
        if started:
            return
        try:
            from java import dynamic_proxy
            from java.lang import Runnable

            class _Tick(dynamic_proxy(Runnable)):
                def run(self):
                    _tick()

            self._mix_tick_r = _Tick()
            self._mix_anim = True
            self._post_mix_tick(layer_b, 0)
            started = True
        except Exception:
            started = False
        if started:
            return
        try:
            from android.animation import ValueAnimator
            from android.view.animation import LinearInterpolator
            from java import dynamic_proxy
            anim = ValueAnimator.ofFloat(0.0, 1.0)
            anim.setDuration(int(total))
            anim.setRepeatCount(ValueAnimator.INFINITE)
            anim.setRepeatMode(ValueAnimator.RESTART)
            anim.setInterpolator(LinearInterpolator())

            class _UL(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self, animation):
                    try:
                        t = float(animation.getAnimatedFraction())
                        a = plugin._mix_alpha_at(t, mix_ms, hold_ms)
                        plugin._apply_mix_alpha(layer_b, a)
                    except Exception:
                        pass

            anim.addUpdateListener(_UL())
            anim.start()
            self._mix_anim = anim
        except Exception:
            self._mix_anim = None

    def _install_classwatch(self):
        if self._hooks_ready:
            return
        try:
            cl = _safe_find_class("java.lang.ClassLoader")
            if cl is None:
                return
            unhooks = self.hook_all_methods(cl, "loadClass", _ClassLoadWatch(self))
            if unhooks:
                self._unhooks.extend(unhooks)
        except Exception:
            pass

    def _on_class_loaded(self, name):
        if self._hooks_ready or self._watch_pending:
            return
        if not name.startswith("org.telegram") and not name.startswith("com.exteragram"):
            return
        wanted = (
            self.ICV, self.ICV + "$VideoRecorder", self.ICV + "$CameraGLThread",
            self.ICV + "$EncoderRenderer", self.ICV + "$Delegate",
            "org.telegram.messenger.SendMessagesHelper",
            "org.telegram.ui.ChatActivity",
            "org.telegram.messenger.NotificationCenter",
        )
        if name not in wanted and not name.startswith(self.ICV + "$"):
            return
        self._watch_pending = True

        def _ui():
            self._watch_pending = False
            self._install_hooks(only_missing=True)

        try:
            run_on_ui_thread(_ui)
        except Exception:
            _ui()

    def _short_for(self, class_name):
        return class_name.split(".")[-1].split("$")[-1]

    def _mark_ready(self):
        send_ok = (
            self._counts.get("InstantCameraView.send", 0) > 0
            or self._counts.get("ChatActivity.sendMedia", 0) > 0
            or self._counts.get("Delegate.sendMedia", 0) > 0
            or self._counts.get("SendMessagesHelper~prepareSendingVideo", 0) > 0
        )
        flip_ok = (
            self._counts.get("InstantCameraView.switchCamera", 0) > 0
            or self._counts.get("CameraGLThread.flipSurfaces", 0) > 0
            or self._counts.get("CameraGLThread.reinitForNewCamera", 0) > 0
            or self._counts.get("CameraGLThread.switchCamera", 0) > 0
        )
        if send_ok and flip_ok:
            self._hooks_ready = True

    def _schedule_rehook(self, delay_s):
        if self._reattempts >= 3 or self._hooks_ready:
            return

        def _bg():
            time.sleep(delay_s)

            def _ui():
                self._reattempts += 1
                self._install_hooks(only_missing=True)
                if not self._hooks_ready:
                    self._schedule_rehook(delay_s * 2)

            try:
                run_on_ui_thread(_ui)
            except Exception:
                pass

        self._run_bg(_bg)

    def _load_notification_ids(self):
        try:
            nc = _safe_find_class("org.telegram.messenger.NotificationCenter")
            if nc is None:
                return
            self._nc_started = self._static_int(nc, "recordStarted")
            self._nc_stopped = self._static_int(nc, "recordStopped")
        except Exception:
            pass

    def _static_int(self, clazz, name):
        try:
            f = clazz.getDeclaredField(name)
            f.setAccessible(True)
            return int(f.get(None))
        except Exception:
            pass
        try:
            v = get_private_field(clazz, name)
            if v is not None:
                return int(v)
        except Exception:
            pass
        try:
            return int(getattr(clazz, name))
        except Exception:
            return None

    def _install_hooks(self, only_missing=False):
        H = _SafeHook
        self._hook_overloads(self.ICV, "send", H(self, self._before_icv_send, self._after_icv_send), only_missing)
        self._hook_overloads(self.ICV, "switchCamera", H(self, self._before_switch, self._after_switch), only_missing)
        self._hook_overloads(self.ICV, "showCamera", H(self, None, self._after_show_camera), only_missing)
        self._hook_overloads(self.ICV, "togglePause", H(self, None, self._after_toggle_pause), only_missing)
        self._hook_overloads(self.ICV, "cancel", H(self, None, self._after_cancel), only_missing)
        self._scan_icv_once()
        self._hook_inner_classes(only_missing)
        self._hook_overloads("org.telegram.ui.ChatActivity", "sendMedia", H(self, self._before_send_media, None), only_missing)
        self._hook_overloads(self.ICV + "$Delegate", "sendMedia", H(self, self._before_send_media, None), only_missing)
        for cls in (
            "org.telegram.messenger.camera.CameraXController",
            "com.exteragram.messenger.camera.CameraXController",
            "org.telegram.ui.Components.CameraView",
            "org.telegram.messenger.camera.CameraController",
            "org.telegram.messenger.camera.CameraSession",
            "org.telegram.messenger.camera.Camera2Session",
            "org.telegram.messenger.camera.CameraSessionWrapper",
        ):
            self._hook_overloads(cls, "switchCamera", H(self, self._before_switch, self._after_switch), only_missing, quiet=True)
            self._hook_overloads(cls, "switchToNext", H(self, self._before_switch, self._after_switch), only_missing, quiet=True)
            self._hook_overloads(cls, "changeCamera", H(self, self._before_switch, self._after_switch), only_missing, quiet=True)
        try:
            icv = _safe_find_class(self.ICV)
            if icv is not None:
                for m in icv.getDeclaredMethods():
                    try:
                        nm = str(m.getName())
                    except Exception:
                        continue
                    low = nm.lower()
                    if "switch" in low and not any(k in low for k in ("flash", "mode", "night", "zoom", "lens", "wide", "ultra", "tele", "scale", "ratio")):
                        self._hook_on(icv, self.ICV, nm, H(self, self._before_switch, self._after_switch), only_missing, quiet=True)
        except Exception as e:
            self._log("HOOKS", "icv switch scan", self._err_str(e))
        self._log("HOOKS", "install", self._hook_summary())
        self._hook_contains("org.telegram.messenger.SendMessagesHelper", "prepareSendingVideo",
                            H(self, self._before_prepare_video, None), only_missing)
        self._hook_notifications(only_missing)
        self._mark_ready()

    def _hook_notifications(self, only_missing):
        short = "NotificationCenter.postNotificationName"
        if only_missing and self._counts.get(short, 0) > 0:
            return
        if self._nc_started is None and self._nc_stopped is None:
            return
        clazz = _safe_find_class("org.telegram.messenger.NotificationCenter")
        if clazz is None:
            return
        try:
            unhooks = self.hook_all_methods(clazz, "postNotificationName", _NotifyHook(self))
            n = len(unhooks or [])
            if unhooks:
                self._unhooks.extend(unhooks)
            self._counts[short] = max(self._counts.get(short, 0), n)
        except Exception:
            self._counts.setdefault(short, 0)

    def _on_notification(self, param):
        try:
            nid_i = int(param.args[0])
        except Exception:
            return
        if self._nc_started is not None and nid_i == int(self._nc_started):
            self._latch_recording(param.thisObject)
            return
        if self._nc_stopped is not None and nid_i == int(self._nc_stopped):
            self._recording = False
            self._session_active = False
            self._last_stop_ms = self._now_ms()

    def _scan_icv_once(self):
        if self._icv_scanned:
            return
        icv = _safe_find_class(self.ICV)
        if icv is None:
            return
        self._icv_scanned = True

    def _hook_inner_classes(self, only_missing):
        H = _SafeHook
        icv = _safe_find_class(self.ICV)
        inners = []
        if icv is not None:
            try:
                declared = icv.getDeclaredClasses()
                if declared is not None:
                    for c in declared:
                        inners.append(c)
            except Exception:
                pass
        for name in (
            self.ICV + "$VideoRecorder",
            self.ICV + "$CameraGLThread",
            self.ICV + "$EncoderRenderer",
            self.ICV + "$EncoderHandler",
            self.ICV + "$Delegate",
            self.ICV + "_VideoRecorder",
            self.ICV + "_CameraGLThread",
            "org.telegram.ui.Components.VideoRecorder",
        ):
            c = _safe_find_class(name)
            if c is not None:
                inners.append(c)
        seen = set()
        for inner in inners:
            try:
                full = str(inner.getName())
            except Exception:
                continue
            if full in seen:
                continue
            seen.add(full)
            names = _method_names(inner)
            short = self._short_for(full)
            name_set = set(names)
            for m in START_METHODS:
                if m in name_set:
                    self._hook_on(inner, full, m, H(self, self._before_vr_start, None), only_missing)
            if "onEncoderSurfaceCreated" in name_set:
                self._hook_on(inner, full, "onEncoderSurfaceCreated",
                              H(self, None, self._after_encoder_created), only_missing)
            for m in STOP_METHODS:
                if m in name_set:
                    self._hook_on(inner, full, m, H(self, None, self._after_stop), only_missing)
            if short in ("CameraGLThread", "VideoRecorder", "EncoderHandler"):
                for m in GL_STOP_METHODS:
                    if m in name_set:
                        self._hook_on(inner, full, m, H(self, None, self._after_stop), only_missing, quiet=True)
            if short != "Delegate":
                for m in FLIP_METHODS:
                    if m in name_set:
                        self._hook_on(inner, full, m, H(self, self._before_switch, self._after_switch), only_missing)
            if "sendMedia" in name_set:
                self._hook_on(inner, full, "sendMedia", H(self, self._before_send_media, None), only_missing)
        self._inner_scanned = True

    def _hook_overloads(self, class_name, method_name, handler, only_missing=False, quiet=False):
        short = self._short_for(class_name) + "." + method_name
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        clazz = _safe_find_class(class_name)
        if clazz is None:
            self._counts.setdefault(short, 0)
            return 0
        return self._hook_on(clazz, class_name, method_name, handler, only_missing, quiet=quiet)

    def _hook_on(self, clazz, class_name, method_name, handler, only_missing=False, quiet=False):
        short = self._short_for(class_name) + "." + method_name
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        n = 0
        try:
            unhooks = self.hook_all_methods(clazz, method_name, handler)
            n = len(unhooks or [])
            if unhooks:
                self._unhooks.extend(unhooks)
        except Exception:
            pass
        if n == 0:
            try:
                methods = clazz.getDeclaredMethods()
                for m in methods:
                    if str(m.getName()) != method_name:
                        continue
                    try:
                        m.setAccessible(True)
                        u = self.hook_method(m, handler)
                        if u:
                            self._unhooks.append(u)
                        n += 1
                    except Exception:
                        pass
            except Exception:
                pass
        self._counts[short] = max(self._counts.get(short, 0), n)
        return n

    def _hook_contains(self, class_name, needle, handler, only_missing=False):
        short = self._short_for(class_name) + "~" + needle
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        clazz = _safe_find_class(class_name)
        if clazz is None:
            self._counts.setdefault(short, 0)
            return 0
        n = 0
        try:
            for m in clazz.getDeclaredMethods():
                if needle not in str(m.getName()):
                    continue
                try:
                    m.setAccessible(True)
                    u = self.hook_method(m, handler)
                    if u:
                        self._unhooks.append(u)
                    n += 1
                except Exception:
                    pass
        except Exception:
            pass
        self._counts[short] = max(self._counts.get(short, 0), n)
        return n

    def _load_mixer(self):
        self._mixer_class = None
        last = None
        try:
            from java import jclass
            from java.nio import ByteBuffer
            Base64 = jclass("android.util.Base64")
            Build = jclass("android.os.Build")
            File = jclass("java.io.File")
            FileOutputStream = jclass("java.io.FileOutputStream")
            raw = Base64.decode(DEX_B64.strip(), 0)
            if raw is None or len(raw) < 64:
                self._mixer_status = "empty dex"
                self._log("DEX", "empty")
                return
            try:
                nraw = len(raw)
            except Exception:
                nraw = -1
            self._log("DEX", "decoded", "bytes=%s" % nraw)
            ctx = self._app_context()
            parent_cl = ctx.getClassLoader()
            sdk = int(Build.VERSION.SDK_INT)
            loader = None
            how = None
            if sdk >= 26:
                try:
                    InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
                    loader = InMemoryDexClassLoader(ByteBuffer.wrap(raw), parent_cl)
                    how = "inmemory-wrap"
                except Exception as e:
                    last = e
                    self._log("DEX", "inmemory wrap fail", self._err_str(e))
                    loader = None
                if loader is None:
                    try:
                        InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
                        bb = ByteBuffer.allocateDirect(nraw)
                        bb.put(raw)
                        bb.position(0)
                        loader = InMemoryDexClassLoader(bb, parent_cl)
                        how = "inmemory-direct"
                    except Exception as e:
                        last = e
                        self._log("DEX", "inmemory direct fail", self._err_str(e))
                        loader = None
            if loader is None:
                DexClassLoader = jclass("dalvik.system.DexClassLoader")
                dirs = []
                try:
                    dirs.append(ctx.getCodeCacheDir())
                except Exception:
                    pass
                try:
                    dirs.append(ctx.getDir("ioscircle_dex", 0))
                except Exception:
                    pass
                try:
                    dirs.append(ctx.getCacheDir())
                except Exception:
                    pass
                for cache in dirs:
                    try:
                        dex_file = File(cache, "ioscircle3.dex")
                        if dex_file.exists():
                            try:
                                dex_file.setWritable(True, False)
                            except Exception:
                                pass
                            dex_file.delete()
                        fos = FileOutputStream(dex_file)
                        fos.write(raw)
                        try:
                            fos.flush()
                        except Exception:
                            pass
                        fos.close()
                        try:
                            dex_file.setWritable(False, False)
                            dex_file.setReadable(True, True)
                            dex_file.setReadOnly()
                        except Exception as e:
                            self._log("DEX", "setReadOnly", self._err_str(e))
                        opt = File(cache, "ioscircle3_opt")
                        if not opt.exists():
                            opt.mkdirs()
                        loader = DexClassLoader(dex_file.getAbsolutePath(), opt.getAbsolutePath(), None, parent_cl)
                        how = "file:%s" % dex_file.getAbsolutePath()
                        break
                    except Exception as e:
                        last = e
                        self._log("DEX", "file load fail", self._err_str(e))
                        loader = None
            if loader is None:
                raise last if last is not None else Exception("no dex loader")
            cls = loader.loadClass("ioscircle.Mixer")
            self._mixer_class = cls
            self._mixer_status = "loaded:%s" % how
            self._log("DEX", "loaded", how)
        except Exception as e:
            self._mixer_class = None
            self._mixer_status = "%s: %s" % (type(e).__name__, e)
            self._log("DEX", "failed", self._err_str(e))

    def _java_array(self, component, values, setter):
        from java import jclass
        Array = jclass("java.lang.reflect.Array")
        n = len(values)
        arr = Array.newInstance(component, n)
        for i in range(n):
            setter(arr, i, values[i])
        return arr

    def _box_arg(self, t, v):
        from java import jclass
        Integer = jclass("java.lang.Integer")
        Long = jclass("java.lang.Long")
        Boolean = jclass("java.lang.Boolean")
        Array = jclass("java.lang.reflect.Array")
        tn = str(t.getName())
        if tn in ("java.lang.String", "String"):
            return None if v is None else str(v)
        if tn == "int":
            return Integer.valueOf(int(v))
        if tn == "long":
            return Long.valueOf(int(v))
        if tn == "boolean":
            return Boolean.valueOf(bool(v))
        if tn in ("[J", "long[]"):
            seq = list(v or [])
            return self._java_array(Long.TYPE, [int(x) for x in seq], Array.setLong)
        if tn in ("[I", "int[]"):
            seq = list(v or [])
            return self._java_array(Integer.TYPE, [int(x) for x in seq], Array.setInt)
        return v

    def _invoke_static(self, m, values):
        from java import jclass, jarray
        try:
            from java.lang import Object
        except Exception:
            Object = jclass("java.lang.Object")
        ptypes = list(m.getParameterTypes())
        if len(ptypes) != len(values):
            raise Exception("param count %d != %d" % (len(ptypes), len(values)))
        boxed = [self._box_arg(t, v) for t, v in zip(ptypes, values)]
        obj_arr = jarray(Object)(boxed)
        last = None
        try:
            return m.invoke(None, obj_arr)
        except Exception as e:
            last = e
        try:
            return m.invoke(None, boxed)
        except Exception as e:
            last = e
        try:
            return m.invoke(None, *boxed)
        except Exception as e:
            last = e
        raise last

    def _cut_min_gap(self):
        try:
            return max(int(CUT_MIN_GAP_MS), int(self._mix_ms() * 0.7))
        except Exception:
            return 450

    def _valid_cuts(self):
        gap = self._cut_min_gap()
        out = []
        for x in self._switches_ms:
            try:
                v = int(x)
            except Exception:
                continue
            if v <= 40:
                continue
            if out and abs(v - out[-1]) < gap:
                continue
            out.append(v)
        return out

    def _transition_mode(self):
        try:
            t = int(self.get_setting("transition_type", 0) or 0)
        except Exception:
            t = 0
        if t < 0 or t > 4:
            t = 0
        return t

    def _mix_file(self, in_path, out_path):
        mix_ms = self._mix_ms()
        base_easing = int(self.get_setting("easing", 1) or 1)
        if base_easing < 0 or base_easing > 2:
            base_easing = 1
        t_mode = self._transition_mode()
        easing = t_mode * 10 + base_easing
        path_i = 0
        try:
            path_i = int(self.get_setting("mix_path", 0) or 0)
        except Exception:
            path_i = 0
        cuts = self._valid_cuts()
        zoom_ignored = int(getattr(self, "_zoom_cuts_ignored", 0))
        self._log("MIX", "begin", "in=%s out=%s mix=%s ease=%s trans=%s path=%s hook_cuts=%s zoom_ign=%s" % (
            in_path, out_path, mix_ms, base_easing, t_mode, path_i, cuts, zoom_ignored,
        ))
        try:
            from java.io import File
            inf = File(in_path)
            self._log("MIX", "input", "exists=%s size=%s" % (inf.exists(), int(inf.length()) if inf.exists() else 0))
        except Exception as e:
            self._log("MIX", "input stat", self._err_str(e))
        if not cuts and zoom_ignored > 0:
            self._log("MIX", "skip auto cut detect after 0.5x/1x lens switch")
            return "NO_CUTS"
        if not cuts:
            try:
                cuts = self._dex_detect_cuts(in_path)
            except Exception as e:
                self._log("CUTS", "dex detect", self._err_str(e))
                cuts = []
            if cuts:
                self._log("CUTS", "from dex detect", str(cuts))
        spec = "mixMs=%d;freeze=1;easing=%d;cuts=%s" % (
            mix_ms,
            easing,
            ",".join(str(int(c)) for c in cuts),
        )
        last_err = "no mixer"
        if path_i != 3 and self._mixer_class is None:
            try:
                self._load_mixer()
            except Exception:
                pass
        if path_i != 3 and self._mixer_class is not None:
            self._log("MIX", "dex first", "path=%s auto=%s" % (path_i, int(path_i == 0)))
            try:
                run = None
                proc = None
                proc_cuts = None
                for m in self._mixer_class.getDeclaredMethods():
                    nm = str(m.getName())
                    nparams = 0
                    try:
                        nparams = len(list(m.getParameterTypes()))
                    except Exception:
                        pass
                    if nm == "run" and nparams == 3:
                        run = m
                    elif nm == "process" and nparams == 5:
                        proc = m
                    elif nm == "processWithCuts" and nparams == 6:
                        proc_cuts = m
                last_err = "no process method"
                if run is not None:
                    run.setAccessible(True)
                    try:
                        self._log("MIX", "dex run", spec)
                        err = self._invoke_static(run, [in_path, out_path, spec])
                        err_s = _safe_str(err) if err is not None else ""
                        if err is None or (isinstance(err, str) and err.strip() == ""):
                            self._log("MIX", "dex run ok")
                            return None
                        last_err = err_s or "dex run empty-err"
                        self._log("MIX", "dex run ret", last_err)
                    except Exception as e:
                        last_err = self._err_str(e)
                        self._log("MIX", "dex run exc", last_err)
                if cuts and proc_cuts is not None:
                    proc_cuts.setAccessible(True)
                    try:
                        self._log("MIX", "dex processWithCuts", str(cuts))
                        err = self._invoke_static(proc_cuts, [in_path, out_path, mix_ms, True, easing, cuts])
                        if err is None or (isinstance(err, str) and err.strip() == ""):
                            self._log("MIX", "dex processWithCuts ok")
                            return None
                        last_err = _safe_str(err) or last_err
                        self._log("MIX", "dex processWithCuts ret", last_err)
                    except Exception as e:
                        last_err = self._err_str(e)
                        self._log("MIX", "dex processWithCuts exc", last_err)
                if proc is not None:
                    proc.setAccessible(True)
                    try:
                        self._log("MIX", "dex process auto")
                        err = self._invoke_static(proc, [in_path, out_path, mix_ms, True, easing])
                        if err is None or (isinstance(err, str) and err.strip() == ""):
                            self._log("MIX", "dex process ok")
                            return None
                        last_err = _safe_str(err) or last_err
                        self._log("MIX", "dex process ret", last_err)
                    except Exception as e:
                        last_err = self._err_str(e)
                        self._log("MIX", "dex process exc", last_err)
            except Exception as e:
                last_err = self._err_str(e)
                self._log("MIX", "dex block", last_err)
        elif self._mixer_class is None:
            last_err = "mixer not loaded"
            self._log("MIX", last_err)
        if path_i == 1:
            return last_err
        if last_err and "NO_CUTS" in _safe_str(last_err) and not cuts:
            self._log("MIX", "NO_CUTS after dex, still trying py detect")
        try:
            err = self._try_py_mix(in_path, out_path, mix_ms, easing, cuts)
            if err is None or (isinstance(err, str) and err.strip() == ""):
                return None
            last_err = err or last_err
        except Exception as e:
            last_err = self._err_str(e)
            self._log("MIX", "py block", last_err)
        return last_err

    def _read_field(self, obj, name):
        if obj is None:
            return None
        try:
            v = get_private_field(obj, name)
            if v is not None:
                return v
        except Exception:
            pass
        try:
            v = getattr(obj, name, None)
            if v is not None:
                return v
        except Exception:
            pass
        try:
            cls = obj.getClass()
        except Exception:
            return None
        hops = 0
        while cls is not None and hops < 6:
            hops += 1
            try:
                f = cls.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                pass
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
        return None

    def _as_bool(self, v):
        if v is None:
            return False
        try:
            if v is True:
                return True
            if v is False:
                return False
        except Exception:
            pass
        try:
            s = str(v).strip().lower()
            if s in ("true", "1"):
                return True
            if s in ("false", "0", "none", "null"):
                return False
        except Exception:
            pass
        try:
            return bool(v.booleanValue())
        except Exception:
            pass
        try:
            return bool(v)
        except Exception:
            return False

    def _as_long(self, v):
        if v is None:
            return 0
        try:
            return int(v)
        except Exception:
            pass
        try:
            return int(v.longValue())
        except Exception:
            pass
        try:
            return int(str(v))
        except Exception:
            return 0

    def _path_of(self, obj):
        if obj is None:
            return None
        try:
            if hasattr(obj, "getAbsolutePath"):
                p = _safe_str(obj.getAbsolutePath())
                if p:
                    return p
        except Exception:
            pass
        try:
            s = _safe_str(obj)
            if s and s.lower().endswith(".mp4") and ("/" in s or "\\" in s):
                return s
        except Exception:
            pass
        return None

    def _chain(self, obj):
        out = []
        seen = set()
        cur = obj
        depth = 0
        while cur is not None and depth < 4:
            try:
                ident = id(cur)
            except Exception:
                ident = depth
            if ident in seen:
                break
            seen.add(ident)
            out.append(cur)
            nxt = None
            for name in OUTER_FIELDS:
                try:
                    nxt = self._read_field(cur, name)
                except Exception:
                    nxt = None
                if nxt is not None and nxt is not cur:
                    break
                nxt = None
            cur = nxt
            depth += 1
        return out

    def _remember_file(self, obj):
        if obj is None:
            return
        for o in self._chain(obj):
            path = self._path_of(o)
            if path:
                self._round_paths.add(path)
            for name in FILE_FIELDS:
                try:
                    f = self._read_field(o, name)
                    p = self._path_of(f)
                    if p:
                        self._round_paths.add(p)
                except Exception:
                    pass
        if len(self._round_paths) > 24:
            extra = list(self._round_paths)[:-16]
            for p in extra:
                self._round_paths.discard(p)
        if self._round_paths:
            self._remembered_this_session = True

    def _field_truthy(self, obj, name):
        return self._as_bool(self._read_field(obj, name))

    def _is_recording_obj(self, obj):
        if obj is None:
            return False
        for o in self._chain(obj):
            for name in RECORDING_FIELDS:
                if self._field_truthy(o, name):
                    return True
            rst = self._as_long(self._read_field(o, "recordStartTime"))
            if rst > 100000:
                return True
            rec_t = self._as_long(self._read_field(o, "recordedTime"))
            if rec_t > 200:
                return True
            for name in ENCODER_FIELDS:
                try:
                    enc = self._read_field(o, name)
                except Exception:
                    enc = None
                if enc is not None:
                    if self._field_truthy(enc, "started") or self._field_truthy(enc, "running"):
                        return True
        return False

    def _record_start_from(self, obj):
        for o in self._chain(obj):
            rst = self._as_long(self._read_field(o, "recordStartTime"))
            if rst > 100000:
                return rst
        return 0

    def _now_ms(self):
        try:
            from java.lang import System
            return int(System.currentTimeMillis())
        except Exception:
            return int(time.time() * 1000)

    def _latch_recording(self, obj):
        self._remember_file(obj)
        self._recording = True
        self._session_active = True
        self._log("REC", "latch", "start=%s" % getattr(self, "_rec_start", 0))
        rst = self._record_start_from(obj) if obj is not None else 0
        now = self._now_ms()
        if rst > 100000 and self._rec_start and rst > self._rec_start + 120:
            shift = rst - self._rec_start
            self._rec_start = rst
            adj = []
            for c in self._switches_ms:
                try:
                    v = int(c) - int(shift)
                except Exception:
                    continue
                if v > 40:
                    adj.append(v)
            self._switches_ms = adj
        elif not self._rec_start:
            self._rec_start = rst if rst else now
            self._switches_ms = []
            self._zoom_cuts_ignored = 0
            f = self._extract_facing(obj)
            if f is not None:
                self._last_facing = f
            self._pending_facing = None
            self._remembered_this_session = False
            self._remember_file(obj)

    def _ensure_recording(self, obj):
        self._remember_file(obj)
        if self._session_active and self._recording:
            if not self._rec_start:
                rst = self._record_start_from(obj)
                self._rec_start = rst if rst else self._now_ms()
            else:
                rst = self._record_start_from(obj)
                if rst > 100000 and rst > self._rec_start + 120:
                    shift = rst - self._rec_start
                    self._rec_start = rst
                    adj = []
                    for c in self._switches_ms:
                        try:
                            v = int(c) - int(shift)
                        except Exception:
                            continue
                        if v > 40:
                            adj.append(v)
                    self._switches_ms = adj
            return True
        rec = self._recording or self._is_recording_obj(obj)
        if not rec:
            return False
        self._latch_recording(obj)
        return True

    def _after_encoder_created(self, param):
        self._remember_file(param.thisObject)
        if self._is_recording_obj(param.thisObject) or self._session_active:
            self._latch_recording(param.thisObject)

    def _after_show_camera(self, param):
        from_paused = False
        try:
            if param.args and len(param.args) > 0:
                from_paused = bool(param.args[0])
        except Exception:
            from_paused = False
        self._remember_file(param.thisObject)
        if from_paused:
            return
        if self._is_recording_obj(param.thisObject):
            self._latch_recording(param.thisObject)
            return
        self._recording = False
        self._session_active = False
        self._rec_start = 0
        self._switches_ms = []
        self._zoom_cuts_ignored = 0
        self._last_facing = self._extract_facing(param.thisObject)
        self._pending_facing = None
        self._remembered_this_session = False

    def _after_toggle_pause(self, param):
        self._remember_file(param.thisObject)
        self._recording = bool(self._is_recording_obj(param.thisObject))

    def _after_cancel(self, param):
        self._recording = False
        self._session_active = False
        self._last_stop_ms = self._now_ms()

    def _before_vr_start(self, param):
        try:
            if param.args and len(param.args) > 0:
                self._remember_file(param.args[0])
        except Exception:
            pass
        self._latch_recording(param.thisObject)

    def _after_stop(self, param):
        self._remember_file(param.thisObject)
        if self._session_active or self._recording:
            self._last_stop_ms = self._now_ms()
        self._log("REC", "stop", "cuts=%s paths=%s" % (list(self._switches_ms), list(self._round_paths)[:6]))
        self._recording = False
        self._session_active = False

    def _extract_facing(self, obj):
        if obj is None:
            return None
        for o in self._chain(obj):
            for fn in FACING_FIELDS:
                v = self._read_field(o, fn)
                if v is not None:
                    return 1 if self._as_bool(v) else 0
            try:
                for mname in ("isFrontface", "isFront", "isFrontCamera"):
                    if hasattr(o, mname):
                        r = getattr(o, mname)()
                        if r is not None:
                            return 1 if self._as_bool(r) else 0
            except Exception:
                pass
            for cam_field in CAMERA_OBJ_FIELDS:
                cam = self._read_field(o, cam_field)
                if cam is None or cam is o:
                    continue
                for fn in ("frontCamera", "isFrontface", "isFront", "frontface", "lensFacing", "facing"):
                    cv = self._read_field(cam, fn)
                    if cv is not None:
                        try:
                            iv = int(cv)
                            if fn in ("lensFacing", "facing"):
                                return 0 if iv == 1 else 1
                            return 1 if iv != 0 else 0
                        except Exception:
                            return 1 if self._as_bool(cv) else 0
                try:
                    for mname in ("isFrontface", "isFront", "getLensFacing"):
                        if hasattr(cam, mname):
                            r = getattr(cam, mname)()
                            if r is not None:
                                if mname == "getLensFacing":
                                    return 0 if int(r) == 1 else 1
                                return 1 if self._as_bool(r) else 0
                except Exception:
                    pass
        return None

    def _is_zoom_or_lens_call(self, param):
        try:
            mname = str(param.method.getName()).lower() if param.method is not None else ""
        except Exception:
            mname = ""
        if any(k in mname for k in ("zoom", "lens", "wide", "ultra", "tele", "scale", "ratio", "0.5", "1x", "2x")):
            return True
        try:
            args = param.args
            if args and len(args) > 0:
                for a in args:
                    if a is None:
                        continue
                    if isinstance(a, float):
                        return True
                    tn = _cls_name(a.getClass()).lower() if hasattr(a, "getClass") else type(a).__name__.lower()
                    if tn in ("float", "double", "java.lang.float", "java.lang.double"):
                        return True
                    sa = (_safe_str(a) or "").lower()
                    if any(k in sa for k in ("0.5", "1x", "2x", "3x", "wide", "ultra", "tele", "zoom")):
                        return True
        except Exception:
            pass
        return False

    def _before_switch(self, param):
        f = self._extract_facing(param.thisObject)
        if f is not None:
            self._pending_facing = f
            if self._last_facing is None:
                self._last_facing = f

    def _after_switch(self, param):
        obj = param.thisObject
        try:
            mname = str(param.method.getName()) if param.method is not None else "?"
        except Exception:
            mname = "?"
        if self._is_zoom_or_lens_call(param):
            self._zoom_cuts_ignored = int(getattr(self, "_zoom_cuts_ignored", 0)) + 1
            self._log("SW", "ignore zoom/lens call", mname)
            return
        rec = self._ensure_recording(obj)
        now = self._now_ms()
        delta = now - self._rec_start if self._rec_start else 0
        try:
            cls_name = _cls_name(obj.getClass()) if obj is not None else "?"
        except Exception:
            cls_name = "?"
        cur_facing = self._extract_facing(obj)
        prev_facing = self._pending_facing if self._pending_facing is not None else self._last_facing
        self._pending_facing = None
        if not rec:
            if cur_facing is not None:
                self._last_facing = cur_facing
            self._log("SW", "ignore not recording", "%s.%s" % (cls_name, mname))
            return
        if delta <= 40:
            if cur_facing is not None:
                self._last_facing = cur_facing
            self._log("SW", "ignore early", "%s.%s d=%s" % (cls_name, mname, delta))
            return
        try:
            cls_name = _cls_name(obj.getClass())
        except Exception:
            cls_name = ""
        short = cls_name.split(".")[-1] if cls_name else ""
        if cur_facing is not None and prev_facing is not None:
            if cur_facing == prev_facing and mname != "flipSurfaces":
                self._zoom_cuts_ignored = int(getattr(self, "_zoom_cuts_ignored", 0)) + 1
                self._log("SW", "ignore same facing (0.5x/1x lens)", "%s.%s facing=%s" % (cls_name, mname, cur_facing))
                return
            self._last_facing = cur_facing
        elif cur_facing is not None:
            self._last_facing = cur_facing
        echo = (
            short in ("CameraGLThread", "EncoderRenderer", "EncoderHandler", "CameraView", "Delegate")
            or "CameraX" in short
            or "GLThread" in short
            or "ChatActivity" in short
            or "$" in short
        )
        min_gap = self._cut_min_gap()
        if self._switches_ms:
            gap = delta - self._switches_ms[-1]
            if gap < min_gap:
                self._log("SW", "ignore dup", "%s.%s d=%s gap=%s min=%s" % (cls_name, mname, delta, gap, min_gap))
                return
            if echo and gap < max(min_gap, 520):
                self._log("SW", "ignore echo", "%s.%s d=%s gap=%s" % (cls_name, mname, delta, gap))
                return
        self._switches_ms.append(delta)
        self._log("SW", "cut", "%s.%s d=%s facing=%s->%s cuts=%s" % (cls_name, mname, delta, prev_facing, cur_facing, list(self._switches_ms)))

    def _before_icv_send(self, param):
        try:
            state = int(param.args[0])
        except Exception:
            state = -1
        self._remember_file(param.thisObject)
        if state == 4 or state == 1 or state == 3:
            self._recording = False
            self._session_active = False
            self._last_stop_ms = self._now_ms()

    def _after_icv_send(self, param):
        self._remember_file(param.thisObject)

    def _is_round_info(self, info):
        if info is None:
            return False
        try:
            v = getattr(info, "roundVideo", None)
            if self._as_bool(v):
                return True
        except Exception:
            pass
        try:
            if self._as_bool(self._read_field(info, "roundVideo")):
                return True
        except Exception:
            pass
        try:
            if self._as_bool(get_private_field(info, "roundVideo")):
                return True
        except Exception:
            pass
        return False

    def _snapshot_args(self, param):
        try:
            n = len(param.args)
            return [param.args[i] for i in range(n)]
        except Exception:
            try:
                return list(param.args)
            except Exception:
                return []

    def _xposed_bridge(self):
        if self._xb is not None:
            return self._xb
        for name in (
            "de.robv.android.xposed.XposedBridge",
            "org.lsposed.lspd.impl.LSPosedBridge",
        ):
            cls = _safe_find_class(name)
            if cls is not None:
                self._xb = cls
                return cls
        self._xb = False
        return None

    def _call_original(self, method, this, args):
        last = None
        xb = self._xposed_bridge()
        if xb and xb is not False:
            try:
                from java import jarray
                from java.lang import Object
                jargs = jarray(Object)(list(args))
                xb.invokeOriginalMethod(method, this, jargs)
                return True
            except Exception as e:
                last = e
        try:
            name = str(method.getName())
            fn = getattr(this, name)
            fn(*tuple(args))
            return True
        except Exception as e:
            last = e
        try:
            if this is None:
                method.invoke(None, *tuple(args))
            else:
                method.invoke(this, *tuple(args))
            return True
        except Exception as e:
            last = e
        return False

    def _resend_on_ui(self, method, this, args):
        def _invoke():
            self._passthrough += 1
            try:
                ok = self._call_original(method, this, args)
                if not ok:
                    self._toast("iOS mix: send failed")
            except Exception:
                self._toast("iOS mix: send failed")
            finally:
                if self._passthrough > 0:
                    self._passthrough -= 1

        try:
            run_on_ui_thread(_invoke)
        except Exception:
            _invoke()

    def _before_send_media(self, param):
        if self._passthrough > 0:
            return
        if not self.get_setting("enabled", True):
            return
        entry = param.args[0] if param.args else None
        info = None
        try:
            if param.args and len(param.args) > 1:
                info = param.args[1]
        except Exception:
            info = None
        path = self._entry_path(entry)
        is_round = self._is_round_info(info) or (path in self._round_paths)
        cuts = self._valid_cuts()
        self._log("SEND", "sendMedia", "path=%s round=%s cuts=%s busy=%s" % (
            path, is_round, cuts, path in self._busy if path else False,
        ))
        if not path or path in self._processed or path in self._busy:
            return
        if not is_round:
            return
        args = self._snapshot_args(param)
        this = param.thisObject
        method = param.method
        param.setResult(None)
        self._busy.add(path)
        self._cancel_upload(path)
        self._toast("iOS mix…")
        self._run_bg(lambda: self._process_then_send(this, method, args, entry, info, path))

    def _before_prepare_video(self, param):
        if self._passthrough > 0:
            return
        if not self.get_setting("enabled", True):
            return
        cuts = self._valid_cuts()
        path = None
        path_index = -1
        round_flag = False
        info = None
        try:
            for i in range(len(param.args)):
                a = param.args[i]
                try:
                    if a is not None and (hasattr(a, "roundVideo") or "VideoEditedInfo" in type(a).__name__):
                        info = a
                        if self._is_round_info(a):
                            round_flag = True
                except Exception:
                    pass
                s = None
                try:
                    if isinstance(a, str) and a.lower().endswith(".mp4"):
                        s = a
                    elif a is not None and hasattr(a, "getAbsolutePath"):
                        s = _safe_str(a.getAbsolutePath())
                except Exception:
                    s = None
                if s and (s in self._round_paths or s in self._busy):
                    path = s
                    path_index = i
        except Exception:
            return
        if path is None and (round_flag or self._is_round_info(info)):
            try:
                for i in range(len(param.args)):
                    a = param.args[i]
                    if isinstance(a, str) and a.lower().endswith(".mp4"):
                        path, path_index = a, i
                        break
            except Exception:
                pass
        if not path or path in self._processed or path in self._busy:
            return
        if not (round_flag or self._is_round_info(info) or path in self._round_paths):
            self._log("SEND", "prepare skip not round", path)
            return
        self._log("SEND", "prepareSendingVideo", "path=%s round=%s cuts=%s" % (path, round_flag, self._valid_cuts()))
        args = self._snapshot_args(param)
        this = param.thisObject
        method = param.method
        param.setResult(None)
        self._busy.add(path)
        self._cancel_upload(path)
        self._toast("iOS mix…")

        def _go():
            try:
                self._wait_stable(path, 8000)
                out = self._do_mix(path)
                if out and out != path and path_index >= 0:
                    try:
                        args[path_index] = out
                    except Exception:
                        pass
                    self._processed.add(out)
                self._processed.add(path)
            except Exception:
                pass
            finally:
                self._busy.discard(path)
            self._resend_on_ui(method, this, args)

        self._run_bg(_go)

    def _entry_path(self, entry):
        if entry is None:
            return None
        for name in ("path", "imagePath", "originalPath"):
            try:
                v = getattr(entry, name, None)
                if v:
                    return _safe_str(v)
            except Exception:
                pass
            try:
                v = self._read_field(entry, name)
                if v:
                    return _safe_str(v)
            except Exception:
                pass
        return self._path_of(entry)

    def _set_entry_path(self, entry, info, out):
        if entry is not None:
            for name in ("path", "imagePath", "originalPath"):
                try:
                    setattr(entry, name, out)
                except Exception:
                    try:
                        set_private_field(entry, name, out)
                    except Exception:
                        pass
        if info is not None:
            try:
                info.originalPath = out
            except Exception:
                try:
                    set_private_field(info, "originalPath", out)
                except Exception:
                    pass
            try:
                info.notReadyYet = False
            except Exception:
                try:
                    set_private_field(info, "notReadyYet", False)
                except Exception:
                    pass
            try:
                from java.io import File
                sz = int(File(out).length())
                if sz > 0:
                    try:
                        info.estimatedSize = sz
                    except Exception:
                        try:
                            set_private_field(info, "estimatedSize", sz)
                        except Exception:
                            pass
            except Exception:
                pass

    def _process_then_send(self, this, method, args, entry, info, path):
        try:
            self._wait_stable(path, 8000)
            out = self._do_mix(path)
            if out and out != path:
                self._set_entry_path(entry, info, out)
                self._processed.add(out)
            self._processed.add(path)
        except Exception as e:
            self._log("MIX", "process_then_send", self._err_str(e))
            self._toast("iOS mix failed, sending original")
        finally:
            self._busy.discard(path)
        self._resend_on_ui(method, this, args)

    def _do_mix(self, path):
        self._log("MIX", "do_mix", path)
        wait = 280
        try:
            wait = int((getattr(self, "_profile", None) or {}).get("wait_ms", 280))
        except Exception:
            wait = 280
        try:
            elapsed = self._now_ms() - int(self._last_stop_ms or 0)
            if self._last_stop_ms and elapsed >= 0 and elapsed < wait:
                from java.lang import Thread as JThread
                sl = int(wait - elapsed)
                self._log("MIX", "wait encoder", "%sms" % sl)
                JThread.sleep(sl)
        except Exception as e:
            self._log("MIX", "wait fail", self._err_str(e))
        cache = get_cache_dir() or "/data/data"
        out_dir = os.path.join(str(cache), "ioscircle")
        try:
            ensure_dir_exists(out_dir)
        except Exception:
            try:
                os.makedirs(out_dir)
            except Exception:
                out_dir = os.path.dirname(path)
        base = os.path.splitext(os.path.basename(path))[0]
        out_path = os.path.join(out_dir, base + "_iosmix.mp4")
        err = self._mix_file(path, out_path)
        if err is not None and _safe_str(err) and "NO_CUTS" not in _safe_str(err):
            try:
                from java.lang import Thread as JThread
                JThread.sleep(450)
            except Exception:
                pass
            self._log("MIX", "retry once", _safe_str(err))
            err2 = self._mix_file(path, out_path)
            if err2 is None or (isinstance(err2, str) and err2.strip() == ""):
                err = None
            else:
                err = err2
        if err is None or (isinstance(err, str) and err.strip() == ""):
            self._toast("iOS mix ready")
            self._log("MIX", "ready", out_path)
            return out_path
        err_s = _safe_str(err) or "unknown"
        if "NO_CUTS" in err_s:
            self._log("MIX", "NO_CUTS, original")
            return path
        self._toast("iOS mix skipped: " + err_s)
        self._log("MIX", "skipped", err_s)
        return path

    def _wait_stable(self, path, timeout_ms):
        try:
            from java.io import File
            from java.lang import Thread as JThread
            f = File(path)
            last = -1
            stable = 0
            waited = 0
            while waited < timeout_ms:
                sz = int(f.length()) if f.exists() else 0
                if sz > 64 and sz == last:
                    stable += 1
                    if stable >= 4:
                        return True
                else:
                    stable = 0
                last = sz
                JThread.sleep(80)
                waited += 80
            return f.exists() and int(f.length()) > 64
        except Exception:
            return True

    def _cancel_upload(self, path):
        try:
            FileLoader = _sdk_find_class("org.telegram.messenger.FileLoader")
            UserConfig = _sdk_find_class("org.telegram.messenger.UserConfig")
            if FileLoader is None or UserConfig is None:
                return
            acc = int(UserConfig.selectedAccount)
            FileLoader.getInstance(acc).cancelFileUpload(path, False)
        except Exception:
            pass

    def _run_bg(self, fn):
        try:
            from java.lang import Thread
            t = Thread(fn)
            t.setName("ioscircle-mix")
            t.start()
        except Exception:
            try:
                import threading
                threading.Thread(target=fn, name="ioscircle-mix").start()
            except Exception:
                fn()

    def _err_str(self, e):
        s = "%s: %s" % (type(e).__name__, e)
        try:
            c = None
            try:
                c = e.getCause()
            except Exception:
                c = getattr(e, "cause", None)
            if c is not None:
                s = s + " | cause: %s" % c
        except Exception:
            pass
        return s

    def _log(self, tag, msg, extra=None):
        try:
            if not self._debug_on():
                return
            ms = 0
            try:
                from java.lang import System
                ms = int(System.currentTimeMillis())
            except Exception:
                ms = int(time.time() * 1000)
            ts = time.strftime("%H:%M:%S")
            try:
                ts = "%s.%03d" % (ts, ms % 1000)
            except Exception:
                pass
            line = "[%s] %s: %s" % (ts, tag, msg)
            if extra is not None:
                es = _safe_str(extra)
                if es:
                    if len(es) > 800:
                        es = es[:800] + "…"
                    line = line + " | " + es
            logs = getattr(self, "_logs", None)
            if logs is None:
                self._logs = []
                logs = self._logs
            logs.append(line)
            if len(logs) > 800:
                del logs[:300]
            self._log_seq = int(getattr(self, "_log_seq", 0)) + 1
            try:
                path = getattr(self, "_log_path", None)
                if not path:
                    path = os.path.join(self._preview_dir(), "debug.log")
                    self._log_path = path
                f = open(path, "a")
                try:
                    f.write(line + "\n")
                finally:
                    f.close()
            except Exception:
                pass
        except Exception:
            pass

    def _log_text(self, limit=0):
        logs = list(getattr(self, "_logs", None) or [])
        if not logs:
            try:
                path = getattr(self, "_log_path", None) or os.path.join(self._preview_dir(), "debug.log")
                f = open(path, "r")
                try:
                    logs = f.read().splitlines()
                finally:
                    f.close()
            except Exception:
                logs = []
        if limit and len(logs) > limit:
            logs = logs[-limit:]
        return "\n".join(logs) if logs else "(зловещая пустота..)"

    def _copy_text(self, text):
        ok = False
        try:
            from android.content import ClipData, Context
            ctx = None
            try:
                frag = get_last_fragment()
                if frag is not None:
                    ctx = frag.getParentActivity()
            except Exception:
                ctx = None
            if ctx is None:
                ctx = self._app_context()
            cm = ctx.getSystemService("clipboard")
            cm.setPrimaryClip(ClipData.newPlainText("ioscircle-log", text))
            ok = True
        except Exception as e:
            self._log("UI", "clipboard fail", self._err_str(e))
            ok = False
        if ok:
            self._toast("Логи скопированы")
        else:
            self._toast("Не удалось скопировать")
        return ok

    def _on_clear_logs(self, view=None):
        try:
            self._logs = []
            path = getattr(self, "_log_path", None) or os.path.join(self._preview_dir(), "debug.log")
            try:
                f = open(path, "w")
                f.write("")
                f.close()
            except Exception:
                pass
            self._log("UI", "logs cleared")
            self._toast("Логи очищены")
        except Exception:
            pass

    def _on_show_logs(self, view=None):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment:
                self._toast("Нет окна для логов")
                return
            activity = current_fragment.getParentActivity()
            if not activity:
                self._toast("Нет окна для логов")
                return
            full = self._log_text(0)
            shown = self._log_text(120)
            if len(shown) > 7000:
                shown = shown[-7000:]
            builder = AlertDialogBuilder(activity)
            builder.set_title("многострадальни iOS Circle")
            builder.set_message(shown)

            def on_copy(bld, which):
                self._copy_text(full)
                try:
                    bld.dismiss()
                except Exception:
                    pass

            def on_clear(bld, which):
                self._on_clear_logs()
                try:
                    bld.dismiss()
                except Exception:
                    pass

            builder.set_positive_button("Копировать все", on_copy)
            builder.set_negative_button("Очистить", on_clear)
            builder.show()
        except Exception as e:
            self._log("UI", "show logs fail", self._err_str(e))
            self._toast("Не удалось открыть логи")

    def _on_dump_device(self, view=None):
        if not self._debug_on():
            self._toast("Включи debug режим")
            return
        self._probe_device(force=True)
        try:
            self._list_encoders()
        except Exception:
            pass
        self._log("DEV", "hooks", self._hook_summary())
        self._toast("Инфо об устройстве записана в логи")

    def _hook_summary(self):
        parts = []
        try:
            items = sorted((self._counts or {}).items())
            for k, v in items:
                if v:
                    parts.append("%s=%s" % (k, v))
        except Exception:
            pass
        if not parts:
            return "нет"
        s = ", ".join(parts)
        if len(s) > 180:
            s = s[:180] + "…"
        return s

    def _mix_ms(self):
        mix_i = int(self.get_setting("mix_duration", 2) or 2)
        if mix_i < 0 or mix_i >= len(MIX_MS_VALUES):
            mix_i = 2
        return int(MIX_MS_VALUES[mix_i])

    def _probe_device(self, force=False):
        if getattr(self, "_probed", False) and not force:
            return self._profile
        profile = {
            "is_flagship": False,
            "is_pixel": False,
            "is_qcom": False,
            "prefer_sw": False,
            "wait_ms": 280,
            "name": "unknown",
        }
        try:
            from java import jclass
            Build = jclass("android.os.Build")
            man = _safe_str(getattr(Build, "MANUFACTURER", "")) or ""
            model = _safe_str(getattr(Build, "MODEL", "")) or ""
            device = _safe_str(getattr(Build, "DEVICE", "")) or ""
            hw = _safe_str(getattr(Build, "HARDWARE", "")) or ""
            board = _safe_str(getattr(Build, "BOARD", "")) or ""
            soc = ""
            try:
                soc = _safe_str(getattr(Build, "SOC_MODEL", "")) or ""
            except Exception:
                soc = ""
            try:
                soc2 = _safe_str(getattr(Build, "SOC_MANUFACTURER", "")) or ""
            except Exception:
                soc2 = ""
            sdk = 0
            rel = ""
            try:
                sdk = int(Build.VERSION.SDK_INT)
                rel = _safe_str(Build.VERSION.RELEASE) or ""
            except Exception:
                pass
            abi = ""
            try:
                abis = Build.SUPPORTED_ABIS
                abi = ",".join([_safe_str(x) for x in abis])
            except Exception:
                try:
                    abi = _safe_str(Build.CPU_ABI) or ""
                except Exception:
                    abi = ""
            blob = (" ".join([man, model, device, hw, board, soc, soc2])).lower()
            flagship_keys = (
                "kalama", "pineapple", "sun", "taro", "waipio", "lahaina", "kona", "cape", "ukee", "cliff", "crow",
                "sm8850", "sm8750", "sm8735", "sm8650", "sm8635", "sm8550", "sm8475", "sm8450", "sm8350", "sm7675", "sm7550",
                "8 gen 3", "8 gen 2", "8 gen 4", "8 elite", "8s gen", "7+ gen",
                "dimensity 9400", "dimensity 9300", "dimensity 9200", "dimensity 9000", "dimensity 8400", "dimensity 8300", "dimensity 8200",
                "mt6991", "mt6989", "mt6985", "mt6983", "mt6897", "mt6896", "mt6895",
                "exynos 2500", "exynos 2400", "exynos 2200", "s5e9945", "s5e9935", "s5e9925",
                "tensor g3", "tensor g4", "tensor g5", "zuma", "zumapro", "laguna",
                "kirin 9000", "kirin 9010", "kirin 9020",
            )
            is_flagship = any(k in blob for k in flagship_keys)
            is_pixel = ("google" in man.lower()) or ("pixel" in model.lower()) or ("tensor" in blob) or ("zuma" in blob) or ("gs201" in blob) or ("gs101" in blob)
            is_mtk = any(k in blob for k in ("mtk", "mediatek", "dimensity", "helio", "mt67", "mt68", "mt69"))
            is_exynos = any(k in blob for k in ("exynos", "s5e", "erd", "universal"))
            is_kirin = any(k in blob for k in ("kirin", "hi36", "hi62", "hisilicon"))
            is_unisoc = any(k in blob for k in ("unisoc", "spreadtrum", "ums", "sp98", "t606", "t616", "t618", "t820"))
            is_qcom = any(k in blob for k in ("qcom", "qualcomm", "snapdragon", "adreno", "sm8", "sm7", "sm6", "sm4", "sdm")) or hw.lower() in (
                "qcom", "kalama", "pineapple", "sun", "taro", "waipio", "lahaina", "kona", "yupik", "blair", "holi", "strait", "bengal", "khaje", "crow", "cliff",
            )
            if "sm6375" in blob or "sm695" in blob or "yupik" in blob or "blair" in blob or "bengal" in blob or "khaje" in blob:
                is_qcom = True
                is_flagship = False
            prefer_sw = bool(is_pixel or is_exynos or is_kirin or is_unisoc or (is_mtk and not is_flagship) or (not is_flagship and not is_qcom))
            if is_flagship and not is_pixel and not is_exynos:
                wait_ms = 180
            elif is_qcom:
                wait_ms = 340
            elif is_mtk or is_exynos:
                wait_ms = 480
            else:
                wait_ms = 550
            if is_pixel:
                wait_ms = 450
                prefer_sw = True
            profile = {
                "is_flagship": bool(is_flagship and not is_pixel),
                "is_pixel": bool(is_pixel),
                "is_qcom": bool(is_qcom),
                "prefer_sw": bool(prefer_sw),
                "wait_ms": int(wait_ms),
                "name": "%s %s" % (man, model),
                "man": man,
                "model": model,
                "device": device,
                "hw": hw,
                "board": board,
                "soc": soc,
                "soc_man": soc2,
                "sdk": sdk,
                "rel": rel,
                "abi": abi,
            }
            self._log("DEV", "device", "%s | hw=%s board=%s soc=%s/%s sdk=%s (%s) abi=%s flagship=%s pixel=%s qcom=%s wait=%s prefer_sw=%s" % (
                profile["name"], hw, board, soc, soc2, sdk, rel, abi, profile["is_flagship"], is_pixel, is_qcom, wait_ms, prefer_sw,
            ))
        except Exception as e:
            self._log("DEV", "probe fail", self._err_str(e))
        self._profile = profile
        self._probed = True
        try:
            self._list_encoders()
        except Exception as e:
            self._log("DEV", "codec list fail", self._err_str(e))
        return profile

    def _list_encoders(self):
        out = []
        try:
            from java import jclass
            MediaCodecList = jclass("android.media.MediaCodecList")
            infos = None
            try:
                mcl = MediaCodecList(1)
                infos = mcl.getCodecInfos()
            except Exception:
                infos = None
            if infos is None:
                try:
                    n = int(MediaCodecList.getCodecCount())
                    infos = [MediaCodecList.getCodecInfoAt(i) for i in range(n)]
                except Exception:
                    infos = []
            for info in infos:
                try:
                    if not info.isEncoder():
                        continue
                    types = []
                    try:
                        types = list(info.getSupportedTypes() or [])
                    except Exception:
                        types = []
                    types_s = [str(t) for t in types]
                    video = [t for t in types_s if t.startswith("video/")]
                    if not video:
                        continue
                    name = str(info.getName())
                    colors = []
                    for t in video:
                        try:
                            caps = info.getCapabilitiesForType(t)
                            cf = caps.colorFormats
                            if cf is not None:
                                for i in range(len(cf)):
                                    colors.append(int(cf[i]))
                        except Exception:
                            pass
                    rec = {"name": name, "types": video, "colors": colors}
                    out.append(rec)
                    self._log("CODEC", name, "types=%s colors=%s" % (",".join(video), ",".join(str(c) for c in colors[:16])))
                except Exception as e:
                    self._log("CODEC", "info fail", self._err_str(e))
        except Exception as e:
            self._log("CODEC", "list fail", self._err_str(e))
        self._encoders = out
        return out

    def _as_cut_list(self, v):
        out = []
        if v is None:
            return out
        seq = None
        try:
            seq = list(v)
        except Exception:
            seq = None
        if seq is None:
            try:
                from java import jclass
                Array = jclass("java.lang.reflect.Array")
                n = int(Array.getLength(v))
                seq = []
                for i in range(n):
                    try:
                        seq.append(Array.getLong(v, i))
                    except Exception:
                        seq.append(Array.get(v, i))
            except Exception:
                seq = None
        if seq is None:
            try:
                out.append(int(v))
                seq = None
            except Exception:
                return []
        if seq is not None:
            for x in seq:
                try:
                    out.append(int(x))
                except Exception:
                    continue
        if not out:
            return []
        mx = max([abs(x) for x in out])
        if mx > 1000000:
            out = [int(x / 1000) for x in out]
        gap = 450
        try:
            gap = self._cut_min_gap()
        except Exception:
            gap = 450
        clean = []
        for x in out:
            if x <= 40:
                continue
            if clean and abs(x - clean[-1]) < gap:
                continue
            clean.append(int(x))
        return clean

    def _dex_detect_cuts(self, path):
        if self._mixer_class is None:
            return []
        mix_ms = self._mix_ms()
        for m in self._mixer_class.getDeclaredMethods():
            try:
                if str(m.getName()) != "detectCuts":
                    continue
            except Exception:
                continue
            try:
                m.setAccessible(True)
                ptypes = list(m.getParameterTypes())
                n = len(ptypes)
            except Exception:
                continue
            tries = []
            if n == 1:
                tries.append([path])
            elif n == 2:
                tries.append([path, mix_ms])
                tries.append([path, True])
            elif n == 3:
                tries.append([path, mix_ms, True])
            for args in tries:
                try:
                    r = self._invoke_static(m, args)
                    cuts = self._as_cut_list(r)
                    self._log("CUTS", "detectCuts n=%d -> %s" % (n, cuts), None)
                    if cuts:
                        return cuts
                except Exception as e:
                    self._log("CUTS", "detectCuts fail", self._err_str(e))
        return []

    def _find_track(self, ex, prefix):
        try:
            n = int(ex.getTrackCount())
        except Exception:
            return -1
        for i in range(n):
            try:
                fmt = ex.getTrackFormat(i)
                mime = _safe_str(fmt.getString("mime")) or ""
                if mime.startswith(prefix):
                    return i
            except Exception:
                continue
        return -1

    def _fmt_int(self, fmt, key, default=0):
        try:
            if fmt.containsKey(key):
                return int(fmt.getInteger(key))
        except Exception:
            pass
        try:
            return int(fmt.getInteger(key))
        except Exception:
            return int(default)

    def _fmt_long(self, fmt, key, default=0):
        try:
            if fmt.containsKey(key):
                return int(fmt.getLong(key))
        except Exception:
            pass
        try:
            return int(fmt.getLong(key))
        except Exception:
            return int(default)

    def _align(self, v, a):
        a = int(a) if a else 16
        if a < 2:
            a = 2
        v = int(v)
        r = ((v + a - 1) // a) * a
        if r < a:
            r = a
        return r

    def _release_codec(self, c):
        if c is None:
            return
        try:
            c.stop()
        except Exception:
            pass
        try:
            c.release()
        except Exception:
            pass

    def _bb_to_py(self, buf):
        if buf is None:
            return None
        n = 0
        pos = 0
        try:
            pos = int(buf.position())
            n = int(buf.remaining())
        except Exception:
            try:
                n = int(buf.capacity())
            except Exception:
                return None
        if n <= 0:
            return bytearray()
        try:
            from jarray import zeros
            arr = zeros(n, "b")
            buf.get(arr)
            try:
                buf.position(pos)
            except Exception:
                pass
            out = bytearray(n)
            for i in range(n):
                out[i] = arr[i] & 0xFF
            return out
        except Exception:
            pass
        try:
            if buf.hasArray():
                raw = buf.array()
                off = int(buf.arrayOffset()) + int(buf.position())
                n = int(buf.remaining())
                out = bytearray(n)
                for i in range(n):
                    out[i] = raw[off + i] & 0xFF
                return out
        except Exception:
            return None
        return None

    def _bb_put_py(self, buf, data):
        if buf is None or data is None:
            return 0
        n = len(data)
        try:
            from jarray import zeros
            arr = zeros(n, "b")
            for i in range(n):
                v = data[i] & 0xFF
                arr[i] = v if v < 128 else v - 256
            try:
                buf.clear()
            except Exception:
                pass
            buf.put(arr)
            return n
        except Exception:
            try:
                buf.clear()
                for i in range(n):
                    v = data[i] & 0xFF
                    buf.put(v if v < 128 else v - 256)
                return n
            except Exception:
                return 0

    def _yuv_size(self, w, h):
        return int(w) * int(h) * 3 // 2

    def _pad_i420(self, src, w, h, aw, ah):
        if src is None:
            return None
        w = int(w)
        h = int(h)
        aw = int(aw)
        ah = int(ah)
        if w == aw and h == ah:
            return src
        out = bytearray(self._yuv_size(aw, ah))
        aysz = aw * ah
        out[aysz:] = b"\x80" * (len(out) - aysz)
        mw = w if w < aw else aw
        mh = h if h < ah else ah
        for y in range(mh):
            row = src[y * w:y * w + mw]
            out[y * aw:y * aw + mw] = row
            if aw > mw and mw > 0:
                out[y * aw + mw:(y + 1) * aw] = bytes([row[-1]]) * (aw - mw)
        if ah > mh and mh > 0:
            last_row = bytes(out[(mh - 1) * aw:mh * aw])
            for y in range(mh, ah):
                out[y * aw:(y + 1) * aw] = last_row
        uw = w // 2
        uh = h // 2
        auw = aw // 2
        auh = ah // 2
        ysz = w * h
        muw = uw if uw < auw else auw
        muh = uh if uh < auh else auh
        v0_dst = aysz + auw * auh
        v0_src = ysz + uw * uh
        for y in range(muh):
            u_row = src[ysz + y * uw:ysz + y * uw + muw]
            v_row = src[v0_src + y * uw:v0_src + y * uw + muw]
            out[aysz + y * auw:aysz + y * auw + muw] = u_row
            out[v0_dst + y * auw:v0_dst + y * auw + muw] = v_row
            if auw > muw and muw > 0:
                out[aysz + y * auw + muw:aysz + (y + 1) * auw] = bytes([u_row[-1]]) * (auw - muw)
                out[v0_dst + y * auw + muw:v0_dst + (y + 1) * auw] = bytes([v_row[-1]]) * (auw - muw)
        if auh > muh and muh > 0:
            last_u = bytes(out[aysz + (muh - 1) * auw:aysz + muh * auw])
            last_v = bytes(out[v0_dst + (muh - 1) * auw:v0_dst + muh * auw])
            for y in range(muh, auh):
                out[aysz + y * auw:aysz + (y + 1) * auw] = last_u
                out[v0_dst + y * auw:v0_dst + (y + 1) * auw] = last_v
        return out

    def _decoder_to_i420(self, data, w, h, stride, slice_h, color, crop_l=0, crop_t=0):
        if data is None:
            return None
        w = int(w)
        h = int(h)
        crop_l = int(crop_l or 0) & ~1
        crop_t = int(crop_t or 0) & ~1
        if stride is None or int(stride) < w + crop_l:
            stride = w + crop_l
        if slice_h is None or int(slice_h) < h + crop_t:
            slice_h = h + crop_t
        stride = int(stride)
        slice_h = int(slice_h)
        packed = bytearray(self._yuv_size(w, h))
        ysz = w * h
        uw = w // 2
        uh = h // 2
        packed[ysz:] = b"\x80" * (len(packed) - ysz)
        color = int(color or 0)
        semi = color in (21, 39, 2141391872, 2141391876, 2141391873, 2141391875, 2130708361, 2141391878, 2130708480, 2135033992)
        nv21 = color in (39, 2141391876, 2141391875, 2141391873)
        try:
            for y in range(h):
                src = (y + crop_t) * stride + crop_l
                dst = y * w
                packed[dst:dst + w] = data[src:src + w]
            if semi:
                uv0 = stride * slice_h
                for y in range(uh):
                    src = uv0 + (y + crop_t // 2) * stride + crop_l
                    row = data[src:src + 2 * uw]
                    if len(row) == 2 * uw:
                        if nv21:
                            packed[ysz + y * uw:ysz + (y + 1) * uw] = row[1::2]
                            packed[ysz + uw * uh + y * uw:ysz + uw * uh + (y + 1) * uw] = row[0::2]
                        else:
                            packed[ysz + y * uw:ysz + (y + 1) * uw] = row[0::2]
                            packed[ysz + uw * uh + y * uw:ysz + uw * uh + (y + 1) * uw] = row[1::2]
            else:
                usz = stride * slice_h
                c_stride = stride // 2
                uoff = usz
                voff = usz + c_stride * (slice_h // 2)
                if voff + uw * uh > len(data):
                    voff = usz + uw * uh
                    uoff = usz
                    c_stride = uw
                for y in range(uh):
                    u_src = uoff + (y + crop_t // 2) * c_stride + crop_l // 2
                    v_src = voff + (y + crop_t // 2) * c_stride + crop_l // 2
                    packed[ysz + y * uw:ysz + (y + 1) * uw] = data[u_src:u_src + uw]
                    packed[ysz + uw * uh + y * uw:ysz + uw * uh + (y + 1) * uw] = data[v_src:v_src + uw]
            return packed
        except Exception as e:
            self._log("YUV", "to_i420 fail", self._err_str(e))
            if len(data) >= self._yuv_size(w, h):
                return bytearray(data[:self._yuv_size(w, h)])
            return None

    def _i420_to_encoder(self, src, w, h, stride, slice_h, color):
        w = int(w)
        h = int(h)
        if stride is None or int(stride) < w:
            stride = w
        if slice_h is None or int(slice_h) < h:
            slice_h = h
        stride = int(stride)
        slice_h = int(slice_h)
        color = int(color or 21)
        ysz = w * h
        uw = w // 2
        uh = h // 2
        semi = color in (21, 39, 2141391872, 2141391876, 2141391873, 2141391875, 2130708361, 2141391878, 2130708480, 2135033992)
        nv21 = color in (39, 2141391876, 2141391875, 2141391873)
        out_n = stride * slice_h * 3 // 2
        if out_n < self._yuv_size(w, h):
            out_n = self._yuv_size(w, h)
        out = bytearray(out_n)
        luma_end = stride * slice_h
        if luma_end < out_n:
            out[luma_end:] = b"\x80" * (out_n - luma_end)
        for y in range(h):
            row = src[y * w:(y + 1) * w]
            out[y * stride:y * stride + w] = row
            if stride > w and w > 0:
                out[y * stride + w:(y + 1) * stride] = bytes([row[-1]]) * (stride - w)
        if slice_h > h and h > 0:
            last_row = bytes(out[(h - 1) * stride:h * stride])
            for y in range(h, slice_h):
                out[y * stride:(y + 1) * stride] = last_row
        if semi:
            uv0 = stride * slice_h
            for y in range(uh):
                dst = uv0 + y * stride
                u_row = src[ysz + y * uw:ysz + (y + 1) * uw]
                v_row = src[ysz + uw * uh + y * uw:ysz + uw * uh + (y + 1) * uw]
                if nv21:
                    out[dst:dst + 2 * uw:2] = v_row
                    out[dst + 1:dst + 2 * uw:2] = u_row
                else:
                    out[dst:dst + 2 * uw:2] = u_row
                    out[dst + 1:dst + 2 * uw:2] = v_row
                if stride > 2 * uw and uw > 0:
                    pair = bytes([out[dst + 2 * uw - 2], out[dst + 2 * uw - 1]])
                    out[dst + 2 * uw:dst + stride] = pair * ((stride - 2 * uw) // 2)
        else:
            uoff = stride * slice_h
            c_stride = stride // 2
            c_slice = slice_h // 2
            voff = uoff + c_stride * c_slice
            for y in range(uh):
                u_row = src[ysz + y * uw:ysz + (y + 1) * uw]
                v_row = src[ysz + uw * uh + y * uw:ysz + uw * uh + (y + 1) * uw]
                out[uoff + y * c_stride:uoff + y * c_stride + uw] = u_row
                out[voff + y * c_stride:voff + y * c_stride + uw] = v_row
                if c_stride > uw and uw > 0:
                    out[uoff + y * c_stride + uw:uoff + (y + 1) * c_stride] = bytes([u_row[-1]]) * (c_stride - uw)
                    out[voff + y * c_stride + uw:voff + (y + 1) * c_stride] = bytes([v_row[-1]]) * (c_stride - uw)
        return out

    def _blend_i420(self, a, b, t, w=0, h=0):
        if a is None:
            return b
        if b is None:
            return a
        t_mode = 0
        if t >= 35.0:
            t_mode = 4
            t = t - 40.0
        elif t >= 25.0:
            t_mode = 3
            t = t - 30.0
        elif t >= 15.0:
            t_mode = 2
            t = t - 20.0
        elif t >= 5.0:
            t_mode = 1
            t = t - 10.0
        if t <= 0:
            return bytearray(a)
        if t >= 1:
            return bytearray(b)
        n = len(a) if len(a) <= len(b) else len(b)
        if w <= 0 or h <= 0:
            ysz = n * 2 // 3
            w = int(ysz ** 0.5)
            h = ysz // w if w > 0 else 0
        ysz = w * h
        uw = w // 2
        uh = h // 2
        if t_mode == 0 or ysz <= 0:
            out = bytearray(n)
            ia = max(0, min(256, int(t * 256)))
            ib = 256 - ia
            for i in range(n):
                out[i] = (a[i] * ib + b[i] * ia) >> 8
            return out
        s = 4.0 * t * (1.0 - t)
        if t_mode == 1:
            u = t * t * (3.0 - 2.0 * t)
            ia = max(0, min(256, int(u * 256)))
            ib = 256 - ia
            dark = max(160, min(256, 256 - int(s * 82.0)))
            wa = (ib * dark) >> 8
            wb = (ia * dark) >> 8
            out = bytearray(n)
            for i in range(ysz):
                out[i] = (a[i] * wa + b[i] * wb) >> 8
            for i in range(ysz, n):
                ca = (a[i] - 128) * ib + (b[i] - 128) * ia
                out[i] = max(0, min(255, ((ca * dark) >> 16) + 128))
            rad = max(1, int(s * (w / 15.0)))
            r2 = (rad + 1) >> 1
            tmp = bytearray(ysz)
            for y in range(h):
                row = y * w
                for x in range(w):
                    x1 = max(0, x - rad)
                    x2 = max(0, x - r2)
                    x4 = min(w - 1, x + r2)
                    x5 = min(w - 1, x + rad)
                    tmp[row + x] = (out[row + x1] + (out[row + x2] << 1) + (out[row + x] << 1) + (out[row + x4] << 1) + out[row + x5] + 4) >> 3
            for y in range(h):
                row = y * w
                y1 = max(0, y - rad) * w
                y2 = max(0, y - r2) * w
                y4 = min(h - 1, y + r2) * w
                y5 = min(h - 1, y + rad) * w
                for x in range(w):
                    out[row + x] = (tmp[y1 + x] + (tmp[y2 + x] << 1) + (tmp[row + x] << 1) + (tmp[y4 + x] << 1) + tmp[y5 + x] + 4) >> 3
            return out
        if t_mode == 3:
            u = t * t * (3.0 - 2.0 * t)
            ia = max(0, min(256, int(u * 256)))
            ib = 256 - ia
            dark = max(180, min(256, 256 - int(s * 56.0)))
            wa = (ib * dark) >> 8
            wb = (ia * dark) >> 8
            inv_sa = int(1024.0 / (1.0 + 1.35 * t * t))
            u1 = 1.0 - t
            inv_sb = int(1024.0 / max(0.2, 1.0 - 0.62 * u1 * u1))
            cx = w >> 1
            cy = h >> 1
            v_off = ysz + uw * uh
            out = bytearray(n)
            for y in range(h):
                dy = y - cy
                row = y * w
                sya = max(0, min(h - 1, cy + ((dy * inv_sa) >> 10)))
                syb = max(0, min(h - 1, cy + ((dy * inv_sb) >> 10)))
                ra = sya * w
                rb = syb * w
                for x in range(w):
                    dx = x - cx
                    sxa = max(0, min(w - 1, cx + ((dx * inv_sa) >> 10)))
                    sxb = max(0, min(w - 1, cx + ((dx * inv_sb) >> 10)))
                    out[row + x] = (a[ra + sxa] * wa + b[rb + sxb] * wb) >> 8
                    if (x & 1) == 0 and (y & 1) == 0:
                        di = (y >> 1) * uw + (x >> 1)
                        sia = (sya >> 1) * uw + (sxa >> 1)
                        sib = (syb >> 1) * uw + (sxb >> 1)
                        ca_u = (a[ysz + sia] - 128) * ib + (b[ysz + sib] - 128) * ia
                        ca_v = (a[v_off + sia] - 128) * ib + (b[v_off + sib] - 128) * ia
                        out[ysz + di] = max(0, min(255, ((ca_u * dark) >> 16) + 128))
                        out[v_off + di] = max(0, min(255, ((ca_v * dark) >> 16) + 128))
            rad = max(1, int(s * (w / 18.0)))
            r2 = (rad + 1) >> 1
            tmp = bytearray(ysz)
            for y in range(h):
                row = y * w
                for x in range(w):
                    x1 = max(0, x - rad)
                    x2 = max(0, x - r2)
                    x4 = min(w - 1, x + r2)
                    x5 = min(w - 1, x + rad)
                    tmp[row + x] = (out[row + x1] + (out[row + x2] << 1) + (out[row + x] << 1) + (out[row + x4] << 1) + out[row + x5] + 4) >> 3
            for y in range(h):
                row = y * w
                y1 = max(0, y - rad) * w
                y2 = max(0, y - r2) * w
                y4 = min(h - 1, y + r2) * w
                y5 = min(h - 1, y + rad) * w
                for x in range(w):
                    out[row + x] = (tmp[y1 + x] + (tmp[y2 + x] << 1) + (tmp[row + x] << 1) + (tmp[y4 + x] << 1) + tmp[y5 + x] + 4) >> 3
            return out
        if t_mode == 4:
            blk = 1 + int(s * (w / 24.0))
            cell = max(4, w >> 5)
            t_sc = int(t * 332.0)
            v_off = ysz + uw * uh
            out = bytearray(n)
            for y in range(h):
                cy_i = y // cell
                by = min(h - 1, (y // blk) * blk + (blk >> 1))
                row = y * w
                brow = by * w
                for x in range(w):
                    cx_i = x // cell
                    hval = ((cx_i * 73) ^ (cy_i * 151) ^ ((cx_i + cy_i) * 37)) & 255
                    diff = t_sc - hval
                    idx = row + x
                    if diff <= 0:
                        out[idx] = a[idx]
                        if (x & 1) == 0 and (y & 1) == 0:
                            di = (y >> 1) * uw + (x >> 1)
                            out[ysz + di] = a[ysz + di]
                            out[v_off + di] = a[v_off + di]
                    elif diff >= 76:
                        out[idx] = b[idx]
                        if (x & 1) == 0 and (y & 1) == 0:
                            di = (y >> 1) * uw + (x >> 1)
                            out[ysz + di] = b[ysz + di]
                            out[v_off + di] = b[v_off + di]
                    else:
                        wb = (diff << 8) // 76
                        wa = 256 - wb
                        bx = min(w - 1, (x // blk) * blk + (blk >> 1))
                        bidx = brow + bx
                        out[idx] = (a[bidx] * wa + b[bidx] * wb) >> 8
                        if (x & 1) == 0 and (y & 1) == 0:
                            di = (y >> 1) * uw + (x >> 1)
                            si = (by >> 1) * uw + (bx >> 1)
                            out[ysz + di] = (a[ysz + si] * wa + b[ysz + si] * wb) >> 8
                            out[v_off + di] = (a[v_off + si] * wa + b[v_off + si] * wb) >> 8
            return out
        import math
        u = max(0.0, min(1.0, (t - 0.35) * 3.3333333))
        u = u * u * (3.0 - 2.0 * u)
        ia = max(0, min(256, int(u * 256)))
        ib = 256 - ia
        dark = max(200, min(256, 256 - int(s * 36.0)))
        wa = (ib * dark) >> 8
        wb = (ia * dark) >> 8
        blended = bytearray(n)
        for i in range(ysz):
            blended[i] = (a[i] * wa + b[i] * wb) >> 8
        for i in range(ysz, n):
            blended[i] = (a[i] * ib + b[i] * ia) >> 8
        if t < 0.5:
            p = 2.0 * t * t
        else:
            um = 1.0 - t
            p = 1.0 - 2.0 * um * um
        ang = p * 2.0 * math.pi
        inv_sc = 1.0 - 0.14 * s
        ic = int(math.cos(ang) * 1024.0 * inv_sc)
        is_ = int(math.sin(ang) * 1024.0 * inv_sc)
        cx = w >> 1
        cy = h >> 1
        out = bytearray(blended)
        v_off = ysz + uw * uh
        for y in range(h):
            dy = y - cy
            row = y * w
            for x in range(w):
                dx = x - cx
                ux = (dx * ic - dy * is_) >> 10
                uy = (dx * is_ + dy * ic) >> 10
                sx = max(0, min(w - 1, cx + ux))
                sy = max(0, min(h - 1, cy + uy))
                out[row + x] = blended[sy * w + sx]
                if (x & 1) == 0 and (y & 1) == 0:
                    di = (y >> 1) * uw + (x >> 1)
                    si = (sy >> 1) * uw + (sx >> 1)
                    out[ysz + di] = blended[ysz + si]
                    out[v_off + di] = blended[v_off + si]
        return out

    def _mad_y(self, a, b, w, h):
        if a is None or b is None:
            return 0
        n = int(w) * int(h)
        if n <= 0:
            return 0
        s = 0
        cnt = 0
        step = 17
        lim = n if n <= len(a) and n <= len(b) else min(len(a), len(b))
        i = 0
        while i < lim:
            s += abs(a[i] - b[i])
            cnt += 1
            i += step
        if cnt <= 0:
            return 0
        return s / float(cnt)

    def _py_detect_cuts(self, frames, w, h):
        cuts = []
        prev = None
        prev_pts = 0
        last_cut = -99999
        for pts, yuv in frames:
            if prev is not None:
                d = self._mad_y(prev, yuv, w, h)
                if d >= 22.0 and (pts - last_cut) >= 400:
                    cuts.append(int(pts))
                    last_cut = pts
                    self._log("CUTS", "py detect", "pts=%s mad=%.1f" % (pts, d))
            prev = yuv
            prev_pts = pts
        return cuts

    def _mix_attempts(self):
        path = 0
        try:
            path = int(self.get_setting("mix_path", 0) or 0)
        except Exception:
            path = 0
        encs = getattr(self, "_encoders", None) or []
        if not encs:
            try:
                encs = self._list_encoders()
            except Exception:
                encs = []
        sw = []
        hw = []
        for e in encs:
            n = (e.get("name") or "").lower()
            types = ",".join(e.get("types") or []).lower()
            if "avc" not in n and "h264" not in n and "avc" not in types:
                continue
            is_sw = (
                "google" in n
                or "c2.android" in n
                or n.startswith("omx.google")
                or "android.avc" in n
            )
            if is_sw:
                sw.append(e)
            else:
                hw.append(e)
        profile = getattr(self, "_profile", None) or {}
        if path == 0 or path == 1:
            prefer_sw = False
        elif path == 3:
            prefer_sw = True
        else:
            prefer_sw = bool(profile.get("prefer_sw"))
        colors_hw = [21, 19, 2135033992, 2141391872, 2141391876, 39]
        colors_sw = [19, 21, 2135033992]
        attempts = []

        def add(name, color, align, baseline, mime="video/avc"):
            attempts.append({
                "name": name,
                "color": int(color),
                "align": int(align),
                "baseline": bool(baseline),
                "mime": mime,
                "label": "%s color=%s align=%s bl=%s" % (name or "byType", color, align, int(bool(baseline))),
            })

        if path == 3:
            for e in sw:
                for c in colors_sw:
                    add(e.get("name"), c, 16, True)
            add(None, 19, 16, True)
            add(None, 21, 16, True)
            return attempts[:6]
        order = list(sw) + list(hw) if prefer_sw else list(hw) + list(sw)
        aligns = [16, 32] if (path == 2 or not profile.get("is_flagship")) else [16]
        for e in order:
            supported = e.get("colors") or []
            cols = colors_sw if e in sw else colors_hw
            use = []
            for c in cols:
                if not supported or c in supported or 2135033992 in supported:
                    use.append(c)
            if not use:
                use = cols[:3]
            for c in use[:3]:
                add(e.get("name"), c, aligns[0], e in sw)
                if len(aligns) > 1 and len(attempts) < 7:
                    add(e.get("name"), c, aligns[1], True)
            if len(attempts) >= 8:
                break
        add(None, 21, 16, False)
        add(None, 19, 16, True)
        add(None, 2135033992, 16, True)
        lim = 8 if path != 1 else 0
        return attempts[:lim]

    def _make_encoder(self, attempt, w, h, fps, bitrate):
        from java import jclass
        MediaCodec = jclass("android.media.MediaCodec")
        MediaFormat = jclass("android.media.MediaFormat")
        mime = attempt.get("mime") or "video/avc"
        name = attempt.get("name")
        if name:
            enc = MediaCodec.createByCodecName(str(name))
        else:
            enc = MediaCodec.createEncoderByType(mime)
        fmt = MediaFormat.createVideoFormat(mime, int(w), int(h))
        fmt.setInteger("bitrate", int(bitrate))
        fmt.setInteger("frame-rate", int(fps if fps else 30))
        fmt.setInteger("i-frame-interval", 1)
        fmt.setInteger("color-format", int(attempt.get("color") or 21))
        try:
            fmt.setInteger("bitrate-mode", 1)
        except Exception:
            pass
        if attempt.get("baseline"):
            try:
                fmt.setInteger("profile", 1)
                fmt.setInteger("level", 512)
            except Exception:
                pass
        enc.configure(fmt, None, None, 1)
        enc.start()
        return enc

    def _copy_audio(self, in_path, muxer, audio_track):
        if muxer is None or audio_track is None or int(audio_track) < 0:
            return
        from java import jclass
        MediaExtractor = jclass("android.media.MediaExtractor")
        ex = None
        try:
            ex = MediaExtractor()
            ex.setDataSource(in_path)
            aix = self._find_track(ex, "audio/")
            if aix < 0:
                return
            ex.selectTrack(aix)
            from java.nio import ByteBuffer
            buf = ByteBuffer.allocate(256 * 1024)
            info = jclass("android.media.MediaCodec$BufferInfo")()
            while True:
                try:
                    buf.clear()
                    n = int(ex.readSampleData(buf, 0))
                except Exception:
                    n = -1
                if n < 0:
                    break
                try:
                    info.offset = 0
                    info.size = n
                    info.presentationTimeUs = int(ex.getSampleTime())
                    info.flags = int(ex.getSampleFlags())
                    muxer.writeSampleData(int(audio_track), buf, info)
                except Exception as e:
                    self._log("AUD", "write fail", self._err_str(e))
                    break
                if not ex.advance():
                    break
        except Exception as e:
            self._log("AUD", "copy fail", self._err_str(e))
        finally:
            try:
                if ex is not None:
                    ex.release()
            except Exception:
                pass

    def _py_mix_once(self, in_path, out_path, mix_ms, easing, cuts, attempt):
        from java import jclass
        MediaExtractor = jclass("android.media.MediaExtractor")
        MediaCodec = jclass("android.media.MediaCodec")
        MediaFormat = jclass("android.media.MediaFormat")
        MediaMuxer = jclass("android.media.MediaMuxer")
        File = jclass("java.io.File")
        BufferInfo = jclass("android.media.MediaCodec$BufferInfo")
        extractor = None
        decoder = None
        encoder = None
        muxer = None
        mux_started = False
        try:
            f = File(out_path)
            if f.exists():
                f.delete()
            extractor = MediaExtractor()
            extractor.setDataSource(in_path)
            vix = self._find_track(extractor, "video/")
            if vix < 0:
                return "no video track"
            vfmt = extractor.getTrackFormat(vix)
            mime = _safe_str(vfmt.getString("mime")) or "video/avc"
            w = self._fmt_int(vfmt, "width", 384)
            h = self._fmt_int(vfmt, "height", 384)
            rot = self._fmt_int(vfmt, "rotation-degrees", 0)
            dur = self._fmt_long(vfmt, "durationUs", 0)
            fps = self._fmt_int(vfmt, "frame-rate", 30)
            if fps <= 0 or fps > 120:
                fps = 30
            aw = self._align(w, attempt.get("align") or 16)
            ah = self._align(h, attempt.get("align") or 16)
            bitrate = int(max(400000, min(1600000, aw * ah * int(fps) * 4)))
            self._log("PYMIX", "open", "mime=%s %dx%d rot=%s fps=%s dur=%s -> %dx%d %s" % (
                mime, w, h, rot, fps, dur, aw, ah, attempt.get("label"),
            ))
            decoder = MediaCodec.createDecoderByType(mime)
            decoder.configure(vfmt, None, None, 0)
            decoder.start()
            encoder = self._make_encoder(attempt, aw, ah, fps, bitrate)
            enc_color = int(attempt.get("color") or 21)
            in_stride = aw
            in_slice = ah
            try:
                inf = encoder.getInputFormat()
                in_stride = self._fmt_int(inf, "stride", aw) or aw
                in_slice = self._fmt_int(inf, "slice-height", ah) or ah
                enc_color = self._fmt_int(inf, "color-format", enc_color) or enc_color
            except Exception:
                pass
            extractor.selectTrack(vix)
            a_fmt = None
            try:
                aex = MediaExtractor()
                aex.setDataSource(in_path)
                aix = self._find_track(aex, "audio/")
                if aix >= 0:
                    a_fmt = aex.getTrackFormat(aix)
                aex.release()
            except Exception as e:
                self._log("AUD", "peek format", self._err_str(e))
                a_fmt = None
            muxer = MediaMuxer(out_path, 0)
            if rot:
                try:
                    muxer.setOrientationHint(int(rot))
                except Exception:
                    pass
            video_track = -1
            audio_track = -1
            info = BufferInfo()
            in_eos = False
            out_eos = False
            freeze = None
            cut_i = 0
            cuts_ms = list(cuts or [])
            mix_ms = int(mix_ms)
            encoded = 0
            decoded = 0
            t0 = self._now_ms()
            dec_color = 19
            dec_stride = w
            dec_slice = h
            dec_crop_l = 0
            dec_crop_t = 0
            while (not out_eos) and (self._now_ms() - t0) < 90000:
                if not in_eos:
                    try:
                        ix = int(decoder.dequeueInputBuffer(8000))
                    except Exception:
                        ix = -1
                    if ix >= 0:
                        try:
                            ib = decoder.getInputBuffer(ix)
                            n = int(extractor.readSampleData(ib, 0))
                        except Exception:
                            n = -1
                        pts = 0
                        flags = 0
                        try:
                            pts = int(extractor.getSampleTime())
                            flags = int(extractor.getSampleFlags())
                        except Exception:
                            pts = 0
                        if n < 0:
                            decoder.queueInputBuffer(ix, 0, 0, 0, 4)
                            in_eos = True
                        else:
                            decoder.queueInputBuffer(ix, 0, n, pts, flags)
                            extractor.advance()
                try:
                    oix = int(decoder.dequeueOutputBuffer(info, 8000))
                except Exception:
                    oix = -1
                if oix == -2:
                    try:
                        ofmt = decoder.getOutputFormat()
                        dec_color = self._fmt_int(ofmt, "color-format", dec_color)
                        dec_stride = self._fmt_int(ofmt, "stride", w) or w
                        dec_slice = self._fmt_int(ofmt, "slice-height", h) or h
                        dec_crop_l = self._fmt_int(ofmt, "crop-left", 0)
                        dec_crop_t = self._fmt_int(ofmt, "crop-top", 0)
                        cw = self._fmt_int(ofmt, "width", w) or w
                        ch = self._fmt_int(ofmt, "height", h) or h
                        self._log("PYMIX", "dec format", "color=%s stride=%s slice=%s %dx%d" % (
                            dec_color, dec_stride, dec_slice, cw, ch,
                        ))
                    except Exception as e:
                        self._log("PYMIX", "dec format fail", self._err_str(e))
                elif oix >= 0:
                    pts_us = int(info.presentationTimeUs or 0)
                    flags = int(info.flags or 0)
                    eos_f = (flags & 4) != 0
                    size = int(info.size or 0)
                    yuv = None
                    if size > 0 and (flags & 2) == 0:
                        try:
                            ob = decoder.getOutputBuffer(oix)
                            raw = self._bb_to_py(ob)
                            yuv = self._decoder_to_i420(raw, w, h, dec_stride, dec_slice, dec_color, dec_crop_l, dec_crop_t)
                        except Exception as e:
                            self._log("PYMIX", "dec copy fail", self._err_str(e))
                            yuv = None
                    decoder.releaseOutputBuffer(oix, False)
                    decoded += 1
                    if yuv is not None:
                        pts_ms = int(pts_us / 1000)
                        alpha = 0.0
                        while cut_i < len(cuts_ms) and pts_ms > int(cuts_ms[cut_i]) + mix_ms + 40:
                            cut_i += 1
                            freeze = None
                        if cut_i < len(cuts_ms):
                            cut = int(cuts_ms[cut_i])
                            if pts_ms < cut:
                                freeze = yuv
                            elif pts_ms <= cut + mix_ms:
                                if freeze is None:
                                    freeze = yuv
                                frac = (pts_ms - cut) / float(mix_ms if mix_ms else 1)
                                if frac < 0:
                                    frac = 0.0
                                if frac > 1:
                                    frac = 1.0
                                base_ease = int(easing) % 10
                                mode_off = (int(easing) // 10) * 10.0
                                alpha = self._mix_ease(base_ease, frac) + mode_off
                                yuv = self._blend_i420(freeze, yuv, alpha, w, h)
                            else:
                                freeze = None
                                cut_i += 1
                        packed = self._i420_to_encoder(
                            self._pad_i420(yuv, w, h, aw, ah),
                            aw, ah, in_stride, in_slice, enc_color,
                        )
                        eix = -1
                        wt = 0
                        while eix < 0 and wt < 30:
                            try:
                                eix = int(encoder.dequeueInputBuffer(8000))
                            except Exception:
                                eix = -1
                            wt += 1
                        if eix >= 0:
                            try:
                                eb = encoder.getInputBuffer(eix)
                                n = self._bb_put_py(eb, packed)
                                encoder.queueInputBuffer(eix, 0, n, pts_us, 0)
                                encoded += 1
                            except Exception as e:
                                self._log("PYMIX", "enc queue fail", self._err_str(e))
                    if eos_f:
                        try:
                            eix = int(encoder.dequeueInputBuffer(20000))
                            if eix >= 0:
                                encoder.queueInputBuffer(eix, 0, 0, 0, 4)
                        except Exception:
                            pass
                        in_eos = True
                try:
                    eox = int(encoder.dequeueOutputBuffer(info, 4000))
                except Exception:
                    eox = -1
                if eox == -2:
                    try:
                        efmt = encoder.getOutputFormat()
                        video_track = muxer.addTrack(efmt)
                        if a_fmt is not None:
                            try:
                                audio_track = muxer.addTrack(a_fmt)
                            except Exception as e:
                                self._log("AUD", "addTrack", self._err_str(e))
                                audio_track = -1
                        muxer.start()
                        mux_started = True
                        self._log("PYMIX", "mux start", "v=%s a=%s" % (video_track, audio_track))
                    except Exception as e:
                        return "encoder produced no format / mux: %s" % self._err_str(e)
                elif eox >= 0:
                    eos_f = (int(info.flags or 0) & 4) != 0
                    if mux_started and int(info.size or 0) > 0 and video_track >= 0:
                        try:
                            ob = encoder.getOutputBuffer(eox)
                            muxer.writeSampleData(video_track, ob, info)
                        except Exception as e:
                            self._log("PYMIX", "mux write fail", self._err_str(e))
                    encoder.releaseOutputBuffer(eox, False)
                    if eos_f:
                        out_eos = True
            if encoded <= 0:
                return "no frames encoded"
            if not mux_started:
                return "encoder produced no format"
            try:
                self._copy_audio(in_path, muxer, audio_track)
            except Exception as e:
                self._log("AUD", "late copy", self._err_str(e))
            try:
                muxer.stop()
            except Exception as e:
                self._log("PYMIX", "mux stop", self._err_str(e))
            try:
                sz = int(File(out_path).length())
            except Exception:
                sz = 0
            if sz < 64:
                return "output empty"
            self._log("PYMIX", "ok", "decoded=%s encoded=%s out=%s" % (decoded, encoded, sz))
            return None
        except Exception as e:
            return self._err_str(e)
        finally:
            self._release_codec(decoder)
            self._release_codec(encoder)
            try:
                if extractor is not None:
                    extractor.release()
            except Exception:
                pass
            try:
                if muxer is not None:
                    muxer.release()
            except Exception:
                pass

    def _try_py_mix(self, in_path, out_path, mix_ms, easing, cuts):
        attempts = self._mix_attempts()
        if not attempts:
            return "no py attempts"
        last = "py mix failed"
        for att in attempts:
            self._log("PYMIX", "try", att.get("label"))
            t0 = self._now_ms()
            err = self._py_mix_once(in_path, out_path, mix_ms, easing, cuts, att)
            dt = self._now_ms() - t0
            if err is None or (isinstance(err, str) and err.strip() == ""):
                self._log("PYMIX", "success", "%s in %sms" % (att.get("label"), dt))
                return None
            last = "%s: %s" % (att.get("label"), err)
            self._log("PYMIX", "fail", last + " (%sms)" % dt)
            try:
                from java.io import File
                f = File(out_path)
                if f.exists():
                    f.delete()
            except Exception:
                pass
        return last

    def _toast(self, msg):
        def _show():
            try:
                BulletinHelper.show_info(msg)
            except Exception:
                pass
        try:
            run_on_ui_thread(_show)
        except Exception:
            _show()