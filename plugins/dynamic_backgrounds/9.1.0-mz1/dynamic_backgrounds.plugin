                       _mz_t("🌫 Туман", "🌫 Fog", "🌫 Туман"), _mz_t("🌦 Невеликий дощ", "🌦 Light rain", "🌦 Лёгкий дождь"), _mz_t("🌧 Дощ", "🌧 Rain", "🌧 Дождь"),
                       _mz_t("⚡ Гроза", "⚡ Thunderstorm", "⚡ Гроза"), _mz_t("🌨 Невеликий сніг", "🌨 Light snow", "🌨 Лёгкий снег"), _mz_t("❄️ Сніг", "❄️ Snow", "❄️ Снег"),
