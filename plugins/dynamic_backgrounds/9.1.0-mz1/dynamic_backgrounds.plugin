            Input(key="city", text=_mz_t("Місто (резервне)", "City (fallback)", "Город (запасной)"), default="",
                  subtext=_mz_t("Якщо задано, використовується замість GPS/IP. Приклад: Moscow", "If set, used instead of GPS/IP. Example: Moscow", "Если задан — используется вместо GPS/IP. Пример: Moscow"),
