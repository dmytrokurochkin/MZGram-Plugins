            Text(text=_mz_t("Оновити погоду зараз", "Refresh weather now", "Обновить погоду сейчас"), icon="media_repost",
                 on_click=self._force_refresh),
            Input(key="update_interval", text=_mz_t("Інтервал оновлення", "Update interval", "Интервал обновления"), default="30",
                  subtext=_mz_t("хвилин (мінімум 5)", "minutes (minimum 5)", "минут (минимум 5)"), icon="msg_calendar2",
                  on_change=lambda v: self.set_setting("update_interval", str(max(5, int(v or 30))))),
            Divider(),
            Header(text=_mz_t("Пора доби", "Time of day", "Время суток")),
            Input(key="night_start", text=_mz_t("Початок ночі", "Night start", "Начало ночи"), default="20",
                  subtext=_mz_t("години (0–23), типово 20:00", "hour (0–23), default 20:00", "часов (0–23), по умолч. 20:00"), icon="msg_media", on_change=self._apply_cfg),
            Input(key="day_start", text=_mz_t("Початок дня", "Day start", "Начало дня"), default="6",
                  subtext=_mz_t("години (0–23), типово 06:00", "hour (0–23), default 06:00", "часов (0–23), по умолч. 06:00"), icon="msg_media", on_change=self._apply_cfg),
            Divider(),
            Header(text=_mz_t("Елементи ефектів", "Effect elements", "Элементы эффектов")),
            Switch(key="show_sun",       text=_mz_t("☀️ Сонце", "☀️ Sun", "☀️ Солнце"),          default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_moon",      text=_mz_t("🌙 Місяць", "🌙 Moon", "🌙 Луна"),             default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_stars",     text=_mz_t("✨ Зорі", "✨ Stars", "✨ Звёзды"),           default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_sparks",    text=_mz_t("💫 Іскри (ясно)", "💫 Sparks (clear)", "💫 Искры (ясно)"),     default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_clouds",    text=_mz_t("☁️ Хмари", "☁️ Clouds", "☁️ Облака"),           default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_rain",      text=_mz_t("🌧 Дощ / Мокрий сніг", "🌧 Rain / Sleet", "🌧 Дождь / Слякоть"),  default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_snow",      text=_mz_t("❄️ Сніг", "❄️ Snow", "❄️ Снег"),             default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_fog",       text=_mz_t("🌫 Туман", "🌫 Fog", "🌫 Туман"),            default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_lightning", text=_mz_t("⚡ Блискавка", "⚡ Lightning", "⚡ Молния"),           default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_spring",    text=_mz_t("🌸 Весняні частинки", "🌸 Spring particles", "🌸 Весенние частицы"), default=True, icon="msg_media", on_change=self._apply_cfg),
            Switch(key="show_rocket",    text=_mz_t("🚀 Ракета (ясно, ніч)", "🚀 Rocket (clear, night)", "🚀 Ракета (ясно, ночь)"), default=True, icon="msg_media", on_change=self._apply_cfg),

            Divider(),
            Header(text=_mz_t("Тонке налаштування", "Fine tuning", "Тонкая настройка")),
            Text(text=_mz_t("☀️ Ясно", "☀️ Clear", "☀️ Ясно"),                  icon="msg_list", create_sub_fragment=self._sub_clear),
            Text(text=_mz_t("⛅ Мінлива хмарність", "⛅ Partly cloudy", "⛅ Переменная облачность"),  icon="msg_list", create_sub_fragment=self._sub_partly_cloudy),
            Text(text=_mz_t("☁️ Хмарно / Похмуро", "☁️ Cloudy / Overcast", "☁️ Облачно / Пасмурно"),    icon="msg_list", create_sub_fragment=self._sub_cloudy),
