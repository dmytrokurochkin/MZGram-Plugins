__min_version__ = "11.12.0"
__category__ = ["appearance", "integrations"]

# ─── EFFECT TYPES ────────────────────────────────────────────────────────────
#
# clear        → sun (rotating rays) + twinkling sparks
# partly_cloudy→ translucent sun + drifting clouds
# cloudy       → clouds only (drift horizontally)
# fog          → slow translucent patches
# light_rain   → sparse thin drops (drizzle, Patchy rain)
# rain         → regular rain
# thunder      → rain + lightning flashes
# light_snow   → sparse light snowflakes
# snow         → dense snow (SnowflakesEffect.java algorithm)
# sleet        → mix of snowflakes and raindrops
# hail         → fast small hail pellets
#
# particle ptype:
# 0 — snow flake (dot)
# 1 — 6-ray snowflake
# 2 — raindrop (line)
# 3 — fog patch (big dot)
# 4 — cloud (5 overlapping circles)
# 6 — sun spark (twinkling circle)
# 7 — hailstone (white ball with outline)

