class _SafeLogger:
    def __init__(self, plugin):
        self._plugin = plugin

    def _write(self, level: str, msg: str, with_trace: bool = False):
        text = str(msg) + (("\n" + traceback.format_exc()) if with_trace else "")
        real = getattr(self._plugin, "logger", None)
        if real is not None:
            try:
                getattr(real, level)(text)
                return
            except Exception:
                pass
        legacy = getattr(self._plugin, "log", None)
        if callable(legacy):
            try:
                legacy(text)
                return
            except Exception:
                pass
        try:
            print(f"[gift_scheduler] {text}")
        except Exception:
            pass

    def info(self, msg):
        self._write("info", msg)

    def exception(self, msg):
        self._write("error", msg, with_trace=True)


class _SheetHook(MethodHook):
    """After any BottomSheet is shown: if it is the gift sending window, add our own row."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_sheet_shown(param.thisObject)
        except Exception as e:
            self.plugin._last_error = f"sheet hook: {type(e).__name__}: {e}"


class GiftSchedulerPlugin(BasePlugin):
    # ------------------------------------------------------------------ lifecycle

    def on_plugin_load(self):
        self._lg = _SafeLogger(self)
        self._alive = True
        self._lock = threading.RLock()
        self._catalog = None  # (load time, gift list)
        self._last_error = ""
        self._last_tick = 0.0
        self.stats = {"scheduled": 0, "sent": 0, "failed": 0, "missed": 0}
        self._sheet_info = "not installed"
        self._alarm_status = "-"
        self._tl_cache = {}
        self._tl_index = None
        self._tl_scan = "-"
        self._ui_dump = ""
        self._ui_status = "-"
        self._sheets_done = set()

        try:
            self._install_sheet_hook()
        except Exception as e:
            self._sheet_info = f"error: {type(e).__name__}: {e}"
            self._last_error = f"install_sheet_hook: {type(e).__name__}: {e}"

        try:
            self.add_on_send_message_hook()
        except Exception as e:
            self._last_error = f"add_on_send_message_hook: {type(e).__name__}: {e}"

        self._thread = threading.Thread(target=self._loop, name="gift-scheduler", daemon=True)
        self._thread.start()
        self._arm_alarm()
        self._lg.info("Gift Scheduler loaded")

    def on_plugin_unload(self):
        self._alive = False

    def _hook_all(self, cls, name: str, handler):
        if hasattr(self, "hook_all_methods"):
            return self.hook_all_methods(cls, name, handler)
        unhooks = []
        for method in cls.getDeclaredMethods():
            if method.getName() == name:
                method.setAccessible(True)
                unhook = self.hook_method(method, handler)
                if unhook:
                    unhooks.append(unhook)
        return unhooks

    def _install_sheet_hook(self):
        cls = find_class(BOTTOM_SHEET_CLASS)
        if not cls:
            self._sheet_info = "BottomSheet not found"
            return
        unhooks = self._hook_all(cls, "show", _SheetHook(self))
        self._sheet_info = f"BottomSheet.show={len(unhooks or [])}"

    def _loop(self):
        for _ in range(8):  # after an alarm launch the client needs time to start and connect
            if not self._alive:
                return
            time.sleep(1)
        while self._alive:
            try:
                self._tick()
            except Exception as e:
                self._last_error = f"tick: {type(e).__name__}: {e}"
            for _ in range(TICK_SECONDS):
                if not self._alive:
                    return
                time.sleep(1)

    # ------------------------------------------------------------------ task storage

    def _flag(self, key: str, default: bool) -> bool:
        value = self.get_setting(key, default)
        if isinstance(value, str):
            return value.strip().lower() in ("1", "true", "yes", "on")
        return bool(value)

    def _set(self, key: str, value, reload: bool = False):
        try:
            self.set_setting(key, value, reload_settings=reload)
        except TypeError:
            self.set_setting(key, value)

    def _tasks(self) -> list:
        try:
            data = json.loads(str(self.get_setting("tasks", "[]") or "[]"))
            return data if isinstance(data, list) else []
        except Exception:
            return []

    def _save_tasks(self, tasks: list):
        self._set("tasks", json.dumps(tasks, ensure_ascii=False))
        self._arm_alarm(tasks)

    def _update_task(self, task_id: int, **changes):
        with self._lock:
            tasks = self._tasks()
            for task in tasks:
                if task.get("id") == task_id:
                    task.update(changes)
                    break
            self._save_tasks(tasks)

    def _max_late(self) -> float:
        try:
            return max(0.0, float(str(self.get_setting("max_late_min", "360")).strip().replace(",", "."))) * 60
        except Exception:
            return 3600.0

    # ------------------------------------------------------------------ scheduler

    def _tick(self):
        self._last_tick = time.time()
        now = time.time()
        due = []
        with self._lock:
            tasks = self._tasks()
            changed = False
            for task in tasks:
                if task.get("status") != "pending" or task.get("when", 0) > now or task.get("next_try", 0) > now:
                    continue
                if now - task["when"] > self._max_late():
                    task["status"] = "missed"
                    task["error"] = _mz_t("застосунок був закритий у призначений час", "the app was closed at the scheduled time", "приложение было закрыто в назначенное время")
                    self.stats["missed"] += 1
                    changed = True
                    self._toast(_mz_t(f"Подарунок пропущено: {self._short(task)}", f"Gift skipped: {self._short(task)}", f"Подарок пропущен: {self._short(task)}"))
                    continue
                task["status"] = "sending"
                changed = True
                due.append(dict(task))
            if changed:
                self._save_tasks(tasks)
        for task in due:
            run_on_ui_thread(lambda t=task: self._send_task(t))

    @staticmethod
    def _short(task: dict) -> str:
        return _mz_t(f"{task.get('label', 'подарок')} → {task.get('recipient', '?')} ({fmt_when(task.get('when', 0))})", f"{task.get('label', 'подарок')} → {task.get('recipient', '?')} ({fmt_when(task.get('when', 0))})", f"{task.get('label', 'подарок')} → {task.get('recipient', '?')} ({fmt_when(task.get('when', 0))})")

    # ------------------------------------------------------------------ sending

    def _mc(self, account: int):
        from client_utils import get_messages_controller

        try:
            return get_messages_controller(account)
        except TypeError:
            return get_messages_controller()

    def _build_tl_index(self) -> dict:
        """Scans the client classes and remembers where each TL_* lives: short name -> full name.
        Needed because in different Telegram versions the same requests live in different containers."""
        if getattr(self, "_tl_index", None) is not None:
            return self._tl_index
        index = {}
        self._tl_scan = "did not run"
        try:
            from java import jclass

            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            dex = jclass("dalvik.system.DexFile")(str(ctx.getPackageCodePath()))
            entries = dex.entries()
            total = 0
            while entries.hasMoreElements():
                name = str(entries.nextElement())
                total += 1
                if not name.startswith("org.telegram.tgnet."):
                    continue
                simple = name.replace("$", ".").rsplit(".", 1)[-1]
                if simple.startswith("TL_"):
                    # TLRPC has priority: on short-name collisions we keep it
                    if simple not in index or name.startswith("org.telegram.tgnet.TLRPC$"):
                        index[simple] = name
            try:
                dex.close()
            except Exception:
                pass
            self._tl_scan = f"ok: {total} classes, TL_*: {len(index)}"
        except Exception as e:
            self._tl_scan = f"error: {type(e).__name__}: {e}"
        self._tl_index = index
        return index

    def _tl_class(self, class_name: str):
        """The TL class is looked up in TLRPC, in known containers and, if not found, in the client class index."""
        from java import jclass

        if class_name in self._tl_cache:
            return self._tl_cache[class_name][1]
        last = None
        for prefix in TL_CONTAINERS:
            try:
                cls = jclass(prefix + class_name)
                self._tl_cache[class_name] = (prefix, cls)
                return cls
            except Exception as e:
                last = e
        index = self._build_tl_index()
        full = index.get(class_name)
        if full:
            try:
                cls = jclass(full)
                self._tl_cache[class_name] = (full, cls)
                return cls
            except Exception as e:
                last = e
        tail = class_name.replace("TL_payments_", "").replace("TL_", "")
        similar = sorted(n for n in index if tail[:12].lower() in n.lower())[:8]
        raise RuntimeError(
            f"{class_name} not found in the client ({type(last).__name__}); scan: {getattr(self, '_tl_scan', '-')}; "
            f"similar: {', '.join(similar) or 'нет'}"
        )

    def _tl_request(self, class_name: str, fields: dict, handler):
        from client_utils import RequestCallback, send_request

        req = self._tl_class(class_name)()
        for name, value in fields.items():
            setattr(req, name, value)
        return send_request(req, RequestCallback(handler))

    def _fail_task(self, task: dict, reason: str, note: str = "", retry: bool = False):
        if retry and time.time() - task.get("when", 0) < self._max_late():
            # No network or Telegram is still connecting: no payment happened, try again.
            self._update_task(task["id"], status="pending", next_try=time.time() + RETRY_DELAY,
                              error=_mz_t(f"повтор: {reason}", f"retry: {reason}", f"повтор: {reason}"))
            return
        self.stats["failed"] += 1
        self._update_task(task["id"], status="failed", error=reason + note)
        self._toast(_mz_t(f"Подарунок не надіслано ({self._short(task)}): {reason}", f"Gift not sent ({self._short(task)}): {reason}", f"Подарок не отправлен ({self._short(task)}): {reason}"))

    def _hold_awake(self, millis: int = 90000):
        """Keep the CPU from sleeping while sending."""
        try:
            from java import jclass

            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            power = ctx.getSystemService("power")
            lock = power.newWakeLock(1, "giftscheduler:send")  # PARTIAL_WAKE_LOCK
            lock.acquire(int(millis))
        except Exception as e:
            self._last_error = f"wakelock: {type(e).__name__}: {e}"

    def _send_task(self, task: dict):
        """Runs on the UI thread for a task whose time has come."""
        self._hold_awake()
        try:
            account = int(task.get("account", 0))
            target = parse_recipient(task.get("recipient"))
            if target is None:
                self._fail_task(task, _mz_t("некоректний отримувач", "invalid recipient", "некорректный получатель"))
                return
            self._resolve_peer(
                account, target, lambda peer, err: self._send_with_peer(task, account, peer, err)
            )
        except Exception as e:
            self._last_error = f"send_task: {type(e).__name__}: {e}"
            self._lg.exception("send_task")
            self._fail_task(task, f"{type(e).__name__}: {e}")

    def _resolve_peer(self, account: int, target: dict, done):
        """done(input_peer, error_text). InputPeer for the gift recipient."""
        from java import jclass

        if target["kind"] == "self":
            done(self._tl_class("TL_inputPeerSelf")(), None)
            return

        controller = jclass("org.telegram.messenger.MessagesController")
        mc = self._mc(account)

        def finish_with(user):
            if user is None:
                done(None, _mz_t("отримувача не знайдено", "recipient not found", "получатель не найден"))
                return
            try:
                done(controller.getInputPeer(user), None)
            except Exception as e:
                done(None, f"{type(e).__name__}: {e}")

        if target["kind"] == "id":
            user = None
            try:
                from java import jlong

                user = mc.getUser(jlong(target["id"]))
            except Exception:
                try:
                    user = mc.getUser(target["id"])
                except Exception:
                    user = None
            if user is None:
                try:
                    from client_utils import get_messages_storage

                    try:
                        storage = get_messages_storage(account)
                    except TypeError:
                        storage = get_messages_storage()
                    user = storage.getUser(target["id"])
                except Exception:
                    user = None
            if user is None:
                done(None, "PEER_ID_INVALID")
                return
            finish_with(user)
            return

        name = target["username"]
        cached = None
        try:
            cached = mc.getUserOrChat(name)
        except Exception:
            cached = None
        if cached is not None and hasattr(cached, "first_name"):
            finish_with(cached)
            return

        def on_response(response, error):
            def finish():
                try:
                    if error is not None or response is None:
                        text = str(getattr(error, "text", "") or "")
                        done(None, _mz_t("@%s не знайдено", "@%s not found", "@%s не найден") % name if ("NOT_OCCUPIED" in text or "INVALID" in text) else (text or _mz_t("немає відповіді", "no response", "нет ответа")))
                        return
                    users = list(getattr(response, "users", None) or [])
                    try:
                        mc.putUsers(response.users, False)
                        mc.putChats(response.chats, False)
                    except Exception:
                        pass
                    user = next(
                        (u for u in users if str(getattr(u, "username", "") or "").lower() == name.lower()),
                        users[0] if len(users) == 1 else None,
                    )
                    if user is None or not hasattr(user, "first_name"):
                        done(None, _mz_t(f"@{name}: це не користувач", f"@{name}: not a user", f"@{name}: это не пользователь"))
                        return
                    finish_with(user)
                except Exception as e:
                    done(None, f"{type(e).__name__}: {e}")

            run_on_ui_thread(finish)

        self._tl_request("TL_contacts_resolveUsername", {"username": name}, on_response)

    def _build_invoice(self, task: dict, peer):
        from java import jclass

        invoice = self._tl_class("TL_inputInvoiceStarGift")()
        invoice.peer = peer
        invoice.gift_id = int(task["gift_id"])
        flags = 0
        if task.get("hide"):
            invoice.hide_name = True
            flags |= 1
        text = str(task.get("text") or "").strip()
        if text:
            message = self._tl_class("TL_textWithEntities")()
            message.text = text
            message.entities = jclass("java.util.ArrayList")()
            invoice.message = message
            flags |= 2
        invoice.flags = flags
        return invoice

    def _send_with_peer(self, task: dict, account: int, peer, error_text: Optional[str]):
        if peer is None:
            net = (not error_text) or any(k in str(error_text).upper() for k in ("TIMEOUT", "CONNECTION", "NETWORK", "НЕТ ОТВЕТА", "НЕМАЄ ВІДПОВІДІ", "NO RESPONSE"))
            self._fail_task(task, friendly_error(error_text or _mz_t("отримувача не знайдено", "recipient not found", "получатель не найден")), retry=net)
            return
        try:
            invoice = self._build_invoice(task, peer)
        except Exception as e:
            self._last_error = f"build invoice: {type(e).__name__}: {e}"
            self._fail_task(task, _mz_t(f"не вдалося скласти запит ({type(e).__name__})", f"could not build the request ({type(e).__name__})", f"не удалось собрать запрос ({type(e).__name__})"))
            return

        def on_form(response, error):
            def after_form():
                try:
                    if error is not None or response is None:
                        self._fail_task(
                            task, friendly_error(str(getattr(error, "text", "") or _mz_t("немає відповіді", "no response", "нет ответа"))),
                            retry=is_retryable(error) if error is not None else True,
                        )
                        return
                    form_id = getattr(response, "form_id", None)
                    if form_id is None:
                        self._fail_task(task, _mz_t("Telegram не повернув форму оплати", "Telegram did not return a payment form", "Telegram не вернул форму оплаты"))
                        return
                    self._tl_request(
                        "TL_payments_sendStarsForm", {"form_id": form_id, "invoice": invoice}, on_paid
                    )
                except Exception as e:
                    self._last_error = f"after_form: {type(e).__name__}: {e}"
                    self._fail_task(task, f"{type(e).__name__}: {e}")

            run_on_ui_thread(after_form)

        def on_paid(response, error):
            def after_paid():
                try:
                    if error is not None:
                        # The money may have been charged if the reply was lost: do not retry.
                        reason = friendly_error(str(getattr(error, "text", "") or ""))
                        self._fail_task(task, reason, _mz_t(" (перевірте, чи не пішов подарунок)", " (check whether the gift was sent)", " (проверьте, не ушёл ли подарок)") if not getattr(error, "text", "") else "")
                        return
                    self.stats["sent"] += 1
                    self._update_task(task["id"], status="sent", error="", sent_at=time.time())
                    self._toast(_mz_t(f"🎁 Подарунок надіслано: {self._short(task)}", f"🎁 Gift sent: {self._short(task)}", f"🎁 Подарок отправлен: {self._short(task)}"))
                except Exception as e:
                    self._last_error = f"after_paid: {type(e).__name__}: {e}"

            run_on_ui_thread(after_paid)

        self._tl_request("TL_payments_getPaymentForm", {"invoice": invoice}, on_form)

    # ------------------------------------------------------------------ alarm

    def _arm_alarm(self, tasks: Optional[list] = None):
        """System alarm for the nearest task. It starts the Telegram service and so brings up the
        app (and this plugin), even if it was unloaded from memory or the phone fell asleep."""
        try:
            from java import jclass, jlong

            if tasks is None:
                tasks = self._tasks()
            moments = [
                max(float(t.get("when", 0)), float(t.get("next_try", 0)))
                for t in tasks if t.get("status") == "pending"
            ]
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            manager = ctx.getSystemService("alarm")
            service_cls = find_class("org.telegram.messenger.NotificationsService")
            if service_cls is None:
                self._alarm_status = "NotificationsService not found"
                return
            intent = jclass("android.content.Intent")(ctx, service_cls)
            intent.setAction("gift_scheduler.WAKE")
            pending = jclass("android.app.PendingIntent").getService(
                ctx, ALARM_REQUEST_CODE, intent, 134217728 | 67108864  # UPDATE_CURRENT | IMMUTABLE
            )
            if not moments:
                manager.cancel(pending)
                self._alarm_status = "no pending tasks"
                return
            trigger = max(int(min(moments) * 1000), int(time.time() * 1000) + 1500)
            try:
                exact = bool(manager.canScheduleExactAlarms())
            except Exception:
                exact = True
            try:
                if exact:
                    manager.setExactAndAllowWhileIdle(0, jlong(trigger), pending)
                    self._alarm_status = f"exact at {fmt_when(trigger / 1000)}"
                    return
            except Exception as e:
                self._last_error = f"exact alarm: {type(e).__name__}: {e}"
            manager.setAndAllowWhileIdle(0, jlong(trigger), pending)
            self._alarm_status = f"inexact at {fmt_when(trigger / 1000)} (no permission for exact)"
        except Exception as e:
            self._alarm_status = f"error: {type(e).__name__}: {e}"
            self._last_error = f"arm_alarm: {type(e).__name__}: {e}"

    def _open_system_settings(self, action: str, with_package: bool = False):
        try:
            from java import jclass

            activity = self._activity()
            intent = jclass("android.content.Intent")(action)
            if with_package:
                intent.setData(jclass("android.net.Uri").parse("package:" + str(activity.getPackageName())))
            activity.startActivity(intent)
        except Exception as e:
            self._last_error = f"open settings: {type(e).__name__}: {e}"
            self._toast(_mz_t(f"Не вдалося відкрити налаштування: {type(e).__name__}", f"Couldn't open settings: {type(e).__name__}", f"Не удалось открыть настройки: {type(e).__name__}"))

    # ------------------------------------------------------------------ gift catalog

    def _fetch_catalog(self, account: int, done):
        """done(gift list | None, error). Called exactly once."""
        if self._catalog and time.time() - self._catalog[0] < CATALOG_TTL:
            done(self._catalog[1], None)
            return

        state = {"finished": False}

        def finish(gifts, error):
            if state["finished"]:
                return
            state["finished"] = True
            done(gifts, error)

        def on_response(response, error):
            def handle():
                try:
                    if error is not None or response is None:
                        finish(None, friendly_error(str(getattr(error, "text", "") or _mz_t("немає відповіді", "no response", "нет ответа"))))
                        return
                    gifts = []
                    for gift in list(getattr(response, "gifts", None) or []):
                        if getattr(gift, "sold_out", False):
                            continue
                        gifts.append(self._gift_info(gift))
                    gifts = [g for g in gifts if g]
                    if not gifts:
                        finish(None, _mz_t(f"каталог порожній ({_cls_name(response).rsplit('.', 1)[-1]})", f"the catalog is empty ({_cls_name(response).rsplit('.', 1)[-1]})", f"каталог пуст ({_cls_name(response).rsplit('.', 1)[-1]})"))
                        return
                    gifts.sort(key=lambda g: (g["stars"], g["id"]))
                    self._catalog = (time.time(), gifts)
                    finish(gifts, None)
                except Exception as e:
                    self._last_error = f"catalog: {type(e).__name__}: {e}"
                    finish(None, f"{type(e).__name__}: {e}")

            run_on_ui_thread(handle)

        try:
            self._tl_request("TL_payments_getStarGifts", {"hash": 0}, on_response)
        except Exception as e:
            self._last_error = f"catalog request: {type(e).__name__}: {e}"
            finish(None, f"{type(e).__name__}: {e}")
            return
        self._post_delayed(lambda: finish(None, _mz_t("Telegram не відповів за 20 секунд", "Telegram did not respond in 20 seconds", "Telegram не ответил за 20 секунд")), 20000)

    def _pick_gift(self):
        try:
            account = self._account()
            self._toast(_mz_t("Завантажую каталог подарунків…", "Loading the gift catalog…", "Загружаю каталог подарков…"))

            def got(gifts, error):
                if gifts is None:
                    self._toast(_mz_t(f"Не вдалося завантажити каталог: {error}", f"Couldn't load the catalog: {error}", f"Не удалось загрузить каталог: {error}"))
                    return

                def pick(i):
                    gift = gifts[i]
                    self._set("new_gift_id", str(gift["id"]))
                    self._set("new_gift_label", gift["label"])
                    self._set("new_gift_stars", str(gift["stars"]), reload=True)
                    self._toast(_mz_t(f"Вибрано подарунок: {gift['label']} ({gift['stars']} ⭐)", f"Gift selected: {gift['label']} ({gift['stars']} ⭐)", f"Выбран подарок: {gift['label']} ({gift['stars']} ⭐)"))

                self._choose(_mz_t("Виберіть подарунок", "Choose a gift", "Выберите подарок"), [g["menu"] for g in gifts], pick)

            self._fetch_catalog(account, got)
        except Exception as e:
            self._last_error = f"pick_gift: {type(e).__name__}: {e}"
            self._toast(_mz_t(f"Не вдалося відкрити каталог: {type(e).__name__}: {e}", f"Couldn't open the catalog: {type(e).__name__}: {e}", f"Не удалось открыть каталог: {type(e).__name__}: {e}"))

    @staticmethod
    def _gift_info(gift) -> Optional[dict]:
        try:
            gift_id = int(gift.id)
            stars = int(getattr(gift, "stars", 0) or 0)
        except Exception:
            return None
        emoji = ""
        try:
            for attr in list(getattr(getattr(gift, "sticker", None), "attributes", None) or []):
                alt = getattr(attr, "alt", None)
                if alt:
                    emoji = str(alt)
                    break
        except Exception:
            pass
        title = str(getattr(gift, "title", "") or "")
        limited = bool(getattr(gift, "limited", False))
        left = getattr(gift, "availability_remains", None)
        label = f"{emoji} {title}".strip() or _mz_t(f"Подарунок {gift_id}", f"Gift {gift_id}", f"Подарок {gift_id}")
        extra = _mz_t(f", залишилось {int(left)}", f", {int(left)} left", f", осталось {int(left)}") if limited and left is not None else (_mz_t(", ліміт", ", limited", ", лимит") if limited else "")
        return {"id": gift_id, "stars": stars, "label": label, "menu": f"{stars} ⭐   {label}{extra}"}

    def _pick_gift(self):
        account = self._account()
        self._toast(_mz_t("Завантажую каталог подарунків…", "Loading the gift catalog…", "Загружаю каталог подарков…"))

        def got(gifts, error):
            if gifts is None:
                self._toast(_mz_t(f"Не вдалося завантажити каталог: {error}", f"Couldn't load the catalog: {error}", f"Не удалось загрузить каталог: {error}"))
                return

            def pick(i):
                gift = gifts[i]
                self._set("new_gift_id", str(gift["id"]))
                self._set("new_gift_label", gift["label"])
                self._set("new_gift_stars", str(gift["stars"]), reload=True)
                self._toast(_mz_t(f"Вибрано подарунок: {gift['label']} ({gift['stars']} ⭐)", f"Gift selected: {gift['label']} ({gift['stars']} ⭐)", f"Выбран подарок: {gift['label']} ({gift['stars']} ⭐)"))

            self._choose(_mz_t("Виберіть подарунок", "Choose a gift", "Выберите подарок"), [g["menu"] for g in gifts], pick)

        self._fetch_catalog(account, got)

    # ------------------------------------------------------------------ task creation

    @staticmethod
    def _account() -> int:
        try:
            from java import jclass

            return int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
        except Exception:
            return 0

    def _schedule_from_settings(self):
        gift_id = str(self.get_setting("new_gift_id", "") or "").strip()
        if not gift_id.isdigit():
            self._toast(_mz_t("Спершу виберіть подарунок", "Choose a gift first", "Сначала выберите подарок"))
            return
        recipient_raw = str(self.get_setting("new_recipient", "") or "").strip()
        target = parse_recipient(recipient_raw)
        if target is None:
            self._toast(_mz_t("Вкажіть отримувача: @username, ID або «я»", "Enter a recipient: @username, ID or \"me\"", "Укажите получателя: @username, ID или «я»"))
            return
        when = parse_when(self.get_setting("new_time", ""))
        if when is None:
            self._toast(_mz_t("Не зрозумів час. Приклад: 25.12 18:00, завтра 10:30, через 90 хв", "Couldn't understand the time. Example: 25.12 18:00, tomorrow 10:30, in 90 min", "Не понял время. Пример: 25.12 18:00, завтра 10:30, через 90 мин"))
            return
        if when <= datetime.now() + timedelta(seconds=30):
            self._toast(_mz_t("Час уже минув або надто близько", "The time has passed or is too close", "Время уже прошло или слишком близко"))
            return

        text = str(self.get_setting("new_message", "") or "").strip()
        if len(text) > 255:
            self._toast(_mz_t("Підпис задовгий (до 255 символів)", "The caption is too long (up to 255 characters)", "Подпись слишком длинная (до 255 символов)"))
            return

        label = str(self.get_setting("new_gift_label", "") or "") or _mz_t(f"Подарунок {gift_id}", f"Gift {gift_id}", f"Подарок {gift_id}")
        stars = str(self.get_setting("new_gift_stars", "") or "?")
        task = {
            "id": int(time.time() * 1000),
            "when": when.timestamp(),
            "recipient": recipient_raw if target["kind"] != "self" else _mz_t("я", "me", "я"),
            "gift_id": int(gift_id),
            "label": label,
            "stars": stars,
            "text": text,
            "hide": self._flag("new_hide", False),
            "account": self._account(),
            "status": "pending",
            "error": "",
        }
        summary = (
            _mz_t(f"{label} ({stars} ⭐)\nОтримувач: {task['recipient']}\nКоли: {fmt_when(task['when'])}", f"{label} ({stars} ⭐)\nRecipient: {task['recipient']}\nWhen: {fmt_when(task['when'])}", f"{label} ({stars} ⭐)\nПолучатель: {task['recipient']}\nКогда: {fmt_when(task['when'])}")
            + (_mz_t(f"\nПідпис: {text}", f"\nCaption: {text}", f"\nПодпись: {text}") if text else "")
            + (_mz_t("\nІм'я приховано", "\nName hidden", "\nИмя скрыто") if task["hide"] else "")
            + _mz_t("\n\nЗірки спишуться в момент надсилання. Telegram має бути запущений.", "\n\nStars are charged at the moment of sending. Telegram must be running.", "\n\nЗвёзды спишутся в момент отправки. Telegram должен быть запущен.")
        )

        def commit():
            with self._lock:
                tasks = self._tasks()
                tasks.append(task)
                self._save_tasks(tasks)
            self.stats["scheduled"] += 1
            self._set("new_time", "")
            self._set("new_message", "", reload=True)
            self._toast(_mz_t(f"Заплановано на {fmt_when(task['when'])}", f"Scheduled for {fmt_when(task['when'])}", f"Запланировано на {fmt_when(task['when'])}"))

        self._confirm(_mz_t("Запланувати подарунок?", "Schedule the gift?", "Запланировать подарок?"), summary, _mz_t("Запланувати", "Schedule", "Запланировать"), commit)

    # ------------------------------------------------------------------ task list

    def _show_list(self, recipient: Optional[str] = None):
        tasks = sorted(self._tasks(), key=lambda t: t.get("when", 0))
        if recipient is not None:
            tasks = [t for t in tasks if str(t.get("recipient")) == str(recipient)]
        if not tasks:
            self._toast(_mz_t("Запланованих подарунків немає", "No scheduled gifts", "Запланированных подарков нет"))
            return
        labels = [
            f"{STATUS_ICONS.get(t.get('status'), '•')} {fmt_when(t.get('when', 0))} · {t.get('recipient', '?')} · "
            f"{t.get('label', '')}" for t in tasks
        ]

        def pick(i):
            task = tasks[i]
            status = task.get("status")
            detail = _mz_t(f"{self._short(task)}\nСтатус: {status}", f"{self._short(task)}\nStatus: {status}", f"{self._short(task)}\nСтатус: {status}") + (f"\n{task['error']}" if task.get("error") else "")
            if status == "sending":
                self._toast(_mz_t("Подарунок уже надсилається, скасувати не можна", "The gift is already being sent, it can't be cancelled", "Подарок уже отправляется, отменить нельзя"))
            elif status == "pending":
                self._confirm(_mz_t("Скасувати надсилання?", "Cancel sending?", "Отменить отправку?"), detail, _mz_t("Скасувати", "Cancel", "Отменить"), lambda: self._cancel_task(task["id"]))
            else:
                self._confirm(_mz_t("Прибрати зі списку?", "Remove from the list?", "Убрать из списка?"), detail, _mz_t("Прибрати", "Remove", "Убрать"), lambda: self._remove_task(task["id"]))

        self._choose(_mz_t("Подарунки за розкладом", "Scheduled gifts", "Подарки по расписанию"), labels, pick)

    def _cancel_task(self, task_id: int):
        """Cancelling a pending task: only if it has not started sending yet."""
        with self._lock:
            tasks = self._tasks()
            task = next((t for t in tasks if t.get("id") == task_id), None)
            if task is None:
                self._toast(_mz_t("Завдання вже видалено", "The task has already been removed", "Задача уже удалена"))
                return
            if task.get("status") != "pending":
                self._toast(_mz_t("Подарунок уже надсилається чи надіслано, скасувати не можна", "The gift is already being sent or was sent, it can't be cancelled", "Подарок уже отправляется или отправлен, отменить нельзя"))
                return
            self._save_tasks([t for t in tasks if t.get("id") != task_id])
        self._toast(_mz_t("Надсилання скасовано, зірки не списано", "Sending cancelled, no Stars charged", "Отправка отменена, звёзды не списаны"))

    def _cancel_all_pending(self):
        with self._lock:
            tasks = self._tasks()
            keep = [t for t in tasks if t.get("status") != "pending"]
            count = len(tasks) - len(keep)
            self._save_tasks(keep)
        self._toast(_mz_t(f"Скасовано надсилань: {count}", f"Sendings cancelled: {count}", f"Отменено отправок: {count}") if count else _mz_t("Очікуваних надсилань немає", "No pending sendings", "Ожидающих отправок нет"))

    def _pending_for(self, recipient: Optional[str]) -> int:
        return sum(
            1 for t in self._tasks()
            if t.get("status") == "pending" and (recipient is None or str(t.get("recipient")) == str(recipient))
        )

    def _remove_task(self, task_id: int):
        with self._lock:
            tasks = [t for t in self._tasks() if t.get("id") != task_id]
            self._save_tasks(tasks)
        self._toast(_mz_t("Готово", "Done", "Готово"))

    # ------------------------------------------------------------------ settings

