                key="sheet_ui",
                text=_mz_t("«Відкласти» у вікні надсилання", "\"Postpone\" in the sending window", "«Отложить» в окне отправки"),
                default=True,
                subtext=_mz_t("Додає рядок «Відкласти надсилання» під «Приховати моє ім'я» у вікні подарунка", "Adds a \"Postpone sending\" row under \"Hide My Name\" in the gift window", "Добавляет строку «Отложить отправку» под «Скрыть моё имя» в окне подарка"),
                icon="msg_info",
            ),
            Header(text=_mz_t("Розклад", "Schedule", "Расписание")),
            Text(
                text=_mz_t("Заплановані", "Scheduled", "Запланированные"),
                subtext=_mz_t(f"Очікують надсилання: {pending}. Натисніть, щоб переглянути або скасувати", f"Waiting to be sent: {pending}. Tap to view or cancel", f"Ожидают отправки: {pending}. Нажмите, чтобы посмотреть или отменить"),
                on_click=lambda view: self._show_list(),
            ),
            Text(
                text=_mz_t("Скасувати всі очікувані", "Cancel all pending", "Отменить все ожидающие"),
                subtext=_mz_t("Зірки не списуються, доки подарунок не надіслано", "Stars are not charged until the gift is sent", "Звёзды не списываются, пока подарок не отправлен"),
                red=True,
                on_click=lambda view: self._confirm(
                    _mz_t("Скасувати всі надсилання?", "Cancel all sendings?", "Отменить все отправки?"),
                    _mz_t(f"Буде скасовано подарунків: {self._pending_for(None)}", f"Gifts to be cancelled: {self._pending_for(None)}", f"Будет отменено подарков: {self._pending_for(None)}"),
                    _mz_t("Скасувати всі", "Cancel all", "Отменить все"),
                    self._cancel_all_pending,
                ),
            ),
            Input(
                key="max_late_min",
                text=_mz_t("Допустиме запізнення, хв", "Allowed delay, min", "Допустимое опоздание, мин"),
                default="360",
                subtext=_mz_t("Якщо Telegram був закритий і подарунок прострочено більше ніж на цей час, він не піде, а позначиться як пропущений", "If Telegram was closed and the gift is overdue by more than this time, it will not be sent and will be marked as missed", ("Если Telegram был закрыт и подарок просрочен больше, чем на это время, "
                        "он не уйдёт, а пометится как пропущенный")),
            ),
            Header(text=_mz_t("Робота у фоні", "Background work", "Работа в фоне")),
            Text(
                text=_mz_t("Дозволити роботу без обмежень", "Allow unrestricted background work", "Разрешить работу без ограничений"),
                subtext=_mz_t("Вимкніть для Telegram економію заряду, інакше система може присипити його до строку", "Turn off battery saving for Telegram, otherwise the system may put it to sleep before the deadline", "Отключите для Telegram экономию заряда, иначе система может усыпить его до срока"),
                on_click=lambda view: self._open_system_settings("android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS"),
            ),
            Text(
