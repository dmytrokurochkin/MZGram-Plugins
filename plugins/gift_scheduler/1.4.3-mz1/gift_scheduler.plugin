"""Plugin for MZGram: scheduled sending of Telegram gifts.

You pick a gift from the catalog, a recipient (@username, ID or "me"), a date and time, and the plugin
sends the gift at the chosen moment (Stars are charged at the moment of sending).

Important: the plugin works inside the app. If Telegram is closed or killed by the system at the
right time, the gift is sent on the next launch, but only if the delay is no longer than the limit
from the settings (60 minutes by default), otherwise the task is marked as missed.
"""
# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en


