# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from java.lang import Float, Boolean
from ui.settings import Header, Divider, Text, Input, Switch
from ui.bulletin import BulletinHelper
from android_utils import run_on_ui_thread

__name__ = "Square Liquid Glass"
__description__ = "Reduces the corner radius of blurred backgrounds by half."
__version__ = "1.0.0-mz1"
__author__ = "@immat0x1 little bit edited with square settings by @la_cringe"
__id__ = "square_liquid_glass"
__category__ = ["appearance"]


class SmallerBlurRadii(BasePlugin):
    class ReduceRadiusHook(MethodHook):
        def __init__(self, plugin) -> None:
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                args_count = len(param.args)
                mode = self.plugin.get_setting("radius_mode", "multiplier")

                if mode == "multiplier":
                    multiplier = float(self.plugin.get_setting("radius_multiplier", "0.5"))
                    if args_count == 1:
                        param.args[0] = Float(param.args[0] * multiplier)
                    elif args_count >= 4:
                        for i in range(4):
                            param.args[i] = Float(param.args[i] * multiplier)
                
                elif mode == "fixed":
                    fixed_value = float(self.plugin.get_setting("fixed_radius", "0.0"))
                    if args_count == 1:
                        param.args[0] = Float(fixed_value)
                    elif args_count >= 4:
                        for i in range(4):
                            param.args[i] = Float(fixed_value)
                
                elif mode == "individual":
                    if args_count == 1:
                        radius = float(self.plugin.get_setting("radius_all", "0.0"))
                        param.args[0] = Float(radius)
                    elif args_count >= 4:
                        radii = [
                            float(self.plugin.get_setting("radius_top_left", "0.0")),
                            float(self.plugin.get_setting("radius_top_right", "0.0")),
                            float(self.plugin.get_setting("radius_bottom_right", "0.0")),
                            float(self.plugin.get_setting("radius_bottom_left", "0.0"))
                        ]
                        for i in range(4):
                            param.args[i] = Float(radii[i])

            except Exception as e:
                self.plugin.log(f"{e}\n{traceback.format_exc()}")

    def on_plugin_load(self):
        try:
            drawable_cls = find_class("org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable").getClass()

            if not drawable_cls:
                self.log("BlurredBackgroundDrawable class not found.")
                return

            hook = self.ReduceRadiusHook(self)

            method_single = drawable_cls.getDeclaredMethod(
                "setRadius",
                Float.TYPE
            )
            self.hook_method(method_single, hook)

            method_quad = drawable_cls.getDeclaredMethod(
                "setRadius",
                Float.TYPE, Float.TYPE, Float.TYPE, Float.TYPE
            )
            self.hook_method(method_quad, hook)

            method_penta = drawable_cls.getDeclaredMethod(
                "setRadius",
                Float.TYPE, Float.TYPE, Float.TYPE, Float.TYPE, Boolean.TYPE
            )
            self.hook_method(method_penta, hook)

            self.log("Plugin loaded successfully")

        except Exception as e:
            self.log(f"Failed to activate radius hook: {e}\n{traceback.format_exc()}")

    def create_settings(self):
        settings = [
            Header(text=_mz_t("Основні налаштування", "Main settings", "Основные настройки")),
            Text(
                text=_mz_t("Режим налаштування", "Setup mode", "Режим настройки"),
                icon="msg_edit",
                on_click=lambda view: self._show_mode_selector()
            ),
            Divider()
        ]

        mode = self.get_setting("radius_mode", "multiplier")

        if mode == "multiplier":
            settings.extend([
                Header(text=_mz_t("Налаштування множника", "Multiplier settings", "Настройки множителя")),
                Input(
                    key="radius_multiplier",
                    text=_mz_t("Множник радіуса", "Radius multiplier", "Множитель радиуса"),
                    subtext=_mz_t("0.0 = квадрат, 0.5 = половина, 1.0 = оригінал, 2.0 = подвійний", "0.0 = square, 0.5 = half, 1.0 = original, 2.0 = double", "0.0 = квадрат, 0.5 = половина, 1.0 = оригинал, 2.0 = двойной"),
                    default="0.5",
                    icon="msg_speed",
                    on_change=lambda value: self._on_setting_change("radius_multiplier", value)
                )
            ])

        elif mode == "fixed":
            settings.extend([
                Header(text=_mz_t("Фіксоване значення", "Fixed value", "Фиксированное значение")),
                Input(
                    key="fixed_radius",
                    text=_mz_t("Радіус у пікселях", "Radius in pixels", "Радиус в пикселях"),
                    subtext=_mz_t("Установіть точне значення радіуса (0-100 пікселів)", "Set the exact radius value (0-100 pixels)", "Установите точное значение радиуса (0-100 пикселей)"),
                    default="0.0",
                    icon="msg_radius",
                    on_change=lambda value: self._on_setting_change("fixed_radius", value)
                )
            ])

        elif mode == "individual":
            settings.extend([
                Header(text=_mz_t("Індивідуальні кути", "Individual corners", "Индивидуальные углы")),
                Input(
                    key="radius_all",
                    text=_mz_t("Усі кути (для одиночного методу)", "All corners (for the single method)", "Все углы (для одиночного метода)"),
                    subtext=_mz_t("Радіус для всіх кутів, коли використовується єдине значення", "Radius for all corners when a single value is used", "Радиус для всех углов когда используется единое значение"),
                    default="0.0",
                    icon="msg_radius",
                    on_change=lambda value: self._on_setting_change("radius_all", value)
                ),
                Input(
                    key="radius_top_left",
                    text=_mz_t("Верхній лівий кут", "Top left corner", "Верхний левый угол"),
                    default="0.0",
                    icon="msg_corner_top_left",
                    on_change=lambda value: self._on_setting_change("radius_top_left", value)
                ),
                Input(
                    key="radius_top_right",
                    text=_mz_t("Верхній правий кут", "Top right corner", "Верхний правый угол"),
                    default="0.0",
                    icon="msg_corner_top_right",
                    on_change=lambda value: self._on_setting_change("radius_top_right", value)
                ),
                Input(
                    key="radius_bottom_right",
                    text=_mz_t("Нижній правий кут", "Bottom right corner", "Нижний правый угол"),
                    default="0.0",
                    icon="msg_corner_bottom_right",
                    on_change=lambda value: self._on_setting_change("radius_bottom_right", value)
                ),
                Input(
                    key="radius_bottom_left",
                    text=_mz_t("Нижній лівий кут", "Bottom left corner", "Нижний левый угол"),
                    default="0.0",
                    icon="msg_corner_bottom_left",
                    on_change=lambda value: self._on_setting_change("radius_bottom_left", value)
                )
            ])

        return settings

    def _show_mode_selector(self):
        from ui.alert import AlertDialogBuilder
        from client_utils import get_last_fragment

        fragment = get_last_fragment()
        if not fragment or not fragment.getParentActivity():
            return

        context = fragment.getParentActivity()
        builder = AlertDialogBuilder(context)
        
        modes = [_mz_t("Множник", "Multiplier", "Множитель"), _mz_t("Фіксоване значення", "Fixed value", "Фиксированное значение"), _mz_t("Індивідуальні кути", "Individual corners", "Индивидуальные углы")]
        mode_values = ["multiplier", "fixed", "individual"]
        current_mode = self.get_setting("radius_mode", "multiplier")

        builder.set_title(_mz_t("Оберіть режим налаштування", "Choose a setup mode", "Выберите режим настройки"))
        builder.set_items(
            modes,
            lambda dialog, which: self._on_mode_selected(mode_values[which])
        )
        
        run_on_ui_thread(builder.show)

    def _on_mode_selected(self, mode):
        self.set_setting("radius_mode", mode, reload_settings=True)
        mode_names = {
            "multiplier": _mz_t("Множник", "Multiplier", "Множитель"),
            "fixed": _mz_t("Фіксоване значення", "Fixed value", "Фиксированное значение"),
            "individual": _mz_t("Індивідуальні кути", "Individual corners", "Индивидуальные углы")
        }
        run_on_ui_thread(lambda: BulletinHelper.show_success(_mz_t(f"Режим змінено на: {mode_names.get(mode, mode)}", f"Mode changed to: {mode_names.get(mode, mode)}", f"Режим изменён на: {mode_names.get(mode, mode)}")))

    def _on_setting_change(self, key, value):
        try:
            float(value)
            self.set_setting(key, value, reload_settings=False)
            self.log(f"Setting '{key}' changed to: {value}")
        except ValueError:
            run_on_ui_thread(lambda: BulletinHelper.show_error(_mz_t("Введіть коректне числове значення", "Enter a valid number", "Введите корректное числовое значение")))