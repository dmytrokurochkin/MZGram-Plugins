# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "record_blocker"
__name__ = "Record Blocker"
__description__ = "Full ban on manual recording of voice messages and round videos: the record button simply doesn't work. The plugin protects against accidentally recording or sending a voice message or round video with a mistaken tap on the button."
__author__ = "@huecoder"
__version__ = "1.1.3-mz1"
__icon__ = "rbicon_by_W1fmaSnc23f0akxcmbot/0"
__min_version__ = "12.5.1"
__category__ = ["media"]

import traceback

from android_utils import log
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from ui.settings import Header, Switch


class BlockRecordHook(MethodHook):
    def __init__(self, plugin, setting_key, message):
        self.plugin = plugin
        self.setting_key = setting_key
        self.message = message

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("enabled", True):
                return
            if not self.plugin.get_setting(self.setting_key, True):
                return
            param.setResult(None)
            if self.plugin.get_setting("show_bulletin", True):
                BulletinHelper.show_info(self.message)
        except Exception:
            log("record_blocker hook error:\n" + traceback.format_exc())


class RecordBlockerPlugin(BasePlugin):
    def on_plugin_load(self):
        self._unhooks = []

        mc = find_class("org.telegram.messenger.MediaController")
        if mc:
            hooks = self.hook_all_methods(
                mc, "startRecording",
                BlockRecordHook(self, "block_voice", _mz_t("Запис голосових заблоковано", "Voice recording blocked", "Запись голосовых заблокирована")),
            ) or []
            self._unhooks += hooks
            self.log(f"record_blocker: voice hooks = {len(hooks)}")
        else:
            self.log("record_blocker: MediaController not found!")

        icv = find_class("org.telegram.ui.Components.InstantCameraView")
        if icv:
            hooks = self.hook_all_methods(
                icv, "showCamera",
                BlockRecordHook(self, "block_round", _mz_t("Запис кружків заблоковано", "Round video recording blocked", "Запись кружков заблокирована")),
            ) or []
            self._unhooks += hooks
            self.log(f"record_blocker: round hooks = {len(hooks)}")
        else:
            self.log("record_blocker: InstantCameraView not found!")

    def create_settings(self):
        return [
            Header(text="Record Blocker"),
            Switch(key="enabled", text=_mz_t("Блокування увімкнено", "Blocking enabled", "Блокировка включена"), default=True),
            Switch(key="block_voice", text=_mz_t("Блокувати голосові", "Block voice messages", "Блокировать голосовые"), default=True),
            Switch(key="block_round", text=_mz_t("Блокувати кружки", "Block round videos", "Блокировать кружки"), default=True),
            Switch(key="show_bulletin", text=_mz_t("Сповіщення про блокування", "Notify when blocked", "Уведомление при блокировке"), default=True),
        ]

    def on_plugin_unload(self):
        for uh in getattr(self, "_unhooks", []):
            try:
                self.unhook_method(uh)
            except Exception:
                pass
        self._unhooks = []
