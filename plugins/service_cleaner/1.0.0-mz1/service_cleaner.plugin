# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

from typing import Any, Dict, List, Optional

from java.lang import Integer
from org.telegram.tgnet import TLRPC

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from client_utils import (
    get_last_fragment,
    get_messages_controller,
    run_on_queue,
    send_request,
)
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Selector, Switch, Text

# --- Metadata (required top-level constants, parsed via AST) ---

__id__ = "service_cleaner"
__name__ = "Service Cleaner"
__description__ = "Bulk deletion of service messages: \"joined the chat\", \"added a poll option\" and others.\n\nChat menu (⋮) → **Delete service…**, or long press on a service message → **Delete all like this**."
__author__ = "Author: @PLOXOI_RRO"
__version__ = "1.0.0-mz1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__category__ = ["chats"]
__sdk_version__ = ">=1.4.4.3"

# --- Logic constants ---

PAGE_SIZE = 100          # how many messages to request at a time
DELETE_BATCH = 100       # how many ids to send in one delete request
SCAN_DEPTHS = [100, 300, 600, 1200]

CATEGORY_JOIN = "join"
CATEGORY_POLL = "poll"
CATEGORY_OTHER = "other"

# Action classes counted as "members joining/leaving".
JOIN_ACTION_NAMES = [
    "TL_messageActionChatAddUser",
    "TL_messageActionChatDeleteUser",
    "TL_messageActionChatJoinedByLink",
    "TL_messageActionChatJoinedByRequest",
    "TL_messageActionChatJoinedByInvite",
    "TL_messageActionPeerJoined",
]

# Action classes counted as "poll options".
POLL_ACTION_NAMES = [
    "TL_messageActionPollVote",
]

# Service messages the server doesn't allow to delete,
# so they are not counted and not added to the deletion list.
UNDELETABLE_ACTION_NAMES = [
    "TL_messageActionChannelCreate",  # "channel created"
    "TL_messageActionChatCreate",     # "group created"
]


def _existing_classes(names):
    """Collect the TLRPC Java classes that exist in the current build."""
    result = []
    for name in names:
        cls = getattr(TLRPC, name, None)
        if cls is not None:
            result.append(cls)
    return result


JOIN_CLASSES = _existing_classes(JOIN_ACTION_NAMES)
POLL_CLASSES = _existing_classes(POLL_ACTION_NAMES)
UNDELETABLE_CLASSES = _existing_classes(UNDELETABLE_ACTION_NAMES)


class ServiceCleanerPlugin(BasePlugin):
    """Finds and bulk-deletes service messages in the current chat."""

    # ------------------------------------------------------------------
    # Initialization
    # ------------------------------------------------------------------

    def on_plugin_load(self):
        self._scan_dialog = None
        self._delete_dialog = None
        self._delete_total = 0
        self._scan_depth = SCAN_DEPTHS[0]
        self._scan_filter = None  # None or the action class name for the filter
        self._scan_range = None   # None or (mode, message id)

        # Item in the chat menu (three dots inside the chat)
        self._chat_menu_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_mz_t("Видалити службові…", "Delete service…", "Удалить служебные…"),
                subtext=_mz_t("Масове видалення службових повідомлень", "Bulk delete service messages", "Массовое удаление служебных сообщений"),
                icon="msg_info",
                on_click=self._on_chat_menu_click,
                priority=20,
            )
        )

        # Item in the message context menu (long press)
        self._msg_menu_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text=_mz_t("Видалити всі такі самі", "Delete all like this", "Удалить все такие же"),
                subtext=_mz_t("Службові повідомлення цього типу", "Service messages of this type", "Служебные сообщения этого типа"),
                icon="msg_list",
                on_click=self._on_same_type_click,
                priority=20,
            )
        )
        # "Pull up/down": all service messages older/newer than the selected one
        self._above_menu_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text=_mz_t("Видалити службові вище", "Delete service above", "Удалить служебные выше"),
                subtext=_mz_t("Це повідомлення та вище", "This message and above", "Это сообщение и выше"),
                icon="msg_info",
                on_click=self._on_above_click,
                priority=19,
            )
        )
        self._below_menu_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text=_mz_t("Видалити службові нижче", "Delete service below", "Удалить служебные ниже"),
                subtext=_mz_t("Це повідомлення та нижче", "This message and below", "Это сообщение и ниже"),
                icon="msg_info",
                on_click=self._on_below_click,
                priority=18,
            )
        )
        self.logger.info("Service Cleaner loaded")

    def on_plugin_unload(self):
        for item_id in (getattr(self, "_chat_menu_id", None),
                        getattr(self, "_msg_menu_id", None),
                        getattr(self, "_above_menu_id", None),
                        getattr(self, "_below_menu_id", None)):
            if item_id:
                try:
                    self.remove_menu_item(item_id)
                except Exception:
                    pass

    def create_settings(self):
        return [
            Header(text=_mz_t("Які повідомлення видаляти", "Which messages to delete", "Какие сообщения удалять")),
            Switch(
                key="delete_joins",
                text=_mz_t("Вхід/вихід учасників", "Members joining/leaving", "Вход/выход участников"),
                subtext=_mz_t("«приєднався до чату», «покинув чат», запрошення", "\"joined the chat\", \"left the chat\", invitations", "«вошёл в чат», «покинул чат», приглашения"),
                default=True,
                icon="msg_info",
            ),
            Switch(
                key="delete_poll_votes",
                text=_mz_t("Варіанти в опитуваннях", "Poll options", "Варианты в опросах"),
                subtext=_mz_t("«додав варіант в опитування», голоси", "\"added a poll option\", votes", "«добавил вариант в опрос», голоса"),
                default=True,
                icon="msg_list",
            ),
            Switch(
                key="delete_other",
                text=_mz_t("Інші службові", "Other service", "Прочие служебные"),
                subtext=_mz_t("закріплення, зміна назви/фото тощо", "pins, title/photo changes, etc.", "закрепления, смена названия/фото и т.п."),
                default=False,
                icon="msg_settings",
            ),
            Divider(),
            Header(text=_mz_t("Глибина сканування", "Scan depth", "Глубина сканирования")),
            Selector(
                key="scan_depth",
                text=_mz_t("Скільки останніх повідомлень перевіряти", "How many recent messages to check", "Сколько последних сообщений проверять"),
                default=0,
                items=[_mz_t("100 повідомлень", "100 messages", "100 сообщений"), _mz_t("300 повідомлень", "300 messages", "300 сообщений"), _mz_t("600 повідомлень", "600 messages", "600 сообщений"),
                       _mz_t("1200 повідомлень", "1200 messages", "1200 сообщений")],
                icon="msg_list",
            ),
            Divider(),
            Text(
                text=_mz_t("Як користуватися", "How to use", "Как пользоваться"),
                subtext=_mz_t("Меню чату (⋮) → «Видалити службові…», або довге натискання на службове повідомлення → «Видалити всі такі самі» / «вище» / «нижче». Щоб видаляти чужі повідомлення, потрібні права адміністратора.", "Chat menu (⋮) → \"Delete service…\", or long press on a service message → \"Delete all like this\" / \"above\" / \"below\". Deleting other people's messages requires admin rights.", ("Меню чата (⋮) → «Удалить служебные…», или долгое "
                        "нажатие на служебное сообщение → «Удалить все "
                        "такие же» / «выше» / «ниже». Для удаления чужих "
                        "сообщений нужны права администратора.")),
                icon="msg_info",
            ),
        ]

    # ------------------------------------------------------------------
    # Menu item handlers
    # ------------------------------------------------------------------

    def _on_chat_menu_click(self, context: Dict[str, Any]):
        dialog_id = self._resolve_dialog_id(context)
        if not dialog_id:
            self._bulletin(_mz_t("Не вдалося визначити чат", "Couldn't determine the chat", "Не удалось определить чат"))
            return
        self._run_scan(self._account_of(context), dialog_id, None)

    def _on_same_type_click(self, context: Dict[str, Any]):
        owner, dialog_id = self._service_owner_or_hint(context)
        if owner is None:
            return
        action = getattr(owner, "action", None)
        if action is None:
            self._bulletin(_mz_t("Це не службове повідомлення", "This is not a service message", "Это не служебное сообщение"))
            return
        action_name = str(action.getClass().getSimpleName())
        if action_name in UNDELETABLE_ACTION_NAMES:
            self._bulletin(_mz_t("Повідомлення «канал/чат створено» видалити не можна", "The \"channel/chat created\" message can't be deleted", "Сообщение «канал/чат создан» удалить нельзя"))
            return
        self._run_scan(self._account_of(context), dialog_id, action_name)

    def _on_above_click(self, context: Dict[str, Any]):
        owner, dialog_id = self._service_owner_or_hint(context)
        if owner is None:
            return
        self._run_scan(self._account_of(context), dialog_id, None,
                       "above", int(owner.id))

    def _on_below_click(self, context: Dict[str, Any]):
        owner, dialog_id = self._service_owner_or_hint(context)
        if owner is None:
            return
        self._run_scan(self._account_of(context), dialog_id, None,
                       "below", int(owner.id))

    def _service_owner_or_hint(self, context: Dict[str, Any]):
        """Dialog id and TLRPC.Message of the tapped service message.

        Returns (None, 0) with a hint if the tapped message is not a service
        message or the chat couldn't be determined.
        """
        dialog_id = self._resolve_dialog_id(context)
        if not dialog_id:
            self._bulletin(_mz_t("Не вдалося визначити чат", "Couldn't determine the chat", "Не удалось определить чат"))
            return None, 0
        message = context.get("message")
        owner = getattr(message, "messageOwner", None) if message is not None else None
        if owner is None or not isinstance(owner, TLRPC.TL_messageService):
            self._bulletin(_mz_t("Це не службове повідомлення", "This is not a service message", "Это не служебное сообщение"))
            return None, 0
        return owner, dialog_id

    # ------------------------------------------------------------------
    # History scan
    # ------------------------------------------------------------------

    def _run_scan(self, account: int, dialog_id: int,
                  type_filter: Optional[str] = None,
                  range_mode: Optional[str] = None,
                  range_ref_id: int = 0):
        try:
            depth_index = int(self.get_setting("scan_depth", 0))
        except Exception:
            depth_index = 0
        if depth_index < 0 or depth_index >= len(SCAN_DEPTHS):
            depth_index = 0
        self._scan_depth = SCAN_DEPTHS[depth_index]
        self._scan_filter = type_filter
        # None, ("above", id): only this message and older,
        # ("below", id): only this message and newer.
        if range_mode in ("above", "below") and range_ref_id:
            self._scan_range = (range_mode, int(range_ref_id))
        else:
            self._scan_range = None

        run_on_ui_thread(lambda: self._show_scan_dialog())
        run_on_queue(
            lambda: self._scan_page(account, dialog_id, 0, 0, 0, []))

    def _show_scan_dialog(self):
        activity = self._activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_SPINNER)
        builder.set_title(_mz_t("Службові повідомлення", "Service messages", "Служебные сообщения"))
        builder.set_message(_mz_t("Скануємо історію чату…", "Scanning the chat history…", "Сканирую историю чата…"))
        builder.set_cancelable(False)
        builder.show()
        self._scan_dialog = builder

    def _scan_page(self, account: int, dialog_id: int, offset_id: int,
                   offset_date: int, scanned: int, found: List):
        """Requests the next history page (runs off the UI thread)."""
        if scanned >= self._scan_depth:
            self._finish_scan(account, dialog_id, found)
            return
        try:
            mc = get_messages_controller(account)
            peer = mc.getInputPeer(dialog_id)
            if peer is None:
                run_on_ui_thread(
                    lambda: self._scan_failed(_mz_t("Не вдалося відкрити чат", "Couldn't open the chat", "Не удалось открыть чат")))
                return
            req = TLRPC.TL_messages_getHistory()
            req.peer = peer
            req.offset_id = offset_id
            req.offset_date = offset_date
            req.add_offset = 0
            req.limit = min(PAGE_SIZE, self._scan_depth - scanned)
            req.max_id = 0
            req.min_id = 0
            if hasattr(req, "hash"):
                req.hash = 0
            send_request(
                req,
                lambda response, error: self._on_history(
                    account, dialog_id, offset_id, scanned, found,
                    response, error),
                account=account,
            )
        except Exception:
            self.logger.exception("scan failed")
            run_on_ui_thread(
                lambda: self._scan_failed(_mz_t("Помилка сканування (див. журнал)", "Scan error (see the log)", "Ошибка сканирования (см. лог)")))

    def _on_history(self, account: int, dialog_id: int, prev_offset_id: int,
                    scanned: int, found: List, response, error):
        if error is not None:
            text = getattr(error, "text", None) or error
            run_on_ui_thread(
                lambda: self._scan_failed(_mz_t("Не вдалося прочитати історію: ", "Couldn't read the history: ", "Не удалось прочитать историю: ")
                                          + str(text)))
            return
        messages = getattr(response, "messages", None)
        if messages is None or messages.isEmpty():
            self._finish_scan(account, dialog_id, found)
            return
        size = messages.size()
        scanned += size
        last = messages.get(size - 1)
        for i in range(size):
            msg = messages.get(i)
            if isinstance(msg, TLRPC.TL_messageService):
                self._collect_if_needed(msg, found)
        # End of history or the page is smaller than requested: stop.
        if size < PAGE_SIZE:
            self._finish_scan(account, dialog_id, found)
            return
        if scanned >= self._scan_depth:
            self._finish_scan(account, dialog_id, found)
            return
        # Protection against looping if the server doesn't move the offset.
        if prev_offset_id != 0 and last.id >= prev_offset_id:
            self._finish_scan(account, dialog_id, found)
            return
        self._scan_page(account, dialog_id, last.id, last.date, scanned,
                        found)

    def _collect_if_needed(self, msg, found: List):
        # "Channel/chat created" can't be deleted: don't count it.
        action = getattr(msg, "action", None)
        for cls in UNDELETABLE_CLASSES:
            if action is not None and isinstance(action, cls):
                return
        # "above/below" filter relative to the selected message (including it).
        if self._scan_range is not None:
            mode, ref_id = self._scan_range
            mid = int(msg.id)
            if mode == "above" and mid > ref_id:
                return
            if mode == "below" and mid < ref_id:
                return
        category = self._category_of(msg)
        if not self._category_enabled(category):
            return
        if self._scan_filter is not None \
                and self._action_name(msg) != self._scan_filter:
            return
        found.append((int(msg.id), category))

    def _category_of(self, msg) -> str:
        action = getattr(msg, "action", None)
        if action is None:
            return CATEGORY_OTHER
        for cls in JOIN_CLASSES:
            if isinstance(action, cls):
                return CATEGORY_JOIN
        for cls in POLL_CLASSES:
            if isinstance(action, cls):
                return CATEGORY_POLL
        return CATEGORY_OTHER

    def _category_enabled(self, category: str) -> bool:
        if category == CATEGORY_JOIN:
            return bool(self.get_setting("delete_joins", True))
        if category == CATEGORY_POLL:
            return bool(self.get_setting("delete_poll_votes", True))
        return bool(self.get_setting("delete_other", False))

    def _action_name(self, msg) -> str:
        action = getattr(msg, "action", None)
        if action is None:
            return ""
        return str(action.getClass().getSimpleName())

    def _finish_scan(self, account: int, dialog_id: int, found: List):
        entries = list(found)
        run_on_ui_thread(
            lambda: self._show_confirm(account, dialog_id, entries))

    # ------------------------------------------------------------------
    # Confirmation
    # ------------------------------------------------------------------

    def _show_confirm(self, account: int, dialog_id: int, entries: List):
        self._dismiss_scan_dialog()
        if not entries:
            self._bulletin(_mz_t("Службових повідомлень не знайдено", "No service messages found", "Служебные сообщения не найдены"))
            return
        joins = sum(1 for _mid, c in entries if c == CATEGORY_JOIN)
        polls = sum(1 for _mid, c in entries if c == CATEGORY_POLL)
        others = len(entries) - joins - polls
        lines = [_mz_t("Знайдено службових повідомлень: %d", "Service messages found: %d", "Найдено служебных сообщений: %d") % len(entries)]
        if joins:
            lines.append(_mz_t("• вхід/вихід: %d", "• joining/leaving: %d", "• вход/выход: %d") % joins)
        if polls:
            lines.append(_mz_t("• варіанти в опитуваннях: %d", "• poll options: %d", "• варианты в опросах: %d") % polls)
        if others:
            lines.append(_mz_t("• інші: %d", "• other: %d", "• прочие: %d") % others)
        lines.append("")
        lines.append(_mz_t("Видалити їх для всіх?", "Delete them for everyone?", "Удалить их для всех?"))

        activity = self._activity()
        if activity is None:
            self._bulletin(_mz_t("Не вдалося показати діалог підтвердження", "Couldn't show the confirmation dialog", "Не удалось показать диалог подтверждения"))
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(_mz_t("Видалити службові?", "Delete service messages?", "Удалить служебные?"))
        builder.set_message("\n".join(lines))

        ids = [mid for mid, _c in entries]

        def on_positive(bld, which):
            bld.dismiss()
            self._start_delete(account, dialog_id, ids)

        def on_negative(bld, which):
            bld.dismiss()

        builder.set_positive_button(_mz_t("Видалити", "Delete", "Удалить"), on_positive)
        builder.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), on_negative)
        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        builder.show()

    # ------------------------------------------------------------------
    # Deletion
    # ------------------------------------------------------------------

    def _start_delete(self, account: int, dialog_id: int, ids: List):
        if not ids:
            return
        use_channels = False
        channel = None
        try:
            if dialog_id < 0:
                mc = get_messages_controller(account)
                chat = mc.getChat(-dialog_id)
                if chat is not None and (chat.megagroup or chat.broadcast):
                    use_channels = True
                    channel = TLRPC.TL_inputChannel()
                    channel.channel_id = chat.id
                    channel.access_hash = chat.access_hash
        except Exception:
            self.logger.exception("cannot resolve chat for delete")
        run_on_ui_thread(lambda: self._show_delete_dialog(len(ids)))
        run_on_queue(
            lambda: self._delete_batch(
                account, use_channels, channel, ids, 0, 0, 0))

    def _show_delete_dialog(self, total: int):
        activity = self._activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity, AlertDialogBuilder.ALERT_TYPE_LOADING)
        builder.set_title(_mz_t("Видалення…", "Deleting…", "Удаление…"))
        builder.set_message("0 / %d" % total)
        builder.set_progress(0)
        builder.set_cancelable(False)
        builder.show()
        self._delete_dialog = builder
        self._delete_total = total

    def _delete_batch(self, account: int, use_channels: bool, channel,
                      ids: List, index: int, deleted: int, failed: int):
        if index >= len(ids):
            run_on_ui_thread(
                lambda: self._finish_delete(deleted, failed))
            return
        batch = ids[index:index + DELETE_BATCH]
        try:
            if use_channels:
                req = TLRPC.TL_channels_deleteMessages()
                req.channel = channel
            else:
                req = TLRPC.TL_messages_deleteMessages()
            for mid in batch:
                req.id.add(Integer(mid))
            send_request(
                req,
                lambda response, error: self._on_delete(
                    account, use_channels, channel, ids, index, deleted,
                    failed, len(batch), error),
                account=account,
            )
        except Exception:
            self.logger.exception("delete request failed")
            run_on_ui_thread(
                lambda: self._finish_delete(deleted, failed + len(batch)))

    def _on_delete(self, account: int, use_channels: bool, channel,
                   ids: List, index: int, deleted: int, failed: int,
                   batch_len: int, error):
        if error is not None:
            failed += batch_len
            self.logger.warning("delete error: %s",
                                getattr(error, "text", error))
        else:
            deleted += batch_len
        done = min(index + batch_len, len(ids))
        run_on_ui_thread(lambda: self._update_delete_progress(done))
        self._delete_batch(account, use_channels, channel, ids,
                           index + batch_len, deleted, failed)

    def _update_delete_progress(self, done: int):
        if self._delete_dialog is None:
            return
        try:
            total = self._delete_total or 1
            self._delete_dialog.set_message(
                "%d / %d" % (done, self._delete_total))
            self._delete_dialog.set_progress(int(done * 100 / total))
        except Exception:
            self.logger.exception("progress update failed")

    def _finish_delete(self, deleted: int, failed: int):
        self._dismiss_delete_dialog()
        message = _mz_t("Видалено службових повідомлень: %d", "Service messages deleted: %d", "Удалено служебных сообщений: %d") % deleted
        if failed:
            message += _mz_t(", не вдалося: %d (потрібні права адміністратора?)", ", failed: %d (admin rights needed?)", ", не удалось: %d (нужны права администратора?)") % failed
        self._bulletin(message)

    # ------------------------------------------------------------------
    # Helper methods
    # ------------------------------------------------------------------

    def _account_of(self, context: Dict[str, Any]) -> int:
        account = context.get("account")
        try:
            return int(account) if account is not None else 0
        except Exception:
            return 0

    def _resolve_dialog_id(self, context: Dict[str, Any]) -> int:
        dialog_id = context.get("dialog_id")
        if dialog_id:
            try:
                return int(dialog_id)
            except Exception:
                pass
        fragment = context.get("fragment") or get_last_fragment()
        get_dialog_id = getattr(fragment, "getDialogId", None)
        if get_dialog_id is not None:
            try:
                return int(get_dialog_id())
            except Exception:
                pass
        chat_id = context.get("chatId") or context.get("chat_id")
        if chat_id:
            try:
                return -int(chat_id)
            except Exception:
                pass
        user_id = context.get("userId") or context.get("user_id")
        if user_id:
            try:
                return int(user_id)
            except Exception:
                pass
        return 0

    def _activity(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        return fragment.getParentActivity()

    def _dismiss_scan_dialog(self):
        if self._scan_dialog is not None:
            try:
                self._scan_dialog.dismiss()
            except Exception:
                pass
            self._scan_dialog = None

    def _dismiss_delete_dialog(self):
        if self._delete_dialog is not None:
            try:
                self._delete_dialog.dismiss()
            except Exception:
                pass
            self._delete_dialog = None

    def _scan_failed(self, message: str):
        self._dismiss_scan_dialog()
        self._bulletin(message)

    def _bulletin(self, message: str):
        def show():
            try:
                BulletinHelper.show_info(message)
            except Exception:
                self.logger.exception("bulletin failed: %s", message)
        run_on_ui_thread(show)

