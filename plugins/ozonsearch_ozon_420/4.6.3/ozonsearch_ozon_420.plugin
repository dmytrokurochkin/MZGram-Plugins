# ── плагин ─────────────────────────────────────────────────────────

class OzonSearchPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._alive = True
        self._bg_threads = weakref.WeakSet()
        self._log_buffer = []
        self._log_lock = threading.RLock()
        self._cache = {}
        self._cache_lock = threading.Lock()
        self._kw_warned = set()
        self._slider_kwargs = None
        self._slider_ok = SLIDER_CLS is not None
        self._session = OzonSession(self._plog)
        self._last_error_code = None
        self._menu_item_id = None

    # ── локализация ────────────────────────────────────────────────

    def _lang(self):
        # 0=ru, 1=en
        try:
            idx = int(self.get_setting("lang", 0) or 0)
        except (TypeError, ValueError):
            idx = 0
        return {0: "ru", 1: "en"}.get(idx, "ru")

    def tr(self, key):
        lang = self._lang()
        return STRINGS[lang].get(key) or STRINGS["ru"].get(key) or key

    def _sep(self):
        idx = self._int("sep_style", 0, len(SEPARATORS) - 1, DEFAULTS["sep_style"])
        return SEPARATORS[idx]

    def _ui(self, fn):
        if not self._alive:
            return
        run_on_ui_thread(fn)

    def _spawn(self, target, args=()):
        """Фоновый поток со слабой ссылкой + перехват необработанных
        исключений (иначе поток тихо умирает без следа в логах)."""
        def runner(*a):
            try:
                target(*a)
            except Exception as e:
                self._plog("Необработанное исключение в потоке {}: {}\n{}".format(
                    getattr(target, "__name__", str(target)), e, traceback.format_exc()),
                    level="ERROR")
        t = threading.Thread(target=runner, args=args, daemon=True)
        self._bg_threads.add(t)
        t.start()
        return t

    def _plog(self, msg, level="INFO"):
        try:
            log("[OzonSearch] {}".format(msg))
        except Exception:
            pass
        entry = {"ts": time.time(), "level": level, "msg": str(msg)}
        with self._log_lock:
            self._log_buffer.append(entry)
            overflow = len(self._log_buffer) - MAX_LOG_ENTRIES
            if overflow > 0:
                del self._log_buffer[:overflow]

    # ── чтение настроек ───────────────────────────────────────────

    def _bool(self, key, default=False):
        value = self.get_setting(key, default)
        if isinstance(value, bool):
            return value
        if value is None:
            return default
        t = str(value).strip().lower()
        if t in ("1", "true", "yes", "on"):
            return True
        if t in ("0", "false", "no", "off"):
            return False
        return default

    def _int(self, key, lo, hi, default):
        """Числовая настройка с зажимом в диапазон. Работает и когда значение
        пришло от слайдера (int), и когда от поля ввода (строка) — поэтому
        фолбэк Slider→Input не ломает семантику сохранённого значения."""
        raw = self.get_setting(key, default)
        try:
            val = float(str(raw).strip().replace(",", "."))
        except (TypeError, ValueError):
            val = float(default)
        if val != val:  # nan
            val = float(default)
        val = int(round(val))
        if val < lo:
            val = lo
        if val > hi:
            val = hi
        return val

    def _str(self, key, default=""):
        v = self.get_setting(key, default)
        return (str(v) if v is not None else default).strip()

    def _timeout(self):
        return self._int("net_timeout", R_TIMEOUT[0], R_TIMEOUT[1], R_TIMEOUT[3])

    def _ua(self):
        mode = self._int("ua_mode", 0, 2, 0)
        if mode == 2:
            custom = self._str("ua_custom")
            if custom:
                return custom
            return UA_MOBILE
        return UA_DESKTOP if mode == 1 else UA_MOBILE

    # ── безопасное создание UI-элементов ──────────────────────────

    def _supports(self, cls, kw):
        allowed = _item_allowed(cls)
        return allowed is None or kw in allowed

    def _warn_kwargs(self, cls, dropped):
        key = (getattr(cls, "__name__", str(cls)), tuple(sorted(dropped)))
        if key in self._kw_warned:
            return
        self._kw_warned.add(key)
        self._plog("{} не поддерживает kwargs {} в этой сборке SDK — "
                   "они проигнорированы".format(getattr(cls, "__name__", cls),
                                                sorted(dropped)), level="WARN")

    def _it(self, cls, **kwargs):
        """Создаёт элемент настроек, отбрасывая kwargs, которых нет в этой
        версии SDK (именно из-за такого kwarg разделы падают целиком)."""
        kwargs = {k: v for k, v in kwargs.items() if v is not None}
        allowed = _item_allowed(cls)
        if allowed is not None:
            if "text" not in allowed:
                allowed = None
            elif any(c in kwargs and c not in allowed for c in ("key", "items")):
                allowed = None
        if allowed is not None:
            dropped = [k for k in kwargs if k not in allowed]
            if dropped:
                for k in dropped:
                    kwargs.pop(k, None)
                self._warn_kwargs(cls, dropped)
        try:
            return cls(**kwargs)
        except TypeError:
            for opt in ("subtext", "icon", "red", "accent", "on_click",
                        "create_sub_fragment", "default"):
                if opt not in kwargs:
                    continue
                kwargs.pop(opt, None)
                try:
                    item = cls(**kwargs)
                    self._warn_kwargs(cls, [opt])
                    return item
                except TypeError:
                    continue
            self._plog("Не удалось создать {} с {}".format(
                getattr(cls, "__name__", cls), list(kwargs)), level="ERROR")
            try:
                return Text(text=str(kwargs.get("text", "?")))
            except Exception:
                return Header(text=str(kwargs.get("text", "?")))

    def _hint(self, text):
        return self._it(Divider, text=text)

    def _sel(self, key, text, items, default=0, subtext=None, icon=None):
        """Selector + пояснение. Selector в части сборок SDK не принимает
        subtext — подпись уезжает в Divider под ним."""
        base = {"key": key, "text": text, "items": items, "default": default}
        if icon and self._supports(Selector, "icon"):
            base["icon"] = icon
        if subtext and self._supports(Selector, "subtext"):
            try:
                return [Selector(**dict(base, subtext=subtext))]
            except TypeError:
                pass
        out = [self._it(Selector, **base)]
        if subtext:
            out.append(self._hint(subtext))
        return out

    def _slider(self, key, label, rng, unit="", hint=None, icon=None, fmt=None):
        """Полоска-регулятор. Текущее значение вписано в заголовок пункта,
        чтобы оно читалось даже если сборка не рисует бабл с цифрой.
        Если Slider недоступен — деградируем до числового поля, сохраняя
        ровно то же значение (не индекс), так что _int() не ломается."""
        lo, hi, step, default = rng
        cur = self._int(key, lo, hi, default)
        shown = fmt(cur) if fmt else "{}{}".format(cur, unit)
        text = "{} — {}".format(label, shown)

        if SLIDER_CLS is not None:
            base = {"key": key, "text": text, "default": default}
            if icon and self._supports(SLIDER_CLS, "icon"):
                base["icon"] = icon
            sub_ok = bool(hint) and self._supports(SLIDER_CLS, "subtext")
            if sub_ok:
                base["subtext"] = hint

            variants = []
            if self._slider_kwargs:
                variants.append(self._slider_kwargs)
            variants += [
                {"min_value": lo, "max_value": hi, "step": step},
                {"min_value": lo, "max_value": hi},
                {"min": lo, "max": hi, "step": step},
                {"min": lo, "max": hi},
                {"minimum": lo, "maximum": hi, "step": step},
                {"min_value": lo, "max_value": hi, "step_size": step},
            ]
            allowed = _item_allowed(SLIDER_CLS)
            for cand in variants:
                if allowed is not None and not all(k in allowed for k in cand):
                    continue
                try:
                    item = SLIDER_CLS(**dict(base, **cand))
                except TypeError:
                    continue
                self._slider_kwargs = cand   # запоминаем рабочую схему имён
                rows = [item]
                if hint and not sub_ok:
                    rows.append(self._hint(hint))
                return rows
            self._slider_ok = False
            self._plog("{} не удалось собрать ни с одной схемой min/max — "
                       "переключаюсь на числовые поля".format(SLIDER_NAME), level="WARN")

        range_hint = "{}…{}{}".format(lo, hi, unit)
        sub = "{} · {}".format(range_hint, hint) if hint else range_hint
        return [self._it(Input, key=key, text=label, default=str(default),
                         subtext=sub, icon=icon)]

    def _safe_page(self, builder):
        try:
            return builder()
        except Exception as e:
            tb = traceback.format_exc()
            self._plog("Ошибка построения страницы настроек ({}): {}\n{}".format(
                getattr(builder, "__name__", "?"), e, tb), level="ERROR")
            return [
                self._it(Header, text=self.tr("s_page_error_head")),
                self._it(Text, text=self.tr("s_page_error_text"), subtext=str(e),
                         icon="msg_error", red=True),
                self._it(Text, text=self.tr("s_page_error_hint"), icon="msg_info"),
                self._it(Text, text=self.tr("s_dev_copy_all"), icon="msg_copy",
                         on_click=lambda view, t=tb: self._copy_and_notify(t)),
            ]

    # ── буфер обмена / диалоги ────────────────────────────────────

    def _copy_text(self, text):
        if not text:
            return False
        try:
            from android_utils import copy_to_clipboard as _sdk_copy
            _sdk_copy(text)
            return True
        except Exception:
            pass
        try:
            from java import jclass
            au = jclass("org.telegram.messenger.AndroidUtilities")
            au.addToClipboard(text)
            return True
        except Exception:
            pass
        try:
            from java import jclass
            app_loader = jclass("org.telegram.messenger.ApplicationLoader")
            clip_data = jclass("android.content.ClipData")
            ctx = app_loader.applicationContext
            cm = ctx.getSystemService("clipboard")
            cm.setPrimaryClip(clip_data.newPlainText("OzonSearch", text))
            return True
        except Exception as e:
            self._plog("clipboard fail: {}".format(e), level="ERROR")
        return False

    def _copy_and_notify(self, text):
        ok = self._copy_text(text)
        frag = get_last_fragment()
        if ok:
            done = getattr(BulletinHelper, "show_copied_to_clipboard", None)
            if callable(done):
                try:
                    done(frag)
                    return True
                except Exception:
                    pass
            BulletinHelper.show_info(self.tr("s_dev_copied"), frag)
        else:
            BulletinHelper.show_error(self.tr("s_dev_copy_fail"), frag)
        return ok

    @staticmethod
    def _invoke(obj, names, *args):
        for n in names:
            fn = getattr(obj, n, None)
            if callable(fn):
                return fn(*args)
        raise AttributeError("none of {} on {}".format(names, type(obj)))

    def _activity(self):
        try:
            return get_last_fragment().getParentActivity()
        except Exception:
            return None

    def _show_text_dialog(self, title, body):
        """Полное окно: скроллящийся диалог + кнопка «Копировать».
        Если диалог собрать не удалось — молча копируем в буфер."""
        def run():
            activity = self._activity()
            if activity is None:
                self._copy_and_notify(body)
                return
            shown = body
            if len(shown) > MAX_DIALOG_CHARS:
                shown = shown[:MAX_DIALOG_CHARS] + self.tr("s_dev_truncated")
            try:
                from ui.alert import AlertDialogBuilder
                b = AlertDialogBuilder(activity)
                self._invoke(b, ["set_title", "setTitle"], title)
                self._invoke(b, ["set_message", "setMessage"], shown)

                def on_copy(*_a):
                    self._copy_and_notify(body)
                    try:
                        self._invoke(b, ["dismiss"])
                    except Exception:
                        pass

                def on_close(*_a):
                    try:
                        self._invoke(b, ["dismiss"])
                    except Exception:
                        pass

                self._invoke(b, ["set_positive_button", "setPositiveButton"],
                             self.tr("s_dev_dlg_copy"), on_copy)
                self._invoke(b, ["set_negative_button", "setNegativeButton"],
                             self.tr("s_dev_dlg_close"), on_close)
                self._invoke(b, ["show"])
            except Exception as e:
                self._plog("dialog fail: {}\n{}".format(e, traceback.format_exc()),
                           level="ERROR")
                self._copy_and_notify(body)
        self._ui(run)

    def _confirm(self, message, yes_label, on_yes):
        def run():
            activity = self._activity()
            if activity is None:
                on_yes()
                return
            try:
                from ui.alert import AlertDialogBuilder
                b = AlertDialogBuilder(activity)
                self._invoke(b, ["set_title", "setTitle"], __name__)
                self._invoke(b, ["set_message", "setMessage"], message)

                def yes(*_a):
                    try:
                        self._invoke(b, ["dismiss"])
                    except Exception:
                        pass
                    on_yes()

                self._invoke(b, ["set_positive_button", "setPositiveButton"], yes_label, yes)
                self._invoke(b, ["set_negative_button", "setNegativeButton"],
                             self.tr("s_dev_dlg_close"),
                             lambda *_a: self._invoke(b, ["dismiss"]))
                self._invoke(b, ["show"])
            except Exception as e:
                self._plog("confirm dialog fail: {}".format(e), level="ERROR")
                on_yes()
        self._ui(run)

    # ── жизненный цикл ────────────────────────────────────────────

    def on_plugin_load(self):
        self._alive = True
        self.add_on_send_message_hook()
        try:
            self._menu_item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text=self.tr("menu_search"),
                    on_click=self._on_context_menu_click,
                    icon="msg_search",
                    subtext=self.tr("menu_search_sub"),
                    priority=10,
                )
            )
        except Exception as e:
            self._plog("не удалось зарегистрировать пункт контекстного меню: {}".format(e),
                       level="ERROR")
            self._menu_item_id = None
        self._plog("OzonSearch v{} loaded · slider={} · hook registered".format(
            __version__, SLIDER_NAME or "none"))
        # уведомление о загрузке отключено намеренно — не беспокоим пользователя

    def on_plugin_unload(self):
        self._alive = False
        if self._menu_item_id:
            try:
                self.remove_menu_item(self._menu_item_id)
            except Exception:
                pass
            self._menu_item_id = None
        # жёсткая очистка, чтобы не оставлять ссылки и не раздувать память клиента
        with self._cache_lock:
            self._cache.clear()
        with self._log_lock:
            self._log_buffer.clear()
        try:
            self._session.reset()
            self._session.last_raw = ""
            self._session.last_strategy = ""
            self._session.last_status = ""
        except Exception:
            pass
        self._last_error_code = None
        self._kw_warned.clear()
        self._slider_kwargs = None
        self._bg_threads.clear()
        try:
            gc.collect()
        except Exception:
            pass
        self._plog("OzonSearch unloaded")

    def on_app_event(self, event_type: AppEvent):
        pass

    # ── контекстное меню ───────────────────────────────────────────

    @staticmethod
    def _as_text(value):
        """CharSequence / Spannable / bytes / str → обычная строка.
        messageText в MessageObject часто не str, а Java CharSequence —
        именно из‑за isinstance(..., str) раньше срабатывало «нет текста»."""
        if value is None:
            return None
        if isinstance(value, str):
            s = value
        elif isinstance(value, bytes):
            try:
                s = value.decode("utf-8", "replace")
            except Exception:
                return None
        else:
            # CharSequence, SpannableStringBuilder, StringBuilder и т.п.
            try:
                s = str(value)
            except Exception:
                try:
                    s = value.toString()
                except Exception:
                    return None
        s = s.strip()
        return s if s else None

    def _message_text(self, message):
        """Достаём текст/подпись из MessageObject всеми доступными путями."""
        if message is None:
            return None

        # 1) отображаемый текст (может быть CharSequence)
        for attr in ("messageText", "message_text", "caption", "captionText"):
            s = self._as_text(getattr(message, attr, None))
            if s:
                return s

        # 2) сырой TLRPC.Message.message / .messageOwner.message
        owner = getattr(message, "messageOwner", None)
        if owner is not None:
            for attr in ("message", "caption", "messageText"):
                s = self._as_text(getattr(owner, attr, None))
                if s:
                    return s
            media = getattr(owner, "media", None)
            if media is not None:
                s = self._as_text(getattr(media, "caption", None))
                if s:
                    return s

        # 3) метод getMessageText / getCaption, если есть
        for name in ("getMessageText", "getCaption", "getText"):
            fn = getattr(message, name, None)
            if callable(fn):
                try:
                    s = self._as_text(fn())
                    if s:
                        return s
                except Exception:
                    pass

        return None

    def _resolve_peer(self, context, message):
        """dialog_id из контекста, иначе getDialogId() у сообщения."""
        if context:
            for key in ("dialog_id", "dialogId", "peer", "chatId"):
                val = context.get(key)
                if val is not None:
                    try:
                        return int(val)
                    except (TypeError, ValueError):
                        return val
        if message is not None:
            for name in ("getDialogId", "getChatId"):
                fn = getattr(message, name, None)
                if callable(fn):
                    try:
                        return fn()
                    except Exception:
                        pass
            for attr in ("dialogId", "dialog_id"):
                val = getattr(message, attr, None)
                if val is not None:
                    return val
        return None

    def _on_context_menu_click(self, context):
        try:
            message = context.get("message") if context else None
            text = self._message_text(message)
            if not text:
                # сгруппированные сообщения (альбом) — пробуем первый с текстом
                grouped = (context or {}).get("groupedMessages")
                if grouped:
                    try:
                        for m in grouped:
                            text = self._message_text(m)
                            if text:
                                message = m
                                break
                    except Exception:
                        pass
            if not text:
                self._plog(
                    "контекстное меню: текст не извлечён · keys={} · msg={}".format(
                        list((context or {}).keys()),
                        type(message).__name__ if message is not None else None),
                    level="WARN")
                self._ui(lambda: BulletinHelper.show_info(
                    self.tr("menu_empty_text"), get_last_fragment()))
                return
            text = re.sub(r"\s+", " ", text).strip()[:200]
            peer = self._resolve_peer(context, message)
            if peer is None:
                self._plog("контекстное меню: не удалось определить чат для ответа",
                           level="ERROR")
                self._ui(lambda: BulletinHelper.show_error(
                    self.tr("menu_empty_text"), get_last_fragment()))
                return
            self._spawn(self._run_search, args=(peer, text))
        except Exception as e:
            self._plog("контекстное меню: сбой обработчика: {}\n{}".format(
                e, traceback.format_exc()), level="ERROR")

    # ── хук команд ───────────────────────────────────────────────

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            if not isinstance(getattr(params, "message", None), str):
                return HookResult()

            raw = params.message.strip()
            if not raw:
                return HookResult()
            parts = raw.split(" ", 1)
            first = parts[0].lower()
            arg = parts[1].strip() if len(parts) > 1 else ""

            cmd = (self._str("cmd_search", DEFAULT_CMD) or DEFAULT_CMD).lower()
            if cmd and first == cmd:
                peer = getattr(params, "peer", None)
                self._spawn(self._run_search, args=(peer, arg))
                return HookResult(strategy=HookStrategy.CANCEL)

            return HookResult()
        finally:
            del params

    # ── отправка ────────────────────────────────────────────────

    def _send(self, peer, text):
        try:
            return send_message({"peer": peer, "message": text})
        except Exception as e:
            self._plog("send dict fail: {}".format(e), level="ERROR")
        try:
            return send_message(peer, text)
        except Exception as e:
            self._plog("send positional fail: {}".format(e), level="ERROR")
        return None

    def _send_photo(self, peer, path, caption):
        """Отправка фото. Возвращает True при успехе."""
        if not path or not os.path.isfile(path):
            return False
        caption = (caption or "")[:IMG_CAPTION_LIMIT]
        if _sdk_send_photo is not None:
            try:
                _sdk_send_photo(peer, path, caption=caption)
                return True
            except TypeError:
                try:
                    _sdk_send_photo(peer, path, caption)
                    return True
                except Exception as e:
                    self._plog("send_photo sdk fail: {}".format(e), level="ERROR")
            except Exception as e:
                self._plog("send_photo sdk fail: {}".format(e), level="ERROR")
        # fallback через send_message params
        try:
            send_message({
                "peer": peer,
                "path": path,
                "photo": path,
                "caption": caption,
                "message": caption,
            })
            return True
        except Exception as e:
            self._plog("send_photo fallback fail: {}".format(e), level="ERROR")
        return False

    def _format_caption(self, it, index=None):
        """Короткая подпись под фото (лимит Telegram ~1024)."""
        show_pos = self._bool("show_position", True)
        show_old = self._bool("show_old_price", True)
        show_disc = self._bool("show_discount", True)
        show_rating = self._bool("show_rating", True)
        show_reviews = self._bool("show_reviews", True)
        mark_ads = self._bool("mark_ads", True) and not self._bool("hide_ads", True)

        lines = []
        prefix = "{}. ".format(index) if (show_pos and index is not None) else ""
        lines.append(prefix + self._cut_title(it.get("title")))

        price = it.get("price")
        if price:
            money = _fmt_money(price)
            old = it.get("old_price")
            if old and show_old:
                extra = self.tr("was").format(_fmt_money(old))
                if show_disc:
                    try:
                        pct = int(round((1.0 - float(price) / float(old)) * 100))
                    except (TypeError, ValueError, ZeroDivisionError):
                        pct = 0
                    if pct > 0:
                        extra += ", −{}%".format(pct)
                money += " ({})".format(extra)
            lines.append("{}{}".format(self._emoji("💰 "), money))

        rating = it.get("rating")
        reviews = it.get("reviews")
        if show_rating and rating:
            part = "{}{:g}".format(self._emoji("★ "), rating)
            if show_reviews and reviews:
                part += " ({} {})".format(reviews, self._reviews_word(reviews))
            lines.append(part)
        elif show_reviews and reviews:
            lines.append("{} {}".format(reviews, self._reviews_word(reviews)))

        if mark_ads and it.get("is_ad"):
            lines.append("({})".format(self.tr("ad")))

        lines.append("{}{}".format(self._emoji("🔗 "), self._item_link(it)))
        text = "\n".join(lines)
        if len(text) > IMG_CAPTION_LIMIT:
            text = text[: IMG_CAPTION_LIMIT - 1] + "…"
        return text

    def _deliver_results(self, peer, parsed, items, search_link, total_matched, want):
        """Текст и/или фото. Вызывается из фонового потока."""
        use_photos = self._bool("show_photos", True)
        text_too = self._bool("photos_text_too", False)
        ua = self._ua()
        cookie = self._str("cookie")
        timeout = min(self._timeout(), 20)

        head = self.tr("head").format(parsed.text, self._filters_suffix(parsed))
        footer_bits = []
        if total_matched is not None and want and total_matched < want:
            footer_bits.append(self.tr("shown_fewer").format(total_matched, want))
        if self._bool("show_all_link", True):
            footer_bits.append(self.tr("all_link").format(search_link))

        if not use_photos:
            text = self._format_results(parsed, items, search_link,
                                        total_matched=total_matched, want=want)
            self._ui(lambda t=text: self._send(peer, t))
            return

        # текстовая сводка (опционально или если ни одной картинки не скачается)
        if text_too:
            text = self._format_results(parsed, items, search_link,
                                        total_matched=total_matched, want=want)
            self._ui(lambda t=text: self._send(peer, t))
            time.sleep(0.25)

        # заголовок, если сводку не слали — чтобы было понятно, по какому запросу фото
        if not text_too:
            intro = head
            if footer_bits:
                intro += "\n" + "\n".join(footer_bits)
            self._ui(lambda t=intro: self._send(peer, t))
            time.sleep(0.2)

        sent_photo = 0
        text_fallback = []
        for i, it in enumerate(items, 1):
            if not self._alive:
                break
            img_url = it.get("image")
            path = None
            if img_url:
                path = self._session.download_image(img_url, ua, cookie, timeout)
            caption = self._format_caption(it, index=i)
            if path:
                ok = self._send_photo(peer, path, caption)
                try:
                    os.unlink(path)
                except Exception:
                    pass
                if ok:
                    sent_photo += 1
                    time.sleep(PHOTO_SEND_GAP)
                    continue
            # нет картинки или не удалось отправить — накопим текст
            text_fallback.append(it)

        if text_fallback and not text_too:
            # товары без фото — одним текстовым блоком
            body = self._format_results(parsed, text_fallback, search_link,
                                        total_matched=None, want=None)
            # убрать повторный заголовок «Все результаты» если уже был в intro
            self._ui(lambda t=body: self._send(peer, t))

        self._plog("photos delivered: {} / {}, fallback text: {}".format(
            sent_photo, len(items), len(text_fallback)))

    def _status(self, key):
        if not self._bool("notify_searching", False):
            return
        self._ui(lambda: BulletinHelper.show_info(self.tr(key), get_last_fragment()))

    def _report_error(self, peer, text, extra=None):
        body = text if not extra else "{}\n{}".format(text, extra)
        if self._bool("notify_errors_bulletin", False):
            self._ui(lambda: BulletinHelper.show_error(text, get_last_fragment()))
            if extra:
                self._ui(lambda: self._send(peer, extra))
        else:
            self._ui(lambda: self._send(peer, body))

    # ── умные ошибки: код -> конкретная причина + конкретные шаги ──

    def _smart_error_text(self, err):
        """По коду ошибки (см. ERROR_CODES) собирает: заголовок с конкретной
        причиной, конкретные шаги решения и машинный код для обращения в
        поддержку. Возвращает готовый текст, без общих "что-то пошло не так"."""
        code = getattr(err, "code", "unknown")
        self._last_error_code = ERROR_CODES.get(code, ERROR_CODES["unknown"])
        timeout = self._timeout()
        tries = self._int("net_tries", R_TRIES[0], R_TRIES[1], R_TRIES[3])

        pairs = {
            "blocked_403": ("err_403", "err_403_hint"),
            "blocked_429": ("err_429", "err_429_hint"),
            "captcha": ("err_captcha", "err_captcha_hint"),
            "timeout": ("err_timeout", "err_timeout_hint"),
            "dns": ("err_dns", "err_dns_hint"),
            "ssl": ("err_ssl", "err_ssl_hint"),
            "conn": ("err_conn", "err_conn_hint"),
            "empty": ("err_data", "err_data_hint"),
            "badjson": ("err_data", "err_data_hint"),
            "nodata": ("err_data", "err_data_hint"),
            "http": ("err_http", "err_http_hint"),
        }
        title_key, hint_key = pairs.get(code, (None, None))
        if title_key is None:
            # неизвестная причина — используем старый общий текст как страховку
            if isinstance(err, OzonBlocked):
                title, hint = self.tr("err_blocked"), self.tr("err_blocked_hint")
            else:
                title, hint = self.tr("err_net"), None
        else:
            title = self.tr(title_key)
            hint = self.tr(hint_key)
            if "{}" in hint and code == "timeout":
                hint = hint.format(timeout, tries)

        raw_code = ERROR_CODES.get(code, ERROR_CODES["unknown"])
        status = getattr(err, "http_status", None)
        label = self.tr("err_code_label").format(
            "{} · HTTP {}".format(raw_code, status) if status else raw_code)

        parts = [title]
        if hint:
            parts.append(hint)
        parts.append(label)
        return "\n".join(parts)

    def _diagnose_no_results(self, raw_items, parsed):
        """Товары нашлись, но после фильтров список пуст — вместо общей
        фразы объясняем, какой именно фильтр всё съел, на основе того, что
        было в сырой выдаче до фильтрации."""
        if not raw_items:
            return self.tr("err_nr_generic")

        hide_ads = self._bool("hide_ads", True)
        require_price = self._bool("require_price", True)
        min_rating = parsed.min_rating
        if min_rating is None:
            x10 = self._int("min_rating_x10", R_RATE[0], R_RATE[1], R_RATE[3])
            min_rating = (x10 / 10.0) if x10 else None
        min_reviews = parsed.min_reviews
        if min_reviews is None:
            n = self._int("min_reviews_n", R_REVIEWS[0], R_REVIEWS[1], R_REVIEWS[3])
            min_reviews = n or None

        total = len(raw_items)
        ads_n = sum(1 for it in raw_items if it.get("is_ad"))
        price_n = sum(1 for it in raw_items if it.get("price"))
        price_range_n = sum(
            1 for it in raw_items if it.get("price")
            and (not parsed.price_min or it["price"] >= parsed.price_min)
            and (not parsed.price_max or it["price"] <= parsed.price_max))
        rating_n = sum(1 for it in raw_items if not min_rating
                       or (it.get("rating") or 0) >= min_rating - 1e-9)
        reviews_n = sum(1 for it in raw_items if not min_reviews
                        or (it.get("reviews") or 0) >= min_reviews)

        # выбираем самый «жадный» фильтр — тот, что отсёк больше всего
        candidates = []
        if (parsed.price_min or parsed.price_max) and price_range_n < total:
            candidates.append((total - price_range_n, "err_nr_price"))
        if min_rating and rating_n < total:
            candidates.append((total - rating_n, "err_nr_rating"))
        if min_reviews and reviews_n < total:
            candidates.append((total - reviews_n, "err_nr_reviews"))
        if hide_ads and ads_n >= total * 0.6 and ads_n > 0:
            candidates.append((ads_n, "err_nr_ads"))
        if require_price and price_n < total * 0.4:
            candidates.append((total - price_n, "err_nr_price"))

        if not candidates:
            return self.tr("err_nr_generic")
        candidates.sort(key=lambda c: c[0], reverse=True)
        return self.tr(candidates[0][1])

    # ── кэш выдачи ──────────────────────────────────────────────

    def _cache_key(self, page_url):
        return page_url

    def _cache_get(self, key):
        ttl = self._int("cache_min", R_CACHE[0], R_CACHE[1], R_CACHE[3]) * 60
        if ttl <= 0:
            return None
        with self._cache_lock:
            entry = self._cache.get(key)
        if not entry:
            return None
        ts, items = entry
        if time.time() - ts > ttl:
            with self._cache_lock:
                self._cache.pop(key, None)
            return None
        return list(items)

    def _cache_put(self, key, items):
        if self._int("cache_min", R_CACHE[0], R_CACHE[1], R_CACHE[3]) <= 0:
            return
        # лёгкие копии только нужных полей — без ссылок на сырой JSON
        light = []
        for it in items:
            light.append({
                "id": it.get("id"),
                "slug": it.get("slug"),
                "title": it.get("title"),
                "title_from_slug": it.get("title_from_slug"),
                "price": it.get("price"),
                "old_price": it.get("old_price"),
                "rating": it.get("rating"),
                "reviews": it.get("reviews"),
                "is_ad": it.get("is_ad"),
                "image": it.get("image"),
            })
        with self._cache_lock:
            self._cache[key] = (time.time(), light)
            if len(self._cache) > CACHE_MAX:
                oldest = sorted(self._cache.items(), key=lambda kv: kv[1][0])
                for k, _ in oldest[:len(self._cache) - CACHE_MAX]:
                    self._cache.pop(k, None)

    # ── основной поиск ──────────────────────────────────────────

    def _run_search(self, peer, raw_arg):
        if peer is None:
            return
        cmd = self._str("cmd_search", DEFAULT_CMD) or DEFAULT_CMD
        if not raw_arg:
            self._ui(lambda: self._send(peer, self.tr("usage").format(cmd=cmd)))
            return

        parsed = parse_query(raw_arg)
        if not parsed.text:
            self._ui(lambda: self._send(peer, self.tr("usage").format(cmd=cmd)))
            return

        if not self._alive:
            return
        self._status("searching")

        timeout = self._timeout()
        tries = self._int("net_tries", R_TRIES[0], R_TRIES[1], R_TRIES[3])
        pages = self._int("pages_n", R_PAGES[0], R_PAGES[1], R_PAGES[3])
        want = self._int("count_n", R_COUNT[0], R_COUNT[1], R_COUNT[3])
        default_sort = SORT_VALUES[self._int("sort_default", 0, len(SORT_VALUES) - 1, 0)]
        extra = self._str("extra_params")
        ua = self._ua()
        cookie = self._str("cookie")

        first_url = build_page_url(parsed, 1, default_sort, extra)
        search_link = OZON_BASE + first_url

        if self._bool("warm_up", True):
            self._session.warm_up(ua, cookie, timeout)

        raw_items = []
        seen = set()
        blocked_err = None
        net_err = None

        for page in range(1, pages + 1):
            if not self._alive:
                return
            page_url = build_page_url(parsed, page, default_sort, extra)
            key = self._cache_key(page_url)
            cached = self._cache_get(key)
            if cached is not None:
                page_items = cached
                self._plog("страница {} из кэша ({} товаров)".format(page, len(page_items)))
            else:
                try:
                    data, strategy = self._session.fetch_page(page_url, ua, cookie,
                                                              timeout, tries)
                except OzonBlocked as e:
                    blocked_err = e
                    self._plog("страница {}: антибот · {}".format(page, e), level="ERROR")
                    break
                except OzonUnavailable as e:
                    net_err = e
                    self._plog("страница {}: сеть · {}".format(page, e), level="ERROR")
                    break
                except Exception as e:
                    net_err = e
                    self._plog("страница {}: {}\n{}".format(page, e, traceback.format_exc()),
                               level="ERROR")
                    break
                try:
                    page_items = extract_products(data)
                except Exception as e:
                    self._plog("разбор страницы {} упал: {}\n{}".format(
                        page, e, traceback.format_exc()), level="ERROR")
                    page_items = []
                finally:
                    # JSON/HTML больше не нужны — отпускаем сразу, не ждём GC
                    try:
                        del data
                    except Exception:
                        pass
                self._plog("страница {}: стратегия {}, товаров {}".format(
                    page, strategy, len(page_items)))
                if page_items:
                    self._cache_put(key, page_items)

            if not page_items:
                break
            for it in page_items:
                if it["id"] in seen:
                    continue
                seen.add(it["id"])
                raw_items.append(it)
            # page_items больше не нужен после слияния
            page_items = None
            if len(self._filter_items(raw_items, parsed)) >= want:
                break

        if not self._alive:
            return

        if not raw_items and (blocked_err or net_err):
            link = self.tr("err_open").format(search_link) \
                if self._bool("send_link_on_error", True) else None
            err = blocked_err or net_err
            self._report_error(peer, self._smart_error_text(err), link)
            return

        filtered = self._filter_items(raw_items, parsed)
        filtered = self._sort_items(filtered)
        total_matched = len(filtered)
        shown = filtered[:want]

        if not shown:
            msg = "{}\n{}".format(self.tr("not_found").format(parsed.text),
                                  self._diagnose_no_results(raw_items, parsed))
            if self._bool("send_all_link_on_empty", True) and self._bool("show_all_link", True):
                msg += "\n{}".format(self.tr("all_link").format(search_link))
            # отпускаем списки до отправки
            raw_items = filtered = shown = None
            seen = None
            self._ui(lambda: self._send(peer, msg))
            return

        try:
            self._deliver_results(peer, parsed, shown, search_link,
                                  total_matched, want)
        finally:
            raw_items = filtered = shown = None
            seen = None

    def _filter_items(self, items, parsed):
        min_rating = parsed.min_rating
        if min_rating is None:
            x10 = self._int("min_rating_x10", R_RATE[0], R_RATE[1], R_RATE[3])
            min_rating = (x10 / 10.0) if x10 else None
        min_reviews = parsed.min_reviews
        if min_reviews is None:
            n = self._int("min_reviews_n", R_REVIEWS[0], R_REVIEWS[1], R_REVIEWS[3])
            min_reviews = n or None

        hide_ads = self._bool("hide_ads", True)
        require_price = self._bool("require_price", True)

        out = []
        for it in items:
            if hide_ads and it.get("is_ad"):
                continue
            price = it.get("price")
            if require_price and not price:
                continue
            if price:
                if parsed.price_min and price < parsed.price_min:
                    continue
                if parsed.price_max and price > parsed.price_max:
                    continue
            if min_rating:
                r = it.get("rating")
                if not r or r < min_rating - 1e-9:
                    continue
            if min_reviews:
                rv = it.get("reviews") or 0
                if rv < min_reviews:
                    continue
            if not it.get("title"):
                continue
            out.append(it)
        return out

    def _sort_items(self, items):
        mode = self._int("local_sort", 0, 4, 0)
        if mode == 0:
            return items
        items = list(items)
        if mode == 1:
            items.sort(key=lambda i: i.get("price") or 10 ** 12)
        elif mode == 2:
            items.sort(key=lambda i: i.get("price") or 0, reverse=True)
        elif mode == 3:
            items.sort(key=lambda i: (i.get("rating") or 0, i.get("reviews") or 0),
                       reverse=True)
        elif mode == 4:
            items.sort(key=lambda i: i.get("reviews") or 0, reverse=True)
        return items

    # ── форматирование ──────────────────────────────────────────

    def _emoji(self, s):
        return s if self._bool("use_emoji", True) else ""

    def _reviews_word(self, n):
        lang = self._lang()
        if lang == "en":
            return self.tr("reviews_one") if n == 1 else self.tr("reviews_many")
        # ru — Slavic plural rules
        return _plural_ru(n, self.tr("reviews_one"), self.tr("reviews_few"),
                          self.tr("reviews_many"))

    def _cut_title(self, title):
        maxlen = self._int("title_len", R_TITLE[0], R_TITLE[1], R_TITLE[3])
        t = re.sub(r"\s+", " ", title or "").strip()
        if len(t) <= maxlen:
            return t
        cut = t[:maxlen].rsplit(" ", 1)[0].rstrip(" ,.;:-")
        return (cut or t[:maxlen]) + "…"

    def _item_link(self, item):
        style = self._int("link_style", 0, 2, 0)
        short = "{}/product/{}/".format(OZON_BASE, item.get("id"))
        full = "{}/product/{}/".format(OZON_BASE, item.get("slug") or item.get("id"))
        if style == 1:
            return "[{}]({})".format(self.tr("link_word"), short)
        if style == 2:
            return full
        return short

    def _filters_suffix(self, parsed):
        bits = []
        if parsed.price_min and parsed.price_max:
            bits.append(self.tr("f_range").format(_fmt_money(parsed.price_min),
                                                  _fmt_money(parsed.price_max)))
        elif parsed.price_max:
            bits.append(self.tr("f_to").format(_fmt_money(parsed.price_max)))
        elif parsed.price_min:
            bits.append(self.tr("f_from").format(_fmt_money(parsed.price_min)))
        if parsed.min_rating:
            bits.append(self.tr("f_rating").format(
                ("%g" % parsed.min_rating)))
        if parsed.min_reviews:
            bits.append(self.tr("f_reviews").format(parsed.min_reviews))
        if parsed.sort_label_key:
            bits.append(self.tr(parsed.sort_label_key))
        if not bits:
            return ""
        return " ({})".format(", ".join(bits))

    def _format_results(self, parsed, items, search_link, total_matched=None, want=None):
        sep = self._sep()
        head = self.tr("head").format(parsed.text, self._filters_suffix(parsed))

        show_pos = self._bool("show_position", True)
        show_old = self._bool("show_old_price", True)
        show_disc = self._bool("show_discount", True)
        show_rating = self._bool("show_rating", True)
        show_reviews = self._bool("show_reviews", True)
        mark_ads = self._bool("mark_ads", True) and not self._bool("hide_ads", True)

        blocks = []
        for i, it in enumerate(items, 1):
            lines = []
            prefix = "{}. ".format(i) if show_pos else ""
            lines.append(prefix + self._cut_title(it.get("title")))

            meta = []
            price = it.get("price")
            if price:
                money = _fmt_money(price)
                old = it.get("old_price")
                if old and show_old:
                    extra = self.tr("was").format(_fmt_money(old))
                    if show_disc:
                        try:
                            pct = int(round((1.0 - float(price) / float(old)) * 100))
                        except (TypeError, ValueError, ZeroDivisionError):
                            pct = 0
                        if pct > 0:
                            extra += ", −{}%".format(pct)
                    money += " ({})".format(extra)
                meta.append("{}{}".format(self._emoji("💰 "), money))

            rating = it.get("rating")
            reviews = it.get("reviews")
            if show_rating and rating:
                part = "{}{:g}".format(self._emoji("★ "), rating)
                if show_reviews and reviews:
                    part += " ({} {})".format(reviews, self._reviews_word(reviews))
                meta.append(part)
            elif show_reviews and reviews:
                meta.append("{} {}".format(reviews, self._reviews_word(reviews)))

            if mark_ads and it.get("is_ad"):
                meta.append("({})".format(self.tr("ad")))

            if meta:
                lines.append(" | ".join(meta))
            lines.append("{}{}".format(self._emoji("🔗 "), self._item_link(it)))
            blocks.append("\n".join(lines))

        joiner = "\n{}\n".format(sep) if sep else "\n\n"
        text = head + "\n\n" + joiner.join(blocks)

        if total_matched is not None and want and total_matched < want:
            text += "\n\n" + self.tr("shown_fewer").format(total_matched, want)
        if self._bool("show_all_link", True):
            text += "\n\n" + self.tr("all_link").format(search_link)
        return text

    # ── настройки: главная ──────────────────────────────────────

    def _preview_click(self, view):
        parsed = ParsedQuery()
        parsed.text = "Pixel 9a синий"
        parsed.price_max = 30000
        link = OZON_BASE + build_page_url(parsed, 1, None, "")
        want = self._int("count_n", R_COUNT[0], R_COUNT[1], R_COUNT[3])
        items = self._sort_items(self._filter_items(SAMPLE_ITEMS, parsed))[:want]
        if not items:
            items = SAMPLE_ITEMS[:want]
        body = self._format_results(parsed, items, link)
        self._show_text_dialog(self.tr("s_preview_title"), body)

    def create_settings(self) -> List[Any]:
        return [
            self._it(Header, text=self.tr("s_title")),
            self._it(Text, text=self.tr("s_preview"), subtext=self.tr("s_preview_sub"),
                     icon="msg_view_file", on_click=self._preview_click),
            self._it(Divider),

            self._it(Header, text=self.tr("s_cmds")),
            self._it(Input, key="cmd_search", text=self.tr("s_cmd"),
                     default=DEFAULT_CMD, subtext=self.tr("s_cmd_sub"), icon="msg_message"),
            *self._sel("lang", self.tr("s_lang"), ["Русский", "English"], 0,
                       icon="msg_translate"),
            self._hint(self.tr("s_cmds_hint")),

            self._it(Header, text=self.tr("s_sections")),
            self._it(Text, text=self.tr("s_out_p"), subtext=self.tr("s_out_p_s"),
                     icon="msg_list",
                     create_sub_fragment=lambda: self._safe_page(self._page_output)),
            self._it(Text, text=self.tr("s_filters_p"), subtext=self.tr("s_filters_p_s"),
                     icon="msg_search",
                     create_sub_fragment=lambda: self._safe_page(self._page_filters)),
            self._it(Text, text=self.tr("s_net_p"), subtext=self.tr("s_net_p_s"),
                     icon="msg_language",
                     create_sub_fragment=lambda: self._safe_page(self._page_net)),
            self._it(Text, text=self.tr("s_notify_p"), subtext=self.tr("s_notify_p_s"),
                     icon="msg_notifications",
                     create_sub_fragment=lambda: self._safe_page(self._page_notify)),
            self._it(Divider),
            self._it(Text, text=self.tr("s_help_p"), subtext=self.tr("s_help_p_s"),
                     icon="msg_help",
                     create_sub_fragment=lambda: self._safe_page(self._page_help)),
            self._it(Text, text=self.tr("s_about_p"), subtext=self.tr("s_about_p_s"),
                     icon="msg_info",
                     create_sub_fragment=lambda: self._safe_page(self._page_about)),
            self._it(Text, text=self.tr("s_dev_p"), subtext=self.tr("s_dev_p_s"),
                     icon="msg_bug",
                     create_sub_fragment=lambda: self._safe_page(self._page_dev)),
        ]

    # ── настройки: страницы ─────────────────────────────────────

    def _page_output(self) -> List[Any]:
        return [
            self._it(Header, text=self.tr("s_out_head")),
            self._it(Text, text=self.tr("s_preview"), subtext=self.tr("s_preview_sub"),
                     icon="msg_view_file", on_click=self._preview_click),
            self._it(Divider),

            *self._slider("count_n", self.tr("s_count"), R_COUNT, icon="msg_list"),
            *self._slider("title_len", self.tr("s_title_len"), R_TITLE,
                          unit=self.tr("s_unit_chars"), hint=self.tr("s_title_hint")),
            self._it(Switch, key="show_position", text=self.tr("s_show_position"),
                     default=True, icon="msg_pin"),

            self._it(Header, text=self.tr("s_price_head")),
            self._it(Switch, key="show_old_price", text=self.tr("s_show_old"),
                     default=True, icon="msg_payment_discount"),
            self._it(Switch, key="show_discount", text=self.tr("s_show_discount"),
                     default=True),

            self._it(Header, text=self.tr("s_rating_head")),
            self._it(Switch, key="show_rating", text=self.tr("s_show_rating"),
                     default=True, icon="msg_favs"),
            self._it(Switch, key="show_reviews", text=self.tr("s_show_reviews"),
                     default=True),

            self._it(Header, text=self.tr("s_links_head")),
            *self._sel("link_style", self.tr("s_link_style"),
                       ["ozon.ru/product/ID", "ссылка (markdown)", "полная со слагом"], 0,
                       subtext=self.tr("s_link_style_hint"), icon="msg_link"),
            self._it(Switch, key="show_all_link", text=self.tr("s_all_link"),
                     default=True, icon="msg_shareout"),

            self._it(Header, text=self.tr("s_look_head")),
            self._it(Switch, key="use_emoji", text=self.tr("s_use_emoji"),
                     subtext=self.tr("s_use_emoji_sub"), default=True,
                     icon="msg_emoji_smiles"),
            self._it(Switch, key="show_photos", text=self.tr("s_photos"),
                     subtext=self.tr("s_photos_sub"), default=True,
                     icon="msg_photo"),
            self._it(Switch, key="photos_text_too", text=self.tr("s_photos_text_too"),
                     subtext=self.tr("s_photos_text_too_sub"), default=False,
                     icon="msg_list"),
            *self._sel("sep_style", self.tr("s_sep"),
                       ["━━━━━", "┅┅┅┅┅", "═════", "• • •", "— нет —"],
                       DEFAULTS["sep_style"], subtext=self.tr("s_sep_hint")),
        ]

    def _page_filters(self) -> List[Any]:
        cmd = self._str("cmd_search", DEFAULT_CMD) or DEFAULT_CMD
        sort_items = [self.tr("sort_relevance"), self.tr("sort_cheap"),
                      self.tr("sort_expensive"), self.tr("sort_new"),
                      self.tr("sort_rating"), self.tr("sort_discount")]
        local_items = [self.tr("sort_relevance"), self.tr("sort_cheap"),
                       self.tr("sort_expensive"), self.tr("sort_rating"),
                       "≡ " + self.tr("reviews_many")]
        return [
            self._it(Header, text=self.tr("s_filters_head")),
            *self._sel("sort_default", self.tr("s_sort_default"), sort_items, 0,
                       subtext=self.tr("s_sort_default_sub"), icon="msg_sort"),
            *self._sel("local_sort", self.tr("s_local_sort"), local_items, 0,
                       subtext=self.tr("s_local_sort_sub")),
            *self._slider("pages_n", self.tr("s_pages"), R_PAGES,
                          hint=self.tr("s_pages_hint")),

            self._it(Header, text=self.tr("s_quality_head")),
            *self._slider("min_rating_x10", self.tr("s_min_rating"), R_RATE,
                          icon="msg_favs",
                          fmt=lambda v: self.tr("s_min_rating_any") if v == 0
                          else "{:.1f}+".format(v / 10.0)),
            *self._slider("min_reviews_n", self.tr("s_min_reviews"), R_REVIEWS,
                          fmt=lambda v: self.tr("s_min_reviews_any") if v == 0
                          else "{}+{}".format(v, self.tr("s_unit_reviews"))),
            self._it(Switch, key="hide_ads", text=self.tr("s_hide_ads"),
                     subtext=self.tr("s_hide_ads_sub"), default=True, icon="msg_block"),
            self._it(Switch, key="mark_ads", text=self.tr("s_mark_ads"), default=True),
            self._it(Switch, key="require_price", text=self.tr("s_require_price"),
                     default=True),

            self._it(Header, text=self.tr("s_cheat")),
            self._hint(self.tr("s_cheat_text").format(cmd=cmd)),
        ]

    def _page_net(self) -> List[Any]:
        with self._cache_lock:
            cached = len(self._cache)
        return [
            self._it(Header, text=self.tr("s_net_head")),
            *self._slider("net_timeout", self.tr("s_timeout"), R_TIMEOUT,
                          unit=self.tr("s_unit_sec")),
            *self._slider("net_tries", self.tr("s_tries"), R_TRIES),
            *self._slider("cache_min", self.tr("s_cache"), R_CACHE,
                          unit=self.tr("s_unit_min"), hint=self.tr("s_cache_hint")),
            self._it(Text, text=self.tr("s_cache_clear"),
                     subtext=self.tr("s_cache_clear_sub").format(cached),
                     icon="msg_delete", red=True, on_click=self._clear_cache_click),

            self._it(Header, text=self.tr("s_access_head")),
            self._it(Switch, key="warm_up", text=self.tr("s_warm_up"),
                     subtext=self.tr("s_warm_up_sub"), default=True, icon="msg_online"),
            *self._sel("ua_mode", self.tr("s_ua"),
                       ["Android (мобильный)", "Desktop Chrome", "Свой"], 0,
                       subtext=self.tr("s_ua_hint"), icon="msg_devices"),
            self._it(Input, key="ua_custom", text=self.tr("s_ua_custom"), default=""),
            self._it(Input, key="cookie", text=self.tr("s_cookie"), default="",
                     subtext=self.tr("s_cookie_sub"), icon="msg_pin_code"),
            self._hint(self.tr("s_cookie_hint")),
            self._it(Input, key="extra_params", text=self.tr("s_extra"), default="",
                     subtext=self.tr("s_extra_sub"), icon="msg_settings"),
            self._it(Text, text=self.tr("s_session_reset"),
                     subtext=self.tr("s_session_reset_sub"),
                     icon="msg_reset", red=True, on_click=self._reset_session_click),
        ]

    def _page_notify(self) -> List[Any]:
        return [
            self._it(Header, text=self.tr("s_notify_head")),
            self._it(Switch, key="notify_searching", text=self.tr("s_notify_searching"),
                     subtext=self.tr("s_notify_searching_sub"), default=False,
                     icon="msg_search"),
            self._it(Switch, key="notify_errors_bulletin",
                     text=self.tr("s_notify_errors_bulletin"),
                     subtext=self.tr("s_notify_errors_bulletin_sub"), default=False,
                     icon="msg_error"),
            self._it(Switch, key="send_link_on_error",
                     text=self.tr("s_send_link_on_error"),
                     subtext=self.tr("s_send_link_on_error_sub"), default=True,
                     icon="msg_link"),
        ]

    def _page_help(self) -> List[Any]:
        lang = self._lang()
        sections = HELP_SECTIONS.get(lang) or HELP_SECTIONS["ru"]
        items = [self._it(Header, text=self.tr("s_help_p"))]
        items.append(self._hint(
            "Нажми на термин — откроется полное окно с пояснением"
            if lang == "ru" else
            "Tap a term to open the full explanation"))
        for title, terms in sections:
            items.append(self._it(Header, text=title))
            for term, explanation in terms:
                # замыкание по умолчанию, чтобы term/explanation не «уплыли»
                items.append(self._it(
                    Text,
                    text=term,
                    subtext=(explanation[:120] + "…") if len(explanation) > 120 else explanation,
                    icon="msg_info",
                    on_click=lambda view, t=term, e=explanation: self._show_text_dialog(t, e),
                ))
        return items

    def _page_about(self) -> List[Any]:
        return [
            self._it(Header, text="OzonSearch v{}".format(__version__)),
            self._it(Text, text=self.tr("s_about_version"), icon="msg_info",
                     on_click=lambda view: self._show_text_dialog(
                         self.tr("s_about_version"),
                         self.tr("s_about_version_body").format(
                             __version__, SDK_INFO, __min_version__))),
            self._it(Text, text=self.tr("s_about_source"), icon="msg_channel",
                     on_click=lambda view: self._show_text_dialog(
                         self.tr("s_about_source"), self.tr("s_about_source_body"))),
        ]

    # ── клики ───────────────────────────────────────────────────

    def _clear_cache_click(self, view):
        with self._cache_lock:
            self._cache.clear()
        self._plog("кэш выдачи очищен")
        self._ui(lambda: BulletinHelper.show_success(
            self.tr("s_cache_cleared"), get_last_fragment()))

    def _reset_session_click(self, view):
        self._session.reset()
        self._ui(lambda: BulletinHelper.show_success(
            self.tr("s_session_reset_ok"), get_last_fragment()))

    def _ping_click(self, view):
        def task():
            parsed = ParsedQuery()
            parsed.text = "iphone"
            page_url = build_page_url(parsed, 1, None, "")
            ua, cookie = self._ua(), self._str("cookie")
            timeout = self._timeout()
            if self._bool("warm_up", True):
                self._session.warm_up(ua, cookie, timeout)
            t0 = time.time()
            try:
                data, strategy = self._session.fetch_page(
                    page_url, ua, cookie, timeout,
                    self._int("net_tries", R_TRIES[0], R_TRIES[1], R_TRIES[3]))
                ms = int((time.time() - t0) * 1000)
                count = len(extract_products(data))
                try:
                    del data
                except Exception:
                    pass
                self._plog("ping ok: {} мс, {}, товаров {}".format(ms, strategy, count))
                self._ui(lambda: BulletinHelper.show_success(
                    self.tr("s_dev_ping_ok").format(ms, strategy, count),
                    get_last_fragment()))
            except OzonBlocked as e:
                self._plog("ping blocked: {}".format(e), level="ERROR")
                self._ui(lambda: BulletinHelper.show_error(
                    self.tr("s_dev_ping_blocked"), get_last_fragment()))
            except Exception as e:
                self._plog("ping fail: {}\n{}".format(e, traceback.format_exc()),
                           level="ERROR")
                self._ui(lambda: BulletinHelper.show_error(
                    self.tr("s_dev_ping_fail"), get_last_fragment()))
        self._spawn(task)

    def _raw_click(self, view):
        raw = self._session.last_raw
        if not raw:
            self._ui(lambda: BulletinHelper.show_info(
                self.tr("s_dev_raw_empty"), get_last_fragment()))
            return
        head = "strategy: {} · status: {} · {} chars\n{}\n".format(
            self._session.last_strategy or "?", self._session.last_status or "?",
            len(raw), "-" * 30)
        self._show_text_dialog(self.tr("s_dev_raw"), head + raw)

    def _reset_click(self, view):
        def do_reset():
            errors = 0
            for key, value in DEFAULTS.items():
                try:
                    self.set_setting(key, value)
                except Exception:
                    errors += 1
            self._plog("settings reset, failed keys: {}".format(errors),
                       level="WARN" if errors else "INFO")
            self._ui(lambda: BulletinHelper.show_success(
                self.tr("s_dev_reset_ok"), get_last_fragment()))
        self._confirm(self.tr("s_dev_reset_q"), self.tr("s_dev_reset_yes"), do_reset)

    # ── для разработчиков ──────────────────────────────────────

    def _snapshot(self, only_errors=False):
        with self._log_lock:
            if only_errors:
                return [e for e in self._log_buffer if e.get("level") == "ERROR"]
            return list(self._log_buffer)

    def _logs_as_text(self, entries):
        if not entries:
            return self.tr("s_dev_empty")
        head = "OzonSearch v{} · SDK {} · min {} · {}\nstrategy: {} · status: {}\n{} entries\n{}\n".format(
            __version__, SDK_INFO, __min_version__, time.strftime("%Y-%m-%d %H:%M:%S"),
            self._session.last_strategy or "-", self._session.last_status or "-",
            len(entries), "-" * 30)
        body = []
        for e in entries:
            when = time.strftime("%H:%M:%S", time.localtime(e.get("ts", 0)))
            body.append("[{}] {}: {}".format(when, e.get("level", "INFO"), e.get("msg", "")))
        return head + "\n\n".join(body)

    def _entry_as_text(self, entry):
        when = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(entry.get("ts", 0)))
        return "[{}] {}\n\n{}".format(when, entry.get("level", "INFO"), entry.get("msg", ""))

    def _log_rows(self, entries):
        if not entries:
            return [self._it(Text, text=self.tr("s_dev_empty"), icon="msg_info")]
        rows = [self._hint(self.tr("s_dev_tap_hint"))]
        shown = list(reversed(entries))[:MAX_LOG_SHOWN]   # новые сверху
        for entry in shown:
            when = time.strftime("%H:%M:%S", time.localtime(entry.get("ts", 0)))
            msg = entry.get("msg", "")
            is_err = entry.get("level") == "ERROR"
            head, _, rest = msg.partition("\n")
            rows.append(self._it(
                Text,
                text="{}  {}".format(when, head)[:120],
                subtext=(rest[:400] if rest else None),
                icon="msg_error" if is_err else "msg_message",
                red=is_err,
                on_click=lambda view, e=entry: self._open_entry(e),
            ))
        if len(entries) > MAX_LOG_SHOWN:
            rows.append(self._hint(self.tr("s_dev_more").format(len(entries) - MAX_LOG_SHOWN)))
        return rows

    def _open_entry(self, entry):
        self._show_text_dialog(self.tr("s_dev_entry"), self._entry_as_text(entry))

    def _page_dev(self) -> List[Any]:
        total = len(self._snapshot())
        errors = len(self._snapshot(only_errors=True))
        ui_mode = self.tr("s_dev_ui_slider") if (SLIDER_CLS is not None and self._slider_ok) \
            else self.tr("s_dev_ui_input")
        return [
            self._it(Header, text=self.tr("s_dev_header")),
            self._it(Text, text=self.tr("s_dev_info"),
                     subtext="OzonSearch v{} · SDK {} · min {}".format(
                         __version__, SDK_INFO, __min_version__),
                     icon="msg_info"),
            self._it(Text, text=self.tr("s_dev_ui_mode"), subtext=ui_mode,
                     icon="msg_photo_settings"),
            self._it(Text, text=self.tr("s_dev_last"),
                     subtext=self.tr("s_dev_last_sub").format(
                         self._session.last_strategy or "-",
                         self._session.last_status or "-"),
                     icon="msg_stats"),
            self._it(Text, text=self.tr("err_code_label").format(
                         self._last_error_code or "—"),
                     subtext=self.tr("s_dev_last_sub").format(
                         self._session.last_strategy or "-", self._session.last_status or "-"),
                     icon="msg_error" if self._last_error_code else "msg_stats",
                     red=bool(self._last_error_code)),
            self._it(Text, text=self.tr("s_dev_ping"), subtext=self.tr("s_dev_ping_sub"),
                     icon="msg_language", on_click=self._ping_click),
            self._it(Text, text=self.tr("s_dev_raw"),
                     subtext=self.tr("s_dev_raw_sub").format(len(self._session.last_raw)),
                     icon="msg_view_file", on_click=self._raw_click),
            self._it(Divider),

            self._it(Text, text=self.tr("s_dev_logs"),
                     subtext=self.tr("s_dev_logs_sub").format(total), icon="msg_folder",
                     create_sub_fragment=lambda: self._safe_page(self._page_dev_logs)),
            self._it(Text, text=self.tr("s_dev_errors"),
                     subtext=self.tr("s_dev_errors_sub").format(errors),
                     icon="msg_error", red=errors > 0,
                     create_sub_fragment=lambda: self._safe_page(self._page_dev_errors)),
            self._it(Divider),

            self._it(Text, text=self.tr("s_dev_open_full"),
                     subtext=self.tr("s_dev_open_full_sub"), icon="msg_viewintopic",
                     on_click=lambda view: self._show_text_dialog(
                         self.tr("s_dev_logs"), self._logs_as_text(self._snapshot()))),
            self._it(Text, text=self.tr("s_dev_copy_all"),
                     subtext=self.tr("s_dev_copy_all_sub"), icon="msg_copy",
                     on_click=lambda view: self._copy_and_notify(
                         self._logs_as_text(self._snapshot()))),
            self._it(Text, text=self.tr("s_dev_copy_err"), icon="msg_copy",
                     on_click=lambda view: self._copy_and_notify(
                         self._logs_as_text(self._snapshot(only_errors=True)))),
            self._it(Text, text=self.tr("s_dev_full_page"),
                     subtext=self.tr("s_dev_full_page_sub"), icon="msg_list",
                     create_sub_fragment=lambda: self._safe_page(self._page_dev_full)),
            self._it(Divider),

            self._it(Text, text=self.tr("s_dev_clear"), icon="msg_delete", red=True,
                     on_click=self._clear_logs_click),
            self._it(Text, text=self.tr("s_dev_reset"), subtext=self.tr("s_dev_reset_sub"),
                     icon="msg_reset", red=True, on_click=self._reset_click),
        ]

    def _dev_actions(self, only_errors=False):
        def text():
            return self._logs_as_text(self._snapshot(only_errors=only_errors))
        title = self.tr("s_dev_errors") if only_errors else self.tr("s_dev_logs")
        return [
            self._it(Text, text=self.tr("s_dev_open_full"), icon="msg_viewintopic",
                     on_click=lambda view: self._show_text_dialog(title, text())),
            self._it(Text, text=self.tr("s_dev_copy_all"), icon="msg_copy",
                     on_click=lambda view: self._copy_and_notify(text())),
            self._it(Divider),
        ]

    def _page_dev_logs(self) -> List[Any]:
        return ([self._it(Header, text=self.tr("s_dev_logs"))]
                + self._dev_actions(False) + self._log_rows(self._snapshot()))

    def _page_dev_errors(self) -> List[Any]:
        return ([self._it(Header, text=self.tr("s_dev_errors"))]
                + self._dev_actions(True) + self._log_rows(self._snapshot(only_errors=True)))

    def _page_dev_full(self) -> List[Any]:
        full = self._logs_as_text(self._snapshot())
        items = [
            self._it(Header, text=self.tr("s_dev_full_page")),
            self._it(Text, text=self.tr("s_dev_copy_all"), icon="msg_copy",
                     on_click=lambda view: self._copy_and_notify(full)),
            self._it(Divider),
        ]
        for chunk in self._chunk_text(full, LOG_CHUNK):
            items.append(self._hint(chunk))
        return items

    @staticmethod
    def _chunk_text(text, size):
        chunks, buf = [], []
        cur = 0
        for line in text.split("\n"):
            if cur + len(line) + 1 > size and buf:
                chunks.append("\n".join(buf))
                buf, cur = [], 0
            while len(line) > size:
                chunks.append(line[:size])
                line = line[size:]
            buf.append(line)
            cur += len(line) + 1
        if buf:
            chunks.append("\n".join(buf))
        return chunks or [""]

    def _clear_logs_click(self, view):
        try:
            with self._log_lock:
                self._log_buffer.clear()
            self._kw_warned.clear()
            self._ui(lambda: BulletinHelper.show_success(
                self.tr("s_dev_cleared"), get_last_fragment()))
        finally:
            del view