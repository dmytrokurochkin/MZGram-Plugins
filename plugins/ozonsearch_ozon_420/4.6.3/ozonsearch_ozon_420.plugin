def _item_allowed(cls):
    """set имён kwargs, которые принимает конструктор элемента настроек,
    или None если определить не удалось. Состав полей у Switch/Text/
    Selector/Slider различается между версиями SDK — один лишний kwarg
    рушит всю страницу настроек с TypeError."""
    cached = _ITEM_KW_CACHE.get(cls)
    if cached is not None:
        return None if cached == _ANY else cached

    names = set()
    fields = getattr(cls, "__dataclass_fields__", None)
    if isinstance(fields, dict):
        names.update(fields.keys())

    var_kw = False
    try:
        sig = inspect.signature(cls.__init__)
        for name, p in sig.parameters.items():
            if name == "self":
                continue
            if p.kind in (p.VAR_KEYWORD, p.VAR_POSITIONAL):
                var_kw = True
                continue
            names.add(name)
    except Exception:
        pass

    if not names or (var_kw and not fields):
        _ITEM_KW_CACHE[cls] = _ANY
        return None
    _ITEM_KW_CACHE[cls] = names
    return names

# ── сеть: низкий уровень ───────────────────────────────────────────

class OzonError(Exception):
    """Базовая ошибка. code — короткий машинный код причины (см. ERROR_CODES),
    http_status — код ответа, если он был. Оба поля используются для
    построения «умного» сообщения пользователю (конкретная причина +
    конкретные варианты решения), а не общего «что-то пошло не так»."""
    def __init__(self, message, code="unknown", http_status=None):
        super().__init__(message)
        self.code = code
        self.http_status = http_status

class OzonBlocked(OzonError):
    """антибот / 403 / 429 / отдали HTML-заглушку вместо данных"""

class OzonUnavailable(OzonError):
    """сеть, таймаут, 5xx, битый ответ"""

# машинные коды причин — показываются пользователю как "Код: OZS-xxx",
# чтобы при обращении в @ccsFM сразу было понятно, что искать в логах
ERROR_CODES = {
    "blocked_403": "OZS-403", "blocked_429": "OZS-429", "captcha": "OZS-CAPTCHA",
    "timeout": "OZS-TIMEOUT", "dns": "OZS-DNS", "ssl": "OZS-SSL", "conn": "OZS-CONN",
    "empty": "OZS-EMPTY", "badjson": "OZS-JSON", "nodata": "OZS-NODATA",
    "http": "OZS-HTTP", "unknown": "OZS-UNKNOWN",
}

def _classify_reason(reason):
    """По исключению/reason из urllib определяет код причины: timeout,
    dns (не резолвится домен), conn (сброс/отказ соединения), ssl,
    иначе unknown. Нужно, чтобы пользователь видел конкретную причину,
    а не общее «нет соединения»."""
    if isinstance(reason, (socket.timeout, TimeoutError)):
        return "timeout"
    if isinstance(reason, socket.gaierror):
        return "dns"
    if isinstance(reason, ssl.SSLError):
        return "ssl"
    if isinstance(reason, (ConnectionResetError, ConnectionRefusedError,
                           ConnectionAbortedError, BrokenPipeError)):
        return "conn"
    msg = str(reason).lower()
    if "timed out" in msg or "timeout" in msg:
        return "timeout"
    if "name or service not known" in msg or "nodename nor servname" in msg \
            or "getaddrinfo failed" in msg or "temporary failure in name resolution" in msg:
        return "dns"
    if "ssl" in msg or "certificate" in msg:
        return "ssl"
    if "refused" in msg or "reset" in msg or "aborted" in msg or "broken pipe" in msg:
        return "conn"
    return "unknown"

def _throttle():
    with _RATE_LOCK:
        now = time.time()
        wait = _MIN_INTERVAL - (now - _LAST_REQ_TS[0])
        if wait > 0:
            time.sleep(wait)
        _LAST_REQ_TS[0] = time.time()

def _read_text(resp, limit=None):
    """Читает ответ и сам разжимает gzip/deflate по магическим байтам.
    Заголовкам не доверяем: при частичном чтении (limit) поток обрезан,
    поэтому decompressobj — он терпит усечение и отдаёт что успел."""
    raw = resp.read(limit) if limit else resp.read()
    if not raw:
        return ""
    if raw[:2] == b"\x1f\x8b":
        try:
            raw = zlib.decompressobj(47).decompress(raw)
        except Exception:
            pass
    else:
        enc = ""
        try:
            enc = (resp.headers.get("Content-Encoding") or "").lower()
        except Exception:
            pass
        if "deflate" in enc:
            for wbits in (15, -15):
                try:
                    raw = zlib.decompressobj(wbits).decompress(raw)
                    break
                except Exception:
                    continue
    return raw.decode("utf-8", "replace")

DATA_STATE_ID_RE = re.compile(r'id="state-([^"]+)"[^>]*?data-state="(.*?)"', re.S)
DATA_STATE_RE = re.compile(r'data-state="(.*?)"', re.S)

def _states_from_html(html):
    """SSR-версия страницы Ozon хранит состояние виджетов в data-state="{...}".
    Приводим её к тому же виду, что и JSON API, чтобы извлекатель был один."""
    states = {}
    pairs = DATA_STATE_ID_RE.findall(html or "")
    if pairs:
        for key, raw in pairs:
            s = html_unescape(raw)
            if s.strip()[:1] not in "{[":
                continue
            try:
                states[key] = json.loads(s)
            except Exception:
                continue
    if not states:
        for i, raw in enumerate(DATA_STATE_RE.findall(html or "")):
            s = html_unescape(raw)
            if s.strip()[:1] not in "{[":
                continue
            try:
                states["html-{}".format(i)] = json.loads(s)
            except Exception:
                continue
    return {"widgetStates": states}

class OzonSession:
    """Одна долгая сессия: cookie-jar + прогрев главной страницы.
    Без cookie антибот отдаёт заглушку почти всегда, поэтому это не
    «красивость», а условие работоспособности."""

    def __init__(self, logger):
        self._log = logger
        self._lock = threading.Lock()
        self._opener = None
        self._warm_ts = 0.0
        self.last_raw = ""
        self.last_strategy = ""
        self.last_status = ""

    def reset(self):
        with self._lock:
            self._opener = None
            self._warm_ts = 0.0
        self.last_raw = ""
        self.last_strategy = ""
        self.last_status = ""
        self._log("сессия и cookie сброшены")

    def _get_opener(self):
        with self._lock:
            if self._opener is None:
                jar = http.cookiejar.CookieJar()
                self._opener = urllib.request.build_opener(
                    urllib.request.HTTPCookieProcessor(jar),
                    urllib.request.HTTPSHandler(context=SSL_CONTEXT),
                )
            return self._opener

    def _remember(self, text, strategy):
        # держим только усечённый срез — полный HTML/JSON не нужен после разбора
        self.last_raw = (text or "")[:RAW_LIMIT]
        self.last_strategy = strategy
        # явный сброс больших временных ссылок не требуется: text — локальная переменная

    @staticmethod
    def _base_headers(ua, cookie):
        h = {
            "User-Agent": ua,
            "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
            "Accept-Encoding": "gzip, deflate",
            "Connection": "keep-alive",
            "Cache-Control": "no-cache",
            "Pragma": "no-cache",
        }
        if cookie:
            h["Cookie"] = cookie
        return h

    def _api_headers(self, ua, cookie, page_url):
        h = self._base_headers(ua, cookie)
        h.update({
            "Accept": "application/json, text/plain, */*",
            "Referer": OZON_BASE + page_url,
            "Origin": OZON_BASE,
            "x-o3-app-name": "dweb_client",
            "x-o3-app-version": "release-2-0",
            "x-o3-page-type": "search",
            "x-requested-with": "XMLHttpRequest",
        })
        return h

    def _html_headers(self, ua, cookie):
        h = self._base_headers(ua, cookie)
        h.update({
            "Accept": ("text/html,application/xhtml+xml,application/xml;q=0.9,"
                       "image/avif,image/webp,*/*;q=0.8"),
            "Upgrade-Insecure-Requests": "1",
            "Referer": OZON_BASE + "/",
        })
        return h

    def _open(self, url, headers, timeout, limit=None):
        _throttle()
        req = urllib.request.Request(url, headers=headers)
        resp = None
        try:
            resp = self._get_opener().open(req, timeout=timeout)
            self.last_status = "HTTP {}".format(getattr(resp, "status", "?"))
            return _read_text(resp, limit)
        except urllib.error.HTTPError as e:
            body = ""
            try:
                body = _read_text(e, 4096)
            except Exception:
                pass
            self.last_status = "HTTP {}".format(e.code)
            snippet = body[:180].replace("\n", " ")
            if e.code == 429:
                raise OzonBlocked("HTTP 429 · {}".format(snippet), code="blocked_429",
                                  http_status=429)
            if e.code in (401, 403):
                raise OzonBlocked("HTTP {} · {}".format(e.code, snippet), code="blocked_403",
                                  http_status=e.code)
            if e.code == 503:
                raise OzonBlocked("HTTP 503 · {}".format(snippet), code="captcha",
                                  http_status=503)
            raise OzonUnavailable("HTTP {} · {}".format(e.code, snippet), code="http",
                                  http_status=e.code)
        except urllib.error.URLError as e:
            self.last_status = "URLError"
            reason = getattr(e, "reason", e)
            code = _classify_reason(reason)
            raise OzonUnavailable("URLError: {}".format(reason), code=code)
        except OzonError:
            raise
        except (TimeoutError, socket.timeout) as e:
            self.last_status = "Timeout"
            raise OzonUnavailable("{}: {}".format(type(e).__name__, e), code="timeout")
        except ssl.SSLError as e:
            self.last_status = "SSLError"
            raise OzonUnavailable("SSLError: {}".format(e), code="ssl")
        except Exception as e:
            self.last_status = type(e).__name__
            code = _classify_reason(e)
            raise OzonUnavailable("{}: {}".format(type(e).__name__, e), code=code)
        finally:
            if resp is not None:
                try:
                    resp.close()
                except Exception:
                    pass

    def warm_up(self, ua, cookie, timeout):
        if time.time() - self._warm_ts < WARM_TTL:
            return
        try:
            self._open(OZON_BASE + "/", self._html_headers(ua, cookie), timeout, limit=65536)
            self._warm_ts = time.time()
            self._log("прогрев сессии ok")
        except Exception as e:
            self._log("прогрев не удался: {}".format(e), level="WARN")

    def download_image(self, url, ua, cookie, timeout):
        """Скачивает картинку во временный файл. Возвращает путь или None.
        Вызывающий обязан удалить файл после отправки."""
        if not url or not url.startswith("http"):
            return None
        headers = self._base_headers(ua, cookie)
        headers.update({
            "Accept": "image/avif,image/webp,image/apng,image/*,*/*;q=0.8",
            "Referer": OZON_BASE + "/",
        })
        _throttle()
        req = urllib.request.Request(url, headers=headers)
        resp = None
        path = None
        try:
            resp = self._get_opener().open(req, timeout=timeout)
            raw = resp.read(IMG_MAX_BYTES + 1)
            if not raw or len(raw) > IMG_MAX_BYTES:
                return None
            # магические байты → расширение
            ext = ".jpg"
            if raw[:3] == b"\xff\xd8\xff":
                ext = ".jpg"
            elif raw[:8] == b"\x89PNG\r\n\x1a\n":
                ext = ".png"
            elif raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
                ext = ".webp"
            elif raw[:2] == b"\x1f\x8b":
                # gzip-обёртка — редко, но бывает
                try:
                    raw = zlib.decompressobj(47).decompress(raw)
                except Exception:
                    return None
            fd, path = tempfile.mkstemp(prefix="ozs_img_", suffix=ext)
            try:
                os.write(fd, raw)
            finally:
                os.close(fd)
            return path
        except Exception as e:
            self._log("download_image fail: {}".format(e), level="WARN")
            if path:
                try:
                    os.unlink(path)
                except Exception:
                    pass
            return None
        finally:
            if resp is not None:
                try:
                    resp.close()
                except Exception:
                    pass

    def fetch_page(self, page_url, ua, cookie, timeout, tries, allow_html=True):
        """Каскад стратегий. Возвращает (data, strategy_name).
        Бросает OzonBlocked/OzonUnavailable, если не сработало ничего."""
        blocked = 0
        last_err = None

        for name, base in API_ENDPOINTS:
            url = "{}?url={}".format(base, urllib.parse.quote(page_url, safe=""))
            for attempt in range(max(1, tries)):
                try:
                    text = self._open(url, self._api_headers(ua, cookie, page_url), timeout)
                except OzonBlocked as e:
                    last_err = e
                    blocked += 1
                    break
                except OzonUnavailable as e:
                    last_err = e
                    time.sleep(0.4 * (attempt + 1))
                    continue
                if not text.strip():
                    last_err = OzonUnavailable("пустой ответ", code="empty")
                    continue
                if text.lstrip()[:1] not in "{[":
                    # вместо JSON приехала HTML-заглушка антибота
                    self._remember(text, name + " (антибот)")
                    last_err = OzonBlocked("не JSON от {}".format(name), code="captcha")
                    blocked += 1
                    break
                try:
                    data = json.loads(text)
                except Exception as e:
                    last_err = OzonUnavailable("битый JSON: {}".format(e), code="badjson")
                    continue
                self._remember(text, name)
                return data, name

        if allow_html:
            url = OZON_BASE + page_url
            for attempt in range(max(1, tries)):
                try:
                    html = self._open(url, self._html_headers(ua, cookie), timeout,
                                      limit=HTML_LIMIT)
                except OzonBlocked as e:
                    last_err = e
                    blocked += 1
                    break
                except OzonUnavailable as e:
                    last_err = e
                    time.sleep(0.4 * (attempt + 1))
                    continue
                data = _states_from_html(html)
                if data.get("widgetStates"):
                    self._remember(html, "html")
                    return data, "html"
                self._remember(html, "html (без состояния)")
                last_err = OzonBlocked("HTML без состояния виджетов", code="nodata")
                break

        # переиспользуем сам объект ошибки (а не строку), чтобы сохранить
        # code/http_status — на них строится конкретное сообщение пользователю
        if isinstance(last_err, OzonError):
            raise last_err
        if blocked:
            raise OzonBlocked(str(last_err or "антибот"), code="unknown")
        raise OzonUnavailable(str(last_err or "нет ответа"), code="unknown")

# ── извлечение товаров из произвольного JSON ───────────────────────

PRICE_RE = re.compile(r"(\d[\d\s\u00a0\u2009\u202f]{0,15})\s*(?:₽|руб)", re.I)
RATING_STR_RE = re.compile(r"^([0-5](?:[.,]\d)?)$")
REVIEWS_RE = re.compile(r"(\d[\d\s\u00a0]*)\s*(?:отзыв\w*|review)", re.I)
PRODUCT_LINK_RE = re.compile(r"/product/([A-Za-z0-9\-_%.]+)")
DIGITS_RE = re.compile(r"\d{5,}")
# CDN Ozon / общие картинки (jpg/webp/png), без data: и без svg
IMAGE_URL_RE = re.compile(
    r"https?://[^\s\"'<>\\]+?\.(?:jpe?g|png|webp)(?:\?[^\s\"'<>\\]*)?",
    re.I,
)
IMAGE_HOST_HINTS = (
    "ozon", "cdn", "ir.ozone", "ozone.ru", "ozonru", "wc.o3.ru",
)

SKIP_KEYS = {
    "link", "deeplink", "weblink", "url", "src", "image", "images", "img",
    "icon", "id", "sku", "type", "component", "stateid", "vwpid", "action",
    "trackinginfo", "celltrackinginfo", "style", "textstyle", "theme",
    "color", "background", "align", "font", "tag", "test", "testinfo",
    "params", "gradient", "colorname",
}

BAD_TITLE_BITS = (
    "₽", "отзыв", "в корзину", "доставка", "рассрочка", "ozon карта",
    "с картой", "картой ozon", "осталось", "реклам", "хит", "бестселлер",
    "спецпредложение", "промокод", "смотреть все", "premium", "бонус",
    "кэшбэк", "кешбэк", "быстрая", "самовывоз", "в наличии", "аналог",
)

def _iter_dicts(node, depth=0):
    if depth > 30:
        return
    if isinstance(node, dict):
        yield node
        for v in node.values():
            if isinstance(v, (dict, list)):
                for d in _iter_dicts(v, depth + 1):
                    yield d
    elif isinstance(node, list):
        for v in node:
            if isinstance(v, (dict, list)):
                for d in _iter_dicts(v, depth + 1):
                    yield d

def _collect_strings(node, out=None, depth=0, limit=250):
    if out is None:
        out = []
    if len(out) >= limit or depth > 12:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            if str(k).lower() in SKIP_KEYS:
                continue
            if isinstance(v, str):
                s = v.strip()
                if s and len(s) <= 300 and s[:1] not in "{[#" \
                        and not s.startswith(("http", "/", "ozon://", "data:")):
                    out.append(s)
            elif isinstance(v, (dict, list)):
                _collect_strings(v, out, depth + 1, limit)
    elif isinstance(node, list):
        for v in node:
            if isinstance(v, (dict, list, str)):
                if isinstance(v, str):
                    s = v.strip()
                    if s and len(s) <= 300 and s[:1] not in "{[#" \
                            and not s.startswith(("http", "/", "ozon://", "data:")):
                        out.append(s)
                else:
                    _collect_strings(v, out, depth + 1, limit)
    return out

def _price_to_int(value):
    if value is None:
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        v = int(value)
        return v if 0 < v < 100000000 else None
    if not isinstance(value, str):
        return None
    m = PRICE_RE.search(value)
    chunk = m.group(1) if m else value
    digits = re.sub(r"\D", "", chunk)
    if not digits or len(digits) > 9:
        return None
    v = int(digits)
    return v if 0 < v < 100000000 else None

def _fmt_money(value):
    try:
        n = int(round(float(value)))
    except (TypeError, ValueError):
        return "?"
    return "{:,}".format(n).replace(",", " ") + " ₽"

def _node_link(node):
    for key in ("link", "deepLink", "webLink", "url"):
        v = node.get(key)
        if isinstance(v, str) and "/product/" in v:
            return v
    a = node.get("action")
    if isinstance(a, dict):
        for key in ("link", "deepLink", "url"):
            v = a.get(key)
            if isinstance(v, str) and "/product/" in v:
                return v
    return None


def _looks_like_product_image(url):
    if not url or not isinstance(url, str):
        return False
    u = url.strip()
    if not u.startswith("http"):
        return False
    low = u.lower()
    if low.startswith("data:") or ".svg" in low:
        return False
    if not IMAGE_URL_RE.search(u):
        # иногда CDN без расширения в path, но с image в query/host
        if not any(h in low for h in IMAGE_HOST_HINTS):
            return False
        if not any(x in low for x in ("/wc/", "/multimedia/", "/cover/", "image", "photo", "pic")):
            return False
    # отсекаем крошечные иконки и UI-спрайты
    if any(x in low for x in ("/icon", "favicon", "sprite", "logo", "1x1", "pixel.gif")):
        return False
    return True


def _node_image(node):
    """Ищем URL превью товара в узле карточки (структурные ключи + fallback regex)."""
    candidates = []

    def push(u, score):
        if _looks_like_product_image(u):
            candidates.append((score, u.strip()))

    for d in _iter_dicts(node):
        for k, v in d.items():
            lk = str(k).lower()
            if isinstance(v, str):
                if lk in ("url", "src", "image", "img", "link", "href", "picture",
                          "imageurl", "imgurl", "cover", "thumbnail", "thumb"):
                    score = 50
                    if any(x in lk for x in ("image", "img", "cover", "thumb", "picture")):
                        score = 80
                    push(v, score)
                elif v.startswith("http") and _looks_like_product_image(v):
                    push(v, 30)
            elif isinstance(v, list) and lk in ("images", "image", "pictures", "gallery"):
                for i, el in enumerate(v[:6]):
                    if isinstance(el, str):
                        push(el, 70 - i)
                    elif isinstance(el, dict):
                        for kk in ("url", "src", "link", "image", "img"):
                            vv = el.get(kk)
                            if isinstance(vv, str):
                                push(vv, 75 - i)
            elif isinstance(v, dict) and lk in ("image", "img", "picture", "cover", "thumbnail"):
                for kk in ("url", "src", "link", "image", "img"):
                    vv = v.get(kk)
                    if isinstance(vv, str):
                        push(vv, 85)

    if not candidates:
        # редкий случай: url только вложенной строкой без ключа-подсказки
        raw = str(node)[:8000]
        for m in IMAGE_URL_RE.finditer(raw):
            push(m.group(0), 10)

    if not candidates:
        return None
    candidates.sort(key=lambda x: -x[0])
    return candidates[0][1]

def _slug_title(slug):
    s = slug
    s = re.sub(r"-?\d{5,}$", "", s)
    try:
        s = urllib.parse.unquote(s)
    except Exception:
        pass
    s = s.replace("-", " ").replace("_", " ").strip()
    if not s:
        return None
    return s[:1].upper() + s[1:]

def _pick_title(strings, fallback):
    best, best_score = None, -1
    for s in strings:
        if len(s) < 8:
            continue
        low = s.lower()
        if any(bit in low for bit in BAD_TITLE_BITS):
            continue
        if not re.search(r"[A-Za-zА-Яа-яЁё]", s):
            continue
        score = min(len(s), 160)
        if s.isupper() and len(s) < 24:
            score -= 25
        if score > best_score:
            best, best_score = s, score
    if best:
        return best, False
    return fallback, True

def _prices_from_node(node, strings):
    cur = old = None
    # 1) структурный priceV2 (основной формат тайлов)
    for d in _iter_dicts(node):
        pv = d.get("priceV2")
        if isinstance(pv, dict) and isinstance(pv.get("price"), list):
            for p in pv["price"]:
                if not isinstance(p, dict):
                    continue
                val = _price_to_int(p.get("text") or p.get("price"))
                if val is None:
                    continue
                style = str(p.get("textStyle") or p.get("style") or "").upper()
                if "ORIGINAL" in style or "CROSS" in style or "OLD" in style:
                    if old is None:
                        old = val
                elif cur is None:
                    cur = val
            if cur is not None:
                break
    # 2) плоские ключи (встречается в html-состояниях)
    if cur is None:
        for d in _iter_dicts(node):
            for k, v in d.items():
                if not isinstance(v, (str, int, float)):
                    continue
                lk = str(k).lower()
                if cur is None and lk in ("price", "cardprice", "finalprice", "priceint"):
                    cur = _price_to_int(v)
                elif old is None and lk in ("originalprice", "oldprice", "priceoriginal",
                                            "basicprice", "crossprice"):
                    old = _price_to_int(v)
            if cur is not None and old is not None:
                break
    # 3) последний резерв: регулярка по всем строкам узла
    if cur is None:
        found = []
        for s in strings:
            for m in PRICE_RE.finditer(s):
                v = _price_to_int(m.group(0))
                if v:
                    found.append(v)
        if found:
            cur = found[0]
            bigger = [v for v in found[1:] if v > cur]
            if bigger and old is None:
                old = min(bigger)
    if cur and old and old <= cur:
        old = None
    return cur, old

def _rating_from_strings(strings):
    rating = reviews = None
    for s in strings:
        if rating is None:
            m = RATING_STR_RE.match(s.strip())
            if m:
                try:
                    val = float(m.group(1).replace(",", "."))
                except ValueError:
                    val = 0.0
                if 0.0 < val <= 5.0:
                    rating = val
                    continue
        if reviews is None:
            m = REVIEWS_RE.search(s)
            if m:
                digits = re.sub(r"\D", "", m.group(1))
                if digits:
                    reviews = int(digits)
    return rating, reviews

def _is_ad(node):
    for d in _iter_dicts(node):
        for k, v in d.items():
            lk = str(k).lower()
            if v is True and ("isadv" in lk or "advertis" in lk or lk in ("isad", "adv")):
                return True
            if isinstance(v, str) and "реклам" in v.lower():
                return True
    return False

def _relevant_states(data):
    """widgetStates: значения часто приходят строками с JSON внутри.
    Сначала берём виджеты выдачи, иначе — весь ответ целиком."""
    objs = []
    ws = data.get("widgetStates") if isinstance(data, dict) else None
    if isinstance(ws, dict):
        for k, v in ws.items():
            obj = v
            if isinstance(v, str):
                if v.strip()[:1] not in "{[":
                    continue
                try:
                    obj = json.loads(v)
                except Exception:
                    continue
            if isinstance(obj, (dict, list)):
                objs.append((str(k), obj))
    preferred = [(k, v) for k, v in objs
                 if re.search(r"(searchResults|tileGrid|resultsV2|skuGrid|shelf)", k, re.I)]
    if preferred:
        return preferred
    if objs:
        return objs
    return [("root", data)]

def extract_products(data):
    """Deep-walk: ищем любые узлы со ссылкой на /product/ и собираем из них
    поля. Так парсер не ломается от очередного редизайна виджетов Ozon."""
    items = {}
    order = []
    for _, obj in _relevant_states(data):
        for node in _iter_dicts(obj):
            link = _node_link(node)
            if not link:
                continue
            m = PRODUCT_LINK_RE.search(link)
            if not m:
                continue
            slug = m.group(1)
            ids = DIGITS_RE.findall(slug)
            pid = ids[-1] if ids else slug
            strings = _collect_strings(node)
            title, from_slug = _pick_title(strings, _slug_title(slug) or pid)
            price, old_price = _prices_from_node(node, strings)
            rating, reviews = _rating_from_strings(strings)
            image = _node_image(node)
            fresh = {
                "id": pid,
                "slug": slug,
                "title": title,
                "title_from_slug": from_slug,
                "price": price,
                "old_price": old_price,
                "rating": rating,
                "reviews": reviews,
                "is_ad": _is_ad(node),
                "image": image,
            }
            old = items.get(pid)
            if old is None:
                items[pid] = fresh
                order.append(pid)
                continue
            # вложенные узлы того же товара: добираем недостающее
            for key in ("price", "old_price", "rating", "reviews", "image"):
                if not old.get(key) and fresh.get(key):
                    old[key] = fresh[key]
            if old.get("title_from_slug") and not fresh["title_from_slug"]:
                old["title"] = fresh["title"]
                old["title_from_slug"] = False
            old["is_ad"] = old.get("is_ad") or fresh["is_ad"]
    return [items[pid] for pid in order]

# ── разбор пользовательского запроса ───────────────────────────────

class ParsedQuery:
    def __init__(self):
        self.text = ""
        self.price_min = None
        self.price_max = None
        self.sort = None
        self.sort_label_key = None
        self.min_rating = None
        self.min_reviews = None

SORT_WORDS = {
    "дешёвые": ("price", "sort_cheap"), "дешевые": ("price", "sort_cheap"),
    "дешево": ("price", "sort_cheap"), "дешёво": ("price", "sort_cheap"),
    "подешевле": ("price", "sort_cheap"), "cheap": ("price", "sort_cheap"),
    "дорогие": ("price_desc", "sort_expensive"), "подороже": ("price_desc", "sort_expensive"),
    "новинки": ("new", "sort_new"), "новые": ("new", "sort_new"), "new": ("new", "sort_new"),
    "рейтинг": ("rating", "sort_rating"), "рейтингу": ("rating", "sort_rating"),
    "скидки": ("discount", "sort_discount"), "скидкой": ("discount", "sort_discount"),
    "популярные": (None, "sort_relevance"), "популярное": (None, "sort_relevance"),
}

NUM_TOKEN_RE = re.compile(r"^(\d+(?:[.,]\d+)?)\s*(к|k|тыс|т)?$", re.I)
RANGE_TOKEN_RE = re.compile(r"^(\d+)\s*[-–—]\s*(\d+)$")

def _to_amount(token):
    t = token.replace("\u00a0", "").replace(" ", "").lower()
    m = NUM_TOKEN_RE.match(t)
    if not m:
        return None
    try:
        val = float(m.group(1).replace(",", "."))
    except ValueError:
        return None
    if m.group(2):
        val *= 1000
    val = int(round(val))
    return val if 0 < val < 100000000 else None

def parse_query(raw_text):
    p = ParsedQuery()
    if not raw_text:
        return p
    tokens = raw_text.split()
    used = [False] * len(tokens)

    def nxt_amount(i):
        for j in range(i + 1, min(i + 3, len(tokens))):
            if used[j]:
                continue
            val = _to_amount(tokens[j])
            if val is not None:
                used[j] = True
                return val
            return None
        return None

    for i, tok in enumerate(tokens):
        if used[i]:
            continue
        low = tok.lower().replace("ё", "е")

        if low in ("до", "макс", "максимум", "<", "<=", "until"):
            val = nxt_amount(i)
            if val is not None:
                p.price_max = val
                used[i] = True
                continue
        if low in ("от", "мин", "минимум", ">", ">=", "from"):
            val = nxt_amount(i)
            if val is not None:
                p.price_min = val
                used[i] = True
                continue
        if low.startswith("<") and len(low) > 1:
            val = _to_amount(low[1:].lstrip("="))
            if val is not None:
                p.price_max = val
                used[i] = True
                continue
        if low.startswith(">") and len(low) > 1:
            val = _to_amount(low[1:].lstrip("="))
            if val is not None:
                p.price_min = val
                used[i] = True
                continue

        m = RANGE_TOKEN_RE.match(low)
        if m:
            a, b = int(m.group(1)), int(m.group(2))
            if a and b and a < b and b > 100:
                p.price_min, p.price_max = a, b
                used[i] = True
                continue

        if low in ("оценка", "оценкой", "звезд", "звёзд", "rating"):
            for j in range(i + 1, min(i + 3, len(tokens))):
                if used[j]:
                    continue
                try:
                    val = float(tokens[j].replace(",", "."))
                except ValueError:
                    break
                if 0 < val <= 5:
                    p.min_rating = val
                    used[i] = used[j] = True
                break
            if used[i]:
                continue

        if low in ("отзывов", "отзывы", "отзыва", "reviews"):
            for j in range(i + 1, min(i + 3, len(tokens))):
                if used[j]:
                    continue
                digits = re.sub(r"\D", "", tokens[j])
                if digits:
                    p.min_reviews = int(digits)
                    used[i] = used[j] = True
                break
            if used[i]:
                continue

        # "сортировка" как служебное слово перед ключом сортировки
        if low in ("сортировка", "сортировать", "sort"):
            used[i] = True
            continue

        if low in SORT_WORDS:
            p.sort, p.sort_label_key = SORT_WORDS[low]
            used[i] = True
            continue

    p.text = " ".join(tokens[i] for i in range(len(tokens)) if not used[i]).strip()
    return p

def build_page_url(parsed, page, default_sort, extra_params):
    params = [("text", parsed.text)]
    sort = parsed.sort or default_sort
    if sort:
        params.append(("sorting", sort))
    if parsed.price_min or parsed.price_max:
        lo = parsed.price_min or 0
        hi = parsed.price_max or 99999999
        params.append(("currency_price", "{}.000-{}.000".format(lo, hi)))
    if page > 1:
        params.append(("page", str(page)))
    params.append(("from_global", "true"))
    query = urllib.parse.urlencode(params, quote_via=urllib.parse.quote)
    extra = (extra_params or "").strip().lstrip("&?")
    if extra:
        query = query + "&" + extra
    return "/search/?" + query

def _plural_ru(n, one, few, many):
    n = abs(int(n)) % 100
    if 11 <= n <= 14:
        return many
    n %= 10
    if n == 1:
        return one
    if 2 <= n <= 4:
        return few
    return many

# ── образец для предпросмотра (без сети) ──────────────────────────

SAMPLE_ITEMS = [
    {"id": "1234567", "slug": "google-pixel-9a-8-128gb-blue-1234567",
     "title": "Google Pixel 9a 8/128 ГБ (Синий)", "price": 28990, "old_price": 31490,
     "rating": 4.9, "reviews": 12, "is_ad": False, "title_from_slug": False, "image": None},
    {"id": "2345678", "slug": "smartfon-pixel-9a-12-256gb-blue-2345678",
     "title": "Смартфон Pixel 9a 12/256 ГБ Blue", "price": 29500, "old_price": None,
     "rating": 4.8, "reviews": 45, "is_ad": True, "title_from_slug": False, "image": None},
    {"id": "3456789", "slug": "google-pixel-9a-sea-3456789",
     "title": "Google Pixel 9a Sea (Голубой/Синий)", "price": 27400, "old_price": 29900,
     "rating": 4.7, "reviews": 8, "is_ad": False, "title_from_slug": False, "image": None},
]

# ── справка: словарь терминов, показывается в разделе «Справка» ────
# структура: {lang: [(заголовок раздела, [(термин, пояснение), ...]), ...]}
HELP_SECTIONS = {
    "ru": [
        ("Команда и фильтры", [
            (".ozon <запрос>", "Основная команда поиска. Пример: .ozon Pixel 9a до 30000"),
            ("Найти на Ozon (меню сообщения)", "Долгий тап по любому сообщению → «Найти на "
                                              "Ozon» — ищет по тексту этого сообщения, без "
                                              "набора команды вручную"),
            ("до N / от N", "Верхняя или нижняя граница цены. Можно указать оба сразу: N-N"),
            ("дешёвые / дорогие", "Сортировка выдачи сначала по возрастанию или убыванию цены"),
            ("новинки", "Сортировка по дате добавления товара"),
            ("рейтинг / скидки", "Сортировка по оценке товара или по размеру скидки"),
            ("оценка N", "Показывать только товары с рейтингом не ниже N, например «оценка 4.5»"),
            ("отзывов N", "Показывать только товары с числом отзывов не меньше N"),
