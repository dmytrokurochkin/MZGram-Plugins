# ---------------------------------------------------------------------------
# Piano timbres (additive synthesis with a model of a real string)
# alpha   : spectrum slope (the larger, the softer and darker)
# fc      : brightness frequency (Hz), above it the harmonics decay
# b       : string inharmonicity (stiffness), the harmonics are slightly stretched
# gamma   : how much faster the upper harmonics decay
# df, ds  : speed of the fast (strike) and slow (afterglow) decay, 1/s
# wf      : share of the fast component
# cents   : detuning of two strings (beats, liveliness)
# noise   : level of the hammer knock on the string
# att     : attack, ms
# dur     : duration multiplier of the sample
# sym     : resonance of neighbouring strings (pedal)
# wander  : random detuning of each note (vintage tuning), cents
# partials: own set of overtones [(multiple, volume, decay speed-up)]
# ---------------------------------------------------------------------------
TIMBRES = [
