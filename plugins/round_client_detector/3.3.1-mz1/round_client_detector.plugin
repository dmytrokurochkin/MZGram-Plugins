try:
    from ui.alert import AlertDialogBuilder
except ImportError:
    AlertDialogBuilder = None

try:
    from client_utils import get_last_fragment
except ImportError:
    get_last_fragment = lambda: None

try:
    from hook_utils import find_class, get_private_field, set_private_field
except ImportError:
    find_class = lambda name: None
    get_private_field = lambda obj, field: getattr(obj, field, None)
    set_private_field = lambda obj, field, val: setattr(obj, field, val)

__id__ = "round_client_detector"
__name__ = "Round Video Client Detector"
__description__ = "Shows which device (iOS, Android, PC) a round video was recorded on."
__author__ = "MZGram"
__version__ = "3.3.1-mz1"
__app_version__ = ">=12.1.1"
__category__ = ["media"]
