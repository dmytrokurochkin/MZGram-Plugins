# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

__id__ = "remover"
__name__ = "Advanced Eraser"
__author__ = "@Sk0lovek_plugins"
__version__ = "3.3.1-mz1"
__description__ = """Automatically removes the specified characters or whole words from all outgoing messages. Flexible black and white list settings."""

# Compatible version
# -*- coding: utf-8 -*-

__icon__ = "Sk0lovekPlugins/2"
__min_version__ = "11.12.0"
__category__ = ["chats"]

import re
import string
from typing import Any
from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from ui.settings import Switch, Header, Divider, Input
from android_utils import run_on_ui_thread
from client_utils import send_message, get_last_fragment
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from hook_utils import find_class

# Imports that will not cause an error in your app version
from com.exteragram.messenger.plugins import PluginsController
from com.exteragram.messenger.plugins.ui import PluginSettingsActivity

class SymbolEraserPlugin(BasePlugin):
    """
    This plugin removes or keeps the characters/words specified by the user
    in outgoing messages, depending on the selected mode.
    """

    def _open_plugin_settings(self, context: dict):
        """
        Opens the settings via 'context' for compatibility with older versions.
        """
        @run_on_ui_thread
        def open_settings_action_pg():
            try:
                # generated with PluginGRT - @PluginIDEbot
                pg_java_plugin_instance = PluginsController.getInstance().plugins.get(self.id)
                pg_last_fragment = context.get('fragment')
                if pg_java_plugin_instance and pg_last_fragment:
                    pg_last_fragment.presentFragment(PluginSettingsActivity(pg_java_plugin_instance))
            except Exception as e:
                self.log(f"Failed to open plugin settings: {e}")

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_mz_t("Налаштування Розширеного ластика", "Advanced Eraser settings", "Настройки Продвинутого ластика"),
                icon="msg_settings_solar",
                on_click=self._open_plugin_settings
            )
        )

    def create_settings(self):
        """
        Creates the plugin settings page.
        """
        return [
            Header(text=_mz_t("Налаштування Розширеного ластика", "Advanced Eraser settings", "Настройки Продвинутого ластика")),
            Switch(key="master_enabled", text=_mz_t("Увімкнути плагін", "Enable plugin", "Включить плагин"), subtext=_mz_t("Головний перемикач. Якщо вимкнено, фільтрація не працює.", "Main switch. If off, filtering does not work.", "Главный переключатель. Если выключен, фильтрация не работает."), default=True, icon="msg_power"),
            Switch(key="show_warning", text=_mz_t("Показувати попередження", "Show warning", "Показывать предупреждение"), subtext=_mz_t("Попереджати перед надсиланням, якщо повідомлення буде змінено.", "Warn before sending if the message will be changed.", "Предупреждать перед отправкой, если сообщение будет изменено."), default=False, icon="msg_warning"),
            Divider(),
            Header(text=_mz_t("Фільтрація символів", "Character filtering", "Фильтрация символов")),
            Switch(key="chars_enabled", text=_mz_t("Увімкнути фільтрацію символів", "Enable character filtering", "Включить фильтрацию символов"), subtext=_mz_t("Вмикає видалення та збереження окремих символів.", "Enables removing and keeping individual characters.", "Активирует удаление/сохранение отдельных символов."), default=False, icon="msg_delete"),
            Switch(key="chars_whitelist_mode", text=_mz_t("Режим білого списку для символів", "Whitelist mode for characters", "Режим белого списка для символов"), subtext=_mz_t("Якщо увімкнено, *лише* вказані символи залишаться.", "If enabled, *only* the specified characters are kept.", "Если включено, *только* указанные символы будут оставлены."), default=False, icon="filter_custom_solar"),
            Input(key="chars_to_filter", text=_mz_t("Символи для фільтрації", "Characters to filter", "Символы для фильтрации"), subtext=_mz_t("У чорному списку ці символи видаляться. У білому списку залишаться лише вони.", "In the blacklist these characters are removed. In the whitelist only they remain.", "В черном списке: эти символы удалятся. В белом списке: только они останутся."), default="", icon="input_bot1_remix"),
            Switch(key="chars_case_insensitive", text=_mz_t("Ігнорувати регістр для символів", "Ignore case for characters", "Игнорировать регистр для символов"), subtext=_mz_t("Якщо увімкнено, 'a' також обробить 'A' і навпаки.", "If enabled, 'a' also matches 'A' and vice versa.", "Если включено, 'a' также обработает 'А' и наоборот."), default=False, icon="msg_text_check"),
            Divider(),
            Header(text=_mz_t("Фільтрація слів", "Word filtering", "Фильтрация слов")),
            Switch(key="words_enabled", text=_mz_t("Увімкнути фільтрацію слів", "Enable word filtering", "Включить фильтрацию слов"), subtext=_mz_t("Вмикає видалення та збереження цілих слів.", "Enables removing and keeping whole words.", "Активирует удаление/сохранение целых слов."), default=False, icon="msg_delete"),
            Switch(key="words_whitelist_mode", text=_mz_t("Режим білого списку для слів", "Whitelist mode for words", "Режим белого списка для слов"), subtext=_mz_t("Якщо увімкнено, *лише* вказані слова залишаться.", "If enabled, *only* the specified words are kept.", "Если включено, *только* указанные слова будут оставлены."), default=False, icon="filter_custom_solar"),
            Input(key="words_to_filter", text=_mz_t("Слова для фільтрації (через кому)", "Words to filter (comma-separated)", "Слова для фильтрации (через запятую)"), subtext=_mz_t("Приклад: слово1, інше слово, третє. Пунктуація на краях слів ігнорується.", "Example: word1, another word, third. Punctuation at the edges of words is ignored.", "Пример: слово1, другое слово, третье. Пунктуация по краям слов игнорируется."), default="", icon="input_bot1_remix"),
            Switch(key="words_case_insensitive", text=_mz_t("Ігнорувати регістр для слів", "Ignore case for words", "Игнорировать регистр для слов"), subtext=_mz_t("Якщо увімкнено, 'Слово' оброблятиметься так само, як 'слово'.", "If enabled, 'Word' is handled the same as 'word'.", "Если включено, 'Слово' будет обработано так же, как 'слово'."), default=True, icon="msg_text_check"),
            Divider()
        ]

    def _show_confirmation_dialog(self, params: Any, original_text: str, final_text: str):
        """
        Shows a confirmation dialog before sending the changed message.
        """
        @run_on_ui_thread
        def show_dialog_action():
            fragment = get_last_fragment()
            if not fragment or not fragment.getParentActivity():
                send_message({"peer": params.peer, "message": final_text, "replyToMsg": getattr(params, 'replyToMsg', None)})
                return

            activity = fragment.getParentActivity()
            
            # Finding the required Android classes
            TextUtils = find_class("android.text.TextUtils")
            Html = find_class("android.text.Html")
            Build = find_class("android.os.Build")
            AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")

            # Escaping the user text for safe insertion into HTML
            escaped_original = TextUtils.htmlEncode(original_text)
            escaped_final = TextUtils.htmlEncode(final_text)

            html_message = (
                _mz_t("Повідомлення буде змінено:<br><br><b>Було:</b><br><code>", "The message will be changed:<br><br><b>Was:</b><br><code>", ("Сообщение будет изменено:<br><br>"
                "<b>Было:</b><br><code>")) + escaped_original + _mz_t("</code><br><br><b>Стане:</b><br><code>", "</code><br><br><b>Becomes:</b><br><code>", ("</code><br><br>"
                "<b>Станет:</b><br><code>")) + escaped_final + _mz_t("</code><br><br>Надіслати змінену версію?", "</code><br><br>Send the changed version?", ("</code><br><br>"
                "Отправить измененную версию?"))
            )
            
            # Converting HTML to formatted text
            if Build.VERSION.SDK_INT >= 24: # For Android N and above
                formatted_message = Html.fromHtml(html_message, Html.FROM_HTML_MODE_LEGACY)
            else: # For older versions
                formatted_message = Html.fromHtml(html_message)

            builder = AlertDialogBuilder(activity)
            builder.set_title(_mz_t("Попередження", "Warning", "Предупреждение"))
            builder.set_message(formatted_message)

            def send_action(dialog, which):
                send_message({
                    "peer": params.peer, "message": final_text, "replyToMsg": getattr(params, 'replyToMsg', None)
                })
                dialog.dismiss()
            
            def cancel_action(dialog, which):
                # Copy the text so the user does not lose it
                AndroidUtilities.addToClipboard(original_text)
                BulletinHelper.show_info(_mz_t("Текст скопійовано в буфер обміну.", "Text copied to clipboard.", "Текст скопирован в буфер обмена."), fragment)
                dialog.dismiss()

            builder.set_positive_button(_mz_t("Надіслати", "Send", "Отправить"), send_action)
            builder.set_negative_button(_mz_t("Скасувати", "Cancel", "Отмена"), cancel_action)
            builder.show()


    def _filter_characters(self, text: str) -> str:
        if not self.get_setting("chars_enabled", False): return text
        chars_to_filter = self.get_setting("chars_to_filter", "")
        if not chars_to_filter: return text
        is_case_insensitive = self.get_setting("chars_case_insensitive", False)
        is_whitelist_mode = self.get_setting("chars_whitelist_mode", False)
        effective_chars_set = set()
        if is_case_insensitive:
            for char in chars_to_filter:
                effective_chars_set.add(char.lower())
                effective_chars_set.add(char.upper())
        else:
            effective_chars_set.update(chars_to_filter)
        if is_whitelist_mode:
            return "".join([char for char in text if char in effective_chars_set])
        else:
            translation_table = str.maketrans('', '', "".join(effective_chars_set))
            return text.translate(translation_table)

    def _filter_words(self, text: str) -> str:
        if not self.get_setting("words_enabled", False): return text
        words_to_filter_str = self.get_setting("words_to_filter", "")
        if not words_to_filter_str: return text
        punctuation_to_strip = string.punctuation
        raw_words = words_to_filter_str.split(',')
        words_list = [word.strip().strip(punctuation_to_strip) for word in raw_words if word.strip()]
        if not words_list: return text
        is_whitelist_mode = self.get_setting("words_whitelist_mode", False)
        is_case_insensitive = self.get_setting("words_case_insensitive", True)
        words_to_process = []
        if is_whitelist_mode:
            all_words_in_text = re.findall(r'\b\w+\b', text)
            if is_case_insensitive:
                whitelist_set = {word.lower() for word in words_list}
                words_to_process = list({word for word in all_words_in_text if word.lower() not in whitelist_set})
            else:
                whitelist_set = set(words_list)
                words_to_process = list({word for word in all_words_in_text if word not in whitelist_set})
        else:
            words_to_process = words_list
        if not words_to_process: return text
        pattern = r'\b(' + '|'.join(re.escape(word) for word in words_to_process) + r')\b'
        flags = re.IGNORECASE if is_case_insensitive else 0
        modified_text = re.sub(pattern, '', text, flags=flags)
        return re.sub(r'\s{2,}', ' ', modified_text).strip()

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not self.get_setting("master_enabled", True): return HookResult()
        if not hasattr(params, 'message') or not isinstance(params.message, str): return HookResult()
        
        original_message = params.message
        filtered_text = self._filter_words(original_message)
        final_text = self._filter_characters(filtered_text)
        
        if original_message != final_text:
            if self.get_setting("show_warning", False):
                self._show_confirmation_dialog(params, original_message, final_text)
                return HookResult(strategy=HookStrategy.CANCEL)
            else:
                params.message = final_text
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
                
        return HookResult()