# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import json
import re
from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from ui.settings import Header, Input, Switch, Divider, Text
from markdown_utils import parse_markdown
from java.util import ArrayList
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread, log
from com.exteragram.messenger.plugins import PluginsController
from com.exteragram.messenger.plugins.ui import PluginSettingsActivity

__id__ = "requisites_sender"
__name__ = "rekvplug"
__version__ = "2.1.0-mz1"
__author__ = "MZGram"
__description__ = "Sends the requisites from the settings on the .rekv command. Be sure to check .helprekv"
__min_version__ = "11.12.0"
__category__ = ["chats"]

REQUISITES = [
    ("tonkeeper", "Tonkeeper"),
    ("wallet", "Wallet"),
    ("tonhub", "TONhub"),
    ("bank_card", "Bank card"),
    ("patreon", "Patreon")
]
MAX_CUSTOM_FIELDS = 5
FLAG_MAP = {
    '-tk': 'tonkeeper',
    '-th': 'tonhub',
    '-w': 'wallet',
    '-bc': 'bank_card',
    '-p': 'patreon',
}
HELP_TEXT = (
    _mz_t("*Довідка за командами:*\n\n`-tk` - вимикає Tonkeeper\n`-th` - вимикає TONhub\n`-w` - вимикає Wallet\n`-bc` - вимикає Bank card\n`-p` - вимикає Patreon\n\n_Можна використовувати кілька прапорців одразу, наприклад:_\n`.rekv -p -tk`", "*Command help:*\n\n`-tk` - disables Tonkeeper\n`-th` - disables TONhub\n`-w` - disables Wallet\n`-bc` - disables Bank card\n`-p` - disables Patreon\n\n_You can use several flags at once, for example:_\n`.rekv -p -tk`", ("*Справка по командам:*\n\n"
    "`-tk` - отключает Tonkeeper\n"
    "`-th` - отключает TONhub\n"
    "`-w` - отключает Wallet\n"
    "`-bc` - отключает Bank card\n"
    "`-p` - отключает Patreon\n\n"
    "_Можно использовать несколько флагов сразу, например:_\n"
    "`.rekv -p -tk`"))
)


class RekvPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_mz_t("Налаштування реквізитів", "Requisites settings", "Настройки реквизитов"),
                icon="msg_settings_14",
                on_click=self._open_settings
            )
        )

    def _open_settings(self, ctx):
        def action():
            try:
                java_plugin = PluginsController.getInstance().plugins.get(self.id)
                if java_plugin:
                    get_last_fragment().presentFragment(PluginSettingsActivity(java_plugin))
            except Exception as e:
                log(f"Error opening plugin settings: {e}")
        run_on_ui_thread(action)

    def _contains_russian(self, text: str) -> bool:
        return bool(re.search('[а-яА-ЯёЁ]', str(text)))

    def _is_valid_username(self, username: str) -> bool:
        if not username:
            return True
        return bool(re.match(r'^[a-zA-Z]{4,14}$', username))

    def create_settings(self):
        settings_list = [
            Header(text=_mz_t("Основні налаштування", "Basic settings", "Основные настройки")),
            Input(
                key="username",
                text=_mz_t("Твій нік", "Your nickname", "Ваш никнейм"),
                default="",
                subtext=_mz_t("Відображається в заголовку", "Shown in the header", "Отображается в заголовке"),
                icon="msg_contacts"
            ),
            Switch(
                key="show_username",
                text=_mz_t("Показувати нік", "Show nickname", "Показывать никнейм"),
                default=True,
                icon="msg_info"
            ),
            Divider(),
            Header(text=_mz_t("Платіжні реквізити", "Payment requisites", "Платежные реквизиты")),
        ]

        for key, label in REQUISITES:
            settings_list.extend([
                Input(key=key, text=label, default="", icon="msg_pin_code"),
                Switch(key=f"show_{key}", text=_mz_t(f"Показувати {label}", f"Show {label}", f"Показывать {label}"), default=True, icon="msg_visibility"),
                Divider()
            ])

        settings_list.append(Header(text=_mz_t("Власні реквізити", "Custom requisites", "Пользовательские реквизиты")))

        for i in range(1, MAX_CUSTOM_FIELDS + 1):
            settings_list.extend([
                Input(key=f"custom_name_{i}", text=_mz_t(f"Назва поля {i}", f"Field name {i}", f"Название поля {i}"), default="", icon="msg_edit"),
                Input(key=f"custom_value_{i}", text=_mz_t(f"Значення поля {i}", f"Field value {i}", f"Значение поля {i}"), default="", icon="msg_pin_code"),
                Switch(key=f"show_custom_{i}", text=_mz_t(f"Показувати поле {i}", f"Show field {i}", f"Показывать поле {i}"), default=True, icon="msg_visibility"),
                Divider()
            ])

        settings_list.extend([
            Header(text=_mz_t("Інше", "Other", "Прочее")),
            Switch(key="disable_ad", text=_mz_t("Вимкнути рекламу", "Disable ads", "Отключить рекламу"), default=False, icon="msg_block")
        ])
        return settings_list

    def on_send_message_hook(self, account, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()

        command = params.message.strip().lower()

        if command == ".helprekv":
            parsed = parse_markdown(HELP_TEXT)
            params.message = parsed.text
            if not hasattr(params, "entities") or params.entities is None:
                params.entities = ArrayList()
            else:
                params.entities.clear()
            for entity in parsed.entities:
                params.entities.add(entity.to_tlrpc_object())
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if not command.startswith(".rekv"):
            return HookResult()

        validation_failed_pg = False
        
        show_username = self.get_setting("show_username", True)
        username = self.get_setting("username", "")
        if show_username and username and not self._is_valid_username(username):
            validation_failed_pg = True

        if not validation_failed_pg:
            all_requisites_to_check = []
            for key, _ in REQUISITES:
                if self.get_setting(f"show_{key}", True):
                    all_requisites_to_check.append(self.get_setting(key, ""))
            for i in range(1, MAX_CUSTOM_FIELDS + 1):
                if self.get_setting(f"show_custom_{i}", True):
                    all_requisites_to_check.append(self.get_setting(f"custom_name_{i}", ""))
                    all_requisites_to_check.append(self.get_setting(f"custom_value_{i}", ""))
            
            if any(value and self._contains_russian(value) for value in all_requisites_to_check):
                validation_failed_pg = True
        
        if validation_failed_pg:
            params.message = _mz_t("Спочатку прибери російські літери з рядків, а потім користуйся", "Remove the Russian letters from the lines first, then use it", "Сначала убери русские буквы из строк, а потом уже пользуйся")
            if hasattr(params, 'entities') and params.entities:
                params.entities.clear()
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        
        parts = command.split()
        temp_disabled_keys = {FLAG_MAP[part] for part in parts if part in FLAG_MAP}
        
        message_parts = []
        
        if show_username and username:
            message_parts.append(f"Payment [{username}]")
            message_parts.append("")

        for key, label in REQUISITES:
            if key in temp_disabled_keys:
                continue
            show_item = self.get_setting(f"show_{key}", True)
            item_value = self.get_setting(key, "")
            if show_item and item_value:
                message_parts.append(f"{label}: `{item_value}`")

        for i in range(1, MAX_CUSTOM_FIELDS + 1):
            show_custom = self.get_setting(f"show_custom_{i}", True)
            custom_name = self.get_setting(f"custom_name_{i}", "")
            custom_value = self.get_setting(f"custom_value_{i}", "")
            if show_custom and custom_name and custom_value:
                message_parts.append(f"{custom_name}: `{custom_value}`")



        if not any(part.strip() for part in message_parts if part):
            params.message = _mz_t("Реквізити не налаштовано. Заповніть їх у налаштуваннях плагіна.", "Requisites are not set up. Fill them in the plugin settings.", "Реквизиты не настроены. Заполните их в настройках плагина.")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        
        final_text = "\n".join(message_parts)
        
        parsed = parse_markdown(final_text)
        params.message = parsed.text
        
        if not hasattr(params, "entities") or params.entities is None:
            params.entities = ArrayList()
        else:
            params.entities.clear()
            
        for entity in parsed.entities:
            params.entities.add(entity.to_tlrpc_object())
            
        return HookResult(strategy=HookStrategy.MODIFY, params=params)