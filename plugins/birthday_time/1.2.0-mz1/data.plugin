# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import datetime
import calendar

from ui.settings import Header, Switch, Divider, Input, Selector
from base_plugin import BasePlugin, HookResult, HookStrategy

__id__ = "birthday_time"
__name__ = "BirthdayTime"
__version__ = "1.2.0-mz1"
__description__ = "Shows the number of days until your birthday."
__author__ = "MZGram"
__min_version__ = "11.9.0"
__category__ = ["tools"]


class BirthdayTimePlugin(BasePlugin):
    def create_settings(self):
        return [
            Header(text=_mz_t("Налаштування плагіна «День народження»", "Birthday plugin settings", "Настройки плагина \"Дата рождения\"")),
            Input(
                key="birthday_date",
                text=_mz_t("День народження", "Birthday", "Дата рождения"),
                default="",
                subtext=_mz_t("Вкажіть дату народження у форматі ММ.ДД (наприклад, 10.25)", "Enter your birthday in MM.DD format (for example, 10.25)", "Укажите дату рождения в формате ММ.ДД (например, 10.25)"),
            ),
            Divider(text=_mz_t(".dt - дізнатися кількість днів до дня народження", ".dt - show the number of days until your birthday", ".dt - узнать количество дней до дня рождения")),
        ]

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def get_time_units_string(self, value: int, unit: str) -> str:
        if unit == "день":
            if value % 10 == 1 and value % 100 != 11:
                return _mz_t(f"{value} день", f"{value} day", f"{value} день")
            elif 2 <= value % 10 <= 4 and (value % 100 < 10 or value % 100 >= 20):
                return _mz_t(f"{value} дні", f"{value} days", f"{value} дня")
            else:
                return _mz_t(f"{value} днів", f"{value} days", f"{value} дней")
        elif unit == "час":
            if value % 10 == 1 and value % 100 != 11:
                return _mz_t(f"{value} година", f"{value} hour", f"{value} час")
            elif 2 <= value % 10 <= 4 and (value % 100 < 10 or value % 100 >= 20):
                return _mz_t(f"{value} години", f"{value} hours", f"{value} часа")
            else:
                return _mz_t(f"{value} годин", f"{value} hours", f"{value} часов")
        elif unit == "минута":
            if value % 10 == 1 and value % 100 != 11:
                return _mz_t(f"{value} хвилина", f"{value} minute", f"{value} минута")
            elif 2 <= value % 10 <= 4 and (value % 100 < 10 or value % 100 >= 20):
                return _mz_t(f"{value} хвилини", f"{value} minutes", f"{value} минуты")
            else:
                return _mz_t(f"{value} хвилин", f"{value} minutes", f"{value} минут")
        elif unit == "секунда":
            if value % 10 == 1 and value % 100 != 11:
                return _mz_t(f"{value} секунда", f"{value} second", f"{value} секунда")
            elif 2 <= value % 10 <= 4 and (value % 100 < 10 or value % 100 >= 20):
                return _mz_t(f"{value} секунди", f"{value} seconds", f"{value} секунды")
            else:
                return _mz_t(f"{value} секунд", f"{value} seconds", f"{value} секунд")
        return ""

    def get_formatted_birthday_message(self, birth_date_str: str) -> str:
        now = datetime.datetime.now()

        try:
            birth_month, birth_day = map(int, birth_date_str.split("."))
        except ValueError:
            return _mz_t("Помилка: неправильний формат дати. Використовуйте ММ.ДД (приклад: 12.25).", "Error: invalid date format. Use MM.DD (example: 12.25).", "Ошибка: Неверный формат даты. Используйте MM.DD (пример: 12.25).")

        try:
            birthday = datetime.datetime(now.year, birth_month, birth_day)
        except ValueError:
            return _mz_t("Помилка: неправильна дата (наприклад, день поза межами місяця).", "Error: invalid date (for example, the day is out of range for the month).", "Ошибка: Неверная дата (например, день вне диапазона для месяца).")

        if now.month > birth_month or (now.month == birth_month and now.day > birth_day):
            birthday = datetime.datetime(now.year + 1, birth_month, birth_day)

        time_to_birthday = birthday - now

        days = time_to_birthday.days
        hours = time_to_birthday.seconds // 3600
        minutes = (time_to_birthday.seconds // 60) % 60
        seconds = time_to_birthday.seconds % 60

        days_str = self.get_time_units_string(days, "день")
        hours_str = self.get_time_units_string(hours, "час")
        minutes_str = self.get_time_units_string(minutes, "минута")
        seconds_str = self.get_time_units_string(seconds, "секунда")

        return _mz_t(f"До вашого дня народження залишилось: {days_str}, {hours_str}, {minutes_str}, {seconds_str}.", f"Time left until your birthday: {days_str}, {hours_str}, {minutes_str}, {seconds_str}.", f"До вашего дня рождения осталось: {days_str}, {hours_str}, {minutes_str}, {seconds_str}.")

    def on_send_message_hook(self, account, params):
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()

        command_prefix = ".dt"
        if params.message.startswith(command_prefix):

            birth_date_str = self.get_setting("birthday_date")
            text = self.get_formatted_birthday_message(birth_date_str)
            params.message = text

            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        return HookResult()