# MZGram: Ukrainian for the Ukrainian app language, the original Russian for Russian, English for everyone else
def _mz_t(uk, en, ru=None):
    try:
        from java.util import Locale as _MzLocale
        lang = str(_MzLocale.getDefault().getLanguage())
    except Exception:
        lang = "en"
    if lang == "uk":
        return uk
    if lang == "ru" and ru is not None:
        return ru
    return en

import requests
from requests.exceptions import Timeout, ConnectionError, HTTPError
from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Divider
from ui.bulletin import BulletinHelper
from client_utils import send_message, run_on_queue
from java.util import Locale, ArrayList
from markdown_utils import parse_markdown

# Apache license 2.0 copyright @shareui
# The violation will be removed via dmca@telegram.org
